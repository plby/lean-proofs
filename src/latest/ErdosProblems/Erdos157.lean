namespace Erdos157.SawinGeometry

open AlgebraicGeometry

open AlgebraicGeometry.Scheme

/-- Absolute Frobenius on an arbitrary scheme over the prime field, glued
from the affine construction. -/
noncomputable def schemeFrobeniusOver
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) : X ⟶ X :=
  X.affineCover.glueMorphisms
    (fun i ↦ affineSchemeFrobeniusOver (X.affineCover.X i) q
        (X.affineCover.f i ≫ p) ≫ X.affineCover.f i)
    (fun i j ↦ by
      apply (pullback (X.affineCover.f i) (X.affineCover.f j)).affineCover.hom_ext
      intro k
      simp only [← Category.assoc]
      rw [← affineSchemeFrobeniusOver_naturality
          ((pullback (X.affineCover.f i) (X.affineCover.f j)).affineCover.f k ≫
            pullback.fst (X.affineCover.f i) (X.affineCover.f j)) q
          (((pullback (X.affineCover.f i) (X.affineCover.f j)).affineCover.f k ≫
            pullback.fst (X.affineCover.f i) (X.affineCover.f j)) ≫
              X.affineCover.f i ≫ p)
          (X.affineCover.f i ≫ p),
        ← affineSchemeFrobeniusOver_naturality
          ((pullback (X.affineCover.f i) (X.affineCover.f j)).affineCover.f k ≫
            pullback.snd (X.affineCover.f i) (X.affineCover.f j)) q
          (((pullback (X.affineCover.f i) (X.affineCover.f j)).affineCover.f k ≫
            pullback.fst (X.affineCover.f i) (X.affineCover.f j)) ≫
              X.affineCover.f i ≫ p)
          (X.affineCover.f j ≫ p)]
      simp only [Category.assoc]
      rw [pullback.condition])

@[reassoc]
theorem affineCover_f_schemeFrobeniusOver
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) (i : X.affineCover.I₀) :
    X.affineCover.f i ≫ schemeFrobeniusOver X q p =
      affineSchemeFrobeniusOver (X.affineCover.X i) q
        (X.affineCover.f i ≫ p) ≫ X.affineCover.f i := by
  apply Scheme.Cover.ι_glueMorphisms

/-- Naturality of the glued Frobenius for a map into an affine target. -/
theorem schemeFrobeniusOver_naturality_toAffine
    {X Y : Scheme} [IsAffine Y]
    (f : X ⟶ Y) (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q))) :
    schemeFrobeniusOver X q pX ≫ f =
      f ≫ affineSchemeFrobeniusOver Y q pY := by
  apply X.affineCover.hom_ext
  intro i
  simp only [Category.assoc, affineCover_f_schemeFrobeniusOver_assoc]
  rw [affineSchemeFrobeniusOver_naturality
    (X.affineCover.f i ≫ f) q (X.affineCover.f i ≫ pX) pY]
  simp only [Category.assoc]

/-- Naturality of the glued Frobenius for an arbitrary scheme morphism.
The proof refines an affine cover of the source by pullbacks of an affine
cover of the target, reducing every comparison to affine Frobenius
naturality. -/
theorem schemeFrobeniusOver_naturality
    {X Y : Scheme} (f : X ⟶ Y)
    (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q))) :
    schemeFrobeniusOver X q pX ≫ f =
      f ≫ schemeFrobeniusOver Y q pY := by
  apply X.affineCover.hom_ext
  intro i
  simp only [Category.assoc, affineCover_f_schemeFrobeniusOver_assoc]
  let h := X.affineCover.f i ≫ f
  apply Scheme.Cover.hom_ext (Y.affineCover.pullback₁ h)
  intro j
  change Y.affineCover.I₀ at j
  apply (pullback h (Y.affineCover.f j)).affineCover.hom_ext
  intro k
  let V := pullback h (Y.affineCover.f j)
  let W := V.affineCover.X k
  let a : W ⟶ X.affineCover.X i :=
    V.affineCover.f k ≫ pullback.fst h (Y.affineCover.f j)
  let b : W ⟶ Y.affineCover.X j :=
    V.affineCover.f k ≫ pullback.snd h (Y.affineCover.f j)
  have hab : a ≫ h = b ≫ Y.affineCover.f j := by
    dsimp only [a, b, V]
    simp only [Category.assoc]
    rw [pullback.condition]
  change a ≫ affineSchemeFrobeniusOver (X.affineCover.X i) q
        (X.affineCover.f i ≫ pX) ≫ h =
    a ≫ h ≫ schemeFrobeniusOver Y q pY
  calc
    a ≫ affineSchemeFrobeniusOver (X.affineCover.X i) q
          (X.affineCover.f i ≫ pX) ≫ h =
        affineSchemeFrobeniusOver W q (a ≫ X.affineCover.f i ≫ pX) ≫
          a ≫ h := by
      rw [← Category.assoc,
        ← affineSchemeFrobeniusOver_naturality a q
          (a ≫ X.affineCover.f i ≫ pX) (X.affineCover.f i ≫ pX)]
      simp only [Category.assoc]
    _ = affineSchemeFrobeniusOver W q
          (a ≫ X.affineCover.f i ≫ pX) ≫ b ≫ Y.affineCover.f j := by
      simp only [Category.assoc, hab]
    _ = b ≫ affineSchemeFrobeniusOver (Y.affineCover.X j) q
          (Y.affineCover.f j ≫ pY) ≫ Y.affineCover.f j := by
      rw [← Category.assoc,
        affineSchemeFrobeniusOver_naturality b q
          (a ≫ X.affineCover.f i ≫ pX) (Y.affineCover.f j ≫ pY)]
      simp only [Category.assoc]
    _ = b ≫ Y.affineCover.f j ≫ schemeFrobeniusOver Y q pY := by
      rw [← Category.assoc, affineCover_f_schemeFrobeniusOver]
      simp only [Category.assoc]
    _ = a ≫ h ≫ schemeFrobeniusOver Y q pY := by
      simpa only [Category.assoc] using
        congrArg (fun z ↦ z ≫ schemeFrobeniusOver Y q pY) hab.symm

/-- Frobenius on the projective closure of a large Young quotient fiber. -/
noncomputable def
    largeYoungSymmetricResidueFiberProjectiveClosureFrobenius
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LargeYoungSymmetricResidueFiberProjectiveClosure
        q m g hg hdeg hm B i₀ hlarge t ht ⟶
      LargeYoungSymmetricResidueFiberProjectiveClosure
        q m g hg hdeg hm B i₀ hlarge t ht :=
  schemeFrobeniusOver
    (LargeYoungSymmetricResidueFiberProjectiveClosure
      q m g hg hdeg hm B i₀ hlarge t ht) q
    (largeYoungSymmetricResidueFiberProjectiveClosureProjection
      q m g hg hdeg hm B i₀ hlarge t ht)

/-- The canonical projective compactification is equivariant for scheme
Frobenius. -/
@[reassoc]
theorem largeYoungSymmetricResidueFiberProjectiveClosureOpen_frobenius
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    schemeFrobeniusOver
          (LargeYoungSymmetricResidueFiber
            (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) q
          (largeYoungSymmetricResidueFiberProjection
            (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) ≫
        largeYoungSymmetricResidueFiberProjectiveClosureOpen
          q m g hg hdeg hm B i₀ hlarge t ht =
      largeYoungSymmetricResidueFiberProjectiveClosureOpen
          q m g hg hdeg hm B i₀ hlarge t ht ≫
        largeYoungSymmetricResidueFiberProjectiveClosureFrobenius
          q m g hg hdeg hm B i₀ hlarge t ht := by
  unfold largeYoungSymmetricResidueFiberProjectiveClosureFrobenius
  exact schemeFrobeniusOver_naturality
    (largeYoungSymmetricResidueFiberProjectiveClosureOpen
      q m g hg hdeg hm B i₀ hlarge t ht) q
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureProjection
      q m g hg hdeg hm B i₀ hlarge t ht)

/-- The explicit isomorphism between two large Young quotient fibers
intertwines absolute Frobenius.  Thus its induced cohomological comparison
will preserve Frobenius, not merely the underlying vector spaces. -/
theorem largeYoungSymmetricResidueFiberTargetIso_frobenius
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t' : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht' : t' ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    schemeFrobeniusOver
        (LargeYoungSymmetricResidueFiber
          (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) ≫
      (largeYoungSymmetricResidueFiberTargetIso
        (ZMod q) m g hg hdeg hm B i₀ hlarge t t' ht ht').hom =
    (largeYoungSymmetricResidueFiberTargetIso
        (ZMod q) m g hg hdeg hm B i₀ hlarge t t' ht ht').hom ≫
      schemeFrobeniusOver
        (LargeYoungSymmetricResidueFiber
          (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht') q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht') := by
  exact schemeFrobeniusOver_naturality
    (largeYoungSymmetricResidueFiberTargetIso
      (ZMod q) m g hg hdeg hm B i₀ hlarge t t' ht ht').hom q
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht')

theorem specFrobeniusOverZMod_apply_point
    (q : ℕ) [Fact q.Prime] {R : Type} [CommRing R]
    (i : ZMod q →+* R) (x : Spec (.of R)) :
    Spec.map (CommRingCat.ofHom (frobeniusOverZMod q i)) x = x := by
  apply PrimeSpectrum.ext
  ext a
  change frobeniusOverZMod q i a ∈ x.asIdeal ↔ a ∈ x.asIdeal
  rw [frobeniusOverZMod_apply]
  exact x.2.pow_mem_iff_mem _
    (show 0 < q from (show q.Prime from Fact.out).pos)

theorem affineSchemeFrobeniusOver_apply
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) (x : X) :
    affineSchemeFrobeniusOver X q p x = x := by
  unfold affineSchemeFrobeniusOver
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
    specFrobeniusOverZMod_apply_point]
  have h := congrArg (fun f : X ⟶ X ↦ f x) X.isoSpec.hom_inv_id
  have hid : (𝟙 X : X ⟶ X) x = x := by
    change (𝟙 X : X ⟶ X).base x = x
    rw [Scheme.Hom.id_base]
    rfl
  exact h.trans hid

theorem schemeFrobeniusOver_apply
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) (x : X) :
    schemeFrobeniusOver X q p x = x := by
  obtain ⟨i, y, rfl⟩ := X.affineCover.exists_eq x
  rw [← Scheme.Hom.comp_apply,
    affineCover_f_schemeFrobeniusOver]
  simp only [Scheme.Hom.comp_apply, affineSchemeFrobeniusOver_apply]

theorem schemeFrobeniusOver_eq_affine
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    schemeFrobeniusOver X q p = affineSchemeFrobeniusOver X q p := by
  simpa using schemeFrobeniusOver_naturality_toAffine
    (X := X) (Y := X) (𝟙 X) q p p

/-- Arithmetic Frobenius on the algebraic-closure base is the globally
glued absolute Frobenius of its affine spectrum. -/
theorem geometricBaseArithmeticFrobenius_eq_schemeFrobeniusOver
    (q : ℕ) [Fact q.Prime] :
    geometricBaseArithmeticFrobenius q =
      schemeFrobeniusOver
        (Spec (.of (AlgebraicClosure (ZMod q)))) q
        (Scheme.ProEt.geometricPoint q) := by
  rw [schemeFrobeniusOver_eq_affine,
    affineSchemeFrobeniusOver_Spec q (Scheme.ProEt.geometricPoint q)
      (algebraMap (ZMod q) (AlgebraicClosure (ZMod q)))]
  unfold geometricBaseArithmeticFrobenius
  congr 1
  apply CommRingCat.hom_ext
  ext x
  change frobeniusEquiv (AlgebraicClosure (ZMod q)) q x =
    frobeniusOverZMod q
      (algebraMap (ZMod q) (AlgebraicClosure (ZMod q))) x
  rw [frobeniusOverZMod_apply]
  rfl

/-- The arithmetic base Frobenius may be moved through any geometric point
to become absolute Frobenius on the target scheme. -/
theorem geometricBaseArithmeticFrobenius_point_naturality
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    geometricBaseArithmeticFrobenius q ≫ x =
      x ≫ schemeFrobeniusOver X q p := by
  rw [geometricBaseArithmeticFrobenius_eq_schemeFrobeniusOver]
  exact schemeFrobeniusOver_naturality x q
    (Scheme.ProEt.geometricPoint q) p

@[simp]
theorem inv_geometricBaseFrobenius (q : ℕ) [Fact q.Prime] :
    inv (geometricBaseFrobenius q) =
      geometricBaseArithmeticFrobenius q := by
  unfold geometricBaseFrobenius
  simp

/-- With geometric Frobenius on the base, transported semilinear action on
a point is the ordinary `q`-power scheme Frobenius followed by the chosen
`F_q`-endomorphism. -/
theorem geometricRationalPointEquiv_geometricFrobeniusSemilinearAction
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p)
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    (geometricRationalPointEquiv X q p).symm
        (Scheme.ProEt.geometricRelativePointSemilinearAction X q p f hf
          (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
          (geometricRationalPointEquiv X q p x)) =
      x ≫ schemeFrobeniusOver X q p ≫ f := by
  calc
    _ = inv (geometricBaseFrobenius q) ≫ x ≫ f :=
      geometricRationalPointEquiv_semilinearAction
        X q p f hf (geometricBaseFrobenius q)
          (geometricBaseFrobenius_over q) x
    _ = geometricBaseArithmeticFrobenius q ≫ x ≫ f := by
      rw [inv_geometricBaseFrobenius]
    _ = x ≫ schemeFrobeniusOver X q p ≫ f :=
      congrArg (fun z => z ≫ f)
        (geometricBaseArithmeticFrobenius_point_naturality X q p x)

/-- Frobenius is a morphism over the prime field. -/
@[reassoc (attr := simp)]
theorem schemeFrobeniusOver_over
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    schemeFrobeniusOver X q p ≫ p = p := by
  rw [schemeFrobeniusOver_naturality p q p (𝟙 _)]
  rw [schemeFrobeniusOver_eq_affine,
    affineSchemeFrobeniusOver_specZMod_eq_id]
  simp

/-- The point action transported from geometric Frobenius is exactly the
usual permutation-twisted absolute Frobenius action. -/
theorem geometricFrobeniusTransport_eq_twistedSchemeFrobenius
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X)
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    inv (geometricBaseFrobenius q) ≫ x ≫ f =
      x ≫ f ≫ schemeFrobeniusOver X q p := by
  calc
    inv (geometricBaseFrobenius q) ≫ x ≫ f =
        geometricBaseArithmeticFrobenius q ≫ x ≫ f := by
      rw [inv_geometricBaseFrobenius]
    _ = (x ≫ schemeFrobeniusOver X q p) ≫ f :=
      congrArg (fun z => z ≫ f)
        (geometricBaseArithmeticFrobenius_point_naturality X q p x)
    _ =
        x ≫ (schemeFrobeniusOver X q p ≫ f) :=
      Category.assoc _ _ _
    _ =
        x ≫ (f ≫ schemeFrobeniusOver X q p) :=
      congrArg (fun z => x ≫ z)
        (schemeFrobeniusOver_naturality f q p p)
    _ = x ≫ f ≫ schemeFrobeniusOver X q p :=
      (Category.assoc _ _ _).symm

/-- Fixed points of permutation-twisted absolute Frobenius on an
`F_q`-scheme are the fixed relative points of geometric Frobenius on the
geometric fiber.  This is the exact point-side comparison required by the
canonical compact-support trace. -/
noncomputable def geometricFrobeniusTwistedFixedPointEquiv
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p) :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X //
        x ≫ f ≫ schemeFrobeniusOver X q p = x} ≃
      {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q p //
            y ≫ pullback.snd p (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
        Scheme.ProEt.geometricRelativePointSemilinearAction X q p f hf
          (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y} :=
  ({ toFun := fun x => ⟨x.1, by
        rw [geometricFrobeniusTransport_eq_twistedSchemeFrobenius]
        exact x.2⟩
     invFun := fun x => ⟨x.1, by
        rw [← geometricFrobeniusTransport_eq_twistedSchemeFrobenius]
        exact x.2⟩
     left_inv := fun _ => rfl
     right_inv := fun _ => rfl } :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X //
        x ≫ f ≫ schemeFrobeniusOver X q p = x} ≃
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X //
        inv (geometricBaseFrobenius q) ≫ x ≫ f = x}).trans
    (geometricSemilinearFixedPointEquiv X q p f hf
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q))

/-- Relative Frobenius of a weakly étale object over an affine
prime-field scheme. -/
noncomputable def relativeFrobeniusOver
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    U.left ⟶ pullback U.hom (affineSchemeFrobeniusOver X q p) :=
  pullback.lift
    (schemeFrobeniusOver U.left q (U.hom ≫ p)) U.hom
    (schemeFrobeniusOver_naturality_toAffine (X := U.left) (Y := X) U.hom q
      (U.hom ≫ p) p)

@[reassoc (attr := simp)]
theorem relativeFrobeniusOver_fst
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    relativeFrobeniusOver U q p ≫
        pullback.fst U.hom (affineSchemeFrobeniusOver X q p) =
      schemeFrobeniusOver U.left q (U.hom ≫ p) := by
  apply pullback.lift_fst

@[reassoc (attr := simp)]
theorem relativeFrobeniusOver_snd
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    relativeFrobeniusOver U q p ≫
        pullback.snd U.hom (affineSchemeFrobeniusOver X q p) = U.hom := by
  apply pullback.lift_snd

theorem relativeFrobeniusOver_weaklyEtale
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    WeaklyEtale (relativeFrobeniusOver U q p) := by
  let g := pullback.snd U.hom (affineSchemeFrobeniusOver X q p)
  have : WeaklyEtale g := inferInstance
  have : WeaklyEtale (relativeFrobeniusOver U q p ≫ g) := by
    rw [show relativeFrobeniusOver U q p ≫ g = U.hom by
      exact relativeFrobeniusOver_snd U q p]
    infer_instance
  exact WeaklyEtale.of_comp (relativeFrobeniusOver U q p) g

theorem relativeFrobeniusOver_integral_of_affine
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) [IsAffine U.left] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    IsIntegralHom (relativeFrobeniusOver U q p) := by
  let g := pullback.fst U.hom (affineSchemeFrobeniusOver X q p)
  let : IsIntegralHom (affineSchemeFrobeniusOver X q p) :=
    affineSchemeFrobeniusOver_integral X q p
  let : IsIntegralHom g := inferInstance
  let : IsSeparated g := IsSeparated.of_isAffineHom g
  have : IsIntegralHom (relativeFrobeniusOver U q p ≫ g) := by
    rw [show relativeFrobeniusOver U q p ≫ g =
        affineSchemeFrobeniusOver U.left q (U.hom ≫ p) by
      rw [relativeFrobeniusOver_fst,
        schemeFrobeniusOver_eq_affine]]
    exact affineSchemeFrobeniusOver_integral U.left q (U.hom ≫ p)
  exact IsIntegralHom.of_comp (relativeFrobeniusOver U q p) g

theorem relativeFrobeniusOver_surjective_of_affine
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) [IsAffine U.left] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    Surjective (relativeFrobeniusOver U q p) := by
  let r := relativeFrobeniusOver U q p
  let g := pullback.fst U.hom (affineSchemeFrobeniusOver X q p)
  let : UniversallyInjective (affineSchemeFrobeniusOver X q p) :=
    affineSchemeFrobeniusOver_universallyInjective X q p
  let : MorphismProperty.IsStableUnderBaseChange (@UniversallyInjective) :=
    UniversallyInjective.isStableUnderBaseChange
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@UniversallyInjective) U.hom :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  have hg : Function.Injective g := by
    let : UniversallyInjective g := by
      dsimp only [g]
      exact MorphismProperty.pullback_fst U.hom
        (affineSchemeFrobeniusOver X q p)
        (affineSchemeFrobeniusOver_universallyInjective X q p)
    exact g.injective
  have hrg : Function.Surjective (r ≫ g) := by
    rw [show r ≫ g = affineSchemeFrobeniusOver U.left q (U.hom ≫ p) by
      rw [relativeFrobeniusOver_fst,
        schemeFrobeniusOver_eq_affine]]
    exact (affineSchemeFrobeniusOver_surjective
      U.left q (U.hom ≫ p)).surj
  constructor
  intro y
  obtain ⟨x, hx⟩ := hrg (g y)
  refine ⟨x, hg ?_⟩
  simpa only [Scheme.Hom.comp_apply] using hx

theorem relativeFrobeniusOver_universallyInjective_of_affine
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) [IsAffine U.left] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    UniversallyInjective (relativeFrobeniusOver U q p) := by
  let r := relativeFrobeniusOver U q p
  let g := pullback.fst U.hom (affineSchemeFrobeniusOver X q p)
  have : UniversallyInjective (r ≫ g) := by
    rw [show r ≫ g = affineSchemeFrobeniusOver U.left q (U.hom ≫ p) by
      rw [relativeFrobeniusOver_fst,
        schemeFrobeniusOver_eq_affine]]
    exact affineSchemeFrobeniusOver_universallyInjective
      U.left q (U.hom ≫ p)
  apply ((tfae_universallyInjective r).out 0 1).mpr
  intro K _ a b h
  have hcompinj :
      ∀ (L : Type) [Field L],
        Function.Injective (fun z : Spec (.of L) ⟶ U.left ↦ z ≫ (r ≫ g)) :=
    ((tfae_universallyInjective (r ≫ g)).out 0 1).mp
      (inferInstance : UniversallyInjective (r ≫ g))
  apply hcompinj K
  simpa only [Category.assoc] using congrArg (fun z ↦ z ≫ g) h

noncomputable instance relativeFrobeniusOver_isIso_of_affine
    {X : Scheme} [IsAffine X]
    (U : X.ProEt) [IsAffine U.left] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    IsIso (relativeFrobeniusOver U q p) := by
  let : WeaklyEtale (relativeFrobeniusOver U q p) :=
    relativeFrobeniusOver_weaklyEtale U q p
  let : IsIntegralHom (relativeFrobeniusOver U q p) :=
    relativeFrobeniusOver_integral_of_affine U q p
  let : Surjective (relativeFrobeniusOver U q p) :=
    relativeFrobeniusOver_surjective_of_affine U q p
  let : UniversallyInjective (relativeFrobeniusOver U q p) :=
    relativeFrobeniusOver_universallyInjective_of_affine U q p
  exact AlgebraicGeometry.WeaklyEtale.isIso_of_integral_surjective_universallyInjective
    (relativeFrobeniusOver U q p)

/-! The affine weakly-étale subsite sees Frobenius base change as the
identity. -/

abbrev AffineProEt (X : Scheme.{u}) : Type (u + 1) :=
  MorphismProperty.CostructuredArrow
    (@WeaklyEtale.{u} : MorphismProperty Scheme.{u})
    (⊤ : MorphismProperty CommRingCat.{u}ᵒᵖ) Scheme.Spec.{u} X

noncomputable instance affineProEtCategory (X : Scheme.{u}) :
    Category.{u} (AffineProEt X) := by
  dsimp [AffineProEt]
  change Category.{u} (MorphismProperty.Comma
    Scheme.Spec.{u} (Functor.fromPUnit.{0} X)
      (@WeaklyEtale.{u} : MorphismProperty Scheme.{u})
      (⊤ : MorphismProperty CommRingCat.{u}ᵒᵖ) ⊤)
  exact MorphismProperty.Comma.instCategory _ _ _ _ _

set_option backward.isDefEq.respectTransparency.types false in
noncomputable instance affineProEtHasPullbacks (X : Scheme.{u}) :
    HasPullbacks (AffineProEt X) := by
  dsimp only [AffineProEt]
  infer_instance

local instance explicitProEtCategory (X : Scheme.{u}) :
    Category.{u} X.ProEt := X.instCategoryProEt

set_option backward.isDefEq.respectTransparency.types false in
noncomputable def affineProEtInclusion (X : Scheme.{u}) :
    CategoryTheory.Functor (AffineProEt X) X.ProEt where
  obj A := MorphismProperty.Over.mk ⊤ A.hom A.prop
  map h := MorphismProperty.Over.homMk (Scheme.Spec.map h.left) h.w
  map_id A := by
    apply MorphismProperty.Over.Hom.ext
    change Scheme.Spec.map (𝟙 A : A ⟶ A).left = 𝟙 _
    change Scheme.Spec.map (𝟙 A.left) = 𝟙 _
    exact Scheme.Spec.map_id A.left
  map_comp f g := by
    apply MorphismProperty.Over.Hom.ext
    change Scheme.Spec.map (f ≫ g).left =
      Scheme.Spec.map f.left ≫ Scheme.Spec.map g.left
    rw [MorphismProperty.Comma.comp_left, Functor.map_comp]

theorem relativeFrobeniusOver_naturality_of_affine
    {X : Scheme} [IsAffine X] {U V : X.ProEt}
    [IsAffine U.left] [IsAffine V.left]
    (h : U ⟶ V) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    h.left ≫ relativeFrobeniusOver V q p =
      relativeFrobeniusOver U q p ≫
        ((AlgebraicGeometry.Scheme.ProEt.baseChange
          (affineSchemeFrobeniusOver X q p)).map h).left := by
  let F := affineSchemeFrobeniusOver X q p
  let bh := ((AlgebraicGeometry.Scheme.ProEt.baseChange F).map h).left
  have hfst : bh ≫ pullback.fst V.hom F =
      pullback.fst U.hom F ≫ h.left := by
    change pullback.lift
        (pullback.fst U.hom F ≫ h.left)
        (pullback.snd U.hom F) _ ≫ pullback.fst V.hom F = _
    exact pullback.lift_fst _ _ _
  have hsnd : bh ≫ pullback.snd V.hom F =
      pullback.snd U.hom F := by
    change pullback.lift
        (pullback.fst U.hom F ≫ h.left)
        (pullback.snd U.hom F) _ ≫ pullback.snd V.hom F = _
    exact pullback.lift_snd _ _ _
  apply pullback.hom_ext
  · calc
      (h.left ≫ relativeFrobeniusOver V q p) ≫ pullback.fst V.hom F =
          h.left ≫ (relativeFrobeniusOver V q p ≫
            pullback.fst V.hom F) := Category.assoc _ _ _
      _ = h.left ≫ schemeFrobeniusOver V.left q (V.hom ≫ p) := by
        rw [relativeFrobeniusOver_fst]
      _ = h.left ≫ affineSchemeFrobeniusOver V.left q (V.hom ≫ p) := by
        rw [schemeFrobeniusOver_eq_affine]
      _ = affineSchemeFrobeniusOver U.left q (U.hom ≫ p) ≫ h.left :=
        (affineSchemeFrobeniusOver_naturality h.left q
          (U.hom ≫ p) (V.hom ≫ p)).symm
      _ = schemeFrobeniusOver U.left q (U.hom ≫ p) ≫ h.left := by
        rw [schemeFrobeniusOver_eq_affine]
      _ = (relativeFrobeniusOver U q p ≫ pullback.fst U.hom F) ≫
          h.left := by rw [relativeFrobeniusOver_fst]
      _ = relativeFrobeniusOver U q p ≫
          (pullback.fst U.hom F ≫ h.left) := Category.assoc _ _ _
      _ = relativeFrobeniusOver U q p ≫ (bh ≫ pullback.fst V.hom F) := by
        exact congrArg (fun k ↦ relativeFrobeniusOver U q p ≫ k) hfst.symm
      _ = (relativeFrobeniusOver U q p ≫ bh) ≫ pullback.fst V.hom F :=
        (Category.assoc _ _ _).symm
  · calc
      (h.left ≫ relativeFrobeniusOver V q p) ≫ pullback.snd V.hom F =
          h.left ≫ (relativeFrobeniusOver V q p ≫
            pullback.snd V.hom F) := Category.assoc _ _ _
      _ = h.left ≫ V.hom := by rw [relativeFrobeniusOver_snd]
      _ = U.hom := h.w
      _ = relativeFrobeniusOver U q p ≫ pullback.snd U.hom F :=
        (relativeFrobeniusOver_snd U q p).symm
      _ = relativeFrobeniusOver U q p ≫
          (bh ≫ pullback.snd V.hom F) := by
        exact congrArg (fun k ↦ relativeFrobeniusOver U q p ≫ k) hsnd.symm
      _ = (relativeFrobeniusOver U q p ≫ bh) ≫ pullback.snd V.hom F :=
        (Category.assoc _ _ _).symm

noncomputable def affineProEtRelativeFrobenius
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    affineProEtInclusion X ⟶
      affineProEtInclusion X ⋙
        AlgebraicGeometry.Scheme.ProEt.baseChange
          (affineSchemeFrobeniusOver X q p) where
  app A := MorphismProperty.Over.homMk
    (relativeFrobeniusOver ((affineProEtInclusion X).obj A) q p)
    (relativeFrobeniusOver_snd ((affineProEtInclusion X).obj A) q p)
  naturality := by
    intro A B h
    apply MorphismProperty.Over.Hom.ext
    let : IsAffine ((affineProEtInclusion X).obj A).left := by
      change IsAffine (Scheme.Spec.obj A.left)
      infer_instance
    let : IsAffine ((affineProEtInclusion X).obj B).left := by
      change IsAffine (Scheme.Spec.obj B.left)
      infer_instance
    exact relativeFrobeniusOver_naturality_of_affine
      ((affineProEtInclusion X).map h) q p

noncomputable def affineProEtRelativeFrobeniusIso
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    affineProEtInclusion X ≅
      affineProEtInclusion X ⋙
        AlgebraicGeometry.Scheme.ProEt.baseChange
          (affineSchemeFrobeniusOver X q p) :=
  NatIso.ofComponents
    (fun A ↦ by
      let U := (affineProEtInclusion X).obj A
      letI : IsAffine U.left := by
        change IsAffine (Scheme.Spec.obj A.left)
        infer_instance
      let r := relativeFrobeniusOver U q p
      exact MorphismProperty.Over.isoMk
        (@asIso _ _ _ _ r (relativeFrobeniusOver_isIso_of_affine U q p))
        (relativeFrobeniusOver_snd U q p))
    (by
      intro A B h
      exact (affineProEtRelativeFrobenius q p).naturality h)

noncomputable def affineProEtTopology (X : Scheme.{u}) :
    GrothendieckTopology (AffineProEt X) :=
  (affineProEtInclusion X).inducedTopology
    (AlgebraicGeometry.Scheme.ProEt.topology X)

set_option backward.isDefEq.respectTransparency.types false in
instance affineProEtInclusion_faithful (X : Scheme.{u}) :
    (affineProEtInclusion X).Faithful := by
  constructor
  intro A B f g h
  apply MorphismProperty.CostructuredArrow.Hom.ext
  exact Scheme.Spec.map_injective (congrArg (fun k ↦ k.left) h)

set_option backward.isDefEq.respectTransparency.types false in
instance affineProEtInclusion_full (X : Scheme.{u}) :
    (affineProEtInclusion X).Full := by
  constructor
  intro A B f
  refine ⟨MorphismProperty.CostructuredArrow.homMk
    (Scheme.Spec.preimage f.left) trivial ?_, ?_⟩
  · rw [Scheme.Spec.map_preimage]
    exact MorphismProperty.Over.w f
  · apply MorphismProperty.Over.Hom.ext
    exact Scheme.Spec.map_preimage f.left

set_option backward.isDefEq.respectTransparency.types false in
instance affineProEtInclusion_isCoverDense (X : Scheme.{u}) :
    (affineProEtInclusion X).IsCoverDense
      (AlgebraicGeometry.Scheme.ProEt.topology X) where
  is_cover U := by
    let 𝒰 := AlgebraicGeometry.Scheme.affineOpenCover U.left
    let 𝒱 : AlgebraicGeometry.Scheme.Cover
        (precoverage
          (@Etale : MorphismProperty Scheme.{u})) U.left :=
      𝒰.openCover.changeProp
        (fun i ↦ IsZariskiLocalAtSource.of_isOpenImmersion
          (P := @Etale) (𝒰.openCover.f i))
    let A (i : 𝒰.I₀) : AffineProEt X :=
      AlgebraicGeometry.Scheme.affineOverMk
        (𝒰.f i ≫ U.hom)
        (by
          let : WeaklyEtale (𝒰.f i) :=
            IsZariskiLocalAtSource.of_isOpenImmersion
              (P := @WeaklyEtale) (𝒰.f i)
          let : WeaklyEtale U.hom := U.prop
          infer_instance)
    let f (i : 𝒰.I₀) : (affineProEtInclusion X).obj (A i) ⟶ U :=
      MorphismProperty.Over.homMk (𝒰.f i) rfl
    apply (AlgebraicGeometry.Scheme.ProEt.topology X).superset_covering
      (S := Sieve.ofArrows (fun i ↦ (affineProEtInclusion X).obj (A i)) f)
    · intro Y g hg
      rw [Sieve.mem_ofArrows_iff] at hg
      obtain ⟨i, t, rfl⟩ := hg
      exact (Sieve.coverByImage (affineProEtInclusion X) U).downward_closed
        (Presieve.in_coverByImage (affineProEtInclusion X) (f i)) t
    · apply Precoverage.generate_mem_toGrothendieck
      rw [AlgebraicGeometry.Scheme.ProEt.precoverage,
        Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      apply AlgebraicGeometry.Scheme.etalePrecoverage_le_proetalePrecoverage
      exact 𝒱.mem₀

instance affineProEtInclusion_isDenseSubsite (X : Scheme.{u}) :
    Functor.IsDenseSubsite (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X)
      (affineProEtInclusion X) := by
  dsimp [affineProEtTopology]
  infer_instance

set_option backward.isDefEq.respectTransparency.types false in
instance affineProEtInclusion_isOneHypercoverDense (X : Scheme.{u}) :
    Functor.IsOneHypercoverDense.{u} (affineProEtInclusion X)
      (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X) :=
  Functor.IsOneHypercoverDense.of_hasPullbacks fun U ↦ by
    let 𝒰 := AlgebraicGeometry.Scheme.affineOpenCover U.left
    let 𝒱 : AlgebraicGeometry.Scheme.Cover
        (precoverage (@Etale : MorphismProperty Scheme.{u})) U.left :=
      𝒰.openCover.changeProp
        (fun i ↦ IsZariskiLocalAtSource.of_isOpenImmersion
          (P := @Etale) (𝒰.openCover.f i))
    let A (i : 𝒰.I₀) : AffineProEt X :=
      AlgebraicGeometry.Scheme.affineOverMk
        (𝒰.f i ≫ U.hom)
        (by
          let : WeaklyEtale (𝒰.f i) :=
            IsZariskiLocalAtSource.of_isOpenImmersion
              (P := @WeaklyEtale) (𝒰.f i)
          let : WeaklyEtale U.hom := U.prop
          infer_instance)
    let f (i : 𝒰.I₀) : (affineProEtInclusion X).obj (A i) ⟶ U :=
      MorphismProperty.Over.homMk (𝒰.f i) rfl
    refine ⟨𝒰.I₀, A, f, ?_⟩
    apply Precoverage.generate_mem_toGrothendieck
    rw [AlgebraicGeometry.Scheme.ProEt.precoverage,
      Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    apply AlgebraicGeometry.Scheme.etalePrecoverage_le_proetalePrecoverage
    exact 𝒱.mem₀

noncomputable def affineProEtRestriction (X : Scheme.{u}) :
    CategoryTheory.Functor
      (Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{u + 1})
      (Sheaf (affineProEtTopology X) Ab.{u + 1}) :=
  (affineProEtInclusion X).sheafPushforwardContinuous Ab.{u + 1}
    (affineProEtTopology X) (AlgebraicGeometry.Scheme.ProEt.topology X)

instance affineProEtRestriction_isEquivalence (X : Scheme.{u}) :
    (affineProEtRestriction X).IsEquivalence := by
  let : Functor.IsOneHypercoverDense.{u} (affineProEtInclusion X)
      (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X) :=
    affineProEtInclusion_isOneHypercoverDense X
  exact Functor.isEquivalence_of_isOneHypercoverDense.{u}
    (affineProEtInclusion X) (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{u + 1}

noncomputable def affineProEtRestrictedBaseChangeIso
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (A : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{1}) :
    (affineProEtRestriction X).obj A ≅
      (affineProEtRestriction X).obj
        ((AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).obj A) :=
  (fullyFaithfulSheafToPresheaf (affineProEtTopology X) Ab.{1}).preimageIso
    ((Functor.isoWhiskerRight
      ((Functor.opComp (affineProEtInclusion X)
        (AlgebraicGeometry.Scheme.ProEt.baseChange
          (affineSchemeFrobeniusOver X q p))).symm ≪≫
            NatIso.op (affineProEtRelativeFrobeniusIso q p)) A.val).symm ≪≫
        Functor.associator
          (affineProEtInclusion X).op
          (AlgebraicGeometry.Scheme.ProEt.baseChange
            (affineSchemeFrobeniusOver X q p)).op A.val)

noncomputable def proEtBaseChangeSheafIsoOfFrobenius
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (A : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{1}) :
    A ≅ (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
      (affineSchemeFrobeniusOver X q p)).obj A :=
  (Functor.FullyFaithful.ofFullyFaithful (affineProEtRestriction X)).preimageIso
    (affineProEtRestrictedBaseChangeIso q p A)

/-- Naturality of dense-subsite Frobenius descent on abelian pro-étale
sheaves. -/
theorem proEtBaseChangeSheafIsoOfFrobenius_hom_naturality
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    {A B : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{1}}
    (f : A ⟶ B) :
    f ≫ (proEtBaseChangeSheafIsoOfFrobenius q p B).hom =
      (proEtBaseChangeSheafIsoOfFrobenius q p A).hom ≫
        (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).map f := by
  apply (affineProEtRestriction X).map_injective
  apply (fullyFaithfulSheafToPresheaf
    (affineProEtTopology X) Ab.{1}).map_injective
  simp only [Functor.map_comp]
  unfold proEtBaseChangeSheafIsoOfFrobenius
  unfold affineProEtRestrictedBaseChangeIso
  simp only [Functor.FullyFaithful.preimageIso_hom,
    Functor.FullyFaithful.map_preimage]
  ext U x
  dsimp
  have h := f.hom.naturality
    ((affineProEtRelativeFrobeniusIso q p).inv.app U.unop).op
  have h' := congrArg AddCommGrpCat.Hom.hom h.symm
  exact congrArg (fun k ↦ k x) h'

/-- Inverse naturality for dense-subsite Frobenius descent. -/
theorem proEtBaseChangeSheafIsoOfFrobenius_inv_naturality
    {X : Scheme} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    {A B : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{1}}
    (f : A ⟶ B) :
    (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).map f ≫
        (proEtBaseChangeSheafIsoOfFrobenius q p B).inv =
      (proEtBaseChangeSheafIsoOfFrobenius q p A).inv ≫ f := by
  apply (cancel_epi
    (proEtBaseChangeSheafIsoOfFrobenius q p A).hom).1
  rw [← Category.assoc,
    ← proEtBaseChangeSheafIsoOfFrobenius_hom_naturality q p f]
  simp

/-! The coefficient sheaf itself lives one universe below the universe-lifted
compact-support category.  We therefore repeat the same dense-subsite
descent at that coefficient universe, form the Frobenius endomorphism there,
and only afterwards apply the universe-lift functor. -/

noncomputable def affineProEtRestrictionSmall (X : Scheme.{0}) :
    CategoryTheory.Functor
      (Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0})
      (Sheaf (affineProEtTopology X) Ab.{0}) :=
  (affineProEtInclusion X).sheafPushforwardContinuous Ab.{0}
    (affineProEtTopology X) (AlgebraicGeometry.Scheme.ProEt.topology X)

instance affineProEtRestrictionSmall_isEquivalence (X : Scheme.{0}) :
    (affineProEtRestrictionSmall X).IsEquivalence := by
  let : Functor.IsOneHypercoverDense.{0} (affineProEtInclusion X)
      (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X) :=
    affineProEtInclusion_isOneHypercoverDense X
  exact Functor.isEquivalence_of_isOneHypercoverDense.{0}
    (affineProEtInclusion X) (affineProEtTopology X)
      (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0}

noncomputable def affineProEtRestrictedBaseChangeIsoSmall
    {X : Scheme.{0}} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (A : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0}) :
    (affineProEtRestrictionSmall X).obj A ≅
      (affineProEtRestrictionSmall X).obj
        ((AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).obj A) :=
  (fullyFaithfulSheafToPresheaf (affineProEtTopology X) Ab.{0}).preimageIso
    ((Functor.isoWhiskerRight
      ((Functor.opComp (affineProEtInclusion X)
        (AlgebraicGeometry.Scheme.ProEt.baseChange
          (affineSchemeFrobeniusOver X q p))).symm ≪≫
            NatIso.op (affineProEtRelativeFrobeniusIso q p)) A.val).symm ≪≫
        Functor.associator
          (affineProEtInclusion X).op
          (AlgebraicGeometry.Scheme.ProEt.baseChange
            (affineSchemeFrobeniusOver X q p)).op A.val)

noncomputable def proEtBaseChangeSheafIsoOfFrobeniusSmall
    {X : Scheme.{0}} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (A : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0}) :
    A ≅ (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
      (affineSchemeFrobeniusOver X q p)).obj A :=
  (Functor.FullyFaithful.ofFullyFaithful
    (affineProEtRestrictionSmall X)).preimageIso
      (affineProEtRestrictedBaseChangeIsoSmall q p A)

theorem proEtBaseChangeSheafIsoOfFrobeniusSmall_hom_naturality
    {X : Scheme.{0}} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    {A B : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0}}
    (f : A ⟶ B) :
    f ≫ (proEtBaseChangeSheafIsoOfFrobeniusSmall q p B).hom =
      (proEtBaseChangeSheafIsoOfFrobeniusSmall q p A).hom ≫
        (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).map f := by
  apply (affineProEtRestrictionSmall X).map_injective
  apply (fullyFaithfulSheafToPresheaf
    (affineProEtTopology X) Ab.{0}).map_injective
  simp only [Functor.map_comp]
  unfold proEtBaseChangeSheafIsoOfFrobeniusSmall
  unfold affineProEtRestrictedBaseChangeIsoSmall
  simp only [Functor.FullyFaithful.preimageIso_hom,
    Functor.FullyFaithful.map_preimage]
  ext U x
  dsimp
  have h := f.hom.naturality
    ((affineProEtRelativeFrobeniusIso q p).inv.app U.unop).op
  have h' := congrArg AddCommGrpCat.Hom.hom h.symm
  exact congrArg (fun k ↦ k x) h'

theorem proEtBaseChangeSheafIsoOfFrobeniusSmall_inv_naturality
    {X : Scheme.{0}} [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    {A B : Sheaf (AlgebraicGeometry.Scheme.ProEt.topology X) Ab.{0}}
    (f : A ⟶ B) :
    (AlgebraicGeometry.Scheme.ProEt.baseChangeSheafPushforward
          (affineSchemeFrobeniusOver X q p)).map f ≫
        (proEtBaseChangeSheafIsoOfFrobeniusSmall q p B).inv =
      (proEtBaseChangeSheafIsoOfFrobeniusSmall q p A).inv ≫ f := by
  apply (cancel_epi
    (proEtBaseChangeSheafIsoOfFrobeniusSmall q p A).hom).1
  rw [← Category.assoc,
    ← proEtBaseChangeSheafIsoOfFrobeniusSmall_hom_naturality q p f]
  simp

/-- Frobenius on the actual rational `ℓ`-adic coefficient sheaf.  The first
factor is geometric pullback; the second factor identifies the base-changed
sheaf with the original sheaf by the independently constructed affine-site
descent isomorphism. -/
noncomputable def qEllAdicFrobeniusSheafEndomorphismRaw
    (X : Scheme.{0}) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] :
    X.qEllAdicSheafAb ℓ ⟶ X.qEllAdicSheafAb ℓ :=
  AlgebraicGeometry.Scheme.ProEt.qEllAdicCoefficientPullback
      (affineSchemeFrobeniusOver X q p) ℓ ≫
    (proEtBaseChangeSheafIsoOfFrobeniusSmall q p
      (X.qEllAdicSheafAb ℓ)).inv

theorem qEllAdicFrobeniusSheafEndomorphismRaw_scalar
    (X : Scheme.{0}) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    X.qEllAdicSheafAbScalar ℓ r ≫
        qEllAdicFrobeniusSheafEndomorphismRaw X q p ℓ =
      qEllAdicFrobeniusSheafEndomorphismRaw X q p ℓ ≫
        X.qEllAdicSheafAbScalar ℓ r := by
  unfold qEllAdicFrobeniusSheafEndomorphismRaw
  rw [← Category.assoc,
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCoefficientPullback_scalar,
    AlgebraicGeometry.Scheme.ProEt.baseChangedQEllAdicSheafScalar,
    Category.assoc,
    proEtBaseChangeSheafIsoOfFrobeniusSmall_inv_naturality,
    ← Category.assoc]

/-- Universe-lifted Frobenius endomorphism used by extension by zero. -/
noncomputable def qEllAdicFrobeniusSheafEndomorphism
    (X : Scheme.{0}) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] :
    AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift X ℓ ⟶
      AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift X ℓ :=
  (sheafCompose (AlgebraicGeometry.Scheme.ProEt.topology X)
    AddCommGrpCat.uliftFunctor.{1}).map
      (qEllAdicFrobeniusSheafEndomorphismRaw X q p ℓ)

theorem qEllAdicFrobeniusSheafEndomorphism_scalar
    (X : Scheme.{0}) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbScalarULift X ℓ r ≫
        qEllAdicFrobeniusSheafEndomorphism X q p ℓ =
      qEllAdicFrobeniusSheafEndomorphism X q p ℓ ≫
        AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbScalarULift X ℓ r := by
  unfold qEllAdicFrobeniusSheafEndomorphism
    AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbScalarULift
    AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift
  rw [← (sheafCompose (AlgebraicGeometry.Scheme.ProEt.topology X)
      AddCommGrpCat.uliftFunctor.{1}).map_comp,
    qEllAdicFrobeniusSheafEndomorphismRaw_scalar,
    (sheafCompose (AlgebraicGeometry.Scheme.ProEt.topology X)
      AddCommGrpCat.uliftFunctor.{1}).map_comp]

/-- Frobenius on `j_! Q_ℓ` for any open compactification of an affine
scheme over the prime field. -/
noncomputable def qEllAdicCompactSupportFrobeniusEndomorphism
    {X Xbar : Scheme.{0}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] :
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportSheaf j ℓ ⟶
      AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportSheaf j ℓ :=
  (AlgebraicGeometry.Scheme.ProEt.lowerShriek j).map
    (qEllAdicFrobeniusSheafEndomorphism X q p ℓ)

set_option backward.isDefEq.respectTransparency.types false in
theorem qEllAdicCompactSupportFrobeniusEndomorphism_scalar
    {X Xbar : Scheme.{0}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportScalar j ℓ r ≫
        qEllAdicCompactSupportFrobeniusEndomorphism j q p ℓ =
      qEllAdicCompactSupportFrobeniusEndomorphism j q p ℓ ≫
        AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportScalar j ℓ r := by
  unfold qEllAdicCompactSupportFrobeniusEndomorphism
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportScalar
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportSheaf
  rw [← (AlgebraicGeometry.Scheme.ProEt.lowerShriek j).map_comp,
    qEllAdicFrobeniusSheafEndomorphism_scalar,
    (AlgebraicGeometry.Scheme.ProEt.lowerShriek j).map_comp]

/-- The induced scalar-linear Frobenius action on compactly supported
rational `ℓ`-adic cohomology. -/
noncomputable def qEllAdicCompactSupportFrobeniusLinearMap
    {S X Xbar : Scheme.{0}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar] [IsAffine X]
    (q : ℕ) [Fact q.Prime] (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree :=
  AlgebraicGeometry.Scheme.ProEt.compactlySupportedQEllAdicCohomologyLinearMap
    j pbar ℓ degree
    (qEllAdicCompactSupportFrobeniusEndomorphism j q p ℓ)
    (qEllAdicCompactSupportFrobeniusEndomorphism_scalar j q p ℓ)

/-- Pullback by absolute scheme Frobenius on the geometric fiber.  This
universal-homeomorphism action is kept separate from the Galois Frobenius
used by the arithmetic trace formula below. -/
noncomputable def geometricCompactSupportAbsoluteFrobeniusLinearMap
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q))) [IsAffine X]
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree :=
  qEllAdicCompactSupportFrobeniusLinearMap
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
      q pX j pbar hj)
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection q pbar)
    q
    (pullback.fst pX
      (AlgebraicGeometry.Scheme.ProEt.geometricPoint q) ≫ pX)
    ℓ degree

/-- Galois Frobenius on geometric compact-support cohomology.  It is the
equivariant action induced by `x ↦ x^q` on the algebraic-closure factor,
and hence is the Frobenius whose traces occur in Grothendieck--Lefschetz. -/
noncomputable def geometricCompactSupportFrobeniusLinearMap
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree :=
  AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapOfEquivariantIso
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
      q pX j pbar hj)
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection q pbar)
    (AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap
      q pX (geometricBaseFrobenius q) (geometricBaseFrobenius_over q))
    (AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap
      q pbar (geometricBaseFrobenius q) (geometricBaseFrobenius_over q))
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen_base_equivariant
      q pX j pbar hj (geometricBaseFrobenius q)
      (geometricBaseFrobenius_over q)) ℓ degree

/-- The basis-independent trace of compactly supported Frobenius. -/
noncomputable def qEllAdicCompactSupportFrobeniusTrace
    {S X Xbar : Scheme.{0}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar] [IsAffine X]
    (q : ℕ) [Fact q.Prime] (p : X ⟶ Spec (.of (ZMod q)))
    (ℓ degree : ℕ) [Fact ℓ.Prime]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)] : ℚ_[ℓ] :=
  AlgebraicGeometry.Scheme.ProEt.compactlySupportedQEllAdicCohomologyTrace
    j pbar ℓ degree
    (qEllAdicCompactSupportFrobeniusEndomorphism j q p ℓ)
    (qEllAdicCompactSupportFrobeniusEndomorphism_scalar j q p ℓ)

/-- The scalar-linear compact-support Frobenius action on an actual full
residue-unit fiber. -/
noncomputable def fullResidueUnitFiberQEllAdicCompactSupportFrobeniusLinearMap
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar] :
    AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree :=
  qEllAdicCompactSupportFrobeniusLinearMap j pbar q
    (fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t) ℓ degree

/-- The basis-independent `Q_ℓ`-valued trace of Frobenius on the actual
full residue-unit fiber. -/
noncomputable def fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)] : ℚ_[ℓ] :=
  qEllAdicCompactSupportFrobeniusTrace j pbar q
    (fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t) ℓ degree

/-- Compactly supported rational `ℓ`-adic cohomology of a literal residue
fiber, formed using its canonical scheme-theoretic projective closure. -/
instance fullResidueUnitFiberProjectiveClosureOpen_isOpenImmersion_instance
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsOpenImmersion
      (fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t) :=
  fullResidueUnitFiberProjectiveClosureOpen_isOpenImmersion
    q n m g hg hdeg hm hmn t

instance fullResidueUnitFiberProjectiveClosureProjection_isProper_instance
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsProper
      (fullResidueUnitFiberProjectiveClosureProjection
        q n m g hg hdeg hm hmn t) :=
  fullResidueUnitFiberProjectiveClosureProjection_isProper
    q n m g hg hdeg hm hmn t

noncomputable abbrev
    FullResidueUnitFiberCanonicalQEllAdicCompactSupportCohomology
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :=
  AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
    (fullResidueUnitFiberProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjectiveClosureProjection
      q n m g hg hdeg hm hmn t) ℓ degree

/-- Frobenius on the canonical compact-support cohomology of a literal
residue fiber. -/
noncomputable def
    fullResidueUnitFiberCanonicalQEllAdicCompactSupportFrobeniusLinearMap
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberCanonicalQEllAdicCompactSupportCohomology
        q n m ℓ degree g hg hdeg hm hmn t →ₗ[ℚ_[ℓ]]
      FullResidueUnitFiberCanonicalQEllAdicCompactSupportCohomology
        q n m ℓ degree g hg hdeg hm hmn t := by
  letI : IsOpenImmersion
      (fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberProjectiveClosureOpen_isOpenImmersion
      q n m g hg hdeg hm hmn t
  letI : IsProper
      (fullResidueUnitFiberProjectiveClosureProjection
        q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberProjectiveClosureProjection_isProper
      q n m g hg hdeg hm hmn t
  exact fullResidueUnitFiberQEllAdicCompactSupportFrobeniusLinearMap
    q n m ℓ degree g hg hdeg hm hmn t
    (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t)
    (Spec (.of (ZMod q)))
    (fullResidueUnitFiberProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)

/-- Basis-independent Frobenius trace on the canonical compact-support
cohomology of a literal residue fiber. -/
noncomputable def
    fullResidueUnitFiberCanonicalQEllAdicCompactSupportFrobeniusTrace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [FiniteDimensional ℚ_[ℓ]
      (FullResidueUnitFiberCanonicalQEllAdicCompactSupportCohomology
        q n m ℓ degree g hg hdeg hm hmn t)] : ℚ_[ℓ] := by
  letI : IsOpenImmersion
      (fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberProjectiveClosureOpen_isOpenImmersion
      q n m g hg hdeg hm hmn t
  letI : IsProper
      (fullResidueUnitFiberProjectiveClosureProjection
        q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberProjectiveClosureProjection_isProper
      q n m g hg hdeg hm hmn t
  exact fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
    q n m ℓ degree g hg hdeg hm hmn t
    (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t)
    (Spec (.of (ZMod q)))
    (fullResidueUnitFiberProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)

/-- The identity matrix on the finite type of Frobenius-fixed geometric
points.  Its trace is the fixed-point side of Grothendieck--Lefschetz, now
over the same `Q_ℓ` coefficient field as compactly supported cohomology. -/
noncomputable def fullResidueUnitFiberFixedGeometricPointTraceMatrix
    (q n m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Matrix
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t = x}
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t = x}
      ℚ_[ℓ] := by
  classical
  exact 1

/-- The fixed-geometric-point trace is exactly the number of rational
points of the literal residue-unit fiber. -/
theorem fullResidueUnitFiberFixedGeometricPointTraceMatrix_trace
    (q n m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    letI : Fintype
        {x : Spec (.of F) ⟶
            FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
          x ≫ fullResidueUnitFiberFrobenius
            q n m g hg hdeg hm hmn t = x} := Fintype.ofFinite _
    (fullResidueUnitFiberFixedGeometricPointTraceMatrix
      q n m ℓ F g hg hdeg hm hmn t).trace =
      (Nat.card (Spec (.of (ZMod q)) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) : ℚ_[ℓ]) := by
  let : Fintype
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t = x} := Fintype.ofFinite _
  rw [fullResidueUnitFiber_rationalPoint_natCard_eq_fixedGeometricPoint
    q n m F g hg hdeg hm hmn t]
  unfold fullResidueUnitFiberFixedGeometricPointTraceMatrix Matrix.trace
  simp

/-- Alternating trace of compactly supported Frobenius on an actual full
residue-unit fiber, through a prescribed cohomological cutoff.  The
finite-dimensionality hypotheses are indexed only over the finitely many
degrees which occur in the sum. -/
noncomputable def fullResidueUnitFiberQEllAdicAlternatingTrace
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ degree)] : ℚ_[ℓ] :=
  ∑ degree : Fin (topDegree + 1),
    (-1 : ℚ_[ℓ]) ^ (degree : ℕ) *
      letI := hfinite degree
      fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar

/-- If all terms of a finite alternating trace vanish outside two distinct
degrees, the alternating trace is the signed sum of exactly those terms.
This is the algebraic two-degree-collapse step used after Sawin's
perverse-sheaf concentration theorem. -/
theorem alternating_sum_eq_two_degrees
    {R : Type*} [CommRing R] (f : ℕ → R) (top lower upper : ℕ)
    (hlower : lower ≤ top) (hupper : upper ≤ top) (hne : lower ≠ upper)
    (hzero : ∀ i ≤ top, i ≠ lower → i ≠ upper → f i = 0) :
    ∑ i : Fin (top + 1), (-1 : R) ^ (i : ℕ) * f i =
      (-1 : R) ^ lower * f lower + (-1 : R) ^ upper * f upper := by
  classical
  calc
    ∑ i : Fin (top + 1), (-1 : R) ^ (i : ℕ) * f i =
        ∑ i ∈ Finset.range (top + 1), (-1 : R) ^ i * f i := by
      simpa using (Fin.sum_univ_eq_sum_range
        (fun i : ℕ ↦ (-1 : R) ^ i * f i) (top + 1))
    _ =
        ∑ i ∈ Finset.range (top + 1),
          if i = lower then (-1 : R) ^ lower * f lower
          else if i = upper then (-1 : R) ^ upper * f upper else 0 := by
      apply Finset.sum_congr rfl
      intro i hi
      simp only [Finset.mem_range] at hi
      by_cases hil : i = lower
      · simp [hil]
      · by_cases hiu : i = upper
        · simp [hiu, Ne.symm hne]
        · simp [hil, hiu, hzero i (by omega) hil hiu]
    _ =
        (∑ i ∈ Finset.range (top + 1),
          if i = lower then (-1 : R) ^ lower * f lower else 0) +
        (∑ i ∈ Finset.range (top + 1),
          if i = upper then (-1 : R) ^ upper * f upper else 0) := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hil : i = lower
      · simp [hil, hne]
      · simp [hil]
    _ = (-1 : R) ^ lower * f lower +
        (-1 : R) ^ upper * f upper := by
      rw [Finset.sum_ite_eq', Finset.sum_ite_eq']
      simp only [Finset.mem_range]
      simp [hlower, hupper]

/-- Specialization of `alternating_sum_eq_two_degrees` to the honest
compact-support Frobenius trace on a full residue-unit fiber.  This is the
exact algebraic conclusion of the source's two-adjacent-degree vanishing
statement, before applying bounds to the two remaining traces. -/
theorem fullResidueUnitFiberQEllAdicAlternatingTrace_eq_two_degrees
    (q n m ℓ topDegree lower upper : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ degree)]
    (hlower : lower ≤ topDegree) (hupper : upper ≤ topDegree)
    (hne : lower ≠ upper)
    (hzero : ∀ degree ≤ topDegree, degree ≠ lower → degree ≠ upper →
      fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar = 0) :
    fullResidueUnitFiberQEllAdicAlternatingTrace
        q n m ℓ topDegree g hg hdeg hm hmn t Xbar S j pbar =
      (-1 : ℚ_[ℓ]) ^ lower *
          fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
            q n m ℓ lower g hg hdeg hm hmn t Xbar S j pbar +
        (-1 : ℚ_[ℓ]) ^ upper *
          fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
            q n m ℓ upper g hg hdeg hm hmn t Xbar S j pbar := by
  unfold fullResidueUnitFiberQEllAdicAlternatingTrace
  exact alternating_sum_eq_two_degrees
    (fun degree ↦
      fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar)
    topDegree lower upper hlower hupper hne hzero

/-- In Sawin's ordered-root map, the relative dimension is `n - m`, and the
perverse concentration theorem leaves precisely degrees `n - m` and
`n + 1 - m` inside the usual compact-support range `0,…,2(n-m)`. -/
theorem fullResidueUnitFiberQEllAdicAlternatingTrace_eq_sawin_degrees
    (q n m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m < n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn.le t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ degree)]
    (hzero : ∀ degree ≤ 2 * (n - m),
      degree ≠ n - m → degree ≠ n + 1 - m →
      fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ degree g hg hdeg hm hmn.le t Xbar S j pbar = 0) :
    fullResidueUnitFiberQEllAdicAlternatingTrace
        q n m ℓ (2 * (n - m)) g hg hdeg hm hmn.le t Xbar S j pbar =
      (-1 : ℚ_[ℓ]) ^ (n - m) *
          fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
            q n m ℓ (n - m) g hg hdeg hm hmn.le t Xbar S j pbar +
        (-1 : ℚ_[ℓ]) ^ (n + 1 - m) *
          fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
            q n m ℓ (n + 1 - m) g hg hdeg hm hmn.le t Xbar S j pbar := by
  apply fullResidueUnitFiberQEllAdicAlternatingTrace_eq_two_degrees
    q n m ℓ (2 * (n - m)) (n - m) (n + 1 - m)
    g hg hdeg hm hmn.le t Xbar S j pbar
  · omega
  · omega
  · omega
  · exact hzero

end SawinGeometry

end Erdos157

/-! ### The empty-fiber case of the compact-support trace formula -/

open AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.ProEt

universe u

/-- The rational coefficient sheaf on an empty scheme is the zero object. -/
lemma isZero_qEllAdicSheafAb_of_isEmpty
    (X : Scheme.{u}) [IsEmpty X] (ℓ : ℕ) [Fact ℓ.Prime] :
    IsZero (X.qEllAdicSheafAb ℓ) :=
  (Sheaf.isTerminalOfEqTop (topology_eq_top_of_isEmpty X) _).isZero

/-- Universe lifting preserves the zero coefficient sheaf. -/
lemma isZero_qEllAdicSheafAbULift_of_isEmpty
    (X : Scheme.{u}) [IsEmpty X] (ℓ : ℕ) [Fact ℓ.Prime] :
    IsZero (qEllAdicSheafAbULift X ℓ) := by
  exact Functor.map_isZero _ (isZero_qEllAdicSheafAb_of_isEmpty X ℓ)

/-- Extension by zero from an empty open subscheme is zero. -/
lemma isZero_qEllAdicCompactSupportSheaf_of_isEmpty
    {X Xbar : Scheme.{u}} [IsEmpty X]
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (ℓ : ℕ) [Fact ℓ.Prime] :
    IsZero (qEllAdicCompactSupportSheaf j ℓ) := by
  exact Functor.map_isZero _ (isZero_qEllAdicSheafAbULift_of_isEmpty X ℓ)

noncomputable instance compactlySupportedQEllAdicCohomology_subsingleton_of_isEmpty
    {S X Xbar : Scheme.{u}} [IsEmpty X]
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    Subsingleton (CompactlySupportedQEllAdicCohomology
      j pbar ℓ degree) := by
  apply Sheaf.subsingleton_H_of_isZero
  exact isZero_qEllAdicCompactSupportSheaf_of_isEmpty j ℓ

noncomputable instance compactlySupportedQEllAdicCohomology_finiteDimensional_of_isEmpty
    {S X Xbar : Scheme.{u}} [IsEmpty X]
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    FiniteDimensional ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree) := by
  infer_instance

/-- Every compact-support cohomological trace on an empty scheme is zero. -/
theorem compactlySupportedQEllAdicCohomologyTrace_eq_zero_of_isEmpty
    {S X Xbar : Scheme.{u}} [IsEmpty X]
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime]
    (f : qEllAdicCompactSupportSheaf j ℓ ⟶
      qEllAdicCompactSupportSheaf j ℓ)
    (hf : ∀ r : ℚ_[ℓ],
      qEllAdicCompactSupportScalar j ℓ r ≫ f =
        f ≫ qEllAdicCompactSupportScalar j ℓ r) :
    compactlySupportedQEllAdicCohomologyTrace
      j pbar ℓ degree f hf = 0 := by
  apply Erdos157.SawinSpecialization.trace_eq_zero_of_finrank_eq_zero
  exact Module.finrank_zero_of_subsingleton

end AlgebraicGeometry.Scheme.ProEt

namespace Erdos157.SawinGeometry

/-- Degreewise Frobenius trace vanishes on an empty full residue fiber. -/
theorem fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace_eq_zero_of_isEmpty
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [IsEmpty (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t)]
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar] :
    fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
      q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar = 0 := by
  exact AlgebraicGeometry.Scheme.ProEt.compactlySupportedQEllAdicCohomologyTrace_eq_zero_of_isEmpty
    j pbar ℓ degree _ _

/-- The complete alternating compact-support trace vanishes on an empty
full residue fiber. -/
theorem fullResidueUnitFiberQEllAdicAlternatingTrace_eq_zero_of_isEmpty
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [IsEmpty (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t)]
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar] :
    fullResidueUnitFiberQEllAdicAlternatingTrace
      q n m ℓ topDegree g hg hdeg hm hmn t Xbar S j pbar = 0 := by
  unfold fullResidueUnitFiberQEllAdicAlternatingTrace
  apply Finset.sum_eq_zero
  intro degree _hdegree
  rw [fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace_eq_zero_of_isEmpty,
    mul_zero]

noncomputable instance fullResidueUnitFiberRationalPoint_isEmpty_of_isEmpty
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [IsEmpty (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t)] :
    IsEmpty (Spec (.of (ZMod q)) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :=
  ⟨fun f ↦ isEmptyElim
    (f.base (Classical.choice
      (inferInstance : Nonempty (Spec (.of (ZMod q))))))⟩

/-- An empty full residue fiber has no rational points. -/
theorem fullResidueUnitFiber_rationalPoint_natCard_eq_zero_of_isEmpty
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [IsEmpty (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t)] :
    Nat.card (Spec (.of (ZMod q)) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) = 0 := by
  exact Nat.card_of_isEmpty

/-- Grothendieck--Lefschetz for an empty full residue-unit fiber: both the
alternating compact-support trace and the rational fixed-point count are
zero, with all coefficient and finiteness instances constructed above. -/
theorem fullResidueUnitFiber_grothendieckLefschetz_of_isEmpty
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    [IsEmpty (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t)]
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar] :
    fullResidueUnitFiberQEllAdicAlternatingTrace
        q n m ℓ topDegree g hg hdeg hm hmn t Xbar S j pbar =
      (Nat.card (Spec (.of (ZMod q)) ⟶
        FullResidueUnitFiber
          (ZMod q) n m g hg hdeg hm hmn t) : ℚ_[ℓ]) := by
  rw [fullResidueUnitFiberQEllAdicAlternatingTrace_eq_zero_of_isEmpty,
    fullResidueUnitFiber_rationalPoint_natCard_eq_zero_of_isEmpty]
  norm_num



end Erdos157.SawinGeometry

namespace AlgebraicGeometry.Scheme.ProEt


local instance rawCategoryExplicit (X : Scheme.{u}) : Category.{u} (Raw X) := by
  exact X.instCategoryProEt


noncomputable def baseChangeUnitSection
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    U.left ⟶ pullback U.hom f :=
  pullback.lift (𝟙 _) (U.hom ≫ inv f) (by simp)

@[reassoc]
theorem baseChangeUnitSection_fst
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    baseChangeUnitSection f U ≫ pullback.fst U.hom f = 𝟙 _ :=
  pullback.lift_fst _ _ _

@[reassoc]
theorem baseChangeUnitSection_snd
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    baseChangeUnitSection f U ≫ pullback.snd U.hom f = U.hom ≫ inv f :=
  pullback.lift_snd _ _ _

noncomputable def baseChangeUnitComponentIsoExplicit
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    U ≅ (baseChange f ⋙ baseChange (inv f)).obj U := by
  let s := baseChangeUnitSection f U
  have hs : pullback.fst U.hom f ≫ s = 𝟙 _ := by
    apply pullback.hom_ext
    · slice_lhs 2 3 => rw [baseChangeUnitSection_fst]
      simp
    · slice_lhs 2 3 => rw [baseChangeUnitSection_snd]
      slice_lhs 1 2 => rw [pullback.condition]
      simp
  let e : U.left ≅ pullback (pullback.snd U.hom f) (inv f) := {
    hom := pullback.lift s U.hom (by
      exact baseChangeUnitSection_snd f U)
    inv := pullback.fst (pullback.snd U.hom f) (inv f) ≫
      pullback.fst U.hom f
    hom_inv_id := by
      rw [pullback.lift_fst_assoc]
      exact baseChangeUnitSection_fst f U
    inv_hom_id := by
      apply pullback.hom_ext
      · slice_lhs 3 4 => rw [pullback.lift_fst]
        slice_lhs 2 3 => rw [hs]
        simp
      · slice_lhs 3 4 => rw [pullback.lift_snd]
        slice_lhs 2 3 => rw [pullback.condition]
        slice_lhs 1 2 => rw [pullback.condition]
        simp }
  exact MorphismProperty.Over.isoMk e (pullback.lift_snd _ _ _)

@[reassoc]
theorem baseChangeUnitComponentIsoExplicit_hom_left_fst
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    (baseChangeUnitComponentIsoExplicit f U).hom.left ≫
        pullback.fst ((proEtToRaw X).obj ((baseChange f).obj U)).hom (inv f) =
      baseChangeUnitSection f U := by
  exact pullback.lift_fst _ _ _

@[reassoc]
theorem baseChangeUnitComponentIsoExplicit_hom_left_snd
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    (baseChangeUnitComponentIsoExplicit f U).hom.left ≫
        pullback.snd ((proEtToRaw X).obj ((baseChange f).obj U)).hom (inv f) = U.hom := by
  exact pullback.lift_snd _ _ _

noncomputable def baseChangeUnitIsoExplicit
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    𝟭 Y.ProEt ≅ baseChange f ⋙ baseChange (inv f) := by
  refine NatIso.ofComponents (baseChangeUnitComponentIsoExplicit f) ?_
  intro U V k
  apply MorphismProperty.Over.Hom.ext
  change k.left ≫ (baseChangeUnitComponentIsoExplicit f V).hom.left =
    (baseChangeUnitComponentIsoExplicit f U).hom.left ≫
      ((baseChange (inv f)).map ((baseChange f).map k)).left
  have hinnerFst := baseChange_map_left_fst f k
  have hinnerSnd := MorphismProperty.Over.w ((baseChange f).map k)
  have hsection :
      k.left ≫ baseChangeUnitSection f V =
        baseChangeUnitSection f U ≫ ((baseChange f).map k).left := by
    apply pullback.hom_ext
    · calc
        (k.left ≫ baseChangeUnitSection f V) ≫ pullback.fst V.hom f =
            k.left ≫ (baseChangeUnitSection f V ≫ pullback.fst V.hom f) :=
          Category.assoc _ _ _
        _ = k.left := by rw [baseChangeUnitSection_fst, Category.comp_id]
        _ = (baseChangeUnitSection f U ≫ pullback.fst U.hom f) ≫ k.left := by
          rw [baseChangeUnitSection_fst, Category.id_comp]
        _ = baseChangeUnitSection f U ≫
            (pullback.fst U.hom f ≫ k.left) := Category.assoc _ _ _
        _ = baseChangeUnitSection f U ≫
            (((baseChange f).map k).left ≫ pullback.fst V.hom f) := by
          exact congrArg (fun z => baseChangeUnitSection f U ≫ z)
            hinnerFst.symm
        _ = (baseChangeUnitSection f U ≫ ((baseChange f).map k).left) ≫
            pullback.fst V.hom f := (Category.assoc _ _ _).symm
    · calc
        (k.left ≫ baseChangeUnitSection f V) ≫ pullback.snd V.hom f =
            k.left ≫ (baseChangeUnitSection f V ≫ pullback.snd V.hom f) :=
          Category.assoc _ _ _
        _ = k.left ≫ (V.hom ≫ inv f) := by rw [baseChangeUnitSection_snd]
        _ = (k.left ≫ V.hom) ≫ inv f := (Category.assoc _ _ _).symm
        _ = U.hom ≫ inv f := by rw [MorphismProperty.Over.w k]
        _ = baseChangeUnitSection f U ≫ pullback.snd U.hom f :=
          (baseChangeUnitSection_snd f U).symm
        _ = baseChangeUnitSection f U ≫
            (((baseChange f).map k).left ≫ pullback.snd V.hom f) := by
          exact congrArg (fun z => baseChangeUnitSection f U ≫ z)
            hinnerSnd.symm
        _ = (baseChangeUnitSection f U ≫ ((baseChange f).map k).left) ≫
            pullback.snd V.hom f := (Category.assoc _ _ _).symm
  have houterFst := baseChange_map_left_fst (inv f) ((baseChange f).map k)
  have houterSnd := MorphismProperty.Over.w
    ((baseChange (inv f)).map ((baseChange f).map k))
  have hcomponentV :=
    baseChangeUnitComponentIsoExplicit_hom_left_fst f V
  have hfirst := congrArg (fun z => k.left ≫ z) hcomponentV
  let componentU := (baseChangeUnitComponentIsoExplicit f U).hom.left
  let componentV := (baseChangeUnitComponentIsoExplicit f V).hom.left
  let innerMap := ((baseChange f).map k).left
  let outerMap := ((baseChange (inv f)).map ((baseChange f).map k)).left
  let outerFstU :=
    pullback.fst ((proEtToRaw X).obj ((baseChange f).obj U)).hom (inv f)
  let outerFstV :=
    pullback.fst ((proEtToRaw X).obj ((baseChange f).obj V)).hom (inv f)
  let outerSndU :=
    pullback.snd ((proEtToRaw X).obj ((baseChange f).obj U)).hom (inv f)
  let outerSndV :=
    pullback.snd ((proEtToRaw X).obj ((baseChange f).obj V)).hom (inv f)
  have houterFst' : outerMap ≫ outerFstV = outerFstU ≫ innerMap :=
    houterFst
  have houterSnd' : outerMap ≫ outerSndV = outerSndU := houterSnd
  have hleftFst : (k.left ≫ componentV) ≫ outerFstV =
      k.left ≫ baseChangeUnitSection f V :=
    (Category.assoc _ _ _).trans hfirst
  have hcomponentU :=
    baseChangeUnitComponentIsoExplicit_hom_left_fst f U
  have hrightFst : (componentU ≫ outerMap) ≫ outerFstV =
      baseChangeUnitSection f U ≫ innerMap := by
    exact (Category.assoc _ _ _).trans
      ((congrArg (fun z => componentU ≫ z) houterFst').trans
        ((Category.assoc _ _ _).symm.trans
          (congrArg (fun z => z ≫ innerMap) hcomponentU)))
  have hcomponentVSnd :=
    baseChangeUnitComponentIsoExplicit_hom_left_snd f V
  have hleftSnd : (k.left ≫ componentV) ≫ outerSndV = U.hom := by
    calc
      (k.left ≫ componentV) ≫ outerSndV =
          k.left ≫ (componentV ≫ outerSndV) := Category.assoc _ _ _
      _ = k.left ≫ V.hom := congrArg (fun z => k.left ≫ z) hcomponentVSnd
      _ = U.hom := MorphismProperty.Over.w k
  have hcomponentUSnd :=
    baseChangeUnitComponentIsoExplicit_hom_left_snd f U
  have hrightSnd : (componentU ≫ outerMap) ≫ outerSndV = U.hom := by
    exact (Category.assoc _ _ _).trans
      ((congrArg (fun z => componentU ≫ z) houterSnd').trans hcomponentUSnd)
  apply pullback.hom_ext
  · exact hleftFst.trans (hsection.trans hrightFst.symm)
  · exact hleftSnd.trans hrightSnd.symm

theorem baseChangeUnitIsoExplicit_hom_app_left_fst
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    ((baseChangeUnitIsoExplicit f).hom.app U).left ≫
        pullback.fst (pullback.snd U.hom f) (inv f) ≫
          pullback.fst U.hom f = 𝟙 U.left := by
  change (baseChangeUnitComponentIsoExplicit f U).hom.left ≫
      pullback.fst ((proEtToRaw X).obj ((baseChange f).obj U)).hom (inv f) ≫
        pullback.fst U.hom f = 𝟙 U.left
  exact (baseChangeUnitComponentIsoExplicit_hom_left_fst_assoc
    f U (pullback.fst U.hom f)).trans (baseChangeUnitSection_fst f U)

noncomputable def baseChangeCounitIsoForNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChange (inv f) ⋙ baseChange f ≅ 𝟭 X.ProEt :=
  (baseChangeCompOfEq f (inv f) (𝟙 X) (by simp)).symm ≪≫
    baseChangeId X

noncomputable def baseChangeEquivalenceOfIsoUnitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] : Y.ProEt ≌ X.ProEt :=
  (CategoryTheory.Equivalence.mk
    (baseChange (inv f)) (baseChange f)
    (baseChangeCounitIsoForNormalized f).symm
    (baseChangeUnitIsoExplicit f).symm).symm

theorem baseChangeEquivalenceOfIsoUnitNormalized_unit
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIsoUnitNormalized f).unit =
      (baseChangeUnitIsoExplicit f).hom := by
  rfl

noncomputable def baseChangeAdjunctionOfIsoUnitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChange f ⊣ baseChange (inv f) :=
  (baseChangeEquivalenceOfIsoUnitNormalized f).toAdjunction

theorem baseChangeAdjunctionOfIsoUnitNormalized_unit_app
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : Y.ProEt) :
    (baseChangeAdjunctionOfIsoUnitNormalized f).unit.app U =
      (baseChangeUnitComponentIsoExplicit f U).hom := by
  rfl

noncomputable def equivariantBaseChangeForwardSiteIsoDirect
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    map j ⋙ baseChange fbar ≅ baseChange f ⋙ map j := by
  simpa only [IsIso.inv_inv] using
    equivariantBaseChange j (inv f) (inv fbar)
      (inverse_equivariant j f fbar h)

end AlgebraicGeometry.Scheme.ProEt

namespace AlgebraicGeometry.Scheme.ProEt

universe u

local instance rawCategoryNormalized (X : Scheme.{u}) : Category.{u} (Raw X) := by
  exact X.instCategoryProEt

local instance weaklyEtaleStableCompositionNormalized :
    MorphismProperty.IsStableUnderComposition
      (@WeaklyEtale : MorphismProperty Scheme.{u}) where
  comp_mem f g hf hg := by
    let _ : WeaklyEtale f := hf
    let _ : WeaklyEtale g := hg
    infer_instance

noncomputable def baseChangeEquivalenceOfIsoCounitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] : Y.ProEt ≌ X.ProEt :=
  CategoryTheory.Equivalence.mk
    (baseChange f) (baseChange (inv f))
    (baseChangeUnitIsoExplicit f)
    (baseChangeCounitIsoForNormalized f)

theorem baseChangeEquivalenceOfIsoCounitNormalized_counit
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIsoCounitNormalized f).counit =
      (baseChangeCounitIsoForNormalized f).hom := by
  rfl

noncomputable def baseChangeAdjunctionOfIsoCounitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChange f ⊣ baseChange (inv f) :=
  (baseChangeEquivalenceOfIsoCounitNormalized f).toAdjunction

theorem baseChangeAdjunctionOfIsoCounitNormalized_counit_app
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (U : X.ProEt) :
    (baseChangeAdjunctionOfIsoCounitNormalized f).counit.app U =
      (baseChangeCounitIsoForNormalized f).hom.app U := by
  rfl

noncomputable def baseChangeSheafAdjunctionOfIsoCounitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChangeSheafPushforward f ⊣
      baseChangeSheafPushforward (inv f) := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  letI : (baseChange (inv f)).IsContinuous (topology X) (topology Y) :=
    baseChange_isContinuous (inv f)
  exact (baseChangeAdjunctionOfIsoCounitNormalized f).sheafPushforwardContinuous
    (topology Y) (topology X)

noncomputable def baseChangeSheafAdjunctionOfIsoUnitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChangeSheafPushforward f ⊣
      baseChangeSheafPushforward (inv f) := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  letI : (baseChange (inv f)).IsContinuous (topology X) (topology Y) :=
    baseChange_isContinuous (inv f)
  exact (baseChangeAdjunctionOfIsoUnitNormalized f).sheafPushforwardContinuous
    (topology Y) (topology X)

theorem baseChangeSheafAdjunctionOfIsoUnitNormalized_unit_app_hom_app
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (Q : Sheaf (topology Y) Ab) (U : Y.ProEtᵒᵖ) :
    ((baseChangeSheafAdjunctionOfIsoUnitNormalized f).counit.app Q).hom.app U =
      Q.obj.map (((baseChangeUnitIsoExplicit f).hom.app U.unop).op) := by
  rfl

/-- Transport by a scheme isomorphism, formed with the same unit-normalized
base-change adjunction used by the normalized Frobenius action. -/
noncomputable def lowerShriekIsoBaseChangeOfIsoUnitNormalized
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    lowerShriek f ≅ baseChangeSheafPushforward f := by
  exact Adjunction.leftAdjointUniq
    ((lowerShriekAdjunction f).ofNatIsoRight
      (lowerShriekRightAdjointIsoOfIso f))
    (baseChangeSheafAdjunctionOfIsoUnitNormalized f)

/-- The unit-normalized transport of rational ell-adic coefficients along a
scheme isomorphism. -/
noncomputable def lowerShriekQEllAdicIsoOfIsoUnitNormalized
    {X Y : Scheme.{u}} (e : X ≅ Y) (ell : ℕ) [Fact ell.Prime] :
    (lowerShriek e.hom).obj (qEllAdicSheafAbULift X ell) ≅
      qEllAdicSheafAbULift Y ell :=
  (lowerShriekIsoBaseChangeOfIsoUnitNormalized e.hom).app
      (qEllAdicSheafAbULift X ell) ≪≫
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom)).symm

/-- Unit-normalized compact-support coefficient transport after replacing an
open scheme by an isomorphic one. -/
noncomputable def qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ell : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportSheaf (e.hom ≫ j) ell ≅
      qEllAdicCompactSupportSheaf j ell :=
  (lowerShriekCompIso e.hom j).symm.app
      (qEllAdicSheafAbULift X ell) ≪≫
    (lowerShriek j).mapIso
      (lowerShriekQEllAdicIsoOfIsoUnitNormalized e ell)

theorem lowerShriekQEllAdicIsoOfIsoUnitNormalized_hom_scalar
    {X Y : Scheme.{u}} (e : X ≅ Y) (ell : ℕ) [Fact ell.Prime]
    (r : ℚ_[ell]) :
    (lowerShriek e.hom).map (qEllAdicSheafAbScalarULift X ell r) ≫
        (lowerShriekQEllAdicIsoOfIsoUnitNormalized e ell).hom =
      (lowerShriekQEllAdicIsoOfIsoUnitNormalized e ell).hom ≫
        qEllAdicSheafAbScalarULift Y ell r := by
  let E := lowerShriekIsoBaseChangeOfIsoUnitNormalized e.hom
  let C : qEllAdicSheafAbULift Y ell ≅
      (baseChangeSheafPushforward e.hom).obj
        (qEllAdicSheafAbULift X ell) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom))
  have hC_hom :
      qEllAdicSheafAbScalarULift Y ell r ≫ C.hom =
        C.hom ≫
          (baseChangeSheafPushforward e.hom).map
            (qEllAdicSheafAbScalarULift X ell r) := by
    change qEllAdicSheafAbScalarULift Y ell r ≫
        qEllAdicCoefficientPullbackULift e.hom ell = _
    exact qEllAdicCoefficientPullbackULift_scalar e.hom ell r
  have hC :
      (baseChangeSheafPushforward e.hom).map
          (qEllAdicSheafAbScalarULift X ell r) ≫ C.inv =
        C.inv ≫ qEllAdicSheafAbScalarULift Y ell r := by
    apply (cancel_epi C.hom).1
    rw [← Category.assoc, ← hC_hom]
    simp
  change (lowerShriek e.hom).map
      (qEllAdicSheafAbScalarULift X ell r) ≫
        E.hom.app (qEllAdicSheafAbULift X ell) ≫ C.inv =
      E.hom.app (qEllAdicSheafAbULift X ell) ≫ C.inv ≫
        qEllAdicSheafAbScalarULift Y ell r
  rw [← Category.assoc, E.hom.naturality]
  rw [Category.assoc, hC]

theorem qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized_hom_scalar
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ell : ℕ) [Fact ell.Prime] (r : ℚ_[ell]) :
    qEllAdicCompactSupportScalar (e.hom ≫ j) ell r ≫
        (qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized
          e j ell).hom =
      (qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized
          e j ell).hom ≫
        qEllAdicCompactSupportScalar j ell r := by
  let A := (lowerShriekCompIso e.hom j).symm
  let D := lowerShriekQEllAdicIsoOfIsoUnitNormalized e ell
  change (lowerShriek (e.hom ≫ j)).map
      (qEllAdicSheafAbScalarULift X ell r) ≫
        A.hom.app (qEllAdicSheafAbULift X ell) ≫
          (lowerShriek j).map D.hom =
      A.hom.app (qEllAdicSheafAbULift X ell) ≫
        (lowerShriek j).map D.hom ≫
          (lowerShriek j).map (qEllAdicSheafAbScalarULift Y ell r)
  rw [← Category.assoc, A.hom.naturality]
  change A.hom.app (qEllAdicSheafAbULift X ell) ≫
      (lowerShriek j).map
          ((lowerShriek e.hom).map
            (qEllAdicSheafAbScalarULift X ell r)) ≫
        (lowerShriek j).map D.hom = _
  rw [← (lowerShriek j).map_comp]
  rw [lowerShriekQEllAdicIsoOfIsoUnitNormalized_hom_scalar]
  rw [(lowerShriek j).map_comp]

/-- The unit-normalized transport is a linear equivalence on compact-support
cohomology. -/
noncomputable def
    qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoUnitNormalized
    {S X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    (p : Z ⟶ S) [IsOpenImmersion j] [IsProper p]
    (ell degree : ℕ) [Fact ell.Prime] :
    CompactlySupportedQEllAdicCohomology (e.hom ≫ j) p ell degree ≃ₗ[ℚ_[ell]]
      CompactlySupportedQEllAdicCohomology j p ell degree := by
  let E := qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized e j ell
  exact
    { toFun := Sheaf.H.map E.hom degree
      invFun := Sheaf.H.map E.inv degree
      left_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      right_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      map_add' := (Sheaf.H.map E.hom degree).map_add
      map_smul' := by
        intro r x
        change (qEllAdicCompactSupportSheaf (e.hom ≫ j) ell).H degree at x
        change Sheaf.H.map E.hom degree
              (Sheaf.H.map
                (qEllAdicCompactSupportScalar (e.hom ≫ j) ell r)
                degree x) =
            Sheaf.H.map (qEllAdicCompactSupportScalar j ell r) degree
              (Sheaf.H.map E.hom degree x)
        rw [← Sheaf.H.map_comp_apply,
          qEllAdicCompactSupportSheafIsoOfOpenIsoUnitNormalized_hom_scalar,
          Sheaf.H.map_comp_apply] }

/-! The normalized Beck--Chevalley comparison is also needed between two
different open immersions.  This is the four-corner form of the equivariant
square used above for endomorphisms. -/

noncomputable def rawEquivariantBaseChangeBetween
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) :
    MorphismProperty.Over.map
          (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤
          (show WeaklyEtale jX from inferInstance) ⋙
        rawBaseChange (inv ebar) ≅
      rawBaseChange (inv e) ⋙
        MorphismProperty.Over.map
          (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤
          (show WeaklyEtale jY from inferInstance) := by
  let hjX : WeaklyEtale jX := inferInstance
  let hjY : WeaklyEtale jY := inferInstance
  let he : WeaklyEtale e := inferInstance
  let hebar : WeaklyEtale ebar := inferInstance
  exact
    Functor.isoWhiskerLeft (MorphismProperty.Over.map ⊤ hjX)
        (rawBaseChangeInvIsoMap ebar) ≪≫
      (MorphismProperty.Over.mapComp ⊤ hjX hebar).symm ≪≫
      MorphismProperty.Over.mapCongr ⊤ h.symm
        (show WeaklyEtale (jX ≫ ebar) from inferInstance) ≪≫
      MorphismProperty.Over.mapComp ⊤ he hjY ≪≫
      Functor.isoWhiskerRight (rawBaseChangeInvIsoMap e).symm
        (MorphismProperty.Over.map ⊤ hjY)

noncomputable def equivariantBaseChangeBetween
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) :
    map jX ⋙ baseChange (inv ebar) ≅
      baseChange (inv e) ⋙ map jY := by
  unfold map baseChange proEtToRaw rawToProEt
  exact rawEquivariantBaseChangeBetween jX jY e ebar h

@[reassoc]
theorem equivariantBaseChangeBetween_hom_app_left_fst
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) (U : X.ProEt) :
    ((equivariantBaseChangeBetween jX jY e ebar h).hom.app U).left ≫
        pullback.fst U.hom (inv e) =
      pullback.fst (U.hom ≫ jX) (inv ebar) := by
  change (pullback.fst (U.hom ≫ jX) (inv ebar) ≫
      pullback.lift (𝟙 U.left) (U.hom ≫ e) _) ≫
        pullback.fst U.hom (inv e) = _
  rw [Category.assoc, pullback.lift_fst]
  exact Category.comp_id _

@[reassoc]
theorem equivariantBaseChangeBetween_hom_app_left_snd
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) (U : X.ProEt) :
    ((equivariantBaseChangeBetween jX jY e ebar h).hom.app U).left ≫
        pullback.snd U.hom (inv e) =
      pullback.fst (U.hom ≫ jX) (inv ebar) ≫ U.hom ≫ e := by
  change (pullback.fst (U.hom ≫ jX) (inv ebar) ≫
      pullback.lift (𝟙 U.left) (U.hom ≫ e) _) ≫
        pullback.snd U.hom (inv e) = _
  rw [Category.assoc, pullback.lift_snd]

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
noncomputable def equivariantBaseChangeBetweenIteratedActual
    {X Y Z Xbar Ybar Zbar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (jZ : Z ⟶ Zbar) [WeaklyEtale jZ]
    (e : X ⟶ Y) [IsIso e] (f : Y ⟶ Z) [IsIso f]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (fbar : Ybar ⟶ Zbar) [IsIso fbar]
    (he : e ≫ jY = jX ≫ ebar) (hf : f ≫ jZ = jY ≫ fbar) :
    map jX ⋙ baseChange (inv (ebar ≫ fbar)) ≅
      baseChange (inv (e ≫ f)) ⋙ map jZ := by
  refine Functor.isoWhiskerLeft (map jX)
      (baseChangeCompOfEq (inv fbar) (inv ebar)
        (inv (ebar ≫ fbar)) IsIso.inv_comp) ≪≫ ?_
  refine (Functor.associator _ _ _).symm ≪≫ ?_
  refine Functor.isoWhiskerRight
      (equivariantBaseChangeBetween jX jY e ebar he)
      (baseChange (inv fbar)) ≪≫ ?_
  refine Functor.associator _ _ _ ≪≫ ?_
  refine Functor.isoWhiskerLeft (baseChange (inv e))
      (equivariantBaseChangeBetween jY jZ f fbar hf) ≪≫ ?_
  refine (Functor.associator _ _ _).symm ≪≫ ?_
  exact Functor.isoWhiskerRight
    (baseChangeCompOfEq (inv f) (inv e)
      (inv (e ≫ f)) IsIso.inv_comp).symm (map jZ)

theorem equivariantBaseChangeBetween_after_baseChange_hom_app_left_fst_assoc
    {X Y Z Ybar Zbar : Scheme.{u}}
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (jZ : Z ⟶ Zbar) [WeaklyEtale jZ]
    (e : X ⟶ Y) [IsIso e] (f : Y ⟶ Z) [IsIso f]
    (fbar : Ybar ⟶ Zbar) [IsIso fbar]
    (hf : f ≫ jZ = jY ≫ fbar) (U : X.ProEt) :
    ((equivariantBaseChangeBetween jY jZ f fbar hf).hom.app
        ((baseChange (inv e)).obj U)).left ≫
      pullback.fst (pullback.snd U.hom (inv e)) (inv f) ≫
      pullback.fst U.hom (inv e) =
    pullback.fst
        (pullback.snd U.hom (inv e) ≫ jY) (inv fbar) ≫
      pullback.fst U.hom (inv e) := by
  exact equivariantBaseChangeBetween_hom_app_left_fst_assoc
    jY jZ f fbar hf ((baseChange (inv e)).obj U)
      (pullback.fst U.hom (inv e))

theorem equivariantBaseChangeBetweenIteratedActual_hom_app_left_fst
    {X Y Z Xbar Ybar Zbar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (jZ : Z ⟶ Zbar) [WeaklyEtale jZ]
    (e : X ⟶ Y) [IsIso e] (f : Y ⟶ Z) [IsIso f]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (fbar : Ybar ⟶ Zbar) [IsIso fbar]
    (he : e ≫ jY = jX ≫ ebar) (hf : f ≫ jZ = jY ≫ fbar)
    (U : X.ProEt) :
    ((equivariantBaseChangeBetweenIteratedActual
      jX jY jZ e f ebar fbar he hf).hom.app U).left ≫
        pullback.fst U.hom (inv (e ≫ f)) =
      pullback.fst (U.hom ≫ jX) (inv (ebar ≫ fbar)) := by
  unfold equivariantBaseChangeBetweenIteratedActual
  simp only [Functor.comp_obj, Functor.id_obj, Iso.trans_hom, Functor.isoWhiskerLeft_hom, Iso.symm_hom,
    Functor.isoWhiskerRight_hom, NatTrans.comp_app, Functor.whiskerLeft_app, Functor.associator_inv_app,
    Functor.whiskerRight_app, Functor.associator_hom_app, Category.id_comp, Functor.const_obj_obj]
  change
    ((baseChangeCompOfEq (inv fbar) (inv ebar)
          (inv (ebar ≫ fbar)) IsIso.inv_comp).hom.app ((map jX).obj U)).left ≫
      ((baseChange (inv fbar)).map
          ((equivariantBaseChangeBetween jX jY e ebar he).hom.app U)).left ≫
      ((equivariantBaseChangeBetween jY jZ f fbar hf).hom.app
          ((baseChange (inv e)).obj U)).left ≫
      ((map jZ).map ((baseChangeCompOfEq (inv f) (inv e)
        (inv (e ≫ f)) IsIso.inv_comp).inv.app U)).left ≫
      pullback.fst U.hom (inv (e ≫ f)) = _
  slice_lhs 4 5 =>
