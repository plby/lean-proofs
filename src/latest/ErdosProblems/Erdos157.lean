theorem properPairResidueFiberRootCoordinates_comp_twistedFrobenius
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    (x : Spec (.of F) ⟶
      ProperPairResidueFiberDistinct (ZMod q) d m g t hg) :
    properPairResidueFiberRootCoordinates q d m F g t hg
        (x ≫ properPairResidueFiberDistinctTwistedFrobenius
            q d m g t hg π ≫
          properPairResidueFiberDistinctι (ZMod q) d m g t hg) =
      twistedTupleFrobenius q (2 * d) F
        (twoBlockPermutationFamily d π)
        (properPairResidueFiberRootCoordinates q d m F g t hg
          (x ≫ properPairResidueFiberDistinctι
            (ZMod q) d m g t hg)) := by
  funext i
  unfold properPairResidueFiberRootCoordinates
  have hmor :
      (x ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg π ≫
        properPairResidueFiberDistinctι (ZMod q) d m g t hg) ≫
          properPairResidueFiberToRootSpace
            (ZMod q) d m g t hg ≫
          (RootSpaceOpen (ZMod q) (2 * d) g).ι =
        (x ≫ properPairResidueFiberDistinctι
            (ZMod q) d m g t hg ≫
          properPairResidueFiberToRootSpace
            (ZMod q) d m g t hg ≫
          (RootSpaceOpen (ZMod q) (2 * d) g).ι) ≫
          affineRootPermutation (ZMod q) (2 * d)
            (twoBlockPermutationFamily d π) ≫
          affineRootFrobenius q (2 * d) := by
    simp only [Category.assoc]
    rw [properPairResidueFiberDistinctTwistedFrobenius_ι_assoc,
      properPairResidueFiberFrobenius_toRootSpace_assoc,
      properPairResidueFiberPermutation_toRootSpace_assoc,
      rootFrobenius_ι, rootPermutation_ι_assoc]
  rw [hmor, ← Category.assoc]
  rw [affineRootPointCoordinates_comp_frobenius,
    affineRootPointCoordinates_comp_permutation]
  rfl

theorem properPairResidueFiberPoint_affine_residue_condition
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : Spec (.of F) ⟶
      ProperPairResidueFiber (ZMod q) d m g t hg) :
    rootTupleAffinePoint q (2 * d) F
        (properPairResidueFiberRootCoordinates q d m F g t hg x) ≫
      affineProperPairResidueMultiplication (ZMod q) d m g hg =
    Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)) ≫
      residuePoint (ZMod q) m t := by
  let r := x ≫ properPairResidueFiberToRootSpace
    (ZMod q) d m g t hg
  have hmor : r ≫ properPairResidueMultiplication
        (ZMod q) d m g hg =
      Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F)) ≫
        residuePoint (ZMod q) m t := by
    calc
      r ≫ properPairResidueMultiplication (ZMod q) d m g hg =
          x ≫ (properPairResidueFiberToRootSpace
              (ZMod q) d m g t hg ≫
            properPairResidueMultiplication (ZMod q) d m g hg) := by
        simp [r, Category.assoc]
      _ = x ≫ (properPairResidueFiberProjection
              (ZMod q) d m g t hg ≫
            residuePoint (ZMod q) m t) := by
        rw [properPairResidueFiber_condition]
      _ = (x ≫ properPairResidueFiberProjection
              (ZMod q) d m g t hg) ≫
            residuePoint (ZMod q) m t := by
        simp only [Category.assoc]
      _ = _ := by
        rw [specToZMod_hom_ext q F
          (x ≫ properPairResidueFiberProjection
            (ZMod q) d m g t hg)
          (Spec.map (CommRingCat.ofHom
            (ZMod.castHom (m := q) dvd_rfl F)))]
  have hr := rootSpacePoint_eq_rootTupleRootSpacePoint
    q (2 * d) F g r
  rw [hr] at hmor
  unfold properPairResidueMultiplication at hmor
  rw [← Category.assoc, rootTupleRootSpacePoint_ι] at hmor
  simpa only [r, properPairResidueFiberRootCoordinates, Category.assoc] using hmor

theorem properPairResidueFiberPoint_residue_coeff
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : Spec (.of F) ⟶
      ProperPairResidueFiber (ZMod q) d m g t hg)
    (j : Fin m) :
    (properPairTuplePolynomial d F
        (properPairResidueFiberRootCoordinates q d m F g t hg x) %ₘ
      g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff j =
    ZMod.castHom (m := q) dvd_rfl F (t.coeff j) := by
  have hmor := properPairResidueFiberPoint_affine_residue_condition
    q d m F g t hg x
  have happ := congrArg Scheme.Hom.appTop hmor
  have hc := congrArg (fun f =>
      (Scheme.ΓSpecIso (.of F)).hom
        (f (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) happ
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at hc
  change (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q (2 * d) F
        (properPairResidueFiberRootCoordinates q d m F g t hg x)).appTop
        ((affineProperPairResidueMultiplication
            (ZMod q) d m g hg).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) =
    (Scheme.ΓSpecIso (.of F)).hom
      ((Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F))).appTop
        ((residuePoint (ZMod q) m t).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) at hc
  rw [affineProperPairResidueMultiplication_appTop_coord] at hc
  have hleft := congrArg (fun p : Polynomial F => p.coeff j)
    (rootTupleAffinePoint_universalProperPairRemainder q d m F
      (properPairResidueFiberRootCoordinates q d m F g t hg x) g hg)
  rw [Polynomial.coeff_map] at hleft
  have hleft' : (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q (2 * d) F
        (properPairResidueFiberRootCoordinates q d m F g t hg x)).appTop
        ((universalProperPairRemainder (ZMod q) d g hg).coeff j)) =
      (properPairTuplePolynomial d F
          (properPairResidueFiberRootCoordinates q d m F g t hg x) %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff j := by
    change (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q (2 * d) F
          (properPairResidueFiberRootCoordinates q d m F g t hg x)).appTop
          ((universalProperPairRemainder (ZMod q) d g hg).coeff j)) = _
      at hleft
    exact hleft
  calc
    _ = (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q (2 * d) F
          (properPairResidueFiberRootCoordinates q d m F g t hg x)).appTop
          ((universalProperPairRemainder (ZMod q) d g hg).coeff j)) :=
      hleft'.symm
    _ = (Scheme.ΓSpecIso (.of F)).hom
        ((Spec.map (CommRingCat.ofHom
            (ZMod.castHom (m := q) dvd_rfl F))).appTop
          ((residuePoint (ZMod q) m t).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) := hc
    _ = _ := by
      rw [zmodBaseChange_evaluate q F]
      simp [residuePoint]

theorem properPairResidueFiberPoint_residue_polynomial
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (x : Spec (.of F) ⟶
      ProperPairResidueFiber (ZMod q) d m g t hg) :
    properPairTuplePolynomial d F
        (properPairResidueFiberRootCoordinates q d m F g t hg x) %ₘ
      g.map (ZMod.castHom (m := q) dvd_rfl F) =
    t.map (ZMod.castHom (m := q) dvd_rfl F) := by
  apply Polynomial.ext
  intro k
  by_cases hk : k < m
  · let j : Fin m := ⟨k, hk⟩
    simpa only [j, Polynomial.coeff_map] using
      properPairResidueFiberPoint_residue_coeff
        q d m F g t hg x j
  · have hmk : m ≤ k := Nat.le_of_not_gt hk
    have hgmapdeg :
        (g.map (ZMod.castHom (m := q) dvd_rfl F)).degree =
          (m : WithBot ℕ) := by
      rw [Polynomial.degree_eq_natDegree (hg.map _).ne_zero,
        Polynomial.natDegree_map_eq_of_injective
          (ZMod.castHom (m := q) dvd_rfl F).injective, hdeg]
    have hleft : (properPairTuplePolynomial d F
        (properPairResidueFiberRootCoordinates q d m F g t hg x) %ₘ
          g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff k = 0 := by
      apply Polynomial.coeff_eq_zero_of_degree_lt
      exact (Polynomial.degree_modByMonic_lt _ (hg.map _)).trans_le <| by
        rw [hgmapdeg]
        exact_mod_cast hmk
    rw [hleft, Polynomial.coeff_map,
      Polynomial.coeff_eq_zero_of_natDegree_lt (ht.trans_le hmk), map_zero]

noncomputable def properPairTupleToFiberPoint
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (y : Fin (2 * d) → F)
    (havoid : ∀ i : Fin (2 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hmod : properPairTuplePolynomial d F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F)) :
    Spec (.of F) ⟶ ProperPairResidueFiber (ZMod q) d m g t hg :=
  pullback.lift
    (rootTupleRootSpacePoint q (2 * d) F y g havoid)
    (Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F)))
    (properPairResidue_condition_of_mod_eq
      q d m F g t hg y havoid hmod)

@[simp]
theorem properPairTupleToFiberPoint_coordinates
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (y : Fin (2 * d) → F)
    (havoid : ∀ i : Fin (2 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hmod : properPairTuplePolynomial d F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F)) :
    properPairResidueFiberRootCoordinates q d m F g t hg
      (properPairTupleToFiberPoint
        q d m F g t hg y havoid hmod) = y := by
  unfold properPairResidueFiberRootCoordinates
  rw [← Category.assoc,
    show properPairTupleToFiberPoint q d m F g t hg y havoid hmod ≫
      properPairResidueFiberToRootSpace (ZMod q) d m g t hg =
      rootTupleRootSpacePoint q (2 * d) F y g havoid by
    unfold properPairTupleToFiberPoint
    exact pullback.lift_fst _ _ _]
  exact rootTupleRootSpacePoint_coordinates q (2 * d) F y g havoid

theorem properPairResidueFiberDistinctPoint_coordinates_injective
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (z : Spec (.of F) ⟶
      ProperPairResidueFiberDistinct (ZMod q) d m g t hg) :
    Function.Injective
      (properPairResidueFiberRootCoordinates q d m F g t hg
        (z ≫ properPairResidueFiberDistinctι
          (ZMod q) d m g t hg)) := by
  let x := z ≫ properPairResidueFiberDistinctι
    (ZMod q) d m g t hg
  let a := x ≫ properPairResidueFiberToRootSpace
      (ZMod q) d m g t hg ≫
    (RootSpaceOpen (ZMod q) (2 * d) g).ι
  have hopen : x ⁻¹ᵁ ProperPairResidueFiberDistinctOpen
      (ZMod q) d m g t hg = ⊤ := by
    dsimp only [x, properPairResidueFiberDistinctι]
    rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self,
      Scheme.Hom.preimage_top]
  have hsection : x.appTop
      ((properPairResidueFiberToRootSpace
          (ZMod q) d m g t hg ≫
        (RootSpaceOpen (ZMod q) (2 * d) g).ι).appTop
          (rootVandermondeSection (ZMod q) (2 * d))) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of F)).basicOpen
        (x.appTop
          ((properPairResidueFiberToRootSpace
              (ZMod q) d m g t hg ≫
            (RootSpaceOpen (ZMod q) (2 * d) g).ι).appTop
              (rootVandermondeSection (ZMod q) (2 * d)))) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    exact bot_ne_top hbasic
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) (2 * d))) ≠ 0 := by
    intro hzero
    change a.appTop (rootVandermondeSection (ZMod q) (2 * d)) ≠ 0
      at hsection
    apply hsection
    have hinv := congrArg
      (fun y => (Scheme.ΓSpecIso (.of F)).inv y) hzero
    simpa using hinv
  exact (affineRootPoint_rootVandermondeSection_ne_zero_iff
    q (2 * d) F a).mp himage

noncomputable def properPairResidueFiberPointToDistinct
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : Spec (.of F) ⟶
      ProperPairResidueFiber (ZMod q) d m g t hg)
    (hx : Function.Injective
      (properPairResidueFiberRootCoordinates q d m F g t hg x)) :
    Spec (.of F) ⟶
      ProperPairResidueFiberDistinct (ZMod q) d m g t hg := by
  apply IsOpenImmersion.lift
    (properPairResidueFiberDistinctι (ZMod q) d m g t hg) x
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  unfold properPairResidueFiberDistinctι
  rw [Scheme.Opens.range_ι]
  apply x.mem_preimage.mp
  unfold ProperPairResidueFiberDistinctOpen
  rw [Scheme.preimage_basicOpen_top]
  let a := x ≫ properPairResidueFiberToRootSpace
      (ZMod q) d m g t hg ≫
    (RootSpaceOpen (ZMod q) (2 * d) g).ι
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) (2 * d))) ≠ 0 :=
    (affineRootPoint_rootVandermondeSection_ne_zero_iff
      q (2 * d) F a).mpr hx
  have hu : IsUnit ((Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) (2 * d)))) :=
    isUnit_iff_ne_zero.mpr himage
  have humap := hu.map (Scheme.ΓSpecIso (.of F)).inv.hom
  have hu' : IsUnit
      (a.appTop (rootVandermondeSection (ZMod q) (2 * d))) := by
    simpa using humap
  change w ∈ (Spec (.of F)).basicOpen
    (a.appTop (rootVandermondeSection (ZMod q) (2 * d)))
  rw [Scheme.basicOpen_of_isUnit _ hu']
  trivial

@[reassoc (attr := simp)]
theorem properPairResidueFiberPointToDistinct_ι
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : Spec (.of F) ⟶
      ProperPairResidueFiber (ZMod q) d m g t hg)
    (hx : Function.Injective
      (properPairResidueFiberRootCoordinates q d m F g t hg x)) :
    properPairResidueFiberPointToDistinct
        q d m F g t hg x hx ≫
      properPairResidueFiberDistinctι (ZMod q) d m g t hg = x := by
  unfold properPairResidueFiberPointToDistinct
  exact IsOpenImmersion.lift_fac _ _ _

noncomputable def properPairResidueFiberDistinctFixedPointEquivTupleData
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (π₀ π₁ : Equiv.Perm (Fin d)) :
    {z : Spec (.of F) ⟶
        ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg ![π₀, π₁] = z} ≃
      ProperPairTwistedTupleData q d F g t π₀ π₁ where
  toFun z := by
    let x := z.1 ≫ properPairResidueFiberDistinctι
      (ZMod q) d m g t hg
    let y := properPairResidueFiberRootCoordinates q d m F g t hg x
    refine {
      coords := y
      avoids := ?_
      injective := ?_
      residue_condition := ?_
      twisted_fixed := ?_ }
    · exact rootSpacePoint_avoids q (2 * d) F g
        (x ≫ properPairResidueFiberToRootSpace
          (ZMod q) d m g t hg)
    · exact properPairResidueFiberDistinctPoint_coordinates_injective
        q d m F g t hg z.1
    · exact properPairResidueFiberPoint_residue_polynomial
        q d m F g t hg hdeg ht x
    · change twistedTupleFrobenius q (2 * d) F
          (twoBlockPermutationFamily d ![π₀, π₁]) y = y
      rw [← properPairResidueFiberRootCoordinates_comp_twistedFrobenius
        q d m F g t hg ![π₀, π₁] z.1]
      rw [← Category.assoc, z.2]
  invFun a := by
    let x := properPairTupleToFiberPoint q d m F g t hg
      a.coords a.avoids a.residue_condition
    have hx : Function.Injective
        (properPairResidueFiberRootCoordinates q d m F g t hg x) := by
      rw [properPairTupleToFiberPoint_coordinates]
      exact a.injective
    let z := properPairResidueFiberPointToDistinct
      q d m F g t hg x hx
    refine ⟨z, ?_⟩
    apply (cancel_mono
      (properPairResidueFiberDistinctι (ZMod q) d m g t hg)).1
    apply properPairResidueFiberRootCoordinates_injective
      q d m F g t hg
    rw [Category.assoc]
    rw [properPairResidueFiberRootCoordinates_comp_twistedFrobenius]
    change twistedTupleFrobenius q (2 * d) F
        (twoBlockPermutationPair d π₀ π₁)
        (properPairResidueFiberRootCoordinates q d m F g t hg
          (z ≫ properPairResidueFiberDistinctι
            (ZMod q) d m g t hg)) =
      properPairResidueFiberRootCoordinates q d m F g t hg
        (z ≫ properPairResidueFiberDistinctι
          (ZMod q) d m g t hg)
    rw [properPairResidueFiberPointToDistinct_ι]
    rw [properPairTupleToFiberPoint_coordinates]
    exact a.twisted_fixed
  left_inv z := by
    apply Subtype.ext
    apply (cancel_mono
      (properPairResidueFiberDistinctι (ZMod q) d m g t hg)).1
    apply properPairResidueFiberRootCoordinates_injective
      q d m F g t hg
    rw [properPairResidueFiberPointToDistinct_ι]
    rw [properPairTupleToFiberPoint_coordinates]
  right_inv a := by
    apply ProperPairTwistedTupleData.ext
    change properPairResidueFiberRootCoordinates q d m F g t hg
        (properPairResidueFiberPointToDistinct q d m F g t hg
          (properPairTupleToFiberPoint q d m F g t hg
            a.coords a.avoids a.residue_condition)
          (by
            rw [properPairTupleToFiberPoint_coordinates]
            exact a.injective) ≫
          properPairResidueFiberDistinctι (ZMod q) d m g t hg) =
      a.coords
    rw [properPairResidueFiberPointToDistinct_ι]
    rw [properPairTupleToFiberPoint_coordinates]

theorem properPairResidueFiberDistinctFixedPoint_natCard_eq
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (π₀ π₁ : Equiv.Perm (Fin d)) :
    Nat.card {z : Spec (.of F) ⟶
        ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg ![π₀, π₁] = z} =
      properPairTwistedTupleCount q d F g t π₀ π₁ := by
  unfold properPairTwistedTupleCount
  exact Nat.card_congr
    (properPairResidueFiberDistinctFixedPointEquivTupleData
      q d m F g t hg hdeg ht π₀ π₁)

theorem
    sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_pair
    (q d m : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (hgt : IsCoprime g t) :
    (∑ π₀ : Equiv.Perm (Fin d),
      ∑ π₁ : Equiv.Perm (Fin d),
        permutationVirtualMangoldt ℚ (Fin d) π₀ *
          permutationVirtualMangoldt ℚ (Fin d) π₁ *
          (Nat.card {z : Spec (.of F) ⟶
              ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
            z ≫ properPairResidueFiberDistinctTwistedFrobenius
              q d m g t hg ![π₀, π₁] = z} : ℚ)) =
      (d.factorial : ℚ) ^ 2 *
        (d ^ 2 * Nat.card
          (CongruentIrreducibleProperPair q d g t) : ℕ) := by
  simp_rw [properPairResidueFiberDistinctFixedPoint_natCard_eq
    q d m F g t hg hdeg ht]
  exact sum_two_permutationVirtualMangoldt_mul_properPairCount_eq_pair
    q d hd F g t hg hgt

open AlgebraicGeometry

theorem residuePoint_isClosedImmersion
    (q m : ℕ) [Fact q.Prime] (t : Polynomial (ZMod q)) :
    IsClosedImmersion (residuePoint (ZMod q) m t) := by
  apply isClosedImmersion_of_comp_eq_id
    (AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))) _
  exact specZMod_hom_ext q _ _

theorem properPairResidueFiberToRootSpace_isClosedImmersion
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    IsClosedImmersion
      (properPairResidueFiberToRootSpace (ZMod q) d m g t hg) := by
  let : IsClosedImmersion (residuePoint (ZMod q) m t) :=
    residuePoint_isClosedImmersion q m t
  unfold properPairResidueFiberToRootSpace ProperPairResidueFiber
  infer_instance

@[reassoc (attr := simp)]
theorem properPairResidueMultiplication_over
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic) :
    properPairResidueMultiplication K d m g hg ≫
        (AffineRootSpace K m ↘ Spec (.of K)) =
      rootSpaceProjection K (2 * d) g := by
  unfold properPairResidueMultiplication rootSpaceProjection
  simp only [Category.assoc,
    affineProperPairResidueMultiplication_over]

noncomputable def properPairResidueFiberDistinctToProjectiveRootSpace
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    ProperPairResidueFiberDistinct (ZMod q) d m g t hg ⟶
      AlgebraicGeometry.ProjectiveCompactification.ProjectiveSpace
        (ZMod q) (RI (2 * d)) :=
  properPairResidueFiberDistinctι (ZMod q) d m g t hg ≫
    properPairResidueFiberToRootSpace (ZMod q) d m g t hg ≫
    (RootSpaceOpen (ZMod q) (2 * d) g).ι ≫
    AlgebraicGeometry.ProjectiveCompactification.affineSpaceToProjective
      (ZMod q) (RI (2 * d))

theorem properPairResidueFiberDistinctToProjectiveRootSpace_isImmersion
    (q d m : ℕ) [Fact q.Prime]
