          q d m ℓ degree g hg hdeg hm hmn t)] : Prop :=
  fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedAlternatingTrace
      q d m ℓ topDegree g hg hdeg hm hmn t =
    (Nat.card {z : Spec (.of F) ⟶
        FullResidueUnitFiberBlockwiseDistinct
          (ZMod q) d m g hg hdeg hm hmn t //
      z ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
        q d m g hg hdeg hm hmn t = z} : ℚ_[ℓ])

/-- Finite-dimensionality, Lefschetz, two-degree concentration, and Deligne
root bounds for the exact blockwise-distinct unsieved fiber. -/
structure FullBlockwiseDistinctCanonicalTwoDegreeGeometricData
    (q d m ℓ topDegree lowerDegree upperDegree : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : ℚ_[ℓ] →+* ℂ) (radius : ℝ) where
  finite : ∀ degree : ℕ,
    FiniteDimensional ℚ_[ℓ]
      (FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g hg hdeg hm hmn t)
  lefschetz :
    letI := finite
    HasBlockwiseDistinctCanonicalTwistedGrothendieckLefschetz
      q d m ℓ topDegree (AlgebraicClosure (ZMod q))
        g hg hdeg hm hmn t
  lower_le : lowerDegree ≤ topDegree
  upper_le : upperDegree ≤ topDegree
  degrees_ne : lowerDegree ≠ upperDegree
  concentration :
    letI := finite
    ∀ degree ≤ topDegree, degree ≠ lowerDegree → degree ≠ upperDegree →
      fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedCompactSupportTrace
        q d m ℓ degree g hg hdeg hm hmn t = 0
  lower_root_bound :
    letI := finite lowerDegree
    ∀ z, z ∈
      (fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
        q d m ℓ lowerDegree g hg hdeg hm hmn t σ).charpoly.roots →
      ‖z‖ ≤ radius
  upper_root_bound :
    letI := finite upperDegree
    ∀ z, z ∈
      (fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
        q d m ℓ upperDegree g hg hdeg hm hmn t σ).charpoly.roots →
      ‖z‖ ≤ radius

/-- The exact unsieved compact-support data yield the signed two-degree
Frobenius matrices whose trace is the blockwise fixed-point count. -/
noncomputable def FullBlockwiseDistinctCanonicalTwoDegreeGeometricData.toMatrices
    {q d m ℓ topDegree lowerDegree upperDegree : ℕ}
    [Fact q.Prime] [Fact ℓ.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {hdeg : g.natDegree = m} {hm : 0 < m} {hmn : m ≤ 3 * d}
    {t : ResidueUnitPoint (ZMod q) m g}
    {σ : ℚ_[ℓ] →+* ℂ} {radius : ℝ}
    (data : FullBlockwiseDistinctCanonicalTwoDegreeGeometricData
      q d m ℓ topDegree lowerDegree upperDegree
      g hg hdeg hm hmn t σ radius) :
    letI := data.finite lowerDegree
    let lower :=
      fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
        q d m ℓ lowerDegree g hg hdeg hm hmn t σ
    letI := data.finite upperDegree
    let upper :=
      fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
        q d m ℓ upperDegree g hg hdeg hm hmn t σ
    SawinSpecialization.TwoDegreeFrobeniusMatrices
      (Nat.card {z : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          FullResidueUnitFiberBlockwiseDistinct
            (ZMod q) d m g hg hdeg hm hmn t //
        z ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
          q d m g hg hdeg hm hmn t = z} : ℂ)
      (Module.finrank ℚ_[ℓ]
        (FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ lowerDegree g hg hdeg hm hmn t))
      (Module.finrank ℚ_[ℓ]
        (FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ upperDegree g hg hdeg hm hmn t)) radius radius := by
  letI := data.finite
  let lower :=
    fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
      q d m ℓ lowerDegree g hg hdeg hm hmn t σ
  let upper :=
    fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix
      q d m ℓ upperDegree g hg hdeg hm hmn t σ
  apply twoDegreeFrobeniusMatricesOfCohomologicalMatrices
    lowerDegree upperDegree lower upper
  · have halt :=
      fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedAlternatingTrace_eq_two_degrees
        q d m ℓ topDegree lowerDegree upperDegree g hg hdeg hm hmn t
        data.lower_le data.upper_le data.degrees_ne data.concentration
    have hqell :
        (Nat.card {z : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            FullResidueUnitFiberBlockwiseDistinct
              (ZMod q) d m g hg hdeg hm hmn t //
          z ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
            q d m g hg hdeg hm hmn t = z} : ℚ_[ℓ]) =
          (-1 : ℚ_[ℓ]) ^ lowerDegree *
              fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedCompactSupportTrace
                q d m ℓ lowerDegree g hg hdeg hm hmn t +
            (-1 : ℚ_[ℓ]) ^ upperDegree *
              fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedCompactSupportTrace
                q d m ℓ upperDegree g hg hdeg hm hmn t := by
      rw [← halt]
      exact data.lefschetz.symm
    have hc := congrArg σ hqell
    simpa only [map_natCast, map_add, map_mul, map_pow, map_neg, map_one,
      fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedRealizationMatrix_trace,
      lower, upper] using hc
  · exact data.lower_root_bound
  · exact data.upper_root_bound

noncomputable abbrev
    ProgressionBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
    (q k r ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ) :=
  FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
    q (2 * r) (k ^ 2) ℓ degree
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
    (Nat.pow_pos (lt_of_lt_of_le Nat.zero_lt_one hk)) hkm
    (progressionResidueUnitPoint q k hk u)

theorem
    threeBlockBlockwiseDistinctCanonicalTwistedAlternatingTrace_eq_allOrdered
    (q k r ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ)
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (ProgressionBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q k r ℓ degree hk hkm u)]
    (hGL : HasBlockwiseDistinctCanonicalTwistedGrothendieckLefschetz
      q (2 * r) (k ^ 2) ℓ topDegree (AlgebraicClosure (ZMod q))
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k)
      (Nat.pow_pos (lt_of_lt_of_le Nat.zero_lt_one hk)) hkm
      (progressionResidueUnitPoint q k hk u)) :
    fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedAlternatingTrace
        q (2 * r) (k ^ 2) ℓ topDegree
        (modulusProduct q k) (modulusProduct_monic q k)
        (modulusProduct_natDegree q k)
        (Nat.pow_pos (lt_of_lt_of_le Nat.zero_lt_one hk)) hkm
        (progressionResidueUnitPoint q k hk u) =
      (((2 * r) ^ 3 * Nat.card (CongruentAllOrderedPrimeTriple q k r
        (progressionUnitRepresentative q k u)) : ℕ) : ℚ_[ℓ]) := by
  rw [hGL,
    fullResidueUnitFiberBlockwiseDistinctFixedPoint_card_eq_allOrdered
      q k r hk hr hkm u]

