noncomputable def
    fullResidueUnitFiberBlockwiseDistinctFixedPointEquivBlockwiseTuple
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    {z : Spec (.of F) ⟶ FullResidueUnitFiberBlockwiseDistinct
          (ZMod q) d m g hg hdeg hm hmn t //
      z ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
        q d m g hg hdeg hm hmn t = z} ≃
      ThreeBlockBlockwiseInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t := by
  let e := fullResidueUnitFiberFixedPointEquivTupleData
    q (3 * d) m F g hg hdeg hm hmn t
      (threeBlockCyclePermutation d)
  refine {
    toFun := fun z => ⟨e ⟨z.1 ≫
      fullResidueUnitFiberBlockwiseDistinctι
        (ZMod q) d m g hg hdeg hm hmn t, ?_⟩, ?_⟩
    invFun := fun x =>
      let hx : ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
          fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
            hdeg hm hmn t (e.symm x.1).1 (finProdFinEquiv (b, j))) := by
        intro b
        change Function.Injective (fun j : Fin d =>
          (e (e.symm x.1)).coords (finProdFinEquiv (b, j)))
        rw [e.apply_symm_apply]
        have hb := x.2 b
        change Function.Injective (fun j : Fin d =>
          x.1.coords (finProdFinEquiv (b, j))) at hb
        exact hb
      ⟨fullResidueUnitFiberPointToBlockwiseDistinct
        q d m F g hg hdeg hm hmn t (e.symm x.1).1 hx, by
        apply (cancel_mono (fullResidueUnitFiberBlockwiseDistinctι
          (ZMod q) d m g hg hdeg hm hmn t)).1
        simp only [Category.assoc]
        rw [fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius_ι]
        rw [← Category.assoc,
          fullResidueUnitFiberPointToBlockwiseDistinct_ι]
        exact (e.symm x.1).2⟩
    left_inv := ?_
    right_inv := ?_ }
  · calc
      (z.1 ≫ fullResidueUnitFiberBlockwiseDistinctι
          (ZMod q) d m g hg hdeg hm hmn t) ≫
          fullResidueUnitFiberTwistedFrobenius
            q (3 * d) m g hg hdeg hm hmn t
              (threeBlockCyclePermutation d) =
        z.1 ≫ (fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
            q d m g hg hdeg hm hmn t ≫
          fullResidueUnitFiberBlockwiseDistinctι
            (ZMod q) d m g hg hdeg hm hmn t) := by
          rw [fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius_ι]
          simp only [Category.assoc]
      _ = z.1 ≫ fullResidueUnitFiberBlockwiseDistinctι
            (ZMod q) d m g hg hdeg hm hmn t := by
          rw [← Category.assoc, z.2]
  · intro b
    change Function.Injective (fun j : Fin d =>
      (e ⟨z.1 ≫ fullResidueUnitFiberBlockwiseDistinctι
        (ZMod q) d m g hg hdeg hm hmn t, _⟩).coords
          (finProdFinEquiv (b, j)))
    exact fullResidueUnitFiberBlockwiseDistinctPoint_coordinates_injective
      q d m F g hg hdeg hm hmn t z.1 b
  · intro z
    apply Subtype.ext
    apply (cancel_mono (fullResidueUnitFiberBlockwiseDistinctι
      (ZMod q) d m g hg hdeg hm hmn t)).1
    rw [fullResidueUnitFiberPointToBlockwiseDistinct_ι]
    change (e.symm (e _)).1 = _
    rw [e.symm_apply_apply]
  · intro x
    let hx : ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
        fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
          hdeg hm hmn t (e.symm x.1).1 (finProdFinEquiv (b, j))) := by
      intro b
      change Function.Injective (fun j : Fin d =>
        (e (e.symm x.1)).coords (finProdFinEquiv (b, j)))
      rw [e.apply_symm_apply]
      have hb := x.2 b
      change Function.Injective (fun j : Fin d =>
        x.1.coords (finProdFinEquiv (b, j))) at hb
      exact hb
    apply Subtype.ext
    rw [← e.apply_symm_apply x.1]
    apply congrArg e
    apply Subtype.ext
    exact fullResidueUnitFiberPointToBlockwiseDistinct_ι
      q d m F g hg hdeg hm hmn t (e.symm x.1).1 hx

theorem fullResidueUnitFiberBlockwiseDistinctFixedPoint_card_eq_allOrdered
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ) :
    Nat.card {z : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
        FullResidueUnitFiberBlockwiseDistinct
          (ZMod q) (2 * r) (k ^ 2) (modulusProduct q k)
          (modulusProduct_monic q k) (modulusProduct_natDegree q k)
          (by positivity) hkm (progressionResidueUnitPoint q k hk u) //
      z ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
        q (2 * r) (k ^ 2) (modulusProduct q k)
          (modulusProduct_monic q k) (modulusProduct_natDegree q k)
          (by positivity) hkm (progressionResidueUnitPoint q k hk u) = z} =
      (2 * r) ^ 3 * Nat.card (CongruentAllOrderedPrimeTriple q k r
        (progressionUnitRepresentative q k u)) := by
  rw [Nat.card_congr
    (fullResidueUnitFiberBlockwiseDistinctFixedPointEquivBlockwiseTuple
      q (2 * r) (k ^ 2) (AlgebraicClosure (ZMod q))
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u))]
  exact threeBlockBlockwiseFixedTuple_card_eq_allOrderedPrimeTriple
    q k r hk hr hkm u

