open Module Set Set.powersetCard

theorem invariant_subset_eq_empty_or_univ_of_isCycle_support_eq_univ
    {H : Type*} [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (hg : g.IsCycle)
    (hsupport : g.support = Finset.univ)
    (s : Finset H) (hinv : ∀ x, x ∈ s ↔ g x ∈ s) :
    s = ∅ ∨ s = Finset.univ := by
  by_cases hs : s = ∅
  · exact Or.inl hs
  · right
    apply Finset.eq_univ_iff_forall.mpr
    intro y
    obtain ⟨x, hx⟩ := Finset.nonempty_iff_ne_empty.mpr hs
    have hxmove : g x ≠ x := by
      rw [← Equiv.Perm.mem_support, hsupport]
      exact Finset.mem_univ x
    have hymove : g y ≠ y := by
      rw [← Equiv.Perm.mem_support, hsupport]
      exact Finset.mem_univ y
    obtain ⟨n, hn⟩ := hg.exists_pow_eq hxmove hymove
    have hpow : ∀ n : ℕ, ∀ z, z ∈ s → (g ^ n) z ∈ s := by
      intro n
      induction n with
      | zero =>
          intro z hz
          simpa using hz
      | succ n ih =>
          intro z hz
          rw [pow_succ', Equiv.Perm.mul_apply]
          exact (hinv _).mp (ih z hz)
    rw [← hn]
    exact hpow n x hx

theorem permutationVirtualMangoldt_conj
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g h : Equiv.Perm H) :
    permutationVirtualMangoldt K H (h * g * h⁻¹) =
      permutationVirtualMangoldt K H g := by
  unfold permutationVirtualMangoldt
  apply Finset.sum_congr rfl
  intro degree _
  rw [Representation.char_conj]

theorem permutationVirtualMangoldt_finRotate
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d) :
    permutationVirtualMangoldt K (Fin d) (finRotate d) = (d : K) := by
  simpa using
    (permutationVirtualMangoldt_eq_card_of_only_trivial_invariant_subset
      K (Fin d) (finRotate d) fun s hs =>
        invariant_subset_eq_empty_or_univ_of_isCycle_support_eq_univ
          (finRotate d) (isCycle_finRotate_of_le hd)
            (support_finRotate_of_le hd) s hs)

theorem permutationVirtualMangoldt_eq_card_of_cycleType_eq_singleton
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (g : Equiv.Perm (Fin d)) (hg : g.cycleType = {d}) :
    permutationVirtualMangoldt K (Fin d) g = (d : K) := by
  have hconj : IsConj g (finRotate d) :=
    Equiv.Perm.isConj_iff_cycleType_eq.mpr
      (hg.trans (cycleType_finRotate_of_le hd).symm)
  obtain ⟨h, hh⟩ := isConj_iff.mp hconj
  calc
    permutationVirtualMangoldt K (Fin d) g =
        permutationVirtualMangoldt K (Fin d) (h * g * h⁻¹) :=
      (permutationVirtualMangoldt_conj K (Fin d) g h).symm
    _ = permutationVirtualMangoldt K (Fin d) (finRotate d) := by rw [hh]
    _ = (d : K) := permutationVirtualMangoldt_finRotate K d hd

theorem permutationVirtualMangoldt_eq_zero_of_cycleType_ne_singleton
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (g : Equiv.Perm (Fin d)) (hg : g.cycleType ≠ {d}) :
    permutationVirtualMangoldt K (Fin d) g = 0 := by
  let : Nonempty (Fin d) := Fintype.card_pos_iff.mp (by simpa using (show 0 < d by omega))
  have hnot : ¬(∀ s : Finset (Fin d),
      (∀ x, x ∈ s ↔ g x ∈ s) → s = ∅ ∨ s = Finset.univ) := by
    intro ht
    have hcycle := permutation_isCycle_of_only_trivial_invariant_subset
      g (by simpa using hd) ht
    have hsupport :=
      permutation_support_eq_univ_of_only_trivial_invariant_subset g hcycle ht
    apply hg
    rw [hcycle.cycleType, hsupport, Finset.card_univ, Fintype.card_fin]
  push_neg at hnot
  obtain ⟨s, hinv, hsne, hsuniv⟩ := hnot
  exact permutationVirtualMangoldt_eq_zero_of_invariant_subset
    K (Fin d) g s hsne hsuniv hinv

theorem permutationVirtualMangoldt_eq_ite_cycleType
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (g : Equiv.Perm (Fin d)) :
    permutationVirtualMangoldt K (Fin d) g =
      if g.cycleType = {d} then (d : K) else 0 := by
  split_ifs with hg
  · exact permutationVirtualMangoldt_eq_card_of_cycleType_eq_singleton
      K d hd g hg
  · exact permutationVirtualMangoldt_eq_zero_of_cycleType_ne_singleton
      K d hd g hg

theorem sum_permutationVirtualMangoldt_mul_conjInvariant
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (f : Equiv.Perm (Fin d) → K)
    (hf : ∀ g h, f (h * g * h⁻¹) = f g) :
    ∑ g : Equiv.Perm (Fin d),
        permutationVirtualMangoldt K (Fin d) g * f g =
      (d.factorial : K) * f (finRotate d) := by
  classical
  simp_rw [permutationVirtualMangoldt_eq_ite_cycleType K d hd]
  let C : Finset (Equiv.Perm (Fin d)) :=
    {g | g.cycleType = {d}}
  have hfC : ∀ g ∈ C, f g = f (finRotate d) := by
    intro g hg
    have hcycle : g.cycleType = {d} := by simpa [C] using hg
    have hconj : IsConj g (finRotate d) :=
      Equiv.Perm.isConj_iff_cycleType_eq.mpr
        (hcycle.trans (cycleType_finRotate_of_le hd).symm)
    obtain ⟨h, hh⟩ := isConj_iff.mp hconj
    rw [← hh, hf]
  rw [show (∑ g : Equiv.Perm (Fin d),
      (if g.cycleType = {d} then (d : K) else 0) * f g) =
      ∑ g ∈ C, (d : K) * f g by
    simp only [ite_mul, zero_mul]
    rw [← Finset.sum_filter]]
  calc
    (∑ g ∈ C, (d : K) * f g) =
        (C.card : K) * ((d : K) * f (finRotate d)) := by
      calc
        (∑ g ∈ C, (d : K) * f g) =
            ∑ g ∈ C, (d : K) * f (finRotate d) := by
          apply Finset.sum_congr rfl
          intro g hg
          rw [hfC g hg]
        _ = (C.card : K) * ((d : K) * f (finRotate d)) := by simp
    _ = (d.factorial : K) * f (finRotate d) := by
      have hcard : C.card = (d - 1).factorial := by
        simpa [C] using
          (Equiv.Perm.card_of_cycleType_singleton (α := Fin d) hd (by simp))
      rw [hcard]
      rw [show d.factorial = d * (d - 1).factorial by
        exact (Nat.mul_factorial_pred (by omega)).symm]
      push_cast
      ring

noncomputable def threeBlockPermutationFamily (d : ℕ)
    (π : Fin 3 → Equiv.Perm (Fin d)) : Equiv.Perm (Fin (3 * d)) :=
  (finProdFinEquiv (m := 3) (n := d)).symm |>.trans
    (Equiv.prodCongrRight π) |>.trans
    (finProdFinEquiv (m := 3) (n := d))

@[simp]
theorem threeBlockPermutationFamily_apply (d : ℕ)
    (π : Fin 3 → Equiv.Perm (Fin d)) (b : Fin 3) (j : Fin d) :
    threeBlockPermutationFamily d π (finProdFinEquiv (b, j)) =
      finProdFinEquiv (b, π b j) := by
  simp [threeBlockPermutationFamily]

theorem threeBlockPermutationFamily_const_finRotate_symm (d : ℕ) :
    threeBlockPermutationFamily d (fun _ ↦ (finRotate d).symm) =
      threeBlockCyclePermutation d := by
  ext x
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective x
  rw [threeBlockPermutationFamily_apply, threeBlockCyclePermutation_apply]

theorem threeBlockPermutationFamily_conj (d : ℕ)
    (π ρ : Fin 3 → Equiv.Perm (Fin d)) :
    threeBlockPermutationFamily d (fun b ↦ ρ b * π b * (ρ b)⁻¹) =
      threeBlockPermutationFamily d ρ *
        threeBlockPermutationFamily d π *
          (threeBlockPermutationFamily d ρ)⁻¹ := by
  ext x
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective x
  simp only [Equiv.Perm.mul_apply, threeBlockPermutationFamily_apply]
  have hinv : (threeBlockPermutationFamily d ρ)⁻¹
      (finProdFinEquiv (b, j)) =
        finProdFinEquiv (b, (ρ b)⁻¹ j) := by
    apply (threeBlockPermutationFamily d ρ).injective
    simp
  rw [hinv]
  simp

theorem threeBlockDistinctFixedPointCount_conj
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π ρ : Fin 3 → Equiv.Perm (Fin d)) :
    fullResidueUnitFiberDistinctFixedPointCount
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockPermutationFamily d
            (fun b ↦ ρ b * π b * (ρ b)⁻¹)) =
      fullResidueUnitFiberDistinctFixedPointCount
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockPermutationFamily d π) := by
  rw [threeBlockPermutationFamily_conj]
  exact fullResidueUnitFiberDistinctFixedPointCount_conj
    q (3 * d) m F g hg hdeg hm hmn t
      (threeBlockPermutationFamily d π) (threeBlockPermutationFamily d ρ)

theorem sum_three_permutationVirtualMangoldt_mul_conjInvariant
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (f : Equiv.Perm (Fin d) → Equiv.Perm (Fin d) →
      Equiv.Perm (Fin d) → K)
    (hf₀ : ∀ g₀ h g₁ g₂, f (h * g₀ * h⁻¹) g₁ g₂ = f g₀ g₁ g₂)
    (hf₁ : ∀ g₀ g₁ h g₂, f g₀ (h * g₁ * h⁻¹) g₂ = f g₀ g₁ g₂)
    (hf₂ : ∀ g₀ g₁ g₂ h, f g₀ g₁ (h * g₂ * h⁻¹) = f g₀ g₁ g₂) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        ∑ g₂ : Equiv.Perm (Fin d),
          permutationVirtualMangoldt K (Fin d) g₀ *
            permutationVirtualMangoldt K (Fin d) g₁ *
            permutationVirtualMangoldt K (Fin d) g₂ * f g₀ g₁ g₂) =
      (d.factorial : K) ^ 3 *
        f (finRotate d) (finRotate d) (finRotate d) := by
  let L : Equiv.Perm (Fin d) → K :=
    permutationVirtualMangoldt K (Fin d)
  have h₂ (g₀ g₁ : Equiv.Perm (Fin d)) :
      (∑ g₂ : Equiv.Perm (Fin d), L g₂ * f g₀ g₁ g₂) =
        (d.factorial : K) * f g₀ g₁ (finRotate d) :=
    sum_permutationVirtualMangoldt_mul_conjInvariant K d hd
      (fun g₂ ↦ f g₀ g₁ g₂) (hf₂ g₀ g₁)
  have h₁ (g₀ : Equiv.Perm (Fin d)) :
      (∑ g₁ : Equiv.Perm (Fin d), L g₁ *
        ((d.factorial : K) * f g₀ g₁ (finRotate d))) =
      (d.factorial : K) ^ 2 * f g₀ (finRotate d) (finRotate d) := by
    calc
      (∑ g₁ : Equiv.Perm (Fin d), L g₁ *
          ((d.factorial : K) * f g₀ g₁ (finRotate d))) =
        (d.factorial : K) *
          ∑ g₁ : Equiv.Perm (Fin d), L g₁ * f g₀ g₁ (finRotate d) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro g₁ _
            ring
      _ = (d.factorial : K) *
          ((d.factorial : K) * f g₀ (finRotate d) (finRotate d)) := by
            rw [sum_permutationVirtualMangoldt_mul_conjInvariant K d hd
              (fun g₁ ↦ f g₀ g₁ (finRotate d))
              (fun g₁ h ↦ hf₁ g₀ g₁ h (finRotate d))]
      _ = (d.factorial : K) ^ 2 *
          f g₀ (finRotate d) (finRotate d) := by ring
  have h₀ :
      (∑ g₀ : Equiv.Perm (Fin d), L g₀ *
        ((d.factorial : K) ^ 2 * f g₀ (finRotate d) (finRotate d))) =
      (d.factorial : K) ^ 3 * f (finRotate d) (finRotate d) (finRotate d) := by
    calc
      (∑ g₀ : Equiv.Perm (Fin d), L g₀ *
          ((d.factorial : K) ^ 2 * f g₀ (finRotate d) (finRotate d))) =
        (d.factorial : K) ^ 2 *
          ∑ g₀ : Equiv.Perm (Fin d), L g₀ * f g₀ (finRotate d) (finRotate d) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro g₀ _
            ring
      _ = (d.factorial : K) ^ 2 *
          ((d.factorial : K) * f (finRotate d) (finRotate d) (finRotate d)) := by
            rw [sum_permutationVirtualMangoldt_mul_conjInvariant K d hd
              (fun g₀ ↦ f g₀ (finRotate d) (finRotate d))
              (fun g₀ h ↦ hf₀ g₀ h (finRotate d) (finRotate d))]
      _ = (d.factorial : K) ^ 3 *
          f (finRotate d) (finRotate d) (finRotate d) := by ring
  change (∑ g₀, ∑ g₁, ∑ g₂,
    L g₀ * L g₁ * L g₂ * f g₀ g₁ g₂) = _
  calc
    (∑ g₀, ∑ g₁, ∑ g₂,
        L g₀ * L g₁ * L g₂ * f g₀ g₁ g₂) =
      ∑ g₀, ∑ g₁, L g₀ * L g₁ *
        ((d.factorial : K) * f g₀ g₁ (finRotate d)) := by
          apply Finset.sum_congr rfl
          intro g₀ _
          apply Finset.sum_congr rfl
          intro g₁ _
          rw [← h₂ g₀ g₁]
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro g₂ _
          ring
    _ = ∑ g₀, L g₀ *
        ((d.factorial : K) ^ 2 * f g₀ (finRotate d) (finRotate d)) := by
          apply Finset.sum_congr rfl
          intro g₀ _
          rw [← h₁ g₀]
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro g₁ _
          ring
    _ = _ := h₀

noncomputable def threeBlockPermutationTriple (d : ℕ)
    (g₀ g₁ g₂ : Equiv.Perm (Fin d)) : Equiv.Perm (Fin (3 * d)) :=
  threeBlockPermutationFamily d ![g₀, g₁, g₂]

theorem threeBlockPermutationTriple_conj_first (d : ℕ)
    (g₀ g₁ g₂ h : Equiv.Perm (Fin d)) :
    threeBlockPermutationTriple d (h * g₀ * h⁻¹) g₁ g₂ =
      threeBlockPermutationFamily d
          ![h, 1, 1] *
        threeBlockPermutationTriple d g₀ g₁ g₂ *
          (threeBlockPermutationFamily d
            ![h, 1, 1])⁻¹ := by
  unfold threeBlockPermutationTriple
  rw [← threeBlockPermutationFamily_conj]
  congr 1
  funext b
  fin_cases b <;> simp

theorem threeBlockPermutationTriple_conj_second (d : ℕ)
    (g₀ g₁ g₂ h : Equiv.Perm (Fin d)) :
    threeBlockPermutationTriple d g₀ (h * g₁ * h⁻¹) g₂ =
      threeBlockPermutationFamily d
          ![1, h, 1] *
        threeBlockPermutationTriple d g₀ g₁ g₂ *
          (threeBlockPermutationFamily d
            ![1, h, 1])⁻¹ := by
  unfold threeBlockPermutationTriple
  rw [← threeBlockPermutationFamily_conj]
  congr 1
  funext b
  fin_cases b <;> simp

theorem threeBlockPermutationTriple_conj_third (d : ℕ)
    (g₀ g₁ g₂ h : Equiv.Perm (Fin d)) :
    threeBlockPermutationTriple d g₀ g₁ (h * g₂ * h⁻¹) =
      threeBlockPermutationFamily d
          ![1, 1, h] *
        threeBlockPermutationTriple d g₀ g₁ g₂ *
          (threeBlockPermutationFamily d
            ![1, 1, h])⁻¹ := by
  unfold threeBlockPermutationTriple
  rw [← threeBlockPermutationFamily_conj]
  congr 1
  funext b
  fin_cases b <;> simp

theorem sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount
    (q d m : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        ∑ g₂ : Equiv.Perm (Fin d),
          permutationVirtualMangoldt ℚ (Fin d) g₀ *
            permutationVirtualMangoldt ℚ (Fin d) g₁ *
            permutationVirtualMangoldt ℚ (Fin d) g₂ *
            fullResidueUnitFiberDistinctFixedPointCount
              q (3 * d) m F g hg hdeg hm hmn t
                (threeBlockPermutationTriple d g₀ g₁ g₂)) =
      (d.factorial : ℚ) ^ 3 *
        fullResidueUnitFiberDistinctFixedPointCount
          q (3 * d) m F g hg hdeg hm hmn t
            (threeBlockPermutationTriple d
              (finRotate d) (finRotate d) (finRotate d)) := by
  apply sum_three_permutationVirtualMangoldt_mul_conjInvariant ℚ d hd
  · intro g₀ h g₁ g₂
    rw [threeBlockPermutationTriple_conj_first]
    exact_mod_cast fullResidueUnitFiberDistinctFixedPointCount_conj
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockPermutationTriple d g₀ g₁ g₂)
        (threeBlockPermutationFamily d
          ![h, 1, 1])
  · intro g₀ g₁ h g₂
    rw [threeBlockPermutationTriple_conj_second]
    exact_mod_cast fullResidueUnitFiberDistinctFixedPointCount_conj
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockPermutationTriple d g₀ g₁ g₂)
        (threeBlockPermutationFamily d
          ![1, h, 1])
  · intro g₀ g₁ g₂ h
    rw [threeBlockPermutationTriple_conj_third]
    exact_mod_cast fullResidueUnitFiberDistinctFixedPointCount_conj
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockPermutationTriple d g₀ g₁ g₂)
        (threeBlockPermutationFamily d
          ![1, 1, h])

theorem threeBlockPermutationTriple_finRotate_symm (d : ℕ) :
    threeBlockPermutationTriple d (finRotate d).symm
        (finRotate d).symm (finRotate d).symm =
      threeBlockCyclePermutation d := by
  rw [← threeBlockPermutationFamily_const_finRotate_symm]
  unfold threeBlockPermutationTriple
  congr 1
  funext b
  fin_cases b <;> rfl

theorem threeBlockPermutationFamily_const_finRotate (d : ℕ) :
    threeBlockPermutationFamily d (fun _ ↦ finRotate d) =
      threeBlockPermutationTriple d (finRotate d) (finRotate d) (finRotate d) := by
  unfold threeBlockPermutationTriple
  congr 1
  funext b
  fin_cases b <;> rfl

theorem threeBlockPermutationTriple_finRotate_isConj_cycle
    (d : ℕ) (hd : 2 ≤ d) :
    IsConj
      (threeBlockPermutationTriple d (finRotate d) (finRotate d) (finRotate d))
      (threeBlockCyclePermutation d) := by
  have htypes : (finRotate d).cycleType = ((finRotate d)⁻¹).cycleType :=
    (Equiv.Perm.cycleType_inv (finRotate d)).symm
  have hconj : IsConj (finRotate d) ((finRotate d)⁻¹) :=
    Equiv.Perm.isConj_iff_cycleType_eq.mpr htypes
  obtain ⟨h, hh⟩ := isConj_iff.mp hconj
  apply isConj_iff.mpr
  refine ⟨threeBlockPermutationFamily d (fun _ ↦ h), ?_⟩
  calc
    threeBlockPermutationFamily d (fun _ ↦ h) *
          threeBlockPermutationTriple d (finRotate d) (finRotate d) (finRotate d) *
        (threeBlockPermutationFamily d (fun _ ↦ h))⁻¹ =
      threeBlockPermutationFamily d
        (fun _ ↦ h * finRotate d * h⁻¹) := by
          rw [← threeBlockPermutationFamily_const_finRotate d]
          exact (threeBlockPermutationFamily_conj d
            (fun _ ↦ finRotate d) (fun _ ↦ h)).symm
    _ = threeBlockPermutationFamily d (fun _ ↦ (finRotate d).symm) := by
      congr 1
      funext b
      exact hh
    _ = threeBlockCyclePermutation d :=
      threeBlockPermutationFamily_const_finRotate_symm d

theorem threeBlockDistinctFixedPointCount_finRotate_eq_cycle
    (q d m : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberDistinctFixedPointCount
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockPermutationTriple d
            (finRotate d) (finRotate d) (finRotate d)) =
      fullResidueUnitFiberDistinctFixedPointCount
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d) := by
  obtain ⟨ρ, hρ⟩ := isConj_iff.mp
    (threeBlockPermutationTriple_finRotate_isConj_cycle d hd)
  have hc := fullResidueUnitFiberDistinctFixedPointCount_conj
    q (3 * d) m F g hg hdeg hm hmn t
      (threeBlockPermutationTriple d (finRotate d) (finRotate d) (finRotate d)) ρ
  have hρ' : ρ *
      threeBlockPermutationTriple d (finRotate d) (finRotate d) (finRotate d) *
        ρ.symm = threeBlockCyclePermutation d := hρ
  rw [hρ'] at hc
  exact hc.symm

theorem sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount_eq_triple
    (q d m : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        ∑ g₂ : Equiv.Perm (Fin d),
          permutationVirtualMangoldt ℚ (Fin d) g₀ *
            permutationVirtualMangoldt ℚ (Fin d) g₁ *
            permutationVirtualMangoldt ℚ (Fin d) g₂ *
            fullResidueUnitFiberDistinctFixedPointCount
              q (3 * d) m F g hg hdeg hm hmn t
                (threeBlockPermutationTriple d g₀ g₁ g₂)) =
      (d.factorial : ℚ) ^ 3 *
        (d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t)) : ℕ) := by
  rw [sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount
    q d m hd F g hg hdeg hm hmn t]
  rw [threeBlockDistinctFixedPointCount_finRotate_eq_cycle
    q d m hd F g hg hdeg hm hmn t]
  unfold fullResidueUnitFiberDistinctFixedPointCount
  rw [threeBlockDistinctFixedPoint_card_eq_triple_card
    q d m (by omega) F g hg hdeg hm hmn t]

/-- After Grothendieck--Lefschetz, the three-block character average of the
actual compact-support alternating traces is exactly the arithmetic
irreducible-triple mass, including all three root-ordering factorials. -/
theorem
    sum_three_permutationVirtualMangoldt_mul_distinctAlternatingTrace_eq_triple
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hd : 2 ≤ d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * d) m ℓ degree g hg hdeg hm hmn t)]
    (hGL : ∀ g₀ g₁ g₂ : Equiv.Perm (Fin d),
      HasDistinctCanonicalTwistedGrothendieckLefschetz
        q (3 * d) m ℓ topDegree F g hg hdeg hm hmn t
        (threeBlockPermutationTriple d g₀ g₁ g₂)) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        ∑ g₂ : Equiv.Perm (Fin d),
          (permutationVirtualMangoldt ℚ (Fin d) g₀ : ℚ_[ℓ]) *
            (permutationVirtualMangoldt ℚ (Fin d) g₁ : ℚ_[ℓ]) *
            (permutationVirtualMangoldt ℚ (Fin d) g₂ : ℚ_[ℓ]) *
            fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
              q (3 * d) m ℓ topDegree g hg hdeg hm hmn t
              (threeBlockPermutationTriple d g₀ g₁ g₂)) =
      (d.factorial : ℚ_[ℓ]) ^ 3 *
        ((d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t)) : ℕ) : ℚ_[ℓ]) := by
  unfold HasDistinctCanonicalTwistedGrothendieckLefschetz at hGL
  simp_rw [hGL]
  exact_mod_cast
    sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount_eq_triple
      q d m hd F g hg hdeg hm hmn t


end Erdos157.SawinGeometry
namespace Erdos157.SawinGeometry

open Module Set Set.powersetCard

theorem sum_two_permutationVirtualMangoldt_mul_conjInvariant
    (K : Type*) [Field K] (d : ℕ) (hd : 2 ≤ d)
    (f : Equiv.Perm (Fin d) → Equiv.Perm (Fin d) → K)
    (hf₀ : ∀ g₀ h g₁, f (h * g₀ * h⁻¹) g₁ = f g₀ g₁)
    (hf₁ : ∀ g₀ g₁ h, f g₀ (h * g₁ * h⁻¹) = f g₀ g₁) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        permutationVirtualMangoldt K (Fin d) g₀ *
          permutationVirtualMangoldt K (Fin d) g₁ * f g₀ g₁) =
      (d.factorial : K) ^ 2 * f (finRotate d) (finRotate d) := by
  let L : Equiv.Perm (Fin d) → K :=
    permutationVirtualMangoldt K (Fin d)
  have h₁ (g₀ : Equiv.Perm (Fin d)) :
      (∑ g₁ : Equiv.Perm (Fin d), L g₁ * f g₀ g₁) =
        (d.factorial : K) * f g₀ (finRotate d) :=
    sum_permutationVirtualMangoldt_mul_conjInvariant K d hd
      (fun g₁ ↦ f g₀ g₁) (hf₁ g₀)
  calc
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d), L g₀ * L g₁ * f g₀ g₁) =
        ∑ g₀ : Equiv.Perm (Fin d),
          L g₀ * ((d.factorial : K) * f g₀ (finRotate d)) := by
            apply Finset.sum_congr rfl
            intro g₀ _
            rw [← h₁ g₀, Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro g₁ _
            ring
    _ = (d.factorial : K) *
          (∑ g₀ : Equiv.Perm (Fin d),
            L g₀ * f g₀ (finRotate d)) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro g₀ _
            ring
    _ = (d.factorial : K) *
          ((d.factorial : K) * f (finRotate d) (finRotate d)) := by
            rw [sum_permutationVirtualMangoldt_mul_conjInvariant K d hd
              (fun g₀ ↦ f g₀ (finRotate d))
              (fun g₀ h ↦ hf₀ g₀ h (finRotate d))]
    _ = (d.factorial : K) ^ 2 *
          f (finRotate d) (finRotate d) := by ring

noncomputable def twoBlockPermutationFamily (d : ℕ)
    (π : Fin 2 → Equiv.Perm (Fin d)) : Equiv.Perm (Fin (2 * d)) :=
  (finProdFinEquiv (m := 2) (n := d)).symm |>.trans
    (Equiv.prodCongrRight π) |>.trans
    (finProdFinEquiv (m := 2) (n := d))

@[simp]
theorem twoBlockPermutationFamily_apply (d : ℕ)
    (π : Fin 2 → Equiv.Perm (Fin d)) (b : Fin 2) (j : Fin d) :
    twoBlockPermutationFamily d π (finProdFinEquiv (b, j)) =
      finProdFinEquiv (b, π b j) := by
  simp [twoBlockPermutationFamily]

@[simp]
theorem twoBlockPermutationFamily_symm_apply (d : ℕ)
    (π : Fin 2 → Equiv.Perm (Fin d)) (b : Fin 2) (j : Fin d) :
    (twoBlockPermutationFamily d π).symm (finProdFinEquiv (b, j)) =
      finProdFinEquiv (b, (π b).symm j) := by
  apply (twoBlockPermutationFamily d π).injective
  simp

theorem twoBlockPermutationFamily_conj (d : ℕ)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    twoBlockPermutationFamily d (fun b ↦ ρ b * π b * (ρ b)⁻¹) =
      twoBlockPermutationFamily d ρ *
        twoBlockPermutationFamily d π *
          (twoBlockPermutationFamily d ρ)⁻¹ := by
  ext x
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective x
  simp only [Equiv.Perm.mul_apply, twoBlockPermutationFamily_apply]
  have hinv : (twoBlockPermutationFamily d ρ)⁻¹
      (finProdFinEquiv (b, j)) =
        finProdFinEquiv (b, (ρ b)⁻¹ j) := by
    apply (twoBlockPermutationFamily d ρ).injective
    simp
  rw [hinv]
  simp

noncomputable def twoBlockPermutationPair (d : ℕ)
    (g₀ g₁ : Equiv.Perm (Fin d)) : Equiv.Perm (Fin (2 * d)) :=
  twoBlockPermutationFamily d ![g₀, g₁]

noncomputable def twoBlockTuplePolynomial
    (d : ℕ) (F : Type*) [CommRing F]
    (x : Fin (2 * d) → F) (b : Fin 2) : Polynomial F :=
  ∏ j : Fin d, (Polynomial.X - Polynomial.C (x (finProdFinEquiv (b, j))))

noncomputable def properPairTuplePolynomial
    (d : ℕ) (F : Type*) [CommRing F]
    (x : Fin (2 * d) → F) : Polynomial F :=
  (twoBlockTuplePolynomial d F x 0) ^ 2 *
    twoBlockTuplePolynomial d F x 1

structure ProperPairTwistedTupleData
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q))
    (π₀ π₁ : Equiv.Perm (Fin d)) where
  coords : Fin (2 * d) → F
  avoids : ∀ i,
    Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (coords i) g ≠ 0
  injective : Function.Injective coords
  residue_condition :
    properPairTuplePolynomial d F coords %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F)
  twisted_fixed :
    twistedTupleFrobenius q (2 * d) F
      (twoBlockPermutationPair d π₀ π₁) coords = coords

namespace ProperPairTwistedTupleData

@[ext]
theorem ext
    {q d : ℕ} [Fact q.Prime]
    {F : Type*} [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    {π₀ π₁ : Equiv.Perm (Fin d)}
    {x y : ProperPairTwistedTupleData q d F g t π₀ π₁}
    (h : x.coords = y.coords) : x = y := by
  cases x
  cases y
  cases h
  rfl

end ProperPairTwistedTupleData

theorem twoBlockTuplePolynomial_comp_family
    (d : ℕ) (F : Type*) [CommRing F]
    (x : Fin (2 * d) → F) (ρ : Fin 2 → Equiv.Perm (Fin d))
    (b : Fin 2) :
    twoBlockTuplePolynomial d F
        (fun i ↦ x ((twoBlockPermutationFamily d ρ).symm i)) b =
      twoBlockTuplePolynomial d F x b := by
  unfold twoBlockTuplePolynomial
  have hinv : ∀ j : Fin d,
      (twoBlockPermutationFamily d ρ).symm (finProdFinEquiv (b, j)) =
        finProdFinEquiv (b, (ρ b).symm j) := by
    intro j
    apply (twoBlockPermutationFamily d ρ).injective
    simp
  simp_rw [hinv]
  exact Equiv.prod_comp (ρ b).symm
    (fun j ↦ Polynomial.X - Polynomial.C (x (finProdFinEquiv (b, j))))

theorem properPairTuplePolynomial_comp_family
    (d : ℕ) (F : Type*) [CommRing F]
    (x : Fin (2 * d) → F) (ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairTuplePolynomial d F
        (fun i ↦ x ((twoBlockPermutationFamily d ρ).symm i)) =
      properPairTuplePolynomial d F x := by
  unfold properPairTuplePolynomial
  rw [twoBlockTuplePolynomial_comp_family,
    twoBlockTuplePolynomial_comp_family]

noncomputable def ProperPairTwistedTupleData.conj
    {q d : ℕ} [Fact q.Prime]
    {F : Type*} [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    {π₀ π₁ : Equiv.Perm (Fin d)}
    (x : ProperPairTwistedTupleData q d F g t π₀ π₁)
    (h₀ h₁ : Equiv.Perm (Fin d)) :
    ProperPairTwistedTupleData q d F g t
      (h₀ * π₀ * h₀⁻¹) (h₁ * π₁ * h₁⁻¹) := by
  let ρ : Fin 2 → Equiv.Perm (Fin d) := ![h₀, h₁]
  let y : Fin (2 * d) → F :=
    fun i ↦ x.coords ((twoBlockPermutationFamily d ρ).symm i)
  refine ⟨y, ?_, ?_, ?_, ?_⟩
  · intro i
    exact x.avoids _
  · exact x.injective.comp (twoBlockPermutationFamily d ρ).symm.injective
  · rw [properPairTuplePolynomial_comp_family]
    exact x.residue_condition
  · apply (twistedTupleFrobenius_fixed_iff q (2 * d) F _ _).2
    intro i
    have hx := (twistedTupleFrobenius_fixed_iff q (2 * d) F _ _).1
      x.twisted_fixed ((twoBlockPermutationFamily d ρ).symm i)
    have hperm :
        twoBlockPermutationPair d (h₀ * π₀ * h₀⁻¹) (h₁ * π₁ * h₁⁻¹) =
          twoBlockPermutationFamily d ρ *
            twoBlockPermutationPair d π₀ π₁ *
              (twoBlockPermutationFamily d ρ)⁻¹ := by
      calc
        _ = twoBlockPermutationFamily d
            (fun b ↦ ρ b * ![π₀, π₁] b * (ρ b)⁻¹) := by
              unfold twoBlockPermutationPair
              congr 1
              funext b
              fin_cases b <;> rfl
        _ = _ := twoBlockPermutationFamily_conj d ![π₀, π₁] ρ
    rw [hperm]
    simpa [y, Equiv.Perm.mul_apply] using hx

noncomputable def ProperPairTwistedTupleData.transport
    {q d : ℕ} [Fact q.Prime]
    {F : Type*} [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    {π₀ π₁ ρ₀ ρ₁ : Equiv.Perm (Fin d)}
    (h₀ : π₀ = ρ₀) (h₁ : π₁ = ρ₁)
    (x : ProperPairTwistedTupleData q d F g t π₀ π₁) :
    ProperPairTwistedTupleData q d F g t ρ₀ ρ₁ := by
  subst ρ₀
  subst ρ₁
  exact x

@[simp]
theorem ProperPairTwistedTupleData.transport_coords
    {q d : ℕ} [Fact q.Prime]
    {F : Type*} [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    {π₀ π₁ ρ₀ ρ₁ : Equiv.Perm (Fin d)}
    (h₀ : π₀ = ρ₀) (h₁ : π₁ = ρ₁)
    (x : ProperPairTwistedTupleData q d F g t π₀ π₁) :
    (x.transport h₀ h₁).coords = x.coords := by
  subst ρ₀
  subst ρ₁
  rfl

noncomputable def properPairTwistedTupleConjEquiv
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q))
    (π₀ π₁ h₀ h₁ : Equiv.Perm (Fin d)) :
    ProperPairTwistedTupleData q d F g t π₀ π₁ ≃
      ProperPairTwistedTupleData q d F g t
        (h₀ * π₀ * h₀⁻¹) (h₁ * π₁ * h₁⁻¹) where
  toFun x := x.conj h₀ h₁
  invFun x := by
    have x' := x.conj h₀.symm h₁.symm
    have h₀' : h₀.symm * (h₀ * π₀ * h₀⁻¹) * h₀.symm⁻¹ = π₀ := by
      change h₀⁻¹ * (h₀ * π₀ * h₀⁻¹) * (h₀⁻¹)⁻¹ = π₀
      group
    have h₁' : h₁.symm * (h₁ * π₁ * h₁⁻¹) * h₁.symm⁻¹ = π₁ := by
      change h₁⁻¹ * (h₁ * π₁ * h₁⁻¹) * (h₁⁻¹)⁻¹ = π₁
      group
    exact x'.transport h₀' h₁'
  left_inv x := by
    apply ProperPairTwistedTupleData.ext
    funext i
    simp only [ProperPairTwistedTupleData.transport_coords]
    dsimp only [ProperPairTwistedTupleData.conj]
    apply congrArg x.coords
    obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
    fin_cases b <;> simp
  right_inv x := by
    apply ProperPairTwistedTupleData.ext
    funext i
    dsimp only [ProperPairTwistedTupleData.conj]
    simp only [ProperPairTwistedTupleData.transport_coords]
    apply congrArg x.coords
    obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
    fin_cases b <;> simp

noncomputable def properPairTwistedTupleCount
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q))
    (π₀ π₁ : Equiv.Perm (Fin d)) : ℕ :=
  Nat.card (ProperPairTwistedTupleData q d F g t π₀ π₁)

theorem properPairTwistedTupleCount_conj
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q))
    (π₀ π₁ h₀ h₁ : Equiv.Perm (Fin d)) :
    properPairTwistedTupleCount q d F g t
        (h₀ * π₀ * h₀⁻¹) (h₁ * π₁ * h₁⁻¹) =
      properPairTwistedTupleCount q d F g t π₀ π₁ := by
  unfold properPairTwistedTupleCount
  exact (Nat.card_congr
    (properPairTwistedTupleConjEquiv q d F g t π₀ π₁ h₀ h₁)).symm

theorem sum_two_permutationVirtualMangoldt_mul_properPairCount
    (q d : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        permutationVirtualMangoldt ℚ (Fin d) g₀ *
          permutationVirtualMangoldt ℚ (Fin d) g₁ *
          properPairTwistedTupleCount q d F g t g₀ g₁) =
      (d.factorial : ℚ) ^ 2 *
        properPairTwistedTupleCount q d F g t
          (finRotate d) (finRotate d) := by
  apply sum_two_permutationVirtualMangoldt_mul_conjInvariant ℚ d hd
  · intro g₀ h g₁
    exact_mod_cast properPairTwistedTupleCount_conj
      q d F g t g₀ g₁ h 1
  · intro g₀ g₁ h
    exact_mod_cast properPairTwistedTupleCount_conj
      q d F g t g₀ g₁ 1 h

structure CongruentIrreducibleProperPair
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) where
  repeated : Polynomial.MonicDegreeEq (ZMod q) d
  single : Polynomial.MonicDegreeEq (ZMod q) d
  product_mod : (repeated.1 ^ 2 * single.1) %ₘ g = t
  coprime : IsCoprime repeated.1 single.1
  repeated_irreducible : Irreducible repeated.1
  single_irreducible : Irreducible single.1

namespace CongruentIrreducibleProperPair

@[ext]
theorem ext
    {q d : ℕ} [Fact q.Prime]
    {g t : Polynomial (ZMod q)}
    {x y : CongruentIrreducibleProperPair q d g t}
    (h₀ : x.repeated = y.repeated) (h₁ : x.single = y.single) : x = y := by
  cases x
  cases y
  cases h₀
  cases h₁
  rfl

end CongruentIrreducibleProperPair

abbrev TwoBlockCycleTupleData
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) :=
  ProperPairTwistedTupleData q d F g t
    (finRotate d).symm (finRotate d).symm

noncomputable def twoBlockFixedBlock
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    {y : Fin d → F //
      twistedTupleFrobenius q d F (finRotate d).symm y = y} := by
  refine ⟨fun j ↦ x.coords (finProdFinEquiv (b, j)), ?_⟩
  apply (twistedTupleFrobenius_fixed_iff q d F (finRotate d).symm _).2
  intro j
  have hx := (twistedTupleFrobenius_fixed_iff q (2 * d) F
    (twoBlockPermutationPair d (finRotate d).symm (finRotate d).symm)
    x.coords).1 x.twisted_fixed (finProdFinEquiv (b, j))
  fin_cases b <;> simpa [twoBlockPermutationPair] using hx

theorem twoBlockFixedBlock_eq_frobenius_iterate
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) (j : Fin d) :
    (twoBlockFixedBlock q d F x b).1 j =
      (frobeniusEquiv F q)^[j.1]
        ((twoBlockFixedBlock q d F x b).1 ⟨0, hd⟩) := by
  have hrec : ∀ n : ℕ, ∀ hn : n < d,
      (twoBlockFixedBlock q d F x b).1 ⟨n, hn⟩ =
        (frobeniusEquiv F q)^[n]
          ((twoBlockFixedBlock q d F x b).1 ⟨0, hd⟩) := by
    intro n
    induction n with
    | zero =>
        intro hn
        rfl
    | succ n ih =>
        intro hn
        have hfix := (twistedTupleFrobenius_fixed_iff q d F
          (finRotate d).symm (twoBlockFixedBlock q d F x b)).1
          (twoBlockFixedBlock q d F x b).2 ⟨n + 1, hn⟩
        have hprev : (finRotate d).symm (⟨n + 1, hn⟩ : Fin d) =
            ⟨n, by omega⟩ := by
          apply (finRotate d).injective
          simp only [Equiv.apply_symm_apply]
          rw [finRotate_apply]
          apply Fin.ext
          simp [Fin.add_def, Nat.mod_eq_of_lt hn]
        rw [hprev] at hfix
        calc
          (twoBlockFixedBlock q d F x b).1 ⟨n + 1, hn⟩ =
              frobeniusEquiv F q
                ((twoBlockFixedBlock q d F x b).1 ⟨n, by omega⟩) := hfix.symm
          _ = frobeniusEquiv F q
                ((frobeniusEquiv F q)^[n]
                  ((twoBlockFixedBlock q d F x b).1 ⟨0, hd⟩)) :=
              congrArg (frobeniusEquiv F q) (ih (by omega))
          _ = (frobeniusEquiv F q)^[n + 1]
                ((twoBlockFixedBlock q d F x b).1 ⟨0, hd⟩) :=
              (Function.iterate_succ_apply' (frobeniusEquiv F q) n _).symm
  exact hrec j.1 j.2

noncomputable def twoBlockDescendedFactor
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    Polynomial (ZMod q) :=
  descendedTupleRootPolynomial q d F (finRotate d).symm
    (twoBlockFixedBlock q d F x b)

theorem twoBlockDescendedFactor_map
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    (twoBlockDescendedFactor q d F x b).map
        (ZMod.castHom (m := q) dvd_rfl F) =
      twoBlockTuplePolynomial d F x.coords b := by
  exact descendedTupleRootPolynomial_map q d F (finRotate d).symm _

theorem twoBlockDescendedFactor_monic
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    (twoBlockDescendedFactor q d F x b).Monic :=
  descendedTupleRootPolynomial_monic q d F (finRotate d).symm _

theorem twoBlockDescendedFactor_natDegree
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    (twoBlockDescendedFactor q d F x b).natDegree = d :=
  descendedTupleRootPolynomial_natDegree q d F (finRotate d).symm _

theorem twoBlockFixedBlock_injective
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    Function.Injective (twoBlockFixedBlock q d F x b).1 := by
  intro i j hij
  have h := x.injective (show
    x.coords (finProdFinEquiv (b, i)) =
      x.coords (finProdFinEquiv (b, j)) from hij)
  simpa using congrArg (fun z : Fin (2 * d) ↦
    (finProdFinEquiv.symm z).2) h

theorem twoBlockDescendedFactor_irreducible
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    Irreducible (twoBlockDescendedFactor q d F x b) := by
  apply irreducible_of_distinct_frobenius_orbit q d F
    ((twoBlockFixedBlock q d F x b).1 ⟨0, hd⟩)
  · exact hd
  · exact twoBlockDescendedFactor_monic q d F x b
  · exact twoBlockDescendedFactor_natDegree q d F x b
  · rw [twoBlockDescendedFactor_map]
    unfold twoBlockTuplePolynomial
    apply Finset.prod_congr rfl
    intro j _
    exact congrArg (fun z : F ↦ Polynomial.X - Polynomial.C z)
      (twoBlockFixedBlock_eq_frobenius_iterate q d hd F x b j)
  · intro i j hij
    apply twoBlockFixedBlock_injective q d F x b
    exact (twoBlockFixedBlock_eq_frobenius_iterate q d hd F x b i).trans
      (hij.trans
        (twoBlockFixedBlock_eq_frobenius_iterate q d hd F x b j).symm)

theorem twoBlockDescendedFactor_ne
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) :
    twoBlockDescendedFactor q d F x 0 ≠
      twoBlockDescendedFactor q d F x 1 := by
  intro heq
  let α := (twoBlockFixedBlock q d F x 0).1 ⟨0, hd⟩
  have hroot0 : ((twoBlockDescendedFactor q d F x 0).map
      (ZMod.castHom (m := q) dvd_rfl F)).IsRoot α := by
    rw [twoBlockDescendedFactor_map]
    unfold twoBlockTuplePolynomial
    rw [Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
    · exact Finset.mem_univ _
    · simp [α, twoBlockFixedBlock]
  have hroot1 : ((twoBlockDescendedFactor q d F x 1).map
      (ZMod.castHom (m := q) dvd_rfl F)).IsRoot α := by
    simpa only [heq] using hroot0
  rw [twoBlockDescendedFactor_map, Polynomial.IsRoot,
    show twoBlockTuplePolynomial d F x.coords 1 =
      ∏ j : Fin d, (Polynomial.X -
        Polynomial.C (x.coords (finProdFinEquiv (1, j)))) by rfl,
    Polynomial.eval_prod, Finset.prod_eq_zero_iff] at hroot1
  obtain ⟨j, _hj, hj⟩ := hroot1
  have hα : (twoBlockFixedBlock q d F x 0).1 ⟨0, hd⟩ =
      (twoBlockFixedBlock q d F x 1).1 j := by
    apply sub_eq_zero.mp
    simpa [α, twoBlockFixedBlock] using hj
  have hidx := x.injective (show
    x.coords (finProdFinEquiv (0, ⟨0, hd⟩)) =
      x.coords (finProdFinEquiv (1, j)) from hα)
  have := congrArg (fun z : Fin (2 * d) ↦
    (finProdFinEquiv.symm z).1) hidx
  norm_num at this

theorem twoBlockDescendedFactor_isCoprime
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) :
    IsCoprime (twoBlockDescendedFactor q d F x 0)
      (twoBlockDescendedFactor q d F x 1) := by
  let f₀ := twoBlockDescendedFactor q d F x 0
  let f₁ := twoBlockDescendedFactor q d F x 1
  have hi₀ := twoBlockDescendedFactor_irreducible q d hd F x 0
  have hi₁ := twoBlockDescendedFactor_irreducible q d hd F x 1
  rw [hi₀.coprime_iff_not_dvd]
  intro hdvd
  have hassoc := hi₀.associated_of_dvd hi₁ hdvd
  have heq : f₀ = f₁ := Polynomial.eq_of_monic_of_associated
    (twoBlockDescendedFactor_monic q d F x 0)
    (twoBlockDescendedFactor_monic q d F x 1) hassoc
  exact twoBlockDescendedFactor_ne q d hd F x heq

noncomputable def twoBlockCycleTupleToProperPair
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : TwoBlockCycleTupleData q d F g t) :
    CongruentIrreducibleProperPair q d g t := by
  let f₀ := twoBlockDescendedFactor q d F x 0
  let f₁ := twoBlockDescendedFactor q d F x 1
  let P₀ : Polynomial.MonicDegreeEq (ZMod q) d :=
    Polynomial.MonicDegreeEq.mk f₀
      (twoBlockDescendedFactor_monic q d F x 0)
      (twoBlockDescendedFactor_natDegree q d F x 0)
  let P₁ : Polynomial.MonicDegreeEq (ZMod q) d :=
    Polynomial.MonicDegreeEq.mk f₁
      (twoBlockDescendedFactor_monic q d F x 1)
      (twoBlockDescendedFactor_natDegree q d F x 1)
  refine ⟨P₀, P₁, ?_,
    twoBlockDescendedFactor_isCoprime q d hd F x,
    twoBlockDescendedFactor_irreducible q d hd F x 0,
    twoBlockDescendedFactor_irreducible q d hd F x 1⟩
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  rw [Polynomial.map_modByMonic _ hg]
  change ((f₀ ^ 2 * f₁).map
      (ZMod.castHom (m := q) dvd_rfl F)) %ₘ
      g.map (ZMod.castHom (m := q) dvd_rfl F) =
    t.map (ZMod.castHom (m := q) dvd_rfl F)
  rw [Polynomial.map_mul, Polynomial.map_pow, twoBlockDescendedFactor_map,
    twoBlockDescendedFactor_map]
  exact x.residue_condition

noncomputable def congruentIrreducibleProperPairFactor
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t) (b : Fin 2) :
    Polynomial (ZMod q) :=
  ![T.repeated.1, T.single.1] b

theorem congruentIrreducibleProperPairFactor_monic
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t) (b : Fin 2) :
    (congruentIrreducibleProperPairFactor q d g t T b).Monic := by
  fin_cases b
  · exact T.repeated.monic
  · exact T.single.monic

theorem congruentIrreducibleProperPairFactor_natDegree
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t) (b : Fin 2) :
    (congruentIrreducibleProperPairFactor q d g t T b).natDegree = d := by
  fin_cases b
  · exact T.repeated.natDegree
  · exact T.single.natDegree

theorem congruentIrreducibleProperPairFactor_irreducible
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t) (b : Fin 2) :
    Irreducible (congruentIrreducibleProperPairFactor q d g t T b) := by
  fin_cases b
  · exact T.repeated_irreducible
  · exact T.single_irreducible

theorem congruentIrreducibleProperPairFactor_isCoprime
    (q d : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t) {b c : Fin 2}
    (hbc : b ≠ c) :
    IsCoprime (congruentIrreducibleProperPairFactor q d g t T b)
      (congruentIrreducibleProperPairFactor q d g t T c) := by
  fin_cases b <;> fin_cases c <;> simp at hbc
  · exact T.coprime
  · exact T.coprime.symm

noncomputable def twoBlockRootChoiceCoords
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (roots : Fin 2 → F) : Fin (2 * d) → F :=
  fun i ↦
    let bj := finProdFinEquiv.symm i
    (frobeniusEquiv F q)^[bj.2.1] (roots bj.1)

@[simp]
theorem twoBlockRootChoiceCoords_apply
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (roots : Fin 2 → F) (b : Fin 2) (j : Fin d) :
    twoBlockRootChoiceCoords q d F roots (finProdFinEquiv (b, j)) =
      (frobeniusEquiv F q)^[j.1] (roots b) := by
  simp [twoBlockRootChoiceCoords]

theorem twoBlockRootChoiceCoords_twisted_fixed
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (T : Fin 2 → Polynomial (ZMod q))
    (hTirr : ∀ b, Irreducible (T b))
    (hTdeg : ∀ b, (T b).natDegree = d)
    (roots : ∀ b, (T b).rootSet F) :
    twistedTupleFrobenius q (2 * d) F
        (twoBlockPermutationPair d (finRotate d).symm (finRotate d).symm)
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)) =
      twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1) := by
  obtain ⟨e, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hd)
  apply (twistedTupleFrobenius_fixed_iff q (2 * (e + 1)) F _ _).2
  intro i
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  simp only [twoBlockPermutationPair, twoBlockPermutationFamily_apply,
    Matrix.cons_val_fin_one, Matrix.cons_val_zero,
    twoBlockRootChoiceCoords_apply, frobeniusEquiv_def]
  have hb : ![(finRotate (e + 1)).symm,
      (finRotate (e + 1)).symm] b = (finRotate (e + 1)).symm := by
    fin_cases b <;> rfl
  rw [hb]
  by_cases hj : j = 0
  · subst j
    have hpred : ((finRotate (e + 1)).symm (0 : Fin (e + 1))).1 = e := by
      rw [finRotate_symm_apply]
      exact Fin.coe_neg_one
    change frobeniusEquiv F q
        ((frobeniusEquiv F q)^[((finRotate (e + 1)).symm
          (0 : Fin (e + 1))).1] (roots b).1) = (roots b).1
    rw [← Function.iterate_succ_apply' (frobeniusEquiv F q), hpred]
    exact irreducibleRoot_frobenius_iterate_natDegree
      q (e + 1) F (T b) (hTirr b) (hTdeg b) (roots b)
  · have hpred : ((finRotate (e + 1)).symm j).1 = j.1 - 1 :=
      coe_finRotate_symm_of_ne_zero hj
    have hjpos : 0 < j.1 := Fin.pos_iff_ne_zero.mpr hj
    change frobeniusEquiv F q
        ((frobeniusEquiv F q)^[((finRotate (e + 1)).symm j).1]
          (roots b).1) =
      (frobeniusEquiv F q)^[j.1] (roots b).1
    rw [← Function.iterate_succ_apply' (frobeniusEquiv F q), hpred]
    congr 2
    omega

theorem aeval_ne_zero_or_ne_zero_of_isCoprime
    {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    {p s : Polynomial R} (h : IsCoprime p s) (z : F) :
    Polynomial.aeval z p ≠ 0 ∨ Polynomial.aeval z s ≠ 0 := by
  by_contra hn
  push Not at hn
  have hc := h.map (Polynomial.aeval z).toRingHom
  change (Polynomial.aeval z).toRingHom p = 0 ∧
    (Polynomial.aeval z).toRingHom s = 0 at hn
  rw [hn.1, hn.2] at hc
  have hu : IsUnit (0 : F) := hc.isUnit_of_dvd (dvd_refl 0)
  exact not_isUnit_zero hu

theorem twoBlockRootChoiceCoords_factor_aeval
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F)
    (b : Fin 2) (j : Fin d) :
    Polynomial.aeval
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)
          (finProdFinEquiv (b, j)))
        (congruentIrreducibleProperPairFactor q d g t T b) = 0 := by
  let p := congruentIrreducibleProperPairFactor q d g t T b
  have hfac := irreducible_map_eq_prod_frobeniusOrbit q d F p
    (congruentIrreducibleProperPairFactor_monic q d g t T b)
    (congruentIrreducibleProperPairFactor_irreducible q d g t T b)
    (congruentIrreducibleProperPairFactor_natDegree q d g t T b)
    (roots b)
  have hroot : (p.map (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      ((frobeniusEquiv F q)^[j.1] (roots b).1) := by
    rw [hfac, Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := j)
    · exact Finset.mem_univ j
    · simp
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  rw [twoBlockRootChoiceCoords_apply]
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem twoBlockRootChoiceCoords_injective
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    Function.Injective
      (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)) := by
  intro i k hik
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  obtain ⟨⟨c, l⟩, rfl⟩ := finProdFinEquiv.surjective k
  suffices (b, j) = (c, l) by exact congrArg finProdFinEquiv this
  by_cases hbc : b = c
  · subst c
    congr 1
    apply (irreducibleRoot_frobeniusOrbit_injective q d F
      (congruentIrreducibleProperPairFactor q d g t T b)
      (congruentIrreducibleProperPairFactor_irreducible q d g t T b)
      (congruentIrreducibleProperPairFactor_natDegree q d g t T b)
      (roots b))
    simpa only [twoBlockRootChoiceCoords_apply] using hik
  · exfalso
    have hbzero := twoBlockRootChoiceCoords_factor_aeval
      q d F g t T roots b j
    have hczero := twoBlockRootChoiceCoords_factor_aeval
      q d F g t T roots c l
    have hcop := aeval_ne_zero_or_ne_zero_of_isCoprime
      (congruentIrreducibleProperPairFactor_isCoprime
        q d g t T hbc)
      (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)
        (finProdFinEquiv (b, j)))
    have hczero' : Polynomial.aeval
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)
          (finProdFinEquiv (b, j)))
        (congruentIrreducibleProperPairFactor q d g t T c) = 0 := by
      rw [hik]
      exact hczero
    exact hcop.elim (fun h ↦ h hbzero) (fun h ↦ h hczero')

theorem twoBlockRootChoiceCoords_properPolynomial
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    properPairTuplePolynomial d F
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)) =
      (T.repeated.1 ^ 2 * T.single.1).map
        (ZMod.castHom (m := q) dvd_rfl F) := by
  have hfactor : ∀ b : Fin 2,
      (congruentIrreducibleProperPairFactor q d g t T b).map
          (ZMod.castHom (m := q) dvd_rfl F) =
        twoBlockTuplePolynomial d F
          (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)) b := by
    intro b
    rw [irreducible_map_eq_prod_frobeniusOrbit q d F
      (congruentIrreducibleProperPairFactor q d g t T b)
      (congruentIrreducibleProperPairFactor_monic q d g t T b)
      (congruentIrreducibleProperPairFactor_irreducible q d g t T b)
      (congruentIrreducibleProperPairFactor_natDegree q d g t T b)
      (roots b)]
    unfold twoBlockTuplePolynomial
    apply Finset.prod_congr rfl
    intro j _
    rw [twoBlockRootChoiceCoords_apply]
  unfold properPairTuplePolynomial
  rw [← hfactor 0, ← hfactor 1, ← Polynomial.map_pow,
    ← Polynomial.map_mul]
  rfl

theorem twoBlockRootChoiceCoords_mod
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    properPairTuplePolynomial d F
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)) %ₘ
      g.map (ZMod.castHom (m := q) dvd_rfl F) =
        t.map (ZMod.castHom (m := q) dvd_rfl F) := by
  rw [twoBlockRootChoiceCoords_properPolynomial q d F g t T roots]
  rw [← Polynomial.map_modByMonic _ hg]
  simpa using congrArg
    (Polynomial.map (ZMod.castHom (m := q) dvd_rfl F)) T.product_mod

theorem twoBlockRootChoiceCoords_avoids
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    ∀ i,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
        (twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1) i) g ≠ 0 := by
  intro i hgeval
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  let z := twoBlockRootChoiceCoords q d F
    (fun b ↦ (roots b).1) (finProdFinEquiv (b, j))
  let P := T.repeated.1 ^ 2 * T.single.1
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  have hgzero : Polynomial.aeval z g = 0 := by
    simpa [Polynomial.aeval_def, hι, z] using hgeval
  have hbzero := twoBlockRootChoiceCoords_factor_aeval
    q d F g t T roots b j
  have hPzero : Polynomial.aeval z P = 0 := by
    dsimp only [P]
    fin_cases b
    · have hb : Polynomial.aeval z T.repeated.1 = 0 := by
        simpa [congruentIrreducibleProperPairFactor, z] using hbzero
      simp [hb]
    · have hb : Polynomial.aeval z T.single.1 = 0 := by
        simpa [congruentIrreducibleProperPairFactor, z] using hbzero
      simp [hb]
  have hremzero : Polynomial.aeval z (P %ₘ g) = 0 := by
    have hdiv := congrArg (Polynomial.aeval z)
      (Polynomial.modByMonic_add_div P g)
    simp only [map_add, map_mul, hgzero, zero_mul, add_zero, hPzero] at hdiv
    exact hdiv
  have htzero : Polynomial.aeval z t = 0 := by
    rw [← T.product_mod]
    exact hremzero
  exact (aeval_ne_zero_or_ne_zero_of_isCoprime hgt z).elim
    (fun h ↦ h hgzero) (fun h ↦ h htzero)

noncomputable def twoBlockRootChoicesToCycleTuple
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    TwoBlockCycleTupleData q d F g t := by
  let y := twoBlockRootChoiceCoords q d F (fun b ↦ (roots b).1)
  refine ⟨y,
    twoBlockRootChoiceCoords_avoids q d F g t hg hgt T roots,
    twoBlockRootChoiceCoords_injective q d hd F g t T roots,
    twoBlockRootChoiceCoords_mod q d F g t hg T roots, ?_⟩
  exact twoBlockRootChoiceCoords_twisted_fixed q d hd F
    (fun b ↦ congruentIrreducibleProperPairFactor q d g t T b)
    (congruentIrreducibleProperPairFactor_irreducible q d g t T)
    (congruentIrreducibleProperPairFactor_natDegree q d g t T)
    roots

theorem twoBlockCycleTupleToProperPair_factor
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    congruentIrreducibleProperPairFactor q d g t
        (twoBlockCycleTupleToProperPair q d hd F g t hg x) b =
      twoBlockDescendedFactor q d F x b := by
  fin_cases b <;> rfl

theorem twoBlockRootChoicesToCycleTuple_factor
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F)
    (b : Fin 2) :
    congruentIrreducibleProperPairFactor q d g t
        (twoBlockCycleTupleToProperPair q d hd F g t hg
          (twoBlockRootChoicesToCycleTuple
            q d hd F g t hg hgt T roots)) b =
      congruentIrreducibleProperPairFactor q d g t T b := by
  rw [twoBlockCycleTupleToProperPair_factor]
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  rw [twoBlockDescendedFactor_map]
  rw [irreducible_map_eq_prod_frobeniusOrbit q d F
    (congruentIrreducibleProperPairFactor q d g t T b)
    (congruentIrreducibleProperPairFactor_monic q d g t T b)
    (congruentIrreducibleProperPairFactor_irreducible q d g t T b)
    (congruentIrreducibleProperPairFactor_natDegree q d g t T b)
    (roots b)]
  unfold twoBlockTuplePolynomial
  apply Finset.prod_congr rfl
  intro j _
  congr 3
  simp only [coe_frobeniusEquiv]
  rw [Equiv.symm_apply_apply]

theorem twoBlockRootChoicesToCycleTuple_toProperPair
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t)
    (roots : ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F) :
    twoBlockCycleTupleToProperPair q d hd F g t hg
        (twoBlockRootChoicesToCycleTuple q d hd F g t hg hgt T roots) = T := by
  apply CongruentIrreducibleProperPair.ext
  · apply Subtype.ext
    exact twoBlockRootChoicesToCycleTuple_factor
      q d hd F g t hg hgt T roots 0
  · apply Subtype.ext
    exact twoBlockRootChoicesToCycleTuple_factor
      q d hd F g t hg hgt T roots 1

noncomputable def twoBlockCycleTupleInitial
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)}
    (x : TwoBlockCycleTupleData q d F g t) : Fin 2 → F :=
  fun b ↦ x.coords (finProdFinEquiv (b, ⟨0, hd⟩))

theorem twoBlockCycleTupleInitial_injective
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    {g t : Polynomial (ZMod q)} :
    Function.Injective
      (twoBlockCycleTupleInitial q d hd F :
        TwoBlockCycleTupleData q d F g t → Fin 2 → F) := by
  intro x y h
  apply ProperPairTwistedTupleData.ext
  funext i
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  change (twoBlockFixedBlock q d F x b).1 j =
    (twoBlockFixedBlock q d F y b).1 j
  have hx := twoBlockFixedBlock_eq_frobenius_iterate
    q d hd F x b j
  have hy := twoBlockFixedBlock_eq_frobenius_iterate
    q d hd F y b j
  have hi := congrArg ((frobeniusEquiv F q)^[j.1]) (congrFun h b)
  exact hx.trans (hi.trans hy.symm)

theorem twoBlockCycleTupleInitial_isRoot_factor
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (x : TwoBlockCycleTupleData q d F g t) (b : Fin 2) :
    ((congruentIrreducibleProperPairFactor q d g t
      (twoBlockCycleTupleToProperPair q d hd F g t hg x) b).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      (twoBlockCycleTupleInitial q d hd F x b) := by
  rw [twoBlockCycleTupleToProperPair_factor,
    twoBlockDescendedFactor_map]
  unfold twoBlockTuplePolynomial
  rw [Polynomial.IsRoot, Polynomial.eval_prod]
  apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
  · exact Finset.mem_univ _
  · simp [twoBlockCycleTupleInitial]

noncomputable def twoBlockCycleTupleFiberInitialRoots
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (T : CongruentIrreducibleProperPair q d g t)
    (x : {x : TwoBlockCycleTupleData q d F g t //
      twoBlockCycleTupleToProperPair q d hd F g t hg x = T}) :
    ∀ b,
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F := by
  intro b
  refine ⟨twoBlockCycleTupleInitial q d hd F x.1 b, ?_⟩
  rw [(congruentIrreducibleProperPairFactor_monic
    q d g t T b).mem_rootSet]
  have hroot := twoBlockCycleTupleInitial_isRoot_factor
    q d hd F g t hg x.1 b
  rw [x.2] at hroot
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

noncomputable def twoBlockCycleTupleFiberEquivRoots
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t) :
    {x : TwoBlockCycleTupleData q d F g t //
        twoBlockCycleTupleToProperPair q d hd F g t hg x = T} ≃
      ∀ b,
        (congruentIrreducibleProperPairFactor q d g t T b).rootSet F where
  toFun := twoBlockCycleTupleFiberInitialRoots q d hd F g t hg T
  invFun roots :=
    ⟨twoBlockRootChoicesToCycleTuple q d hd F g t hg hgt T roots,
      twoBlockRootChoicesToCycleTuple_toProperPair
        q d hd F g t hg hgt T roots⟩
  left_inv x := by
    apply Subtype.ext
    apply twoBlockCycleTupleInitial_injective q d hd F
    funext b
    simp [twoBlockCycleTupleFiberInitialRoots,
      twoBlockCycleTupleInitial, twoBlockRootChoicesToCycleTuple,
      twoBlockRootChoiceCoords]
  right_inv roots := by
    funext b
    apply Subtype.ext
    simp [twoBlockCycleTupleFiberInitialRoots,
      twoBlockCycleTupleInitial, twoBlockRootChoicesToCycleTuple,
      twoBlockRootChoiceCoords]
    rw [Equiv.symm_apply_apply]

theorem twoBlockCycleTupleToProperPair_fiber_card_eq
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t)
    (T : CongruentIrreducibleProperPair q d g t) :
    Nat.card {x : TwoBlockCycleTupleData q d F g t //
      twoBlockCycleTupleToProperPair q d hd F g t hg x = T} = d ^ 2 := by
  classical
  let P := fun b : Fin 2 ↦
    (congruentIrreducibleProperPairFactor q d g t T b).rootSet F
  let (b : Fin 2) : Finite (P b) :=
    ((congruentIrreducibleProperPairFactor q d g t T b).rootSet_finite F).to_subtype
  have hP : ∀ b, Nat.card (P b) = d := by
    intro b
    let p := congruentIrreducibleProperPairFactor q d g t T b
    change Nat.card (p.rootSet F) = d
    calc
      Nat.card (p.rootSet F) = (p.rootSet F).ncard :=
        Nat.card_coe_set_eq _
      _ = Fintype.card (p.rootSet F) :=
        (Set.fintypeCard_eq_ncard (p.rootSet F)).symm
      _ = p.natDegree := Polynomial.card_rootSet_eq_natDegree
        (F := ZMod q) (K := F)
        (PerfectField.separable_of_irreducible
          (congruentIrreducibleProperPairFactor_irreducible q d g t T b))
        (IsAlgClosed.splits _)
      _ = d := congruentIrreducibleProperPairFactor_natDegree q d g t T b
  calc
    Nat.card {x : TwoBlockCycleTupleData q d F g t //
        twoBlockCycleTupleToProperPair q d hd F g t hg x = T} =
      Nat.card (∀ b, P b) := Nat.card_congr
        (twoBlockCycleTupleFiberEquivRoots q d hd F g t hg hgt T)
    _ = ∏ b, Nat.card (P b) := Nat.card_pi
    _ = ∏ _ : Fin 2, d := by
      apply Finset.prod_congr rfl
      intro b _
      exact hP b
    _ = d ^ 2 := by simp [pow_two]

noncomputable instance finiteMonicDegreeEqZMod
    (q d : ℕ) [Fact q.Prime] :
    Finite (Polynomial.MonicDegreeEq (ZMod q) d) := by
  apply Finite.of_injective
    (fun f : Polynomial.MonicDegreeEq (ZMod q) d ↦
      fun i : Fin d ↦ f.1.coeff i)
  intro f h heq
  apply Subtype.ext
  apply Polynomial.ext
  intro n
  by_cases hn : n < d
  · exact congrFun heq ⟨n, hn⟩
  by_cases hnd : n = d
  · subst n
    rw [show f.1.coeff d = 1 by
      simpa only [f.natDegree] using f.monic.coeff_natDegree,
      show h.1.coeff d = 1 by
        simpa only [h.natDegree] using h.monic.coeff_natDegree]
  · have hdn : d < n := by omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn),
      Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn)]

noncomputable instance finiteCongruentIrreducibleProperPair
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    Finite (CongruentIrreducibleProperPair q d g t) := by
  apply Finite.of_injective
    (fun T : CongruentIrreducibleProperPair q d g t ↦
      (T.repeated, T.single))
  intro x y h
  apply CongruentIrreducibleProperPair.ext
  · exact congrArg Prod.fst h
  · exact congrArg Prod.snd h

theorem twoBlockCycleTuple_card_eq_pair_card
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t) :
    Nat.card (TwoBlockCycleTupleData q d F g t) =
      d ^ 2 * Nat.card (CongruentIrreducibleProperPair q d g t) := by
  classical
  let f := twoBlockCycleTupleToProperPair q d hd F g t hg
  let : Fintype (CongruentIrreducibleProperPair q d g t) :=
    Fintype.ofFinite _
  let (T : CongruentIrreducibleProperPair q d g t) :
      Finite {x // f x = T} := by
    let P := fun b : Fin 2 ↦
      (congruentIrreducibleProperPairFactor q d g t T b).rootSet F
    let (b : Fin 2) : Finite (P b) :=
      ((congruentIrreducibleProperPairFactor q d g t T b).rootSet_finite F).to_subtype
    exact Finite.of_equiv (∀ b, P b)
      (twoBlockCycleTupleFiberEquivRoots
        q d hd F g t hg hgt T).symm
  calc
    Nat.card (TwoBlockCycleTupleData q d F g t) =
        Nat.card (Σ T, {x // f x = T}) :=
      (Nat.card_congr (Equiv.sigmaFiberEquiv f)).symm
    _ = ∑ T, Nat.card {x // f x = T} := Nat.card_sigma
    _ = ∑ _ : CongruentIrreducibleProperPair q d g t, d ^ 2 := by
      apply Finset.sum_congr rfl
      intro T _
      exact twoBlockCycleTupleToProperPair_fiber_card_eq
        q d hd F g t hg hgt T
    _ = d ^ 2 * Nat.card (CongruentIrreducibleProperPair q d g t) := by
      simp [Nat.card_eq_fintype_card, Nat.mul_comm]

theorem properPairTwistedTupleCount_finRotate_eq_cycle
    (q d : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) :
    properPairTwistedTupleCount q d F g t
        (finRotate d) (finRotate d) =
      Nat.card (TwoBlockCycleTupleData q d F g t) := by
  have htypes : (finRotate d).cycleType = ((finRotate d)⁻¹).cycleType :=
    (Equiv.Perm.cycleType_inv (finRotate d)).symm
  have hconj : IsConj (finRotate d) ((finRotate d)⁻¹) :=
    Equiv.Perm.isConj_iff_cycleType_eq.mpr htypes
  obtain ⟨h, hh⟩ := isConj_iff.mp hconj
  have hc := properPairTwistedTupleCount_conj
    q d F g t (finRotate d) (finRotate d) h h
  calc
    properPairTwistedTupleCount q d F g t
        (finRotate d) (finRotate d) =
      properPairTwistedTupleCount q d F g t
        (h * finRotate d * h⁻¹) (h * finRotate d * h⁻¹) := hc.symm
    _ = properPairTwistedTupleCount q d F g t
        (finRotate d).symm (finRotate d).symm := by
          rw [hh]
          simp only [Equiv.Perm.inv_def]
    _ = Nat.card (TwoBlockCycleTupleData q d F g t) := rfl

theorem sum_two_permutationVirtualMangoldt_mul_properPairCount_eq_pair
    (q d : ℕ) [Fact q.Prime] (hd : 2 ≤ d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) (hgt : IsCoprime g t) :
    (∑ g₀ : Equiv.Perm (Fin d),
      ∑ g₁ : Equiv.Perm (Fin d),
        permutationVirtualMangoldt ℚ (Fin d) g₀ *
          permutationVirtualMangoldt ℚ (Fin d) g₁ *
          properPairTwistedTupleCount q d F g t g₀ g₁) =
      (d.factorial : ℚ) ^ 2 *
        (d ^ 2 * Nat.card
          (CongruentIrreducibleProperPair q d g t) : ℕ) := by
  rw [sum_two_permutationVirtualMangoldt_mul_properPairCount
    q d hd F g t]
  rw [properPairTwistedTupleCount_finRotate_eq_cycle q d hd F g t]
  rw [twoBlockCycleTuple_card_eq_pair_card
    q d (by omega) F g t hg hgt]

end Erdos157.SawinGeometry
namespace Erdos157.SawinGeometry

open PolynomialInfrastructure PrimePolynomials RepresentationFamilies
  SawinSpecialization

/-- The irreducible two-block locus with normalized residue is exactly the
proper-pair fiber of the progression unit map.  The normalization by
`modByMonic` is essential: `progressionUnitRepresentative` is an arbitrary
representative of the quotient class, while the geometric locus records the
unique polynomial remainder. -/
noncomputable def congruentIrreducibleProperPairEquivFiber
    (q k r : ℕ) [Fact q.Prime]
    (u : (ProgressionQuotient q k)ˣ) :
    CongruentIrreducibleProperPair q (2 * r) (modulusProduct q k)
        (progressionUnitRepresentative q k u %ₘ modulusProduct q k) ≃
      {x : ProperPrimePair q r //
        properPrimePairProgressionUnit q k r x = u} where
  toFun T := by
    let p : OfDegree q (2 * r) :=
      ⟨T.repeated.1, T.repeated.monic, T.repeated_irreducible,
        T.repeated.natDegree⟩
    let s : OfDegree q (2 * r) :=
      ⟨T.single.1, T.single.monic, T.single_irreducible,
        T.single.natDegree⟩
    have hsp : s ≠ p := by
      intro heq
      have hpoly : T.single.1 = T.repeated.1 := by
        simpa [p, s] using congrArg Subtype.val heq
      apply T.single_irreducible.not_isUnit
      rw [← isCoprime_self]
      simpa only [hpoly] using T.coprime
    let x : ProperPrimePair q r := ⟨p, ⟨s, hsp⟩⟩
    refine ⟨x, ?_⟩
    rw [← orderedPrimeTripleProgressionUnit_pair q k r x]
    apply (orderedPrimeTripleProgressionUnit_eq_iff q k r u
      (properPrimePairOrderedTriple q r x)).2
    change modulusProduct q k ∣
      ((p : Polynomial (ZMod q)) * p * s) -
        progressionUnitRepresentative q k u
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd
      (modulusProduct_monic q k), Polynomial.sub_modByMonic]
    exact sub_eq_zero.mpr (by
      simpa [x, p, s, properPrimePairOrderedTriple, pow_two] using
        T.product_mod)
  invFun x := by
    let p : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk x.1.1
        (PrimePolynomials.monic x.1.1)
        (PrimePolynomials.natDegree x.1.1)
    let s : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk x.1.2.1
        (PrimePolynomials.monic x.1.2.1)
        (PrimePolynomials.natDegree x.1.2.1)
    have hdivOrdered : modulusProduct q k ∣
        (properPrimePairOrderedTriple q r x.1).product -
          progressionUnitRepresentative q k u := by
      apply (orderedPrimeTripleProgressionUnit_eq_iff q k r u _).1
      rw [orderedPrimeTripleProgressionUnit_pair]
      exact x.2
    change modulusProduct q k ∣
      ((x.1.1 : Polynomial (ZMod q)) * x.1.1 * x.1.2.1) -
        progressionUnitRepresentative q k u at hdivOrdered
    refine ⟨p, s, ?_, ?_, ?_, ?_⟩
    · simpa [p, s, properPrimePairOrderedTriple, pow_two] using
        (Polynomial.modByMonic_eq_of_dvd_sub
          (modulusProduct_monic q k) hdivOrdered)
    · exact coprime_of_distinct_monic_irreducible x.1.1 x.1.2.1
        x.1.2.2.symm
    · exact PrimePolynomials.irreducible x.1.1
    · exact PrimePolynomials.irreducible x.1.2.1
  left_inv T := by
    apply CongruentIrreducibleProperPair.ext <;>
      apply Subtype.ext <;> rfl
  right_inv x := by
    apply Subtype.ext
    rcases x with ⟨⟨p, ⟨s, hsp⟩⟩, hu⟩
    rfl

/-- Cardinal form of the exact two-block progression identification. -/
theorem congruentIrreducibleProperPair_natCard_eq_fiber
    (q k r : ℕ) [Fact q.Prime]
    (u : (ProgressionQuotient q k)ˣ) :
    Nat.card (CongruentIrreducibleProperPair q (2 * r)
        (modulusProduct q k)
        (progressionUnitRepresentative q k u %ₘ modulusProduct q k)) =
      Nat.card {x : ProperPrimePair q r //
        properPrimePairProgressionUnit q k r x = u} :=
  Nat.card_congr (congruentIrreducibleProperPairEquivFiber q k r u)

/-- Reducing a unit representative modulo the monic progression modulus
preserves its coprimality with that modulus. -/
theorem modulusProduct_isCoprime_normalizedUnitRepresentative
    (q k : ℕ) [Fact q.Prime]
    (u : (ProgressionQuotient q k)ˣ) :
    IsCoprime (modulusProduct q k)
      (progressionUnitRepresentative q k u %ₘ modulusProduct q k) := by
  apply (isCoprime_modByMonic_right_iff (K := ZMod q)
    (modulusProduct q k) (progressionUnitRepresentative q k u)
    (modulusProduct_monic q k)).2
  exact ((isUnit_modulusQuotient_mk_iff_isCoprime q k
    (progressionUnitRepresentative q k u)).1 (by
      rw [progressionUnitRepresentative_mk]
      exact u.isUnit)).symm

/-- The two-block character-weighted fixed-point average is the exact
`d²`-weighted cardinality of the proper-pair progression fiber. -/
theorem sum_two_permutationVirtualMangoldt_mul_properPairCount_eq_fiber
    (q k r : ℕ) [Fact q.Prime] (hr : 1 ≤ r)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (u : (ProgressionQuotient q k)ˣ) :
    (∑ g₀ : Equiv.Perm (Fin (2 * r)),
      ∑ g₁ : Equiv.Perm (Fin (2 * r)),
        permutationVirtualMangoldt ℚ (Fin (2 * r)) g₀ *
          permutationVirtualMangoldt ℚ (Fin (2 * r)) g₁ *
          properPairTwistedTupleCount q (2 * r) F
            (modulusProduct q k)
            (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
            g₀ g₁) =
      ((2 * r).factorial : ℚ) ^ 2 *
        ((2 * r) ^ 2 * Nat.card {x : ProperPrimePair q r //
          properPrimePairProgressionUnit q k r x = u} : ℕ) := by
  rw [sum_two_permutationVirtualMangoldt_mul_properPairCount_eq_pair
    q (2 * r) (by omega) F
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)]
  rw [congruentIrreducibleProperPair_natCard_eq_fiber q k r u]

end Erdos157.SawinGeometry
namespace Erdos157.SawinGeometry

open AlgebraicGeometry AlgebraicGeometry.Scheme
open PolynomialInfrastructure PrimePolynomials RepresentationFamilies
  SawinSpecialization

noncomputable def residueUnitPointOfPolynomial
    (q m : ℕ) [Fact q.Prime]
    (g a : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ha : a.natDegree < m)
    (hga : IsCoprime g a) : ResidueUnitPoint (ZMod q) m g := by
  let x := residuePoint (ZMod q) m a
  let ev : Γ(AffineRootSpace (ZMod q) m, ⊤) →+* ZMod q :=
    (Scheme.ΓSpecIso (.of (ZMod q))).hom.hom.comp x.appTop.hom
  have hevCoeff : ev.comp (rootCoefficientMap (ZMod q) m) = RingHom.id _ := by
    apply RingHom.ext
    intro c
    unfold ev x residuePoint rootCoefficientMap
    change (Scheme.ΓSpecIso (.of (ZMod q))).hom
        ((AffineSpace.homOfVector (𝟙 (Spec (.of (ZMod q))))
          (fun j : RootIndex m ↦
            (Scheme.ΓSpecIso (.of (ZMod q))).inv (a.coeff j.down))).appTop
          ((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop
            ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = c
    have hover : x ≫ (AffineRootSpace (ZMod q) m ↘
        Spec (.of (ZMod q))) = 𝟙 _ := by
      dsimp only [x, residuePoint]
      exact AffineSpace.homOfVector_over _ _
    have happ := congrArg Scheme.Hom.appTop hover
    rw [Scheme.Hom.comp_appTop] at happ
    change (Scheme.ΓSpecIso (.of (ZMod q))).hom
        ((((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop ≫
          x.appTop) ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = c
    rw [happ]
    simp
  have hevg : (g.map (rootCoefficientMap (ZMod q) m)).map ev = g := by
    rw [Polynomial.map_map, hevCoeff]
    simp
  have hevCoord (j : Fin m) :
      ev (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)) =
        a.coeff j := by
    unfold ev x residuePoint
    change (Scheme.ΓSpecIso (.of (ZMod q))).hom
      ((AffineSpace.homOfVector (𝟙 (Spec (.of (ZMod q))))
        (fun i : RootIndex m ↦
          (Scheme.ΓSpecIso (.of (ZMod q))).inv (a.coeff i.down))).appTop
        (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j))) = _
    rw [AffineSpace.homOfVector_appTop_coord]
    simp
  have hevResidue :
      (universalResiduePolynomial (ZMod q) m).map ev = a := by
    unfold universalResiduePolynomial
    rw [Polynomial.map_sum]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
      Polynomial.map_X]
    simp_rw [hevCoord]
    change (∑ j : Fin m,
      Polynomial.C (a.coeff j) * Polynomial.X ^ j.1) = a
    rw [Fin.sum_univ_eq_sum_range
      (fun i : ℕ ↦ Polynomial.C (a.coeff i) * Polynomial.X ^ i) m]
    exact (a.as_sum_range_C_mul_X_pow' ha).symm
  have hsectionImage :
      (Scheme.ΓSpecIso (.of (ZMod q))).hom
          (x.appTop (residueUnitSection (ZMod q) m g)) =
        g.resultant a m m := by
    change ev (residueUnitSection (ZMod q) m g) = _
    unfold residueUnitSection
    rw [← Polynomial.resultant_map_map, hevg, hevResidue]
  have hres : g.resultant a ≠ 0 := by
    exact (isUnit_iff_ne_zero.mp
      ((Polynomial.isUnit_resultant_iff_isCoprime hg).2 hga))
  have hpad : g.resultant a m m = g.resultant a := by
    have hle : a.natDegree ≤ m := ha.le
    have hp := Polynomial.resultant_add_right_deg
      (f := g) (g := a) (m := m) (n := a.natDegree)
      (k := m - a.natDegree) le_rfl
    have hmadd : a.natDegree + (m - a.natDegree) = m :=
      Nat.add_sub_of_le hle
    rw [hmadd] at hp
    have hgcoeff : g.coeff m = 1 := by
      rw [← hdeg]
      exact hg.coeff_natDegree
    rw [hgcoeff, one_pow, one_mul] at hp
    change g.resultant a m m = g.resultant a g.natDegree a.natDegree
    rw [hdeg]
    exact hp
  have hsectionImageNe :
      (Scheme.ΓSpecIso (.of (ZMod q))).hom
          (x.appTop (residueUnitSection (ZMod q) m g)) ≠ 0 := by
    rw [hsectionImage, hpad]
    exact hres
  have hsectionUnit : IsUnit
      (x.appTop (residueUnitSection (ZMod q) m g)) := by
    have hu : IsUnit ((Scheme.ΓSpecIso (.of (ZMod q))).hom
        (x.appTop (residueUnitSection (ZMod q) m g))) :=
      isUnit_iff_ne_zero.mpr hsectionImageNe
    have humap := hu.map (Scheme.ΓSpecIso (.of (ZMod q))).inv.hom
    simpa using humap
  apply IsOpenImmersion.lift (ResidueUnitOpen (ZMod q) m g).ι x
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  rw [Scheme.Opens.range_ι]
  apply x.mem_preimage.mp
  unfold ResidueUnitOpen
  rw [Scheme.preimage_basicOpen_top]
  rw [Scheme.basicOpen_of_isUnit _ hsectionUnit]
  trivial

@[reassoc (attr := simp)]
theorem residueUnitPointOfPolynomial_immersion
    (q m : ℕ) [Fact q.Prime]
    (g a : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ha : a.natDegree < m)
    (hga : IsCoprime g a) :
    residueUnitPointOfPolynomial q m g a hg hdeg ha hga ≫
      residueUnitImmersion (ZMod q) m g =
      residuePoint (ZMod q) m a := by
  change residueUnitPointOfPolynomial q m g a hg hdeg ha hga ≫
      (ResidueUnitOpen (ZMod q) m g).ι = residuePoint (ZMod q) m a
  simpa only [residueUnitPointOfPolynomial] using
    (IsOpenImmersion.lift_fac
      (f := (ResidueUnitOpen (ZMod q) m g).ι)
      (g := residuePoint (ZMod q) m a) _)

theorem residueUnitPointPolynomial_ofPolynomial
    (q m : ℕ) [Fact q.Prime]
    (g a : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ha : a.natDegree < m)
    (hga : IsCoprime g a) :
    residueUnitPointPolynomial q m g
        (residueUnitPointOfPolynomial q m g a hg hdeg ha hga) = a := by
  apply Polynomial.ext
  intro n
  by_cases hn : n < m
  · let j : Fin m := ⟨n, hn⟩
    have hc := residueUnitPointPolynomial_coeff q m g
      (residueUnitPointOfPolynomial q m g a hg hdeg ha hga) j
    change (residueUnitPointPolynomial q m g
      (residueUnitPointOfPolynomial q m g a hg hdeg ha hga)).coeff n =
        a.coeff n
    rw [hc]
    rw [residueUnitPointOfPolynomial_immersion]
    simp [residuePoint, j]
  · have hmn : m ≤ n := Nat.le_of_not_gt hn
    rw [residueUnitPointPolynomial_coeff_eq_zero_of_le q m g _ n hmn]
    exact (Polynomial.coeff_eq_zero_of_natDegree_lt (ha.trans_le hmn)).symm
/-- The canonical scheme point of the unit-valued residue space represented
by a progression unit's degree-bounded remainder. -/
noncomputable def progressionResidueUnitPoint
    (q k : ℕ) [Fact q.Prime] (hk : 1 ≤ k)
    (u : (ProgressionQuotient q k)ˣ) :
    ResidueUnitPoint (ZMod q) (k ^ 2) (modulusProduct q k) :=
  residueUnitPointOfPolynomial q (k ^ 2) (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k) (modulusProduct_natDegree q k)
    (normalizedResidue_natDegree_lt q k hk
      (progressionUnitRepresentative q k u))
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)

theorem progressionResidueUnitPoint_polynomial
    (q k : ℕ) [Fact q.Prime] (hk : 1 ≤ k)
    (u : (ProgressionQuotient q k)ˣ) :
    residueUnitPointPolynomial q (k ^ 2) (modulusProduct q k)
        (progressionResidueUnitPoint q k hk u) =
      progressionUnitRepresentative q k u %ₘ modulusProduct q k := by
  exact residueUnitPointPolynomial_ofPolynomial q (k ^ 2)
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k) (modulusProduct_natDegree q k)
    (normalizedResidue_natDegree_lt q k hk
      (progressionUnitRepresentative q k u))
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)

/-- The three-block character-weighted fixed-point average over the
canonical residue-unit scheme point is exactly the `d³`-weighted cardinality
of the distinct ordered progression fiber. -/
theorem
    sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount_eq_progression
    (q k r : ℕ) [Fact q.Prime] (hk : 1 ≤ k) (hr : 1 ≤ r)
    (hkm : k ^ 2 ≤ 3 * (2 * r))
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (u : (ProgressionQuotient q k)ˣ) :
    (∑ g₀ : Equiv.Perm (Fin (2 * r)),
      ∑ g₁ : Equiv.Perm (Fin (2 * r)),
        ∑ g₂ : Equiv.Perm (Fin (2 * r)),
          permutationVirtualMangoldt ℚ (Fin (2 * r)) g₀ *
            permutationVirtualMangoldt ℚ (Fin (2 * r)) g₁ *
            permutationVirtualMangoldt ℚ (Fin (2 * r)) g₂ *
            fullResidueUnitFiberDistinctFixedPointCount
              q (3 * (2 * r)) (k ^ 2) F
              (modulusProduct q k) (modulusProduct_monic q k)
              (modulusProduct_natDegree q k) (by positivity) hkm
              (progressionResidueUnitPoint q k hk u)
              (threeBlockPermutationTriple (2 * r) g₀ g₁ g₂)) =
      ((2 * r).factorial : ℚ) ^ 3 *
        ((2 * r) ^ 3 * Nat.card
          (CongruentDistinctOrderedPrimeTriple q k r
            (progressionUnitRepresentative q k u)) : ℕ) := by
  rw [sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount_eq_triple
    q (2 * r) (k ^ 2) (by omega) F
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u)]
  rw [progressionResidueUnitPoint_polynomial q k hk u]
  rw [← congruentDistinctOrderedPrimeTriple_natCard_eq_irreducible q k r
    (progressionUnitRepresentative q k u)]

/-- At the canonical progression point, the twisted compact-support trace
formula identifies the three-cycle trace with the literal distinct-prime
progression mass. -/
theorem threeBlockDistinctCanonicalTwistedAlternatingTrace_eq_progression
    (q k r ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (u : (ProgressionQuotient q k)ˣ)
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * (2 * r)) (k ^ 2) ℓ degree
          (modulusProduct q k) (modulusProduct_monic q k)
          (modulusProduct_natDegree q k) (by positivity) hkm
          (progressionResidueUnitPoint q k hk u))]
    (hGL : HasDistinctCanonicalTwistedGrothendieckLefschetz
      q (3 * (2 * r)) (k ^ 2) ℓ topDegree F
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u)
      (threeBlockCyclePermutation (2 * r))) :
    fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
        q (3 * (2 * r)) (k ^ 2) ℓ topDegree
        (modulusProduct q k) (modulusProduct_monic q k)
        (modulusProduct_natDegree q k) (by positivity) hkm
        (progressionResidueUnitPoint q k hk u)
        (threeBlockCyclePermutation (2 * r)) =
      (((2 * r) ^ 3 * Nat.card
        (CongruentDistinctOrderedPrimeTriple q k r
          (progressionUnitRepresentative q k u)) : ℕ) : ℚ_[ℓ]) := by
  have hk2 : 0 < k ^ 2 := by positivity
  rw [threeBlockDistinctCanonicalTwistedAlternatingTrace_eq_triple_card
    q (2 * r) (k ^ 2) ℓ topDegree (by omega) F
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) hk2 hkm
    (progressionResidueUnitPoint q k hk u) hGL]
  rw [progressionResidueUnitPoint_polynomial q k hk u]
  rw [← congruentDistinctOrderedPrimeTriple_natCard_eq_irreducible q k r
    (progressionUnitRepresentative q k u)]

open CategoryTheory.Limits

noncomputable def universalTwoBlockPolynomial
    (K : Type*) [Field K] (d : ℕ) (b : Fin 2) :
    Polynomial Γ(AffineRootSpace K (2 * d), ⊤) :=
  ∏ j : Fin d,
    (Polynomial.X - Polynomial.C
      (AffineSpace.coord (Spec (.of K))
        (ULift.up (finProdFinEquiv (b, j)))))

noncomputable def universalProperPairPolynomial
    (K : Type*) [Field K] (d : ℕ) :
    Polynomial Γ(AffineRootSpace K (2 * d), ⊤) :=
  (universalTwoBlockPolynomial K d 0) ^ 2 *
    universalTwoBlockPolynomial K d 1

theorem universalTwoBlockPolynomial_monic
    (K : Type*) [Field K] (d : ℕ) (b : Fin 2) :
    (universalTwoBlockPolynomial K d b).Monic := by
  unfold universalTwoBlockPolynomial
  apply Polynomial.monic_prod_of_monic
  intro j _
  exact Polynomial.monic_X_sub_C _

theorem universalTwoBlockPolynomial_natDegree
    (K : Type*) [Field K] (d : ℕ) (b : Fin 2) :
    (universalTwoBlockPolynomial K d b).natDegree = d := by
  unfold universalTwoBlockPolynomial
  have h := Polynomial.natDegree_prod_of_monic
    (s := Finset.univ)
    (f := fun j : Fin d ↦
      Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K))
          (ULift.up (finProdFinEquiv (b, j)))))
    (by intro j _; exact Polynomial.monic_X_sub_C _)
  simpa using h

theorem universalProperPairPolynomial_monic
    (K : Type*) [Field K] (d : ℕ) :
    (universalProperPairPolynomial K d).Monic := by
  exact ((universalTwoBlockPolynomial_monic K d 0).pow 2).mul
    (universalTwoBlockPolynomial_monic K d 1)

theorem universalProperPairPolynomial_natDegree
    (K : Type*) [Field K] (d : ℕ) :
    (universalProperPairPolynomial K d).natDegree = 3 * d := by
  have h0 := universalTwoBlockPolynomial_monic K d 0
  have h1 := universalTwoBlockPolynomial_monic K d 1
  rw [universalProperPairPolynomial,
    Polynomial.natDegree_mul (h0.pow 2).ne_zero h1.ne_zero,
    Polynomial.natDegree_pow,
    universalTwoBlockPolynomial_natDegree,
    universalTwoBlockPolynomial_natDegree]
  omega

noncomputable def universalProperPairRemainder
    (K : Type*) [Field K] (d : ℕ) (g : Polynomial K) (hg : g.Monic) :
    Polynomial Γ(AffineRootSpace K (2 * d), ⊤) :=
  universalProperPairPolynomial K d %ₘ
    g.map (rootCoefficientMap K (2 * d))

noncomputable def affineProperPairResidueMultiplication
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic) :
    AffineRootSpace K (2 * d) ⟶ AffineRootSpace K m :=
  AffineSpace.homOfVector (AffineRootSpace K (2 * d) ↘ Spec (.of K))
    (fun j ↦ (universalProperPairRemainder K d g hg).coeff j.down)

@[simp]
theorem affineProperPairResidueMultiplication_appTop_coord
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic) (j : Fin m) :
    (affineProperPairResidueMultiplication K d m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (universalProperPairRemainder K d g hg).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

@[reassoc (attr := simp)]
theorem affineProperPairResidueMultiplication_over
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic) :
    affineProperPairResidueMultiplication K d m g hg ≫
        (AffineRootSpace K m ↘ Spec (.of K)) =
      (AffineRootSpace K (2 * d) ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

/-- Restriction of the repeated-pair residue map to roots avoiding the
modulus. -/
noncomputable def properPairResidueMultiplication
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic) :
    RootSpace K (2 * d) g ⟶ AffineRootSpace K m :=
  (RootSpaceOpen K (2 * d) g).ι ≫
    affineProperPairResidueMultiplication K d m g hg

/-- Scheme fiber representing two coprime squarefree degree-`d` factors
`P,S` with `P²S` in a prescribed residue class.  Pairwise distinctness is
imposed by the open subscheme below. -/
noncomputable def ProperPairResidueFiber
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) : Scheme :=
  pullback (properPairResidueMultiplication K d m g hg)
    (residuePoint K m t)

noncomputable def properPairResidueFiberToRootSpace
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    ProperPairResidueFiber K d m g t hg ⟶ RootSpace K (2 * d) g :=
  pullback.fst _ _

noncomputable def properPairResidueFiberProjection
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    ProperPairResidueFiber K d m g t hg ⟶ Spec (.of K) :=
  pullback.snd _ _

theorem properPairResidueFiber_condition
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    properPairResidueFiberToRootSpace K d m g t hg ≫
        properPairResidueMultiplication K d m g hg =
      properPairResidueFiberProjection K d m g t hg ≫
        residuePoint K m t := by
  exact pullback.condition

instance properPairResidueFiber_isAffine
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    IsAffine (ProperPairResidueFiber K d m g t hg) := by
  let : IsAffine (AffineRootSpace K (2 * d)) := inferInstance
  let : IsAffine (RootSpace K (2 * d) g) := by
    change IsAffine ((AffineRootSpace K (2 * d)).basicOpen _)
    infer_instance
  let : IsAffine (AffineRootSpace K m) := inferInstance
  let : IsAffine (Spec (.of K)) := inferInstance
  unfold ProperPairResidueFiber
  infer_instance

noncomputable def ProperPairResidueFiberDistinctOpen
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    (ProperPairResidueFiber K d m g t hg).Opens :=
  (ProperPairResidueFiber K d m g t hg).basicOpen
    ((properPairResidueFiberToRootSpace K d m g t hg ≫
      (RootSpaceOpen K (2 * d) g).ι).appTop
        (rootVandermondeSection K (2 * d)))

noncomputable abbrev ProperPairResidueFiberDistinct
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) : Scheme :=
  (ProperPairResidueFiberDistinctOpen K d m g t hg).toScheme

noncomputable def properPairResidueFiberDistinctι
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    ProperPairResidueFiberDistinct K d m g t hg ⟶
      ProperPairResidueFiber K d m g t hg :=
  (ProperPairResidueFiberDistinctOpen K d m g t hg).ι

instance properPairResidueFiberDistinct_isAffine
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    IsAffine (ProperPairResidueFiberDistinct K d m g t hg) := by
  change IsAffine ((ProperPairResidueFiber K d m g t hg).basicOpen _)
  infer_instance
theorem rootTupleAffinePoint_universalTwoBlockPolynomial
    (q d : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin (2 * d) → F) (b : Fin 2) :
    (universalTwoBlockPolynomial (ZMod q) d b).map
        (affineRootPointEvaluationHom q (2 * d) F
          (rootTupleAffinePoint q (2 * d) F y)) =
      twoBlockTuplePolynomial d F y b := by
  unfold universalTwoBlockPolynomial twoBlockTuplePolynomial
  rw [Polynomial.map_prod]
  apply Finset.prod_congr rfl
  intro j _hj
  simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  congr 2
  change (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q (2 * d) F y).appTop
        (AffineSpace.coord (Spec (.of (ZMod q)))
          (ULift.up (finProdFinEquiv (b, j))))) =
    y (finProdFinEquiv (b, j))
  exact congrFun (rootTupleAffinePoint_coordinates q (2 * d) F y)
    (finProdFinEquiv (b, j))

theorem rootTupleAffinePoint_universalProperPairPolynomial
    (q d : ℕ) [Fact q.Prime]
