/-- All non-analytic hypotheses of Sawin's Theorem 1.7 for the canonical
Pilatte progression.  This record deliberately contains no estimate: it
packages only the squarefree modulus, exact degrees, short-interval range,
and invertible residue class which a formal proof of the theorem consumes. -/
structure CanonicalTheorem17Data (k : ℕ)
    (a : Polynomial (ZMod q)) : Prop where
  modulusMonic : (modulusProduct q k).Monic
  modulusSquarefree : Squarefree (modulusProduct q k)
  modulusDegree : (modulusProduct q k).natDegree = k ^ 2
  totalDegreeAtLeastModulus :
    k ^ 2 ≤ 6 * Construction.canonicalDegreeIndex k
  thetaRange :
    k ^ 2 ≤ 20 * (6 * Construction.canonicalDegreeIndex k - k ^ 2)
  residueClassIsUnit :
    IsUnit (AdjoinRoot.mk (modulusProduct q k) a)

/-- The canonical large-level data meet every algebraic and numerical
hypothesis of Theorem 1.7 before its characteristic-cycle estimate is used. -/
theorem canonicalTheorem17Data (k : ℕ) (hk : 1000 ≤ k)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    CanonicalTheorem17Data q k a := by
  have hrange := Construction.modulus_degree_in_sawin_range
    (by omega : 3 ≤ k)
  refine
    { modulusMonic := modulusProduct_monic q k
      modulusSquarefree := modulusProduct_squarefree q k
      modulusDegree := modulusProduct_natDegree q k
      totalDegreeAtLeastModulus := by omega
      thetaRange := Construction.sawin_degree_excess
        (by omega : 3 ≤ k)
      residueClassIsUnit :=
        FiniteFieldEncoding.isUnit_modulusQuotient_mk_iff q k a |>.mpr ha }

/-- Canonical-remainder normalization does not change the literal
arithmetic-progression statement. -/
theorem hasSawinLemma914OriginalProgression_iff_progression :
    HasSawinLemma914OriginalProgressionFactorizationDeviation q ↔
      HasSawinLemma914ProgressionFactorizationDeviation q := by
  constructor <;> intro h k hk a ha
