  change IsAffine ((FullResidueUnitFiberBlockwiseDistinctOpen
    K d m g hg hdeg hm hmn t).toScheme)
  unfold FullResidueUnitFiberBlockwiseDistinctOpen
  infer_instance

theorem fullResidueUnitFiberThreeBlockPermutation_appTop_blockwiseSection
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    (fullResidueUnitFiberPermutation
        K (3 * d) m g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)).appTop
      (((fullResidueUnitFiberToRootSpace
          K (3 * d) m g hg hdeg hm hmn t) ≫
        (RootSpaceOpen K (3 * d) g).ι).appTop
          (threeBlockVandermondeSection K d)) =
      (((fullResidueUnitFiberToRootSpace
          K (3 * d) m g hg hdeg hm hmn t) ≫
        (RootSpaceOpen K (3 * d) g).ι).appTop
          (threeBlockCycleSignScalar K d)) ^ 3 *
        ((fullResidueUnitFiberToRootSpace
          K (3 * d) m g hg hdeg hm hmn t) ≫
        (RootSpaceOpen K (3 * d) g).ι).appTop
          (threeBlockVandermondeSection K d) := by
  let f := fullResidueUnitFiberPermutation
    K (3 * d) m g hg hdeg hm hmn t (threeBlockCyclePermutation d)
  let a := (fullResidueUnitFiberToRootSpace
      K (3 * d) m g hg hdeg hm hmn t) ≫
    (RootSpaceOpen K (3 * d) g).ι
  calc
    f.appTop (a.appTop (threeBlockVandermondeSection K d)) =
        (f ≫ a).appTop (threeBlockVandermondeSection K d) := by rfl
    _ = (a ≫ affineRootPermutation K (3 * d)
        (threeBlockCyclePermutation d)).appTop
          (threeBlockVandermondeSection K d) := by
      rw [show f ≫ a = a ≫ affineRootPermutation K (3 * d)
          (threeBlockCyclePermutation d) by
        dsimp only [f, a]
        simp only [Category.assoc]
        rw [fullResidueUnitFiberPermutation_toRootSpace_assoc,
          rootPermutation_ι]]
    _ = a.appTop ((affineRootPermutation K (3 * d)
        (threeBlockCyclePermutation d)).appTop
          (threeBlockVandermondeSection K d)) := by rfl
    _ = a.appTop ((threeBlockCycleSignScalar K d) ^ 3 *
        threeBlockVandermondeSection K d) := by
      rw [affineRootPermutation_appTop_threeBlockVandermondeSection]
    _ = _ := by rw [map_mul, map_pow]

theorem fullResidueUnitFiberThreeBlockPermutation_preimage_blockwiseOpen
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    (fullResidueUnitFiberPermutation
        K (3 * d) m g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) ⁻¹ᵁ
      FullResidueUnitFiberBlockwiseDistinctOpen
        K d m g hg hdeg hm hmn t =
      FullResidueUnitFiberBlockwiseDistinctOpen
        K d m g hg hdeg hm hmn t := by
  unfold FullResidueUnitFiberBlockwiseDistinctOpen
  rw [Scheme.preimage_basicOpen_top,
    fullResidueUnitFiberThreeBlockPermutation_appTop_blockwiseSection,
    Scheme.basicOpen_mul]
  have hsign : IsUnit (threeBlockCycleSignScalar K d) := by
    unfold threeBlockCycleSignScalar
    exact (Equiv.Perm.sign (finRotate d).symm).isUnit.map (Int.castRingHom _)
  have hmapped := hsign.map
    ((fullResidueUnitFiberToRootSpace
      K (3 * d) m g hg hdeg hm hmn t) ≫
      (RootSpaceOpen K (3 * d) g).ι).appTop.hom
  let c := ((fullResidueUnitFiberToRootSpace
      K (3 * d) m g hg hdeg hm hmn t) ≫
    (RootSpaceOpen K (3 * d) g).ι).appTop
      (threeBlockCycleSignScalar K d)
  have hc : IsUnit c := hmapped
  have hunit : IsUnit (c ^ 3) := hc.pow _
  dsimp only [c] at hunit
  rw [Scheme.basicOpen_of_isUnit _ hunit, top_inf_eq]

noncomputable def fullResidueUnitFiberBlockwiseDistinctPermutation
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    FullResidueUnitFiberBlockwiseDistinct K d m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberBlockwiseDistinct K d m g hg hdeg hm hmn t :=
  ((Scheme.isoOfEq
      (FullResidueUnitFiber K (3 * d) m g hg hdeg hm hmn t)
      (fullResidueUnitFiberThreeBlockPermutation_preimage_blockwiseOpen
        K d m g hg hdeg hm hmn t).symm).hom) ≫
    fullResidueUnitFiberPermutation
      K (3 * d) m g hg hdeg hm hmn t
      (threeBlockCyclePermutation d) ∣_
        FullResidueUnitFiberBlockwiseDistinctOpen
          K d m g hg hdeg hm hmn t

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberBlockwiseDistinctPermutation_ι
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    (fullResidueUnitFiberBlockwiseDistinctPermutation
        K d m g hg hdeg hm hmn t) ≫
      fullResidueUnitFiberBlockwiseDistinctι
        K d m g hg hdeg hm hmn t =
    (fullResidueUnitFiberBlockwiseDistinctι
        K d m g hg hdeg hm hmn t) ≫
      fullResidueUnitFiberPermutation
        K (3 * d) m g hg hdeg hm hmn t
        (threeBlockCyclePermutation d) := by
  unfold fullResidueUnitFiberBlockwiseDistinctPermutation
    fullResidueUnitFiberBlockwiseDistinctι
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
    Scheme.isoOfEq_hom_ι]

theorem fullResidueUnitFiberBlockwiseDistinctPoint_coordinates_injective
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (z : Spec (.of F) ⟶ FullResidueUnitFiberBlockwiseDistinct
      (ZMod q) d m g hg hdeg hm hmn t) :
    ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
      fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
        hdeg hm hmn t
        (z ≫ fullResidueUnitFiberBlockwiseDistinctι
          (ZMod q) d m g hg hdeg hm hmn t)
        (finProdFinEquiv (b, j))) := by
  let x := z ≫ fullResidueUnitFiberBlockwiseDistinctι
    (ZMod q) d m g hg hdeg hm hmn t
  let a := x ≫ fullResidueUnitFiberToRootSpace
      (ZMod q) (3 * d) m g hg hdeg hm hmn t ≫
    (RootSpaceOpen (ZMod q) (3 * d) g).ι
  have hopen : x ⁻¹ᵁ FullResidueUnitFiberBlockwiseDistinctOpen
      (ZMod q) d m g hg hdeg hm hmn t = ⊤ := by
    dsimp only [x, fullResidueUnitFiberBlockwiseDistinctι]
    rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self,
      Scheme.Hom.preimage_top]
  have hsection : x.appTop
      (((fullResidueUnitFiberToRootSpace
          (ZMod q) (3 * d) m g hg hdeg hm hmn t) ≫
        (RootSpaceOpen (ZMod q) (3 * d) g).ι).appTop
          (threeBlockVandermondeSection (ZMod q) d)) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of F)).basicOpen
        (x.appTop
          (((fullResidueUnitFiberToRootSpace
              (ZMod q) (3 * d) m g hg hdeg hm hmn t) ≫
            (RootSpaceOpen (ZMod q) (3 * d) g).ι).appTop
              (threeBlockVandermondeSection (ZMod q) d))) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    exact bot_ne_top hbasic
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (threeBlockVandermondeSection (ZMod q) d)) ≠ 0 := by
    intro hzero
    change a.appTop (threeBlockVandermondeSection (ZMod q) d) ≠ 0 at hsection
    apply hsection
    have hinv := congrArg (fun y => (Scheme.ΓSpecIso (.of F)).inv y) hzero
    simpa using hinv
  exact (affineRootPoint_threeBlockVandermondeSection_ne_zero_iff
    q d F a).mp himage

noncomputable def fullResidueUnitFiberPointToBlockwiseDistinct
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t)
    (hx : ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
      fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
        hdeg hm hmn t x (finProdFinEquiv (b, j)))) :
    Spec (.of F) ⟶ FullResidueUnitFiberBlockwiseDistinct
      (ZMod q) d m g hg hdeg hm hmn t := by
  apply IsOpenImmersion.lift
    (fullResidueUnitFiberBlockwiseDistinctι
      (ZMod q) d m g hg hdeg hm hmn t) x
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  unfold fullResidueUnitFiberBlockwiseDistinctι
  rw [Scheme.Opens.range_ι]
  apply x.mem_preimage.mp
  unfold FullResidueUnitFiberBlockwiseDistinctOpen
  rw [Scheme.preimage_basicOpen_top]
  let a := x ≫ fullResidueUnitFiberToRootSpace
      (ZMod q) (3 * d) m g hg hdeg hm hmn t ≫
    (RootSpaceOpen (ZMod q) (3 * d) g).ι
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (threeBlockVandermondeSection (ZMod q) d)) ≠ 0 :=
    (affineRootPoint_threeBlockVandermondeSection_ne_zero_iff
      q d F a).mpr hx
  have hu : IsUnit ((Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (threeBlockVandermondeSection (ZMod q) d))) :=
    isUnit_iff_ne_zero.mpr himage
  have humap := hu.map (Scheme.ΓSpecIso (.of F)).inv.hom
  have hu' : IsUnit
      (a.appTop (threeBlockVandermondeSection (ZMod q) d)) := by
    simpa using humap
  change w ∈ (Spec (.of F)).basicOpen
    (a.appTop (threeBlockVandermondeSection (ZMod q) d))
  rw [Scheme.basicOpen_of_isUnit _ hu']
  trivial

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberPointToBlockwiseDistinct_ι
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t)
    (hx : ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
      fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
        hdeg hm hmn t x (finProdFinEquiv (b, j)))) :
    fullResidueUnitFiberPointToBlockwiseDistinct
        q d m F g hg hdeg hm hmn t x hx ≫
      fullResidueUnitFiberBlockwiseDistinctι
        (ZMod q) d m g hg hdeg hm hmn t = x := by
  unfold fullResidueUnitFiberPointToBlockwiseDistinct
  exact IsOpenImmersion.lift_fac _ _ _

noncomputable def
    fullResidueUnitFiberBlockwiseDistinctPointEquivBlockwisePoint
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (Spec (.of F) ⟶ FullResidueUnitFiberBlockwiseDistinct
      (ZMod q) d m g hg hdeg hm hmn t) ≃
      {x : Spec (.of F) ⟶ FullResidueUnitFiber
          (ZMod q) (3 * d) m g hg hdeg hm hmn t //
        ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
          fullResidueUnitFiberRootCoordinates q (3 * d) m F g hg
            hdeg hm hmn t x (finProdFinEquiv (b, j)))} where
  toFun z := ⟨z ≫ fullResidueUnitFiberBlockwiseDistinctι
      (ZMod q) d m g hg hdeg hm hmn t,
    fullResidueUnitFiberBlockwiseDistinctPoint_coordinates_injective
      q d m F g hg hdeg hm hmn t z⟩
  invFun x := fullResidueUnitFiberPointToBlockwiseDistinct
    q d m F g hg hdeg hm hmn t x.1 x.2
  left_inv z := by
    apply (cancel_mono (fullResidueUnitFiberBlockwiseDistinctι
      (ZMod q) d m g hg hdeg hm hmn t)).1
    rw [fullResidueUnitFiberPointToBlockwiseDistinct_ι]
  right_inv x := by
    apply Subtype.ext
    exact fullResidueUnitFiberPointToBlockwiseDistinct_ι
      q d m F g hg hdeg hm hmn t x.1 x.2

