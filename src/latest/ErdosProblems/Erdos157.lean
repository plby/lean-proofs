  change
      ‖data.all u - (∑ v, data.all v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.proper12 u - (∑ v, data.proper12 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.proper13 u - (∑ v, data.proper13 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.proper23 u - (∑ v, data.proper23 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤ _ at hfour
  change
      ‖data.diagonal u - (∑ v, data.diagonal v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤ _ at hdiagonal
  calc
    ‖data.all u - (∑ v, data.all v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.proper12 u - (∑ v, data.proper12 v) /
