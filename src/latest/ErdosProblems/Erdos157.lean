/-- The canonical unsieved geometric certificate, specialized to a
progression unit, has exactly the `all` mass used by the partition family. -/
noncomputable def progressionBlockwiseDistinctCanonicalTwoDegreeMatrices
    (q k r ℓ topDegree lowerDegree upperDegree : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ)
    (hpos : 0 < k ^ 2)
    (sigma : ℚ_[ℓ] →+* ℂ) (radius : ℝ)
    (data : FullBlockwiseDistinctCanonicalTwoDegreeGeometricData
      q (2 * r) (k ^ 2) ℓ topDegree lowerDegree upperDegree
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) hpos hkm
      (progressionResidueUnitPoint q k hk u)
      sigma radius) :
    letI := data.finite lowerDegree
    letI := data.finite upperDegree
    TwoDegreeFrobeniusMatrices
      (unitAllOrderedPrimeTripleWeight q k r u)
      (Module.finrank ℚ_[ℓ]
        (ProgressionBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q k r ℓ lowerDegree hk hkm u))
      (Module.finrank ℚ_[ℓ]
        (ProgressionBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q k r ℓ upperDegree hk hkm u)) radius radius := by
  letI := data.finite lowerDegree
  letI := data.finite upperDegree
  let matrices := data.toMatrices
  change TwoDegreeFrobeniusMatrices _ _ _ _ _ at matrices ⊢
  convert matrices using 1
  unfold unitAllOrderedPrimeTripleWeight
  push_cast
  rw [fullResidueUnitFiberBlockwiseDistinctFixedPoint_card_eq_allOrdered
    q k r hk hr hkm u]
  rw [Nat.card_eq_fintype_card]
  norm_cast

noncomputable abbrev
    ProgressionProperPairDistinctCanonicalQEllAdicCompactSupportCohomology
    (q k r ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (u : (ProgressionQuotient q k)ˣ) :=
  ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
    q (2 * r) (k ^ 2) ℓ degree
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)

/-- The representative proper-pair certificate is repeated `2r` times to
recover the third von-Mangoldt factor.  The trace becomes the exact
`proper12` mass and the two radii remain unchanged. -/
noncomputable def progressionProperPairCanonicalTwoDegreeMatrices
    (q k r ℓ topDegree lowerDegree upperDegree : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r)
    (u : (ProgressionQuotient q k)ˣ)
    (sigma : ℚ_[ℓ] →+* ℂ) (radius : ℝ)
    (data : ProperPairDistinctCanonicalTwoDegreeGeometricData
      q (2 * r) (k ^ 2) ℓ topDegree lowerDegree upperDegree
      (modulusProduct q k)
      (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
      (modulusProduct_monic q k)
      ![finRotate (2 * r), finRotate (2 * r)] sigma radius) :
    letI := data.finite lowerDegree
    letI := data.finite upperDegree
    TwoDegreeFrobeniusMatrices
      (unitOrderedPrimeTripleProper12Weight q k r u)
      (Module.finrank ℚ_[ℓ]
        (ProgressionProperPairDistinctCanonicalQEllAdicCompactSupportCohomology
          q k r ℓ lowerDegree u) * (2 * r))
      (Module.finrank ℚ_[ℓ]
        (ProgressionProperPairDistinctCanonicalQEllAdicCompactSupportCohomology
          q k r ℓ upperDegree u) * (2 * r)) radius radius := by
  letI := data.finite lowerDegree
  letI := data.finite upperDegree
  let matrices := data.toMatrices
  let copies := matrices.natCopies (2 * r)
  change TwoDegreeFrobeniusMatrices _ _ _ _ _ at copies ⊢
  convert copies using 1
  unfold unitOrderedPrimeTripleProper12Weight
  rw [properPairResidueFiberDistinctGeometricCycleFixedPoint_card_eq_progression
    q k r hk hr u]
  rw [Nat.card_eq_fintype_card, card_properPrimePair_fiber q k r u]
  push_cast
  ring

/-! The normalized compact-support pullback gives the literal symmetric-group
representation on the distinct ordered-root fiber. -/

noncomputable def
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :
    FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ell degree g hg hdeg hm hmn t →ₗ[ℚ_[ell]]
      FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ell degree g hg hdeg hm hmn t :=
  AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized
    q (fullResidueUnitFiberDistinctProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureOpen_over
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctPermutation
      (ZMod q) n m g hg hdeg hm hmn t π)
    (schemeToSpecZMod_hom_ext q _ _)
    (fullResidueUnitFiberDistinctProjectiveClosurePermutation
      q n m g hg hdeg hm hmn t π)
    (schemeToSpecZMod_hom_ext q _ _)
    (fullResidueUnitFiberDistinctPermutation_projectiveClosureOpen
      q n m g hg hdeg hm hmn t π) ell degree

theorem
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ τ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t (σ * τ) =
      (fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t σ).comp
      (fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t τ) := by
  let pX := fullResidueUnitFiberDistinctProjection
    q n m g hg hdeg hm hmn t
  let j := fullResidueUnitFiberDistinctProjectiveClosureOpen
    q n m g hg hdeg hm hmn t
  let pbar := fullResidueUnitFiberDistinctProjectiveClosureProjection
    q n m g hg hdeg hm hmn t
  let hj := fullResidueUnitFiberDistinctProjectiveClosureOpen_over
    q n m g hg hdeg hm hmn t
  let fσ := fullResidueUnitFiberDistinctPermutation
    (ZMod q) n m g hg hdeg hm hmn t σ
  let fτ := fullResidueUnitFiberDistinctPermutation
    (ZMod q) n m g hg hdeg hm hmn t τ
  let fστ := fullResidueUnitFiberDistinctPermutation
    (ZMod q) n m g hg hdeg hm hmn t (σ * τ)
  let fbσ := fullResidueUnitFiberDistinctProjectiveClosurePermutation
    q n m g hg hdeg hm hmn t σ
  let fbτ := fullResidueUnitFiberDistinctProjectiveClosurePermutation
    q n m g hg hdeg hm hmn t τ
  let fbστ := fullResidueUnitFiberDistinctProjectiveClosurePermutation
    q n m g hg hdeg hm hmn t (σ * τ)
  change
    AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj fστ _ fbστ _ _ ell degree = _
  rw [AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized_congr
    q pX j pbar hj fστ (fσ ≫ fτ) _ _ fbστ (fbσ ≫ fbτ) _ _ _ _
      (by exact (fullResidueUnitFiberDistinctPermutation_comp
        (ZMod q) n m g hg hdeg hm hmn t σ τ).symm)
      (by exact (fullResidueUnitFiberDistinctProjectiveClosurePermutation_comp
        q n m g hg hdeg hm hmn t σ τ).symm)]
  exact AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized_comp
    q pX j pbar hj fσ fτ _ _ fbσ fbτ _ _ _ _ ell degree

theorem
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_one
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t 1 = LinearMap.id := by
  let A :=
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
      q n m ell degree g hg hdeg hm hmn t 1
  have hcomp : A = A.comp A := by
    simpa only [one_mul] using
      fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
        q n m ell degree g hg hdeg hm hmn t 1 1
  have hsurj : Function.Surjective A := by
    unfold A
    unfold fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    exact AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_surjective
      _ _ _ _ _ ell degree
  ext x
  obtain ⟨y, rfl⟩ := hsurj x
  change A (A y) = A y
  exact congrArg (fun F : _ →ₗ[ℚ_[ell]] _ => F y) hcomp.symm

noncomputable def
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportRepresentation
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Representation ℚ_[ell] (Equiv.Perm (Fin n))
      (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ell degree g hg hdeg hm hmn t) where
  toFun := fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    q n m ell degree g hg hdeg hm hmn t
  map_one' :=
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_one
      q n m ell degree g hg hdeg hm hmn t
  map_mul' σ τ :=
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
      q n m ell degree g hg hdeg hm hmn t σ τ

noncomputable def geometricCompactSupportFrobeniusLinearMapUnitNormalized
    {X Xbar : AlgebraicGeometry.Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ AlgebraicGeometry.Spec (.of (ZMod q)))
    (j : X ⟶ Xbar)
    (pbar : Xbar ⟶ AlgebraicGeometry.Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [AlgebraicGeometry.IsOpenImmersion j]
    [AlgebraicGeometry.IsProper pbar]
    (ell degree : ℕ) [Fact ell.Prime] :
    AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ell degree →ₗ[ℚ_[ell]]
      AlgebraicGeometry.Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ell degree :=
  AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
      q pX j pbar hj)
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection q pbar)
    (AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap
      q pX (geometricBaseFrobenius q) (geometricBaseFrobenius_over q))
    (AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap
      q pbar (geometricBaseFrobenius q) (geometricBaseFrobenius_over q))
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen_base_equivariant
      q pX j pbar hj (geometricBaseFrobenius q)
      (geometricBaseFrobenius_over q)) ell degree

/-- Geometric compact-support cohomology of the explicit large Young
quotient, using its finite-type projective closure. -/
noncomputable abbrev
    LargeYoungSymmetricResidueFiberCanonicalQEllAdicCompactSupportCohomology
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :=
  Scheme.ProEt.GeometricCompactlySupportedQEllAdicCohomology
    q (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureOpen
      q m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureProjection
      q m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
      q m g hg hdeg hm B i₀ hlarge t ht) ell degree

/-- The normalized geometric Frobenius on large Young quotient
compact-support cohomology. -/
noncomputable def
    largeYoungSymmetricResidueFiberCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LargeYoungSymmetricResidueFiberCanonicalQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t ht →ₗ[ℚ_[ell]]
      LargeYoungSymmetricResidueFiberCanonicalQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t ht :=
  geometricCompactSupportFrobeniusLinearMapUnitNormalized q
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureOpen
      q m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureProjection
      q m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
      q m g hg hdeg hm B i₀ hlarge t ht) ell degree

/-! A common compactification for the target-independent large Young quotient. -/

noncomputable abbrev
    LargeYoungSymmetricResidueFiberSharedQEllAdicCompactSupportCohomology
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t₀ : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht₀ : t₀ ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :=
  let p := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t ht
  let p₀ := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let j₀ := largeYoungSymmetricResidueFiberProjectiveClosureOpen
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let pbar₀ := largeYoungSymmetricResidueFiberProjectiveClosureProjection
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let e := largeYoungSymmetricResidueFiberGeometricIso
    q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
    (e.hom ≫ AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
      q p₀ j₀ pbar₀
        (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
          q m g hg hdeg hm B i₀ hlarge t₀ ht₀))
    (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection
      q pbar₀) ell degree

noncomputable def
    largeYoungSymmetricResidueFiberSharedCohomologyLinearEquiv
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t₀ : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht₀ : t₀ ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LargeYoungSymmetricResidueFiberSharedQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀ ≃ₗ[ℚ_[ell]]
      LargeYoungSymmetricResidueFiberCanonicalQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t₀ ht₀ := by
  let p₀ := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let j₀ := largeYoungSymmetricResidueFiberProjectiveClosureOpen
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let pbar₀ := largeYoungSymmetricResidueFiberProjectiveClosureProjection
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let e := largeYoungSymmetricResidueFiberGeometricIso
    q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  exact
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
      e
      (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
        q p₀ j₀ pbar₀
          (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
            q m g hg hdeg hm B i₀ hlarge t₀ ht₀))
      (AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection
        q pbar₀) ell degree

theorem largeYoungSymmetricResidueFiberGeometricIso_baseFrobenius
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t₀ : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht₀ : t₀ ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) ≫
      (largeYoungSymmetricResidueFiberGeometricIso
        q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀).hom =
    (largeYoungSymmetricResidueFiberGeometricIso
        q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀).hom ≫
      AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) := by
  exact AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap_naturality
    q
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀)
    (largeYoungSymmetricResidueFiberTargetIso
      (ZMod q) m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀).hom
    (largeYoungSymmetricResidueFiberTargetIso_over_zmod
      q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀)
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)

noncomputable def
    largeYoungSymmetricResidueFiberSharedFrobeniusCompactSupportLinearMapUnitNormalized
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t₀ : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht₀ : t₀ ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LargeYoungSymmetricResidueFiberSharedQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀ →ₗ[ℚ_[ell]]
      LargeYoungSymmetricResidueFiberSharedQEllAdicCompactSupportCohomology
        q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀ := by
  let p := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t ht
  let p₀ := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let j₀ := largeYoungSymmetricResidueFiberProjectiveClosureOpen
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let pbar₀ := largeYoungSymmetricResidueFiberProjectiveClosureProjection
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let e := largeYoungSymmetricResidueFiberGeometricIso
    q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  let jGeo₀ := AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
    q p₀ j₀ pbar₀
      (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
        q m g hg hdeg hm B i₀ hlarge t₀ ht₀)
  let pbarGeo₀ :=
    AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection q pbar₀
  let f := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q p
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  let f₀ := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q p₀
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  let fbar₀ := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q pbar₀
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  have hcomm : f ≫ e.hom = e.hom ≫ f₀ :=
    largeYoungSymmetricResidueFiberGeometricIso_baseFrobenius
      q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  have h₀ : f₀ ≫ jGeo₀ = jGeo₀ ≫ fbar₀ :=
    AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen_base_equivariant
      q p₀ j₀ pbar₀
      (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
        q m g hg hdeg hm B i₀ hlarge t₀ ht₀)
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  have h : f ≫ (e.hom ≫ jGeo₀) = (e.hom ≫ jGeo₀) ≫ fbar₀ := by
    calc
      f ≫ (e.hom ≫ jGeo₀) = (f ≫ e.hom) ≫ jGeo₀ :=
        (Category.assoc _ _ _).symm
      _ = (e.hom ≫ f₀) ≫ jGeo₀ :=
        congrArg (fun z => z ≫ jGeo₀) hcomm
      _ = e.hom ≫ (f₀ ≫ jGeo₀) := Category.assoc _ _ _
      _ = e.hom ≫ (jGeo₀ ≫ fbar₀) :=
        congrArg (fun z => e.hom ≫ z) h₀
      _ = (e.hom ≫ jGeo₀) ≫ fbar₀ :=
        (Category.assoc _ _ _).symm
  exact AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
    (e.hom ≫ jGeo₀) pbarGeo₀ f fbar₀ h ell degree

theorem
    largeYoungSymmetricResidueFiberSharedCohomologyLinearEquiv_map_frobenius
    (q m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t₀ : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht₀ : t₀ ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (x : LargeYoungSymmetricResidueFiberSharedQEllAdicCompactSupportCohomology
      q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀) :
    largeYoungSymmetricResidueFiberSharedCohomologyLinearEquiv
        q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
        (largeYoungSymmetricResidueFiberSharedFrobeniusCompactSupportLinearMapUnitNormalized
          q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀ x) =
      largeYoungSymmetricResidueFiberCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
        q m ell degree g hg hdeg hm B i₀ hlarge t₀ ht₀
        (largeYoungSymmetricResidueFiberSharedCohomologyLinearEquiv
          q m ell degree g hg hdeg hm B i₀ hlarge t t₀ ht ht₀ x) := by
  let p := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t ht
  let p₀ := largeYoungSymmetricResidueFiberProjection
    (ZMod q) m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let j₀ := largeYoungSymmetricResidueFiberProjectiveClosureOpen
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let pbar₀ := largeYoungSymmetricResidueFiberProjectiveClosureProjection
    q m g hg hdeg hm B i₀ hlarge t₀ ht₀
  let e := largeYoungSymmetricResidueFiberGeometricIso
    q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  let jGeo₀ := AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen
    q p₀ j₀ pbar₀
      (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
        q m g hg hdeg hm B i₀ hlarge t₀ ht₀)
  let pbarGeo₀ :=
    AlgebraicGeometry.Scheme.ProEt.geometricCompactificationProjection q pbar₀
  let f := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q p
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  let f₀ := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q p₀
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  let fbar₀ := AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap q pbar₀
    (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  have hcomm : f ≫ e.hom = e.hom ≫ f₀ :=
    largeYoungSymmetricResidueFiberGeometricIso_baseFrobenius
      q m g hg hdeg hm B i₀ hlarge t t₀ ht ht₀
  have h₀ : f₀ ≫ jGeo₀ = jGeo₀ ≫ fbar₀ :=
    AlgebraicGeometry.Scheme.ProEt.geometricCompactificationOpen_base_equivariant
      q p₀ j₀ pbar₀
      (largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
        q m g hg hdeg hm B i₀ hlarge t₀ ht₀)
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  have h : f ≫ (e.hom ≫ jGeo₀) = (e.hom ≫ jGeo₀) ≫ fbar₀ := by
    calc
      f ≫ (e.hom ≫ jGeo₀) = (f ≫ e.hom) ≫ jGeo₀ :=
        (Category.assoc _ _ _).symm
      _ = (e.hom ≫ f₀) ≫ jGeo₀ :=
        congrArg (fun z => z ≫ jGeo₀) hcomm
      _ = e.hom ≫ (f₀ ≫ jGeo₀) := Category.assoc _ _ _
      _ = e.hom ≫ (jGeo₀ ≫ fbar₀) :=
        congrArg (fun z => e.hom ≫ z) h₀
      _ = (e.hom ≫ jGeo₀) ≫ fbar₀ :=
        (Category.assoc _ _ _).symm
  change
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
        e jGeo₀ pbarGeo₀ ell degree
        (AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
          (e.hom ≫ jGeo₀) pbarGeo₀ f fbar₀ h ell degree x) =
      AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        jGeo₀ pbarGeo₀ f₀ fbar₀ h₀ ell degree
        (AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
          e jGeo₀ pbarGeo₀ ell degree x)
  exact
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized_map_action
      e jGeo₀ pbarGeo₀ f f₀ fbar₀ h h₀ hcomm ell degree x

noncomputable def
    fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ell degree g hg hdeg hm hmn t →ₗ[ℚ_[ell]]
      FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ell degree g hg hdeg hm hmn t :=
  geometricCompactSupportFrobeniusLinearMapUnitNormalized q
    (fullResidueUnitFiberDistinctProjection q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureOpen_over
      q n m g hg hdeg hm hmn t) ell degree

theorem
    fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized_comm
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :
    (fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t).comp
      (fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t π) =
    (fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t π).comp
      (fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
        q n m ell degree g hg hdeg hm hmn t) := by
  unfold fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized
    geometricCompactSupportFrobeniusLinearMapUnitNormalized
    fullResidueUnitFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized
  apply AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comm_of_comm
  · exact AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap_naturality
      q _ _ (fullResidueUnitFiberDistinctPermutation
        (ZMod q) n m g hg hdeg hm hmn t π)
        (schemeToSpecZMod_hom_ext q _ _)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)
  · exact AlgebraicGeometry.Scheme.ProEt.geometricFiberBaseMap_naturality
      q _ _ (fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t π)
        (schemeToSpecZMod_hom_ext q _ _)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q)

