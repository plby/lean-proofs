  have hwhole :
      C ≫ ((H ≫ E) ≫ (S ≫ f)) = D ≫ (R ≫ f) :=
    (congrArg (fun k => C ≫ k) htail).trans
      ((Category.assoc C (H ≫ F) (R ≫ f)).symm.trans
