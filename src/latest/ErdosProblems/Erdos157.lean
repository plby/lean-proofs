  exact Finite.of_equiv _
    (properPairResidueFiberDistinctFixedPointEquivTupleData
      q d m F g t hg hdeg ht π₀ π₁).symm

noncomputable def properPairResidueFiberDistinctTwistedFixedPointTraceMatrix
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
