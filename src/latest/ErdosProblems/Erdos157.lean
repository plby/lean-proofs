set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem mapCochainComplexSingleFunctor_comp_app
    (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F]
    (G : D ⥤ E) [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G] (X : C) :
    ((F ⋙ G).mapCochainComplexSingleFunctor 0).app X =
      (G.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso
          ((F.mapCochainComplexSingleFunctor 0).app X) ≪≫
        (G.mapCochainComplexSingleFunctor 0).app (F.obj X) := by
  dsimp [Functor.mapCochainComplexSingleFunctor]
  apply Iso.ext
  apply HomologicalComplex.hom_ext
  intro i
  change
    ((HomologicalComplex.singleMapHomologicalComplex
      (F ⋙ G) (ComplexShape.up ℤ) 0).hom.app X).f i =
      G.map (((HomologicalComplex.singleMapHomologicalComplex
        F (ComplexShape.up ℤ) 0).hom.app X).f i) ≫
        ((HomologicalComplex.singleMapHomologicalComplex
          G (ComplexShape.up ℤ) 0).hom.app (F.obj X)).f i
  by_cases hi : i = 0
  · subst i
    rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_self
      (F ⋙ G) (ComplexShape.up ℤ) 0 X]
    rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_self
      F (ComplexShape.up ℤ) 0 X]
    rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_self
      G (ComplexShape.up ℤ) 0 (F.obj X)]
    simp
  · rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_ne
      (F ⋙ G) (ComplexShape.up ℤ) hi X]
    rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_ne
      F (ComplexShape.up ℤ) hi X]
    rw [HomologicalComplex.singleMapHomologicalComplex_hom_app_ne
      G (ComplexShape.up ℤ) hi (F.obj X)]
    simp

theorem mapHomologicalComplex_comp_commShiftIso
    (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F]
    (G : D ⥤ E) [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G] (n : ℤ) :
    let H := (F ⋙ G).mapHomologicalComplex (ComplexShape.up ℤ)
    let hdirect : H.CommShift ℤ :=
      Functor.commShiftMapCochainComplex (F := F ⋙ G)
    let hcomp : (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        G.mapHomologicalComplex (ComplexShape.up ℤ)).CommShift ℤ := inferInstance
    (letI : H.CommShift ℤ := hdirect
     H.commShiftIso n) =
      (letI : (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
          G.mapHomologicalComplex (ComplexShape.up ℤ)).CommShift ℤ := hcomp
       (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
          G.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n) := by
  dsimp only
  let H := (F ⋙ G).mapHomologicalComplex (ComplexShape.up ℤ)
  let hdirect : H.CommShift ℤ :=
    Functor.commShiftMapCochainComplex (F := F ⋙ G)
  let directIso := @Functor.commShiftIso _ _ _ _ H ℤ _ _ _ hdirect n
  let hcomp : (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
      G.mapHomologicalComplex (ComplexShape.up ℤ)).CommShift ℤ := inferInstance
  let compIso := @Functor.commShiftIso _ _ _ _
    (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
      G.mapHomologicalComplex (ComplexShape.up ℤ)) ℤ _ _ _ hcomp n
  change directIso = compIso
  ext K i
  change (directIso.hom.app K).f i = (compIso.hom.app K).f i
  have hleft : (directIso.hom.app K).f i = 𝟙 _ := by
    simpa only [directIso, H, hdirect] using
      (Functor.mapHomologicalComplex_commShiftIso_hom_app_f
        (F ⋙ G) K n i)
  rw [hleft]
  dsimp only [compIso]
  rw [Functor.commShiftIso_comp_hom_app]
  change 𝟙 _ =
    G.map (((((F.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app K).f i)) ≫
      ((((G.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso n).hom.app
        ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)).f i)
  rw [Functor.mapHomologicalComplex_commShiftIso_hom_app_f,
    Functor.mapHomologicalComplex_commShiftIso_hom_app_f]
  erw [G.map_id]
  erw [Category.id_comp]
  rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem mapExactFunctor_comp_functor
    (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F]
    (G : D ⥤ E) [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    [HasDerivedCategory.{t''} E]
    [HasExt.{w} C] [HasExt.{w'} D] [HasExt.{w''} E]
    {X Y : C} {n : ℕ} (e : Ext.{w} X Y n) :
    e.mapExactFunctor (F ⋙ G) =
      (e.mapExactFunctor F).mapExactFunctor G := by
  unfold mapExactFunctor
  let Φ := F.mapHomologicalComplexUpToQuasiIsoLocalizerMorphism
    (ComplexShape.up ℤ)
  let Ψ := G.mapHomologicalComplexUpToQuasiIsoLocalizerMorphism
    (ComplexShape.up ℤ)
  let eFX := (F.mapCochainComplexSingleFunctor 0).app X
  let eFY := (F.mapCochainComplexSingleFunctor 0).app Y
  let eGX := (G.mapCochainComplexSingleFunctor 0).app (F.obj X)
  let eGY := (G.mapCochainComplexSingleFunctor 0).app (F.obj Y)
  let hcompShift : (Φ.functor ⋙ Ψ.functor).CommShift ℤ := inferInstance
  let hcompShift' : (Φ.comp Ψ).functor.CommShift ℤ := by
    change (Φ.functor ⋙ Ψ.functor).CommShift ℤ
    exact hcompShift
  let eYm : Φ.functor.obj
        ((shiftFunctor (CochainComplex C ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor C 0).obj Y)) ≅
      (shiftFunctor (CochainComplex D ℤ) (n : ℤ)).obj
        ((CochainComplex.singleFunctor D 0).obj (F.obj Y)) :=
    (Φ.functor.commShiftIso (n : ℤ)).app
        ((CochainComplex.singleFunctor C 0).obj Y) ≪≫
      (shiftFunctor (CochainComplex D ℤ) (n : ℤ)).mapIso eFY
  let eYm' : Ψ.functor.obj
        ((shiftFunctor (CochainComplex D ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor D 0).obj (F.obj Y))) ≅
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).obj
        ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))) :=
    (Ψ.functor.commShiftIso (n : ℤ)).app
        ((CochainComplex.singleFunctor D 0).obj (F.obj Y)) ≪≫
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).mapIso eGY
  let eYcanon : (Φ.comp Ψ).functor.obj
        ((shiftFunctor (CochainComplex C ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor C 0).obj Y)) ≅
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).obj
        ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))) :=
    letI : (Φ.functor ⋙ Ψ.functor).CommShift ℤ := hcompShift
    ((Φ.functor ⋙ Ψ.functor).commShiftIso (n : ℤ)).app
        ((CochainComplex.singleFunctor C 0).obj Y) ≪≫
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).mapIso
        (Ψ.functor.mapIso eFY ≪≫ eGY)
  let eYdirect :
      ((F ⋙ G).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((shiftFunctor (CochainComplex C ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor C 0).obj Y)) ≅
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).obj
        ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))) :=
    (((F ⋙ G).mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso
        (n : ℤ)).app ((CochainComplex.singleFunctor C 0).obj Y) ≪≫
      (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).mapIso
        (Ψ.functor.mapIso eFY ≪≫ eGY)
  have hdirectCanon : eYdirect = eYcanon := by
    unfold eYdirect eYcanon
    rw [mapHomologicalComplex_comp_commShiftIso F G (n : ℤ)]
    rfl
  have hY : eYcanon = Ψ.functor.mapIso eYm ≪≫ eYm' := by
    apply Iso.ext
    dsimp only [eYcanon, eYm, eYm', Iso.trans_hom,
      Functor.mapIso_hom, Functor.map_comp]
    simp only [Iso.app_hom]
    rw [Functor.commShiftIso_comp_hom_app]
    simp only [Category.assoc]
    rw [Ψ.functor.map_comp]
    rw [(shiftFunctor (CochainComplex E ℤ) (n : ℤ)).map_comp]
    erw [← Ψ.functor.commShiftIso_hom_naturality_assoc eFY.hom (n : ℤ)]
    simp only [Category.assoc]
    dsimp only [Φ, Ψ]
    simp only [Functor.mapHomologicalComplexUpToQuasiIsoLocalizerMorphism_functor,
      Functor.comp_obj]
  let X₂ := (F ⋙ CochainComplex.singleFunctor D 0).obj X
  let Y₂ := (shiftFunctor (CochainComplex D ℤ) (n : ℤ)).obj
    ((CochainComplex.singleFunctor D 0).obj (F.obj Y))
  let X₃ := (G ⋙ CochainComplex.singleFunctor E 0).obj (F.obj X)
  let Y₃ := (shiftFunctor (CochainComplex E ℤ) (n : ℤ)).obj
    ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y)))
  let h₂XX : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) X₂ X₂ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) ℤ X₂ X₂
  let h₂XX' : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ))
      ((CochainComplex.singleFunctor D 0).obj (F.obj X))
      ((CochainComplex.singleFunctor D 0).obj (F.obj X)) := by
    change HasSmallLocalizedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) X₂ X₂
    exact h₂XX
  let h₂XY : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) X₂ Y₂ :=
    let hraw := (show HasSmallLocalizedShiftedHom
        (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) ℤ
        ((CochainComplex.singleFunctor D 0).obj (F.obj X))
        ((CochainComplex.singleFunctor D 0).obj (F.obj Y)) from
          inferInstance) 0 (n : ℤ)
    letI hraw' : HasSmallLocalizedHom
        (HomologicalComplex.quasiIso D (ComplexShape.up ℤ))
        ((shiftFunctor (CochainComplex D ℤ) (0 : ℤ)).obj X₂) Y₂ := by
      change HasSmallLocalizedHom
        (HomologicalComplex.quasiIso D (ComplexShape.up ℤ))
        ((shiftFunctor (CochainComplex D ℤ) (0 : ℤ)).obj
          ((CochainComplex.singleFunctor D 0).obj (F.obj X)))
        ((shiftFunctor (CochainComplex D ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor D 0).obj (F.obj Y)))
      exact hraw
    hasSmallLocalizedHom_of_isos
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ))
      ((shiftFunctorZero (CochainComplex D ℤ) ℤ).app X₂) (Iso.refl Y₂)
  let h₂YY : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) Y₂ Y₂ :=
    (show HasSmallLocalizedShiftedHom
      (HomologicalComplex.quasiIso D (ComplexShape.up ℤ)) ℤ
      ((CochainComplex.singleFunctor D 0).obj (F.obj Y))
      ((CochainComplex.singleFunctor D 0).obj (F.obj Y)) from
        inferInstance) (n : ℤ) (n : ℤ)
  let h₃XX : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) X₃ X₃ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) ℤ X₃ X₃
  let h₃XY : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) X₃ Y₃ :=
    let hraw := (show HasSmallLocalizedShiftedHom
        (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) ℤ
        ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj X)))
        ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))) from
          inferInstance) 0 (n : ℤ)
    letI hraw' : HasSmallLocalizedHom
        (HomologicalComplex.quasiIso E (ComplexShape.up ℤ))
        ((shiftFunctor (CochainComplex E ℤ) (0 : ℤ)).obj X₃) Y₃ := by
      change HasSmallLocalizedHom
        (HomologicalComplex.quasiIso E (ComplexShape.up ℤ))
        ((shiftFunctor (CochainComplex E ℤ) (0 : ℤ)).obj
          ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj X))))
        ((shiftFunctor (CochainComplex E ℤ) (n : ℤ)).obj
          ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))))
      exact hraw
    hasSmallLocalizedHom_of_isos
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ))
      ((shiftFunctorZero (CochainComplex E ℤ) ℤ).app X₃) (Iso.refl Y₃)
  let h₃YY : HasSmallLocalizedHom
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) Y₃ Y₃ :=
    (show HasSmallLocalizedShiftedHom
      (HomologicalComplex.quasiIso E (ComplexShape.up ℤ)) ℤ
      ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y)))
      ((CochainComplex.singleFunctor E 0).obj (G.obj (F.obj Y))) from
        inferInstance) (n : ℤ) (n : ℤ)
  rw [mapCochainComplexSingleFunctor_comp_app F G X,
    mapCochainComplexSingleFunctor_comp_app F G Y]
  unfold LocalizerMorphism.smallShiftedHomMap
  change (Φ.comp Ψ).smallHomMap'
      (Ψ.functor.mapIso eFX ≪≫ eGX) eYdirect e =
    Ψ.smallHomMap' eGX eYm'
      (Φ.smallHomMap' eFX eYm e)
  rw [hdirectCanon]
  rw [hY]
  exact Φ.smallHomMap'_comp_localizer Ψ eFX eYm eGX eYm' e

/-- The natural isomorphism on derived categories induced by an isomorphism
of exact functors. -/
noncomputable def mapDerivedCategoryNatIso
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    (e : F ≅ G) : F.mapDerivedCategory ≅ G.mapDerivedCategory := by
  let c : ComplexShape ℤ := ComplexShape.up ℤ
  let Qc := DerivedCategory.Q (C := C)
  let Qd := DerivedCategory.Q (C := D)
  let Fc := F.mapHomologicalComplex c
  let Gc := G.mapHomologicalComplex c
  let ecomp : Fc ⋙ Qd ≅ Gc ⋙ Qd :=
    CategoryTheory.Functor.isoWhiskerRight
      (NatIso.mapHomologicalComplex e c) Qd
  exact Localization.liftNatIso Qc
    (HomologicalComplex.quasiIso C c)
    (Fc ⋙ Qd) (Gc ⋙ Qd)
    F.mapDerivedCategory G.mapDerivedCategory ecomp

instance mapHomologicalComplexNatTrans_commShift
    (F G : C ⥤ D) [F.Additive] [G.Additive]
    (e : F ≅ G) :
    NatTrans.CommShift
      (NatTrans.mapHomologicalComplex e.hom (ComplexShape.up ℤ)) ℤ := by
  constructor
  intro n
  ext K i
  simp only [NatTrans.comp_app, Functor.whiskerRight_app,
    Functor.whiskerLeft_app,
    Functor.commShiftIso_comp_hom_app,
    HomologicalComplex.comp_f,
    Functor.mapHomologicalComplex_commShiftIso_hom_app_f,
    Functor.map_id, NatTrans.mapHomologicalComplex_app_f,
    CochainComplex.shiftFunctor_map_f',
    CochainComplex.shiftFunctor_obj_X', Functor.comp_obj,
    Category.id_comp, Category.comp_id]
  change 𝟙 (F.obj (K.X (i + n))) ≫ e.hom.app (K.X (i + n)) =
    e.hom.app (K.X (i + n)) ≫ 𝟙 (G.obj (K.X (i + n)))
  simp

instance mapDerivedCategoryNatIso_commShift
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    (e : F ≅ G) :
    NatTrans.CommShift (mapDerivedCategoryNatIso F G e).hom ℤ := by
  let : NatTrans.CommShift
      (NatIso.mapHomologicalComplex e (ComplexShape.up ℤ)).hom ℤ := by
    change NatTrans.CommShift
      (NatTrans.mapHomologicalComplex e.hom (ComplexShape.up ℤ)) ℤ
    infer_instance
  let : NatTrans.CommShift
      (CategoryTheory.Functor.isoWhiskerRight
        (NatIso.mapHomologicalComplex e (ComplexShape.up ℤ))
        (DerivedCategory.Q (C := D))).hom ℤ := by
    change NatTrans.CommShift
      (Functor.whiskerRight
        (NatIso.mapHomologicalComplex e (ComplexShape.up ℤ)).hom
        (DerivedCategory.Q (C := D))) ℤ
    infer_instance
  let : NatTrans.CommShift
      (Localization.Lifting.iso (DerivedCategory.Q (C := C))
        (HomologicalComplex.quasiIso C (ComplexShape.up ℤ))
        (F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
          DerivedCategory.Q (C := D)) F.mapDerivedCategory).hom ℤ := by
    change NatTrans.CommShift F.mapDerivedCategoryFactors.hom ℤ
    infer_instance
  let : NatTrans.CommShift
      (Localization.Lifting.iso (DerivedCategory.Q (C := C))
        (HomologicalComplex.quasiIso C (ComplexShape.up ℤ))
        (G.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
          DerivedCategory.Q (C := D)) G.mapDerivedCategory).hom ℤ := by
    change NatTrans.CommShift G.mapDerivedCategoryFactors.hom ℤ
    infer_instance
  unfold mapDerivedCategoryNatIso
  apply Localization.liftNatTrans_commShift

theorem mapDerivedCategoryNatIso_hom_app
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    (e : F ≅ G) (K : CochainComplex C ℤ) :
    (mapDerivedCategoryNatIso F G e).hom.app (DerivedCategory.Q.obj K) =
      F.mapDerivedCategoryFactors.hom.app K ≫
        DerivedCategory.Q.map
          ((NatIso.mapHomologicalComplex e
            (ComplexShape.up ℤ)).hom.app K) ≫
        G.mapDerivedCategoryFactors.inv.app K := by
  simp only [mapDerivedCategoryNatIso, Localization.liftNatIso_hom,
    Localization.liftNatTrans_app, Functor.isoWhiskerRight_hom,
    Functor.whiskerRight_app]
  change F.mapDerivedCategoryFactors.hom.app K ≫
      DerivedCategory.Q.map
        ((NatIso.mapHomologicalComplex e
          (ComplexShape.up ℤ)).hom.app K) ≫
      G.mapDerivedCategoryFactors.inv.app K = _
  rfl

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem mapDerivedCategoryNatIso_single_hom
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    (e : F ≅ G) (X : C) :
    (DerivedCategory.singleFunctor D 0).map (e.hom.app X) ≫
        (G.mapDerivedCategorySingleFunctor 0).inv.app X =
      (F.mapDerivedCategorySingleFunctor 0).inv.app X ≫
        (mapDerivedCategoryNatIso F G e).hom.app
          ((DerivedCategory.singleFunctor C 0).obj X) := by
  change (DerivedCategory.singleFunctor D 0).map (e.hom.app X) ≫
        (G.mapDerivedCategorySingleFunctor 0).inv.app X =
      (F.mapDerivedCategorySingleFunctor 0).inv.app X ≫
        (mapDerivedCategoryNatIso F G e).hom.app
          (DerivedCategory.Q.obj
            ((CochainComplex.singleFunctor C 0).obj X))
  rw [mapDerivedCategoryNatIso_hom_app]
  apply (cancel_mono (G.mapDerivedCategoryFactors.hom.app
    ((CochainComplex.singleFunctor C 0).obj X))).mp
  erw [Category.assoc]
  erw [Functor.mapDerivedCategorySingleFunctor_inv_app_mapDerivedCategoryFactors_hom_app]
  change DerivedCategory.Q.map
        ((CochainComplex.singleFunctor D 0).map (e.hom.app X)) ≫
      DerivedCategory.Q.map
        ((G.mapCochainComplexSingleFunctor 0).inv.app X) = _
  let hrest :=
    DerivedCategory.Q.map
        ((NatIso.mapHomologicalComplex e
          (ComplexShape.up ℤ)).hom.app
            ((CochainComplex.singleFunctor C 0).obj X)) ≫
      G.mapDerivedCategoryFactors.inv.app
          ((CochainComplex.singleFunctor C 0).obj X) ≫
        G.mapDerivedCategoryFactors.hom.app
          ((CochainComplex.singleFunctor C 0).obj X)
  have hF :=
    Functor.mapDerivedCategorySingleFunctor_inv_app_mapDerivedCategoryFactors_hom_app_assoc
      F X hrest
  change
    (F.mapDerivedCategorySingleFunctor 0).inv.app X ≫
        F.mapDerivedCategoryFactors.hom.app
          ((CochainComplex.singleFunctor C 0).obj X) ≫ hrest =
      DerivedCategory.Q.map
          ((F.mapCochainComplexSingleFunctor 0).inv.app X) ≫ hrest at hF
  have hcomplex :
      (CochainComplex.singleFunctor D 0).map (e.hom.app X) ≫
          (G.mapCochainComplexSingleFunctor 0).inv.app X =
        (F.mapCochainComplexSingleFunctor 0).inv.app X ≫
          (NatIso.mapHomologicalComplex e
            (ComplexShape.up ℤ)).hom.app
              ((CochainComplex.singleFunctor C 0).obj X) := by
    apply HomologicalComplex.hom_ext
    intro i
    by_cases hi : i = 0
    · subst i
      simp only [Functor.mapCochainComplexSingleFunctor,
        CochainComplex.singleFunctor, CochainComplex.singleFunctors,
        HomologicalComplex.comp_f,
        HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
        NatIso.mapHomologicalComplex_hom_app_f,
        HomologicalComplex.single_map_f_self, Category.assoc,
        Iso.inv_hom_id_app_assoc]
      rw [e.hom.naturality]
      simp
    · exact (HomologicalComplex.isZero_single_obj_X
        (ComplexShape.up ℤ) 0 (F.obj X) i hi).eq_of_src _ _
  calc
    _ = DerivedCategory.Q.map
          ((F.mapCochainComplexSingleFunctor 0).inv.app X) ≫ hrest := by
      simp only [hrest, Category.assoc, Iso.inv_hom_id_app_assoc,
        ← Functor.map_comp]
      rw [hcomplex]
      rw [Functor.map_comp]
      simp
    _ = (F.mapDerivedCategorySingleFunctor 0).inv.app X ≫
          F.mapDerivedCategoryFactors.hom.app
            ((CochainComplex.singleFunctor C 0).obj X) ≫ hrest := hF.symm
    _ = _ := by
      simp only [hrest, Category.assoc]

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem mapDerivedCategoryNatIso_single_hom_target
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    (e : F ≅ G) (X : C) :
    (mapDerivedCategoryNatIso F G e).hom.app
          ((DerivedCategory.singleFunctor C 0).obj X) ≫
        (G.mapDerivedCategorySingleFunctor 0).hom.app X =
      (F.mapDerivedCategorySingleFunctor 0).hom.app X ≫
        (DerivedCategory.singleFunctor D 0).map (e.hom.app X) := by
  apply (cancel_epi ((F.mapDerivedCategorySingleFunctor 0).inv.app X)).mp
  have hs := congrArg
    (fun h ↦ h ≫ (G.mapDerivedCategorySingleFunctor 0).hom.app X)
    (mapDerivedCategoryNatIso_single_hom F G e X)
  have hs' := hs.symm
  simp only [Category.assoc, Iso.inv_hom_id_app_assoc,
    Iso.inv_hom_id_app, Category.id_comp] at hs'
  erw [Category.comp_id] at hs'
  erw [Iso.inv_hom_id_app_assoc]
  exact hs'

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- Exact-functor maps on Ext are natural in an isomorphism of exact
functors. -/
theorem mapExactFunctor_naturality_iso
    (F G : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] [G.Additive] [PreservesFiniteLimits G]
    [PreservesFiniteColimits G]
    [HasDerivedCategory.{t} C] [HasDerivedCategory.{t'} D]
    [HasExt.{w} C] [HasExt.{w'} D]
    (e : F ≅ G) {X Y : C} {n : ℕ} (x : Ext.{w} X Y n) :
    (x.mapExactFunctor F).comp (Ext.mk₀ (e.hom.app Y)) (Nat.add_zero n) =
      (Ext.mk₀ (e.hom.app X)).comp
        (x.mapExactFunctor G) (Nat.zero_add n) := by
  ext
  rw [Ext.comp_hom, Ext.comp_hom, Ext.mapExactFunctor_hom,
    Ext.mapExactFunctor_hom, Ext.mk₀_hom, Ext.mk₀_hom]
  simp only [ShiftedHom.comp_mk₀, ShiftedHom.mk₀_comp]
  let d := mapDerivedCategoryNatIso F G e
  have ht := congrArg
    (fun h ↦ (shiftFunctor (DerivedCategory D) (n : ℤ)).map h)
    (mapDerivedCategoryNatIso_single_hom_target F G e Y)
  simp only [Functor.map_comp] at ht
  have hn := ShiftedHom.map_naturality x.hom d.hom
  simp only [ShiftedHom.comp_mk₀, ShiftedHom.mk₀_comp] at hn
  dsimp [d] at hn
  simp only [Category.assoc]
  rw [← ht]
  slice_lhs 2 3 => rw [hn]
  slice_lhs 1 2 =>
    rw [← mapDerivedCategoryNatIso_single_hom F G e X]
  simp only [Category.assoc]

end Abelian.Ext

universe v₀ u₀ v₁ u₁ v₂ u₂

variable {C₀ : Type u₀} [Category.{v₀} C₀]
variable (J₀ : GrothendieckTopology C₀)
variable {C₁ : Type u₁} [Category.{v₁} C₁]
variable (K₀ : GrothendieckTopology C₁)
variable (D₀ : Type u₂) [Category.{v₂} D₀]
  [HasWeakSheafify J₀ D₀] [HasWeakSheafify K₀ D₀]
variable (G₀ : C₀ ⥤ C₁)
  [∀ (X : (C₁)ᵒᵖ), HasLimitsOfShape (StructuredArrow X G₀.op) D₀]
  [G₀.IsDenseSubsite J₀ K₀] {T₀ : C₀}
  (hT₀ : IsTerminal T₀) (hT₁ : IsTerminal (G₀.obj T₀))

/-- The constant-sheaf comparison for a dense equivalence is characterized
by the unit of the target constant-sheaf adjunction. -/
theorem equivCommuteConstant'_homEquiv (A : D₀) :
    ((constantSheafAdj J₀ D₀ hT₀).homEquiv A _)
        ((equivCommuteConstant' J₀ D₀ K₀ G₀ hT₀ hT₁).hom.app A) =
      (constantSheafAdj K₀ D₀ hT₁).unit.app A := by
  let e := Functor.IsDenseSubsite.sheafEquiv J₀ K₀ G₀ D₀
  let adjJ := constantSheafAdj J₀ D₀ hT₀
  let adjK := constantSheafAdj K₀ D₀ hT₁
  change adjJ.homEquiv A _
      (e.unitIso.hom.app ((constantSheaf J₀ D₀).obj A) ≫
        e.inverse.map
          (((adjJ.comp e.toAdjunction).leftAdjointUniq adjK).hom.app A)) =
    adjK.unit.app A
  let α := ((adjJ.comp e.toAdjunction).leftAdjointUniq adjK).hom.app A
  have hcomp :
      (adjJ.comp e.toAdjunction).homEquiv A _ α =
        adjJ.homEquiv A _
          (e.unitIso.hom.app ((constantSheaf J₀ D₀).obj A) ≫
            e.inverse.map α) := by
    rw [Adjunction.comp_homEquiv]
    rfl
  rw [← hcomp]
  exact Adjunction.homEquiv_leftAdjointUniq_hom_app _ _ A

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- The units of the constant-sheaf adjunction at two terminal objects are
identified by the unique morphism between those terminal objects. -/
theorem constantSheafAdj_unit_terminal_change
    {C : Type u₀} [Category.{v₀} C] (J : GrothendieckTopology C)
    (D : Type u₂) [Category.{v₂} D] [HasWeakSheafify J D]
    {T T' : C} (hT : IsTerminal T) (hT' : IsTerminal T') (A : D) :
    (constantSheafAdj J D hT).unit.app A ≫
        ((constantSheaf J D).obj A).val.map (hT.from T').op =
      (constantSheafAdj J D hT').unit.app A := by
  simp only [constantSheafAdj, Adjunction.comp_unit_app,
    constantPresheafAdj_unit_app, Functor.comp_obj,
    Functor.id_obj, Category.id_comp]
  let η := (sheafificationAdjunction J D).unit.app
    ((Functor.const Cᵒᵖ).obj A)
  change η.app (Opposite.op T) ≫
      ((presheafToSheaf J D).obj
        ((Functor.const Cᵒᵖ).obj A)).obj.map (hT.from T').op =
    η.app (Opposite.op T')
  simpa [η] using (η.naturality (hT.from T').op).symm

open Abelian

universe v v' u u' w w'

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- An additive equivalence of abelian categories identifies all Ext groups.
This is the exact functoriality needed to transport sheaf cohomology across
an equivalence of sites. -/
noncomputable def extMapAddEquivOfEquivalence
    {D : Type u'} [Category.{v'} D] [Abelian D]
    (F : C ⥤ D) [F.Additive] [F.IsEquivalence]
    [HasExt.{w} C] [HasExt.{w'} D] [EnoughInjectives C]
    (X Y : C) (n : ℕ) :
    Ext.{w} X Y n ≃+ Ext.{w'} (F.obj X) (F.obj Y) n :=
  AddEquiv.ofBijective (F.mapExtAddHom X Y n) <| by
    apply F.mapExt_bijective_of_preservesInjectiveObjects

/-- Precomposition by an isomorphism in the first Ext variable is an
additive equivalence. -/
noncomputable def extPrecompAddEquiv
    [HasExt.{w} C] {X Y : C} (i : X ≅ Y) (Z : C) (n : ℕ) :
    Ext Y Z n ≃+ Ext X Z n :=
  let m := ((extFunctor n).map i.op.hom).app Z
  AddEquiv.ofBijective m.hom (ConcreteCategory.bijective_of_isIso m)

end CategoryTheory

namespace AlgebraicGeometry.Scheme.ProEt

universe u

local instance : MorphismProperty.IsStableUnderComposition
    (@WeaklyEtale : MorphismProperty Scheme.{u}) where
  comp_mem f g hf hg := by
    let _ : WeaklyEtale f := hf
    let _ : WeaklyEtale g := hg
    infer_instance

/-- Composition with a weakly étale morphism on small pro-étale sites. -/
noncomputable def map {X Y : Scheme.{u}} (f : X ⟶ Y) [WeaklyEtale f] :
    X.ProEt ⥤ Y.ProEt :=
  MorphismProperty.Over.map ⊤ (show WeaklyEtale f from inferInstance)

lemma precoverage_map {X Y : Scheme.{u}} (j : X ⟶ Y) [WeaklyEtale j] :
    precoverage X = (precoverage Y).comap (map j) := by
  rw [precoverage, precoverage, ← Precoverage.comap_comp]
  congr 1

noncomputable instance precoverage_isStableUnderBaseChange (X : Scheme.{u}) :
    (precoverage X).IsStableUnderBaseChange := by
  dsimp only [precoverage]
  infer_instance

noncomputable instance map_preservesWalkingCospans {X Y : Scheme.{u}}
    (j : X ⟶ Y) [WeaklyEtale j] :
    PreservesLimitsOfShape WalkingCospan (map j) := by
  let _ : PreservesLimitsOfShape WalkingCospan (CategoryTheory.Over.map j) := by
    have : PreservesLimitsOfShape WalkingCospan
        (CategoryTheory.Over.map j ⋙ CategoryTheory.Over.forget Y) := by
      change PreservesLimitsOfShape WalkingCospan (CategoryTheory.Over.forget X)
      infer_instance
    exact preservesLimitsOfShape_of_reflects_of_preserves
      (CategoryTheory.Over.map j) (CategoryTheory.Over.forget Y)
  have : PreservesLimitsOfShape WalkingCospan (map j ⋙ ProEt.forget Y) := by
    change PreservesLimitsOfShape WalkingCospan
      (ProEt.forget X ⋙ CategoryTheory.Over.map j)
    infer_instance
  exact preservesLimitsOfShape_of_reflects_of_preserves (map j) (ProEt.forget Y)

/-- Weakly étale composition preserves the pro-étale topology. -/
instance map_isContinuous {X Y : Scheme.{u}} (j : X ⟶ Y) [WeaklyEtale j] :
    Functor.IsContinuous (map j) (topology X) (topology Y) := by
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
    (F := map j) (precoverage X) (precoverage Y)
  rw [precoverage_map j]

/-- The genuine left adjoint to restriction on small pro-étale sites. -/
noncomputable def lowerShriek {X Y : Scheme.{u}} (f : X ⟶ Y) [WeaklyEtale f] :
    Sheaf (topology X) Ab.{u + 1} ⥤ Sheaf (topology Y) Ab.{u + 1} :=
  (map f).sheafPullback Ab.{u + 1} (topology X) (topology Y)

/-- The adjunction characterizing `lowerShriek`. -/
noncomputable def lowerShriekAdjunction {X Y : Scheme.{u}} (f : X ⟶ Y)
    [WeaklyEtale f] :
    lowerShriek f ⊣ (map f).sheafPushforwardContinuous
      Ab.{u + 1} (topology X) (topology Y) :=
  (map f).sheafAdjunctionContinuous Ab.{u + 1} (topology X) (topology Y)

/-- Composition comparison for the covariant small pro-étale maps attached
to weakly étale scheme morphisms. -/
noncomputable def mapCompIso {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) [WeaklyEtale f] [WeaklyEtale g] :
    map (f ≫ g) ≅ map f ⋙ map g :=
  MorphismProperty.Over.mapComp
    (⊤ : MorphismProperty Scheme.{u})
    (show WeaklyEtale f from inferInstance)
    (show WeaklyEtale g from inferInstance)

/-- Right-adjoint composition comparison for small pro-étale sheaves. -/
noncomputable def mapSheafPushforwardComp {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) [WeaklyEtale f] [WeaklyEtale g] :
    (map g).sheafPushforwardContinuous Ab.{u + 1}
          (topology Y) (topology Z) ⋙
        (map f).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Y) ≅
      (map (f ≫ g)).sheafPushforwardContinuous Ab.{u + 1}
        (topology X) (topology Z) := by
  letI : (map f ⋙ map g).IsContinuous (topology X) (topology Z) :=
    Functor.isContinuous_comp (map f) (map g)
      (topology X) (topology Y) (topology Z)
  exact Functor.sheafPushforwardContinuousComp
      (map f) (map g) Ab.{u + 1}
      (topology X) (topology Y) (topology Z) ≪≫
    Functor.sheafPushforwardContinuousIso
      (mapCompIso f g).symm Ab.{u + 1} (topology X) (topology Z)

/-- Extension by zero is compatible with composition of weakly étale
morphisms. -/
noncomputable def lowerShriekCompIso {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) [WeaklyEtale f] [WeaklyEtale g] :
    lowerShriek f ⋙ lowerShriek g ≅ lowerShriek (f ≫ g) := by
  let aComp := (lowerShriekAdjunction f).comp (lowerShriekAdjunction g)
  let aDirect := lowerShriekAdjunction (f ≫ g)
  exact Adjunction.leftAdjointUniq
    (aComp.ofNatIsoRight (mapSheafPushforwardComp f g)) aDirect

/-- The `Z_l` coefficient sheaf lifted to the universe in which the left
Kan extension exists. -/
noncomputable def ellAdicSheafULift (X : Scheme.{u}) (ell : ℕ)
    [Fact ell.Prime] : Sheaf (topology X) Ab.{u + 1} :=
  (sheafCompose _ AddCommGrpCat.uliftFunctor.{u + 1}).obj (X.ellAdicSheaf ell)

/-- The sheaf `j_! Z_l` associated with an open immersion. -/
noncomputable def compactSupportSheaf {X Xbar : Scheme.{u}} (j : X ⟶ Xbar)
    [IsOpenImmersion j] (ell : ℕ) [Fact ell.Prime] :
    Sheaf (topology Xbar) Ab.{u + 1} :=
  (lowerShriek j).obj (ellAdicSheafULift X ell)

/-- Compactly supported `Z_l`-cohomology relative to an open immersion into
a scheme proper over the base. -/
def CompactlySupportedEllAdicCohomology {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (ell : ℕ) [Fact ell.Prime] (n : ℕ) : Type (u + 1) :=
  (compactSupportSheaf j ell).H n

noncomputable instance {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (ell : ℕ) [Fact ell.Prime] (n : ℕ) :
    AddCommGroup (CompactlySupportedEllAdicCohomology j pbar ell n) :=
  inferInstanceAs <| AddCommGroup ((compactSupportSheaf j ell).H n)

/-! Arbitrary scheme maps act contravariantly on the small pro-étale site by
base change.  This supplies the functorial input needed to construct geometric
Frobenius on Sawin's ordered-root space. -/

/-- The underlying comma-category presentation used by the small pro-étale site. -/
abbrev Raw (X : Scheme.{u}) :=
  MorphismProperty.Over @WeaklyEtale ⊤ X

local instance rawCategory (X : Scheme.{u}) : Category.{u} (Raw X) := by
  exact X.instCategoryProEt

/-- Arbitrary scheme morphisms act contravariantly on the underlying small
pro-étale categories by base change. -/
noncomputable def rawBaseChange {X Y : Scheme.{u}} (f : X ⟶ Y) := by
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong (@WeaklyEtale) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  exact MorphismProperty.Over.pullback @WeaklyEtale ⊤ f

/-- Comparison from the raw comma presentation to `Scheme.ProEt`. -/
def rawToProEt (X : Scheme.{u}) : Raw X ⥤ X.ProEt where
  obj U := U
  map f := f
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Comparison from `Scheme.ProEt` to the raw comma presentation. -/
def proEtToRaw (X : Scheme.{u}) : X.ProEt ⥤ Raw X where
  obj U := U
  map f := f
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Base change along an arbitrary scheme morphism, named separately from
the covariant `ProEt.map` along weakly étale morphisms. -/
noncomputable def baseChange {X Y : Scheme.{u}} (f : X ⟶ Y) :
    Y.ProEt ⥤ X.ProEt :=
  proEtToRaw Y ⋙ rawBaseChange f ⋙ rawToProEt X

/-! For a scheme isomorphism, base change is an equivalence even after
restricting the over categories to weakly étale objects.  Mathlib has the
corresponding statement for unrestricted over categories; the explicit
quasi-inverse below records that the weakly étale restriction is stable
under composition with an isomorphism. -/

theorem weaklyEtaleOverMap_isEquivalence_of_isIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    let h : WeaklyEtale f := inferInstance
    (MorphismProperty.Over.map
      (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤ h).IsEquivalence := by
  let hf : WeaklyEtale f := inferInstance
  let hi : WeaklyEtale (inv f) := inferInstance
  let F := MorphismProperty.Over.map ⊤ hf
  let G := MorphismProperty.Over.map ⊤ hi
  let hfi : WeaklyEtale (f ≫ inv f) := inferInstance
  let hif : WeaklyEtale (inv f ≫ f) := inferInstance
  let hidX : WeaklyEtale (𝟙 X) := inferInstance
  let hidY : WeaklyEtale (𝟙 Y) := inferInstance
  have efi :
      MorphismProperty.Over.map ⊤ hfi ≅
        MorphismProperty.Over.map ⊤ hidX :=
    MorphismProperty.Over.mapCongr ⊤ (by simp) hfi
  have eif :
      MorphismProperty.Over.map ⊤ hif ≅
        MorphismProperty.Over.map ⊤ hidY :=
    MorphismProperty.Over.mapCongr ⊤ (by simp) hif
  have η : 𝟭 (Raw X) ≅ F ⋙ G :=
    (MorphismProperty.Over.mapId
      (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
      (⊤ : MorphismProperty Scheme.{u}) X).symm ≪≫
      efi.symm ≪≫
      MorphismProperty.Over.mapComp ⊤ hf hi
  have ε : G ⋙ F ≅ 𝟭 (Raw Y) :=
    (MorphismProperty.Over.mapComp ⊤ hi hf).symm ≪≫
      eif ≪≫
      MorphismProperty.Over.mapId
        (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (⊤ : MorphismProperty Scheme.{u}) Y
  exact Functor.IsEquivalence.mk' G η ε

theorem rawBaseChange_isEquivalence_of_isIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (rawBaseChange f).IsEquivalence := by
  let : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  change (MorphismProperty.Over.pullback
    (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ f).IsEquivalence
  let hf : WeaklyEtale f := inferInstance
  have : (MorphismProperty.Over.map
      (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤ hf).IsEquivalence :=
    weaklyEtaleOverMap_isEquivalence_of_isIso f
  exact Adjunction.isEquivalence_right_of_isEquivalence_left
    (MorphismProperty.Over.mapPullbackAdj
      (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ f hf trivial)

theorem rawToProEt_isEquivalence (X : Scheme.{u}) :
    (rawToProEt X).IsEquivalence := by
  exact
    { faithful := ⟨fun h ↦ h⟩
      full := ⟨fun f ↦ ⟨f, rfl⟩⟩
      essSurj := ⟨fun Y ↦ ⟨Y, ⟨Iso.refl _⟩⟩⟩ }

theorem proEtToRaw_isEquivalence (X : Scheme.{u}) :
    (proEtToRaw X).IsEquivalence := by
  exact
    { faithful := ⟨fun h ↦ h⟩
      full := ⟨fun f ↦ ⟨f, rfl⟩⟩
      essSurj := ⟨fun Y ↦ ⟨Y, ⟨Iso.refl _⟩⟩⟩ }

/-- Pullback along an identity morphism is the identity even on the
weakly-étale restricted over category. -/
noncomputable def rawBaseChangeId (X : Scheme.{u}) :
    rawBaseChange (𝟙 X) ≅ Functor.id (Raw X) := by
  letI : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) (𝟙 X) :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) (𝟙 X) :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  refine NatIso.ofComponents (fun U ↦
    MorphismProperty.Comma.isoFromComma
      ((CategoryTheory.Over.pullbackId (X := X)).app
        ((MorphismProperty.Over.forget
          (@WeaklyEtale : MorphismProperty Scheme.{u}) ⊤ X).obj U))) ?_
  intro U V f
  apply MorphismProperty.Over.Hom.ext
  exact congrArg CategoryTheory.CommaMorphism.left
    ((CategoryTheory.Over.pullbackId (X := X)).hom.naturality f.hom)

/-- Restricted base change is contravariantly functorial under composition. -/
noncomputable def rawBaseChangeComp {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    rawBaseChange (f ≫ g) ≅ rawBaseChange g ⋙ rawBaseChange f := by
  letI : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  letI : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  exact MorphismProperty.Over.pullbackComp f g

/-- Small pro-étale base change is contravariantly functorial under
composition, including the comparison functors between the chosen comma
presentation and `Scheme.ProEt`. -/
noncomputable def baseChangeComp {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    baseChange (f ≫ g) ≅ baseChange g ⋙ baseChange f := by
  unfold baseChange
  exact ((Functor.whiskeringLeft _ _ _).obj (proEtToRaw Z)).mapIso
    (((Functor.whiskeringRight _ _ _).obj (rawToProEt X)).mapIso
      (rawBaseChangeComp f g))

/-- Base change by the identity scheme morphism is naturally isomorphic to
the identity functor on the chosen small pro-étale site. -/
noncomputable def baseChangeId (X : Scheme.{u}) :
    baseChange (𝟙 X) ≅ Functor.id X.ProEt := by
  unfold baseChange
  exact ((Functor.whiskeringLeft _ _ _).obj (proEtToRaw X)).mapIso
    (((Functor.whiskeringRight _ _ _).obj (rawToProEt X)).mapIso
      (rawBaseChangeId X))

/-- Equal scheme maps induce naturally isomorphic restricted base-change
functors. -/
noncomputable def rawBaseChangeCongr {X Y : Scheme.{u}}
    {f g : X ⟶ Y} (h : f = g) :
    rawBaseChange f ≅ rawBaseChange g := by
  subst h
  exact Iso.refl _

/-- An explicit equivalence on restricted over categories whose inverse is
base change along the inverse scheme isomorphism. -/
noncomputable def rawBaseChangeEquivalenceOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] : Raw Y ≌ Raw X := by
  let F := rawBaseChange f
  let G := rawBaseChange (inv f)
  have η : Functor.id (Raw Y) ≅ F ⋙ G :=
    (rawBaseChangeId Y).symm ≪≫
      rawBaseChangeCongr (by simp : 𝟙 Y = inv f ≫ f) ≪≫
      rawBaseChangeComp (inv f) f
  have ε : G ⋙ F ≅ Functor.id (Raw X) :=
    (rawBaseChangeComp f (inv f)).symm ≪≫
      rawBaseChangeCongr (by simp : f ≫ inv f = 𝟙 X) ≪≫
      rawBaseChangeId X
  exact CategoryTheory.Equivalence.mk F G η ε

/-- The raw comma presentation and `Scheme.ProEt` are explicitly equivalent. -/
noncomputable def proEtRawEquivalence (X : Scheme.{u}) :
    X.ProEt ≌ Raw X :=
  CategoryTheory.Equivalence.mk
    (proEtToRaw X) (rawToProEt X) (Iso.refl _) (Iso.refl _)

/-- Site equivalence induced by a scheme isomorphism, with forward functor
definitionally equal to `baseChange f`. -/
noncomputable def baseChangeEquivalenceOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] : Y.ProEt ≌ X.ProEt :=
  ((proEtRawEquivalence Y).trans
    (rawBaseChangeEquivalenceOfIso f)).trans
    (proEtRawEquivalence X).symm

/-- The inverse of the explicit site equivalence is base change along the
inverse scheme map, up to reassociation of functor composition. -/
noncomputable def baseChangeEquivalenceInverseIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIso f).inverse ≅ baseChange (inv f) := by
  unfold baseChangeEquivalenceOfIso baseChange
  change proEtToRaw X ⋙ (rawBaseChange (inv f) ⋙ rawToProEt Y) ≅
    (proEtToRaw X ⋙ rawBaseChange (inv f)) ⋙ rawToProEt Y
  exact (Functor.associator _ _ _).symm

/-- Pro-étale base change along a scheme isomorphism is an equivalence of
the chosen small sites. -/
theorem baseChange_isEquivalence_of_isIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChange f).IsEquivalence := by
  unfold baseChange
  let hA : (proEtToRaw Y).IsEquivalence := proEtToRaw_isEquivalence Y
  let hB : (rawBaseChange f).IsEquivalence :=
    rawBaseChange_isEquivalence_of_isIso f
  let hC : (rawToProEt X).IsEquivalence := rawToProEt_isEquivalence X
  let eA : Y.ProEt ≌ Raw Y :=
    @Functor.asEquivalence _ _ _ _ (proEtToRaw Y) hA
  let eB : Raw Y ≌ Raw X :=
    @Functor.asEquivalence _ _ _ _ (rawBaseChange f) hB
  let eC : Raw X ≌ X.ProEt :=
    @Functor.asEquivalence _ _ _ _ (rawToProEt X) hC
  change ((eA.trans eB).trans eC).functor.IsEquivalence
  exact ((eA.trans eB).trans eC).isEquivalence_functor

/-- Arbitrary scheme-morphism base change is continuous for the small
pro-étale topology. -/
theorem baseChange_isContinuous {X Y : Scheme.{u}} (f : X ⟶ Y) :
    (baseChange f).IsContinuous (topology Y) (topology X) := by
  let : MorphismProperty.HasPullbacksAlong (@WeaklyEtale) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong (@WeaklyEtale) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  let : (precoverage Y).IsStableUnderBaseChange := by
    change (Scheme.proetalePrecoverage.comap
      (ProEt.forget Y ⋙ Over.forget Y)).IsStableUnderBaseChange
    infer_instance
  let : PreservesLimitsOfShape WalkingCospan
      (CategoryTheory.Over.pullback f) := inferInstance
  let : PreservesLimitsOfShape WalkingCospan (baseChange f) := by
    have : PreservesLimitsOfShape WalkingCospan
        (baseChange f ⋙ ProEt.forget X) :=
      inferInstanceAs (PreservesLimitsOfShape WalkingCospan
        (ProEt.forget Y ⋙ CategoryTheory.Over.pullback f))
    exact preservesLimitsOfShape_of_reflects_of_preserves
      (baseChange f) (ProEt.forget X)
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
    (baseChange f) (precoverage Y) (precoverage X)
  intro U R hR
  simp only [Precoverage.mem_comap_iff]
  change (R.map (baseChange f)).map (ProEt.forget X ⋙ Over.forget X) ∈
      Scheme.proetalePrecoverage _
  change R.map (ProEt.forget Y ⋙ Over.forget Y) ∈
    Scheme.proetalePrecoverage _ at hR
  obtain ⟨ι, V, g, rfl⟩ := R.exists_eq_ofArrows
  simp only [Presieve.map_ofArrows] at hR ⊢
  apply Precoverage.mem_coverings_of_isPullback _ hR
    (pullback.fst U.hom f)
    (fun i ↦ ((baseChange f).map (g i)).left)
    (fun i ↦ pullback.fst (V i).hom f)
  intro i
  have hs : IsPullback
      (((baseChange f).map (g i)).left ≫ pullback.snd U.hom f)
      (pullback.fst (V i).hom f)
      f
      ((g i).left ≫ U.hom) := by
    rw [show ((baseChange f).map (g i)).left ≫ pullback.snd U.hom f =
        pullback.snd (V i).hom f by
      change (pullback.lift
          (pullback.fst (V i).hom f ≫ (g i).left)
          (pullback.snd (V i).hom f) _) ≫
          pullback.snd U.hom f = _
      exact pullback.lift_snd _ _ _]
    have hw : (g i).left ≫ U.hom = (V i).hom := by
      change (g i).hom.left ≫ U.hom = (V i).hom
      simpa using (g i).hom.w
    rw [hw]
    exact (IsPullback.of_hasPullback (V i).hom f).flip
  exact IsPullback.of_right hs
    (by
      change (pullback.lift
          (pullback.fst (V i).hom f ≫ (g i).left)
          (pullback.snd (V i).hom f) _) ≫
          pullback.fst U.hom f =
        pullback.fst (V i).hom f ≫ (g i).left
      exact pullback.lift_fst _ _ _)
    (IsPullback.of_hasPullback U.hom f).flip

/-- Both directions of the explicit site equivalence are continuous, so its
forward functor is cocontinuous. -/
theorem baseChangeEquivalence_functor_isCocontinuous
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIso f).functor.IsCocontinuous
      (topology Y) (topology X) := by
  let e := baseChangeEquivalenceOfIso f
  let : (baseChange (inv f)).IsContinuous (topology X) (topology Y) :=
    baseChange_isContinuous (inv f)
  let : e.inverse.IsContinuous (topology X) (topology Y) :=
    Functor.isContinuous_of_iso (baseChangeEquivalenceInverseIso f).symm
      (topology X) (topology Y)
  rw [e.toAdjunction.isCocontinuous_iff_coverPreserving]
  exact CoverPreserving.of_isContinuous e.inverse (topology X) (topology Y)

/-- The inverse of the explicit site equivalence is likewise cocontinuous. -/
theorem baseChangeEquivalence_inverse_isCocontinuous
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIso f).inverse.IsCocontinuous
      (topology X) (topology Y) := by
  let e := baseChangeEquivalenceOfIso f
  let : e.functor.IsContinuous (topology Y) (topology X) := by
    change (baseChange f).IsContinuous (topology Y) (topology X)
    exact baseChange_isContinuous f
  change e.symm.functor.IsCocontinuous (topology X) (topology Y)
  rw [e.symm.toAdjunction.isCocontinuous_iff_coverPreserving]
  exact CoverPreserving.of_isContinuous e.functor (topology Y) (topology X)

/-- Base change by a scheme isomorphism is a dense equivalence of the small
pro-étale sites. -/
theorem baseChange_isDenseSubsite_of_isIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChange f).IsDenseSubsite (topology Y) (topology X) := by
  let e := baseChangeEquivalenceOfIso f
  let : e.functor.IsCocontinuous (topology Y) (topology X) :=
    baseChangeEquivalence_functor_isCocontinuous f
  let : e.inverse.IsCocontinuous (topology X) (topology Y) :=
    baseChangeEquivalence_inverse_isCocontinuous f
  change e.functor.IsDenseSubsite (topology Y) (topology X)
  exact e.isDenseSubsite_functor_of_isCocontinuous
    (topology Y) (topology X)

/-- The inverse functor is a dense subsite as well. -/
theorem baseChangeEquivalence_inverse_isDenseSubsite
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeEquivalenceOfIso f).inverse.IsDenseSubsite
      (topology X) (topology Y) := by
  let e := baseChangeEquivalenceOfIso f
  let : e.functor.IsCocontinuous (topology Y) (topology X) :=
    baseChangeEquivalence_functor_isCocontinuous f
  let : e.inverse.IsCocontinuous (topology X) (topology Y) :=
    baseChangeEquivalence_inverse_isCocontinuous f
  exact e.isDenseSubsite_inverse_of_isCocontinuous
    (topology Y) (topology X)

/-- Precomposition with arbitrary base change on small pro-étale sheaves. -/
noncomputable def baseChangeSheafPushforward {X Y : Scheme.{u}} (f : X ⟶ Y) :
    Sheaf (topology X) Ab ⥤ Sheaf (topology Y) Ab := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  exact (baseChange f).sheafPushforwardContinuous Ab (topology Y) (topology X)

/-- Pushforward on abelian sheaves respects composition of scheme base
change.  The order is covariant on sheaves because scheme base change itself
is contravariant. -/
noncomputable def baseChangeSheafPushforwardComp
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    baseChangeSheafPushforward f ⋙ baseChangeSheafPushforward g ≅
      baseChangeSheafPushforward (f ≫ g) := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  letI : (baseChange g).IsContinuous (topology Z) (topology Y) :=
    baseChange_isContinuous g
  letI : (baseChange (f ≫ g)).IsContinuous (topology Z) (topology X) :=
    baseChange_isContinuous (f ≫ g)
  letI : (baseChange g ⋙ baseChange f).IsContinuous
      (topology Z) (topology X) :=
    Functor.isContinuous_comp (baseChange g) (baseChange f)
      (topology Z) (topology Y) (topology X)
  exact Functor.sheafPushforwardContinuousComp
      (baseChange g) (baseChange f) Ab.{u + 1}
      (topology Z) (topology Y) (topology X) ≪≫
    Functor.sheafPushforwardContinuousIso
      (baseChangeComp f g).symm Ab.{u + 1}
      (topology Z) (topology X)

/-- Pushforward on abelian sheaves for identity base change is the identity
functor. -/
noncomputable def baseChangeSheafPushforwardId (X : Scheme.{u}) :
    baseChangeSheafPushforward (𝟙 X) ≅
      Functor.id (Sheaf (topology X) Ab.{u + 1}) := by
  letI : (baseChange (𝟙 X)).IsContinuous (topology X) (topology X) :=
    baseChange_isContinuous (𝟙 X)
  exact Functor.sheafPushforwardContinuousId'
    (baseChangeId X) Ab.{u + 1} (topology X)

noncomputable instance baseChangeSheafPushforward_additive
    {X Y : Scheme.{u}} (f : X ⟶ Y) :
    (baseChangeSheafPushforward f).Additive where
  map_add := by
    intro A B g h
    ext U x
    rfl

/-- A scheme isomorphism induces an explicit equivalence of categories of
abelian sheaves on the small pro-étale sites. -/
noncomputable def baseChangeSheafEquivalenceOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    Sheaf (topology X) Ab ≌ Sheaf (topology Y) Ab := by
  let e := baseChangeEquivalenceOfIso f
  letI : e.inverse.IsDenseSubsite (topology X) (topology Y) :=
    baseChangeEquivalence_inverse_isDenseSubsite f
  exact (e.sheafCongr (topology Y) (topology X) Ab).symm

theorem baseChangeSheafEquivalenceOfIso_functor
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeSheafEquivalenceOfIso f).functor =
      baseChangeSheafPushforward f := by
  unfold baseChangeSheafEquivalenceOfIso baseChangeSheafPushforward
  rfl

/-- In particular, precomposition by base change along a scheme isomorphism
is an equivalence of abelian sheaf categories. -/
theorem baseChangeSheafPushforward_isEquivalence_of_isIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (baseChangeSheafPushforward f).IsEquivalence := by
  rw [← baseChangeSheafEquivalenceOfIso_functor f]
  exact (baseChangeSheafEquivalenceOfIso f).isEquivalence_functor

/-- A site equivalence carries the constant abelian sheaf to the constant
abelian sheaf.  The orientation is chosen to match contravariant scheme base
change: sheaves on `X` are sent to sheaves on `Y`. -/
noncomputable def baseChangeConstantSheafIsoOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (A : Ab.{u + 1}) :
    (constantSheaf (topology Y) Ab.{u + 1}).obj A ≅
      (baseChangeSheafPushforward f).obj
        ((constantSheaf (topology X) Ab.{u + 1}).obj A) := by
  let e := baseChangeEquivalenceOfIso f
  letI : e.functor.IsContinuous (topology Y) (topology X) := by
    change (baseChange f).IsContinuous (topology Y) (topology X)
    exact baseChange_isContinuous f
  letI : e.functor.IsCocontinuous (topology Y) (topology X) :=
    baseChangeEquivalence_functor_isCocontinuous f
  letI : e.functor.IsDenseSubsite (topology Y) (topology X) :=
    baseChange_isDenseSubsite_of_isIso f
  letI : e.functor.IsEquivalence := e.isEquivalence_functor
  let T : Y.ProEt := ⊤_ Y.ProEt
  let hT : IsTerminal T := terminalIsTerminal
  let hT' : IsTerminal (e.functor.obj T) := hT.isTerminalObj e.functor
  exact (CategoryTheory.equivCommuteConstant'
    (topology Y) Ab.{u + 1} (topology X) e.functor hT hT').app A

/-- Characterization of the constant-sheaf comparison by the adjunction
unit at the chosen terminal pro-étale object. -/
theorem baseChangeConstantSheafIsoOfIso_homEquiv
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (A : Ab.{u + 1}) :
    let e := baseChangeEquivalenceOfIso f
    let T : Y.ProEt := ⊤_ Y.ProEt
    let hT : IsTerminal T := terminalIsTerminal
    let hT' : IsTerminal (e.functor.obj T) :=
      hT.isTerminalObj e.functor
    ((constantSheafAdj (topology Y) Ab.{u + 1} hT).homEquiv A _)
        (baseChangeConstantSheafIsoOfIso f A).hom =
      (constantSheafAdj (topology X) Ab.{u + 1} hT').unit.app A := by
  dsimp only
  let e := baseChangeEquivalenceOfIso f
  let : e.functor.IsContinuous (topology Y) (topology X) := by
    change (baseChange f).IsContinuous (topology Y) (topology X)
    exact baseChange_isContinuous f
  let : e.functor.IsCocontinuous (topology Y) (topology X) :=
    baseChangeEquivalence_functor_isCocontinuous f
  let : e.functor.IsDenseSubsite (topology Y) (topology X) :=
    baseChange_isDenseSubsite_of_isIso f
  let : e.functor.IsEquivalence := e.isEquivalence_functor
  change
    ((constantSheafAdj (topology Y) Ab.{u + 1}
      (terminalIsTerminal : IsTerminal (⊤_ Y.ProEt))).homEquiv A _)
        ((CategoryTheory.equivCommuteConstant'
          (topology Y) Ab.{u + 1} (topology X)
          (baseChangeEquivalenceOfIso f).functor
          (terminalIsTerminal : IsTerminal (⊤_ Y.ProEt))
          ((terminalIsTerminal : IsTerminal (⊤_ Y.ProEt)).isTerminalObj
            (baseChangeEquivalenceOfIso f).functor)).hom.app A) = _
  exact CategoryTheory.equivCommuteConstant'_homEquiv _ _ _ _ _ _ A

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- The same characterization holds at every terminal object, not only the
chosen terminal object used in the definition. -/
theorem baseChangeConstantSheafIsoOfIso_homEquiv_terminal
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (T : Y.ProEt) (hT : IsTerminal T) (A : Ab.{u + 1}) :
    let e := baseChangeEquivalenceOfIso f
    let hT' : IsTerminal (e.functor.obj T) :=
      hT.isTerminalObj e.functor
    ((constantSheafAdj (topology Y) Ab.{u + 1} hT).homEquiv A _)
        (baseChangeConstantSheafIsoOfIso f A).hom =
      (constantSheafAdj (topology X) Ab.{u + 1} hT').unit.app A := by
  dsimp only
  let e := baseChangeEquivalenceOfIso f
  let T₀ : Y.ProEt := ⊤_ Y.ProEt
  let hT₀ : IsTerminal T₀ := terminalIsTerminal
  let hTf : IsTerminal (e.functor.obj T) :=
    hT.isTerminalObj e.functor
  let hTf₀ : IsTerminal (e.functor.obj T₀) :=
    hT₀.isTerminalObj e.functor
  let v : T₀ ⟶ T := hT.from T₀
  let : IsIso v := isIso_of_isTerminal hT₀ hT v
  let c := baseChangeConstantSheafIsoOfIso f A
  rw [Adjunction.homEquiv_unit]
  apply (cancel_mono
    (((baseChangeSheafPushforward f).obj
      ((constantSheaf (topology X) Ab.{u + 1}).obj A)).val.map v.op)).mp
  change
    (constantSheafAdj (topology Y) Ab.{u + 1} hT).unit.app A ≫
        c.hom.hom.app (Opposite.op T) ≫
          ((baseChangeSheafPushforward f).obj
            ((constantSheaf (topology X) Ab.{u + 1}).obj A)).val.map v.op = _
  rw [← c.hom.hom.naturality v.op]
  slice_lhs 1 2 =>
    rw [CategoryTheory.constantSheafAdj_unit_terminal_change
      (topology Y) Ab.{u + 1} hT hT₀ A]
  have htop := baseChangeConstantSheafIsoOfIso_homEquiv f A
  dsimp only at htop
  rw [Adjunction.homEquiv_unit] at htop
  change
    (constantSheafAdj (topology Y) Ab.{u + 1} hT₀).unit.app A ≫
        c.hom.hom.app (Opposite.op T₀) =
      (constantSheafAdj (topology X) Ab.{u + 1} hTf₀).unit.app A at htop
  rw [htop]
  have hv : e.functor.map v = hTf.from (e.functor.obj T₀) :=
    hTf.hom_ext _ _
  change
    (constantSheafAdj (topology X) Ab.{u + 1} hTf₀).unit.app A =
      (constantSheafAdj (topology X) Ab.{u + 1} hTf).unit.app A ≫
        ((constantSheaf (topology X) Ab.{u + 1}).obj A).val.map
          (e.functor.map v).op
  rw [hv]
  exact (CategoryTheory.constantSheafAdj_unit_terminal_change
    (topology X) Ab.{u + 1} hTf hTf₀ A).symm

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- The canonical comparison carrying constant sheaves across an isomorphic
base change is compatible with composition. -/
theorem baseChangeConstantSheafIsoOfIso_comp
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsIso f] [IsIso g] (A : Ab.{u + 1}) :
    (baseChangeConstantSheafIsoOfIso (f ≫ g) A).hom =
      (baseChangeConstantSheafIsoOfIso g A).hom ≫
        (baseChangeSheafPushforward g).map
          (baseChangeConstantSheafIsoOfIso f A).hom ≫
        (baseChangeSheafPushforwardComp f g).hom.app
          ((constantSheaf (topology X) Ab.{u + 1}).obj A) := by
  apply ((constantSheafAdj (topology Z) Ab.{u + 1}
    (terminalIsTerminal : IsTerminal (⊤_ Z.ProEt))).homEquiv A _).injective
  rw [baseChangeConstantSheafIsoOfIso_homEquiv]
  rw [Adjunction.homEquiv_naturality_right]
  rw [baseChangeConstantSheafIsoOfIso_homEquiv]
  let Tz : Z.ProEt := ⊤_ Z.ProEt
  let eg := baseChangeEquivalenceOfIso g
  let hTz : IsTerminal Tz := terminalIsTerminal
  let hTg : IsTerminal (eg.functor.obj Tz) :=
    hTz.isTerminalObj eg.functor
  have hf := baseChangeConstantSheafIsoOfIso_homEquiv_terminal
    f (eg.functor.obj Tz) hTg A
  dsimp only at hf
  rw [Adjunction.homEquiv_unit] at hf
  change
    (constantSheafAdj (topology Y) Ab.{u + 1} hTg).unit.app A ≫
        (baseChangeConstantSheafIsoOfIso f A).hom.hom.app
          (Opposite.op (eg.functor.obj Tz)) =
      (constantSheafAdj (topology X) Ab.{u + 1}
        (hTg.isTerminalObj
          (baseChangeEquivalenceOfIso f).functor)).unit.app A at hf
  simp only [Functor.map_comp, Category.assoc]
  let ef := baseChangeEquivalenceOfIso f
  let efg := baseChangeEquivalenceOfIso (f ≫ g)
  let hTfTg : IsTerminal (ef.functor.obj (eg.functor.obj Tz)) :=
    hTg.isTerminalObj ef.functor
  let hTfg : IsTerminal (efg.functor.obj Tz) :=
    hTz.isTerminalObj efg.functor
  let α := (baseChangeSheafPushforwardComp f g).hom.app
    ((constantSheaf (topology X) Ab.{u + 1}).obj A)
  change
    (constantSheafAdj (topology X) Ab.{u + 1} hTfg).unit.app A =
      (constantSheafAdj (topology Y) Ab.{u + 1} hTg).unit.app A ≫
        (baseChangeConstantSheafIsoOfIso f A).hom.hom.app
            (Opposite.op (eg.functor.obj Tz)) ≫
          α.hom.app (Opposite.op Tz)
  slice_rhs 1 2 => rw [hf]
  have hsite :
      (baseChangeComp f g).hom.app Tz =
        hTfTg.from (efg.functor.obj Tz) := hTfTg.hom_ext _ _
  change
    (constantSheafAdj (topology X) Ab.{u + 1} hTfg).unit.app A =
      (constantSheafAdj (topology X) Ab.{u + 1} hTfTg).unit.app A ≫
        ((constantSheaf (topology X) Ab.{u + 1}).obj A).val.map
          ((baseChangeComp f g).hom.app Tz).op
  rw [hsite]
  exact (CategoryTheory.constantSheafAdj_unit_terminal_change
    (topology X) Ab.{u + 1} hTfTg hTfg A).symm

/-- Cohomology is invariant under base change along a scheme isomorphism.
The construction first applies functoriality of Ext and then uses the
constant-sheaf comparison in its contravariant variable. -/
noncomputable def baseChangeSheafCohomologyAddEquivOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (Q : Sheaf (topology X) Ab.{u + 1}) (n : ℕ) :
    Q.H n ≃+ ((baseChangeSheafPushforward f).obj Q).H n := by
  let E := baseChangeSheafPushforward f
  letI : E.Additive := baseChangeSheafPushforward_additive f
  letI : E.IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso f
  let Z : Sheaf (topology X) Ab.{u + 1} :=
    (constantSheaf (topology X) Ab.{u + 1}).obj
      (AddCommGrpCat.of (ULift ℤ))
  let Z' : Sheaf (topology Y) Ab.{u + 1} :=
    (constantSheaf (topology Y) Ab.{u + 1}).obj
      (AddCommGrpCat.of (ULift ℤ))
  let c : Z' ≅ E.obj Z :=
    baseChangeConstantSheafIsoOfIso f
      (AddCommGrpCat.of (ULift ℤ))
  exact (CategoryTheory.extMapAddEquivOfEquivalence E Z Q n).trans
    (CategoryTheory.extPrecompAddEquiv c (E.obj Q) n)

/-- A morphism from a sheaf to its geometric pullback along a scheme
automorphism induces a genuine endomorphism of sheaf cohomology.  The final
factor transports cohomology of the pulled-back sheaf back across the site
equivalence; it is independent of any coefficient-sheaf identification. -/
noncomputable def sheafCohomologyPullbackEndomorphismOfIso
    {X : Scheme.{u}} (f : X ⟶ X) [IsIso f]
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (n : ℕ) : Q.H n →+ Q.H n :=
  (baseChangeSheafCohomologyAddEquivOfIso f Q n).symm.toAddMonoidHom.comp
    (Sheaf.H.map pullback n)

/-- Naturality of cohomology transport in the coefficient sheaf. -/
theorem baseChangeSheafCohomologyAddEquivOfIso_naturality
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    {Q R : Sheaf (topology X) Ab.{u + 1}} (h : Q ⟶ R)
    (n : ℕ) (x : Q.H n) :
    baseChangeSheafCohomologyAddEquivOfIso f R n (Sheaf.H.map h n x) =
      Sheaf.H.map ((baseChangeSheafPushforward f).map h) n
        (baseChangeSheafCohomologyAddEquivOfIso f Q n x) := by
  unfold baseChangeSheafCohomologyAddEquivOfIso
    CategoryTheory.extMapAddEquivOfEquivalence
    CategoryTheory.extPrecompAddEquiv
  simp only [AddEquiv.trans_apply, AddEquiv.ofBijective_apply]
  simp only [Sheaf.H.map_apply, Functor.mapExtAddHom_apply]
  simp only [CategoryTheory.Abelian.extFunctor_map_app]
  rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
    CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
  symm
  apply CategoryTheory.Abelian.Ext.comp_assoc
  all_goals omega

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- Forward cohomology transport along isomorphic base changes respects
composition and the canonical comparison of the two pushforward functors. -/
theorem baseChangeSheafCohomologyAddEquivOfIso_comp
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsIso f] [IsIso g]
    (Q : Sheaf (topology X) Ab.{u + 1}) (degree : ℕ)
    (x : Q.H degree) :
    baseChangeSheafCohomologyAddEquivOfIso (f ≫ g) Q degree x =
      Sheaf.H.map
        ((baseChangeSheafPushforwardComp f g).hom.app Q) degree
        (baseChangeSheafCohomologyAddEquivOfIso g
          ((baseChangeSheafPushforward f).obj Q) degree
          (baseChangeSheafCohomologyAddEquivOfIso f Q degree x)) := by
  let F := baseChangeSheafPushforward f
  let G := baseChangeSheafPushforward g
  let H := baseChangeSheafPushforward (f ≫ g)
  let : F.Additive := baseChangeSheafPushforward_additive f
  let : F.IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso f
  let : G.Additive := baseChangeSheafPushforward_additive g
  let : G.IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso g
  let : H.Additive := baseChangeSheafPushforward_additive (f ≫ g)
  let : H.IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso (f ≫ g)
  let := HasDerivedCategory.standard (Sheaf (topology X) Ab.{u + 1})
  let := HasDerivedCategory.standard (Sheaf (topology Y) Ab.{u + 1})
  let := HasDerivedCategory.standard (Sheaf (topology Z) Ab.{u + 1})
  let A : Ab.{u + 1} := AddCommGrpCat.of (ULift ℤ)
  let cF := baseChangeConstantSheafIsoOfIso f A
  let cG := baseChangeConstantSheafIsoOfIso g A
  let cH := baseChangeConstantSheafIsoOfIso (f ≫ g) A
  let α := baseChangeSheafPushforwardComp f g
  unfold baseChangeSheafCohomologyAddEquivOfIso
    CategoryTheory.extMapAddEquivOfEquivalence
    CategoryTheory.extPrecompAddEquiv
  simp only [AddEquiv.trans_apply, AddEquiv.ofBijective_apply,
    Sheaf.H.map_apply, Functor.mapExtAddHom_apply]
  change
    (CategoryTheory.Abelian.Ext.mk₀ cH.hom).comp
        (x.mapExactFunctor H) (Nat.zero_add degree) =
      ((CategoryTheory.Abelian.Ext.mk₀ cG.hom).comp
          (((CategoryTheory.Abelian.Ext.mk₀ cF.hom).comp
            (x.mapExactFunctor F) (Nat.zero_add degree)).mapExactFunctor G)
          (Nat.zero_add degree)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (α.hom.app Q))
        (Nat.add_zero degree)
  rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
  rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
  rw [← CategoryTheory.Abelian.Ext.mapExactFunctor_comp_functor F G x]
  rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
  rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hnat := CategoryTheory.Abelian.Ext.mapExactFunctor_naturality_iso
    (F ⋙ G) H α x
  rw [hnat]
  rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
  dsimp [F, G, H, cF, cG, cH, α, A]
  simp only [Category.assoc]
  rw [← baseChangeConstantSheafIsoOfIso_comp f g]

/-- The inverse cohomology transports satisfy the corresponding composition
formula. -/
theorem baseChangeSheafCohomologyAddEquivOfIso_symm_comp
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsIso f] [IsIso g]
    (Q : Sheaf (topology X) Ab.{u + 1}) (degree : ℕ)
    (x : ((baseChangeSheafPushforward g).obj
      ((baseChangeSheafPushforward f).obj Q)).H degree) :
    (baseChangeSheafCohomologyAddEquivOfIso (f ≫ g) Q degree).symm
        (Sheaf.H.map
          ((baseChangeSheafPushforwardComp f g).hom.app Q) degree x) =
      (baseChangeSheafCohomologyAddEquivOfIso f Q degree).symm
        ((baseChangeSheafCohomologyAddEquivOfIso g
          ((baseChangeSheafPushforward f).obj Q) degree).symm x) := by
  apply (baseChangeSheafCohomologyAddEquivOfIso
    (f ≫ g) Q degree).injective
  rw [AddEquiv.apply_symm_apply]
  rw [baseChangeSheafCohomologyAddEquivOfIso_comp]
  simp

/-- Inverse cohomology transport is natural as well. -/
theorem baseChangeSheafCohomologyAddEquivOfIso_symm_naturality
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    {Q R : Sheaf (topology X) Ab.{u + 1}} (h : Q ⟶ R)
    (n : ℕ)
    (x : ((baseChangeSheafPushforward f).obj Q).H n) :
    (baseChangeSheafCohomologyAddEquivOfIso f R n).symm
        (Sheaf.H.map ((baseChangeSheafPushforward f).map h) n x) =
      Sheaf.H.map h n
        ((baseChangeSheafCohomologyAddEquivOfIso f Q n).symm x) := by
  apply (baseChangeSheafCohomologyAddEquivOfIso f R n).injective
  rw [AddEquiv.apply_symm_apply]
  rw [baseChangeSheafCohomologyAddEquivOfIso_naturality]
  rw [AddEquiv.apply_symm_apply]

/-! ### Geometric fibers over a finite field

The trace formula is a statement about compactly supported cohomology after
extension from `F_q` to its algebraic closure.  The following definitions
make that base change explicit.  In particular, later Frobenius complexes
must use `GeometricFiber q p`, rather than the arithmetic scheme `X` itself.
-/

/-- The canonical geometric point `Spec(Fbar_q) -> Spec(F_q)`. -/
noncomputable def geometricPoint (q : ℕ) [Fact q.Prime] :
    Spec (.of (AlgebraicClosure (ZMod q))) ⟶ Spec (.of (ZMod q)) :=
  Spec.map
    (CommRingCat.ofHom (algebraMap (ZMod q) (AlgebraicClosure (ZMod q))))

/-- Base change of an `F_q`-scheme to the chosen algebraic closure. -/
noncomputable abbrev GeometricFiber
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) : Scheme.{0} :=
  pullback p (geometricPoint q)

/-- A morphism of `F_q`-schemes induces the corresponding morphism of
geometric fibers. -/
noncomputable def geometricFiberMap
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) :
    GeometricFiber q pX ⟶ GeometricFiber q pY :=
  pullback.lift
    (pullback.fst pX (geometricPoint q) ≫ f)
    (pullback.snd pX (geometricPoint q)) (by
      rw [Category.assoc, h, pullback.condition])

@[reassoc (attr := simp)]
theorem geometricFiberMap_fst
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) :
    geometricFiberMap q pX pY f h ≫
        pullback.fst pY (geometricPoint q) =
      pullback.fst pX (geometricPoint q) ≫ f := by
  unfold geometricFiberMap
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem geometricFiberMap_snd
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) :
    geometricFiberMap q pX pY f h ≫
        pullback.snd pY (geometricPoint q) =
      pullback.snd pX (geometricPoint q) := by
  unfold geometricFiberMap
  exact pullback.lift_snd _ _ _

/-- Geometric base change sends the identity to the identity. -/
theorem geometricFiberMap_id
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q))) :
    geometricFiberMap q pX pX (𝟙 X) (Category.id_comp pX) = 𝟙 _ := by
  apply pullback.hom_ext
  · simp
  · simp

/-- Geometric base change respects composition. -/
theorem geometricFiberMap_comp
    {X Y Z : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (pZ : Z ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (hf : f ≫ pY = pX) (hg : g ≫ pZ = pY) :
    geometricFiberMap q pX pY f hf ≫ geometricFiberMap q pY pZ g hg =
      geometricFiberMap q pX pZ (f ≫ g)
        (by rw [Category.assoc, hg, hf]) := by
  apply pullback.hom_ext
  · simp
  · simp

/-- Every morphism property stable under base change is inherited by the
map on geometric fibers. -/
theorem geometricFiberMap_mem
    (P : MorphismProperty Scheme.{0}) [P.IsStableUnderBaseChange]
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) (hf : P f) :
    P (geometricFiberMap q pX pY f h) := by
  unfold geometricFiberMap
  exact MorphismProperty.pullbackLift_fst_snd
    (geometricPoint q) h.symm hf

noncomputable instance geometricFiberMap_isIso
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) [IsIso f] :
    IsIso (geometricFiberMap q pX pY f h) :=
  geometricFiberMap_mem (MorphismProperty.isomorphisms Scheme.{0})
    q pX pY f h inferInstance

/-- Open compactification maps remain open after passage to `Fbar_q`. -/
theorem geometricFiberMap_isOpenImmersion
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) [IsOpenImmersion f] :
    IsOpenImmersion (geometricFiberMap q pX pY f h) := by
  exact geometricFiberMap_mem (@IsOpenImmersion) q pX pY f h inferInstance

/-- Proper compactification maps remain proper after passage to `Fbar_q`. -/
theorem geometricFiberMap_isProper
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (h : f ≫ pY = pX) [IsProper f] :
    IsProper (geometricFiberMap q pX pY f h) := by
  exact geometricFiberMap_mem (@IsProper) q pX pY f h inferInstance

/-- The open immersion in a compactification after extension to `Fbar_q`. -/
noncomputable def geometricCompactificationOpen
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (h : j ≫ pbar = pX) :
    GeometricFiber q pX ⟶ GeometricFiber q pbar :=
  geometricFiberMap q pX pbar j h

noncomputable instance geometricCompactificationOpen_isOpenImmersion
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (h : j ≫ pbar = pX) [IsOpenImmersion j] :
    IsOpenImmersion (geometricCompactificationOpen q pX j pbar h) :=
  geometricFiberMap_isOpenImmersion q pX pbar j h

/-- The proper structure morphism of the base-changed compactification. -/
noncomputable def geometricCompactificationProjection
    {Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pbar : Xbar ⟶ Spec (.of (ZMod q))) :
    GeometricFiber q pbar ⟶ Spec (.of (AlgebraicClosure (ZMod q))) :=
  pullback.snd pbar (geometricPoint q)

noncomputable instance geometricCompactificationProjection_isProper
    {Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pbar : Xbar ⟶ Spec (.of (ZMod q))) [IsProper pbar] :
    IsProper (geometricCompactificationProjection q pbar) := by
  unfold geometricCompactificationProjection
  infer_instance

/-- An equivariant square over `F_q` remains equivariant after passage to
the geometric fibers. -/
theorem geometricCompactificationOpen_equivariant
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX)
    (f : X ⟶ X) (hf : f ≫ pX = pX)
    (fbar : Xbar ⟶ Xbar) (hfbar : fbar ≫ pbar = pbar)
    (hbar : f ≫ j = j ≫ fbar) :
    geometricFiberMap q pX pX f hf ≫
        geometricCompactificationOpen q pX j pbar hj =
      geometricCompactificationOpen q pX j pbar hj ≫
        geometricFiberMap q pbar pbar fbar hfbar := by
  unfold geometricCompactificationOpen
  rw [geometricFiberMap_comp, geometricFiberMap_comp]
  congr 1

/-! Besides base-changing morphisms of `F_q`-schemes, geometric Frobenius
requires the semilinear action induced by an automorphism of the chosen
algebraic closure. -/

/-- An automorphism of the geometric base over `F_q` acts on every geometric
fiber, leaving the arithmetic coordinate unchanged. -/
noncomputable def geometricFiberBaseMap
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) :
    GeometricFiber q p ⟶ GeometricFiber q p :=
  pullback.lift
    (pullback.fst p (geometricPoint q))
    (pullback.snd p (geometricPoint q) ≫ b) (by
      rw [Category.assoc, hb, pullback.condition])

@[reassoc (attr := simp)]
theorem geometricFiberBaseMap_fst
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) :
    geometricFiberBaseMap q p b hb ≫
      pullback.fst p (geometricPoint q) =
        pullback.fst p (geometricPoint q) :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem geometricFiberBaseMap_snd
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) :
    geometricFiberBaseMap q p b hb ≫
      pullback.snd p (geometricPoint q) =
        pullback.snd p (geometricPoint q) ≫ b :=
  pullback.lift_snd _ _ _

/-- The identity of the geometric base acts trivially on every geometric
fiber. -/
theorem geometricFiberBaseMap_id
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    geometricFiberBaseMap q p (𝟙 _) (Category.id_comp _) = 𝟙 _ := by
  apply pullback.hom_ext
  · simp
  · simp

/-- The semilinear base actions compose in the same order as the base
automorphisms. -/
theorem geometricFiberBaseMap_comp
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b c : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q)
    (hc : c ≫ geometricPoint q = geometricPoint q) :
    geometricFiberBaseMap q p b hb ≫ geometricFiberBaseMap q p c hc =
      geometricFiberBaseMap q p (b ≫ c) (by
        rw [Category.assoc, hc, hb]) := by
  apply pullback.hom_ext
  · simp
  · simp

/-- Changing the geometric base commutes with every morphism defined over
`F_q`.  This is the scheme-level commutation relation between arithmetic
Galois Frobenius and the coordinate-permutation actions used below. -/
theorem geometricFiberBaseMap_naturality
    {X Y : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ Y) (hf : f ≫ pY = pX)
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) :
    geometricFiberBaseMap q pX b hb ≫
        geometricFiberMap q pX pY f hf =
      geometricFiberMap q pX pY f hf ≫
        geometricFiberBaseMap q pY b hb := by
  apply pullback.hom_ext
  · simp
  · simp

noncomputable instance geometricFiberBaseMap_isIso
    {X : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) [IsIso b] :
    IsIso (geometricFiberBaseMap q p b hb) := by
  let binv := inv b
  have hbinv : binv ≫ geometricPoint q = geometricPoint q := by
    apply (cancel_epi b).1
    rw [← Category.assoc, IsIso.hom_inv_id, Category.id_comp, hb]
  refine ⟨⟨geometricFiberBaseMap q p binv hbinv, ?_, ?_⟩⟩
  · apply pullback.hom_ext
    · simp
    · rw [Category.id_comp, Category.assoc,
        geometricFiberBaseMap_snd, ← Category.assoc,
        geometricFiberBaseMap_snd, Category.assoc,
        IsIso.hom_inv_id, Category.comp_id]
  · apply pullback.hom_ext
    · simp
    · rw [Category.id_comp, Category.assoc,
        geometricFiberBaseMap_snd, ← Category.assoc,
        geometricFiberBaseMap_snd, Category.assoc,
        IsIso.inv_hom_id, Category.comp_id]

/-- An automorphism of the geometric base acts on relative geometric
points by acting on the fiber and then transporting the source back along
the inverse base automorphism.  The transport is essential: postcomposition
with `geometricFiberBaseMap` alone is no longer a point over the identity of
`Spec(Fbar_q)`. -/
noncomputable def geometricRelativePointBaseAction
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) [IsIso b] :
    {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ GeometricFiber q p //
        y ≫ pullback.snd p (geometricPoint q) = 𝟙 _} →
      {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ GeometricFiber q p //
        y ≫ pullback.snd p (geometricPoint q) = 𝟙 _} :=
  fun y => ⟨inv b ≫ y.1 ≫ geometricFiberBaseMap q p b hb, by
    calc
      (inv b ≫ y.1 ≫ geometricFiberBaseMap q p b hb) ≫
          pullback.snd p (geometricPoint q) =
        inv b ≫ (y.1 ≫ pullback.snd p (geometricPoint q)) ≫ b := by simp
      _ = inv b ≫ 𝟙 _ ≫ b := by rw [y.2]
      _ = 𝟙 _ := by simp⟩

/-- Semilinear action on relative geometric points obtained by combining a
map defined over `F_q` with an automorphism of the geometric base. -/
noncomputable def geometricRelativePointSemilinearAction
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p)
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) [IsIso b] :
    {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ GeometricFiber q p //
        y ≫ pullback.snd p (geometricPoint q) = 𝟙 _} →
      {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ GeometricFiber q p //
        y ≫ pullback.snd p (geometricPoint q) = 𝟙 _} :=
  fun y => ⟨inv b ≫ y.1 ≫ geometricFiberMap q p p f hf ≫
      geometricFiberBaseMap q p b hb, by
    calc
      (inv b ≫ y.1 ≫ geometricFiberMap q p p f hf ≫
          geometricFiberBaseMap q p b hb) ≫
          pullback.snd p (geometricPoint q) =
        inv b ≫ (y.1 ≫ pullback.snd p (geometricPoint q)) ≫ b := by simp
      _ = inv b ≫ 𝟙 _ ≫ b := by rw [y.2]
      _ = 𝟙 _ := by simp⟩

/-- The geometric compactification square is equivariant for every
automorphism of the algebraically closed base. -/
theorem geometricCompactificationOpen_base_equivariant
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX)
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ geometricPoint q = geometricPoint q) :
    geometricFiberBaseMap q pX b hb ≫
        geometricCompactificationOpen q pX j pbar hj =
      geometricCompactificationOpen q pX j pbar hj ≫
        geometricFiberBaseMap q pbar b hb := by
  unfold geometricCompactificationOpen geometricFiberMap
  have hcart :
      (pullback.fst pX (geometricPoint q) ≫ j) ≫ pbar =
        pullback.snd pX (geometricPoint q) ≫ geometricPoint q := by
    rw [Category.assoc, hj, pullback.condition]
  apply pullback.hom_ext
  · calc
      (geometricFiberBaseMap q pX b hb ≫
          pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
            (pullback.snd pX (geometricPoint q)) hcart) ≫
            pullback.fst pbar (geometricPoint q) =
          geometricFiberBaseMap q pX b hb ≫
            (pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
                pullback.fst pbar (geometricPoint q)) :=
        Category.assoc _ _ _
      _ = geometricFiberBaseMap q pX b hb ≫
            (pullback.fst pX (geometricPoint q) ≫ j) := by
        rw [pullback.lift_fst]
      _ = (geometricFiberBaseMap q pX b hb ≫
            pullback.fst pX (geometricPoint q)) ≫ j :=
        (Category.assoc _ _ _).symm
      _ = pullback.fst pX (geometricPoint q) ≫ j := by
        rw [geometricFiberBaseMap_fst]
      _ = pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
            (pullback.snd pX (geometricPoint q)) hcart ≫
              pullback.fst pbar (geometricPoint q) :=
        (pullback.lift_fst _ _ _).symm
      _ = pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            (geometricFiberBaseMap q pbar b hb ≫
              pullback.fst pbar (geometricPoint q)) := by
        rw [geometricFiberBaseMap_fst]
      _ = (pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            geometricFiberBaseMap q pbar b hb) ≫
              pullback.fst pbar (geometricPoint q) :=
        (Category.assoc _ _ _).symm
  · calc
      (geometricFiberBaseMap q pX b hb ≫
          pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
            (pullback.snd pX (geometricPoint q)) hcart) ≫
            pullback.snd pbar (geometricPoint q) =
          geometricFiberBaseMap q pX b hb ≫
            (pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
                pullback.snd pbar (geometricPoint q)) :=
        Category.assoc _ _ _
      _ = geometricFiberBaseMap q pX b hb ≫
            pullback.snd pX (geometricPoint q) := by rw [pullback.lift_snd]
      _ = pullback.snd pX (geometricPoint q) ≫ b := by
        rw [geometricFiberBaseMap_snd]
      _ = (pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            pullback.snd pbar (geometricPoint q)) ≫ b := by
        rw [pullback.lift_snd]
      _ = pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            (pullback.snd pbar (geometricPoint q) ≫ b) :=
        Category.assoc _ _ _
      _ = pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            (geometricFiberBaseMap q pbar b hb ≫
              pullback.snd pbar (geometricPoint q)) := by
        rw [geometricFiberBaseMap_snd]
      _ = (pullback.lift (pullback.fst pX (geometricPoint q) ≫ j)
              (pullback.snd pX (geometricPoint q)) hcart ≫
            geometricFiberBaseMap q pbar b hb) ≫
              pullback.snd pbar (geometricPoint q) :=
        (Category.assoc _ _ _).symm

/-! ### Equivariant extension by zero

For an automorphism of an open scheme which extends to an automorphism of a
compactification, the geometric pullback action commutes with `j_!`.  The
construction below proves this Beck--Chevalley comparison from the explicit
small pro-étale site functors and uniqueness of adjoints. -/

/-- Pullback along the inverse of an isomorphism agrees with postcomposition
by the original isomorphism on the weakly-étale over category. -/
noncomputable def rawBaseChangeInvIsoMap
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    rawBaseChange (inv f) ≅
      MorphismProperty.Over.map
        (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (⊤ : MorphismProperty Scheme.{u})
        (show WeaklyEtale f from inferInstance) := by
  refine NatIso.ofComponents (fun U ↦ ?_) ?_
  · let e : pullback U.hom (inv f) ≅ U.left := {
      hom := pullback.fst U.hom (inv f)
      inv := pullback.lift (𝟙 _) (U.hom ≫ f) (by simp)
      hom_inv_id := by
        apply pullback.hom_ext
        · rw [Category.assoc, pullback.lift_fst, Category.comp_id,
            Category.id_comp]
        · simp only [Category.assoc, pullback.lift_snd]
          rw [← Category.assoc, pullback.condition]
          simp
      inv_hom_id := pullback.lift_fst _ _ _ }
    exact MorphismProperty.Over.isoMk e (by
      change pullback.fst U.hom (inv f) ≫ U.hom ≫ f =
        pullback.snd U.hom (inv f)
      rw [← Category.assoc, pullback.condition]
      simp)
  · intro U V h
    apply MorphismProperty.Over.Hom.ext
    change ((rawBaseChange (inv f)).map h).left ≫
        pullback.fst V.hom (inv f) =
      pullback.fst U.hom (inv f) ≫ h.left
    exact pullback.lift_fst _ _ _

/-- On the raw weakly-étale over categories, an equivariant square with
vertical isomorphisms gives the expected base-change comparison. -/
noncomputable def rawEquivariantBaseChange
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    MorphismProperty.Over.map
          (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤
          (show WeaklyEtale j from inferInstance) ⋙
        rawBaseChange (inv fbar) ≅
      rawBaseChange (inv f) ⋙
        MorphismProperty.Over.map
          (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) ⊤
          (show WeaklyEtale j from inferInstance) := by
  let hj : WeaklyEtale j := inferInstance
  let hf : WeaklyEtale f := inferInstance
  let hfbar : WeaklyEtale fbar := inferInstance
  exact
    Functor.isoWhiskerLeft (MorphismProperty.Over.map ⊤ hj)
        (rawBaseChangeInvIsoMap fbar) ≪≫
      (MorphismProperty.Over.mapComp ⊤ hj hfbar).symm ≪≫
      MorphismProperty.Over.mapCongr ⊤ h.symm
        (show WeaklyEtale (j ≫ fbar) from inferInstance) ≪≫
      MorphismProperty.Over.mapComp ⊤ hf hj ≪≫
      Functor.isoWhiskerRight (rawBaseChangeInvIsoMap f).symm
        (MorphismProperty.Over.map ⊤ hj)

/-- The equivariant-square comparison on the actual small pro-étale sites. -/
noncomputable def equivariantBaseChange
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    map j ⋙ baseChange (inv fbar) ≅
      baseChange (inv f) ⋙ map j := by
  unfold map baseChange proEtToRaw rawToProEt
  exact rawEquivariantBaseChange j f fbar h

attribute [local instance] rawCategory

/-- A composition comparison with an explicit chosen composite.  Keeping the
composite as data avoids dependent transports when the inverse of a composite
is rewritten. -/
noncomputable def rawBaseChangeCompOfEq {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (fg : X ⟶ Z) (hfg : fg = f ≫ g) :
    rawBaseChange fg ≅ rawBaseChange g ⋙ rawBaseChange f := by
  letI : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  letI : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  exact MorphismProperty.Over.pullbackComp f g fg hfg

noncomputable def baseChangeCompOfEq {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (fg : X ⟶ Z) (hfg : fg = f ≫ g) :
    baseChange fg ≅ baseChange g ⋙ baseChange f := by
  unfold baseChange
  exact ((Functor.whiskeringLeft _ _ _).obj (proEtToRaw Z)).mapIso
    (((Functor.whiskeringRight _ _ _).obj (rawToProEt X)).mapIso
      (rawBaseChangeCompOfEq f g fg hfg))

theorem rawBaseChangeCompOfEq_hom_app_left_fst_fst
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (fg : X ⟶ Z) (hfg : fg = f ≫ g) (U : Raw Z) :
    ((rawBaseChangeCompOfEq f g fg hfg).hom.app U).left ≫
        Limits.pullback.fst (Limits.pullback.snd U.hom g) f ≫
          Limits.pullback.fst U.hom g =
      Limits.pullback.fst U.hom fg := by
  let : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  let : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb h ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb h⟩
  subst fg
  exact MorphismProperty.Over.pullbackComp_left_fst_fst f g U

theorem baseChangeCompOfEq_hom_app_left_fst_fst
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (fg : X ⟶ Z) (hfg : fg = f ≫ g) (U : Z.ProEt) :
    ((baseChangeCompOfEq f g fg hfg).hom.app U).left ≫
        Limits.pullback.fst (Limits.pullback.snd U.hom g) f ≫
          Limits.pullback.fst U.hom g =
      Limits.pullback.fst U.hom fg := by
  exact rawBaseChangeCompOfEq_hom_app_left_fst_fst f g fg hfg
    ((proEtToRaw Z).obj U)

theorem baseChangeCompOfEq_inv_app_left_fst
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (fg : X ⟶ Z) (hfg : fg = f ≫ g) (U : Z.ProEt) :
    ((baseChangeCompOfEq f g fg hfg).inv.app U).left ≫
        Limits.pullback.fst U.hom fg =
      Limits.pullback.fst (Limits.pullback.snd U.hom g) f ≫
        Limits.pullback.fst U.hom g := by
  have he := baseChangeCompOfEq_hom_app_left_fst_fst f g fg hfg U
  rw [← he, ← Category.assoc]
  have hi := (baseChangeCompOfEq f g fg hfg).inv_hom_id_app U
  have hil := congrArg (fun k => k.left) hi
  change ((baseChangeCompOfEq f g fg hfg).inv.app U).left ≫
      ((baseChangeCompOfEq f g fg hfg).hom.app U).left = 𝟙 _ at hil
  rw [hil]
  exact Category.id_comp _

@[reassoc]
theorem baseChange_map_left_fst
    {X Y : Scheme.{u}} (f : X ⟶ Y) {A B : Y.ProEt} (k : A ⟶ B) :
    ((baseChange f).map k).left ≫ Limits.pullback.fst B.hom f =
      Limits.pullback.fst A.hom f ≫ k.left := by
  change Limits.pullback.lift
      (Limits.pullback.fst A.hom f ≫ k.left)
      (Limits.pullback.snd A.hom f) _ ≫
        Limits.pullback.fst B.hom f = _
  exact Limits.pullback.lift_fst _ _ _

noncomputable def baseChangeCompInv
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChange (inv (f ≫ g)) ≅
      baseChange (inv f) ⋙ baseChange (inv g) :=
  baseChangeCompOfEq (inv g) (inv f) (inv (f ≫ g)) IsIso.inv_comp

/-- A chosen-composite base-change comparison transported after renaming
both factors and their composite.  Packaging all three transports together
makes the coherence independent of the particular equality proofs. -/
noncomputable def baseChangeCompOfEqRenamed
    {X Y Z : Scheme.{u}}
    (f f' : X ⟶ Y) (g g' : Y ⟶ Z) (fg : X ⟶ Z)
    (hf : f' = f) (hg : g' = g) (hfg : fg = f' ≫ g') :
    baseChange (f ≫ g) ≅ baseChange g ⋙ baseChange f := by
  simpa only [hf, hg, hfg] using
    baseChangeCompOfEq f' g' fg hfg

theorem baseChangeCompOfEqRenamed_eq
    {X Y Z : Scheme.{u}}
    (f f' : X ⟶ Y) (g g' : Y ⟶ Z) (fg : X ⟶ Z)
    (hf : f' = f) (hg : g' = g) (hfg : fg = f' ≫ g') :
    baseChangeCompOfEqRenamed f f' g g' fg hf hg hfg =
      baseChangeComp f g := by
  subst f'
  subst g'
  subst fg
  rfl

/-- Applying the inverse-composite comparison to the inverses of two
isomorphisms recovers the ordinary composition comparison. -/
noncomputable def baseChangeCompInvInvNormalized
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChange (f ≫ g) ≅ baseChange g ⋙ baseChange f := by
  simpa only [IsIso.inv_comp, IsIso.inv_inv] using
    baseChangeCompInv (inv g) (inv f)

theorem baseChangeCompInvInvNormalized_eq
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChangeCompInvInvNormalized f g = baseChangeComp f g := by
  let hf : inv (inv f) = f := by simp only [IsIso.inv_inv]
  let hg : inv (inv g) = g := by simp only [IsIso.inv_inv]
  let hfg : inv (inv g ≫ inv f) =
      inv (inv f) ≫ inv (inv g) := IsIso.inv_comp
  have hnorm := baseChangeCompOfEqRenamed_eq
    f (inv (inv f)) g (inv (inv g))
    (inv (inv g ≫ inv f)) hf hg hfg
  unfold baseChangeCompInvInvNormalized
  change (
    (by simpa only [hf, hg, hfg] using
      (baseChangeCompOfEq (inv (inv f)) (inv (inv g))
        (inv (inv g ≫ inv f)) hfg))) = baseChangeComp f g
  exact hnorm

theorem baseChangeCompOfEq_inv_app_left_snd
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (fg : X ⟶ Z) (hfg : fg = f ≫ g) (U : Z.ProEt) :
    ((baseChangeCompOfEq f g fg hfg).inv.app U).left ≫
        Limits.pullback.snd U.hom fg =
      Limits.pullback.snd (Limits.pullback.snd U.hom g) f := by
  exact MorphismProperty.Over.w
    ((baseChangeCompOfEq f g fg hfg).inv.app U)

theorem map_baseChangeCompInv_inv_app_left_fst
    {X W : Scheme.{u}} (j : X ⟶ W) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g] (U : X.ProEt) :
    ((map j).map ((baseChangeCompInv f g).inv.app U)).left ≫
        Limits.pullback.fst U.hom (inv (f ≫ g)) =
      Limits.pullback.fst (Limits.pullback.snd U.hom (inv f)) (inv g) ≫
        Limits.pullback.fst U.hom (inv f) := by
  exact baseChangeCompOfEq_inv_app_left_fst
    (inv g) (inv f) (inv (f ≫ g)) IsIso.inv_comp U

theorem map_baseChangeCompInv_inv_app_left_snd
    {X W : Scheme.{u}} (j : X ⟶ W) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g] (U : X.ProEt) :
    ((map j).map ((baseChangeCompInv f g).inv.app U)).left ≫
        Limits.pullback.snd U.hom (inv (f ≫ g)) =
      Limits.pullback.snd
        (Limits.pullback.snd U.hom (inv f)) (inv g) := by
  exact baseChangeCompOfEq_inv_app_left_snd
    (inv g) (inv f) (inv (f ≫ g)) IsIso.inv_comp U

@[reassoc]
theorem equivariantBaseChange_hom_app_left_fst
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (U : X.ProEt) :
    ((equivariantBaseChange j f fbar h).hom.app U).left ≫
        Limits.pullback.fst U.hom (inv f) =
      Limits.pullback.fst (U.hom ≫ j) (inv fbar) := by
  change (Limits.pullback.fst (U.hom ≫ j) (inv fbar) ≫
      Limits.pullback.lift (𝟙 U.left) (U.hom ≫ f) _) ≫
        Limits.pullback.fst U.hom (inv f) = _
  rw [Category.assoc, Limits.pullback.lift_fst]
  exact Category.comp_id _

@[reassoc]
theorem equivariantBaseChange_hom_app_left_snd
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (U : X.ProEt) :
    ((equivariantBaseChange j f fbar h).hom.app U).left ≫
        Limits.pullback.snd U.hom (inv f) =
      Limits.pullback.fst (U.hom ≫ j) (inv fbar) ≫ U.hom ≫ f := by
  change (Limits.pullback.fst (U.hom ≫ j) (inv fbar) ≫
      Limits.pullback.lift (𝟙 U.left) (U.hom ≫ f) _) ≫
        Limits.pullback.snd U.hom (inv f) = _
  rw [Category.assoc, Limits.pullback.lift_snd]

theorem equivariantBaseChange_after_baseChange_hom_app_left_fst_assoc
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (gbar : Xbar ⟶ Xbar) [IsIso gbar]
    (hg : g ≫ j = j ≫ gbar) (U : X.ProEt) :
    ((equivariantBaseChange j g gbar hg).hom.app
        ((baseChange (inv f)).obj U)).left ≫
      Limits.pullback.fst (Limits.pullback.snd U.hom (inv f)) (inv g) ≫
      Limits.pullback.fst U.hom (inv f) =
    Limits.pullback.fst
        (Limits.pullback.snd U.hom (inv f) ≫ j) (inv gbar) ≫
      Limits.pullback.fst U.hom (inv f) := by
  exact equivariantBaseChange_hom_app_left_fst_assoc j g gbar hg
    ((baseChange (inv f)).obj U) (Limits.pullback.fst U.hom (inv f))

noncomputable def equivariantBaseChangeIteratedActual
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    map j ⋙ baseChange (inv (fbar ≫ gbar)) ≅
      baseChange (inv (f ≫ g)) ⋙ map j :=
  Functor.isoWhiskerLeft (map j) (baseChangeCompInv fbar gbar) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (equivariantBaseChange j f fbar hf)
      (baseChange (inv gbar)) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (baseChange (inv f))
      (equivariantBaseChange j g gbar hg) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (baseChangeCompInv f g).symm (map j)

theorem equivariantBaseChangeIteratedActual_hom_app_left_fst
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (U : X.ProEt) :
    ((equivariantBaseChangeIteratedActual j f g fbar gbar hf hg).hom.app U).left ≫
        Limits.pullback.fst U.hom (inv (f ≫ g)) =
      Limits.pullback.fst (U.hom ≫ j) (inv (fbar ≫ gbar)) := by
  unfold equivariantBaseChangeIteratedActual
  simp only [Functor.comp_obj, Functor.id_obj, Iso.trans_hom, Functor.isoWhiskerLeft_hom, Iso.symm_hom,
    Functor.isoWhiskerRight_hom, NatTrans.comp_app, Functor.whiskerLeft_app, Functor.associator_inv_app,
    Functor.whiskerRight_app, Functor.associator_hom_app, Category.id_comp, Functor.const_obj_obj]
  change
    ((baseChangeCompOfEq (inv gbar) (inv fbar)
          (inv (fbar ≫ gbar)) IsIso.inv_comp).hom.app ((map j).obj U)).left ≫
      ((baseChange (inv gbar)).map
          ((equivariantBaseChange j f fbar hf).hom.app U)).left ≫
      ((equivariantBaseChange j g gbar hg).hom.app
          ((baseChange (inv f)).obj U)).left ≫
      ((map j).map ((baseChangeCompInv f g).inv.app U)).left ≫
      Limits.pullback.fst U.hom (inv (f ≫ g)) = _
  slice_lhs 4 5 =>
    rw [map_baseChangeCompInv_inv_app_left_fst]
  slice_lhs 3 5 =>
    exact equivariantBaseChange_after_baseChange_hom_app_left_fst_assoc
      j f g gbar hg U
  slice_lhs 2 4 =>
    exact baseChange_map_left_fst_assoc (inv gbar)
      ((equivariantBaseChange j f fbar hf).hom.app U)
      (Limits.pullback.fst U.hom (inv f))
  let H := Limits.pullback.fst
    ((map j ⋙ baseChange (inv fbar)).obj U).hom (inv gbar)
  have hEf := equivariantBaseChange_hom_app_left_fst j f fbar hf U
  slice_lhs 2 3 =>
    exact (Category.assoc H
      ((equivariantBaseChange j f fbar hf).hom.app U).left
      (Limits.pullback.fst U.hom (inv f))).trans
        (congrArg (fun k => H ≫ k) hEf)
  exact baseChangeCompOfEq_hom_app_left_fst_fst
    (inv gbar) (inv fbar) (inv (fbar ≫ gbar)) IsIso.inv_comp ((map j).obj U)

theorem equivariantBaseChangeIteratedActual_hom_app_left_snd
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (U : X.ProEt) :
    ((equivariantBaseChangeIteratedActual j f g fbar gbar hf hg).hom.app U).left ≫
        Limits.pullback.snd U.hom (inv (f ≫ g)) =
      Limits.pullback.fst (U.hom ≫ j) (inv (fbar ≫ gbar)) ≫
        U.hom ≫ f ≫ g := by
  unfold equivariantBaseChangeIteratedActual
  simp only [Functor.comp_obj, Iso.trans_hom, Functor.isoWhiskerLeft_hom, Iso.symm_hom,
    Functor.isoWhiskerRight_hom, NatTrans.comp_app, Functor.whiskerLeft_app, Functor.associator_inv_app,
    Functor.whiskerRight_app, Functor.associator_hom_app, Category.id_comp, Functor.id_obj, Functor.const_obj_obj]
  change
    ((baseChangeCompOfEq (inv gbar) (inv fbar)
          (inv (fbar ≫ gbar)) IsIso.inv_comp).hom.app ((map j).obj U)).left ≫
      ((baseChange (inv gbar)).map
          ((equivariantBaseChange j f fbar hf).hom.app U)).left ≫
      ((equivariantBaseChange j g gbar hg).hom.app
          ((baseChange (inv f)).obj U)).left ≫
      ((map j).map ((baseChangeCompInv f g).inv.app U)).left ≫
      Limits.pullback.snd U.hom (inv (f ≫ g)) = _
  slice_lhs 4 5 =>
    rw [map_baseChangeCompInv_inv_app_left_snd]
  slice_lhs 3 4 =>
    exact equivariantBaseChange_hom_app_left_snd j g gbar hg
      ((baseChange (inv f)).obj U)
  slice_lhs 2 4 =>
    exact baseChange_map_left_fst_assoc (inv gbar)
      ((equivariantBaseChange j f fbar hf).hom.app U)
      (((baseChange (inv f)).obj U).hom ≫ g)
  let H := Limits.pullback.fst
    ((map j ⋙ baseChange (inv fbar)).obj U).hom (inv gbar)
  let E := ((equivariantBaseChange j f fbar hf).hom.app U).left
  have hEf := equivariantBaseChange_hom_app_left_snd j f fbar hf U
  let S := Limits.pullback.snd U.hom (inv f)
  let F := Limits.pullback.fst (U.hom ≫ j) (inv fbar)
  let P := U.hom
  let R := P ≫ f
  change E ≫ S = F ≫ R at hEf
  let C := ((baseChangeCompOfEq (inv gbar) (inv fbar)
    (inv (fbar ≫ gbar)) IsIso.inv_comp).hom.app ((map j).obj U)).left
  let D := Limits.pullback.fst (U.hom ≫ j) (inv (fbar ≫ gbar))
  change
    C ≫ ((H ≫ E) ≫ (S ≫ g)) = D ≫ (P ≫ (f ≫ g))
  have hESg : E ≫ (S ≫ g) = (F ≫ R) ≫ g :=
    (Category.assoc E S g).symm.trans
      (congrArg (fun k => k ≫ g) hEf)
  have htail :
      (H ≫ E) ≫ (S ≫ g) = (H ≫ F) ≫ (R ≫ g) :=
    (Category.assoc H E (S ≫ g)).trans
      ((congrArg (fun k => H ≫ k) hESg).trans
        ((congrArg (fun k => H ≫ k) (Category.assoc F R g)).trans
          (Category.assoc H F (R ≫ g)).symm))
  have hcomp := baseChangeCompOfEq_hom_app_left_fst_fst
    (inv gbar) (inv fbar) (inv (fbar ≫ gbar)) IsIso.inv_comp
    ((map j).obj U)
  change C ≫ (H ≫ F) = D at hcomp
  have hwhole :
      C ≫ ((H ≫ E) ≫ (S ≫ g)) = D ≫ (R ≫ g) :=
    (congrArg (fun k => C ≫ k) htail).trans
      ((Category.assoc C (H ≫ F) (R ≫ g)).symm.trans
        (congrArg (fun k => k ≫ (R ≫ g)) hcomp))
  exact hwhole.trans (congrArg (fun k => D ≫ k) (Category.assoc P f g))

theorem equivariantBaseChange_hom_comp_actual
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    (equivariantBaseChange j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])).hom =
      (equivariantBaseChangeIteratedActual j f g fbar gbar hf hg).hom := by
  ext U
  apply MorphismProperty.Over.Hom.ext
  apply Limits.pullback.hom_ext
  · exact (equivariantBaseChange_hom_app_left_fst j (f ≫ g)
      (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) U).trans
        (equivariantBaseChangeIteratedActual_hom_app_left_fst
          j f g fbar gbar hf hg U).symm
  · exact (equivariantBaseChange_hom_app_left_snd j (f ≫ g)
      (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) U).trans
        (equivariantBaseChangeIteratedActual_hom_app_left_snd
          j f g fbar gbar hf hg U).symm

/-- Base change along an isomorphism is left adjoint to base change along
its inverse. -/
noncomputable def baseChangeAdjunctionOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChange f ⊣ baseChange (inv f) :=
  (baseChangeEquivalenceOfIso f).toAdjunction.ofNatIsoRight
    (baseChangeEquivalenceInverseIso f)

/-- The corresponding adjunction on abelian sheaves. -/
noncomputable def baseChangeSheafAdjunctionOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChangeSheafPushforward f ⊣
      baseChangeSheafPushforward (inv f) := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  letI : (baseChange (inv f)).IsContinuous (topology X) (topology Y) :=
    baseChange_isContinuous (inv f)
  exact (baseChangeAdjunctionOfIso f).sheafPushforwardContinuous
    (topology Y) (topology X)

/-- On actual small pro-étale sites, pullback by the inverse of an
isomorphism is postcomposition by that isomorphism. -/
noncomputable def baseChangeInvIsoMap
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    baseChange (inv f) ≅ map f := by
  unfold baseChange map proEtToRaw rawToProEt
  exact rawBaseChangeInvIsoMap f

/-- The right adjoints defining transport and lower shriek along an
isomorphism agree. -/
noncomputable def lowerShriekRightAdjointIsoOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    (map f).sheafPushforwardContinuous Ab.{u + 1}
        (topology X) (topology Y) ≅
      baseChangeSheafPushforward (inv f) := by
  letI : (baseChange (inv f)).IsContinuous (topology X) (topology Y) :=
    baseChange_isContinuous (inv f)
  exact (Functor.sheafPushforwardContinuousIso
    (baseChangeInvIsoMap f) Ab.{u + 1}
      (topology X) (topology Y)).symm

/-- Extension by zero along an isomorphism is the usual transport of
sheaves across that isomorphism. -/
noncomputable def lowerShriekIsoBaseChangeOfIso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    lowerShriek f ≅ baseChangeSheafPushforward f := by
  exact Adjunction.leftAdjointUniq
    ((lowerShriekAdjunction f).ofNatIsoRight
      (lowerShriekRightAdjointIsoOfIso f))
    (baseChangeSheafAdjunctionOfIso f)

/-- The right-adjoint side of equivariant base change, obtained by
precomposition on sheaves. -/
noncomputable def equivariantBaseChangeRightAdjointIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    baseChangeSheafPushforward (inv fbar) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ≅
      (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (inv f) := by
  letI : (baseChange (inv fbar)).IsContinuous
      (topology Xbar) (topology Xbar) :=
    baseChange_isContinuous (inv fbar)
  letI : (baseChange (inv f)).IsContinuous
      (topology X) (topology X) :=
    baseChange_isContinuous (inv f)
  letI : (map j).IsContinuous (topology X) (topology Xbar) :=
    map_isContinuous j
  letI : (map j ⋙ baseChange (inv fbar)).IsContinuous
      (topology X) (topology Xbar) :=
    Functor.isContinuous_comp (map j) (baseChange (inv fbar))
      (topology X) (topology Xbar) (topology Xbar)
  letI : (baseChange (inv f) ⋙ map j).IsContinuous
      (topology X) (topology Xbar) :=
    Functor.isContinuous_comp (baseChange (inv f)) (map j)
      (topology X) (topology X) (topology Xbar)
  exact
    Functor.sheafPushforwardContinuousComp
        (map j) (baseChange (inv fbar)) Ab.{u + 1}
        (topology X) (topology Xbar) (topology Xbar) ≪≫
      Functor.sheafPushforwardContinuousIso
        (equivariantBaseChange j f fbar h) Ab.{u + 1}
        (topology X) (topology Xbar) ≪≫
      (Functor.sheafPushforwardContinuousComp
        (baseChange (inv f)) (map j) Ab.{u + 1}
        (topology X) (topology X) (topology Xbar)).symm

/-- The right-adjoint comparison for a composite equivariant square, with
the inverse of each composite rewritten in reverse order. -/
noncomputable def equivariantBaseChangeRightAdjointIsoCompNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    baseChangeSheafPushforward (inv gbar ≫ inv fbar) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ≅
      (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (inv g ≫ inv f) := by
  simpa only [← IsIso.inv_comp] using
    equivariantBaseChangeRightAdjointIso
      j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])

/-- The same composite comparison obtained by applying the two equivariant
squares successively and inserting the canonical base-change associators. -/
noncomputable def equivariantBaseChangeRightAdjointIsoIterated
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    baseChangeSheafPushforward (inv gbar ≫ inv fbar) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ≅
      (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (inv g ≫ inv f) := by
  let R := (map j).sheafPushforwardContinuous Ab.{u + 1}
    (topology X) (topology Xbar)
  exact Functor.isoWhiskerRight
          (baseChangeSheafPushforwardComp (inv gbar) (inv fbar)).symm R ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft (baseChangeSheafPushforward (inv gbar))
          (equivariantBaseChangeRightAdjointIso j f fbar hf) ≪≫
        (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight
          (equivariantBaseChangeRightAdjointIso j g gbar hg)
          (baseChangeSheafPushforward (inv f)) ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft R
          (baseChangeSheafPushforwardComp (inv g) (inv f))

noncomputable def baseChangeSheafPushforwardCompInv
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChangeSheafPushforward (inv (f ≫ g)) ≅
      baseChangeSheafPushforward (inv g) ⋙
        baseChangeSheafPushforward (inv f) := by
  letI : (baseChange (inv (f ≫ g))).IsContinuous
      (topology X) (topology X) :=
    baseChange_isContinuous (inv (f ≫ g))
  letI : (baseChange (inv f)).IsContinuous
      (topology X) (topology X) :=
    baseChange_isContinuous (inv f)
  letI : (baseChange (inv g)).IsContinuous
      (topology X) (topology X) :=
    baseChange_isContinuous (inv g)
  letI : (baseChange (inv f) ⋙ baseChange (inv g)).IsContinuous
      (topology X) (topology X) :=
    Functor.isContinuous_comp (baseChange (inv f)) (baseChange (inv g))
      (topology X) (topology X) (topology X)
  exact Functor.sheafPushforwardContinuousIso
      (baseChangeCompInv f g) Ab.{u + 1} (topology X) (topology X) ≪≫
    (Functor.sheafPushforwardContinuousComp
      (baseChange (inv f)) (baseChange (inv g)) Ab.{u + 1}
      (topology X) (topology X) (topology X)).symm

/-- The composition comparison for forward pullback on sheaves, chosen as
the mate of the already established right-adjoint comparison.  This choice
makes subsequent compact-support composition laws consequences of the
associativity calculus for adjunctions rather than of pointwise site
computations. -/
noncomputable def baseChangeSheafPullbackCompMateIso
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChangeSheafPushforward f ⋙ baseChangeSheafPushforward g ≅
      baseChangeSheafPushforward (f ≫ g) :=
  Adjunction.leftAdjointCompIso
    (baseChangeSheafAdjunctionOfIso f)
    (baseChangeSheafAdjunctionOfIso g)
    (baseChangeSheafAdjunctionOfIso (f ≫ g))
    (baseChangeSheafPushforwardCompInv f g).symm

/-- By construction, the inverse of the forward composition comparison
conjugates to the right-adjoint comparison. -/
theorem baseChangeSheafPullbackCompMateIso_conjugate_inv
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    CategoryTheory.conjugateEquiv
      ((baseChangeSheafAdjunctionOfIso f).comp
        (baseChangeSheafAdjunctionOfIso g))
      (baseChangeSheafAdjunctionOfIso (f ≫ g))
      (baseChangeSheafPullbackCompMateIso f g).inv =
        (baseChangeSheafPushforwardCompInv f g).inv := by
  exact Adjunction.conjugateEquiv_leftAdjointCompIso_inv _ _ _ _

/-- The forward direction conjugates to the forward right-adjoint
comparison.  This is the inverse statement to the preceding lemma. -/
theorem baseChangeSheafPullbackCompMateIso_conjugate_hom
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    CategoryTheory.conjugateEquiv
      (baseChangeSheafAdjunctionOfIso (f ≫ g))
      ((baseChangeSheafAdjunctionOfIso f).comp
        (baseChangeSheafAdjunctionOfIso g))
      (baseChangeSheafPullbackCompMateIso f g).hom =
        (baseChangeSheafPushforwardCompInv f g).hom := by
  apply (cancel_epi (baseChangeSheafPushforwardCompInv f g).inv).1
  rw [← baseChangeSheafPullbackCompMateIso_conjugate_inv f g]
  rw [CategoryTheory.conjugateEquiv_comp]
  simp only [Iso.hom_inv_id, CategoryTheory.conjugateEquiv_id]
  rw [baseChangeSheafPullbackCompMateIso_conjugate_inv]
  simp

/-- The sheaf-pushforward comparison associated with an explicitly chosen
composite on the underlying sites, in the orientation used for inverses. -/
noncomputable def baseChangeSheafPushforwardCompInvOfEq
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (fg : X ⟶ Z) (hfg : fg = f ≫ g) :
    baseChangeSheafPushforward fg ≅
      baseChangeSheafPushforward f ⋙ baseChangeSheafPushforward g := by
  letI : (baseChange f).IsContinuous (topology Y) (topology X) :=
    baseChange_isContinuous f
  letI : (baseChange g).IsContinuous (topology Z) (topology Y) :=
    baseChange_isContinuous g
  letI : (baseChange fg).IsContinuous (topology Z) (topology X) :=
    baseChange_isContinuous fg
  letI : (baseChange g ⋙ baseChange f).IsContinuous
      (topology Z) (topology X) :=
    Functor.isContinuous_comp (baseChange g) (baseChange f)
      (topology Z) (topology Y) (topology X)
  exact Functor.sheafPushforwardContinuousIso
      (baseChangeCompOfEq f g fg hfg) Ab.{u + 1}
      (topology Z) (topology X) ≪≫
    (Functor.sheafPushforwardContinuousComp
      (baseChange g) (baseChange f) Ab.{u + 1}
      (topology Z) (topology Y) (topology X)).symm

/-- The explicit-composite sheaf comparison transported after renaming its
two factors. -/
noncomputable def baseChangeSheafPushforwardCompInvOfEqRenamed
    {X Y Z : Scheme.{u}}
    (f f' : X ⟶ Y) (g g' : Y ⟶ Z) (fg : X ⟶ Z)
    (hf : f' = f) (hg : g' = g) (hfg : fg = f' ≫ g') :
    baseChangeSheafPushforward (f ≫ g) ≅
      baseChangeSheafPushforward f ⋙ baseChangeSheafPushforward g := by
  simpa only [hf, hg, hfg] using
    baseChangeSheafPushforwardCompInvOfEq f' g' fg hfg

theorem baseChangeSheafPushforwardCompInvOfEqRenamed_eq
    {X Y Z : Scheme.{u}}
    (f f' : X ⟶ Y) (g g' : Y ⟶ Z) (fg : X ⟶ Z)
    (hf : f' = f) (hg : g' = g) (hfg : fg = f' ≫ g') :
    baseChangeSheafPushforwardCompInvOfEqRenamed
        f f' g g' fg hf hg hfg =
      (baseChangeSheafPushforwardComp f g).symm := by
  subst f'
  subst g'
  subst fg
  rfl

/-- The inverse-composite comparison on sheaves, evaluated on inverse
automorphisms and normalized back to the original pair. -/
noncomputable def baseChangeSheafPushforwardCompInvInvNormalized
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChangeSheafPushforward (f ≫ g) ≅
      baseChangeSheafPushforward f ⋙ baseChangeSheafPushforward g := by
  simpa only [IsIso.inv_comp, IsIso.inv_inv] using
    baseChangeSheafPushforwardCompInv (inv g) (inv f)

theorem baseChangeSheafPushforwardCompInvInvNormalized_eq
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    baseChangeSheafPushforwardCompInvInvNormalized f g =
      (baseChangeSheafPushforwardComp f g).symm := by
  let hf : inv (inv f) = f := by simp only [IsIso.inv_inv]
  let hg : inv (inv g) = g := by simp only [IsIso.inv_inv]
  let hfg : inv (inv g ≫ inv f) =
      inv (inv f) ≫ inv (inv g) := IsIso.inv_comp
  have hnorm := baseChangeSheafPushforwardCompInvOfEqRenamed_eq
    f (inv (inv f)) g (inv (inv g))
    (inv (inv g ≫ inv f)) hf hg hfg
  unfold baseChangeSheafPushforwardCompInvInvNormalized
  change (
    (by simpa only [hf, hg, hfg] using
      (baseChangeSheafPushforwardCompInvOfEq
        (inv (inv f)) (inv (inv g))
        (inv (inv g ≫ inv f)) hfg))) =
      (baseChangeSheafPushforwardComp f g).symm
  exact hnorm

noncomputable def equivariantBaseChangeRightAdjointIsoIteratedActual
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    baseChangeSheafPushforward (inv (fbar ≫ gbar)) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ≅
      (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (inv (f ≫ g)) := by
  let R := (map j).sheafPushforwardContinuous Ab.{u + 1}
    (topology X) (topology Xbar)
  exact Functor.isoWhiskerRight
          (baseChangeSheafPushforwardCompInv fbar gbar) R ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft (baseChangeSheafPushforward (inv gbar))
          (equivariantBaseChangeRightAdjointIso j f fbar hf) ≪≫
        (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight
          (equivariantBaseChangeRightAdjointIso j g gbar hg)
          (baseChangeSheafPushforward (inv f)) ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft R
          (baseChangeSheafPushforwardCompInv f g).symm

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem equivariantBaseChangeRightAdjointIso_hom_comp_actual
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    (equivariantBaseChangeRightAdjointIso j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])).hom =
      (equivariantBaseChangeRightAdjointIsoIteratedActual
        j f g fbar gbar hf hg).hom := by
  let ed := equivariantBaseChange j (f ≫ g) (fbar ≫ gbar)
    (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])
  let ei := equivariantBaseChangeIteratedActual j f g fbar gbar hf hg
  have he : ed.hom = ei.hom :=
    equivariantBaseChange_hom_comp_actual j f g fbar gbar hf hg
  have heInv : ed.inv = ei.inv := (Iso.inv_eq_inv ed ei).2 he
  unfold equivariantBaseChangeRightAdjointIsoIteratedActual
    baseChangeSheafPushforwardCompInv
    equivariantBaseChangeRightAdjointIso
  ext Q U x
  simp only [Functor.comp_obj, Functor.sheafPushforwardContinuous_obj_obj_obj, Iso.trans_hom,
    Functor.sheafPushforwardContinuousIso_hom, Iso.symm_hom, NatTrans.comp_app, ObjectProperty.FullSubcategory.comp_hom,
    Functor.sheafPushforwardContinuousNatTrans_app_hom, ObjectProperty.ι_obj,
    Functor.sheafPushforwardContinuousComp_hom_app_hom_app, Functor.whiskerRight_app, Functor.op_obj, NatTrans.op_app,
    Functor.sheafPushforwardContinuousComp_inv_app_hom_app, AddCommGrpCat.hom_comp, Functor.isoWhiskerRight_trans,
    Functor.isoWhiskerLeft_trans, Iso.trans_symm, Iso.trans_assoc, Functor.isoWhiskerRight_hom,
    Functor.isoWhiskerLeft_hom, Iso.symm_inv, Functor.sheafPushforwardContinuousIso_inv, Functor.associator_hom_app,
    Functor.whiskerLeft_app, Functor.associator_inv_app, Category.id_comp,
    Functor.sheafPushforwardContinuous_map_hom_app, Functor.sheafPushforwardContinuous_obj_obj_map, Quiver.Hom.unop_op]
  let A := (Q.obj.map ((baseChangeCompInv fbar gbar).inv.app
    ((map j).obj (Opposite.unop U))).op).hom
  let B := (Q.obj.map ((baseChange (inv gbar)).map
    ((equivariantBaseChange j f fbar hf).inv.app
      (Opposite.unop U))).op).hom
  let C := (Q.obj.map ((equivariantBaseChange j g gbar hg).inv.app
    ((baseChange (inv f)).obj (Opposite.unop U))).op).hom
  let D := (Q.obj.map ((map j).map
    ((baseChangeCompInv f g).hom.app (Opposite.unop U))).op).hom
  change (Q.obj.map ((equivariantBaseChange j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])).inv.app
        (Opposite.unop U)).op).hom x =
    (((D.comp C).comp B).comp A) x
  rw [show (((D.comp C).comp B).comp A) x = D (C (B (A x))) by rfl]
  simpa [ed, ei, equivariantBaseChangeIteratedActual,
    Functor.map_comp, Functor.comp_map,
    AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
    Function.comp_apply] using congrArg (fun k =>
      (Q.obj.map (k.app (Opposite.unop U)).op).hom x) heInv

/-- Inverting both vertical automorphisms preserves an equivariant square. -/
theorem inverse_equivariant
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar)
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    inv f ≫ j = j ≫ inv fbar := by
  apply (cancel_epi f).1
  simp only [IsIso.hom_inv_id_assoc]
  rw [← Category.assoc, h, Category.assoc, IsIso.hom_inv_id,
    Category.comp_id]

/-- The forward right-adjoint square associated with an equivariant square.
It is the orientation consumed by the mates correspondence for the two
copies of `j_! ⊣ j_*`. -/
noncomputable def equivariantBaseChangeForwardRightAdjointIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward f ≅
      baseChangeSheafPushforward fbar ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) := by
  simpa only [IsIso.inv_inv] using
    (equivariantBaseChangeRightAdjointIso j (inv f) (inv fbar)
      (inverse_equivariant j f fbar h)).symm

/-- The forward right-adjoint square as the vertical mate of the inverse
right-adjoint square.  This formulation is designed for the horizontal and
vertical composition laws of `mateEquiv`. -/
noncomputable def equivariantBaseChangeForwardRightAdjoint
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward f ⟶
      baseChangeSheafPushforward fbar ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) :=
  ((CategoryTheory.mateEquiv
    (baseChangeSheafAdjunctionOfIso fbar)
    (baseChangeSheafAdjunctionOfIso f)).symm
      (.mk _ _ _ _
        (equivariantBaseChangeRightAdjointIso j f fbar h).hom)).natTrans

/-- The forward mate is an isomorphism because both vertical adjunctions
come from equivalences.  This packages the mate itself as an isomorphism,
without identifying it with a separately chosen site-level comparison. -/
noncomputable def equivariantBaseChangeForwardRightAdjointMateIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward f ≅
      baseChangeSheafPushforward fbar ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) := by
  letI : (baseChangeSheafPushforward f).IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso f
  letI : (baseChangeSheafPushforward fbar).IsEquivalence :=
    baseChangeSheafPushforward_isEquivalence_of_isIso fbar
  let alpha := equivariantBaseChangeForwardRightAdjoint j f fbar h
  haveI : IsIso alpha := by
    dsimp only [alpha]
    unfold equivariantBaseChangeForwardRightAdjoint
      CategoryTheory.mateEquiv
    dsimp
    infer_instance
  exact asIso alpha

theorem equivariantBaseChangeForwardRightAdjointMateIso_hom
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (equivariantBaseChangeForwardRightAdjointMateIso j f fbar h).hom =
      equivariantBaseChangeForwardRightAdjoint j f fbar h := by
  rfl

/-- The forward right-adjoint square for two successive equivariant
automorphisms, normalized with the mate-defined pullback composition
isomorphisms. -/
noncomputable def equivariantBaseChangeForwardRightAdjointIteratedMate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (f ≫ g) ⟶
      baseChangeSheafPushforward (fbar ≫ gbar) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) := by
  let J := (map j).sheafPushforwardContinuous Ab.{u + 1}
    (topology X) (topology Xbar)
  exact Functor.whiskerLeft J
          (baseChangeSheafPullbackCompMateIso f g).inv ≫
        (Functor.associator _ _ _).inv ≫
        Functor.whiskerRight
          (equivariantBaseChangeForwardRightAdjoint j f fbar hf)
          (baseChangeSheafPushforward g) ≫
        (Functor.associator _ _ _).hom ≫
        Functor.whiskerLeft (baseChangeSheafPushforward fbar)
          (equivariantBaseChangeForwardRightAdjoint j g gbar hg) ≫
        (Functor.associator _ _ _).inv ≫
        Functor.whiskerRight
          (baseChangeSheafPullbackCompMateIso fbar gbar).hom J

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
/-- The mate-defined forward square satisfies the exact composition law.
The proof uses horizontal composition of mates and the previously verified
right-adjoint cocycle; no componentwise sheaf calculation remains. -/
theorem equivariantBaseChangeForwardRightAdjoint_comp_mate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    equivariantBaseChangeForwardRightAdjoint j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) =
    equivariantBaseChangeForwardRightAdjointIteratedMate
      j f g fbar gbar hf hg := by
  let af := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjoint j f fbar hf)
  let ag := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjoint j g gbar hg)
  let ai := (CategoryTheory.TwoSquare.vComp af ag).whiskerRight
      (baseChangeSheafPullbackCompMateIso f g).inv |>.whiskerLeft
      (baseChangeSheafPullbackCompMateIso fbar gbar).hom
  let ad := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjoint j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]))
  have hai : ai.natTrans =
      equivariantBaseChangeForwardRightAdjointIteratedMate
        j f g fbar gbar hf hg := by
    rfl
  rw [← hai]
  change ad.natTrans = ai.natTrans
  apply (CategoryTheory.mateEquiv
    (baseChangeSheafAdjunctionOfIso (fbar ≫ gbar))
    (baseChangeSheafAdjunctionOfIso (f ≫ g))).injective
  change (CategoryTheory.mateEquiv
      (baseChangeSheafAdjunctionOfIso (fbar ≫ gbar))
      (baseChangeSheafAdjunctionOfIso (f ≫ g))) ad = _
  have had : ad =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIso (fbar ≫ gbar))
        (baseChangeSheafAdjunctionOfIso (f ≫ g))).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso
              j (f ≫ g) (fbar ≫ gbar)
                (by rw [Category.assoc, hg, ← Category.assoc, hf,
                  Category.assoc])).hom) := by
    rfl
  rw [had, Equiv.apply_symm_apply]
  dsimp only [ai]
  rw [CategoryTheory.conjugateEquiv_mateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompMateIso_conjugate_hom]
  rw [CategoryTheory.mateEquiv_conjugateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompMateIso_conjugate_inv]
  rw [CategoryTheory.mateEquiv_hcomp]
  have haf : af =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIso fbar)
        (baseChangeSheafAdjunctionOfIso f)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso j f fbar hf).hom) := by
    rfl
  have hag : ag =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIso gbar)
        (baseChangeSheafAdjunctionOfIso g)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso j g gbar hg).hom) := by
    rfl
  rw [haf, hag]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  apply CategoryTheory.TwoSquare.ext
  intro Q
  exact congr_app
    (equivariantBaseChangeRightAdjointIso_hom_comp_actual
      j f g fbar gbar hf hg) Q

/-- Beck--Chevalley for extension by zero across an equivariant square whose
vertical maps are isomorphisms. -/
noncomputable def lowerShriekEquivariantIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    lowerShriek j ⋙ baseChangeSheafPushforward fbar ≅
      baseChangeSheafPushforward f ⋙ lowerShriek j := by
  let aLeft :=
    (lowerShriekAdjunction j).comp
      (baseChangeSheafAdjunctionOfIso fbar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIso f).comp
      (lowerShriekAdjunction j)
  exact Adjunction.leftAdjointUniq
    (aLeft.ofNatIsoRight
      (equivariantBaseChangeRightAdjointIso j f fbar h))
    aRight

/-- The comparison for a composite equivariant automorphism obtained by
successively applying the two compact-support comparisons.  The forward
base-change associators are the mate-defined ones above, so every edge of
this composite is normalized against the same right-adjoint cocycle. -/
noncomputable def lowerShriekEquivariantIsoIteratedMate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    lowerShriek j ⋙ baseChangeSheafPushforward (fbar ≫ gbar) ≅
      baseChangeSheafPushforward (f ≫ g) ⋙ lowerShriek j :=
  Functor.isoWhiskerLeft (lowerShriek j)
      (baseChangeSheafPullbackCompMateIso fbar gbar).symm ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (lowerShriekEquivariantIso j f fbar hf)
      (baseChangeSheafPushforward gbar) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (baseChangeSheafPushforward f)
      (lowerShriekEquivariantIso j g gbar hg) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (baseChangeSheafPullbackCompMateIso f g)
      (lowerShriek j)

/-- The inverse Beck--Chevalley comparison is precisely the horizontal mate
of the forward right-adjoint square.  This identifies the uniqueness-of-left-
adjoints construction with the compositional calculus of mates. -/
theorem lowerShriekEquivariantIso_inv_eq_mate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (lowerShriekEquivariantIso j f fbar h).inv =
      ((CategoryTheory.mateEquiv
        (lowerShriekAdjunction j) (lowerShriekAdjunction j)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeForwardRightAdjoint
              j f fbar h))).natTrans := by
  let aLeft :=
    (lowerShriekAdjunction j).comp
      (baseChangeSheafAdjunctionOfIso fbar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIso f).comp
      (lowerShriekAdjunction j)
  let theta := equivariantBaseChangeRightAdjointIso j f fbar h
  have hconj :
      (lowerShriekEquivariantIso j f fbar h).inv =
        (CategoryTheory.conjugateEquiv aLeft aRight).symm theta.hom := by
    unfold lowerShriekEquivariantIso
    dsimp only [aLeft, aRight, theta]
    ext Q
    simp [CategoryTheory.Adjunction.leftAdjointUniq,
      CategoryTheory.conjugateEquiv, CategoryTheory.mateEquiv]
  rw [hconj]
  have hi := CategoryTheory.iterated_mateEquiv_conjugateEquiv_symm
    (lowerShriekAdjunction j) (lowerShriekAdjunction j)
    (baseChangeSheafAdjunctionOfIso f)
    (baseChangeSheafAdjunctionOfIso fbar)
    (.mk _ _ _ _ theta.hom)
  exact hi.symm

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
/-- Extension by zero satisfies the exact cocycle law for two equivariant
automorphisms when forward pullback composition is normalized by mates. -/
theorem lowerShriekEquivariantIso_comp_mate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    lowerShriekEquivariantIso j (f ≫ g) (fbar ≫ gbar)
      (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) =
    lowerShriekEquivariantIsoIteratedMate j f g fbar gbar hf hg := by
  apply Iso.ext
  apply (Iso.inv_eq_inv _ _).mp
  let af := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjoint j f fbar hf)
  let ag := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjoint j g gbar hg)
  let ai := (CategoryTheory.TwoSquare.vComp af ag).whiskerRight
      (baseChangeSheafPullbackCompMateIso f g).inv |>.whiskerLeft
      (baseChangeSheafPullbackCompMateIso fbar gbar).hom
  have hai : ai.natTrans =
      equivariantBaseChangeForwardRightAdjointIteratedMate
        j f g fbar gbar hf hg := by
    rfl
  let adjj := lowerShriekAdjunction j
  let bf := (CategoryTheory.mateEquiv adjj adjj).symm af
  let bg := (CategoryTheory.mateEquiv adjj adjj).symm ag
  let bi := (CategoryTheory.TwoSquare.hComp bf bg).whiskerTop
      (baseChangeSheafPullbackCompMateIso f g).inv |>.whiskerBottom
      (baseChangeSheafPullbackCompMateIso fbar gbar).hom
  let bd := (CategoryTheory.mateEquiv adjj adjj).symm ai
  have hbf : bf.natTrans =
      (lowerShriekEquivariantIso j f fbar hf).inv := by
    exact (lowerShriekEquivariantIso_inv_eq_mate j f fbar hf).symm
  have hbg : bg.natTrans =
      (lowerShriekEquivariantIso j g gbar hg).inv := by
    exact (lowerShriekEquivariantIso_inv_eq_mate j g gbar hg).symm
  have hbi : bi.natTrans =
      (lowerShriekEquivariantIsoIteratedMate
        j f g fbar gbar hf hg).inv := by
    dsimp only [bi]
    apply NatTrans.ext
    funext Q
    simp only [CategoryTheory.TwoSquare.whiskerBottom_app,
      CategoryTheory.TwoSquare.whiskerTop_app,
      CategoryTheory.TwoSquare.hComp_app]
    rw [congr_app hbg ((baseChangeSheafPushforward f).obj Q),
      congr_app hbf Q]
    rfl
  have hm : (CategoryTheory.mateEquiv adjj adjj) bi = ai := by
    dsimp only [bi, ai]
    rw [CategoryTheory.mateEquiv_whiskerBottom]
    rw [CategoryTheory.mateEquiv_whiskerTop]
    rw [CategoryTheory.mateEquiv_vcomp]
    dsimp only [bf, bg]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  have hbd : bd = bi := by
    apply (CategoryTheory.mateEquiv adjj adjj).injective
    rw [hm]
    dsimp only [bd]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  calc
    (lowerShriekEquivariantIso j (f ≫ g) (fbar ≫ gbar)
        (by rw [Category.assoc, hg, ← Category.assoc, hf,
          Category.assoc])).inv = bd.natTrans := by
      rw [lowerShriekEquivariantIso_inv_eq_mate]
      rw [equivariantBaseChangeForwardRightAdjoint_comp_mate
        j f g fbar gbar hf hg]
      have hsq : CategoryTheory.TwoSquare.mk _ _ _ _
          (equivariantBaseChangeForwardRightAdjointIteratedMate
            j f g fbar gbar hf hg) = ai := by
        exact hai.symm
      exact congrArg (fun z =>
        ((CategoryTheory.mateEquiv adjj adjj).symm z).natTrans) hsq
    _ = bi.natTrans := congrArg CategoryTheory.TwoSquare.natTrans hbd
    _ = (lowerShriekEquivariantIsoIteratedMate
        j f g fbar gbar hf hg).inv := hbi

/-- A pullback map on coefficients extends across `j_!` when the scheme
automorphism extends to the compactification. -/
noncomputable def lowerShriekEquivariantPullback
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q) :
    (lowerShriek j).obj Q ⟶
      (baseChangeSheafPushforward fbar).obj ((lowerShriek j).obj Q) :=
  (lowerShriek j).map pullback ≫
    (lowerShriekEquivariantIso j f fbar h).inv.app Q

/-- Equivariant extension by zero preserves natural endomorphisms of the
coefficient sheaf. -/
theorem lowerShriekEquivariantPullback_naturality
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (s : Q ⟶ Q)
    (hs : s ≫ pullback =
      pullback ≫ (baseChangeSheafPushforward f).map s) :
    (lowerShriek j).map s ≫
        lowerShriekEquivariantPullback j f fbar h Q pullback =
      lowerShriekEquivariantPullback j f fbar h Q pullback ≫
        (baseChangeSheafPushforward fbar).map ((lowerShriek j).map s) := by
  unfold lowerShriekEquivariantPullback
  rw [← Category.assoc, ← (lowerShriek j).map_comp, hs,
    (lowerShriek j).map_comp, Category.assoc]
  have hn :
      (lowerShriek j).map ((baseChangeSheafPushforward f).map s) ≫
          (lowerShriekEquivariantIso j f fbar h).inv.app Q =
        (lowerShriekEquivariantIso j f fbar h).inv.app Q ≫
          (baseChangeSheafPushforward fbar).map ((lowerShriek j).map s) := by
    simpa only [Functor.comp_map] using
      (lowerShriekEquivariantIso j f fbar h).inv.naturality s
  rw [hn]
  rw [Category.assoc]

/-- A natural endomorphism commuting with coefficient pullback also commutes
with the induced cohomology action. -/
theorem sheafCohomologyPullbackEndomorphismOfIso_naturality
    {Y : Scheme.{u}} (f : Y ⟶ Y) [IsIso f]
    (Q : Sheaf (topology Y) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (s : Q ⟶ Q)
    (hs : s ≫ pullback =
      pullback ≫ (baseChangeSheafPushforward f).map s)
    (n : ℕ) (x : Q.H n) :
    sheafCohomologyPullbackEndomorphismOfIso f Q pullback n
        (Sheaf.H.map s n x) =
      Sheaf.H.map s n
        (sheafCohomologyPullbackEndomorphismOfIso f Q pullback n x) := by
  unfold sheafCohomologyPullbackEndomorphismOfIso
  simp only [AddMonoidHom.comp_apply]
  rw [← Sheaf.H.map_comp_apply, hs, Sheaf.H.map_comp_apply]
  exact baseChangeSheafCohomologyAddEquivOfIso_symm_naturality
    f s n (Sheaf.H.map pullback n x)

/-- Naturality of cohomological pullback between two coefficient sheaves. -/
theorem sheafCohomologyPullbackEndomorphismOfIso_naturality_between
    {Y : Scheme.{u}} (f : Y ⟶ Y) [IsIso f]
    (Q R : Sheaf (topology Y) Ab.{u + 1})
    (pullQ : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (pullR : R ⟶ (baseChangeSheafPushforward f).obj R)
    (s : Q ⟶ R)
    (hs : s ≫ pullR =
      pullQ ≫ (baseChangeSheafPushforward f).map s)
    (n : ℕ) (x : Q.H n) :
    sheafCohomologyPullbackEndomorphismOfIso f R pullR n
        (Sheaf.H.map s n x) =
      Sheaf.H.map s n
        (sheafCohomologyPullbackEndomorphismOfIso f Q pullQ n x) := by
  unfold sheafCohomologyPullbackEndomorphismOfIso
  simp only [AddMonoidHom.comp_apply]
  rw [← Sheaf.H.map_comp_apply, hs, Sheaf.H.map_comp_apply]
  exact baseChangeSheafCohomologyAddEquivOfIso_symm_naturality
    f s n (Sheaf.H.map pullQ n x)

/-- The genuine cohomology action obtained after equivariant extension by
zero. -/
noncomputable def lowerShriekCohomologyPullbackEndomorphism
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (n : ℕ) :
    ((lowerShriek j).obj Q).H n →+ ((lowerShriek j).obj Q).H n :=
  sheafCohomologyPullbackEndomorphismOfIso fbar ((lowerShriek j).obj Q)
    (lowerShriekEquivariantPullback j f fbar h Q pullback) n

/-- The extended cohomology action inherits all coefficient naturality. -/
theorem lowerShriekCohomologyPullbackEndomorphism_naturality
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (s : Q ⟶ Q)
    (hs : s ≫ pullback =
      pullback ≫ (baseChangeSheafPushforward f).map s)
    (n : ℕ) (x : ((lowerShriek j).obj Q).H n) :
    lowerShriekCohomologyPullbackEndomorphism j f fbar h Q pullback n
        (Sheaf.H.map ((lowerShriek j).map s) n x) =
      Sheaf.H.map ((lowerShriek j).map s) n
        (lowerShriekCohomologyPullbackEndomorphism
          j f fbar h Q pullback n x) := by
  apply sheafCohomologyPullbackEndomorphismOfIso_naturality
  exact lowerShriekEquivariantPullback_naturality
    j f fbar h Q pullback s hs

/-- Pullback of continuous `ℓ`-adic-valued functions along an arbitrary
scheme morphism. -/
noncomputable def ellAdicCoefficientPullback {X Y : Scheme.{u}}
    (f : X ⟶ Y) (ell : ℕ) [Fact ell.Prime] :
    Y.ellAdicSheaf ell ⟶
      (baseChangeSheafPushforward f).obj (X.ellAdicSheaf ell) := by
  refine ⟨{ app := fun U ↦ ?_, naturality := ?_ }⟩
  · exact AddCommGrpCat.ofHom (ContinuousMap.compAddMonoidHom'
      (pullback.fst U.unop.hom f).base.hom)
  · intro U V g
    ext h
    change C(U.unop.left, ℤ_[ell]) at h
    apply ContinuousMap.coe_injective
    funext x
    change h ((pullback.fst V.unop.hom f ≫ g.unop.left).base x) =
      h ((((baseChange f).map g.unop).left ≫
        pullback.fst U.unop.hom f).base x)
    rw [show ((baseChange f).map g.unop).left ≫
          pullback.fst U.unop.hom f =
        pullback.fst V.unop.hom f ≫ g.unop.left by
      change pullback.lift
            (pullback.fst V.unop.hom f ≫ g.unop.left)
            (pullback.snd V.unop.hom f) _ ≫
          pullback.fst U.unop.hom f = _
      exact pullback.lift_fst _ _ _]
    rfl

/-- Cohomology with the coefficient sheaf precomposed by scheme-morphism
base change. -/
abbrev BaseChangedEllAdicCohomology {X Y : Scheme.{u}}
    (f : X ⟶ Y) (ell degree : ℕ) [Fact ell.Prime] : Type (u + 1) :=
  ((sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).obj <|
    (baseChangeSheafPushforward f).obj (X.ellAdicSheaf ell)).H degree

/-- The cohomology map induced by pullback of continuous ell-adic-valued
functions. -/
noncomputable def ellAdicCohomologyPullback {X Y : Scheme.{u}}
    (f : X ⟶ Y) (ell degree : ℕ) [Fact ell.Prime] :
    Y.EllAdicCohomology ell degree →+
      BaseChangedEllAdicCohomology f ell degree :=
  Sheaf.H.map
    ((sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).map
      (ellAdicCoefficientPullback f ell)) degree

/-! The next comparison turns coefficient pullback into an isomorphism when
the relevant base-change projections are homeomorphisms.  This is the precise
topological input supplied by a universal homeomorphism such as Frobenius. -/

/-- The homeomorphism hypothesis is automatic for identity base change. -/
theorem identityBaseChangeIsHomeomorph (X : Scheme.{u}) :
    ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom (𝟙 X)).base := by
  intro U
  have : IsIso (pullback.fst U.hom (𝟙 X)) := inferInstance
  exact (TopCat.isIso_iff_isHomeomorph _).mp (inferInstance : IsIso _)

/-- More generally, the homeomorphism hypothesis is automatic for a scheme
isomorphism. -/
theorem baseChangeIsHomeomorph_of_isIso {X Y : Scheme.{u}}
    (f : X ⟶ Y) [IsIso f] :
    ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base := by
  intro U
  have : IsIso (pullback.fst U.hom f) := inferInstance
  exact (TopCat.isIso_iff_isHomeomorph _).mp (inferInstance : IsIso _)

/-- If every projection produced by scheme-morphism base change is a
homeomorphism, pullback of continuous ell-adic coefficient functions is an
isomorphism of sheaves. -/
noncomputable def ellAdicCoefficientComparisonIsoOfHomeomorph
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ell : ℕ) [Fact ell.Prime]
    (h : ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    Y.ellAdicSheaf ell ≅
      (baseChangeSheafPushforward f).obj (X.ellAdicSheaf ell) where
  hom := ellAdicCoefficientPullback f ell
  inv := by
    refine ⟨{ app := fun U ↦ ?_, naturality := ?_ }⟩
    · exact AddCommGrpCat.ofHom (ContinuousMap.compAddMonoidHom'
        ⟨(h U.unop).homeomorph.symm,
          (h U.unop).homeomorph.symm.continuous⟩)
    · intro U V g
      ext k
      change C(((baseChange f).obj U.unop).left, ℤ_[ell]) at k
      apply ContinuousMap.coe_injective
      funext x
      change k (((baseChange f).map g.unop).left.base
          ((h V.unop).homeomorph.symm x)) =
        k ((h U.unop).homeomorph.symm (g.unop.left.base x))
      congr 1
      apply (h U.unop).injective
      have hs : ((baseChange f).map g.unop).left ≫
          pullback.fst U.unop.hom f =
          pullback.fst V.unop.hom f ≫ g.unop.left := by
        change pullback.lift
              (pullback.fst V.unop.hom f ≫ g.unop.left)
              (pullback.snd V.unop.hom f) _ ≫
            pullback.fst U.unop.hom f = _
        exact pullback.lift_fst _ _ _
      have hx := congrArg
        (fun e ↦ e.base ((h V.unop).homeomorph.symm x)) hs
      change (pullback.fst U.unop.hom f).base
          (((baseChange f).map g.unop).left.base
            ((h V.unop).homeomorph.symm x)) =
        g.unop.left.base ((pullback.fst V.unop.hom f).base
          ((h V.unop).homeomorph.symm x)) at hx
      calc
        _ = g.unop.left.base ((pullback.fst V.unop.hom f).base
            ((h V.unop).homeomorph.symm x)) := hx
        _ = g.unop.left.base x := congrArg _
          ((h V.unop).homeomorph.apply_symm_apply x)
        _ = (pullback.fst U.unop.hom f).base
            ((h U.unop).homeomorph.symm (g.unop.left.base x)) :=
          ((h U.unop).homeomorph.apply_symm_apply _).symm
  hom_inv_id := by
    ext U k
    change C(U.unop.left, ℤ_[ell]) at k
    apply ContinuousMap.coe_injective
    funext x
    exact congrArg k ((h U.unop).homeomorph.apply_symm_apply x)
  inv_hom_id := by
    ext U k
    change C(((baseChange f).obj U.unop).left, ℤ_[ell]) at k
    apply ContinuousMap.coe_injective
    funext x
    exact congrArg k ((h U.unop).homeomorph.symm_apply_apply x)

/-- Under objectwise topological invariance of base change, the already
constructed cohomology pullback is an additive equivalence. -/
noncomputable def ellAdicCohomologyComparisonEquivOfHomeomorph
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ell degree : ℕ) [Fact ell.Prime]
    (h : ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    Y.EllAdicCohomology ell degree ≃+
      BaseChangedEllAdicCohomology f ell degree := by
  let e :
      (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).obj
          (Y.ellAdicSheaf ell) ≅
        (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).obj
          ((baseChangeSheafPushforward f).obj (X.ellAdicSheaf ell)) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (ellAdicCoefficientComparisonIsoOfHomeomorph f ell h)
  refine
    { toFun := Sheaf.H.map e.hom degree
      invFun := Sheaf.H.map e.inv degree
      left_inv := ?_
      right_inv := ?_
      map_add' := (Sheaf.H.map e.hom degree).map_add }
  · intro x
    dsimp only [Scheme.EllAdicCohomology,
      BaseChangedEllAdicCohomology] at x ⊢
    rw [← Sheaf.H.map_comp_apply]
    simp
  · intro x
    dsimp only [Scheme.EllAdicCohomology,
      BaseChangedEllAdicCohomology] at x ⊢
    rw [← Sheaf.H.map_comp_apply]
    simp

@[simp]
theorem ellAdicCohomologyComparisonEquivOfHomeomorph_apply
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ell degree : ℕ) [Fact ell.Prime]
    (h : ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base)
    (x : Y.EllAdicCohomology ell degree) :
    ellAdicCohomologyComparisonEquivOfHomeomorph f ell degree h x =
      ellAdicCohomologyPullback f ell degree x := by
  rfl

/-- Extension by zero of the coefficient sheaf precomposed with endomorphism
base change. -/
noncomputable def baseChangedCompactSupportSheaf
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ell : ℕ) [Fact ell.Prime] :
    Sheaf (topology Xbar) Ab.{u + 1} :=
  (lowerShriek j).obj
    ((sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).obj
      ((baseChangeSheafPushforward f).obj (X.ellAdicSheaf ell)))

/-- A coefficient comparison on `X` passes through extension by zero. -/
noncomputable def compactSupportCoefficientComparisonIsoOfHomeomorph
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ell : ℕ) [Fact ell.Prime]
    (h : ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    compactSupportSheaf j ell ≅ baseChangedCompactSupportSheaf j f ell :=
  (lowerShriek j).mapIso
    ((sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (ellAdicCoefficientComparisonIsoOfHomeomorph f ell h))

/-- Compactly supported cohomology with the
endomorphism-precomposed coefficient sheaf. -/
abbrev BaseChangedCompactlySupportedEllAdicCohomology
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ell degree : ℕ) [Fact ell.Prime] : Type (u + 1) :=
  (baseChangedCompactSupportSheaf j f ell).H degree

/-- The compact-support coefficient comparison induces an additive
equivalence on cohomology. -/
noncomputable def compactlySupportedCohomologyComparisonEquivOfHomeomorph
    {S X Xbar : Scheme.{u}} (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) (ell degree : ℕ) [Fact ell.Prime]
    (h : ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    CompactlySupportedEllAdicCohomology j pbar ell degree ≃+
      BaseChangedCompactlySupportedEllAdicCohomology j f ell degree := by
  let e : compactSupportSheaf j ell ≅
      baseChangedCompactSupportSheaf j f ell :=
    compactSupportCoefficientComparisonIsoOfHomeomorph j f ell h
  refine
    { toFun := Sheaf.H.map e.hom degree
      invFun := Sheaf.H.map e.inv degree
      left_inv := ?_
      right_inv := ?_
      map_add' := (Sheaf.H.map e.hom degree).map_add }
  · intro x
    dsimp only [CompactlySupportedEllAdicCohomology,
      BaseChangedCompactlySupportedEllAdicCohomology] at x ⊢
    rw [← Sheaf.H.map_comp_apply]
    simp
  · intro x
    dsimp only [CompactlySupportedEllAdicCohomology,
      BaseChangedCompactlySupportedEllAdicCohomology] at x ⊢
    rw [← Sheaf.H.map_comp_apply]
    simp

end AlgebraicGeometry.Scheme.ProEt

namespace AlgebraicGeometry.Scheme

universe u

variable (X : Scheme.{u})

/-- The sheaf of continuous `Q_ℓ`-valued functions on the pro-étale site,
viewed as an abelian sheaf. -/
noncomputable def qEllAdicSheafAb (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf (ProEt.topology X) Ab.{u} :=
  ((ProEt.forget X ⋙ Over.forget _).sheafPushforwardContinuous
      _ _ proetaleTopology).obj
    ⟨continuousMapPresheafAb (ℚ_[ℓ]),
      .of_le proetaleTopology_le_fpqcTopology <|
        isSheaf_fpqcTopology_continuousMapPresheafAb _⟩

/-- Scalar multiplication on the rational `ℓ`-adic coefficient sheaf. -/
noncomputable def qEllAdicSheafAbScalar
    (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    X.qEllAdicSheafAb ℓ ⟶ X.qEllAdicSheafAb ℓ := by
  refine ⟨{ app := fun U ↦ AddCommGrpCat.ofHom ?_, naturality := ?_ }⟩
  · exact
      { toFun := fun f ↦ r • f
        map_zero' := smul_zero r
        map_add' := by
          intro f g
          ext x
          exact smul_add r (f x) (g x) }
  · intro U V f
    ext g
    rfl

@[simp]
lemma qEllAdicSheafAbScalar_zero
    (ℓ : ℕ) [Fact ℓ.Prime] :
    X.qEllAdicSheafAbScalar ℓ 0 = 0 := by
  ext U f
  change C(U.unop.left, ℚ_[ℓ]) at f
  change (0 : ℚ_[ℓ]) • f = 0
  ext x
  simp

@[simp]
lemma qEllAdicSheafAbScalar_one
    (ℓ : ℕ) [Fact ℓ.Prime] :
    X.qEllAdicSheafAbScalar ℓ 1 = 𝟙 _ := by
  ext U f
  change C(U.unop.left, ℚ_[ℓ]) at f
  change (1 : ℚ_[ℓ]) • f = f
  ext x
  simp

@[simp]
lemma qEllAdicSheafAbScalar_add
    (ℓ : ℕ) [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    X.qEllAdicSheafAbScalar ℓ (r + s) =
      X.qEllAdicSheafAbScalar ℓ r + X.qEllAdicSheafAbScalar ℓ s := by
  ext U f
  change C(U.unop.left, ℚ_[ℓ]) at f
  change (r + s) • f = r • f + s • f
  ext x
  exact add_smul r s (f x)

@[simp]
lemma qEllAdicSheafAbScalar_mul
    (ℓ : ℕ) [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    X.qEllAdicSheafAbScalar ℓ (r * s) =
      X.qEllAdicSheafAbScalar ℓ s ≫ X.qEllAdicSheafAbScalar ℓ r := by
  ext U f
  change C(U.unop.left, ℚ_[ℓ]) at f
  change (r * s) • f = r • (s • f)
  ext x
  exact mul_smul r s (f x)

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.ProEt

universe u

noncomputable instance qEllAdicSheafAbULiftFunctor_additive
    (X : Scheme.{u}) :
    (sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).Additive where
  map_add := by
    intro A B f g
    ext U x
    rfl

noncomputable instance lowerShriek_additive {X Y : Scheme.{u}}
    (f : X ⟶ Y) [WeaklyEtale f] : (lowerShriek f).Additive := by
  let : (lowerShriek f).IsLeftAdjoint :=
    (lowerShriekAdjunction f).isLeftAdjoint
  let := preservesBinaryBiproducts_of_preservesBinaryCoproducts
    (lowerShriek f)
  exact Functor.additive_of_preservesBinaryBiproducts _

/-- Universe-lifted rational `ℓ`-adic coefficient sheaf. -/
noncomputable def qEllAdicSheafAbULift (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] : Sheaf (topology X) Ab.{u + 1} :=
  (sheafCompose _ AddCommGrpCat.uliftFunctor.{u + 1}).obj
    (X.qEllAdicSheafAb ℓ)

noncomputable def qEllAdicSheafAbScalarULift (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    qEllAdicSheafAbULift X ℓ ⟶ qEllAdicSheafAbULift X ℓ :=
  (sheafCompose _ AddCommGrpCat.uliftFunctor.{u + 1}).map
    (X.qEllAdicSheafAbScalar ℓ r)

@[simp]
lemma qEllAdicSheafAbScalarULift_zero (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] :
    qEllAdicSheafAbScalarULift X ℓ 0 = 0 := by
  simp [qEllAdicSheafAbScalarULift]
  rfl

@[simp]
lemma qEllAdicSheafAbScalarULift_one (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] :
    qEllAdicSheafAbScalarULift X ℓ 1 = 𝟙 _ := by
  simp [qEllAdicSheafAbScalarULift]
  rfl

@[simp]
lemma qEllAdicSheafAbScalarULift_add (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    qEllAdicSheafAbScalarULift X ℓ (r + s) =
      qEllAdicSheafAbScalarULift X ℓ r +
        qEllAdicSheafAbScalarULift X ℓ s := by
  simp [qEllAdicSheafAbScalarULift]
  rfl

@[simp]
lemma qEllAdicSheafAbScalarULift_mul (X : Scheme.{u}) (ℓ : ℕ)
    [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    qEllAdicSheafAbScalarULift X ℓ (r * s) =
      qEllAdicSheafAbScalarULift X ℓ s ≫
        qEllAdicSheafAbScalarULift X ℓ r := by
  simp [qEllAdicSheafAbScalarULift]
  rfl

/-- The honest extension by zero `j_! Q_ℓ`. -/
noncomputable def qEllAdicCompactSupportSheaf {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf (topology Xbar) Ab.{u + 1} :=
  (lowerShriek j).obj (qEllAdicSheafAbULift X ℓ)

/-- Scalar multiplication on the honest extension by zero `j_! Q_ℓ`. -/
noncomputable def qEllAdicCompactSupportScalar {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime]
    (r : ℚ_[ℓ]) :
    qEllAdicCompactSupportSheaf j ℓ ⟶ qEllAdicCompactSupportSheaf j ℓ :=
  (lowerShriek j).map (qEllAdicSheafAbScalarULift X ℓ r)

@[simp]
lemma qEllAdicCompactSupportScalar_zero {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCompactSupportScalar j ℓ 0 = 0 := by
  simp [qEllAdicCompactSupportScalar]
  rfl

@[simp]
lemma qEllAdicCompactSupportScalar_one {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCompactSupportScalar j ℓ 1 = 𝟙 _ := by
  simp [qEllAdicCompactSupportScalar]
  rfl

@[simp]
lemma qEllAdicCompactSupportScalar_add {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime]
    (r s : ℚ_[ℓ]) :
    qEllAdicCompactSupportScalar j ℓ (r + s) =
      qEllAdicCompactSupportScalar j ℓ r +
        qEllAdicCompactSupportScalar j ℓ s := by
  simp [qEllAdicCompactSupportScalar]
  rfl

@[simp]
lemma qEllAdicCompactSupportScalar_mul {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime]
    (r s : ℚ_[ℓ]) :
    qEllAdicCompactSupportScalar j ℓ (r * s) =
      qEllAdicCompactSupportScalar j ℓ s ≫
        qEllAdicCompactSupportScalar j ℓ r := by
  simp [qEllAdicCompactSupportScalar]
  rfl

def CompactlySupportedQEllAdicCohomology {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) : Type (u + 1) :=
  (qEllAdicCompactSupportSheaf j ℓ).H n

/-- Honest geometric compactly supported rational `ℓ`-adic cohomology,
formed on `X_Fbar` with the base-changed open compactification. -/
noncomputable abbrev GeometricCompactlySupportedQEllAdicCohomology
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (h : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :=
  CompactlySupportedQEllAdicCohomology
    (geometricCompactificationOpen q pX j pbar h)
    (geometricCompactificationProjection q pbar) ℓ degree

noncomputable instance {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    AddCommGroup (CompactlySupportedQEllAdicCohomology j pbar ℓ n) :=
  inferInstanceAs <| AddCommGroup ((qEllAdicCompactSupportSheaf j ℓ).H n)

/-- The action of a scalar on compactly supported rational `ℓ`-adic
cohomology, obtained functorially from its action on `j_! Q_ℓ`. -/
noncomputable def compactlySupportedQEllAdicCohomologyScalar
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) (r : ℚ_[ℓ]) :
    CompactlySupportedQEllAdicCohomology j pbar ℓ n →+
      CompactlySupportedQEllAdicCohomology j pbar ℓ n :=
  Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n

noncomputable instance compactlySupportedQEllAdicCohomologySMul
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    SMul ℚ_[ℓ] (CompactlySupportedQEllAdicCohomology j pbar ℓ n) :=
  ⟨fun r ↦ compactlySupportedQEllAdicCohomologyScalar j pbar ℓ n r⟩

@[simp]
lemma compactlySupportedQEllAdicCohomology_smul_apply
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) (r : ℚ_[ℓ])
    (x : CompactlySupportedQEllAdicCohomology j pbar ℓ n) :
    r • x = Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n x :=
  rfl

noncomputable instance compactlySupportedQEllAdicCohomologyModule
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    Module ℚ_[ℓ] (CompactlySupportedQEllAdicCohomology j pbar ℓ n) :=
  Module.ofMinimalAxioms
    (fun r x y ↦ by
      exact (compactlySupportedQEllAdicCohomologyScalar
        j pbar ℓ n r).map_add x y)
    (fun r s x ↦ by
      change (qEllAdicCompactSupportSheaf j ℓ).H n at x
      change Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ (r + s)) n x =
        Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n x +
          Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ s) n x
      rw [qEllAdicCompactSupportScalar_add,
        Sheaf.H.map_add_apply])
    (fun r s x ↦ by
      change (qEllAdicCompactSupportSheaf j ℓ).H n at x
      change Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ (r * s)) n x =
        Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n
          (Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ s) n x)
      rw [qEllAdicCompactSupportScalar_mul,
        Sheaf.H.map_comp_apply])
    (fun x ↦ by
      change (qEllAdicCompactSupportSheaf j ℓ).H n at x
      change Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ 1) n x = x
      rw [qEllAdicCompactSupportScalar_one,
        Sheaf.H.map_id_apply])

/-- A scalar-linear endomorphism of the compact-support coefficient sheaf
induces a `Q_ℓ`-linear endomorphism on compactly supported cohomology. -/
noncomputable def compactlySupportedQEllAdicCohomologyLinearMap
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ)
    (f : qEllAdicCompactSupportSheaf j ℓ ⟶
      qEllAdicCompactSupportSheaf j ℓ)
    (hf : ∀ r : ℚ_[ℓ],
      qEllAdicCompactSupportScalar j ℓ r ≫ f =
        f ≫ qEllAdicCompactSupportScalar j ℓ r) :
    CompactlySupportedQEllAdicCohomology j pbar ℓ n →ₗ[ℚ_[ℓ]]
      CompactlySupportedQEllAdicCohomology j pbar ℓ n where
  toFun := Sheaf.H.map f n
  map_add' := (Sheaf.H.map f n).map_add
  map_smul' := by
    intro r x
    change (qEllAdicCompactSupportSheaf j ℓ).H n at x
    change Sheaf.H.map f n
        (Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n x) =
      Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) n
        (Sheaf.H.map f n x)
    rw [← Sheaf.H.map_comp_apply, hf, Sheaf.H.map_comp_apply]

/-- The basis-independent trace of a scalar-linear compactly supported
`Q_ℓ`-cohomology endomorphism. -/
noncomputable def compactlySupportedQEllAdicCohomologyTrace
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ)
    [FiniteDimensional ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ n)]
    (f : qEllAdicCompactSupportSheaf j ℓ ⟶
      qEllAdicCompactSupportSheaf j ℓ)
    (hf : ∀ r : ℚ_[ℓ],
      qEllAdicCompactSupportScalar j ℓ r ≫ f =
        f ≫ qEllAdicCompactSupportScalar j ℓ r) : ℚ_[ℓ] :=
  LinearMap.trace ℚ_[ℓ]
    (CompactlySupportedQEllAdicCohomology j pbar ℓ n)
    (compactlySupportedQEllAdicCohomologyLinearMap
      j pbar ℓ n f hf)

/-- Pullback of continuous `Q_ℓ`-valued functions along an arbitrary
scheme morphism. -/
noncomputable def qEllAdicCoefficientPullback {X Y : Scheme.{u}}
    (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime] :
    Y.qEllAdicSheafAb ℓ ⟶
      (baseChangeSheafPushforward f).obj (X.qEllAdicSheafAb ℓ) := by
  refine ⟨{ app := fun U ↦ ?_, naturality := ?_ }⟩
  · exact AddCommGrpCat.ofHom (ContinuousMap.compAddMonoidHom'
      (pullback.fst U.unop.hom f).base.hom)
  · intro U V g
    ext h
    change C(U.unop.left, ℚ_[ℓ]) at h
    apply ContinuousMap.coe_injective
    funext x
    change h ((pullback.fst V.unop.hom f ≫ g.unop.left).base x) =
      h ((((baseChange f).map g.unop).left ≫
        pullback.fst U.unop.hom f).base x)
    rw [show ((baseChange f).map g.unop).left ≫
          pullback.fst U.unop.hom f =
        pullback.fst V.unop.hom f ≫ g.unop.left by
      change pullback.lift
            (pullback.fst V.unop.hom f ≫ g.unop.left)
            (pullback.snd V.unop.hom f) _ ≫
          pullback.fst U.unop.hom f = _
      exact pullback.lift_fst _ _ _]
    rfl

/-- Scalar multiplication on the base-changed rational coefficient sheaf. -/
noncomputable def baseChangedQEllAdicSheafScalar {X Y : Scheme.{u}}
    (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    (baseChangeSheafPushforward f).obj (X.qEllAdicSheafAb ℓ) ⟶
      (baseChangeSheafPushforward f).obj (X.qEllAdicSheafAb ℓ) :=
  (baseChangeSheafPushforward f).map (X.qEllAdicSheafAbScalar ℓ r)

lemma qEllAdicCoefficientPullback_scalar
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime]
    (r : ℚ_[ℓ]) :
    Y.qEllAdicSheafAbScalar ℓ r ≫ qEllAdicCoefficientPullback f ℓ =
      qEllAdicCoefficientPullback f ℓ ≫
        baseChangedQEllAdicSheafScalar f ℓ r := by
  ext U a
  rfl

/-- Geometric pullback on the universe-lifted rational coefficient sheaf. -/
noncomputable def qEllAdicCoefficientPullbackULift
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicSheafAbULift Y ℓ ⟶
      (baseChangeSheafPushforward f).obj (qEllAdicSheafAbULift X ℓ) :=
  (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).map
    (qEllAdicCoefficientPullback f ℓ)

theorem qEllAdicCoefficientPullbackULift_scalar
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime]
    (r : ℚ_[ℓ]) :
    qEllAdicSheafAbScalarULift Y ℓ r ≫
        qEllAdicCoefficientPullbackULift f ℓ =
      qEllAdicCoefficientPullbackULift f ℓ ≫
        (baseChangeSheafPushforward f).map
          (qEllAdicSheafAbScalarULift X ℓ r) := by
  ext U h
  rfl

/-- Geometric pullback of the rational coefficient sheaf along the identity
scheme map, followed by the canonical identity-base-change comparison, is
the identity sheaf morphism. -/
theorem qEllAdicCoefficientPullbackULift_id
    (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCoefficientPullbackULift (𝟙 X) ℓ ≫
        (baseChangeSheafPushforwardId X).hom.app
          (qEllAdicSheafAbULift X ℓ) =
      𝟙 (qEllAdicSheafAbULift X ℓ) := by
  ext U f
  simp only [qEllAdicCoefficientPullbackULift,
    qEllAdicCoefficientPullback, baseChangeSheafPushforwardId,
    baseChangeId]
  rcases f with ⟨f⟩
  change C(U.unop.left, ℚ_[ℓ]) at f
  apply ULift.ext
  apply ContinuousMap.coe_injective
  funext x
  let : Category.{u} (Raw X) := X.instCategoryProEt
  let e := (rawBaseChangeId X).app U.unop
  have he := congrArg (fun h ↦ h.hom.left) e.inv_hom_id
  change e.inv.hom.left ≫ e.hom.hom.left = 𝟙 _ at he
  have hehom : e.hom.hom.left = pullback.fst U.unop.hom (𝟙 X) := rfl
  rw [hehom] at he
  change f ((e.inv.hom.left ≫
    pullback.fst U.unop.hom (𝟙 X)).base x) = f x
  rw [he]
  rfl

/-- Rational coefficient pullback is compatible with composition of scheme
morphisms and the canonical comparison between one-step and iterated site
base change. -/
theorem qEllAdicCoefficientPullbackULift_comp
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCoefficientPullbackULift (f ≫ g) ℓ =
      qEllAdicCoefficientPullbackULift g ℓ ≫
        (baseChangeSheafPushforward g).map
          (qEllAdicCoefficientPullbackULift f ℓ) ≫
        (baseChangeSheafPushforwardComp f g).hom.app
          (qEllAdicSheafAbULift X ℓ) := by
  ext U h
  simp only [qEllAdicCoefficientPullbackULift,
    qEllAdicCoefficientPullback, baseChangeSheafPushforwardComp,
    baseChangeComp]
  rcases h with ⟨h⟩
  change C(U.unop.left, ℚ_[ℓ]) at h
  apply ULift.ext
  apply ContinuousMap.coe_injective
  funext x
  let : Category.{u} (Raw X) := X.instCategoryProEt
  let : Category.{u} (Raw Y) := Y.instCategoryProEt
  let : Category.{u} (Raw Z) := Z.instCategoryProEt
  let : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb hp ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hp⟩
  let : MorphismProperty.HasPullbacksAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb hp ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hp⟩
  let e := (rawBaseChangeComp f g).app U.unop
  have he := MorphismProperty.Over.pullbackComp_left_fst_fst
    (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
    (Q := (⊤ : MorphismProperty Scheme.{u})) f g
    ((proEtToRaw Z).obj U.unop)
  change e.hom.hom.left ≫
      pullback.fst (pullback.snd U.unop.hom g) f ≫
        pullback.fst U.unop.hom g =
    pullback.fst U.unop.hom (f ≫ g) at he
  change h ((pullback.fst U.unop.hom (f ≫ g)).base x) =
    h ((e.hom.hom.left ≫
      pullback.fst (pullback.snd U.unop.hom g) f ≫
        pullback.fst U.unop.hom g).base x)
  rw [he]
  rfl

/-- The honest action of a scheme automorphism on rational pro-étale
cohomology: geometric coefficient pullback followed by transport across the
induced equivalence of sites. -/
noncomputable def qEllAdicCohomologyPullbackEndomorphismOfIso
    (X : Scheme.{u}) (f : X ⟶ X) [IsIso f]
    (ℓ n : ℕ) [Fact ℓ.Prime] :
    (qEllAdicSheafAbULift X ℓ).H n →+
      (qEllAdicSheafAbULift X ℓ).H n :=
  sheafCohomologyPullbackEndomorphismOfIso f
    (qEllAdicSheafAbULift X ℓ)
    (qEllAdicCoefficientPullbackULift f ℓ) n

/-- Pullback on rational pro-étale cohomology is contravariantly
functorial in the underlying scheme automorphism. -/
theorem qEllAdicCohomologyPullbackEndomorphismOfIso_comp
    (X : Scheme.{u}) (f g : X ⟶ X) [IsIso f] [IsIso g]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    qEllAdicCohomologyPullbackEndomorphismOfIso X (f ≫ g) ℓ degree =
      (qEllAdicCohomologyPullbackEndomorphismOfIso X f ℓ degree).comp
        (qEllAdicCohomologyPullbackEndomorphismOfIso X g ℓ degree) := by
  ext x
  unfold qEllAdicCohomologyPullbackEndomorphismOfIso
    sheafCohomologyPullbackEndomorphismOfIso
  simp only [AddMonoidHom.comp_apply]
  rw [qEllAdicCoefficientPullbackULift_comp]
  simp only [Sheaf.H.map_comp_apply]
  simp only [AddEquiv.coe_toAddMonoidHom]
  rw [baseChangeSheafCohomologyAddEquivOfIso_symm_comp]
  rw [baseChangeSheafCohomologyAddEquivOfIso_symm_naturality]

theorem qEllAdicCohomologyPullbackEndomorphismOfIso_scalar
    (X : Scheme.{u}) (f : X ⟶ X) [IsIso f]
    (ℓ n : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ])
    (x : (qEllAdicSheafAbULift X ℓ).H n) :
    qEllAdicCohomologyPullbackEndomorphismOfIso X f ℓ n
        (Sheaf.H.map (qEllAdicSheafAbScalarULift X ℓ r) n x) =
      Sheaf.H.map (qEllAdicSheafAbScalarULift X ℓ r) n
        (qEllAdicCohomologyPullbackEndomorphismOfIso X f ℓ n x) := by
  unfold qEllAdicCohomologyPullbackEndomorphismOfIso
    sheafCohomologyPullbackEndomorphismOfIso
  simp only [AddMonoidHom.comp_apply]
  rw [← Sheaf.H.map_comp_apply]
  rw [qEllAdicCoefficientPullbackULift_scalar]
  rw [Sheaf.H.map_comp_apply]
  exact baseChangeSheafCohomologyAddEquivOfIso_symm_naturality
    f (qEllAdicSheafAbScalarULift X ℓ r) n
      (Sheaf.H.map (qEllAdicCoefficientPullbackULift f ℓ) n x)

/-- The geometric pullback morphism on `j_! Q_ℓ` associated with an
automorphism extending to a compactification. -/
noncomputable def qEllAdicCompactSupportPullbackOfEquivariantIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCompactSupportSheaf j ℓ ⟶
      (baseChangeSheafPushforward fbar).obj
        (qEllAdicCompactSupportSheaf j ℓ) :=
  lowerShriekEquivariantPullback j f fbar h
    (qEllAdicSheafAbULift X ℓ)
    (qEllAdicCoefficientPullbackULift f ℓ)

/-- The genuine automorphism action on compactly supported rational
pro-étale cohomology of an equivariantly compactified scheme. -/
noncomputable def qEllAdicCompactSupportCohomologyActionOfEquivariantIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    (qEllAdicCompactSupportSheaf j ℓ).H degree →+
      (qEllAdicCompactSupportSheaf j ℓ).H degree :=
  lowerShriekCohomologyPullbackEndomorphism j f fbar h
    (qEllAdicSheafAbULift X ℓ)
    (qEllAdicCoefficientPullbackULift f ℓ) degree

/-- The compact-support action is `Q_ℓ`-linear. -/
theorem qEllAdicCompactSupportCohomologyActionOfEquivariantIso_scalar
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ℓ degree : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ])
    (x : (qEllAdicCompactSupportSheaf j ℓ).H degree) :
    qEllAdicCompactSupportCohomologyActionOfEquivariantIso
        j f fbar h ℓ degree
        (Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) degree x) =
      Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) degree
        (qEllAdicCompactSupportCohomologyActionOfEquivariantIso
          j f fbar h ℓ degree x) := by
  exact lowerShriekCohomologyPullbackEndomorphism_naturality
    j f fbar h (qEllAdicSheafAbULift X ℓ)
      (qEllAdicCoefficientPullbackULift f ℓ)
      (qEllAdicSheafAbScalarULift X ℓ r)
      (qEllAdicCoefficientPullbackULift_scalar f ℓ r) degree x

/-- Scalar-linear form of the equivariant compact-support action. -/
noncomputable def qEllAdicCompactSupportCohomologyLinearMapOfEquivariantIso
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    CompactlySupportedQEllAdicCohomology j pbar ℓ degree →ₗ[ℚ_[ℓ]]
      CompactlySupportedQEllAdicCohomology j pbar ℓ degree where
  toFun := qEllAdicCompactSupportCohomologyActionOfEquivariantIso
    j f fbar h ℓ degree
  map_add' :=
    (qEllAdicCompactSupportCohomologyActionOfEquivariantIso
      j f fbar h ℓ degree).map_add
  map_smul' := by
    intro r x
    exact qEllAdicCompactSupportCohomologyActionOfEquivariantIso_scalar
      j f fbar h ℓ degree r x

/-- The scalar-linear action induced by an equivariant automorphism on the
honest geometric compact-support cohomology over `Fbar_q`. -/
noncomputable def
    geometricCompactSupportCohomologyLinearMapOfEquivariantIso
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) (hf : f ≫ pX = pX) [IsIso f]
    (fbar : Xbar ⟶ Xbar) (hfbar : fbar ≫ pbar = pbar) [IsIso fbar]
    (hbar : f ≫ j = j ≫ fbar)
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree →ₗ[ℚ_[ℓ]]
      GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ℓ degree :=
  qEllAdicCompactSupportCohomologyLinearMapOfEquivariantIso
    (geometricCompactificationOpen q pX j pbar hj)
    (geometricCompactificationProjection q pbar)
    (geometricFiberMap q pX pX f hf)
    (geometricFiberMap q pbar pbar fbar hfbar)
    (geometricCompactificationOpen_equivariant
      q pX j pbar hj f hf fbar hfbar hbar) ℓ degree

/-- Basis-independent trace of the equivariant compact-support action. -/
noncomputable def qEllAdicCompactSupportCohomologyTraceOfEquivariantIso
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ℓ degree : ℕ) [Fact ℓ.Prime]
    [FiniteDimensional ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree)] : ℚ_[ℓ] :=
  LinearMap.trace ℚ_[ℓ]
    (CompactlySupportedQEllAdicCohomology j pbar ℓ degree)
    (qEllAdicCompactSupportCohomologyLinearMapOfEquivariantIso
      j pbar f fbar h ℓ degree)

/-- If every projection produced by base change is a homeomorphism,
pullback of continuous rational `ℓ`-adic functions is an isomorphism. -/
noncomputable def qEllAdicCoefficientComparisonIsoOfHomeomorph
    {X Y : Scheme.{u}} (f : X ⟶ Y) (ℓ : ℕ) [Fact ℓ.Prime]
    (h : ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    Y.qEllAdicSheafAb ℓ ≅
      (baseChangeSheafPushforward f).obj (X.qEllAdicSheafAb ℓ) where
  hom := qEllAdicCoefficientPullback f ℓ
  inv := by
    refine ⟨{ app := fun U ↦ ?_, naturality := ?_ }⟩
    · exact AddCommGrpCat.ofHom (ContinuousMap.compAddMonoidHom'
        ⟨(h U.unop).homeomorph.symm,
          (h U.unop).homeomorph.symm.continuous⟩)
    · intro U V g
      ext k
      change C(((baseChange f).obj U.unop).left, ℚ_[ℓ]) at k
      apply ContinuousMap.coe_injective
      funext x
      change k (((baseChange f).map g.unop).left.base
          ((h V.unop).homeomorph.symm x)) =
        k ((h U.unop).homeomorph.symm (g.unop.left.base x))
      congr 1
      apply (h U.unop).injective
      have hs : ((baseChange f).map g.unop).left ≫
          pullback.fst U.unop.hom f =
          pullback.fst V.unop.hom f ≫ g.unop.left := by
        change pullback.lift
              (pullback.fst V.unop.hom f ≫ g.unop.left)
              (pullback.snd V.unop.hom f) _ ≫
            pullback.fst U.unop.hom f = _
        exact pullback.lift_fst _ _ _
      have hx := congrArg
        (fun e ↦ e.base ((h V.unop).homeomorph.symm x)) hs
      change (pullback.fst U.unop.hom f).base
          (((baseChange f).map g.unop).left.base
            ((h V.unop).homeomorph.symm x)) =
        g.unop.left.base ((pullback.fst V.unop.hom f).base
          ((h V.unop).homeomorph.symm x)) at hx
      calc
        _ = g.unop.left.base ((pullback.fst V.unop.hom f).base
            ((h V.unop).homeomorph.symm x)) := hx
        _ = g.unop.left.base x := congrArg _
          ((h V.unop).homeomorph.apply_symm_apply x)
        _ = (pullback.fst U.unop.hom f).base
            ((h U.unop).homeomorph.symm (g.unop.left.base x)) :=
          ((h U.unop).homeomorph.apply_symm_apply _).symm
  hom_inv_id := by
    ext U k
    change C(U.unop.left, ℚ_[ℓ]) at k
    apply ContinuousMap.coe_injective
    funext x
    exact congrArg k ((h U.unop).homeomorph.apply_symm_apply x)
  inv_hom_id := by
    ext U k
    change C(((baseChange f).obj U.unop).left, ℚ_[ℓ]) at k
    apply ContinuousMap.coe_injective
    funext x
    exact congrArg k ((h U.unop).homeomorph.symm_apply_apply x)

/-- Extension by zero of the rational coefficient sheaf precomposed with
endomorphism base change. -/
noncomputable def baseChangedQEllAdicCompactSupportSheaf
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf (topology Xbar) Ab.{u + 1} :=
  (lowerShriek j).obj
    ((sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).obj
      ((baseChangeSheafPushforward f).obj (X.qEllAdicSheafAb ℓ)))

/-- Scalar multiplication on the extension by zero of the base-changed
rational coefficient sheaf. -/
noncomputable def baseChangedQEllAdicCompactSupportScalar
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    baseChangedQEllAdicCompactSupportSheaf j f ℓ ⟶
      baseChangedQEllAdicCompactSupportSheaf j f ℓ :=
  (lowerShriek j).map
    ((sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).map
      (baseChangedQEllAdicSheafScalar f ℓ r))

/-- The rational coefficient comparison passes through extension by zero. -/
noncomputable def qEllAdicCompactSupportCoefficientComparisonIsoOfHomeomorph
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime]
    (h : ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    qEllAdicCompactSupportSheaf j ℓ ≅
      baseChangedQEllAdicCompactSupportSheaf j f ℓ :=
  (lowerShriek j).mapIso
    ((sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph f ℓ h))

/-- Rational ell-adic coefficients are carried to rational ell-adic
coefficients by lower shriek along a scheme isomorphism. -/
noncomputable def lowerShriekQEllAdicIsoOfIso
    {X Y : Scheme.{u}} (e : X ≅ Y) (ℓ : ℕ) [Fact ℓ.Prime] :
    (lowerShriek e.hom).obj (qEllAdicSheafAbULift X ℓ) ≅
      qEllAdicSheafAbULift Y ℓ :=
  (lowerShriekIsoBaseChangeOfIso e.hom).app
      (qEllAdicSheafAbULift X ℓ) ≪≫
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ℓ
        (baseChangeIsHomeomorph_of_isIso e.hom)).symm

/-- Compact-support coefficient sheaves are invariant under changing the
open scheme by an isomorphism while retaining a common compactification. -/
noncomputable def qEllAdicCompactSupportSheafIsoOfOpenIso
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime] :
    qEllAdicCompactSupportSheaf (e.hom ≫ j) ℓ ≅
      qEllAdicCompactSupportSheaf j ℓ :=
  (lowerShriekCompIso e.hom j).symm.app
      (qEllAdicSheafAbULift X ℓ) ≪≫
    (lowerShriek j).mapIso (lowerShriekQEllAdicIsoOfIso e ℓ)

theorem lowerShriekQEllAdicIsoOfIso_hom_scalar
    {X Y : Scheme.{u}} (e : X ≅ Y) (ℓ : ℕ) [Fact ℓ.Prime]
    (r : ℚ_[ℓ]) :
    (lowerShriek e.hom).map (qEllAdicSheafAbScalarULift X ℓ r) ≫
        (lowerShriekQEllAdicIsoOfIso e ℓ).hom =
      (lowerShriekQEllAdicIsoOfIso e ℓ).hom ≫
        qEllAdicSheafAbScalarULift Y ℓ r := by
  let E := lowerShriekIsoBaseChangeOfIso e.hom
  let C : qEllAdicSheafAbULift Y ℓ ≅
      (baseChangeSheafPushforward e.hom).obj
        (qEllAdicSheafAbULift X ℓ) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ℓ
        (baseChangeIsHomeomorph_of_isIso e.hom))
  have hC_hom :
      qEllAdicSheafAbScalarULift Y ℓ r ≫ C.hom =
        C.hom ≫
          (baseChangeSheafPushforward e.hom).map
            (qEllAdicSheafAbScalarULift X ℓ r) := by
    change qEllAdicSheafAbScalarULift Y ℓ r ≫
        qEllAdicCoefficientPullbackULift e.hom ℓ = _
    exact qEllAdicCoefficientPullbackULift_scalar e.hom ℓ r
  have hC :
      (baseChangeSheafPushforward e.hom).map
          (qEllAdicSheafAbScalarULift X ℓ r) ≫ C.inv =
        C.inv ≫ qEllAdicSheafAbScalarULift Y ℓ r := by
    apply (cancel_epi C.hom).1
    rw [← Category.assoc, ← hC_hom]
    simp
  change (lowerShriek e.hom).map
      (qEllAdicSheafAbScalarULift X ℓ r) ≫
        E.hom.app (qEllAdicSheafAbULift X ℓ) ≫ C.inv =
      E.hom.app (qEllAdicSheafAbULift X ℓ) ≫ C.inv ≫
        qEllAdicSheafAbScalarULift Y ℓ r
  rw [← Category.assoc, E.hom.naturality]
  rw [Category.assoc, hC]

theorem qEllAdicCompactSupportSheafIsoOfOpenIso_hom_scalar
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ℓ : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    qEllAdicCompactSupportScalar (e.hom ≫ j) ℓ r ≫
        (qEllAdicCompactSupportSheafIsoOfOpenIso e j ℓ).hom =
      (qEllAdicCompactSupportSheafIsoOfOpenIso e j ℓ).hom ≫
        qEllAdicCompactSupportScalar j ℓ r := by
  let A := (lowerShriekCompIso e.hom j).symm
  let D := lowerShriekQEllAdicIsoOfIso e ℓ
  change (lowerShriek (e.hom ≫ j)).map
      (qEllAdicSheafAbScalarULift X ℓ r) ≫
        A.hom.app (qEllAdicSheafAbULift X ℓ) ≫
          (lowerShriek j).map D.hom =
      A.hom.app (qEllAdicSheafAbULift X ℓ) ≫
        (lowerShriek j).map D.hom ≫
          (lowerShriek j).map (qEllAdicSheafAbScalarULift Y ℓ r)
  rw [← Category.assoc, A.hom.naturality]
  change A.hom.app (qEllAdicSheafAbULift X ℓ) ≫
      (lowerShriek j).map
          ((lowerShriek e.hom).map
            (qEllAdicSheafAbScalarULift X ℓ r)) ≫
        (lowerShriek j).map D.hom = _
  rw [← (lowerShriek j).map_comp]
  rw [lowerShriekQEllAdicIsoOfIso_hom_scalar]
  rw [(lowerShriek j).map_comp]

/-- The induced additive equivalence on compactly-supported cohomology. -/
noncomputable def qEllAdicCompactSupportCohomologyAddEquivOfOpenIso
    {S X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    (p : Z ⟶ S) [IsOpenImmersion j] [IsProper p]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    CompactlySupportedQEllAdicCohomology (e.hom ≫ j) p ℓ degree ≃+
      CompactlySupportedQEllAdicCohomology j p ℓ degree := by
  let E := qEllAdicCompactSupportSheafIsoOfOpenIso e j ℓ
  exact
    { toFun := Sheaf.H.map E.hom degree
      invFun := Sheaf.H.map E.inv degree
      left_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      right_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      map_add' := (Sheaf.H.map E.hom degree).map_add }

/-- The compact-support comparison is linear over the rational ell-adic
coefficient field. -/
noncomputable def qEllAdicCompactSupportCohomologyLinearEquivOfOpenIso
    {S X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    (p : Z ⟶ S) [IsOpenImmersion j] [IsProper p]
    (ℓ degree : ℕ) [Fact ℓ.Prime] :
    CompactlySupportedQEllAdicCohomology (e.hom ≫ j) p ℓ degree ≃ₗ[ℚ_[ℓ]]
      CompactlySupportedQEllAdicCohomology j p ℓ degree := by
  let A := qEllAdicCompactSupportCohomologyAddEquivOfOpenIso
    e j p ℓ degree
  exact
    { A with
      map_smul' := by
        intro r x
        change (qEllAdicCompactSupportSheaf (e.hom ≫ j) ℓ).H degree at x
        change Sheaf.H.map
            (qEllAdicCompactSupportSheafIsoOfOpenIso e j ℓ).hom degree
              (Sheaf.H.map
                (qEllAdicCompactSupportScalar (e.hom ≫ j) ℓ r)
                degree x) =
          Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) degree
            (Sheaf.H.map
              (qEllAdicCompactSupportSheafIsoOfOpenIso e j ℓ).hom
              degree x)
        rw [← Sheaf.H.map_comp_apply,
          qEllAdicCompactSupportSheafIsoOfOpenIso_hom_scalar,
          Sheaf.H.map_comp_apply] }

lemma qEllAdicCompactSupportCoefficientComparison_hom_scalar
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime]
    (h : ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom f).base)
    (r : ℚ_[ℓ]) :
    qEllAdicCompactSupportScalar j ℓ r ≫
        (qEllAdicCompactSupportCoefficientComparisonIsoOfHomeomorph
          j f ℓ h).hom =
      (qEllAdicCompactSupportCoefficientComparisonIsoOfHomeomorph
          j f ℓ h).hom ≫
        baseChangedQEllAdicCompactSupportScalar j f ℓ r := by
  unfold qEllAdicCompactSupportScalar
    qEllAdicCompactSupportSheaf
    qEllAdicCompactSupportCoefficientComparisonIsoOfHomeomorph
    baseChangedQEllAdicCompactSupportScalar
    baseChangedQEllAdicCompactSupportSheaf
    qEllAdicSheafAbULift
    qEllAdicSheafAbScalarULift
    qEllAdicCoefficientComparisonIsoOfHomeomorph
  simp only [Functor.mapIso_hom]
  rw [← (lowerShriek j).map_comp,
    ← (sheafCompose (topology X)
      AddCommGrpCat.uliftFunctor.{u + 1}).map_comp,
    qEllAdicCoefficientPullback_scalar,
    (sheafCompose (topology X)
      AddCommGrpCat.uliftFunctor.{u + 1}).map_comp,
    (lowerShriek j).map_comp]

@[simp]
lemma baseChangedQEllAdicCompactSupportScalar_zero
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] :
    baseChangedQEllAdicCompactSupportScalar j f ℓ 0 = 0 := by
  unfold baseChangedQEllAdicCompactSupportScalar
    baseChangedQEllAdicSheafScalar
  simp
  rfl

@[simp]
lemma baseChangedQEllAdicCompactSupportScalar_one
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] :
    baseChangedQEllAdicCompactSupportScalar j f ℓ 1 = 𝟙 _ := by
  unfold baseChangedQEllAdicCompactSupportScalar
    baseChangedQEllAdicSheafScalar
  simp
  rfl

@[simp]
lemma baseChangedQEllAdicCompactSupportScalar_add
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    baseChangedQEllAdicCompactSupportScalar j f ℓ (r + s) =
      baseChangedQEllAdicCompactSupportScalar j f ℓ r +
        baseChangedQEllAdicCompactSupportScalar j f ℓ s := by
  unfold baseChangedQEllAdicCompactSupportScalar
    baseChangedQEllAdicSheafScalar
  simp
  rfl

@[simp]
lemma baseChangedQEllAdicCompactSupportScalar_mul
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ : ℕ) [Fact ℓ.Prime] (r s : ℚ_[ℓ]) :
    baseChangedQEllAdicCompactSupportScalar j f ℓ (r * s) =
      baseChangedQEllAdicCompactSupportScalar j f ℓ s ≫
        baseChangedQEllAdicCompactSupportScalar j f ℓ r := by
  unfold baseChangedQEllAdicCompactSupportScalar
    baseChangedQEllAdicSheafScalar
  simp
  rfl

abbrev BaseChangedCompactlySupportedQEllAdicCohomology
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ degree : ℕ) [Fact ℓ.Prime] : Type (u + 1) :=
  (baseChangedQEllAdicCompactSupportSheaf j f ℓ).H degree

noncomputable def baseChangedCompactlySupportedQEllAdicCohomologyScalar
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ degree : ℕ) [Fact ℓ.Prime] (r : ℚ_[ℓ]) :
    BaseChangedCompactlySupportedQEllAdicCohomology j f ℓ degree →+
      BaseChangedCompactlySupportedQEllAdicCohomology j f ℓ degree :=
  Sheaf.H.map (baseChangedQEllAdicCompactSupportScalar j f ℓ r) degree

noncomputable instance baseChangedCompactlySupportedQEllAdicCohomologySMul
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ degree : ℕ) [Fact ℓ.Prime] :
    SMul ℚ_[ℓ] (BaseChangedCompactlySupportedQEllAdicCohomology
      j f ℓ degree) :=
  ⟨fun r ↦
    baseChangedCompactlySupportedQEllAdicCohomologyScalar j f ℓ degree r⟩

noncomputable instance baseChangedCompactlySupportedQEllAdicCohomologyModule
    {X Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) (ℓ degree : ℕ) [Fact ℓ.Prime] :
    Module ℚ_[ℓ] (BaseChangedCompactlySupportedQEllAdicCohomology
      j f ℓ degree) :=
  Module.ofMinimalAxioms
    (fun r x y ↦
      (baseChangedCompactlySupportedQEllAdicCohomologyScalar
        j f ℓ degree r).map_add x y)
    (fun r s x ↦ by
      change Sheaf.H.map
        (baseChangedQEllAdicCompactSupportScalar j f ℓ (r + s)) degree x = _
      rw [baseChangedQEllAdicCompactSupportScalar_add,
        Sheaf.H.map_add_apply]
      rfl)
    (fun r s x ↦ by
      change Sheaf.H.map
        (baseChangedQEllAdicCompactSupportScalar j f ℓ (r * s)) degree x = _
      rw [baseChangedQEllAdicCompactSupportScalar_mul,
        Sheaf.H.map_comp_apply]
      rfl)
    (fun x ↦ by
      change Sheaf.H.map
        (baseChangedQEllAdicCompactSupportScalar j f ℓ 1) degree x = x
      rw [baseChangedQEllAdicCompactSupportScalar_one,
        Sheaf.H.map_id_apply])

/-- The compact-support universal-homeomorphism comparison is `Q_ℓ`-linear
on cohomology. -/
noncomputable def compactlySupportedQEllAdicCohomologyComparisonLinearEquivOfHomeomorph
    {S X Xbar : Scheme.{u}} (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) (ℓ degree : ℕ) [Fact ℓ.Prime]
    (h : ∀ U : X.ProEt, IsHomeomorph (pullback.fst U.hom f).base) :
    CompactlySupportedQEllAdicCohomology j pbar ℓ degree ≃ₗ[ℚ_[ℓ]]
      BaseChangedCompactlySupportedQEllAdicCohomology j f ℓ degree := by
  let e := qEllAdicCompactSupportCoefficientComparisonIsoOfHomeomorph
    j f ℓ h
  let eAdd :
      CompactlySupportedQEllAdicCohomology j pbar ℓ degree ≃+
        BaseChangedCompactlySupportedQEllAdicCohomology j f ℓ degree := by
    refine
      { toFun := Sheaf.H.map e.hom degree
        invFun := Sheaf.H.map e.inv degree
        left_inv := ?_
        right_inv := ?_
        map_add' := (Sheaf.H.map e.hom degree).map_add }
    · intro x
      change (qEllAdicCompactSupportSheaf j ℓ).H degree at x
      change Sheaf.H.map e.inv degree (Sheaf.H.map e.hom degree x) = x
      rw [← Sheaf.H.map_comp_apply]
      simp [e]
    · intro x
      change (baseChangedQEllAdicCompactSupportSheaf j f ℓ).H degree at x
      change Sheaf.H.map e.hom degree (Sheaf.H.map e.inv degree x) = x
      rw [← Sheaf.H.map_comp_apply]
      simp [e]
  refine { eAdd with map_smul' := ?_ }
  intro r x
  change (qEllAdicCompactSupportSheaf j ℓ).H degree at x
  change Sheaf.H.map e.hom degree
      (Sheaf.H.map (qEllAdicCompactSupportScalar j ℓ r) degree x) =
    Sheaf.H.map (baseChangedQEllAdicCompactSupportScalar j f ℓ r) degree
      (Sheaf.H.map e.hom degree x)
  rw [← Sheaf.H.map_comp_apply,
    qEllAdicCompactSupportCoefficientComparison_hom_scalar,
    Sheaf.H.map_comp_apply]

end AlgebraicGeometry.Scheme.ProEt

open CategoryTheory Limits
open scoped ModuleCat.Algebra

namespace AlgebraicGeometry

universe u

/-- Continuous functions with values in a topological commutative ring,
as a presheaf of commutative rings. -/
def continuousMapPresheafCommRing
    (R : Type) [TopologicalSpace R] [CommRing R]
    [IsTopologicalRing R] :
    Functor (Scheme.{u}ᵒᵖ) CommRingCat.{u + 1} where
  obj U := CommRingCat.of (ULift.{u + 1} C(U.unop, R))
  map {U V} f := CommRingCat.ofHom
    { toFun := fun g ↦ ⟨ContinuousMap.comp g.down f.unop.base.hom⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  map_id _ := rfl
  map_comp _ _ := rfl

variable (R : Type) [TopologicalSpace R] [CommRing R]
  [IsTopologicalRing R]

lemma isSheaf_fpqcTopology_continuousMapPresheafCommRing :
    Presheaf.IsSheaf Scheme.fpqcTopology.{u}
      (continuousMapPresheafCommRing.{u} R) := by
  let : ReflectsLimitsOfSize.{u, u + 1}
      (forget CommRingCat.{u + 1}) :=
    reflectsLimits_of_reflectsIsomorphisms
  apply Presheaf.isSheaf_of_isSheaf_comp
    (C := Scheme.{u}) (A := CommRingCat.{u + 1}) (B := Type (u + 1))
    Scheme.fpqcTopology.{u} (continuousMapPresheafCommRing.{u} R)
    (forget CommRingCat.{u + 1})
  change Presheaf.IsSheaf Scheme.fpqcTopology.{u}
    (continuousMapPresheaf R ⋙ uliftFunctor.{u + 1})
  rw [isSheaf_iff_isSheaf_of_type,
    Presieve.isSheaf_comp_uliftFunctor_iff,
    ← isSheaf_iff_isSheaf_of_type]
  exact isSheaf_fpqcTopology_continuousMapPresheaf R

namespace Scheme

variable (X : Scheme.{u})

/-- The continuous `Q_ℓ`-valued commutative-ring sheaf on the pro-étale
site. -/
noncomputable def qEllAdicCommRingSheaf (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf (ProEt.topology X) CommRingCat.{u + 1} :=
  ((ProEt.forget X ⋙ Over.forget _).sheafPushforwardContinuous
      _ _ proetaleTopology).obj
    ⟨continuousMapPresheafCommRing.{u} ℚ_[ℓ],
      .of_le proetaleTopology_le_fpqcTopology <|
        isSheaf_fpqcTopology_continuousMapPresheafCommRing (ℚ_[ℓ])⟩

/-- The same coefficient ring sheaf viewed in `RingCat`, as required by
`SheafOfModules`. -/
noncomputable def qEllAdicRingSheaf (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf (ProEt.topology X) RingCat.{u + 1} :=
  (sheafCompose (ProEt.topology X)
    (forget₂ CommRingCat.{u + 1} RingCat.{u + 1})).obj
      (X.qEllAdicCommRingSheaf ℓ)

/-- The constant local section attached to a scalar in `Q_ℓ`. -/
noncomputable def qEllAdicScalar
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ) (r : ℚ_[ℓ]) :
    (X.qEllAdicRingSheaf ℓ).obj.obj U := by
  change (X.qEllAdicCommRingSheaf ℓ).obj.obj U
  dsimp [qEllAdicCommRingSheaf, continuousMapPresheafCommRing]
  exact ⟨ContinuousMap.const _ r⟩

@[simp]
lemma qEllAdicRingSheaf_map_scalar
    (ℓ : ℕ) [Fact ℓ.Prime] {U V : X.ProEtᵒᵖ} (f : U ⟶ V)
    (r : ℚ_[ℓ]) :
    (X.qEllAdicRingSheaf ℓ).obj.map f
        (qEllAdicScalar X ℓ U r) = qEllAdicScalar X ℓ V r := by
  rfl

@[simp] lemma qEllAdicScalar_zero
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ) :
    qEllAdicScalar X ℓ U 0 = 0 := by rfl

@[simp] lemma qEllAdicScalar_one
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ) :
    qEllAdicScalar X ℓ U 1 = 1 := by rfl

@[simp] lemma qEllAdicScalar_add
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ) (r s : ℚ_[ℓ]) :
    qEllAdicScalar X ℓ U (r + s) =
      qEllAdicScalar X ℓ U r + qEllAdicScalar X ℓ U s := by rfl

@[simp] lemma qEllAdicScalar_mul
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ) (r s : ℚ_[ℓ]) :
    qEllAdicScalar X ℓ U (r * s) =
      qEllAdicScalar X ℓ U r * qEllAdicScalar X ℓ U s := by rfl

lemma qEllAdicRingSheaf_mul_comm
    (ℓ : ℕ) [Fact ℓ.Prime] (U : X.ProEtᵒᵖ)
    (a b : (X.qEllAdicRingSheaf ℓ).obj.obj U) : a * b = b * a := by
  dsimp [qEllAdicRingSheaf, qEllAdicCommRingSheaf,
    continuousMapPresheafCommRing] at a b ⊢
  exact congrArg ULift.up (mul_comm a.down b.down)

/-- The rank-one coefficient sheaf as a sheaf of modules over the continuous
`Q_ℓ` ring sheaf. -/
noncomputable def qEllAdicModuleSheaf (ℓ : ℕ) [Fact ℓ.Prime] :
    SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ) :=
  SheafOfModules.unit (R := X.qEllAdicRingSheaf ℓ)

noncomputable def qEllAdicModuleHomSMul
    (ℓ : ℕ) [Fact ℓ.Prime]
    {M N : SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)}
    (r : ℚ_[ℓ]) (f : M ⟶ N) : M ⟶ N where
  val :=
    { app := fun U ↦ ModuleCat.ofHom
        { toFun := fun x ↦
            qEllAdicScalar X ℓ U r • f.val.app U x
          map_add' := fun x y ↦ by simp
          map_smul' := fun s x ↦ by
            simp only [map_smul, smul_smul, RingHom.id_apply]
            rw [qEllAdicRingSheaf_mul_comm] }
      naturality := fun {U V} g ↦ by
        ext x
        change
          qEllAdicScalar X ℓ V r • f.val.app V (M.val.map g x) =
            N.val.map g
              (qEllAdicScalar X ℓ U r • f.val.app U x)
        rw [PresheafOfModules.naturality_apply]
        rw [PresheafOfModules.map_smul]
        rw [qEllAdicRingSheaf_map_scalar]
        rfl }

noncomputable instance qEllAdicModuleHomSMulInst
    (ℓ : ℕ) [Fact ℓ.Prime]
    (M N : SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)) :
    SMul ℚ_[ℓ] (M ⟶ N) :=
  ⟨fun r f ↦ qEllAdicModuleHomSMul X ℓ r f⟩

@[simp]
lemma qEllAdicModuleHom_smul_app_apply
    (ℓ : ℕ) [Fact ℓ.Prime]
    {M N : SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)}
    (r : ℚ_[ℓ]) (f : M ⟶ N) (U : X.ProEtᵒᵖ) (x : M.val.obj U) :
    (r • f).val.app U x = qEllAdicScalar X ℓ U r • f.val.app U x := rfl

noncomputable instance qEllAdicModuleHomModule
    (ℓ : ℕ) [Fact ℓ.Prime]
    (M N : SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)) :
    Module ℚ_[ℓ] (M ⟶ N) where
  one_smul f := by
    ext U x
    simp
  mul_smul r s f := by
    ext U x
    simp [smul_smul]
  smul_zero r := by
    ext U x
    change qEllAdicScalar X ℓ U r • (0 : N.val.obj U) = 0
    simp
  smul_add r f g := by
    ext U x
    simp [smul_add]
  add_smul r s f := by
    ext U x
    simp [add_smul]
  zero_smul f := by
    ext U x
    change qEllAdicScalar X ℓ U 0 • f.val.app U x = (0 : N.val.obj U)
    simp

noncomputable instance qEllAdicModuleCategoryLinear
    (ℓ : ℕ) [Fact ℓ.Prime] :
    Linear ℚ_[ℓ]
      (SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)) where
  smul_comp _ _ _ r f g := by
    ext U x
    simp
  comp_smul _ _ _ f r g := by
    ext U x
    simp

/-- Rational `ℓ`-adic cohomology as Ext in the abelian category of
modules over the continuous `Q_ℓ` ring sheaf. -/
noncomputable def QEllAdicCohomology (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    Type (u + 2) :=
  let C := SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)
  letI := CategoryTheory.HasExt.standard C
  CategoryTheory.Abelian.Ext (X.qEllAdicModuleSheaf ℓ)
    (X.qEllAdicModuleSheaf ℓ) n

noncomputable instance (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    AddCommGroup (X.QEllAdicCohomology ℓ n) := by
  dsimp only [QEllAdicCohomology]
  infer_instance

noncomputable instance (ℓ : ℕ) [Fact ℓ.Prime] (n : ℕ) :
    Module ℚ_[ℓ] (X.QEllAdicCohomology ℓ n) := by
  let C := SheafOfModules.{u + 1} (X.qEllAdicRingSheaf ℓ)
  letI := CategoryTheory.HasExt.standard C
  change Module ℚ_[ℓ]
    (CategoryTheory.Abelian.Ext (X.qEllAdicModuleSheaf ℓ)
      (X.qEllAdicModuleSheaf ℓ) n)
  infer_instance

end Scheme
end AlgebraicGeometry

namespace Erdos157


/-! ## Carry-compatible expansion of a target integer -/

namespace TargetExpansion

open AuxiliaryDigits

/-- The zero-indexed odd-position radix `q^(2i+1)-1`. -/
def oddRadix (q i : ℕ) : ℕ := q ^ (2 * i + 1) - 1

theorem oddRadix_pos {q i : ℕ} (hq : 2 ≤ q) : 0 < oddRadix q i := by
  unfold oddRadix
  have hp : 2 ≤ q ^ (2 * i + 1) := by
    have hone : 1 ≤ q ^ (2 * i) := Nat.one_le_pow _ _ (by omega)
    have hqle : q ≤ q ^ (2 * i) * q := by
      simpa only [one_mul] using Nat.mul_le_mul_right q hone
    exact hq.trans (by simpa only [pow_succ] using hqle)
  omega

theorem oddRadix_two_le {q i : ℕ} (hq : 3 ≤ q) : 2 ≤ oddRadix q i := by
  unfold oddRadix
  have hp : 3 ≤ q ^ (2 * i + 1) := by
    have hone : 1 ≤ q ^ (2 * i) := Nat.one_le_pow _ _ (by omega)
    have hqle : q ≤ q ^ (2 * i) * q := by
      simpa only [one_mul] using Nat.mul_le_mul_right q hone
    exact hq.trans (by simpa only [pow_succ] using hqle)
  omega

/-- The normalized odd-position digit obtained by Euclidean division. -/
def xDigit (q i m : ℕ) : ℕ := m % oddRadix q i

/-- The auxiliary digit congruent to the quotient after removing the odd
position. -/
def yDigit (q i m : ℕ) : ℕ :=
  compatibleTripleDigit (m / oddRadix q i)

/-- The quotient remaining after removing a complete odd/even digit pair. -/
def next (q i m : ℕ) : ℕ :=
  (m / oddRadix q i - yDigit q i m) / 103

theorem xDigit_lt {q i m : ℕ} (hq : 2 ≤ q) :
    xDigit q i m < oddRadix q i :=
  Nat.mod_lt _ (oddRadix_pos hq)

theorem yDigit_bounds (q i m : ℕ) :
    39 ≤ yDigit q i m ∧ yDigit q i m ≤ 141 :=
  compatibleTripleDigit_bounds _

theorem yDigit_carryCovered (q i m : ℕ) :
    CarryCovered auxiliaryDigitSet (yDigit q i m) :=
  compatibleTripleDigit_carryCovered _

/-- Pilatte's stopping-test complement makes the quotient large enough for
the chosen representative `yDigit` to be subtracted in `ℕ`. -/
theorem yDigit_le_div {q i m : ℕ} (hq : 2 ≤ q)
    (hlarge : 6 * 103 * q ^ (2 * i + 1) < m) :
    yDigit q i m ≤ m / oddRadix q i := by
  have hB : 0 < oddRadix q i := oddRadix_pos hq
  have hB_le : oddRadix q i ≤ q ^ (2 * i + 1) := by
    unfold oddRadix
    omega
  have hquot : 618 ≤ m / oddRadix q i := by
    apply (Nat.le_div_iff_mul_le hB).2
    omega
  have hy := (yDigit_bounds q i m).2
  omega

/-- Exact reconstruction after a complete digit-pair division step. -/
theorem reconstruct {q i m : ℕ} (hq : 2 ≤ q)
    (hlarge : 6 * 103 * q ^ (2 * i + 1) < m) :
    m = xDigit q i m + oddRadix q i *
      (yDigit q i m + 103 * next q i m) := by
  have hB : 0 < oddRadix q i := oddRadix_pos hq
  have hy : yDigit q i m ≤ m / oddRadix q i :=
    yDigit_le_div hq hlarge
  have hmod : Nat.ModEq 103 (yDigit q i m) (m / oddRadix q i) := by
    exact compatibleTripleDigit_modEq _
  have hdvd : 103 ∣ m / oddRadix q i - yDigit q i m :=
    (Nat.modEq_iff_dvd' hy).mp hmod
  have hdiff : m / oddRadix q i - yDigit q i m =
      103 * next q i m := by
    rw [next]
    have hzero : (m / oddRadix q i - yDigit q i m) % 103 = 0 :=
      Nat.mod_eq_zero_of_dvd hdvd
    nth_rw 1 [MixedRadix.digit_decomposition 103
      (m / oddRadix q i - yDigit q i m)]
    rw [hzero, zero_add]
  have hquot : m / oddRadix q i =
      yDigit q i m + 103 * next q i m := by
    omega
  calc
    m = xDigit q i m + oddRadix q i * (m / oddRadix q i) := by
      exact MixedRadix.digit_decomposition (oddRadix q i) m
    _ = xDigit q i m + oddRadix q i *
        (yDigit q i m + 103 * next q i m) := by rw [hquot]

/-- Each nonterminal division step leaves a quotient at least three. -/
theorem three_le_next {q i m : ℕ} (hq : 2 ≤ q)
    (hlarge : 6 * 103 * q ^ (2 * i + 1) < m) :
    3 ≤ next q i m := by
  have hB : 0 < oddRadix q i := oddRadix_pos hq
  have hB_le : oddRadix q i ≤ q ^ (2 * i + 1) := by
    unfold oddRadix
    omega
  have hquot : 618 ≤ m / oddRadix q i := by
    apply (Nat.le_div_iff_mul_le hB).2
    omega
  have hy := (yDigit_bounds q i m).2
  rw [next, Nat.le_div_iff_mul_le (by omega : 0 < 103)]
  omega

/-- The quotient strictly decreases, so iterating nonterminal digit steps
terminates without any extra recursion limit. -/
theorem next_lt {q i m : ℕ} (hq : 2 ≤ q)
    (hlarge : 6 * 103 * q ^ (2 * i + 1) < m) :
    next q i m < m := by
  have hB : 0 < oddRadix q i := oddRadix_pos hq
  have hqpos : 0 < m / oddRadix q i := by
    have := yDigit_le_div hq hlarge
    have hy := (yDigit_bounds q i m).1
    omega
  have hdiv : (m / oddRadix q i - yDigit q i m) / 103 <
      m / oddRadix q i := by
    have hsub : m / oddRadix q i - yDigit q i m < m / oddRadix q i := by
      have hy := (yDigit_bounds q i m).1
      omega
    exact (Nat.div_le_self _ _).trans_lt hsub
  have hquot_le : m / oddRadix q i ≤ m := Nat.div_le_self _ _
  unfold next
  omega

/-- The terminating digit-division process.  A `step` records one complete
odd/auxiliary digit pair; `stop` records the remaining top digit. -/
inductive IsExpansion (q : ℕ) : ℕ → ℕ → Prop
  | stop {i m : ℕ} (hm : 3 ≤ m)
      (hsmall : m ≤ 6 * 103 * q ^ (2 * i + 1)) : IsExpansion q i m
  | step {i m : ℕ} (hlarge : 6 * 103 * q ^ (2 * i + 1) < m)
      (tail : IsExpansion q (i + 1) (next q i m)) : IsExpansion q i m

/-- Strict descent of `next` proves that every target at least three has a
finite carry-compatible expansion. -/
theorem exists_isExpansion (q : ℕ) (hq : 2 ≤ q) :
    ∀ (i m : ℕ), 3 ≤ m → IsExpansion q i m := by
  intro i m
  induction m using Nat.strong_induction_on generalizing i with
  | h m ih =>
      intro hm
      by_cases hsmall : m ≤ 6 * 103 * q ^ (2 * i + 1)
      · exact .stop hm hsmall
      · have hlarge : 6 * 103 * q ^ (2 * i + 1) < m := by omega
        exact .step hlarge
          (ih (next q i m) (next_lt hq hlarge) (i + 1)
            (three_le_next hq hlarge))

/-- Alternating normalized odd digits and carry-compatible auxiliary digits,
starting at coordinate `i`. -/
def ValidDigits (q i : ℕ) : List (ℕ × ℕ) → Prop
  | [] => True
  | (b, x) :: (p, y) :: ds =>
      b = oddRadix q i ∧ p = 103 ∧ x < b ∧ y < 206 ∧
        CarryCovered auxiliaryDigitSet y ∧ ValidDigits q (i + 1) ds
  | _ => False

/-- The number of complete digit pairs in a valid target digit string. -/
def levelCount (ds : List (ℕ × ℕ)) : ℕ := ds.length / 2

/-- An expansion proof yields an exact generalized-base encoding whose even
digits can absorb every incoming carry in `{0,1,2}`. -/
theorem IsExpansion.exists_encoding {q i m : ℕ} (hq : 2 ≤ q)
    (h : IsExpansion q i m) :
    ∃ (ds : List (ℕ × ℕ)) (z : ℕ),
      ValidDigits q i ds ∧
      m = MixedRadix.encode ds + MixedRadix.place ds * z ∧
      3 ≤ z ∧
      z ≤ 6 * 103 * q ^ (2 * (i + levelCount ds) + 1) := by
  induction h with
  | stop hm hsmall =>
      refine ⟨[], _, by simp [ValidDigits], ?_, hm, ?_⟩
      · simp [MixedRadix.encode, MixedRadix.place]
      · simpa [levelCount] using hsmall
  | @step i m hlarge tail ih =>
      obtain ⟨ds, z, hvalid, hrepr, hz, hsmall⟩ := ih
      refine ⟨(oddRadix q i, xDigit q i m) ::
        (103, yDigit q i m) :: ds, z, ?_, ?_, hz, ?_⟩
      · have hylt : yDigit q i m < 206 :=
          (yDigit_bounds q i m).2.trans_lt (by norm_num)
        simp [ValidDigits, xDigit_lt hq, hylt,
          yDigit_carryCovered q i m, hvalid]
      · calc
          m = xDigit q i m + oddRadix q i *
              (yDigit q i m + 103 * next q i m) := reconstruct hq hlarge
          _ = MixedRadix.encode ((oddRadix q i, xDigit q i m) ::
                (103, yDigit q i m) :: ds) +
              MixedRadix.place ((oddRadix q i, xDigit q i m) ::
                (103, yDigit q i m) :: ds) * z := by
            rw [hrepr]
            simp only [MixedRadix.encode_cons, MixedRadix.place_cons]
            ring
      · rw [show levelCount ((oddRadix q i, xDigit q i m) ::
            (103, yDigit q i m) :: ds) = levelCount ds + 1 by
          unfold levelCount
          simp only [List.length_cons]
          omega]
        rw [← show i + 1 + levelCount ds = i + (levelCount ds + 1) by omega]
        exact hsmall

/-- The published target-expansion lemma, in an exact list-based form,
specialized to the explicit auxiliary modulus `103`. -/
theorem exists_carryCompatible_encoding {q m : ℕ} (hq : 2 ≤ q)
    (hm : 3 ≤ m) :
    ∃ (ds : List (ℕ × ℕ)) (z : ℕ),
      ValidDigits q 0 ds ∧
      m = MixedRadix.encode ds + MixedRadix.place ds * z ∧
      3 ≤ z ∧
      z ≤ 6 * 103 * q ^ (2 * levelCount ds + 1) := by
  obtain ⟨ds, z, hvalid, hrepr, hz, hsmall⟩ :=
    (exists_isExpansion q hq 0 m hm).exists_encoding hq
  exact ⟨ds, z, hvalid, hrepr, hz, by simpa using hsmall⟩

end TargetExpansion

/-! ## Numerical construction parameter -/

/-- Pilatte's exponent parameter `c = 0.35`.  Rational arithmetic is used
here so the three strict inequalities driving the construction are exact. -/
def exponentC : ℚ := 7 / 20

theorem exponentC_conditions :
    0 < 3 * exponentC - 1 ∧
      exponentC < (1 - exponentC) ^ 2 ∧
      2 * exponentC < 1 := by
  norm_num [exponentC]

/-! ### A concrete coefficient prime for the unconditional specialization

Sawin's estimate is uniform once the coefficient field is fixed and sufficiently
large.  Using a certified Mersenne prime lets the later numerical comparison use
very coarse bounds, while keeping primality entirely kernel checked.
-/

/-- The concrete prime coefficient field used in the final construction. -/
def sawinPrime : ℕ := mersenne 521

theorem sawinPrime_prime : sawinPrime.Prime := by
  unfold sawinPrime
  exact lucas_lehmer_sufficiency _ (by simp) (by norm_num)

instance sawinPrime_fact : Fact sawinPrime.Prime := ⟨sawinPrime_prime⟩

theorem sawinPrime_ge_103 : 103 ≤ sawinPrime := by
  have hpow : 2 ^ 7 ≤ 2 ^ 521 :=
    Nat.pow_le_pow_right (by omega) (by omega)
  norm_num [sawinPrime, mersenne] at hpow ⊢
  omega

theorem two_pow_500_le_sawinPrime : 2 ^ 500 ≤ sawinPrime := by
  have hpow : 2 ^ 501 ≤ 2 ^ 521 :=
    Nat.pow_le_pow_right (by omega) (by omega)
  have hone : 1 ≤ 2 ^ 500 := Nat.one_le_pow 500 2 (by omega)
  have hstep : 2 ^ 500 + 1 ≤ 2 ^ 501 := by
    rw [show 501 = 500 + 1 by omega, pow_succ]
    omega
  unfold sawinPrime mersenne
  omega

/-! ## Polynomial degree infrastructure -/

namespace PolynomialInfrastructure

/-- Over a prime field there is a monic irreducible polynomial of every
positive degree.  We obtain it as the minimal polynomial of a primitive
element of Mathlib's degree-`n` Galois field. -/
theorem exists_monic_irreducible_natDegree (p n : ℕ) [Fact p.Prime]
    (hn : n ≠ 0) :
    ∃ f : Polynomial (ZMod p),
      f.Monic ∧ Irreducible f ∧ f.natDegree = n := by
  let E := GaloisField p n
  let hprim := Field.exists_primitive_element (ZMod p) E
  let α : E := Classical.choose hprim
  have hα : IntermediateField.adjoin (ZMod p) {α} = ⊤ :=
    Classical.choose_spec hprim
  have hi : IsIntegral (ZMod p) α := Algebra.IsIntegral.isIntegral α
  refine ⟨minpoly (ZMod p) α, minpoly.monic hi, minpoly.irreducible hi, ?_⟩
  calc
    (minpoly (ZMod p) α).natDegree = Module.finrank (ZMod p) E :=
      (Field.primitive_element_iff_minpoly_natDegree_eq (ZMod p) α).1 hα
    _ = n := GaloisField.finrank p hn

/-- A fixed monic irreducible of degree `2i+1`; this is Pilatte's `g_{i+1}`
with zero-based indexing. -/
noncomputable def auxiliaryIrreducible (p : ℕ) [Fact p.Prime] (i : ℕ) :
    Polynomial (ZMod p) :=
  Classical.choose (exists_monic_irreducible_natDegree p (2 * i + 1) (by omega))

theorem auxiliaryIrreducible_monic (p : ℕ) [Fact p.Prime] (i : ℕ) :
    (auxiliaryIrreducible p i).Monic :=
  (Classical.choose_spec
    (exists_monic_irreducible_natDegree p (2 * i + 1) (by omega))).1

theorem auxiliaryIrreducible_irreducible (p : ℕ) [Fact p.Prime] (i : ℕ) :
    Irreducible (auxiliaryIrreducible p i) :=
  (Classical.choose_spec
    (exists_monic_irreducible_natDegree p (2 * i + 1) (by omega))).2.1

theorem auxiliaryIrreducible_natDegree (p : ℕ) [Fact p.Prime] (i : ℕ) :
    (auxiliaryIrreducible p i).natDegree = 2 * i + 1 :=
  (Classical.choose_spec
    (exists_monic_irreducible_natDegree p (2 * i + 1) (by omega))).2.2

/-- Distinct auxiliary irreducibles are coprime. -/
theorem auxiliaryIrreducible_coprime (p : ℕ) [Fact p.Prime]
    {i j : ℕ} (hij : i ≠ j) :
    IsCoprime (auxiliaryIrreducible p i) (auxiliaryIrreducible p j) := by
  rw [(auxiliaryIrreducible_irreducible p i).coprime_iff_not_dvd]
  intro hdvd
  have hassoc := (auxiliaryIrreducible_irreducible p i).associated_of_dvd
    (auxiliaryIrreducible_irreducible p j) hdvd
  have heq : auxiliaryIrreducible p i = auxiliaryIrreducible p j :=
    Polynomial.eq_of_monic_of_associated
      (auxiliaryIrreducible_monic p i) (auxiliaryIrreducible_monic p j) hassoc
  have hdeg := congrArg Polynomial.natDegree heq
  rw [auxiliaryIrreducible_natDegree, auxiliaryIrreducible_natDegree] at hdeg
  omega

/-- The product of the first `k` odd-degree auxiliary irreducibles. -/
noncomputable def modulusProduct (p k : ℕ) [Fact p.Prime] :
    Polynomial (ZMod p) :=
  ∏ i ∈ Finset.range k, auxiliaryIrreducible p i

theorem modulusProduct_monic (p k : ℕ) [Fact p.Prime] :
    (modulusProduct p k).Monic := by
  apply Polynomial.monic_prod_of_monic
  intro i _hi
  exact auxiliaryIrreducible_monic p i

/-- The auxiliary modulus is squarefree, as required by Sawin's progression
estimate.  Its factors are irreducible and pairwise coprime because their
degrees are distinct. -/
theorem modulusProduct_squarefree (p k : ℕ) [Fact p.Prime] :
    Squarefree (modulusProduct p k) := by
  unfold modulusProduct
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro i hi j hj hij
    exact (auxiliaryIrreducible_coprime p hij).isRelPrime
  · intro i hi
    exact (auxiliaryIrreducible_irreducible p i).squarefree

/-- Every auxiliary factor with index below `k` divides the full modulus
product `G_k`. -/
theorem auxiliaryIrreducible_dvd_modulusProduct (p : ℕ) [Fact p.Prime]
    {i k : ℕ} (hi : i < k) :
    auxiliaryIrreducible p i ∣ modulusProduct p k := by
  unfold modulusProduct
  exact Finset.dvd_prod_of_mem (fun j : ℕ => auxiliaryIrreducible p j)
    (by simp only [Finset.mem_range, hi])

/-- Congruence modulo every one of the first `k` irreducibles aggregates to
congruence modulo their product. -/
theorem modulusProduct_dvd {p k : ℕ} [Fact p.Prime]
    {f : Polynomial (ZMod p)}
    (h : ∀ i < k, auxiliaryIrreducible p i ∣ f) :
    modulusProduct p k ∣ f := by
  unfold modulusProduct
  apply Finset.prod_dvd_of_coprime
  · intro i hi j hj hij
    exact auxiliaryIrreducible_coprime p hij
  · intro i hi
    exact h i (Finset.mem_range.mp hi)

/-- The degrees `1,3,...,2k-1` used for the auxiliary irreducibles add to
`k²`, which is the modulus degree in all CRT comparisons. -/
theorem sum_first_odd (k : ℕ) :
    ∑ i ∈ Finset.range k, (2 * i + 1) = k ^ 2 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ, ih]
    ring

/-- Consequently the modulus product has degree exactly `k²`. -/
theorem modulusProduct_natDegree (p k : ℕ) [Fact p.Prime] :
    (modulusProduct p k).natDegree = k ^ 2 := by
  unfold modulusProduct
  rw [Polynomial.natDegree_prod_of_monic]
  · simpa only [auxiliaryIrreducible_natDegree] using sum_first_odd k
  · intro i _hi
    exact auxiliaryIrreducible_monic p i

/-- A polynomial congruence modulo a polynomial of larger degree is an
equality.  This is the degree-comparison step repeatedly used after the
Chinese remainder theorem. -/
theorem eq_of_dvd_sub_of_natDegree_lt {K : Type*} [Field K]
    {f h g : Polynomial K} (hdvd : g ∣ f - h)
    (hdeg : (f - h).natDegree < g.natDegree) : f = h := by
  have hz : f - h = 0 := Polynomial.eq_zero_of_dvd_of_natDegree_lt hdvd hdeg
  exact sub_eq_zero.mp hz

/-- Unique factorization turns equality of products of monic irreducibles
into equality of the corresponding unordered pairs. -/
theorem unordered_pair_eq_of_monic_irreducibles
    {K : Type*} [Field K] {f₁ f₂ f₃ f₄ : Polynomial K}
    (h1 : Irreducible f₁) (_h2 : Irreducible f₂)
    (h3 : Irreducible f₃) (h4 : Irreducible f₄)
    (m1 : f₁.Monic) (_m2 : f₂.Monic) (m3 : f₃.Monic) (m4 : f₄.Monic)
    (heq : f₁ * f₂ = f₃ * f₄) :
    (f₁ = f₃ ∧ f₂ = f₄) ∨ (f₁ = f₄ ∧ f₂ = f₃) := by
  have hdvd : f₁ ∣ f₃ * f₄ := ⟨f₂, heq.symm⟩
  rcases h1.prime.dvd_mul.mp hdvd with h13 | h14
  · have e13 : f₁ = f₃ := Polynomial.eq_of_monic_of_associated m1 m3
      (h1.associated_of_dvd h3 h13)
    subst f₃
    have e24 : f₂ = f₄ := mul_left_cancel₀ h1.ne_zero heq
    exact Or.inl ⟨rfl, e24⟩
  · have e14 : f₁ = f₄ := Polynomial.eq_of_monic_of_associated m1 m4
      (h1.associated_of_dvd h4 h14)
    subst f₄
    have e23 : f₂ = f₃ := mul_left_cancel₀ h1.ne_zero (by
      simpa [mul_comm] using heq)
    exact Or.inr ⟨rfl, e23⟩

/-! ### The smooth multiplication chart used in the geometric count -/

private lemma degree_mul_two_fixed_lt
    {K : Type*} [Field K]
    (d : ℕ) (a : Polynomial.degreeLT K d) (q s : Polynomial K)
    (hq : q.Monic) (hs : s.Monic)
    (hqdeg : q.natDegree = d) (hsdeg : s.natDegree = d) :
    (a.1 * q * s).degree < (3 * d : ℕ) := by
  by_cases ha : a.1 = 0
  · rw [ha]
    exact WithBot.bot_lt_coe _
  rw [Polynomial.degree_mul, Polynomial.degree_mul,
    Polynomial.degree_eq_natDegree ha,
    Polynomial.degree_eq_natDegree hq.ne_zero,
    Polynomial.degree_eq_natDegree hs.ne_zero,
    hqdeg, hsdeg]
  norm_cast
  have := (Polynomial.natDegree_lt_iff_degree_lt ha).2
    (Polynomial.mem_degreeLT.mp a.2)
  omega

private lemma multiplicationDifferential_mem_degreeLT
    {K : Type*} [Field K]
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (x : Polynomial.degreeLT K d ×
      Polynomial.degreeLT K d × Polynomial.degreeLT K d) :
    x.1.1 * q * s + (p * x.2.1 * s + p * q * x.2.2) ∈
      Polynomial.degreeLT K (3 * d) := by
  rw [Polynomial.mem_degreeLT]
  calc
    (x.1.1 * q * s + (p * x.2.1 * s + p * q * x.2.2)).degree
        ≤ max (x.1.1 * q * s).degree
            (p * x.2.1 * s + p * q * x.2.2).degree :=
          Polynomial.degree_add_le _ _
    _ ≤ max (x.1.1 * q * s).degree
            (max (p * x.2.1 * s).degree (p * q * x.2.2).degree) := by
          gcongr
          exact Polynomial.degree_add_le _ _
    _ < (3 * d : ℕ) := by
      rw [max_lt_iff, max_lt_iff]
      exact ⟨degree_mul_two_fixed_lt d x.1 q s hq hs hqdeg hsdeg,
        by
          simpa [mul_assoc, mul_comm, mul_left_comm] using
            degree_mul_two_fixed_lt d x.2.1 p s hp hs hpdeg hsdeg,
        by
          simpa [mul_assoc, mul_comm, mul_left_comm] using
            degree_mul_two_fixed_lt d x.2.2 p q hp hq hpdeg hqdeg⟩

/-- The differential of multiplication at three monic degree-`d`
polynomials, restricted to perturbations of degree less than `d`. -/
noncomputable def multiplicationDifferential
    {K : Type*} [Field K]
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d) :
    (Polynomial.degreeLT K d × Polynomial.degreeLT K d ×
      Polynomial.degreeLT K d) →ₗ[K] Polynomial.degreeLT K (3 * d) where
  toFun x := ⟨x.1.1 * q * s + (p * x.2.1 * s + p * q * x.2.2),
    multiplicationDifferential_mem_degreeLT d p q s hp hq hs hpdeg hqdeg hsdeg x⟩
  map_add' x y := by
    apply Subtype.ext
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add]
    ring
  map_smul' c x := by
    apply Subtype.ext
    simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, RingHom.id_apply]
    simp only [Polynomial.smul_eq_C_mul]
    ring

private lemma degreeLT_eq_zero_of_dvd
    {K : Type*} [Field K]
    (d : ℕ) (p : Polynomial K) (hpdeg : p.natDegree = d)
    (a : Polynomial.degreeLT K d) (hpa : p ∣ a.1) : a = 0 := by
  apply Subtype.ext
  by_cases ha : a.1 = 0
  · exact ha
  apply Polynomial.eq_zero_of_dvd_of_natDegree_lt hpa
  rw [hpdeg]
  exact (Polynomial.natDegree_lt_iff_degree_lt ha).2
    (Polynomial.mem_degreeLT.mp a.2)

/-- At a pairwise-coprime triple, the multiplication differential has
trivial kernel.  This is the algebraic Jacobian computation underlying the
smooth proper-prime stratum in Pilatte's specialization of Sawin's map. -/
theorem multiplicationDifferential_injective
    {K : Type*} [Field K]
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s)
    (hqs : IsCoprime q s) :
    Function.Injective
      (multiplicationDifferential d p q s hp hq hs hpdeg hqdeg hsdeg) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  have hpoly :
      x.1.1 * q * s + (p * x.2.1 * s + p * q * x.2.2) = 0 := by
    exact congrArg Subtype.val hx
  have hpMul : p ∣ (q * s) * x.1.1 := by
    refine ⟨-(x.2.1 * s + q * x.2.2), ?_⟩
    linear_combination hpoly
  have hqMul : q ∣ (p * s) * x.2.1 := by
    refine ⟨-(x.1.1 * s + p * x.2.2), ?_⟩
    linear_combination hpoly
  have hsMul : s ∣ (p * q) * x.2.2 := by
    refine ⟨-(x.1.1 * q + p * x.2.1), ?_⟩
    linear_combination hpoly
  have hpa : p ∣ x.1.1 :=
    (hpq.mul_right hps).dvd_of_dvd_mul_left hpMul
  have hqb : q ∣ x.2.1 :=
    (hpq.symm.mul_right hqs).dvd_of_dvd_mul_left hqMul
  have hsc : s ∣ x.2.2 :=
    (hps.symm.mul_right hqs.symm).dvd_of_dvd_mul_left hsMul
  have ha : x.1 = 0 := degreeLT_eq_zero_of_dvd d p hpdeg x.1 hpa
  have hb : x.2.1 = 0 := degreeLT_eq_zero_of_dvd d q hqdeg x.2.1 hqb
  have hc : x.2.2 = 0 := degreeLT_eq_zero_of_dvd d s hsdeg x.2.2 hsc
  exact Prod.ext ha (Prod.ext hb hc)

/-- The multiplication differential is an isomorphism: injectivity and the
equality `3d = d+d+d` of finite dimensions give surjectivity. -/
theorem multiplicationDifferential_bijective
    {K : Type*} [Field K]
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s)
    (hqs : IsCoprime q s) :
    Function.Bijective
      (multiplicationDifferential d p q s hp hq hs hpdeg hqdeg hsdeg) := by
  let : FiniteDimensional K (Polynomial.degreeLT K d) :=
    (Polynomial.degreeLTEquiv K d).symm.finiteDimensional
  let : FiniteDimensional K (Polynomial.degreeLT K (3 * d)) :=
    (Polynomial.degreeLTEquiv K (3 * d)).symm.finiteDimensional
  have hdimD : Module.finrank K (Polynomial.degreeLT K d) = d := by
    rw [LinearEquiv.finrank_eq (Polynomial.degreeLTEquiv K d)]
    simp
  have hdimC : Module.finrank K (Polynomial.degreeLT K (3 * d)) = 3 * d := by
    rw [LinearEquiv.finrank_eq (Polynomial.degreeLTEquiv K (3 * d))]
    simp
  have hdim :
      Module.finrank K
          (Polynomial.degreeLT K d × Polynomial.degreeLT K d ×
            Polynomial.degreeLT K d) =
        Module.finrank K (Polynomial.degreeLT K (3 * d)) := by
    rw [Module.finrank_prod, Module.finrank_prod, hdimD, hdimC]
    omega
  have hinj := multiplicationDifferential_injective d p q s hp hq hs
    hpdeg hqdeg hsdeg hpq hps hqs
  exact ⟨hinj,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mp hinj⟩

/-- Differential of three-factor multiplication followed by reduction
modulo the progression polynomial. -/
noncomputable def residueMultiplicationDifferential
    {K : Type*} [Field K]
    (d m : ℕ) (g p q s : Polynomial K)
    (hg : g.Monic) (hgdeg : g.natDegree = m)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d) :
    (Polynomial.degreeLT K d × Polynomial.degreeLT K d ×
      Polynomial.degreeLT K d) →ₗ[K] Polynomial.degreeLT K m :=
  LinearMap.codRestrict (Polynomial.degreeLT K m)
    ((Polynomial.modByMonicHom g).comp
      ((Polynomial.degreeLT K (3 * d)).subtype.comp
        (multiplicationDifferential d p q s hp hq hs hpdeg hqdeg hsdeg)))
    (fun x ↦ by
      rw [Polynomial.mem_degreeLT]
      simp only [LinearMap.comp_apply, Polynomial.modByMonicHom_apply]
      have h := Polynomial.degree_modByMonic_lt
        (((Polynomial.degreeLT K (3 * d)).subtype.comp
          (multiplicationDifferential d p q s hp hq hs
            hpdeg hqdeg hsdeg)) x) hg
      rw [Polynomial.degree_eq_natDegree hg.ne_zero, hgdeg] at h
      exact h)

/-- At a pairwise-coprime triple the residue-product differential is
surjective whenever the modulus degree does not exceed the total degree. -/
theorem residueMultiplicationDifferential_surjective
    {K : Type*} [Field K]
    (d m : ℕ) (g p q s : Polynomial K)
    (hg : g.Monic) (hgdeg : g.natDegree = m) (hm : m ≤ 3 * d)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s)
    (hqs : IsCoprime q s) :
    Function.Surjective
      (residueMultiplicationDifferential d m g p q s hg hgdeg
        hp hq hs hpdeg hqdeg hsdeg) := by
  intro y
  have hydeg : y.1.degree < (m : WithBot ℕ) :=
    Polynomial.mem_degreeLT.mp y.2
  let z : Polynomial.degreeLT K (3 * d) :=
    ⟨y.1, Polynomial.mem_degreeLT.mpr (hydeg.trans_le (WithBot.coe_le_coe.mpr hm))⟩
  obtain ⟨x, hx⟩ :=
    (multiplicationDifferential_bijective d p q s hp hq hs
      hpdeg hqdeg hsdeg hpq hps hqs).2 z
  refine ⟨x, Subtype.ext ?_⟩
  change ((multiplicationDifferential d p q s hp hq hs
      hpdeg hqdeg hsdeg x : Polynomial.degreeLT K (3 * d)) : Polynomial K) %ₘ g = y.1
  rw [hx]
  exact (Polynomial.modByMonic_eq_self_iff hg).mpr (by
    rw [Polynomial.degree_eq_natDegree hg.ne_zero, hgdeg]
    exact hydeg)

/-- The kernel dimension of the residue-product differential is the
expected relative dimension `3d-m`.  This is the exact Jacobian dimension
calculation on Sawin's pairwise-coprime stratum. -/
theorem residueMultiplicationDifferential_finrank_ker
    {K : Type*} [Field K]
    (d m : ℕ) (g p q s : Polynomial K)
    (hg : g.Monic) (hgdeg : g.natDegree = m) (hm : m ≤ 3 * d)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s)
    (hqs : IsCoprime q s) :
    Module.finrank K (LinearMap.ker
      (residueMultiplicationDifferential d m g p q s hg hgdeg
        hp hq hs hpdeg hqdeg hsdeg)) = 3 * d - m := by
  let : FiniteDimensional K (Polynomial.degreeLT K d) :=
    (Polynomial.degreeLTEquiv K d).symm.finiteDimensional
  let : FiniteDimensional K (Polynomial.degreeLT K m) :=
    (Polynomial.degreeLTEquiv K m).symm.finiteDimensional
  let L := residueMultiplicationDifferential d m g p q s hg hgdeg
    hp hq hs hpdeg hqdeg hsdeg
  have hsurj : Function.Surjective L :=
    residueMultiplicationDifferential_surjective d m g p q s hg hgdeg hm
      hp hq hs hpdeg hqdeg hsdeg hpq hps hqs
  have hrange : LinearMap.range L = ⊤ := LinearMap.range_eq_top.mpr hsurj
  have hd : Module.finrank K (Polynomial.degreeLT K d) = d := by
    rw [LinearEquiv.finrank_eq (Polynomial.degreeLTEquiv K d)]
    simp
  have hm' : Module.finrank K (Polynomial.degreeLT K m) = m := by
    rw [LinearEquiv.finrank_eq (Polynomial.degreeLTEquiv K m)]
    simp
  change Module.finrank K (LinearMap.ker L) = 3 * d - m
  have hrank := L.finrank_range_add_finrank_ker
  rw [hrange, finrank_top, hm', Module.finrank_prod,
    Module.finrank_prod, hd] at hrank
  omega

end PolynomialInfrastructure

/-! ## The ordered root space in Sawin's geometric argument -/

open CategoryTheory
open AlgebraicGeometry
open AlgebraicGeometry.AffineSpace

noncomputable section

namespace SawinGeometry

universe u

variable (K : Type u) [CommRing K]

/-! ### The ordered pairwise-coprime three-factor stratum -/

open Polynomial

/-- The degree identity used for the first universal split. -/
theorem three_mul_eq_add_two_mul (d : ℕ) : 3 * d = d + 2 * d := by omega

/-- The degree identity used for the second universal split. -/
theorem two_mul_eq_add_self (d : ℕ) : 2 * d = d + d := by omega

/-- The first universal étale algebra, splitting a fixed degree `3d`
polynomial into coprime factors of degrees `d` and `2d`. -/
abbrev UniversalCoprimeOneTwoFactorizationRing
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) : Type u :=
  Polynomial.UniversalCoprimeFactorizationRing d (2 * d)
    (three_mul_eq_add_two_mul d) P

/-- The iterated universal étale algebra, additionally splitting the
degree-`2d` factor into two coprime degree-`d` factors. -/
abbrev UniversalPairwiseCoprimeTripleFactorizationRing
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) : Type u :=
  Polynomial.UniversalCoprimeFactorizationRing d d
    (two_mul_eq_add_self d)
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P)

noncomputable instance universalPairwiseCoprimeTripleFactorizationRingAlgebra
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Algebra R (UniversalPairwiseCoprimeTripleFactorizationRing R d P) :=
  Algebra.compHom _
    (algebraMap R (UniversalCoprimeOneTwoFactorizationRing R d P))

instance universalPairwiseCoprimeTripleFactorizationRingIsScalarTower
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    IsScalarTower R (UniversalCoprimeOneTwoFactorizationRing R d P)
      (UniversalPairwiseCoprimeTripleFactorizationRing R d P) :=
  .of_algebraMap_eq' rfl

/-- The ordered pairwise-coprime three-factor parameter algebra is étale
over the coefficient ring. -/
instance universalPairwiseCoprimeTripleFactorizationRingEtale
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Algebra.Etale R (UniversalPairwiseCoprimeTripleFactorizationRing R d P) :=
  Algebra.Etale.comp R
    (UniversalCoprimeOneTwoFactorizationRing R d P)
    (UniversalPairwiseCoprimeTripleFactorizationRing R d P)

/-- First degree-`d` universal factor, pulled through the second étale split. -/
def universalTripleFactor₁
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Polynomial.MonicDegreeEq
      (UniversalPairwiseCoprimeTripleFactorizationRing R d P) d :=
  (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d (2 * d)
    (three_mul_eq_add_two_mul d) P).map
      (algebraMap
        (UniversalCoprimeOneTwoFactorizationRing R d P)
        (UniversalPairwiseCoprimeTripleFactorizationRing R d P))

/-- Second degree-`d` universal factor. -/
def universalTripleFactor₂
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Polynomial.MonicDegreeEq
      (UniversalPairwiseCoprimeTripleFactorizationRing R d P) d :=
  Polynomial.UniversalCoprimeFactorizationRing.factor₁ d d
    (two_mul_eq_add_self d)
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P)

/-- Third degree-`d` universal factor. -/
def universalTripleFactor₃
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Polynomial.MonicDegreeEq
      (UniversalPairwiseCoprimeTripleFactorizationRing R d P) d :=
  Polynomial.UniversalCoprimeFactorizationRing.factor₂ d d
    (two_mul_eq_add_self d)
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P)

/-- The three universal factors multiply to the given polynomial after base
change along the composite coefficient map. -/
theorem universalTripleFactor_mul
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    (universalTripleFactor₁ R d P).1 *
        (universalTripleFactor₂ R d P).1 *
          (universalTripleFactor₃ R d P).1 =
      (P.map (algebraMap R
        (UniversalPairwiseCoprimeTripleFactorizationRing R d P))).1 := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let R₂ := UniversalPairwiseCoprimeTripleFactorizationRing R d P
  have hfirst :=
    Polynomial.UniversalCoprimeFactorizationRing.factor₁_mul_factor₂
      d (2 * d) (three_mul_eq_add_two_mul d) P
  have hsecond :=
    Polynomial.UniversalCoprimeFactorizationRing.factor₁_mul_factor₂
      d d (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)
  have hmapped := congrArg
    (Polynomial.map (algebraMap R₁ R₂)) hfirst
  have hsecond' :
      (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d d
          (two_mul_eq_add_self d)
          (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
            (three_mul_eq_add_two_mul d) P)).1 *
        (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d d
          (two_mul_eq_add_self d)
          (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
            (three_mul_eq_add_two_mul d) P)).1 =
      Polynomial.map (algebraMap R₁ R₂)
        (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
          (three_mul_eq_add_two_mul d) P).1 := by
    simpa only [Polynomial.MonicDegreeEq.map_coe] using hsecond
  dsimp [universalTripleFactor₁, universalTripleFactor₂,
    universalTripleFactor₃, R₁, R₂] at hmapped hsecond ⊢
  rw [Polynomial.map_mul, ← hsecond'] at hmapped
  simpa only [Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map,
    mul_assoc,
    IsScalarTower.algebraMap_eq R
      (UniversalCoprimeOneTwoFactorizationRing R d P)
      (UniversalPairwiseCoprimeTripleFactorizationRing R d P)] using hmapped

/-- The three universal factors are pairwise coprime. -/
theorem universalTripleFactor_pairwiseCoprime
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    IsCoprime (universalTripleFactor₁ R d P).1
        (universalTripleFactor₂ R d P).1 ∧
      IsCoprime (universalTripleFactor₁ R d P).1
        (universalTripleFactor₃ R d P).1 ∧
      IsCoprime (universalTripleFactor₂ R d P).1
        (universalTripleFactor₃ R d P).1 := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let R₂ := UniversalPairwiseCoprimeTripleFactorizationRing R d P
  have hfirst :=
    (Polynomial.UniversalCoprimeFactorizationRing.isCoprime_factor₁_factor₂
      d (2 * d) (three_mul_eq_add_two_mul d) P).map
        (Polynomial.mapRingHom (algebraMap R₁ R₂))
  have hsecond :=
    Polynomial.UniversalCoprimeFactorizationRing.isCoprime_factor₁_factor₂
      d d (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)
  have hproduct :=
    Polynomial.UniversalCoprimeFactorizationRing.factor₁_mul_factor₂
      d d (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)
  have hproduct' :
      (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d d
          (two_mul_eq_add_self d)
          (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
            (three_mul_eq_add_two_mul d) P)).1 *
        (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d d
          (two_mul_eq_add_self d)
          (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
            (three_mul_eq_add_two_mul d) P)).1 =
      Polynomial.map (algebraMap R₁ R₂)
        (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
          (three_mul_eq_add_two_mul d) P).1 := by
    simpa only [Polynomial.MonicDegreeEq.map_coe] using hproduct
  dsimp [universalTripleFactor₁, universalTripleFactor₂,
    universalTripleFactor₃, R₁, R₂] at hfirst hsecond hproduct ⊢
  rw [← hproduct'] at hfirst
  exact ⟨hfirst.of_mul_right_left,
    hfirst.of_mul_right_right, hsecond⟩

/-! ### Rational points of the universal triple-factorization algebra -/

/-- The first component returned by Mathlib's representing equivalence is
the first universal factor evaluated at the algebra map. -/
lemma universalCoprimeFactorizationHomEquiv_fst
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (n a b : ℕ) (hn : n = a + b)
    (P : Polynomial.MonicDegreeEq R n)
    (f : Polynomial.UniversalCoprimeFactorizationRing a b hn P →ₐ[R] S) :
    (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S a b hn P f).1.1 =
      (Polynomial.UniversalCoprimeFactorizationRing.factor₁ a b hn P).map f := by
  apply Subtype.ext
  simp [Polynomial.UniversalCoprimeFactorizationRing.homEquiv,
    Polynomial.UniversalFactorizationRing.homEquiv,
    Polynomial.UniversalCoprimeFactorizationRing.factor₁,
    Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
  congr 1

/-- The second component returned by Mathlib's representing equivalence is
the second universal factor evaluated at the algebra map. -/
lemma universalCoprimeFactorizationHomEquiv_snd
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (n a b : ℕ) (hn : n = a + b)
    (P : Polynomial.MonicDegreeEq R n)
    (f : Polynomial.UniversalCoprimeFactorizationRing a b hn P →ₐ[R] S) :
    (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S a b hn P f).1.2 =
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ a b hn P).map f := by
  apply Subtype.ext
  simp [Polynomial.UniversalCoprimeFactorizationRing.homEquiv,
    Polynomial.UniversalFactorizationRing.homEquiv,
    Polynomial.UniversalCoprimeFactorizationRing.factor₂,
    Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
  congr 1

/-- An ordered pairwise-coprime factorization into three monic factors of
the same prescribed degree. -/
structure PairwiseCoprimeTripleFactorization
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (d : ℕ) (P : Polynomial.MonicDegreeEq R (3 * d)) where
  factor₁ : Polynomial.MonicDegreeEq S d
  factor₂ : Polynomial.MonicDegreeEq S d
  factor₃ : Polynomial.MonicDegreeEq S d
  product_eq : factor₁.1 * factor₂.1 * factor₃.1 =
    P.1.map (algebraMap R S)
  coprime₁₂ : IsCoprime factor₁.1 factor₂.1
  coprime₁₃ : IsCoprime factor₁.1 factor₃.1
  coprime₂₃ : IsCoprime factor₂.1 factor₃.1

namespace PairwiseCoprimeTripleFactorization

variable {R S : Type u} [CommRing R] [CommRing S] [Nontrivial S] [Algebra R S]
  {d : ℕ} {P : Polynomial.MonicDegreeEq R (3 * d)}

@[ext] theorem ext
    {x y : PairwiseCoprimeTripleFactorization R S d P}
    (h₁ : x.factor₁ = y.factor₁) (h₂ : x.factor₂ = y.factor₂)
    (h₃ : x.factor₃ = y.factor₃) : x = y := by
  cases x
  cases y
  cases h₁
  cases h₂
  cases h₃
  rfl

/-- The product of the last two factors, bundled with its exact degree. -/
def factor₂₃ (x : PairwiseCoprimeTripleFactorization R S d P) :
    Polynomial.MonicDegreeEq S (2 * d) :=
  Polynomial.MonicDegreeEq.mk (x.factor₂.1 * x.factor₃.1)
    (x.factor₂.monic.mul x.factor₃.monic) (by
      rw [x.factor₂.monic.natDegree_mul x.factor₃.monic,
        x.factor₂.natDegree, x.factor₃.natDegree]
      omega)

/-- Data for the first split `d + 2d`. -/
def firstSplitData (x : PairwiseCoprimeTripleFactorization R S d P) :
    { y : Polynomial.MonicDegreeEq S d ×
        Polynomial.MonicDegreeEq S (2 * d) //
      y.1.1 * y.2.1 = P.1.map (algebraMap R S) ∧
        IsCoprime y.1.1 y.2.1 } :=
  ⟨(x.factor₁, x.factor₂₃), by
      simpa [factor₂₃, mul_assoc] using x.product_eq,
    by simpa [factor₂₃] using x.coprime₁₂.mul_right x.coprime₁₃⟩

/-- The algebra map induced by the first universal coprime split. -/
def firstLift (x : PairwiseCoprimeTripleFactorization R S d P) :
    UniversalCoprimeOneTwoFactorizationRing R d P →ₐ[R] S :=
  (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S
    d (2 * d) (three_mul_eq_add_two_mul d) P).symm x.firstSplitData

theorem firstLift_factor₁ (x : PairwiseCoprimeTripleFactorization R S d P) :
    (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d (2 * d)
      (three_mul_eq_add_two_mul d) P).map x.firstLift = x.factor₁ := by
  have h := congrArg (fun y ↦ y.1.1)
    ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv S
      d (2 * d) (three_mul_eq_add_two_mul d) P).apply_symm_apply x.firstSplitData)
  rw [universalCoprimeFactorizationHomEquiv_fst] at h
  exact h

theorem firstLift_factor₂ (x : PairwiseCoprimeTripleFactorization R S d P) :
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P).map x.firstLift = x.factor₂₃ := by
  have h := congrArg (fun y ↦ y.1.2)
    ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv S
      d (2 * d) (three_mul_eq_add_two_mul d) P).apply_symm_apply x.firstSplitData)
  rw [universalCoprimeFactorizationHomEquiv_snd] at h
  exact h

/-- Data for the second split `d + d`, with the target made an algebra over
the first universal split through `firstLift`. -/
def secondSplitData (x : PairwiseCoprimeTripleFactorization R S d P) :
    letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
      x.firstLift.toAlgebra
    { y : Polynomial.MonicDegreeEq S d × Polynomial.MonicDegreeEq S d //
      y.1.1 * y.2.1 =
        (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
          (three_mul_eq_add_two_mul d) P).1.map
            (algebraMap (UniversalCoprimeOneTwoFactorizationRing R d P) S) ∧
      IsCoprime y.1.1 y.2.1 } := by
  letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    x.firstLift.toAlgebra
  refine ⟨(x.factor₂, x.factor₃), ?_, x.coprime₂₃⟩
  change x.factor₂.1 * x.factor₃.1 =
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P).1.map x.firstLift
  simpa [factor₂₃] using congrArg Subtype.val x.firstLift_factor₂.symm

/-- The second universal lift, as an algebra map over the first split. -/
def secondLiftOverFirst (x : PairwiseCoprimeTripleFactorization R S d P) :
    letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
      x.firstLift.toAlgebra
    UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[
      UniversalCoprimeOneTwoFactorizationRing R d P] S := by
  letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    x.firstLift.toAlgebra
  exact (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S d d
    (two_mul_eq_add_self d)
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P)).symm x.secondSplitData

/-- The algebra map from the iterated universal ring represented by the
given triple. -/
def lift (x : PairwiseCoprimeTripleFactorization R S d P) :
    UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S := by
  letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    x.firstLift.toAlgebra
  letI : IsScalarTower R (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    .of_algebraMap_eq fun z ↦ (x.firstLift.commutes z).symm
  exact x.secondLiftOverFirst.restrictScalars R

theorem secondLiftOverFirst_factor₁
    (x : PairwiseCoprimeTripleFactorization R S d P) :
    letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
      x.firstLift.toAlgebra
    (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d d
      (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)).map x.secondLiftOverFirst = x.factor₂ := by
  let : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    x.firstLift.toAlgebra
  have h := congrArg (fun y ↦ y.1.1)
    ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv S d d
      (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)).apply_symm_apply x.secondSplitData)
  rw [universalCoprimeFactorizationHomEquiv_fst] at h
  exact h

theorem secondLiftOverFirst_factor₂
    (x : PairwiseCoprimeTripleFactorization R S d P) :
    letI : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
      x.firstLift.toAlgebra
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d d
      (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)).map x.secondLiftOverFirst = x.factor₃ := by
  let : Algebra (UniversalCoprimeOneTwoFactorizationRing R d P) S :=
    x.firstLift.toAlgebra
  have h := congrArg (fun y ↦ y.1.2)
    ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv S d d
      (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)).apply_symm_apply x.secondSplitData)
  rw [universalCoprimeFactorizationHomEquiv_snd] at h
  exact h

theorem lift_factor₁ (x : PairwiseCoprimeTripleFactorization R S d P) :
    (universalTripleFactor₁ R d P).map x.lift = x.factor₁ := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let R₂ := UniversalPairwiseCoprimeTripleFactorizationRing R d P
  let : Algebra R₁ S := x.firstLift.toAlgebra
  let : IsScalarTower R R₁ S :=
    .of_algebraMap_eq fun z ↦ (x.firstLift.commutes z).symm
  apply Subtype.ext
  change Polynomial.map (x.lift : R₂ →ₐ[R] S).toRingHom
      (Polynomial.map (algebraMap R₁ R₂)
        (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d (2 * d)
          (three_mul_eq_add_two_mul d) P).1) = x.factor₁.1
  rw [Polynomial.map_map]
  change Polynomial.map
    ((x.secondLiftOverFirst.toRingHom).comp (algebraMap R₁ R₂)) _ = _
  have heq :
      (x.secondLiftOverFirst.toRingHom).comp (algebraMap R₁ R₂) =
        x.firstLift.toRingHom := by
    ext z
    exact x.secondLiftOverFirst.commutes z
  rw [heq]
  exact congrArg Subtype.val x.firstLift_factor₁

theorem lift_factor₂ (x : PairwiseCoprimeTripleFactorization R S d P) :
    (universalTripleFactor₂ R d P).map x.lift = x.factor₂ := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let : Algebra R₁ S := x.firstLift.toAlgebra
  let : IsScalarTower R R₁ S :=
    .of_algebraMap_eq fun z ↦ (x.firstLift.commutes z).symm
  exact x.secondLiftOverFirst_factor₁

theorem lift_factor₃ (x : PairwiseCoprimeTripleFactorization R S d P) :
    (universalTripleFactor₃ R d P).map x.lift = x.factor₃ := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let : Algebra R₁ S := x.firstLift.toAlgebra
  let : IsScalarTower R R₁ S :=
    .of_algebraMap_eq fun z ↦ (x.firstLift.commutes z).symm
  exact x.secondLiftOverFirst_factor₂

/-- Evaluate the three universal factors at an algebra map. -/
def ofAlgHom
    (f : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) :
    PairwiseCoprimeTripleFactorization R S d P := by
  let p₁ := (universalTripleFactor₁ R d P).map f.toRingHom
  let p₂ := (universalTripleFactor₂ R d P).map f.toRingHom
  let p₃ := (universalTripleFactor₃ R d P).map f.toRingHom
  have hprod := congrArg (Polynomial.map f.toRingHom)
    (universalTripleFactor_mul R d P)
  have hprod' : p₁.1 * p₂.1 * p₃.1 =
      P.1.map (algebraMap R S) := by
    simpa only [p₁, p₂, p₃, Polynomial.MonicDegreeEq.map_coe,
      Polynomial.map_mul, Polynomial.map_map, AlgHom.toRingHom_eq_coe,
      f.comp_algebraMap] using hprod
  have hcop := universalTripleFactor_pairwiseCoprime R d P
  refine ⟨p₁, p₂, p₃, hprod', ?_, ?_, ?_⟩
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₁ R d P).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₂ R d P).1)
    exact hcop.1.map (Polynomial.mapRingHom f.toRingHom)
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₁ R d P).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₃ R d P).1)
    exact hcop.2.1.map (Polynomial.mapRingHom f.toRingHom)
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₂ R d P).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalTripleFactor₃ R d P).1)
    exact hcop.2.2.map (Polynomial.mapRingHom f.toRingHom)

/-- Restrict an algebra map on the iterated universal ring to the first
universal split. -/
def firstRestriction
    (f : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) :
    UniversalCoprimeOneTwoFactorizationRing R d P →ₐ[R] S :=
  f.comp (IsScalarTower.toAlgHom R
    (UniversalCoprimeOneTwoFactorizationRing R d P)
    (UniversalPairwiseCoprimeTripleFactorizationRing R d P))

theorem firstRestriction_factor₁
    (f : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) :
    (Polynomial.UniversalCoprimeFactorizationRing.factor₁ d (2 * d)
      (three_mul_eq_add_two_mul d) P).map (firstRestriction f) =
      (universalTripleFactor₁ R d P).map f.toRingHom := by
  apply Subtype.ext
  simp only [firstRestriction, universalTripleFactor₁,
    Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map,
    AlgHom.comp_toRingHom, IsScalarTower.coe_toAlgHom]
  congr 1

theorem firstRestriction_factor₂
    (f : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) :
    ((Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P).map (firstRestriction f)).1 =
      ((universalTripleFactor₂ R d P).map f.toRingHom).1 *
        ((universalTripleFactor₃ R d P).map f.toRingHom).1 := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let R₂ := UniversalPairwiseCoprimeTripleFactorizationRing R d P
  have h := Polynomial.UniversalCoprimeFactorizationRing.factor₁_mul_factor₂
    d d (two_mul_eq_add_self d)
    (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
      (three_mul_eq_add_two_mul d) P)
  have hmapped := congrArg (Polynomial.map f.toRingHom) h
  change Polynomial.map (firstRestriction f).toRingHom
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P).1 = _
  rw [show (firstRestriction f).toRingHom =
      f.toRingHom.comp (algebraMap R₁ R₂) by rfl,
    ← Polynomial.map_map]
  simpa only [universalTripleFactor₂, universalTripleFactor₃,
    Polynomial.MonicDegreeEq.map_coe, Polynomial.map_mul] using hmapped.symm

/-- Two algebra maps out of the universal triple-factorization ring agree
as soon as they agree on the three universal factors. -/
theorem algHom_ext
    {f g : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S}
    (h₁ : (universalTripleFactor₁ R d P).map f.toRingHom =
      (universalTripleFactor₁ R d P).map g.toRingHom)
    (h₂ : (universalTripleFactor₂ R d P).map f.toRingHom =
      (universalTripleFactor₂ R d P).map g.toRingHom)
    (h₃ : (universalTripleFactor₃ R d P).map f.toRingHom =
      (universalTripleFactor₃ R d P).map g.toRingHom) : f = g := by
  let R₁ := UniversalCoprimeOneTwoFactorizationRing R d P
  let R₂ := UniversalPairwiseCoprimeTripleFactorizationRing R d P
  let f₁ : R₁ →ₐ[R] S := firstRestriction f
  let g₁ : R₁ →ₐ[R] S := firstRestriction g
  have hfg₁ : f₁ = g₁ := by
    apply (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S
      d (2 * d) (three_mul_eq_add_two_mul d) P).injective
    apply Subtype.ext
    apply Prod.ext
    · rw [universalCoprimeFactorizationHomEquiv_fst,
        universalCoprimeFactorizationHomEquiv_fst]
      simpa only [f₁, g₁] using
        (firstRestriction_factor₁ f).trans
          (h₁.trans (firstRestriction_factor₁ g).symm)
    · apply Subtype.ext
      rw [universalCoprimeFactorizationHomEquiv_snd,
        universalCoprimeFactorizationHomEquiv_snd]
      rw [firstRestriction_factor₂, firstRestriction_factor₂]
      rw [congrArg Subtype.val h₂, congrArg Subtype.val h₃]
  let : Algebra R₁ S := f₁.toAlgebra
  let f' : R₂ →ₐ[R₁] S :=
    { toRingHom := f.toRingHom
      commutes' := fun z ↦ rfl }
  let g' : R₂ →ₐ[R₁] S :=
    { toRingHom := g.toRingHom
      commutes' := fun z ↦ by
        change g (algebraMap R₁ R₂ z) = f₁ z
        rw [hfg₁]
        rfl }
  have hfg' : f' = g' := by
    apply (Polynomial.UniversalCoprimeFactorizationRing.homEquiv S d d
      (two_mul_eq_add_self d)
      (Polynomial.UniversalCoprimeFactorizationRing.factor₂ d (2 * d)
        (three_mul_eq_add_two_mul d) P)).injective
    apply Subtype.ext
    apply Prod.ext
    · rw [universalCoprimeFactorizationHomEquiv_fst,
        universalCoprimeFactorizationHomEquiv_fst]
      apply Subtype.ext
      exact congrArg Subtype.val h₂
    · rw [universalCoprimeFactorizationHomEquiv_snd,
        universalCoprimeFactorizationHomEquiv_snd]
      apply Subtype.ext
      exact congrArg Subtype.val h₃
  apply AlgHom.ext
  intro z
  exact DFunLike.congr_fun hfg' z

/-- The iterated universal coprime factorization ring represents ordered
pairwise-coprime monic triple factorizations. -/
def homEquiv :
    (UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) ≃
      PairwiseCoprimeTripleFactorization R S d P where
  toFun := ofAlgHom
  invFun := lift
  left_inv f := algHom_ext (ofAlgHom f).lift_factor₁
    (ofAlgHom f).lift_factor₂ (ofAlgHom f).lift_factor₃
  right_inv x := by
    apply PairwiseCoprimeTripleFactorization.ext
    · exact x.lift_factor₁
    · exact x.lift_factor₂
    · exact x.lift_factor₃

theorem homEquiv_apply_factors
    (f : UniversalPairwiseCoprimeTripleFactorizationRing R d P →ₐ[R] S) :
    (homEquiv f).factor₁ = (universalTripleFactor₁ R d P).map f.toRingHom ∧
      (homEquiv f).factor₂ = (universalTripleFactor₂ R d P).map f.toRingHom ∧
      (homEquiv f).factor₃ = (universalTripleFactor₃ R d P).map f.toRingHom := by
  exact ⟨rfl, rfl, rfl⟩

end PairwiseCoprimeTripleFactorization

/-- The affine scheme morphism represented by the ordered pairwise-coprime
three-factor algebra. -/
noncomputable def universalPairwiseCoprimeTripleFactorizationMorphism
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    Spec (.of (UniversalPairwiseCoprimeTripleFactorizationRing R d P)) ⟶
      Spec (.of R) :=
  Spec.map (CommRingCat.ofHom
    (algebraMap R (UniversalPairwiseCoprimeTripleFactorizationRing R d P)))

/-- The ordered pairwise-coprime three-factor parameter scheme is étale
over the fixed-polynomial coefficient point. -/
instance universalPairwiseCoprimeTripleFactorizationMorphism_etale
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    AlgebraicGeometry.Etale
      (universalPairwiseCoprimeTripleFactorizationMorphism R d P) := by
  change AlgebraicGeometry.Etale
    (Spec.map (CommRingCat.ofHom
      (algebraMap R
        (UniversalPairwiseCoprimeTripleFactorizationRing R d P))))
  apply AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
  exact RingHom.etale_algebraMap.mpr inferInstance

/-- In particular, the universal ordered proper-prime stratum is smooth of
relative dimension zero over the fixed product polynomial. -/
instance universalPairwiseCoprimeTripleFactorizationMorphism_smoothZero
    (R : Type u) [CommRing R] (d : ℕ)
    (P : Polynomial.MonicDegreeEq R (3 * d)) :
    SmoothOfRelativeDimension 0
      (universalPairwiseCoprimeTripleFactorizationMorphism R d P) :=
  inferInstance

/-! ### The universal pairwise-coprime residue-product fiber -/

/-- Number of free coefficients in the monic quotient `(P-t)/g`. -/
def residueQuotientDegree (d m : ℕ) : ℕ := 3 * d - m

/-- Coefficient ring of a universal monic quotient of degree `3d-m`. -/
abbrev ResidueQuotientParameterRing
    (R : Type u) [CommRing R] (d m : ℕ) :=
  MvPolynomial (Fin (residueQuotientDegree d m)) R

/-- The universal monic quotient polynomial. -/
def universalResidueQuotient
    (R : Type u) [CommRing R] (d m : ℕ) :
    Polynomial (ResidueQuotientParameterRing R d m) :=
  Polynomial.freeMonic R (residueQuotientDegree d m)

/-- The universal degree-`3d` lift `t + gH` of the fixed residue class `t`
modulo `g`. -/
def universalResidueProductPolynomial
    (R : Type u) [CommRing R] (d m : ℕ)
    (g t : Polynomial R) :
    Polynomial (ResidueQuotientParameterRing R d m) :=
  t.map MvPolynomial.C + g.map MvPolynomial.C *
    universalResidueQuotient R d m

/-- Under the expected degree hypotheses, the universal lift is monic of
degree exactly `3d`. -/
noncomputable def universalResidueProductMonicDegree
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    Polynomial.MonicDegreeEq
      (ResidueQuotientParameterRing R d m) (3 * d) := by
  have hgmap :
      (g.map (MvPolynomial.C : R →+*
        ResidueQuotientParameterRing R d m)).Monic :=
    hg.map MvPolynomial.C
  have hH :
      (Polynomial.freeMonic R (residueQuotientDegree d m)).Monic :=
    Polynomial.monic_freeMonic R (residueQuotientDegree d m)
  have hp :
      (g.map MvPolynomial.C *
        Polynomial.freeMonic R (residueQuotientDegree d m)).Monic :=
    hgmap.mul hH
  have hprodNat :
      (g.map MvPolynomial.C *
        universalResidueQuotient R d m).natDegree = 3 * d := by
    change (g.map MvPolynomial.C *
      Polynomial.freeMonic R (residueQuotientDegree d m)).natDegree = _
    rw [hgmap.natDegree_mul hH]
    rw [hg.natDegree_map, hgdeg, Polynomial.natDegree_freeMonic]
    dsimp [residueQuotientDegree]
    omega
  have hprodDegree :
      (g.map MvPolynomial.C *
        universalResidueQuotient R d m).degree =
          ((3 * d : ℕ) : WithBot ℕ) := by
    change (g.map MvPolynomial.C *
      Polynomial.freeMonic R (residueQuotientDegree d m)).degree = _
    change (g.map MvPolynomial.C *
      Polynomial.freeMonic R (residueQuotientDegree d m)).natDegree = _ at hprodNat
    rw [Polynomial.degree_eq_natDegree hp.ne_zero, hprodNat]
  have htdeg' :
      (t.map (MvPolynomial.C : R →+*
        ResidueQuotientParameterRing R d m)).degree <
        (g.map MvPolynomial.C *
          universalResidueQuotient R d m).degree := by
    rw [hprodDegree]
    exact Polynomial.degree_map_le.trans_lt
      (htdeg.trans_le (WithBot.coe_le_coe.mpr hm))
  have hdegree :
      (universalResidueProductPolynomial R d m g t).degree =
        ((3 * d : ℕ) : WithBot ℕ) := by
    unfold universalResidueProductPolynomial
    rw [Polynomial.degree_add_eq_right_of_degree_lt htdeg', hprodDegree]
  have hnat :
      (universalResidueProductPolynomial R d m g t).natDegree = 3 * d :=
    Polynomial.natDegree_eq_of_degree_eq_some hdegree
  apply Polynomial.MonicDegreeEq.mk
    (universalResidueProductPolynomial R d m g t) _ hnat
  rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hnat,
    universalResidueProductPolynomial, Polynomial.coeff_add,
    Polynomial.coeff_eq_zero_of_degree_lt
      (htdeg'.trans_eq hprodDegree), zero_add]
  change (g.map MvPolynomial.C *
    Polynomial.freeMonic R (residueQuotientDegree d m)).coeff (3 * d) = 1
  change (g.map MvPolynomial.C *
    Polynomial.freeMonic R (residueQuotientDegree d m)).natDegree =
      3 * d at hprodNat
  rw [← hprodNat]
  exact hp.coeff_natDegree

/-- The universal pairwise-coprime triple factorization family lying above
the affine quotient-polynomial parameter space. -/
abbrev UniversalResidueTripleFactorizationRing
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :=
  UniversalPairwiseCoprimeTripleFactorizationRing
    (ResidueQuotientParameterRing R d m) d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)

noncomputable instance universalResidueTripleFactorizationRingAlgebra
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    Algebra R
      (UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm) :=
  Algebra.compHom _
    (algebraMap R (ResidueQuotientParameterRing R d m))

instance universalResidueTripleFactorizationRingIsScalarTower
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    IsScalarTower R (ResidueQuotientParameterRing R d m)
      (UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm) :=
  .of_algebraMap_eq' rfl

/-- Structural morphism of the affine quotient-polynomial parameter space. -/
noncomputable def residueQuotientParameterProjection
    (R : Type u) [Field R] (d m : ℕ) :
    Spec (.of (ResidueQuotientParameterRing R d m)) ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom
    (algebraMap R (ResidueQuotientParameterRing R d m)))

/-- The quotient-polynomial parameter space has relative dimension `3d-m`. -/
instance residueQuotientParameterProjection_smooth
    (R : Type u) [Field R] (d m : ℕ) :
    SmoothOfRelativeDimension (residueQuotientDegree d m)
      (residueQuotientParameterProjection R d m) := by
  change SmoothOfRelativeDimension (residueQuotientDegree d m)
    (Spec.map (CommRingCat.ofHom
      (algebraMap R (ResidueQuotientParameterRing R d m))))
  apply HasRingHomProperty.Spec_iff.mpr
  apply RingHom.locally_of
    RingHom.isStandardSmoothOfRelativeDimension_respectsIso
  change RingHom.IsStandardSmoothOfRelativeDimension
    (residueQuotientDegree d m)
    (algebraMap R (ResidueQuotientParameterRing R d m))
  rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
  simpa using
    (inferInstance : Algebra.IsStandardSmoothOfRelativeDimension
      (Nat.card (Fin (residueQuotientDegree d m))) R
      (ResidueQuotientParameterRing R d m))

/-- Projection of the universal proper triple-factorization family to the
ground field. -/
noncomputable def universalResidueTripleFactorizationProjection
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    Spec (.of
      (UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm)) ⟶
      Spec (.of R) :=
  universalPairwiseCoprimeTripleFactorizationMorphism
      (ResidueQuotientParameterRing R d m) d
      (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm) ≫
    residueQuotientParameterProjection R d m

/-- The universal pairwise-coprime residue-product fiber is smooth of the
expected relative dimension `3d-m`. -/
instance universalResidueTripleFactorizationProjection_smooth
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    SmoothOfRelativeDimension (residueQuotientDegree d m)
      (universalResidueTripleFactorizationProjection
        R d m g t hg hgdeg htdeg hm) := by
  unfold universalResidueTripleFactorizationProjection
  have : SmoothOfRelativeDimension 0
      (universalPairwiseCoprimeTripleFactorizationMorphism
        (ResidueQuotientParameterRing R d m) d
        (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)) :=
    inferInstance
  have : SmoothOfRelativeDimension (residueQuotientDegree d m)
      (residueQuotientParameterProjection R d m) := inferInstance
  simpa using
    (inferInstance : SmoothOfRelativeDimension
      (0 + residueQuotientDegree d m)
      (universalPairwiseCoprimeTripleFactorizationMorphism
          (ResidueQuotientParameterRing R d m) d
          (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm) ≫
        residueQuotientParameterProjection R d m))

instance universalResidueTripleFactorizationProjection_isSmooth
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    Smooth (universalResidueTripleFactorizationProjection
      R d m g t hg hgdeg htdeg hm) :=
  SmoothOfRelativeDimension.smooth (residueQuotientDegree d m)
    (universalResidueTripleFactorizationProjection
      R d m g t hg hgdeg htdeg hm)

theorem isAffineHom_universalResidueTripleFactorizationProjection
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    IsAffineHom (universalResidueTripleFactorizationProjection
      R d m g t hg hgdeg htdeg hm) := by
  infer_instance

/-- The universal proper-triple residue family is a noetherian affine
scheme of finite presentation over the ground field. -/
theorem isNoetherian_universalResidueTripleFactorization
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    IsNoetherian
      (Spec (.of (UniversalResidueTripleFactorizationRing
        R d m g t hg hgdeg htdeg hm))) := by
  let f := universalResidueTripleFactorizationProjection
    R d m g t hg hgdeg htdeg hm
  let : LocallyOfFinitePresentation f := inferInstance
  have : IsLocallyNoetherian
      (Spec (.of (UniversalResidueTripleFactorizationRing
        R d m g t hg hgdeg htdeg hm))) :=
    LocallyOfFiniteType.isLocallyNoetherian f
  exact AlgebraicGeometry.IsNoetherian.mk

/-- The three monic factors in the universal residue-product family. -/
abbrev universalResidueTripleFactor₁
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :=
  universalTripleFactor₁ (ResidueQuotientParameterRing R d m) d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)

abbrev universalResidueTripleFactor₂
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :=
  universalTripleFactor₂ (ResidueQuotientParameterRing R d m) d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)

abbrev universalResidueTripleFactor₃
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :=
  universalTripleFactor₃ (ResidueQuotientParameterRing R d m) d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)

/-- The product of the universal factors is congruent to the prescribed
residue representative modulo `g`. -/
theorem universalResidueTripleFactor_modByMonic
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    ((universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1 *
        (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1 *
          (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1) %ₘ
        g.map (algebraMap R
          (UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm)) =
      t.map (algebraMap R
        (UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm)) := by
  let RP := ResidueQuotientParameterRing R d m
  let A := UniversalResidueTripleFactorizationRing R d m g t hg hgdeg htdeg hm
  let P := universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm
  have hprod := universalTripleFactor_mul RP d P
  change ((universalTripleFactor₁ RP d P).1 *
      (universalTripleFactor₂ RP d P).1 *
        (universalTripleFactor₃ RP d P).1) %ₘ
      g.map (algebraMap R A) = t.map (algebraMap R A)
  rw [hprod]
  change ((universalResidueProductPolynomial R d m g t).map
      (algebraMap RP A)) %ₘ g.map (algebraMap R A) = _
  cases subsingleton_or_nontrivial A
  · exact Subsingleton.elim _ _
  have hC :
      (algebraMap RP A).comp
          (MvPolynomial.C : R →+* RP) = algebraMap R A := by
    rw [MvPolynomial.C_eq_algebraMap]
    exact (IsScalarTower.algebraMap_eq R RP A).symm
  unfold universalResidueProductPolynomial
  rw [Polynomial.map_add, Polynomial.map_mul,
    Polynomial.map_map, Polynomial.map_map, hC]
  rw [Polynomial.add_modByMonic]
  have htself :
      t.map (algebraMap R A) %ₘ g.map (algebraMap R A) =
        t.map (algebraMap R A) :=
    (Polynomial.modByMonic_eq_self_iff (hg.map
      (algebraMap R A))).mpr (by
      rw [Polynomial.degree_map_eq_of_injective
        (RingHom.injective (algebraMap R A)),
        Polynomial.degree_map_eq_of_injective
          (RingHom.injective (algebraMap R A))]
      rw [Polynomial.degree_eq_natDegree hg.ne_zero, hgdeg]
      exact htdeg)
  have hzero := (Polynomial.modByMonic_eq_zero_iff_dvd (hg.map
    (algebraMap R A))).mpr
      (dvd_mul_right (g.map (algebraMap R A))
        ((universalResidueQuotient R d m).map (algebraMap RP A)))
  rw [htself, hzero, add_zero]

/-- The three factors in the universal residue family remain pairwise
coprime. -/
theorem universalResidueTripleFactor_pairwiseCoprime
    (R : Type u) [Field R] (d m : ℕ)
    (g t : Polynomial R) (hg : g.Monic) (hgdeg : g.natDegree = m)
    (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d) :
    IsCoprime
        (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1
        (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1 ∧
      IsCoprime
        (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1
        (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1 ∧
      IsCoprime
        (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1
        (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1 :=
  universalTripleFactor_pairwiseCoprime
    (ResidueQuotientParameterRing R d m) d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)

/-! ### Rational points of the universal residue-product family -/

/-- Point data before eliminating the universal monic quotient. -/
structure ResidueTripleFactorizationData
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (d m : ℕ) (g t : Polynomial R) where
  quotient : Polynomial.MonicDegreeEq S (residueQuotientDegree d m)
  factor₁ : Polynomial.MonicDegreeEq S d
  factor₂ : Polynomial.MonicDegreeEq S d
  factor₃ : Polynomial.MonicDegreeEq S d
  product_eq : factor₁.1 * factor₂.1 * factor₃.1 =
    t.map (algebraMap R S) + g.map (algebraMap R S) * quotient.1
  coprime₁₂ : IsCoprime factor₁.1 factor₂.1
  coprime₁₃ : IsCoprime factor₁.1 factor₃.1
  coprime₂₃ : IsCoprime factor₂.1 factor₃.1

namespace ResidueTripleFactorizationData

variable {R S : Type u} [Field R] [CommRing S] [Nontrivial S] [Algebra R S]
  {d m : ℕ} {g t : Polynomial R} {hg : g.Monic} {hgdeg : g.natDegree = m}
  {htdeg : t.degree < (m : WithBot ℕ)} {hm : m ≤ 3 * d}

local notation "RP₀" => ResidueQuotientParameterRing R d m
local notation "A₀" => UniversalResidueTripleFactorizationRing
  R d m g t hg hgdeg htdeg hm

@[ext] theorem ext
    {x y : ResidueTripleFactorizationData R S d m g t}
    (hH : x.quotient = y.quotient)
    (h₁ : x.factor₁ = y.factor₁) (h₂ : x.factor₂ = y.factor₂)
    (h₃ : x.factor₃ = y.factor₃) : x = y := by
  cases x
  cases y
  cases hH
  cases h₁
  cases h₂
  cases h₃
  rfl

/-- Restriction of a point to the universal quotient-coefficient ring. -/
def parameterRestriction (f : A₀ →ₐ[R] S) : RP₀ →ₐ[R] S :=
  f.comp (IsScalarTower.toAlgHom R RP₀ A₀)

/-- The monic quotient encoded by a point of the universal family. -/
def quotientOfAlgHom (f : A₀ →ₐ[R] S) :
    Polynomial.MonicDegreeEq S (residueQuotientDegree d m) :=
  MvPolynomial.mapEquivMonic R S (residueQuotientDegree d m)
    (parameterRestriction f)

/-- Evaluate the quotient and the three universal factors at an algebra map. -/
def ofAlgHom (f : A₀ →ₐ[R] S) :
    ResidueTripleFactorizationData R S d m g t := by
  let p₁ := (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).map f.toRingHom
  let p₂ := (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).map f.toRingHom
  let p₃ := (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).map f.toRingHom
  let H := quotientOfAlgHom f
  let P := universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm
  have hprod := congrArg (Polynomial.map f.toRingHom)
    (universalTripleFactor_mul RP₀ d P)
  have hprod' : p₁.1 * p₂.1 * p₃.1 =
      t.map (algebraMap R S) + g.map (algebraMap R S) * H.1 := by
    change Polynomial.map f.toRingHom
        ((universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1 *
          (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1 *
            (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1) =
      Polynomial.map f.toRingHom
        ((universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm).1.map
          (algebraMap RP₀ A₀)) at hprod
    rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_map] at hprod
    change _ = (universalResidueProductPolynomial R d m g t).map
      (parameterRestriction f).toRingHom at hprod
    unfold universalResidueProductPolynomial at hprod
    have hC : (parameterRestriction f).toRingHom.comp
        (MvPolynomial.C : R →+* RP₀) = algebraMap R S := by
      rw [MvPolynomial.C_eq_algebraMap]
      exact (parameterRestriction f).comp_algebraMap
    rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_map,
      Polynomial.map_map, hC] at hprod
    have hHval : (universalResidueQuotient R d m).map
        (parameterRestriction f).toRingHom = H.1 := by rfl
    rw [hHval] at hprod
    simpa only [p₁, p₂, p₃, Polynomial.MonicDegreeEq.map_coe] using hprod
  have hcop := universalResidueTripleFactor_pairwiseCoprime
    R d m g t hg hgdeg htdeg hm
  refine ⟨H, p₁, p₂, p₃, hprod', ?_, ?_, ?_⟩
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1)
    exact hcop.1.map (Polynomial.mapRingHom f.toRingHom)
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1)
    exact hcop.2.1.map (Polynomial.mapRingHom f.toRingHom)
  · change IsCoprime
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).1)
      ((Polynomial.mapRingHom f.toRingHom)
        (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).1)
    exact hcop.2.2.map (Polynomial.mapRingHom f.toRingHom)

/-- Coefficient evaluation corresponding to a prescribed monic quotient. -/
def parameterLift (x : ResidueTripleFactorizationData R S d m g t) : RP₀ →ₐ[R] S :=
  (MvPolynomial.mapEquivMonic R S (residueQuotientDegree d m)).symm x.quotient

/-- Regard the three factors as a factorization of the evaluated universal
product over the quotient-parameter ring. -/
def tripleOverParameter (x : ResidueTripleFactorizationData R S d m g t) :
    letI : Algebra RP₀ S := x.parameterLift.toAlgebra
    PairwiseCoprimeTripleFactorization RP₀ S d
      (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm) := by
  letI : Algebra RP₀ S := x.parameterLift.toAlgebra
  refine ⟨x.factor₁, x.factor₂, x.factor₃, ?_,
    x.coprime₁₂, x.coprime₁₃, x.coprime₂₃⟩
  change x.factor₁.1 * x.factor₂.1 * x.factor₃.1 =
    (universalResidueProductPolynomial R d m g t).map x.parameterLift.toRingHom
  have hH := congrArg Subtype.val
    ((MvPolynomial.mapEquivMonic R S (residueQuotientDegree d m)).apply_symm_apply
      x.quotient)
  change (universalResidueQuotient R d m).map x.parameterLift.toRingHom =
    x.quotient.1 at hH
  unfold universalResidueProductPolynomial
  have hC : x.parameterLift.toRingHom.comp
      (MvPolynomial.C : R →+* RP₀) = algebraMap R S := by
    rw [MvPolynomial.C_eq_algebraMap]
    exact x.parameterLift.comp_algebraMap
  rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_map,
    Polynomial.map_map, hC]
  change _ = t.map (algebraMap R S) + g.map (algebraMap R S) *
    (Polynomial.freeMonic R (residueQuotientDegree d m)).map
      x.parameterLift.toRingHom
  rw [show (Polynomial.freeMonic R (residueQuotientDegree d m)).map
      x.parameterLift.toRingHom = x.quotient.1 by
    simpa only [universalResidueQuotient] using hH]
  exact x.product_eq

/-- Construct the represented algebra map from point data. -/
def lift (x : ResidueTripleFactorizationData R S d m g t) : A₀ →ₐ[R] S := by
  letI : Algebra RP₀ S := x.parameterLift.toAlgebra
  letI : IsScalarTower R RP₀ S :=
    .of_algebraMap_eq fun z ↦ (x.parameterLift.commutes z).symm
  exact x.tripleOverParameter.lift.restrictScalars R

theorem lift_factor₁ (x : ResidueTripleFactorizationData R S d m g t) :
    (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).map
        (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm) x) =
      x.factor₁ := by
  let : Algebra RP₀ S := x.parameterLift.toAlgebra
  let : IsScalarTower R RP₀ S :=
    .of_algebraMap_eq fun z ↦ (x.parameterLift.commutes z).symm
  change (universalTripleFactor₁ RP₀ d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)).map
      (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x).lift = x.factor₁
  simpa only [tripleOverParameter] using
    (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
      (htdeg := htdeg) (hm := hm) x).lift_factor₁

theorem lift_factor₂ (x : ResidueTripleFactorizationData R S d m g t) :
    (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).map
        (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm) x) =
      x.factor₂ := by
  let : Algebra RP₀ S := x.parameterLift.toAlgebra
  let : IsScalarTower R RP₀ S :=
    .of_algebraMap_eq fun z ↦ (x.parameterLift.commutes z).symm
  change (universalTripleFactor₂ RP₀ d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)).map
      (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x).lift = x.factor₂
  simpa only [tripleOverParameter] using
    (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
      (htdeg := htdeg) (hm := hm) x).lift_factor₂

theorem lift_factor₃ (x : ResidueTripleFactorizationData R S d m g t) :
    (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).map
        (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm) x) =
      x.factor₃ := by
  let : Algebra RP₀ S := x.parameterLift.toAlgebra
  let : IsScalarTower R RP₀ S :=
    .of_algebraMap_eq fun z ↦ (x.parameterLift.commutes z).symm
  change (universalTripleFactor₃ RP₀ d
    (universalResidueProductMonicDegree R d m g t hg hgdeg htdeg hm)).map
      (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x).lift = x.factor₃
  simpa only [tripleOverParameter] using
    (tripleOverParameter (hg := hg) (hgdeg := hgdeg)
      (htdeg := htdeg) (hm := hm) x).lift_factor₃

theorem parameterRestriction_lift
    (x : ResidueTripleFactorizationData R S d m g t) :
    parameterRestriction (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)
      (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm) x) =
        x.parameterLift := by
  let : Algebra RP₀ S := x.parameterLift.toAlgebra
  let : IsScalarTower R RP₀ S :=
    .of_algebraMap_eq fun z ↦ (x.parameterLift.commutes z).symm
  apply AlgHom.ext
  intro z
  exact x.tripleOverParameter.lift.commutes z

theorem lift_quotient (x : ResidueTripleFactorizationData R S d m g t) :
    quotientOfAlgHom (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)
      (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm) x) =
        x.quotient := by
  unfold quotientOfAlgHom
  rw [parameterRestriction_lift (hg := hg) (hgdeg := hgdeg)
    (htdeg := htdeg) (hm := hm)]
  exact (MvPolynomial.mapEquivMonic R S (residueQuotientDegree d m)).apply_symm_apply
    x.quotient

/-- Algebra maps agree if their quotient coefficients and all three factors
agree. -/
theorem algHom_ext
    {f k : A₀ →ₐ[R] S}
    (hH : parameterRestriction f = parameterRestriction k)
    (h₁ : (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).map
        f.toRingHom =
      (universalResidueTripleFactor₁ R d m g t hg hgdeg htdeg hm).map
        k.toRingHom)
    (h₂ : (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).map
        f.toRingHom =
      (universalResidueTripleFactor₂ R d m g t hg hgdeg htdeg hm).map
        k.toRingHom)
    (h₃ : (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).map
        f.toRingHom =
      (universalResidueTripleFactor₃ R d m g t hg hgdeg htdeg hm).map
        k.toRingHom) : f = k := by
  let f₀ : RP₀ →ₐ[R] S := parameterRestriction f
  let k₀ : RP₀ →ₐ[R] S := parameterRestriction k
  let : Algebra RP₀ S := f₀.toAlgebra
  let f' : A₀ →ₐ[RP₀] S :=
    { toRingHom := f.toRingHom
      commutes' := fun z ↦ rfl }
  let k' : A₀ →ₐ[RP₀] S :=
    { toRingHom := k.toRingHom
      commutes' := fun z ↦ by
        change k (algebraMap RP₀ A₀ z) = f₀ z
        change k₀ z = f₀ z
        exact DFunLike.congr_fun hH.symm z }
  have hfk' : f' = k' :=
    PairwiseCoprimeTripleFactorization.algHom_ext h₁ h₂ h₃
  apply AlgHom.ext
  intro z
  exact DFunLike.congr_fun hfk' z

/-- Ground-field rational points of the residue family are exactly monic
quotients and pairwise-coprime triples satisfying `F₁F₂F₃ = t + gH`. -/
def homEquiv :
    (A₀ →ₐ[R] S) ≃ ResidueTripleFactorizationData R S d m g t where
  toFun := ofAlgHom
  invFun := lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)
  left_inv f := by
    apply algHom_ext (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)
    · calc
        parameterRestriction
            (lift (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)
              (ofAlgHom f)) =
            parameterLift (ofAlgHom f) :=
          parameterRestriction_lift (hg := hg) (hgdeg := hgdeg)
            (htdeg := htdeg) (hm := hm) (ofAlgHom f)
        _ = parameterRestriction f := by
          exact (MvPolynomial.mapEquivMonic R S
            (residueQuotientDegree d m)).symm_apply_apply (parameterRestriction f)
    · exact lift_factor₁ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) (ofAlgHom f)
    · exact lift_factor₂ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) (ofAlgHom f)
    · exact lift_factor₃ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) (ofAlgHom f)
  right_inv x := by
    apply ResidueTripleFactorizationData.ext
    · exact lift_quotient (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x
    · exact lift_factor₁ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x
    · exact lift_factor₂ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x
    · exact lift_factor₃ (hg := hg) (hgdeg := hgdeg)
        (htdeg := htdeg) (hm := hm) x

end ResidueTripleFactorizationData

/-- Ordered monic triples satisfying the desired product congruence and
pairwise coprimality. -/
structure CongruentPairwiseCoprimeTriple
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (d : ℕ) (g t : Polynomial R) where
  factor₁ : Polynomial.MonicDegreeEq S d
  factor₂ : Polynomial.MonicDegreeEq S d
  factor₃ : Polynomial.MonicDegreeEq S d
  product_mod :
    (factor₁.1 * factor₂.1 * factor₃.1) %ₘ g.map (algebraMap R S) =
      t.map (algebraMap R S)
  coprime₁₂ : IsCoprime factor₁.1 factor₂.1
  coprime₁₃ : IsCoprime factor₁.1 factor₃.1
  coprime₂₃ : IsCoprime factor₂.1 factor₃.1

namespace CongruentPairwiseCoprimeTriple

variable {R S : Type u} [Field R] [CommRing S] [Nontrivial S] [Algebra R S]
  {d m : ℕ} {g t : Polynomial R} (hg : g.Monic) (hgdeg : g.natDegree = m)
  (htdeg : t.degree < (m : WithBot ℕ)) (hm : m ≤ 3 * d)

@[ext] theorem ext
    {x y : CongruentPairwiseCoprimeTriple R S d g t}
    (h₁ : x.factor₁ = y.factor₁) (h₂ : x.factor₂ = y.factor₂)
    (h₃ : x.factor₃ = y.factor₃) : x = y := by
  cases x
  cases y
  cases h₁
  cases h₂
  cases h₃
  rfl

include hg hgdeg htdeg in
private theorem mapped_degree_lt
    (x : ResidueTripleFactorizationData R S d m g t) :
    (t.map (algebraMap R S)).degree < (g.map (algebraMap R S)).degree := by
  rw [Polynomial.degree_map_eq_of_injective
      (RingHom.injective (algebraMap R S)),
    Polynomial.degree_map_eq_of_injective
      (RingHom.injective (algebraMap R S)),
    Polynomial.degree_eq_natDegree hg.ne_zero, hgdeg]
  exact htdeg

include hg hgdeg htdeg in
/-- Forget the quotient and retain the induced congruence. -/
def ofResidueData (x : ResidueTripleFactorizationData R S d m g t) :
    CongruentPairwiseCoprimeTriple R S d g t := by
  let G := g.map (algebraMap R S)
  have hG : G.Monic := hg.map (algebraMap R S)
  refine ⟨x.factor₁, x.factor₂, x.factor₃, ?_,
    x.coprime₁₂, x.coprime₁₃, x.coprime₂₃⟩
  rw [x.product_eq, Polynomial.add_modByMonic]
  rw [(Polynomial.modByMonic_eq_self_iff hG).mpr
    (mapped_degree_lt hg hgdeg htdeg x)]
  rw [(Polynomial.modByMonic_eq_zero_iff_dvd hG).mpr
    (dvd_mul_right G x.quotient.1), add_zero]

private theorem product_monic
    (x : CongruentPairwiseCoprimeTriple R S d g t) :
    (x.factor₁.1 * x.factor₂.1 * x.factor₃.1).Monic :=
  (x.factor₁.monic.mul x.factor₂.monic).mul x.factor₃.monic

private theorem product_natDegree
    (x : CongruentPairwiseCoprimeTriple R S d g t) :
    (x.factor₁.1 * x.factor₂.1 * x.factor₃.1).natDegree = 3 * d := by
  rw [(x.factor₁.monic.mul x.factor₂.monic).natDegree_mul x.factor₃.monic,
    x.factor₁.monic.natDegree_mul x.factor₂.monic,
    x.factor₁.natDegree, x.factor₂.natDegree, x.factor₃.natDegree]
  omega

include hg hgdeg in
private theorem mapped_modulus_natDegree :
    (g.map (algebraMap R S)).natDegree = m := by
  rw [hg.natDegree_map, hgdeg]

include hg hgdeg hm in
private theorem mapped_modulus_degree_le_product
    (x : CongruentPairwiseCoprimeTriple R S d g t) :
    (g.map (algebraMap R S)).degree ≤
      (x.factor₁.1 * x.factor₂.1 * x.factor₃.1).degree := by
  rw [Polynomial.degree_eq_natDegree (hg.map (algebraMap R S)).ne_zero,
    Polynomial.degree_eq_natDegree (product_monic x).ne_zero,
    mapped_modulus_natDegree hg hgdeg, product_natDegree x]
  exact WithBot.coe_le_coe.mpr hm

include hg hgdeg hm in
/-- Recover the quotient by monic Euclidean division. -/
def quotient (x : CongruentPairwiseCoprimeTriple R S d g t) :
    Polynomial.MonicDegreeEq S (residueQuotientDegree d m) := by
  let F := x.factor₁.1 * x.factor₂.1 * x.factor₃.1
  let G := g.map (algebraMap R S)
  have hG : G.Monic := hg.map (algebraMap R S)
  have hnat : (F /ₘ G).natDegree = residueQuotientDegree d m := by
    rw [Polynomial.natDegree_divByMonic F hG,
      product_natDegree x, mapped_modulus_natDegree hg hgdeg]
    rfl
  apply Polynomial.MonicDegreeEq.mk (F /ₘ G) _ hnat
  rw [Polynomial.Monic.def,
    Polynomial.leadingCoeff_divByMonic_of_monic hG
      (mapped_modulus_degree_le_product hg hgdeg hm x)]
  exact (product_monic x).leadingCoeff

include hg hgdeg hm in
def toResidueData (x : CongruentPairwiseCoprimeTriple R S d g t) :
    ResidueTripleFactorizationData R S d m g t := by
  let F := x.factor₁.1 * x.factor₂.1 * x.factor₃.1
  let G := g.map (algebraMap R S)
  let H := quotient hg hgdeg hm x
  refine ⟨H, x.factor₁, x.factor₂, x.factor₃, ?_,
    x.coprime₁₂, x.coprime₁₃, x.coprime₂₃⟩
  change F = t.map (algebraMap R S) + G * (F /ₘ G)
  rw [← x.product_mod]
  exact (Polynomial.modByMonic_add_div F G).symm

include hg hgdeg htdeg hm in
theorem toResidueData_quotient
    (x : ResidueTripleFactorizationData R S d m g t) :
    (toResidueData hg hgdeg hm (ofResidueData hg hgdeg htdeg x)).quotient =
      x.quotient := by
  apply Subtype.ext
  let G := g.map (algebraMap R S)
  have hG : G.Monic := hg.map (algebraMap R S)
  have hdiv := Polynomial.div_modByMonic_unique x.quotient.1
    (t.map (algebraMap R S)) hG
      ⟨x.product_eq.symm, mapped_degree_lt hg hgdeg htdeg x⟩
  exact hdiv.1

include hg hgdeg htdeg hm in
/-- The quotient-free congruence data are equivalent to the data with `H`. -/
def residueDataEquivCongruent :
    ResidueTripleFactorizationData R S d m g t ≃
      CongruentPairwiseCoprimeTriple R S d g t where
  toFun := ofResidueData hg hgdeg htdeg
  invFun := toResidueData hg hgdeg hm
  left_inv x := by
    apply ResidueTripleFactorizationData.ext
    · exact toResidueData_quotient hg hgdeg htdeg hm x
    · rfl
    · rfl
    · rfl
  right_inv x := by
    apply CongruentPairwiseCoprimeTriple.ext <;> rfl

/-- Final rational-point classification of the universal residue family. -/
def universalResidueTripleFactorizationHomEquivCongruent :
    (UniversalResidueTripleFactorizationRing
        R d m g t hg hgdeg htdeg hm →ₐ[R] S) ≃
      CongruentPairwiseCoprimeTriple R S d g t :=
  (ResidueTripleFactorizationData.homEquiv
      (hg := hg) (hgdeg := hgdeg) (htdeg := htdeg) (hm := hm)).trans
    (residueDataEquivCongruent hg hgdeg htdeg hm)

end CongruentPairwiseCoprimeTriple

/-! The ordered-roots-to-coefficients map is the affine quotient by the
symmetric group.  The following algebraic model proves that quotient finite,
and therefore proper, before any compact-support construction is used. -/

local instance rootPermutationSMul (n : ℕ) :
    SMul (Equiv.Perm (Fin n)) (MvPolynomial (Fin n) K) :=
  ⟨fun e p => MvPolynomial.rename e p⟩

local instance rootPermutationAction (n : ℕ) :
    MulSemiringAction (Equiv.Perm (Fin n)) (MvPolynomial (Fin n) K) where
  one_smul p := by
    change MvPolynomial.rename (1 : Equiv.Perm (Fin n)) p = p
    exact MvPolynomial.rename_id_apply p
  mul_smul e f p := by
    change MvPolynomial.rename (e * f) p =
      MvPolynomial.rename e (MvPolynomial.rename f p)
    rw [MvPolynomial.rename_rename]
    rfl
  smul_zero e := by exact (MvPolynomial.rename e).map_zero
  smul_add e p q := by exact (MvPolynomial.rename e).map_add p q
  smul_one e := by exact (MvPolynomial.rename e).map_one
  smul_mul e p q := by exact (MvPolynomial.rename e).map_mul p q

local instance rootPermutationSMulCommClass (n : ℕ) :
    SMulCommClass (Equiv.Perm (Fin n)) K (MvPolynomial (Fin n) K) where
  smul_comm e r p := by
    change MvPolynomial.rename e (r • p) = r • MvPolynomial.rename e p
    simp

local instance symmetricPolynomialIsInvariant (n : ℕ) :
    Algebra.IsInvariant
      (MvPolynomial.symmetricSubalgebra (Fin n) K)
      (MvPolynomial (Fin n) K) (Equiv.Perm (Fin n)) where
  isInvariant p hp := ⟨⟨p, hp⟩, rfl⟩

/-- The polynomial ring in the ordered roots is finite as a module over its
symmetric subalgebra. -/
theorem symmetricSubalgebra_moduleFinite (n : ℕ) :
    Module.Finite (MvPolynomial.symmetricSubalgebra (Fin n) K)
      (MvPolynomial (Fin n) K) := by
  let : Algebra.IsIntegral
      (MvPolynomial.symmetricSubalgebra (Fin n) K)
      (MvPolynomial (Fin n) K) :=
    Algebra.IsInvariant.isIntegral _ _ (Equiv.Perm (Fin n))
  let : Algebra.FiniteType
      (MvPolynomial.symmetricSubalgebra (Fin n) K)
      (MvPolynomial (Fin n) K) :=
    Algebra.FiniteType.of_restrictScalars_finiteType K
      (MvPolynomial.symmetricSubalgebra (Fin n) K)
      (MvPolynomial (Fin n) K)
  exact Algebra.IsIntegral.finite

/-- Send coefficient variables to the elementary symmetric functions of
the ordered roots. -/
noncomputable def symmetricCoefficientToRoots (n : ℕ) :
    MvPolynomial (Fin n) K →+* MvPolynomial (Fin n) K :=
  ((MvPolynomial.symmetricSubalgebra (Fin n) K).val.comp
    (MvPolynomial.esymmAlgEquiv (Fin n) K
      (Fintype.card_fin n)).toAlgHom).toRingHom

theorem symmetricCoefficientToRoots_finite (n : ℕ) :
    (symmetricCoefficientToRoots K n).Finite := by
  have hval :
      (MvPolynomial.symmetricSubalgebra (Fin n) K).val.toRingHom.Finite := by
    rw [RingHom.Finite]
    exact symmetricSubalgebra_moduleFinite K n
  exact hval.comp
    (MvPolynomial.esymmAlgEquiv (Fin n) K
      (Fintype.card_fin n)).toRingEquiv.finite

/-- Affine symmetric quotient in polynomial coordinates. -/
noncomputable def symmetricRootQuotient (n : ℕ) :
    Spec (.of (MvPolynomial (Fin n) K)) ⟶
      Spec (.of (MvPolynomial (Fin n) K)) :=
  Spec.map (CommRingCat.ofHom (symmetricCoefficientToRoots K n))

theorem symmetricRootQuotient_isFinite (n : ℕ) :
    IsFinite (symmetricRootQuotient K n) := by
  rw [symmetricRootQuotient, IsFinite.SpecMap_iff]
  exact symmetricCoefficientToRoots_finite K n

theorem symmetricRootQuotient_isProper (n : ℕ) :
    IsProper (symmetricRootQuotient K n) := by
  let : IsFinite (symmetricRootQuotient K n) :=
    symmetricRootQuotient_isFinite K n
  infer_instance

/-- Universe-lifted coordinate labels required by `AffineSpace`. -/
abbrev RootIndex (n : ℕ) : Type u := ULift.{u} (Fin n)

/-- The ordered affine space of `n` prospective roots. -/
abbrev AffineRootSpace (n : ℕ) : Scheme.{u} :=
  AffineSpace (RootIndex n) (Spec (.of K))

/-- The coefficient embedding into global functions on ordered root space. -/
def rootCoefficientMap (n : ℕ) :
    K →+* Γ(AffineRootSpace K n, ⊤) :=
  (AffineRootSpace K n ↘ Spec (.of K)).appTop.hom.comp
    (Scheme.ΓSpecIso (.of K)).inv.hom

/-- Evaluate `g` at the `i`th universal root. -/
def rootEvaluationSection (n : ℕ) (g : Polynomial K) (i : Fin n) :
    Γ(AffineRootSpace K n, ⊤) :=
  Polynomial.eval₂ (rootCoefficientMap K n)
    (AffineSpace.coord (Spec (.of K)) (ULift.up i)) g

/-- The product whose nonvanishing says that all roots avoid the divisor
cut out by `g`. -/
def rootAvoidanceSection (n : ℕ) (g : Polynomial K) :
    Γ(AffineRootSpace K n, ⊤) :=
  ∏ i : Fin n, rootEvaluationSection K n g i

/-- Sawin's ordered root space `C^n`, for `C = A¹ ∖ V(g)`. -/
def RootSpaceOpen (n : ℕ) (g : Polynomial K) :
    (AffineRootSpace K n).Opens :=
  (AffineRootSpace K n).basicOpen (rootAvoidanceSection K n g)

/-- The ordered root space as a scheme. -/
abbrev RootSpace (n : ℕ) (g : Polynomial K) : Scheme.{u} :=
  (RootSpaceOpen K n g).toScheme

/-- Its structural map to the ground ring. -/
def rootSpaceProjection (n : ℕ) (g : Polynomial K) :
    RootSpace K n g ⟶ Spec (.of K) :=
  (RootSpaceOpen K n g).ι ≫ (AffineRootSpace K n ↘ Spec (.of K))

/-- The universal monic polynomial obtained by multiplying the `n` linear
factors belonging to the ordered roots. -/
def universalRootPolynomial (n : ℕ) :
    Polynomial Γ(AffineRootSpace K n, ⊤) :=
  ∏ i : Fin n,
    (Polynomial.X - Polynomial.C
      (AffineSpace.coord (Spec (.of K)) (ULift.up i)))

/-- Multiplication of ordered linear factors as a coefficient-space
morphism. -/
def affineRootMultiplication (n : ℕ) :
    AffineRootSpace K n ⟶ AffineSpace (RootIndex n) (Spec (.of K)) :=
  AffineSpace.homOfVector (AffineRootSpace K n ↘ Spec (.of K))
    (fun j ↦ (universalRootPolynomial K n).coeff j.down)

/-- Restrict the multiplication morphism to `C^n`. -/
def rootMultiplication (n : ℕ) (g : Polynomial K) :
    RootSpace K n g ⟶ AffineSpace (RootIndex n) (Spec (.of K)) :=
  (RootSpaceOpen K n g).ι ≫ affineRootMultiplication K n

/-- The progression algebra `K[t]/(g)` appearing in
`T(R) = (R[t]/g)ˣ`. -/
abbrev ProgressionAlgebra (g : Polynomial K) :=
  Polynomial K ⧸ Ideal.span ({g} : Set (Polynomial K))

/-- The class of `t-a` modulo `g`. -/
def linearFactorClass (g : Polynomial K) (a : K) : ProgressionAlgebra K g :=
  Ideal.Quotient.mk (Ideal.span ({g} : Set (Polynomial K)))
    (Polynomial.X - Polynomial.C a)

/-- Ordered `K`-points of `C^n`, in the intrinsic form needed for the
unit-valued target. -/
def RootPoint (n : ℕ) (g : Polynomial K) :=
  {a : Fin n → K // ∀ i, IsUnit (linearFactorClass K g (a i))}

/-- On points, Sawin's map is `(αᵢ) ↦ ∏(t-αᵢ) mod g`. -/
def pointRootMultiplication (n : ℕ) (g : Polynomial K)
    (a : RootPoint K n g) : (ProgressionAlgebra K g)ˣ :=
  ∏ i : Fin n, (a.property i).unit

/-- The underlying quotient value of the unit-valued point map is exactly
the class of the product of linear factors. -/
theorem coe_pointRootMultiplication (n : ℕ) (g : Polynomial K)
    (a : RootPoint K n g) :
    ↑(pointRootMultiplication K n g a) =
      Ideal.Quotient.mk (Ideal.span ({g} : Set (Polynomial K)))
        (∏ i : Fin n, (Polynomial.X - Polynomial.C (a.1 i))) := by
  simp [pointRootMultiplication, linearFactorClass]

/-- Pulling back coefficient coordinate `j` gives the `j`th coefficient of
the product of linear factors. -/
@[simp]
theorem affineRootMultiplication_appTop_coord (n : ℕ) (j : Fin n) :
    (affineRootMultiplication K n).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (universalRootPolynomial K n).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

/-- The coefficient-space multiplication morphism lies over the base. -/
@[reassoc (attr := simp)]
theorem affineRootMultiplication_over (n : ℕ) :
    affineRootMultiplication K n ≫
        (AffineSpace (RootIndex n) (Spec (.of K)) ↘ Spec (.of K)) =
      (AffineRootSpace K n ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

/-! The preceding polynomial-coordinate quotient uses `Fin n`, whereas
`AffineSpace` uses its universe-lifted coordinate type.  We now transport
the finite symmetric quotient to those exact coordinates, including the
reversal and signs in Vieta's formula. -/

local instance rootIndexPermutationSMul (n : ℕ) :
    SMul (Equiv.Perm (RootIndex n)) (MvPolynomial (RootIndex n) K) :=
  ⟨fun e p => MvPolynomial.rename e p⟩

local instance rootIndexPermutationAction (n : ℕ) :
    MulSemiringAction (Equiv.Perm (RootIndex n))
      (MvPolynomial (RootIndex n) K) where
  one_smul p := by
    change MvPolynomial.rename (1 : Equiv.Perm (RootIndex n)) p = p
    exact MvPolynomial.rename_id_apply p
  mul_smul e f p := by
    change MvPolynomial.rename (e * f) p =
      MvPolynomial.rename e (MvPolynomial.rename f p)
    rw [MvPolynomial.rename_rename]
    rfl
  smul_zero e := by exact (MvPolynomial.rename e).map_zero
  smul_add e p q := by exact (MvPolynomial.rename e).map_add p q
  smul_one e := by exact (MvPolynomial.rename e).map_one
  smul_mul e p q := by exact (MvPolynomial.rename e).map_mul p q

local instance rootIndexPermutationSMulCommClass (n : ℕ) :
    SMulCommClass (Equiv.Perm (RootIndex n)) K
      (MvPolynomial (RootIndex n) K) where
  smul_comm e r p := by
    change MvPolynomial.rename e (r • p) = r • MvPolynomial.rename e p
    simp

local instance rootIndexSymmetricPolynomialIsInvariant (n : ℕ) :
    Algebra.IsInvariant
      (MvPolynomial.symmetricSubalgebra (RootIndex n) K)
      (MvPolynomial (RootIndex n) K) (Equiv.Perm (RootIndex n)) where
  isInvariant p hp := ⟨⟨p, hp⟩, rfl⟩

theorem rootIndexSymmetricSubalgebra_moduleFinite (n : ℕ) :
    Module.Finite (MvPolynomial.symmetricSubalgebra (RootIndex n) K)
      (MvPolynomial (RootIndex n) K) := by
  let _ : Algebra.IsIntegral
      (MvPolynomial.symmetricSubalgebra (RootIndex n) K)
      (MvPolynomial (RootIndex n) K) :=
    Algebra.IsInvariant.isIntegral _ _ (Equiv.Perm (RootIndex n))
  let _ : Algebra.FiniteType
      (MvPolynomial.symmetricSubalgebra (RootIndex n) K)
      (MvPolynomial (RootIndex n) K) :=
    Algebra.FiniteType.of_restrictScalars_finiteType K
      (MvPolynomial.symmetricSubalgebra (RootIndex n) K)
      (MvPolynomial (RootIndex n) K)
  exact Algebra.IsIntegral.finite

/-- The universe lift used by affine-space coordinates does not change the
finite indexing set. -/
def rootIndexEquivFin (n : ℕ) : RootIndex n ≃ Fin n where
  toFun := ULift.down
  invFun := ULift.up
  left_inv _ := rfl
  right_inv _ := rfl

/-- Change the sign of the `i`th variable by `(-1)^(i+1)`. -/
noncomputable def coefficientSignAlgEquiv (n : ℕ) :
    MvPolynomial (Fin n) K ≃ₐ[K] MvPolynomial (Fin n) K := by
  let h : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K :=
    MvPolynomial.aeval fun i =>
      MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) * MvPolynomial.X i
  apply AlgEquiv.ofAlgHom h h
  · apply MvPolynomial.algHom_ext
    intro i
    simp only [h, AlgHom.comp_apply, MvPolynomial.aeval_X,
      map_mul, MvPolynomial.aeval_C]
    change MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) *
      (MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) * MvPolynomial.X i) =
        MvPolynomial.X i
    rw [← mul_assoc, ← MvPolynomial.C_mul, ← pow_add,
      (Even.add_self (i.1 + 1)).neg_one_pow]
    simp
  · apply MvPolynomial.algHom_ext
    intro i
    simp only [h, AlgHom.comp_apply, MvPolynomial.aeval_X,
      map_mul, MvPolynomial.aeval_C]
    change MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) *
      (MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) * MvPolynomial.X i) =
        MvPolynomial.X i
    rw [← mul_assoc, ← MvPolynomial.C_mul, ← pow_add,
      (Even.add_self (i.1 + 1)).neg_one_pow]
    simp

@[simp]
theorem coefficientSignAlgEquiv_X (n : ℕ) (i : Fin n) :
    coefficientSignAlgEquiv K n (MvPolynomial.X i) =
      MvPolynomial.C ((-1 : K) ^ (i.1 + 1)) * MvPolynomial.X i := by
  simp [coefficientSignAlgEquiv]

/-- Reindex coefficient `j` by `n-1-j`, then apply its Vieta sign. -/
noncomputable def coefficientToElementaryAlgEquiv (n : ℕ) :
    MvPolynomial (RootIndex n) K ≃ₐ[K] MvPolynomial (Fin n) K :=
  ((MvPolynomial.renameEquiv K (rootIndexEquivFin n)).trans
    (MvPolynomial.renameEquiv K Fin.revPerm)).trans
      (coefficientSignAlgEquiv K n)

/-- Send lifted coefficient variables to the elementary symmetric functions
of the lifted ordered-root variables. -/
noncomputable def rootIndexSymmetricCoefficientToRoots (n : ℕ) :
    MvPolynomial (RootIndex n) K →+* MvPolynomial (RootIndex n) K :=
  ((MvPolynomial.symmetricSubalgebra (RootIndex n) K).val.comp
    ((MvPolynomial.esymmAlgEquiv (RootIndex n) K
      (by simp [RootIndex])).toAlgHom.comp
        (coefficientToElementaryAlgEquiv K n).toAlgHom)).toRingHom

@[simp]
theorem rootIndexSymmetricCoefficientToRoots_X (n : ℕ)
    (j : RootIndex n) :
    rootIndexSymmetricCoefficientToRoots K n (MvPolynomial.X j) =
      MvPolynomial.C ((-1 : K) ^ (j.down.rev.1 + 1)) *
        MvPolynomial.esymm (RootIndex n) K (j.down.rev.1 + 1) := by
  simp [rootIndexSymmetricCoefficientToRoots,
    coefficientToElementaryAlgEquiv, rootIndexEquivFin,
    MvPolynomial.esymmAlgEquiv, MvPolynomial.esymmAlgHom]

/-- Universal product of linear factors in polynomial coordinates. -/
def mvUniversalRootPolynomial (n : ℕ) :
    Polynomial (MvPolynomial (RootIndex n) K) :=
  ∏ i : RootIndex n,
    (Polynomial.X - Polynomial.C (MvPolynomial.X i))

theorem mvUniversalRootPolynomial_coeff (n k : ℕ) (hk : k ≤ n) :
    (mvUniversalRootPolynomial K n).coeff k =
      (-1 : MvPolynomial (RootIndex n) K) ^ (n - k) *
        MvPolynomial.esymm (RootIndex n) K (n - k) := by
  let s := Finset.univ.val.map fun i : RootIndex n =>
    (MvPolynomial.X i : MvPolynomial (RootIndex n) K)
  have hcard : n = Multiset.card s := by
    simp [s, RootIndex]
  unfold mvUniversalRootPolynomial
  rw [Finset.prod_eq_multiset_prod,
    MvPolynomial.esymm_eq_multiset_esymm]
  have hv := Multiset.prod_X_sub_C_coeff s (k := k) (by omega)
  rw [← hcard] at hv
  simpa only [s, Multiset.map_map, Function.comp_apply] using hv

/-- The finite symmetric quotient is exactly the coefficient map of the
universal product of linear factors. -/
theorem rootIndexSymmetricCoefficientToRoots_X_eq_coeff
    (n : ℕ) (j : RootIndex n) :
    rootIndexSymmetricCoefficientToRoots K n (MvPolynomial.X j) =
      (mvUniversalRootPolynomial K n).coeff j.down.1 := by
  rw [rootIndexSymmetricCoefficientToRoots_X,
    mvUniversalRootPolynomial_coeff K n j.down.1 (Nat.le_of_lt j.down.isLt)]
  have hrev : j.down.rev.1 + 1 = n - j.down.1 := by
    simp only [Fin.rev]
    omega
  rw [hrev]
  simp

/-- Evaluate lifted polynomial variables at affine coordinate functions. -/
def affineRootCoordinateEval (n : ℕ) :
    MvPolynomial (RootIndex n) K →+*
      Γ(AffineRootSpace K n, ⊤) :=
  MvPolynomial.eval₂Hom (rootCoefficientMap K n)
    (AffineSpace.coord (Spec (.of K)))

theorem mvUniversalRootPolynomial_map_affineRootCoordinateEval
    (n : ℕ) :
    (mvUniversalRootPolynomial K n).map
        (affineRootCoordinateEval K n) =
      universalRootPolynomial K n := by
  unfold mvUniversalRootPolynomial universalRootPolynomial
  rw [Polynomial.map_prod]
  simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
    affineRootCoordinateEval, MvPolynomial.coe_eval₂Hom,
    MvPolynomial.eval₂_X]
  symm
  exact (rootIndexEquivFin n).symm.prod_comp
    (fun j : RootIndex n =>
      Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K)) j))

theorem rootIndexSymmetricCoefficientToRoots_finite (n : ℕ) :
    (rootIndexSymmetricCoefficientToRoots K n).Finite := by
  have hval :
      (MvPolynomial.symmetricSubalgebra (RootIndex n) K).val.toRingHom.Finite := by
    rw [RingHom.Finite]
    exact rootIndexSymmetricSubalgebra_moduleFinite K n
  exact (hval.comp
    (MvPolynomial.esymmAlgEquiv (RootIndex n) K
      (by simp [RootIndex])).toRingEquiv.finite).comp
        (coefficientToElementaryAlgEquiv K n).toRingEquiv.finite

noncomputable def rootIndexSymmetricRootQuotient (n : ℕ) :
    Spec (.of (MvPolynomial (RootIndex n) K)) ⟶
      Spec (.of (MvPolynomial (RootIndex n) K)) :=
  Spec.map (CommRingCat.ofHom (rootIndexSymmetricCoefficientToRoots K n))

theorem rootIndexSymmetricRootQuotient_isFinite (n : ℕ) :
    IsFinite (rootIndexSymmetricRootQuotient K n) := by
  rw [rootIndexSymmetricRootQuotient, IsFinite.SpecMap_iff]
  exact rootIndexSymmetricCoefficientToRoots_finite K n

/-- The finite symmetric quotient transported from polynomial spectra to
the actual affine-space coordinates. -/
noncomputable def affineSymmetricRootQuotient (n : ℕ) :
    AffineRootSpace K n ⟶ AffineRootSpace K n :=
  (AffineSpace.SpecIso (RootIndex n) (.of K)).hom ≫
    rootIndexSymmetricRootQuotient K n ≫
      (AffineSpace.SpecIso (RootIndex n) (.of K)).inv

theorem affineSymmetricRootQuotient_isFinite (n : ℕ) :
    IsFinite (affineSymmetricRootQuotient K n) := by
  let _ : IsFinite (rootIndexSymmetricRootQuotient K n) :=
    rootIndexSymmetricRootQuotient_isFinite K n
  unfold affineSymmetricRootQuotient
  infer_instance

theorem affineSymmetricRootQuotient_appTop_coord
    (n : ℕ) (j : RootIndex n) :
    (affineSymmetricRootQuotient K n).appTop
        (AffineSpace.coord (Spec (.of K)) j) =
      (universalRootPolynomial K n).coeff j.down.1 := by
  unfold affineSymmetricRootQuotient rootIndexSymmetricRootQuotient
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
  simp only [CommRingCat.comp_apply]
  rw [AffineSpace.SpecIso_inv_appTop_coord]
  change (AffineSpace.SpecIso (RootIndex n) (.of K)).hom.appTop
      ((Spec.map (CommRingCat.ofHom
        (rootIndexSymmetricCoefficientToRoots K n))).appTop
          ((Scheme.ΓSpecIso
            (.of (MvPolynomial (RootIndex n) K))).inv
              (MvPolynomial.X j))) = _
  have hspec :
      (Spec.map (CommRingCat.ofHom
        (rootIndexSymmetricCoefficientToRoots K n))).appTop
          ((Scheme.ΓSpecIso
            (.of (MvPolynomial (RootIndex n) K))).inv
              (MvPolynomial.X j)) =
        (Scheme.ΓSpecIso
          (.of (MvPolynomial (RootIndex n) K))).inv
            (rootIndexSymmetricCoefficientToRoots K n
              (MvPolynomial.X j)) := by
    change (((Scheme.ΓSpecIso
        (.of (MvPolynomial (RootIndex n) K))).inv ≫
          (Spec.map (CommRingCat.ofHom
            (rootIndexSymmetricCoefficientToRoots K n))).appTop)
              (MvPolynomial.X j)) =
      ((CommRingCat.ofHom
          (rootIndexSymmetricCoefficientToRoots K n) ≫
        (Scheme.ΓSpecIso
          (.of (MvPolynomial (RootIndex n) K))).inv)
            (MvPolynomial.X j))
    exact congrArg (fun f => f (MvPolynomial.X j))
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom
          (rootIndexSymmetricCoefficientToRoots K n))).symm
  rw [hspec]
  rw [AffineSpace.SpecIso_hom_appTop]
  simp only [CommRingCat.comp_apply, Iso.inv_hom_id_apply]
  rw [rootIndexSymmetricCoefficientToRoots_X_eq_coeff]
  change affineRootCoordinateEval K n
      ((mvUniversalRootPolynomial K n).coeff j.down.1) = _
  rw [← Polynomial.coeff_map,
    mvUniversalRootPolynomial_map_affineRootCoordinateEval]

/-- The transported finite quotient is the ordered-roots-to-coefficients
morphism used in the geometric construction. -/
theorem affineSymmetricRootQuotient_eq_affineRootMultiplication
    (n : ℕ) :
    affineSymmetricRootQuotient K n = affineRootMultiplication K n := by
  apply AffineSpace.hom_ext
  · rw [affineRootMultiplication_over]
    unfold affineSymmetricRootQuotient rootIndexSymmetricRootQuotient
    simp only [Category.assoc, AffineSpace.SpecIso_inv_over]
    rw [← Spec.map_comp]
    have hC : (CommRingCat.ofHom MvPolynomial.C :
        CommRingCat.of K ⟶
          CommRingCat.of (MvPolynomial (RootIndex n) K)) ≫
          CommRingCat.ofHom
            (rootIndexSymmetricCoefficientToRoots K n) =
        CommRingCat.ofHom MvPolynomial.C := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      change rootIndexSymmetricCoefficientToRoots K n
        (algebraMap K (MvPolynomial (RootIndex n) K) r) =
          algebraMap K (MvPolynomial (RootIndex n) K) r
      unfold rootIndexSymmetricCoefficientToRoots
      simp
    rw [hC]
    apply (cancel_epi
      (AffineSpace.SpecIso (RootIndex n) (.of K)).inv).1
    simp
  · intro j
    rw [affineSymmetricRootQuotient_appTop_coord,
      affineRootMultiplication_appTop_coord]

/-- Multiplication of ordered roots is a finite morphism. -/
theorem affineRootMultiplication_isFinite (n : ℕ) :
    IsFinite (affineRootMultiplication K n) := by
  rw [← affineSymmetricRootQuotient_eq_affineRootMultiplication K n]
  exact affineSymmetricRootQuotient_isFinite K n

/-- The universal root polynomial is monic. -/
@[simp]
theorem universalRootPolynomial_monic (n : ℕ) :
    (universalRootPolynomial K n).Monic := by
  unfold universalRootPolynomial
  apply Polynomial.monic_prod_of_monic
  intro i
  intro _
  exact @Polynomial.monic_X_sub_C Γ(AffineRootSpace K n, ⊤) _
    (AffineSpace.coord (Spec (.of K)) (ULift.up i))

/-- Affine `n`-space over `Spec K` is smooth. -/
theorem smooth_affineRootSpace_projection (n : ℕ) :
    Smooth (AffineRootSpace K n ↘ Spec (.of K)) := by
  let : MorphismProperty.RespectsIso (@Smooth) := by
    rw [HasRingHomProperty.eq_affineLocally @Smooth]
    exact affineLocally_respectsIso _ RingHom.Smooth.respectsIso
  rw [← MorphismProperty.cancel_left_of_respectsIso (P := @Smooth)
      (AffineSpace.SpecIso (RootIndex n) (.of K)).inv,
    AffineSpace.SpecIso_inv_over]
  rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
  change (algebraMap K (MvPolynomial (RootIndex n) K)).Smooth
  rw [RingHom.smooth_algebraMap]
  exact ⟨inferInstance, inferInstance⟩

/-- The ordered root space `C^n` is smooth over the ground ring. -/
theorem smooth_rootSpaceProjection (n : ℕ) (g : Polynomial K) :
    Smooth (rootSpaceProjection K n g) := by
  unfold rootSpaceProjection
  let : Smooth (AffineRootSpace K n ↘ Spec (.of K)) :=
    smooth_affineRootSpace_projection K n
  infer_instance

/-- In particular, the ordered root space is flat. -/
theorem flat_rootSpaceProjection (n : ℕ) (g : Polynomial K) :
    Flat (rootSpaceProjection K n g) := by
  let : Smooth (rootSpaceProjection K n g) :=
    smooth_rootSpaceProjection K n g
  infer_instance

/-- It is also locally of finite presentation. -/
theorem locallyOfFinitePresentation_rootSpaceProjection
    (n : ℕ) (g : Polynomial K) :
    LocallyOfFinitePresentation (rootSpaceProjection K n g) := by
  let : Smooth (rootSpaceProjection K n g) :=
    smooth_rootSpaceProjection K n g
  infer_instance

/-- The constant ell-adic sheaf currently provided by Mathlib. -/
def rootEllAdicSheaf (n : ℕ) (g : Polynomial K) (ell : ℕ)
    [Fact ell.Prime] :=
  (RootSpace K n g).ellAdicSheaf ell

/-- Ordinary ell-adic cohomology of the ordered root space.  The subsequent
argument needs to extend this with compact support and Frobenius. -/
def RootEllAdicCohomology (n : ℕ) (g : Polynomial K) (ell i : ℕ)
    [Fact ell.Prime] : Type (u + 1) :=
  (RootSpace K n g).EllAdicCohomology ell i

end SawinGeometry

namespace SawinGeometry

variable (K : Type u) [Field K]

/-- The residue class of an arbitrary polynomial modulo `g`. -/
def polynomialResidueClass (g a : Polynomial K) : ProgressionAlgebra K g :=
  Ideal.Quotient.mk (Ideal.span ({g} : Set (Polynomial K))) a

/-- A polynomial is a unit modulo `g` exactly when it is coprime to `g`. -/
theorem isUnit_polynomialResidueClass_iff_isCoprime
    (g a : Polynomial K) :
    IsUnit (polynomialResidueClass K g a) ↔ IsCoprime g a := by
  let I : Ideal (Polynomial K) := Ideal.span ({g} : Set (Polynomial K))
  constructor
  · intro hu
    obtain ⟨b, hb⟩ := isUnit_iff_exists_inv'.mp hu
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    have hz : b * a - 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simpa [polynomialResidueClass, I] using sub_eq_zero.mpr hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hz
    refine ⟨-c, b, ?_⟩
    calc
      -c * g + b * a = -(b * a - 1) + b * a := by rw [neg_mul, hc]
      _ = 1 := by ring
  · rintro ⟨b, c, hbc⟩
    apply isUnit_iff_exists_inv'.mpr
    refine ⟨Ideal.Quotient.mk I c, ?_⟩
    have hm := congrArg (Ideal.Quotient.mk I) hbc
    simpa [polynomialResidueClass, I] using hm

/-- Equivalently, over a field, the residue class is a unit exactly when
the resultant does not vanish. -/
theorem isUnit_polynomialResidueClass_iff_resultant_ne_zero
    (g a : Polynomial K) (hg : g.Monic) :
    IsUnit (polynomialResidueClass K g a) ↔ g.resultant a ≠ 0 := by
  rw [isUnit_polynomialResidueClass_iff_isCoprime,
    ← Polynomial.isUnit_resultant_iff_isCoprime hg]
  exact isUnit_iff_ne_zero

/-! ### Long-division coordinates on monic polynomial space

This is the algebraic coordinate change used in Sawin's large-block
constancy argument.  Once a block has size `n ≥ m`, its monic polynomial is
equivalently its remainder modulo the degree-`m` modulus and a free monic
quotient of degree `n-m`. -/

export PolynomialDivision (
  monicDegreeEqOfRemainderQuotient
  monicDegreeEqOfRemainderQuotient_modByMonic
  monicDegreeEqOfRemainderQuotient_divByMonic
  monicQuotientOfDegree
  monicDegreeEq_reconstruct
  monicRemainderQuotientEquiv)

/-- A polynomial representative, chosen only to define the unique
degree-bounded representative below. -/
noncomputable def progressionAlgebraRepresentative
    (g : Polynomial K) (x : ProgressionAlgebra K g) : Polynomial K :=
  Classical.choose (Ideal.Quotient.mk_surjective x)

theorem polynomialResidueClass_representative
    (g : Polynomial K) (x : ProgressionAlgebra K g) :
    polynomialResidueClass K g (progressionAlgebraRepresentative K g x) = x :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective x)

/-- The unique degree-bounded representative of a residue class. -/
noncomputable def progressionAlgebraRemainder
    (g : Polynomial K) (_hg : g.Monic) (x : ProgressionAlgebra K g) :
    Polynomial K :=
  progressionAlgebraRepresentative K g x %ₘ g

theorem progressionAlgebraRemainder_degree_lt
    (g : Polynomial K) (hg : g.Monic) (x : ProgressionAlgebra K g) :
    (progressionAlgebraRemainder K g hg x).degree < g.degree :=
  Polynomial.degree_modByMonic_lt _ hg

theorem polynomialResidueClass_modByMonic
    (g f : Polynomial K) (_hg : g.Monic) :
    polynomialResidueClass K g (f %ₘ g) =
      polynomialResidueClass K g f := by
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).2
  rcases Polynomial.dvd_modByMonic_sub f g with ⟨c, hc⟩
  apply Ideal.mem_span_singleton'.2
  refine ⟨c, ?_⟩
  rw [mul_comm]
  exact hc.symm

theorem polynomialResidueClass_progressionAlgebraRemainder
    (g : Polynomial K) (hg : g.Monic) (x : ProgressionAlgebra K g) :
    polynomialResidueClass K g (progressionAlgebraRemainder K g hg x) = x := by
  calc
    polynomialResidueClass K g (progressionAlgebraRemainder K g hg x) =
        polynomialResidueClass K g (progressionAlgebraRepresentative K g x) :=
      polynomialResidueClass_modByMonic K g _ hg
    _ = x := polynomialResidueClass_representative K g x

theorem progressionAlgebraRemainder_eq_modByMonic_of_residueClass_eq
    (g f : Polynomial K) (hg : g.Monic) (x : ProgressionAlgebra K g)
    (hfx : polynomialResidueClass K g f = x) :
    progressionAlgebraRemainder K g hg x = f %ₘ g := by
  unfold progressionAlgebraRemainder
  apply Polynomial.modByMonic_eq_of_dvd_sub hg
  have hquot :
      polynomialResidueClass K g (progressionAlgebraRepresentative K g x) =
        polynomialResidueClass K g f :=
    (polynomialResidueClass_representative K g x).trans hfx.symm
  have hmem := (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).1 hquot
  rcases Ideal.mem_span_singleton'.1 hmem with ⟨c, hc⟩
  refine ⟨c, ?_⟩
  simpa [mul_comm] using hc.symm

/-- A coprime monic polynomial determines a unit modulo `g`. -/
noncomputable def monicCoprimeResidueUnit
    {n : ℕ} (g : Polynomial K) (F : Polynomial.MonicDegreeEq K n)
    (hF : IsCoprime g F.1) : (ProgressionAlgebra K g)ˣ :=
  ((isUnit_polynomialResidueClass_iff_isCoprime K g F.1).2 hF).unit

@[simp]
theorem coe_monicCoprimeResidueUnit
    {n : ℕ} (g : Polynomial K) (F : Polynomial.MonicDegreeEq K n)
    (hF : IsCoprime g F.1) :
    ↑(monicCoprimeResidueUnit K g F hF) =
      polynomialResidueClass K g F.1 :=
  ((isUnit_polynomialResidueClass_iff_isCoprime K g F.1).2 hF).unit_spec

/-- Monic degree-`n` polynomials defining points of the symmetric power of
`A¹ - V(g)`. -/
structure MonicCoprimePolynomial (g : Polynomial K) (n : ℕ) where
  polynomial : Polynomial.MonicDegreeEq K n
  coprime : IsCoprime g polynomial.1

namespace MonicCoprimePolynomial

noncomputable def residueUnit {g : Polynomial K} {n : ℕ}
    (F : MonicCoprimePolynomial K g n) : (ProgressionAlgebra K g)ˣ :=
  monicCoprimeResidueUnit K g F.polynomial F.coprime

@[simp]
theorem coe_residueUnit {g : Polynomial K} {n : ℕ}
    (F : MonicCoprimePolynomial K g n) :
    ↑F.residueUnit = polynomialResidueClass K g F.polynomial.1 :=
  coe_monicCoprimeResidueUnit K g F.polynomial F.coprime

end MonicCoprimePolynomial

/-- The point-level form of Sawin's large-block product decomposition.  The
auxiliary type `R` packages all remaining blocks; only their product residue
unit is needed. -/
noncomputable def largeBlockProductCoordinates
    {m n : ℕ} (g : Polynomial K) (hg : g.Monic)
    (hgdeg : g.natDegree = m) (hmn : m ≤ n)
    (R : Type*) (restUnit : R → (ProgressionAlgebra K g)ˣ) :
    MonicCoprimePolynomial K g n × R ≃
      (ProgressionAlgebra K g)ˣ ×
        Polynomial.MonicDegreeEq K (n - m) × R where
  toFun x :=
    (x.1.residueUnit * restUnit x.2,
      monicQuotientOfDegree K g hg hgdeg hmn x.1.polynomial, x.2)
  invFun y := by
    let v : (ProgressionAlgebra K g)ˣ := y.1 * (restUnit y.2.2)⁻¹
    let r := progressionAlgebraRemainder K g hg (v : ProgressionAlgebra K g)
    have hrdeg : r.degree < (m : WithBot ℕ) := by
      change (progressionAlgebraRemainder K g hg
        (v : ProgressionAlgebra K g)).degree < (m : WithBot ℕ)
      rw [← hgdeg, ← Polynomial.degree_eq_natDegree hg.ne_zero]
      exact progressionAlgebraRemainder_degree_lt K g hg _
    let F := monicDegreeEqOfRemainderQuotient K
      g r hg hgdeg hrdeg hmn y.2.1
    have hFres : polynomialResidueClass K g F.1 =
        (v : ProgressionAlgebra K g) := by
      calc
        polynomialResidueClass K g F.1 =
            polynomialResidueClass K g (F.1 %ₘ g) :=
          (polynomialResidueClass_modByMonic K g F.1 hg).symm
        _ = polynomialResidueClass K g r := by
          rw [monicDegreeEqOfRemainderQuotient_modByMonic K]
        _ = (v : ProgressionAlgebra K g) :=
          polynomialResidueClass_progressionAlgebraRemainder K g hg _
    have hFcop : IsCoprime g F.1 :=
      (isUnit_polynomialResidueClass_iff_isCoprime K g F.1).1
        (hFres.symm ▸ v.isUnit)
    exact (⟨F, hFcop⟩, y.2.2)
  left_inv x := by
    rcases x with ⟨F, z⟩
    apply Prod.ext
    · cases F with
      | mk P hP =>
        dsimp only
        congr 1
        apply Subtype.ext
        have hv :
            (↑(monicCoprimeResidueUnit K g P hP * restUnit z *
                (restUnit z)⁻¹) : ProgressionAlgebra K g) =
              polynomialResidueClass K g P.1 := by
          simp
        simp only [MonicCoprimePolynomial.residueUnit]
        have hr := progressionAlgebraRemainder_eq_modByMonic_of_residueClass_eq K
          g P.1 hg _ hv.symm
        change progressionAlgebraRemainder K g hg
            (↑(monicCoprimeResidueUnit K g P hP * restUnit z *
              (restUnit z)⁻¹) : ProgressionAlgebra K g) +
            g * (P.1 /ₘ g) = P.1
        rw [hr]
        exact Polynomial.modByMonic_add_div P.1 g
    · rfl
  right_inv y := by
    rcases y with ⟨u, H, z⟩
    apply Prod.ext
    · apply Units.ext
      dsimp only
      let v : (ProgressionAlgebra K g)ˣ := u * (restUnit z)⁻¹
      let r := progressionAlgebraRemainder K g hg (v : ProgressionAlgebra K g)
      have hrdeg : r.degree < (m : WithBot ℕ) := by
        change (progressionAlgebraRemainder K g hg
          (v : ProgressionAlgebra K g)).degree < (m : WithBot ℕ)
        rw [← hgdeg, ← Polynomial.degree_eq_natDegree hg.ne_zero]
        exact progressionAlgebraRemainder_degree_lt K g hg _
      let P := monicDegreeEqOfRemainderQuotient K
        g r hg hgdeg hrdeg hmn H
      have hPres : polynomialResidueClass K g P.1 =
          (v : ProgressionAlgebra K g) := by
        calc
          polynomialResidueClass K g P.1 =
              polynomialResidueClass K g (P.1 %ₘ g) :=
            (polynomialResidueClass_modByMonic K g P.1 hg).symm
          _ = polynomialResidueClass K g r := by
            rw [monicDegreeEqOfRemainderQuotient_modByMonic K]
          _ = (v : ProgressionAlgebra K g) :=
            polynomialResidueClass_progressionAlgebraRemainder K g hg _
      change polynomialResidueClass K g P.1 * ↑(restUnit z) = ↑u
      rw [hPres]
      simp [v]
    · apply Prod.ext
      · apply Subtype.ext
        exact monicDegreeEqOfRemainderQuotient_divByMonic K
          g (progressionAlgebraRemainder K g hg
            (↑(u * (restUnit z)⁻¹) : ProgressionAlgebra K g))
          hg hgdeg (by
            rw [← hgdeg, ← Polynomial.degree_eq_natDegree hg.ne_zero]
            exact progressionAlgebraRemainder_degree_lt K g hg _) hmn H
      · rfl

/-- A family of coprime monic block polynomials of prescribed degrees. -/
abbrev MonicCoprimeBlockFamily
    (g : Polynomial K) {I : Type*} (size : I → ℕ) :=
  ∀ i, MonicCoprimePolynomial K g (size i)

noncomputable def blockFamilyResidueUnit
    (g : Polynomial K) {I : Type*} [Fintype I]
    {size : I → ℕ} (F : MonicCoprimeBlockFamily K g size) :
    (ProgressionAlgebra K g)ˣ :=
  ∏ i, (F i).residueUnit

/-- The product residue contributed by all blocks except a distinguished
large block. -/
noncomputable def remainingBlockResidueUnit
    (g : Polynomial K) {I : Type*} [Fintype I]
    (size : I → ℕ) (i : I)
    (F : ∀ j : {j // j ≠ i},
      MonicCoprimePolynomial K g (size j)) :
    (ProgressionAlgebra K g)ˣ := by
  classical
  exact ∏ j, (F j).residueUnit

theorem selected_mul_remainingBlockResidueUnit
    (g : Polynomial K) {I : Type*} [Fintype I]
    (size : I → ℕ) (i : I) (F : MonicCoprimeBlockFamily K g size) :
    (F i).residueUnit *
        remainingBlockResidueUnit K g size i
          (fun j => F j) =
      blockFamilyResidueUnit K g F := by
  classical
  let f : I → (ProgressionAlgebra K g)ˣ := fun j => (F j).residueUnit
  have hrest :
      (∏ j ∈ Finset.univ.erase i, f j) =
        remainingBlockResidueUnit K g size i (fun j => F j) := by
    exact Finset.prod_subtype (Finset.univ.erase i) (by simp) f
  rw [← hrest]
  exact Finset.mul_prod_erase Finset.univ f (Finset.mem_univ i)

/-- Sawin's large-block coordinate isomorphism for an arbitrary finite
labelled block decomposition. -/
noncomputable def largeBlockFamilyCoordinates
    {m : ℕ} (g : Polynomial K) (hg : g.Monic)
    (hgdeg : g.natDegree = m)
    {I : Type*} [Fintype I] (size : I → ℕ)
    (i : I) (hmi : m ≤ size i) :
    MonicCoprimeBlockFamily K g size ≃
      (ProgressionAlgebra K g)ˣ ×
        Polynomial.MonicDegreeEq K (size i - m) ×
          (∀ j : {j // j ≠ i},
            MonicCoprimePolynomial K g (size j)) := by
  classical
  exact (Equiv.piSplitAt i
    (fun j => MonicCoprimePolynomial K g (size j))).trans
      (largeBlockProductCoordinates K g hg hgdeg hmi
        (∀ j : {j // j ≠ i}, MonicCoprimePolynomial K g (size j))
        (remainingBlockResidueUnit K g size i))

theorem largeBlockFamilyCoordinates_fst
    {m : ℕ} (g : Polynomial K) (hg : g.Monic)
    (hgdeg : g.natDegree = m)
    {I : Type*} [Fintype I] (size : I → ℕ)
    (i : I) (hmi : m ≤ size i) (F : MonicCoprimeBlockFamily K g size) :
    (largeBlockFamilyCoordinates K g hg hgdeg size i hmi F).1 =
      blockFamilyResidueUnit K g F := by
  classical
  change (F i).residueUnit *
      remainingBlockResidueUnit K g size i (fun j => F j) =
    blockFamilyResidueUnit K g F
  exact selected_mul_remainingBlockResidueUnit K g size i F

/-- The fiber over a prescribed product residue. -/
abbrev MonicCoprimeBlockFiber
    (g : Polynomial K) {I : Type*} [Fintype I]
    (size : I → ℕ) (u : (ProgressionAlgebra K g)ˣ) :=
  {F : MonicCoprimeBlockFamily K g size // blockFamilyResidueUnit K g F = u}

/-- Every large-block fiber has the same explicit coordinates, independently
of the target unit. -/
noncomputable def largeBlockFiberEquiv
    {m : ℕ} (g : Polynomial K) (hg : g.Monic)
    (hgdeg : g.natDegree = m)
    {I : Type*} [Fintype I] (size : I → ℕ)
    (i : I) (hmi : m ≤ size i) (u : (ProgressionAlgebra K g)ˣ) :
    MonicCoprimeBlockFiber K g size u ≃
      Polynomial.MonicDegreeEq K (size i - m) ×
        (∀ j : {j // j ≠ i}, MonicCoprimePolynomial K g (size j)) where
  toFun F := (largeBlockFamilyCoordinates K g hg hgdeg size i hmi F.1).2
  invFun x := by
    let E := largeBlockFamilyCoordinates K g hg hgdeg size i hmi
    refine ⟨E.symm (u, x), ?_⟩
    rw [← largeBlockFamilyCoordinates_fst K g hg hgdeg size i hmi]
    exact congrArg Prod.fst (E.apply_symm_apply (u, x))
  left_inv F := by
    apply Subtype.ext
    dsimp only
    let E := largeBlockFamilyCoordinates K g hg hgdeg size i hmi
    have hu : u = (E F.1).1 := by
      rw [largeBlockFamilyCoordinates_fst K g hg hgdeg size i hmi]
      exact F.2.symm
    calc
      E.symm (u, (E F.1).2) =
          E.symm ((E F.1).1, (E F.1).2) :=
        congrArg E.symm (Prod.ext hu rfl)
      _ = F.1 := by
        simpa only [Prod.eta] using E.symm_apply_apply F.1
  right_inv x := by
    let E := largeBlockFamilyCoordinates K g hg hgdeg size i hmi
    change (E (E.symm (u, x))).2 = x
    exact congrArg Prod.snd (E.apply_symm_apply (u, x))

/-- The remainder modulo `g` of the universal product of linear factors. -/
def universalRootRemainder (n : ℕ) (g : Polynomial K) (hg : g.Monic) :
    Polynomial Γ(AffineRootSpace K n, ⊤) :=
  (universalRootPolynomial K n) %ₘ
    (g.map (rootCoefficientMap K n))

/-- Scheme-level version of Sawin's multiplication map into the affine
space underlying `K[t]/g`: record all coefficients of the remainder. -/
def affineResidueMultiplication (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    AffineRootSpace K n ⟶ AffineSpace (RootIndex m) (Spec (.of K)) :=
  AffineSpace.homOfVector (AffineRootSpace K n ↘ Spec (.of K))
    (fun j ↦ (universalRootRemainder K n g hg).coeff j.down)

/-- Restriction of the residue multiplication map to `C^n`. -/
def residueMultiplication (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    RootSpace K n g ⟶ AffineSpace (RootIndex m) (Spec (.of K)) :=
  (RootSpaceOpen K n g).ι ≫ affineResidueMultiplication K n m g hg

/-- The affine point whose coordinates are the first `m` coefficients of
the residue polynomial `a`. -/
def residuePoint (m : ℕ) (a : Polynomial K) :
    Spec (.of K) ⟶ AffineSpace (RootIndex m) (Spec (.of K)) :=
  AffineSpace.homOfVector (𝟙 (Spec (.of K)))
    (fun j ↦ (Scheme.ΓSpecIso (.of K)).inv (a.coeff j.down))

/-- The scheme-theoretic fiber of the specialized multiplication map over
the residue class represented by `a`. -/
def ResidueFiber (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) : Scheme.{u} :=
  pullback (residueMultiplication K n m g hg) (residuePoint K m a)

/-- The fiber maps to ordered root space. -/
def residueFiberToRootSpace (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    ResidueFiber K n m g a hg ⟶ RootSpace K n g :=
  pullback.fst _ _

/-- The structural map of the fiber to the ground field. -/
def residueFiberProjection (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    ResidueFiber K n m g a hg ⟶ Spec (.of K) :=
  pullback.snd _ _

/-- The defining cartesian square of the multiplication fiber. -/
theorem residueFiber_condition (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    residueFiberToRootSpace K n m g a hg ≫ residueMultiplication K n m g hg =
      residueFiberProjection K n m g a hg ≫ residuePoint K m a := by
  exact pullback.condition

/-- The residue multiplication morphism lies over `Spec K`. -/
@[reassoc (attr := simp)]
theorem affineResidueMultiplication_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    affineResidueMultiplication K n m g hg ≫
        (AffineSpace (RootIndex m) (Spec (.of K)) ↘ Spec (.of K)) =
      (AffineRootSpace K n ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

/-- Coordinate pullback is the corresponding remainder coefficient. -/
@[simp]
theorem affineResidueMultiplication_appTop_coord
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) (j : Fin m) :
    (affineResidueMultiplication K n m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (universalRootRemainder K n g hg).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

/-- Pullback along residue multiplication fixes the ground-field
coefficients. -/
theorem affineResidueMultiplication_rootCoefficientMap
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) (a : K) :
    (affineResidueMultiplication K n m g hg).appTop
        (rootCoefficientMap K m a) =
      rootCoefficientMap K n a := by
  unfold rootCoefficientMap
  change (affineResidueMultiplication K n m g hg).appTop
      ((AffineRootSpace K m ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  change (((AffineRootSpace K m ↘ Spec (.of K)).appTop ≫
      (affineResidueMultiplication K n m g hg).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (affineResidueMultiplication_over K n m g hg)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]
  rfl

/-- Sawin's residue multiplication map is affine.  This is the exact
scheme-theoretic hypothesis used with Artin's affine theorem in Lemma 4.1. -/
theorem isAffineHom_residueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    IsAffineHom (residueMultiplication K n m g hg) := by
  let : IsAffine (AffineRootSpace K n) := inferInstance
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  let : IsAffine (AffineSpace (RootIndex m) (Spec (.of K))) := inferInstance
  infer_instance

/-- If `deg g = m`, the universal remainder really is represented by its
`m` target coordinates. -/
theorem universalRootRemainder_degree_lt
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (universalRootRemainder K n g hg).degree < (m : WithBot ℕ) := by
  unfold universalRootRemainder
  have hgm : (g.map (rootCoefficientMap K n)).Monic := hg.map _
  have hn : (g.map (rootCoefficientMap K n)).natDegree = m := by
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]
  have hlt := Polynomial.degree_modByMonic_lt
    (universalRootPolynomial K n) hgm
  rwa [Polynomial.degree_eq_natDegree hgm.ne_zero, hn] at hlt

/-- The root space, coefficient target, base point, and hence the
scheme-theoretic residue fiber are affine. -/
theorem isAffine_residueFiber
    (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    IsAffine (ResidueFiber K n m g a hg) := by
  let : IsAffine (AffineRootSpace K n) := inferInstance
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  let : IsAffine (AffineSpace (RootIndex m) (Spec (.of K))) := inferInstance
  let : IsAffine (Spec (.of K)) := inferInstance
  dsimp [ResidueFiber]
  infer_instance

/-- The fiber projection is an affine morphism. -/
theorem isAffineHom_residueFiberProjection
    (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    IsAffineHom (residueFiberProjection K n m g a hg) := by
  let : IsAffine (ResidueFiber K n m g a hg) :=
    isAffine_residueFiber K n m g a hg
  infer_instance

/-- The fiber projection is the base change of the affine residue
multiplication map. -/
theorem isPullback_residueFiber
    (n m : ℕ) (g a : Polynomial K) (hg : g.Monic) :
    IsPullback
      (residueFiberToRootSpace K n m g a hg)
      (residueFiberProjection K n m g a hg)
      (residueMultiplication K n m g hg)
      (residuePoint K m a) := by
  exact IsPullback.of_hasPullback _ _

/-! The checked polynomial differential gives an honest tangent-dimension
statement on the proper, pairwise-coprime three-factor stratum. -/

/-- Zariski tangent model of the fiber of three-factor multiplication at
`(p,q,s)`. -/
abbrev ThreeFactorFiberTangent
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d) :=
  LinearMap.ker
    (PolynomialInfrastructure.multiplicationDifferential d p q s
      hp hq hs hpdeg hqdeg hsdeg)

/-- At a pairwise-coprime triple the tangent space is the zero submodule. -/
theorem threeFactorFiberTangent_eq_bot
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s) (hqs : IsCoprime q s) :
    ThreeFactorFiberTangent K d p q s hp hq hs hpdeg hqdeg hsdeg = ⊥ := by
  exact LinearMap.ker_eq_bot.mpr
    (PolynomialInfrastructure.multiplicationDifferential_injective
      d p q s hp hq hs hpdeg hqdeg hsdeg hpq hps hqs)

/-- Consequently the Zariski tangent dimension of the three-factor fiber
at a pairwise-coprime point is zero. -/
theorem threeFactorFiberTangent_finrank_eq_zero
    (d : ℕ) (p q s : Polynomial K)
    (hp : p.Monic) (hq : q.Monic) (hs : s.Monic)
    (hpdeg : p.natDegree = d) (hqdeg : q.natDegree = d)
    (hsdeg : s.natDegree = d)
    (hpq : IsCoprime p q) (hps : IsCoprime p s) (hqs : IsCoprime q s) :
    Module.finrank K
      (ThreeFactorFiberTangent K d p q s hp hq hs hpdeg hqdeg hsdeg) = 0 := by
  let : FiniteDimensional K (Polynomial.degreeLT K d) :=
    (Polynomial.degreeLTEquiv K d).symm.finiteDimensional
  rw [Submodule.finrank_eq_zero]
  exact threeFactorFiberTangent_eq_bot K d p q s hp hq hs
    hpdeg hqdeg hsdeg hpq hps hqs

end SawinGeometry

namespace SawinGeometry

variable (K : Type u) [Field K]

/-- The resultant of `g` with the universal product of linear factors is,
up to its harmless sign, the product of the evaluations of `g`. -/
theorem resultant_universalRootPolynomial
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    Polynomial.resultant (g.map (rootCoefficientMap K n))
        (universalRootPolynomial K n) m n =
      (-1 : Γ(AffineRootSpace K n, ⊤)) ^ (m * n) *
        rootAvoidanceSection K n g := by
  unfold universalRootPolynomial rootAvoidanceSection rootEvaluationSection
  have hgm : (g.map (rootCoefficientMap K n)).natDegree = m := by
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]
  have hpdeg :
      (∏ i : Fin n, (Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K)) (ULift.up i)))).natDegree = n := by
    have h := Polynomial.natDegree_prod_of_monic
      (s := Finset.univ)
      (f := fun i : Fin n ↦ Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K)) (ULift.up i)))
      (by intro i _; exact Polynomial.monic_X_sub_C _)
    simpa using h
  have hr := Polynomial.resultant_prod_right Finset.univ
    (g.map (rootCoefficientMap K n))
    (fun i : Fin n ↦ Polynomial.X - Polynomial.C
      (AffineSpace.coord (Spec (.of K)) (ULift.up i))) m (by omega) (by simp)
  rw [hpdeg] at hr
  rw [hr]
  have hi (i : Fin n) :
      (g.map (rootCoefficientMap K n)).resultant
          (Polynomial.X - Polynomial.C
            (AffineSpace.coord (Spec (.of K)) (ULift.up i))) m =
        (-1) ^ m * Polynomial.eval
          (AffineSpace.coord (Spec (.of K)) (ULift.up i))
          (g.map (rootCoefficientMap K n)) := by
    simpa using Polynomial.resultant_X_sub_C_right
      (g.map (rootCoefficientMap K n)) m
      (AffineSpace.coord (Spec (.of K)) (ULift.up i)) (by omega)
  simp_rw [hi]
  rw [Finset.prod_mul_distrib]
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [← pow_mul]
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  rw [Polynomial.eval_map]

/-- Reduction modulo a monic polynomial preserves coprimality with the
modulus. -/
theorem isCoprime_modByMonic_right_iff
    (f p : Polynomial K) (hf : f.Monic) :
    IsCoprime f (p %ₘ f) ↔ IsCoprime f p := by
  let r := p %ₘ f
  let q := p /ₘ f
  have hdiv : r + f * q = p := p.modByMonic_add_div f
  change p %ₘ f + f * q = p at hdiv
  constructor
  · rintro ⟨a, b, hab⟩
    refine ⟨a - b * q, b, ?_⟩
    linear_combination hab - b * hdiv
  · rintro ⟨a, b, hab⟩
    refine ⟨a + b * q, b, ?_⟩
    linear_combination hab + b * hdiv

/-- Padded resultants are unchanged when the right input is reduced modulo
a monic left input. -/
theorem resultant_modByMonic_right_padded
    {R : Type u} [CommRing R]
    (f p : Polynomial R) (hf : f.Monic)
    (m n : ℕ) (hfm : f.natDegree = m) (hpn : p.natDegree = n)
    (hmn : m ≤ n) :
    Polynomial.resultant f (p %ₘ f) m n =
      Polynomial.resultant f p m n := by
  have hq : (p /ₘ f).natDegree + m ≤ n := by
    rw [Polynomial.natDegree_divByMonic p hf, hpn, hfm,
      Nat.sub_add_cancel hmn]
  have h := Polynomial.resultant_add_mul_right f (p %ₘ f) (p /ₘ f)
    m n hq (by omega)
  rw [p.modByMonic_add_div f] at h
  exact h.symm

/-- The universal polynomial of degree strictly less than `m` on its
coefficient affine space. -/
def universalResiduePolynomial (m : ℕ) :
    Polynomial Γ(AffineRootSpace K m, ⊤) :=
  ∑ j : Fin m,
    Polynomial.C (AffineSpace.coord (Spec (.of K)) (ULift.up j)) *
      Polynomial.X ^ j.1

/-- Pulling the universal residue polynomial back along the coefficient
morphism reconstructs the universal remainder. -/
theorem universalResiduePolynomial_map_affineResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (universalResiduePolynomial K m).map
        (affineResidueMultiplication K n m g hg).appTop.hom =
      universalRootRemainder K n g hg := by
  let r := universalRootRemainder K n g hg
  have hrdeg : r.degree < (m : WithBot ℕ) :=
    universalRootRemainder_degree_lt K n m g hg hdeg
  rw [universalResiduePolynomial, Polynomial.map_sum]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
    Polynomial.map_pow, affineResidueMultiplication_appTop_coord]
  by_cases hr : r = 0
  · change universalRootRemainder K n g hg = 0 at hr
    rw [hr]
    simp
  have hrnat : r.natDegree < m :=
    (Polynomial.natDegree_lt_iff_degree_lt hr).mpr hrdeg
  change (∑ x : Fin m, Polynomial.C (r.coeff x) * Polynomial.X ^ x.1) = r
  rw [Fin.sum_univ_eq_sum_range
    (fun i : ℕ ↦ Polynomial.C (r.coeff i) * Polynomial.X ^ i) m]
  exact (r.as_sum_range_C_mul_X_pow' hrnat).symm

/-! ### Symmetric powers of the punctured affine line

The quotient `Cⁿ/Sₙ` is the resultant open in monic coefficient space.  The
following definitions and pullback theorem identify it scheme-theoretically
with the quotient of the ordered root space used above. -/

/-- The universal monic polynomial on coefficient affine `n`-space. -/
noncomputable def universalMonicCoefficientPolynomial (n : ℕ) :
    Polynomial Γ(AffineRootSpace K n, ⊤) :=
  universalResiduePolynomial K n + Polynomial.X ^ n

@[simp]
theorem universalMonicCoefficientPolynomial_coeff_lt
    (n : ℕ) (j : Fin n) :
    (universalMonicCoefficientPolynomial K n).coeff j =
      AffineSpace.coord (Spec (.of K)) (ULift.up j) := by
  classical
  simp only [universalMonicCoefficientPolynomial, universalResiduePolynomial,
    Polynomial.coeff_add, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_X_pow]
  rw [Finset.sum_eq_single j]
  · rw [if_neg (Nat.ne_of_lt j.isLt)]
    simp
  · intro b _hb hbj
    rw [if_neg]
    exact fun hval => hbj (Fin.ext hval.symm)
  · intro hj
    simp at hj

@[simp]
theorem universalMonicCoefficientPolynomial_coeff_natDegree (n : ℕ) :
    (universalMonicCoefficientPolynomial K n).coeff n = 1 := by
  classical
  simp only [universalMonicCoefficientPolynomial, universalResiduePolynomial,
    Polynomial.coeff_add, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_X_pow]
  have hsum :
      (∑ x : Fin n,
        if n = (x : ℕ) then
          AffineSpace.coord (Spec (.of K)) (ULift.up x) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro x _hx
    rw [if_neg]
    exact Nat.ne_of_gt x.isLt
  rw [hsum]
  simp

theorem universalMonicCoefficientPolynomial_monic (n : ℕ) :
    (universalMonicCoefficientPolynomial K n).Monic := by
  rw [universalMonicCoefficientPolynomial, add_comm]
  exact Polynomial.monic_X_pow_add
    (Polynomial.degree_sum_fin_lt fun j : Fin n =>
      AffineSpace.coord (Spec (.of K)) (ULift.up j))

/-- The universal monic coefficient polynomial has exactly its displayed
degree. -/
theorem universalMonicCoefficientPolynomial_natDegree (n : ℕ) :
    (universalMonicCoefficientPolynomial K n).natDegree = n := by
  unfold universalMonicCoefficientPolynomial
  rw [add_comm]
  have hlt : (universalResiduePolynomial K n).degree <
      (Polynomial.X ^ n : Polynomial Γ(AffineRootSpace K n, ⊤)).degree := by
    simpa [universalResiduePolynomial] using
      (Polynomial.degree_sum_fin_lt fun j : Fin n =>
        AffineSpace.coord (Spec (.of K)) (ULift.up j))
  rw [Polynomial.natDegree_add_eq_left_of_degree_lt hlt]
  simp

/-- Pulling the universal monic coefficient polynomial back to ordered root
space gives the product of its universal linear factors. -/
theorem universalMonicCoefficientPolynomial_map_affineRootMultiplication
    (n : ℕ) :
    (universalMonicCoefficientPolynomial K n).map
        (affineRootMultiplication K n).appTop.hom =
      universalRootPolynomial K n := by
  let P := universalRootPolynomial K n
  have hPmonic : P.Monic := universalRootPolynomial_monic K n
  have hPnat : P.natDegree = n := by
    unfold P universalRootPolynomial
    have h := Polynomial.natDegree_prod_of_monic
      (s := Finset.univ)
      (f := fun i : Fin n ↦ Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K)) (ULift.up i)))
      (by intro i _; exact Polynomial.monic_X_sub_C _)
    simpa using h
  unfold universalMonicCoefficientPolynomial universalResiduePolynomial
  rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
    Polynomial.map_sum]
  simp only [Polynomial.map_mul, Polynomial.map_C,
    Polynomial.map_pow, Polynomial.map_X,
    affineRootMultiplication_appTop_coord]
  change (∑ j : Fin n, Polynomial.C (P.coeff j) * Polynomial.X ^ j.1) +
      Polynomial.X ^ n = P
  rw [Fin.sum_univ_eq_sum_range
    (fun i : ℕ => Polynomial.C (P.coeff i) * Polynomial.X ^ i) n]
  have hsum := P.as_sum_range_C_mul_X_pow'
    (show P.natDegree < n + 1 by omega)
  rw [Finset.sum_range_succ] at hsum
  have hcoeff : P.coeff n = 1 := by
    simpa only [hPnat] using hPmonic.coeff_natDegree
  rw [hcoeff] at hsum
  simpa using hsum.symm

/-- The resultant open representing monic degree-`n` polynomials coprime to
`g`, i.e. the symmetric power `C^(n)`. -/
noncomputable def monicCoprimeSection (n m : ℕ) (g : Polynomial K) :
    Γ(AffineRootSpace K n, ⊤) :=
  (g.map (rootCoefficientMap K n)).resultant
    (universalMonicCoefficientPolynomial K n) m n

noncomputable def SymmetricCoprimeMonicOpen
    (n m : ℕ) (g : Polynomial K) : (AffineRootSpace K n).Opens :=
  (AffineRootSpace K n).basicOpen (monicCoprimeSection K n m g)

noncomputable abbrev SymmetricCoprimeMonicSpace
    (n m : ℕ) (g : Polynomial K) : Scheme.{u} :=
  (SymmetricCoprimeMonicOpen K n m g).toScheme

theorem isAffine_symmetricCoprimeMonicSpace
    (n m : ℕ) (g : Polynomial K) :
    IsAffine (SymmetricCoprimeMonicSpace K n m g) := by
  change IsAffine ((AffineRootSpace K n).basicOpen _)
  infer_instance

noncomputable def symmetricCoprimeMonicProjection
    (n m : ℕ) (g : Polynomial K) :
    SymmetricCoprimeMonicSpace K n m g ⟶ Spec (.of K) :=
  (SymmetricCoprimeMonicOpen K n m g).ι ≫
    (AffineRootSpace K n ↘ Spec (.of K))

theorem smooth_symmetricCoprimeMonicProjection
    (n m : ℕ) (g : Polynomial K) :
    Smooth (symmetricCoprimeMonicProjection K n m g) := by
  unfold symmetricCoprimeMonicProjection
  let : Smooth (AffineRootSpace K n ↘ Spec (.of K)) :=
    smooth_affineRootSpace_projection K n
  infer_instance

theorem affineRootMultiplication_rootCoefficientMap
    (n : ℕ) (a : K) :
    (affineRootMultiplication K n).appTop (rootCoefficientMap K n a) =
      rootCoefficientMap K n a := by
  unfold rootCoefficientMap
  change (affineRootMultiplication K n).appTop
      ((AffineRootSpace K n ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  change (((AffineRootSpace K n ↘ Spec (.of K)).appTop ≫
      (affineRootMultiplication K n).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (affineRootMultiplication_over K n)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]
  rfl

/-- The remainder modulo `g` of the universal monic polynomial on coefficient
space.  This is the symmetric-power counterpart of
`universalRootRemainder`. -/
def universalMonicRemainder (n : ℕ) (g : Polynomial K) (hg : g.Monic) :
    Polynomial Γ(AffineRootSpace K n, ⊤) :=
  (universalMonicCoefficientPolynomial K n) %ₘ
    (g.map (rootCoefficientMap K n))

/-- Coefficient-space residue multiplication: send a monic polynomial to
its remainder modulo `g`. -/
def affineMonicResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    AffineRootSpace K n ⟶ AffineSpace (RootIndex m) (Spec (.of K)) :=
  AffineSpace.homOfVector (AffineRootSpace K n ↘ Spec (.of K))
    (fun j ↦ (universalMonicRemainder K n g hg).coeff j.down)

@[reassoc (attr := simp)]
theorem affineMonicResidueMultiplication_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    affineMonicResidueMultiplication K n m g hg ≫
        (AffineSpace (RootIndex m) (Spec (.of K)) ↘ Spec (.of K)) =
      (AffineRootSpace K n ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

@[simp]
theorem affineMonicResidueMultiplication_appTop_coord
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) (j : Fin m) :
    (affineMonicResidueMultiplication K n m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (universalMonicRemainder K n g hg).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

/-- Pulling the universal monic remainder back to ordered roots gives the
ordered-root remainder. -/
theorem universalMonicRemainder_map_affineRootMultiplication
    (n : ℕ) (g : Polynomial K) (hg : g.Monic) :
    (universalMonicRemainder K n g hg).map
        (affineRootMultiplication K n).appTop.hom =
      universalRootRemainder K n g hg := by
  unfold universalMonicRemainder universalRootRemainder
  have hc : (affineRootMultiplication K n).appTop.hom.comp
      (rootCoefficientMap K n) = rootCoefficientMap K n := by
    ext a
    exact affineRootMultiplication_rootCoefficientMap K n a
  rw [Polynomial.map_modByMonic _ (hg.map _),
    universalMonicCoefficientPolynomial_map_affineRootMultiplication,
    Polynomial.map_map, hc]

/-- The ordered-root residue map factors through the finite symmetric
ordered-roots-to-coefficients quotient. -/
theorem affineRootMultiplication_comp_affineMonicResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    affineRootMultiplication K n ≫
        affineMonicResidueMultiplication K n m g hg =
      affineResidueMultiplication K n m g hg := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicResidueMultiplication_over,
      affineRootMultiplication_over, affineResidueMultiplication_over]
  · rintro ⟨j⟩
    rw [Scheme.Hom.comp_appTop]
    change (affineRootMultiplication K n).appTop
        ((affineMonicResidueMultiplication K n m g hg).appTop
          (AffineSpace.coord (Spec (.of K)) (ULift.up j))) =
      (affineResidueMultiplication K n m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j))
    rw [affineMonicResidueMultiplication_appTop_coord,
      affineResidueMultiplication_appTop_coord,
      ← Polynomial.coeff_map,
      universalMonicRemainder_map_affineRootMultiplication]

/-- The coefficient-space remainder is represented by its first `m`
coordinates when `deg g = m`. -/
theorem universalMonicRemainder_degree_lt
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (universalMonicRemainder K n g hg).degree < (m : WithBot ℕ) := by
  unfold universalMonicRemainder
  have hgm : (g.map (rootCoefficientMap K n)).Monic := hg.map _
  have hn : (g.map (rootCoefficientMap K n)).natDegree = m := by
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]
  have hlt := Polynomial.degree_modByMonic_lt
    (universalMonicCoefficientPolynomial K n) hgm
  rwa [Polynomial.degree_eq_natDegree hgm.ne_zero, hn] at hlt

/-- Pulling the universal residue polynomial back along coefficient-space
residue multiplication reconstructs the universal monic remainder. -/
theorem universalResiduePolynomial_map_affineMonicResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (universalResiduePolynomial K m).map
        (affineMonicResidueMultiplication K n m g hg).appTop.hom =
      universalMonicRemainder K n g hg := by
  let r := universalMonicRemainder K n g hg
  have hrdeg : r.degree < (m : WithBot ℕ) :=
    universalMonicRemainder_degree_lt K n m g hg hdeg
  rw [universalResiduePolynomial, Polynomial.map_sum]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
    Polynomial.map_pow, affineMonicResidueMultiplication_appTop_coord]
  by_cases hr : r = 0
  · change universalMonicRemainder K n g hg = 0 at hr
    rw [hr]
    simp
  have hrnat : r.natDegree < m :=
    (Polynomial.natDegree_lt_iff_degree_lt hr).mpr hrdeg
  change (∑ x : Fin m,
    Polynomial.C (r.coeff x) * Polynomial.X ^ x.1) = r
  rw [Fin.sum_univ_eq_sum_range
    (fun i : ℕ ↦ Polynomial.C (r.coeff i) * Polynomial.X ^ i) m]
  exact (r.as_sum_range_C_mul_X_pow' hrnat).symm

/-- Coefficient-space residue multiplication fixes the ground-field
coefficient map. -/
theorem affineMonicResidueMultiplication_rootCoefficientMap
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) (a : K) :
    (affineMonicResidueMultiplication K n m g hg).appTop
        (rootCoefficientMap K m a) = rootCoefficientMap K n a := by
  unfold rootCoefficientMap
  change (affineMonicResidueMultiplication K n m g hg).appTop
      ((AffineRootSpace K m ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  change (((AffineRootSpace K m ↘ Spec (.of K)).appTop ≫
      (affineMonicResidueMultiplication K n m g hg).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (affineMonicResidueMultiplication_over K n m g hg)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]
  rfl

theorem affineRootMultiplication_monicCoprimeSection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (affineRootMultiplication K n).appTop (monicCoprimeSection K n m g) =
      (-1 : Γ(AffineRootSpace K n, ⊤)) ^ (m * n) *
        rootAvoidanceSection K n g := by
  have hc : (affineRootMultiplication K n).appTop.hom.comp
      (rootCoefficientMap K n) = rootCoefficientMap K n := by
    ext a
    exact affineRootMultiplication_rootCoefficientMap K n a
  unfold monicCoprimeSection
  rw [← Polynomial.resultant_map_map,
    universalMonicCoefficientPolynomial_map_affineRootMultiplication,
    Polynomial.map_map, hc]
  exact resultant_universalRootPolynomial K n m g hg hdeg

/-- The ordered-to-symmetric multiplication morphism pulls the symmetric
coprimality open back to exactly `Cⁿ`. -/
theorem affineRootMultiplication_preimage_symmetricCoprimeMonicOpen
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    affineRootMultiplication K n ⁻¹ᵁ
        SymmetricCoprimeMonicOpen K n m g = RootSpaceOpen K n g := by
  unfold SymmetricCoprimeMonicOpen RootSpaceOpen
  rw [Scheme.preimage_basicOpen_top,
    affineRootMultiplication_monicCoprimeSection K n m g hg hdeg,
    Scheme.basicOpen_mul]
  rw [(AffineRootSpace K n).basicOpen_of_isUnit
    (isUnit_neg_one.pow (m * n))]
  simp

/-- The ordered-root multiplication map, factored through the symmetric
coprime-monic open. -/
noncomputable def rootMultiplicationToSymmetricCoprimeMonicSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    RootSpace K n g ⟶ SymmetricCoprimeMonicSpace K n m g :=
  IsOpenImmersion.lift (SymmetricCoprimeMonicOpen K n m g).ι
    (rootMultiplication K n g) (by
      rw [(SymmetricCoprimeMonicOpen K n m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : (RootSpaceOpen K n g).ι.base x ∈
          affineRootMultiplication K n ⁻¹ᵁ
          SymmetricCoprimeMonicOpen K n m g := by
        rw [affineRootMultiplication_preimage_symmetricCoprimeMonicOpen
          K n m g hg hdeg]
        exact x.2
      exact hx)

@[reassoc (attr := simp)]
theorem rootMultiplicationToSymmetricCoprimeMonicSpace_fac
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg ≫
        (SymmetricCoprimeMonicOpen K n m g).ι =
      rootMultiplication K n g := by
  exact IsOpenImmersion.lift_fac _ _ _

@[reassoc (attr := simp)]
theorem rootMultiplicationToSymmetricCoprimeMonicSpace_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg ≫
        symmetricCoprimeMonicProjection K n m g =
      rootSpaceProjection K n g := by
  unfold symmetricCoprimeMonicProjection rootSpaceProjection
  rw [← Category.assoc,
    rootMultiplicationToSymmetricCoprimeMonicSpace_fac]
  unfold rootMultiplication
  rw [Category.assoc, affineRootMultiplication_over]

set_option backward.isDefEq.respectTransparency.types false in
/-- Restricting the finite ordered-roots quotient to the coprimality open
remains finite.  The source open is identified with the pullback by the
resultant computation above. -/
theorem rootMultiplicationToSymmetricCoprimeMonicSpace_isFinite
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    IsFinite
      (rootMultiplicationToSymmetricCoprimeMonicSpace
        K n m g hg hdeg) := by
  let : IsFinite (affineRootMultiplication K n) :=
    affineRootMultiplication_isFinite K n
  let U := SymmetricCoprimeMonicOpen K n m g
  let e : affineRootMultiplication K n ⁻¹ᵁ U = RootSpaceOpen K n g :=
    affineRootMultiplication_preimage_symmetricCoprimeMonicOpen
      K n m g hg hdeg
  let i := (AffineRootSpace K n).isoOfEq e
  have hrestrict : IsFinite (affineRootMultiplication K n ∣_ U) := by
    infer_instance
  have heq : i.hom ≫
      rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg =
        affineRootMultiplication K n ∣_ U := by
    apply (cancel_mono U.ι).1
    rw [Category.assoc,
      rootMultiplicationToSymmetricCoprimeMonicSpace_fac,
      morphismRestrict_ι]
    unfold rootMultiplication
    rw [← Category.assoc, Scheme.isoOfEq_hom_ι]
  rw [← MorphismProperty.cancel_left_of_respectsIso
    (P := @IsFinite) i.hom, heq]
  exact hrestrict

/-- The universal resultant cutting out the nonunits in `K[t]/g`. -/
def residueUnitSection (m : ℕ) (g : Polynomial K) :
    Γ(AffineRootSpace K m, ⊤) :=
  (g.map (rootCoefficientMap K m)).resultant
    (universalResiduePolynomial K m) m m

/-- Pulling the unit resultant back along coefficient-space residue
multiplication gives the resultant with the universal monic remainder. -/
theorem affineMonicResidueMultiplication_residueUnitSection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (affineMonicResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) =
      (g.map (rootCoefficientMap K n)).resultant
        (universalMonicRemainder K n g hg) m m := by
  have hc : (affineMonicResidueMultiplication K n m g hg).appTop.hom.comp
      (rootCoefficientMap K m) = rootCoefficientMap K n := by
    ext a
    exact affineMonicResidueMultiplication_rootCoefficientMap K n m g hg a
  unfold residueUnitSection
  rw [← Polynomial.resultant_map_map,
    universalResiduePolynomial_map_affineMonicResidueMultiplication
      K n m g hg hdeg,
    Polynomial.map_map, hc]

/-- In the large-block degree range, that pulled-back unit resultant is
exactly the resultant defining the symmetric coprime-monic open. -/
theorem affineMonicResidueMultiplication_residueUnitSection_eq
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    (affineMonicResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) =
      monicCoprimeSection K n m g := by
  let F := g.map (rootCoefficientMap K n)
  let P := universalMonicCoefficientPolynomial K n
  let r := universalMonicRemainder K n g hg
  have hFmonic : F.Monic := hg.map _
  have hFdeg : F.natDegree = m := by
    dsimp [F]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]
  have hPdeg : P.natDegree = n := by
    exact universalMonicCoefficientPolynomial_natDegree K n
  have hrdeg : r.degree < (m : WithBot ℕ) := by
    exact universalMonicRemainder_degree_lt K n m g hg hdeg
  have hrle : r.natDegree ≤ m := by
    by_cases hr0 : r = 0
    · simp [hr0]
    · exact (Polynomial.natDegree_lt_iff_degree_lt hr0).mpr hrdeg |>.le
  have hcoeff : F.coeff m = 1 := by
    simpa [hFdeg] using hFmonic.coeff_natDegree
  have hpad : F.resultant r m n = F.resultant r m m := by
    calc
      F.resultant r m n = F.resultant r m (m + (n - m)) :=
        congrArg (fun j ↦ F.resultant r m j)
          (Nat.add_sub_of_le hmn).symm
      _ = F.resultant r m m := by
        simpa [hcoeff] using
          (Polynomial.resultant_add_right_deg F r m m (n - m) hrle)
  have hmod : F.resultant r m n = F.resultant P m n := by
    exact resultant_modByMonic_right_padded F P hFmonic
      m n hFdeg hPdeg hmn
  calc
    (affineMonicResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) = F.resultant r m m := by
      exact affineMonicResidueMultiplication_residueUnitSection
        K n m g hg hdeg
    _ = F.resultant r m n := hpad.symm
    _ = F.resultant P m n := hmod
    _ = monicCoprimeSection K n m g := rfl

/-- Pulling back the resultant section gives the resultant of `g` with the
universal remainder, with both Sylvester degree parameters padded to `m`. -/
theorem affineResidueMultiplication_residueUnitSection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (affineResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) =
      (g.map (rootCoefficientMap K n)).resultant
        (universalRootRemainder K n g hg) m m := by
  have hc : (affineResidueMultiplication K n m g hg).appTop.hom.comp
      (rootCoefficientMap K m) = rootCoefficientMap K n := by
    ext a
    exact affineResidueMultiplication_rootCoefficientMap K n m g hg a
  unfold residueUnitSection
  rw [← Polynomial.resultant_map_map,
    universalResiduePolynomial_map_affineResidueMultiplication K n m g hg hdeg,
    Polynomial.map_map, hc]

/-- On the degree range used by Sawin, the pulled-back unit resultant is,
up to a unit sign, exactly the root-avoidance section. -/
theorem affineResidueMultiplication_residueUnitSection_eq
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (_hm : 0 < m) (hmn : m ≤ n) :
    (affineResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) =
      (-1 : Γ(AffineRootSpace K n, ⊤)) ^ (m * n) *
        rootAvoidanceSection K n g := by
  let F := g.map (rootCoefficientMap K n)
  let P := universalRootPolynomial K n
  let r := universalRootRemainder K n g hg
  have hFmonic : F.Monic := hg.map _
  have hFdeg : F.natDegree = m := by
    dsimp [F]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]
  have hPdeg : P.natDegree = n := by
    dsimp [P, universalRootPolynomial]
    have h := Polynomial.natDegree_prod_of_monic
      (s := Finset.univ)
      (f := fun i : Fin n ↦ Polynomial.X - Polynomial.C
        (AffineSpace.coord (Spec (.of K)) (ULift.up i)))
      (by intro i _; exact Polynomial.monic_X_sub_C _)
    simpa using h
  have hrdeg : r.degree < (m : WithBot ℕ) := by
    exact universalRootRemainder_degree_lt K n m g hg hdeg
  have hrle : r.natDegree ≤ m := by
    by_cases hr0 : r = 0
    · simp [hr0]
    · exact (Polynomial.natDegree_lt_iff_degree_lt hr0).mpr hrdeg |>.le
  have hcoeff : F.coeff m = 1 := by
    simpa [hFdeg] using hFmonic.coeff_natDegree
  have hpad : F.resultant r m n = F.resultant r m m := by
    calc
      F.resultant r m n = F.resultant r m (m + (n - m)) :=
        congrArg (fun j ↦ F.resultant r m j) (Nat.add_sub_of_le hmn).symm
      _ = F.resultant r m m := by
        simpa [hcoeff] using
          (Polynomial.resultant_add_right_deg F r m m (n - m) hrle)
  have hmod : F.resultant r m n = F.resultant P m n := by
    exact resultant_modByMonic_right_padded F P hFmonic
      m n hFdeg hPdeg hmn
  calc
    (affineResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) = F.resultant r m m := by
      exact affineResidueMultiplication_residueUnitSection K n m g hg hdeg
    _ = F.resultant r m n := hpad.symm
    _ = F.resultant P m n := hmod
    _ = (-1 : Γ(AffineRootSpace K n, ⊤)) ^ (m * n) *
        rootAvoidanceSection K n g := by
      exact resultant_universalRootPolynomial K n m g hg hdeg

/-- Sawin's unit-valued coefficient target, represented as the principal
open where the universal residue polynomial is coprime to `g`. -/
def ResidueUnitOpen (m : ℕ) (g : Polynomial K) :
    (AffineRootSpace K m).Opens :=
  (AffineRootSpace K m).basicOpen (residueUnitSection K m g)

/-- The scheme representing invertible residue polynomials in `K[t]/g`. -/
abbrev ResidueUnitSpace (m : ℕ) (g : Polynomial K) : Scheme.{u} :=
  (ResidueUnitOpen K m g).toScheme

/-- The unit target is an open subscheme of coefficient affine space. -/
def residueUnitImmersion (m : ℕ) (g : Polynomial K) :
    ResidueUnitSpace K m g ⟶ AffineRootSpace K m :=
  (ResidueUnitOpen K m g).ι

/-- Structural morphism of the unit target. -/
def residueUnitProjection (m : ℕ) (g : Polynomial K) :
    ResidueUnitSpace K m g ⟶ Spec (.of K) :=
  residueUnitImmersion K m g ≫ (AffineRootSpace K m ↘ Spec (.of K))

/-- The coefficient-space residue morphism pulls the unit target back to
exactly the symmetric coprime-monic open. -/
theorem affineMonicResidueMultiplication_preimage_residueUnitOpen
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    affineMonicResidueMultiplication K n m g hg ⁻¹ᵁ
        ResidueUnitOpen K m g =
      SymmetricCoprimeMonicOpen K n m g := by
  unfold ResidueUnitOpen SymmetricCoprimeMonicOpen
  rw [Scheme.preimage_basicOpen_top,
    affineMonicResidueMultiplication_residueUnitSection_eq
      K n m g hg hdeg hmn]

/-- Residue multiplication on the symmetric power before restricting its
target to the unit open. -/
def symmetricCoprimeMonicResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    SymmetricCoprimeMonicSpace K n m g ⟶
      AffineSpace (RootIndex m) (Spec (.of K)) :=
  (SymmetricCoprimeMonicOpen K n m g).ι ≫
    affineMonicResidueMultiplication K n m g hg

/-- Residue multiplication from the symmetric power into the scheme of
units modulo `g`. -/
def symmetricCoprimeMonicResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    SymmetricCoprimeMonicSpace K n m g ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (symmetricCoprimeMonicResidueMultiplication K n m g hg) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : (SymmetricCoprimeMonicOpen K n m g).ι.base x ∈
          affineMonicResidueMultiplication K n m g hg ⁻¹ᵁ
            ResidueUnitOpen K m g := by
        rw [affineMonicResidueMultiplication_preimage_residueUnitOpen
          K n m g hg hdeg hmn]
        exact x.2
      exact hx)

@[reassoc (attr := simp)]
theorem symmetricCoprimeMonicResidueMultiplicationToUnit_fac
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    symmetricCoprimeMonicResidueMultiplicationToUnit
        K n m g hg hdeg hmn ≫ residueUnitImmersion K m g =
      symmetricCoprimeMonicResidueMultiplication K n m g hg := by
  exact IsOpenImmersion.lift_fac _ _ _

/-- The finite ordered-root quotient commutes with residue multiplication
before restricting the target to its unit open. -/
theorem rootMultiplicationToSymmetricCoprimeMonicSpace_comp_residue
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg ≫
        symmetricCoprimeMonicResidueMultiplication K n m g hg =
      residueMultiplication K n m g hg := by
  unfold symmetricCoprimeMonicResidueMultiplication
    residueMultiplication
  rw [← Category.assoc,
    rootMultiplicationToSymmetricCoprimeMonicSpace_fac]
  unfold rootMultiplication
  rw [Category.assoc,
    affineRootMultiplication_comp_affineMonicResidueMultiplication]

/-- The unit target is affine, since it is a principal open in affine
space. -/
theorem isAffine_residueUnitSpace (m : ℕ) (g : Polynomial K) :
    IsAffine (ResidueUnitSpace K m g) := by
  change IsAffine ((AffineRootSpace K m).basicOpen _)
  infer_instance

/-- The unit target is smooth over the ground field. -/
theorem smooth_residueUnitProjection (m : ℕ) (g : Polynomial K) :
    Smooth (residueUnitProjection K m g) := by
  unfold residueUnitProjection residueUnitImmersion
  let : Smooth (AffineRootSpace K m ↘ Spec (.of K)) :=
    smooth_affineRootSpace_projection K m
  infer_instance

/-- Consequently the unit target has a flat structural morphism. -/
theorem flat_residueUnitProjection (m : ℕ) (g : Polynomial K) :
    Flat (residueUnitProjection K m g) := by
  let : Smooth (residueUnitProjection K m g) :=
    smooth_residueUnitProjection K m g
  infer_instance

/-- The maximal open part of ordered root space on which the coefficient
map lands in the resultant-open unit target. -/
def ResidueUnitDomainOpen
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    (RootSpace K n g).Opens :=
  residueMultiplication K n m g hg ⁻¹ᵁ ResidueUnitOpen K m g

/-- In Sawin's degree range the multiplication map lands in the unit
target on every point of ordered root space. -/
theorem residueUnitDomainOpen_eq_top
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    ResidueUnitDomainOpen K n m g hg = ⊤ := by
  have haff : affineResidueMultiplication K n m g hg ⁻¹ᵁ
      ResidueUnitOpen K m g = RootSpaceOpen K n g := by
    unfold ResidueUnitOpen RootSpaceOpen
    rw [Scheme.preimage_basicOpen_top,
      affineResidueMultiplication_residueUnitSection_eq
        K n m g hg hdeg hm hmn,
      Scheme.basicOpen_mul]
    rw [(AffineRootSpace K n).basicOpen_of_isUnit
      (isUnit_neg_one.pow (m * n))]
    simp
  unfold ResidueUnitDomainOpen residueMultiplication
  rw [Scheme.Hom.comp_preimage, haff, Scheme.Opens.ι_preimage_self]

/-- Scheme underlying the maximal unit-valued domain. -/
abbrev ResidueUnitDomain
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) : Scheme.{u} :=
  (ResidueUnitDomainOpen K n m g hg).toScheme

/-- Sawin's multiplication morphism from all of ordered root space into
the resultant-open unit target. -/
def fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    RootSpace K n g ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (residueMultiplication K n m g hg) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ ResidueUnitDomainOpen K n m g hg := by
        rw [residueUnitDomainOpen_eq_top K n m g hg hdeg hm hmn]
        trivial
      exact hx)

/-- The full unit-valued morphism composes to the original coefficient
morphism. -/
@[reassoc (attr := simp)]
theorem fullResidueMultiplicationToUnit_fac
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn ≫
        residueUnitImmersion K m g =
      residueMultiplication K n m g hg := by
  exact IsOpenImmersion.lift_fac _ _ _

/-- The finite ordered-root quotient also commutes with the unit-valued
residue maps. -/
theorem rootMultiplicationToSymmetricCoprimeMonicSpace_comp_residueToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg ≫
      symmetricCoprimeMonicResidueMultiplicationToUnit
          K n m g hg hdeg hmn =
      fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn := by
  let : IsOpenImmersion (residueUnitImmersion K m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion K m g)).1
  rw [Category.assoc,
    symmetricCoprimeMonicResidueMultiplicationToUnit_fac,
    fullResidueMultiplicationToUnit_fac,
    rootMultiplicationToSymmetricCoprimeMonicSpace_comp_residue]

/-- The full unit-valued multiplication morphism is affine. -/
theorem isAffineHom_fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    IsAffineHom
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) := by
  let : IsAffine (AffineRootSpace K n) := inferInstance
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  let : IsAffine (ResidueUnitSpace K m g) :=
    isAffine_residueUnitSpace K m g
  infer_instance

/-- The residue multiplication map, genuinely factored through the
unit-valued target on its maximal open domain. -/
def residueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    ResidueUnitDomain K n m g hg ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    ((ResidueUnitDomainOpen K n m g hg).ι ≫
      residueMultiplication K n m g hg) (by
        rw [(ResidueUnitOpen K m g).range_ι]
        rintro _ ⟨x, rfl⟩
        exact x.2)

/-- The factored unit-valued map composes to the original coefficient
map. -/
@[reassoc (attr := simp)]
theorem residueMultiplicationToUnit_fac
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    residueMultiplicationToUnit K n m g hg ≫
        residueUnitImmersion K m g =
      (ResidueUnitDomainOpen K n m g hg).ι ≫
        residueMultiplication K n m g hg := by
  exact IsOpenImmersion.lift_fac _ _ _

/-- Structural map of the maximal unit-valued domain. -/
def residueUnitDomainProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    ResidueUnitDomain K n m g hg ⟶ Spec (.of K) :=
  (ResidueUnitDomainOpen K n m g hg).ι ≫ rootSpaceProjection K n g

/-- The maximal unit-valued domain remains smooth over the ground field. -/
theorem smooth_residueUnitDomainProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    Smooth (residueUnitDomainProjection K n m g hg) := by
  unfold residueUnitDomainProjection
  let : Smooth (rootSpaceProjection K n g) :=
    smooth_rootSpaceProjection K n g
  infer_instance

/-- The maximal unit-valued domain is affine. -/
theorem isAffine_residueUnitDomain
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    IsAffine (ResidueUnitDomain K n m g hg) := by
  let : IsAffine (AffineRootSpace K n) := inferInstance
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  unfold ResidueUnitDomain ResidueUnitDomainOpen ResidueUnitOpen
  rw [Scheme.preimage_basicOpen_top]
  infer_instance

/-- The factored multiplication morphism is affine. -/
theorem isAffineHom_residueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    IsAffineHom (residueMultiplicationToUnit K n m g hg) := by
  let : IsAffine (ResidueUnitDomain K n m g hg) :=
    isAffine_residueUnitDomain K n m g hg
  let : IsAffine (ResidueUnitSpace K m g) :=
    isAffine_residueUnitSpace K m g
  infer_instance

/-- A `K`-valued point of Sawin's unit target. -/
abbrev ResidueUnitPoint (m : ℕ) (g : Polynomial K) :=
  Spec (.of K) ⟶ ResidueUnitSpace K m g

/-- The full unit-valued multiplication morphism is over the ground field. -/
@[reassoc (attr := simp)]
theorem fullResidueMultiplicationToUnit_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn ≫
        residueUnitProjection K m g =
      rootSpaceProjection K n g := by
  unfold residueUnitProjection
  rw [← Category.assoc,
    fullResidueMultiplicationToUnit_fac K n m g hg hdeg hm hmn]
  unfold residueMultiplication rootSpaceProjection
  rw [Category.assoc, affineResidueMultiplication_over K n m g hg]

/-- The full multiplication morphism is locally of finite presentation. -/
theorem locallyOfFinitePresentation_fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    LocallyOfFinitePresentation
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) := by
  let f := fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn
  let p := residueUnitProjection K m g
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  let : IsAffine (ResidueUnitSpace K m g) :=
    isAffine_residueUnitSpace K m g
  let : IsAffine (Spec (.of K)) := inferInstance
  let : Smooth p := smooth_residueUnitProjection K m g
  have hpft : p.appTop.hom.FiniteType := by
    rw [← HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)]
    infer_instance
  let : LocallyOfFinitePresentation (rootSpaceProjection K n g) :=
    locallyOfFinitePresentation_rootSpaceProjection K n g
  have hcomp : (f ≫ p).appTop.hom.FinitePresentation := by
    rw [fullResidueMultiplicationToUnit_over K n m g hg hdeg hm hmn]
    exact (rootSpaceProjection K n g).finitePresentation_appTop
  rw [HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)]
  rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp] at hcomp
  exact RingHom.FinitePresentation.of_comp_finiteType p.appTop.hom hcomp hpft

theorem quasiCompact_fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    QuasiCompact
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) := by
  let : IsAffineHom
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) :=
    isAffineHom_fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn
  infer_instance

theorem isSeparated_fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    IsSeparated
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) := by
  let : IsAffineHom
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) :=
    isAffineHom_fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn
  infer_instance

/-- Fiber of residue multiplication on the symmetric power over a prescribed
unit modulo `g`. -/
noncomputable def SymmetricResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) : Scheme.{u} :=
  pullback
    (symmetricCoprimeMonicResidueMultiplicationToUnit
      K n m g hg hdeg hmn) t

noncomputable def symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    SymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      SymmetricCoprimeMonicSpace K n m g :=
  pullback.fst _ _

noncomputable def symmetricResidueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    SymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶ Spec (.of K) :=
  pullback.snd _ _

theorem symmetricResidueUnitFiber_condition
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
        K n m g hg hdeg hmn t ≫
        symmetricCoprimeMonicResidueMultiplicationToUnit
          K n m g hg hdeg hmn =
      symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t ≫ t := by
  exact pullback.condition

/-- Fiber of the full unit-valued multiplication map over a unit point. -/
noncomputable def FullResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) : Scheme.{u} :=
  pullback (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) t

noncomputable def fullResidueUnitFiberToRootSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    FullResidueUnitFiber K n m g hg hdeg hm hmn t ⟶ RootSpace K n g :=
  pullback.fst _ _

noncomputable def fullResidueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    FullResidueUnitFiber K n m g hg hdeg hm hmn t ⟶ Spec (.of K) :=
  pullback.snd _ _

theorem fullResidueUnitFiber_condition
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
        fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn =
      fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t ≫ t := by
  exact pullback.condition

/-- The finite ordered-roots-to-coefficients quotient restricts canonically
to every residue-unit fiber. -/
noncomputable def fullResidueUnitFiberToSymmetricResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    FullResidueUnitFiber K n m g hg hdeg hm hmn t ⟶
      SymmetricResidueUnitFiber K n m g hg hdeg hmn t :=
  pullback.lift
    (fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
      rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg)
    (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) (by
      calc
        (fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
              rootMultiplicationToSymmetricCoprimeMonicSpace
                K n m g hg hdeg) ≫
            symmetricCoprimeMonicResidueMultiplicationToUnit
              K n m g hg hdeg hmn =
          fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
            fullResidueMultiplicationToUnit
              K n m g hg hdeg hm hmn := by
                rw [Category.assoc,
                  rootMultiplicationToSymmetricCoprimeMonicSpace_comp_residueToUnit]
        _ = fullResidueUnitFiberProjection
              K n m g hg hdeg hm hmn t ≫ t :=
          fullResidueUnitFiber_condition K n m g hg hdeg hm hmn t)

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberToSymmetricResidueUnitFiber_fst
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    fullResidueUnitFiberToSymmetricResidueUnitFiber
        K n m g hg hdeg hm hmn t ≫
        symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
          K n m g hg hdeg hmn t =
      fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
        rootMultiplicationToSymmetricCoprimeMonicSpace K n m g hg hdeg := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberToSymmetricResidueUnitFiber_snd
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    fullResidueUnitFiberToSymmetricResidueUnitFiber
        K n m g hg hdeg hm hmn t ≫
        symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t =
      fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t := by
  exact pullback.lift_snd _ _ _

/-- The ordered-to-symmetric map on residue fibers is the base change of
the finite ordered-roots quotient. -/
theorem fullResidueUnitFiberToSymmetricResidueUnitFiber_isPullback
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsPullback
      (fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberToSymmetricResidueUnitFiber
        K n m g hg hdeg hm hmn t)
      (rootMultiplicationToSymmetricCoprimeMonicSpace
        K n m g hg hdeg)
      (symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
        K n m g hg hdeg hmn t) := by
  let q := rootMultiplicationToSymmetricCoprimeMonicSpace
    K n m g hg hdeg
  let s := symmetricCoprimeMonicResidueMultiplicationToUnit
    K n m g hg hdeg hmn
  let hqs : q ≫ s = fullResidueMultiplicationToUnit
      K n m g hg hdeg hm hmn :=
    rootMultiplicationToSymmetricCoprimeMonicSpace_comp_residueToUnit
      K n m g hg hdeg hm hmn
  have hmap :
      fullResidueUnitFiberToSymmetricResidueUnitFiber
          K n m g hg hdeg hm hmn t =
        CategoryTheory.pullbackFiberMapOfComm q s t hqs := by
    unfold fullResidueUnitFiberToSymmetricResidueUnitFiber
    unfold CategoryTheory.pullbackFiberMapOfComm
    rfl
  rw [hmap]
  exact CategoryTheory.pullbackFiberMapOfComm_isPullback q s t hqs

/-- Consequently the ordered-to-symmetric quotient on every residue fiber
is finite. -/
theorem fullResidueUnitFiberToSymmetricResidueUnitFiber_isFinite
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsFinite (fullResidueUnitFiberToSymmetricResidueUnitFiber
      K n m g hg hdeg hm hmn t) := by
  apply MorphismProperty.of_isPullback
    (fullResidueUnitFiberToSymmetricResidueUnitFiber_isPullback
      K n m g hg hdeg hm hmn t)
  exact rootMultiplicationToSymmetricCoprimeMonicSpace_isFinite
    K n m g hg hdeg

/-! ### Long-division coordinates on the symmetric residue fiber

The quotient of the universal monic polynomial by `g` supplies the free
affine coordinates in Sawin's proof of large-block constancy. -/

/-- The universal monic quotient after division by the fixed modulus. -/
noncomputable def universalMonicQuotient
    (n : ℕ) (g : Polynomial K) (hg : g.Monic) :
    Polynomial Γ(AffineRootSpace K n, ⊤) :=
  universalMonicCoefficientPolynomial K n /ₘ
    g.map (rootCoefficientMap K n)

theorem universalMonicQuotient_natDegree
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (universalMonicQuotient K n g hg).natDegree = n - m := by
  unfold universalMonicQuotient
  rw [Polynomial.natDegree_divByMonic _ (hg.map _),
    universalMonicCoefficientPolynomial_natDegree,
    Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K n)), hdeg]

theorem universalMonicQuotient_monic
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    (universalMonicQuotient K n g hg).Monic := by
  let P := universalMonicCoefficientPolynomial K n
  let G := g.map (rootCoefficientMap K n)
  have hP : P.Monic := universalMonicCoefficientPolynomial_monic K n
  have hG : G.Monic := hg.map _
  have hle : G.degree ≤ P.degree := by
    rw [Polynomial.degree_eq_natDegree hG.ne_zero,
      Polynomial.degree_eq_natDegree hP.ne_zero]
    change ((G.natDegree : ℕ) : WithBot ℕ) ≤
      ((P.natDegree : ℕ) : WithBot ℕ)
    rw [show G.natDegree = m by
      dsimp [G]
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective (rootCoefficientMap K n)), hdeg]]
    rw [show P.natDegree = n by
      exact universalMonicCoefficientPolynomial_natDegree K n]
    exact WithBot.coe_le_coe.mpr hmn
  rw [Polynomial.Monic.def]
  change (P /ₘ G).leadingCoeff = 1
  rw [Polynomial.leadingCoeff_divByMonic_of_monic hG hle]
  exact hP.leadingCoeff

/-- A monic polynomial is recovered from all coefficients below its degree. -/
theorem universalMonicCoefficientPolynomial_map_homOfVector
    {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) (d : ℕ)
    (P : Polynomial Γ(X, ⊤)) (hP : P.Monic)
    (hdeg : P.natDegree = d) :
    (universalMonicCoefficientPolynomial K d).map
        (AffineSpace.homOfVector f
          (fun j : RootIndex d ↦ P.coeff j.down)).appTop.hom = P := by
  unfold universalMonicCoefficientPolynomial universalResiduePolynomial
  rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
    Polynomial.map_sum]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
    Polynomial.map_X, AffineSpace.homOfVector_appTop_coord]
  change (∑ j : Fin d, Polynomial.C (P.coeff j) * Polynomial.X ^ j.1) +
      Polynomial.X ^ d = P
  rw [Fin.sum_univ_eq_sum_range
    (fun i : ℕ => Polynomial.C (P.coeff i) * Polynomial.X ^ i) d]
  have hsum := P.as_sum_range_C_mul_X_pow'
    (show P.natDegree < d + 1 by omega)
  rw [Finset.sum_range_succ] at hsum
  have hcoeff : P.coeff d = 1 := by
    simpa only [hdeg] using hP.coeff_natDegree
  rw [hcoeff] at hsum
  simpa using hsum.symm

/-- The quotient-coefficient morphism on affine monic-polynomial space. -/
noncomputable def affineMonicQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    AffineRootSpace K n ⟶ AffineRootSpace K (n - m) :=
  AffineSpace.homOfVector (AffineRootSpace K n ↘ Spec (.of K))
    (fun j ↦ (universalMonicQuotient K n g hg).coeff j.down)

@[reassoc (attr := simp)]
theorem affineMonicQuotient_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic) :
    affineMonicQuotient K n m g hg ≫
        (AffineRootSpace K (n - m) ↘ Spec (.of K)) =
      (AffineRootSpace K n ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

theorem universalMonicCoefficientPolynomial_map_affineMonicQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    (universalMonicCoefficientPolynomial K (n - m)).map
        (affineMonicQuotient K n m g hg).appTop.hom =
      universalMonicQuotient K n g hg := by
  exact universalMonicCoefficientPolynomial_map_homOfVector K _ _ _
    (universalMonicQuotient_monic K n m g hg hdeg hmn)
    (universalMonicQuotient_natDegree K n m g hg hdeg)

@[simp]
theorem universalResiduePolynomial_coeff
    (m : ℕ) (j : Fin m) :
    (universalResiduePolynomial K m).coeff j =
      AffineSpace.coord (Spec (.of K)) (ULift.up j) := by
  classical
  simp only [universalResiduePolynomial, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _hb hbj
    rw [if_neg]
    exact fun hval => hbj (Fin.ext hval.symm)
  · simp

/-- Pull the prescribed residue polynomial to the free quotient space. -/
noncomputable def residuePolynomialOnQuotient
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) :
    Polynomial Γ(AffineRootSpace K (n - m), ⊤) :=
  (universalResiduePolynomial K m).map
    (((AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t ≫
      residueUnitImmersion K m g).appTop.hom)

theorem residuePolynomialOnQuotient_degree_lt
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) :
    (residuePolynomialOnQuotient K n m g t).degree <
      (m : WithBot ℕ) := by
  unfold residuePolynomialOnQuotient
  apply Polynomial.degree_map_le.trans_lt
  exact Polynomial.degree_sum_fin_lt fun j : Fin m =>
    AffineSpace.coord (Spec (.of K)) (ULift.up j)

/-- Reconstruct the universal degree-`n` polynomial `r_t + g H`. -/
noncomputable def reconstructedMonicPolynomial
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) :
    Polynomial Γ(AffineRootSpace K (n - m), ⊤) :=
  residuePolynomialOnQuotient K n m g t +
    g.map (rootCoefficientMap K (n - m)) *
      universalMonicCoefficientPolynomial K (n - m)

theorem reconstructedMonicPolynomial_monic
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (reconstructedMonicPolynomial K n m g t).Monic := by
  let r := residuePolynomialOnQuotient K n m g t
  let G := g.map (rootCoefficientMap K (n - m))
  let H := universalMonicCoefficientPolynomial K (n - m)
  have hG : G.Monic := hg.map _
  have hH : H.Monic := universalMonicCoefficientPolynomial_monic K (n - m)
  have hprod : (G * H).Monic := hG.mul hH
  have hGnat : G.natDegree = m := by
    dsimp [G]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K (n - m))), hdeg]
  have hHnat : H.natDegree = n - m :=
    universalMonicCoefficientPolynomial_natDegree K (n - m)
  have hprodNat : (G * H).natDegree = n := by
    rw [hG.natDegree_mul hH, hGnat, hHnat, Nat.add_sub_of_le hmn]
  have hprodDegree : (G * H).degree = ((n : ℕ) : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hprod.ne_zero, hprodNat]
  have hrlt : r.degree < (G * H).degree := by
    rw [hprodDegree]
    exact (residuePolynomialOnQuotient_degree_lt K n m g t).trans_le
      (WithBot.coe_le_coe.mpr hmn)
  have hdegree : (r + G * H).degree = ((n : ℕ) : WithBot ℕ) :=
    (Polynomial.degree_add_eq_right_of_degree_lt hrlt).trans hprodDegree
  have hnat : (r + G * H).natDegree = n :=
    Polynomial.natDegree_eq_of_degree_eq_some hdegree
  change (r + G * H).Monic
  rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hnat,
    Polynomial.coeff_add,
    Polynomial.coeff_eq_zero_of_degree_lt (hrlt.trans_eq hprodDegree),
    zero_add]
  simpa only [hprodNat] using hprod.coeff_natDegree

theorem reconstructedMonicPolynomial_natDegree
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (reconstructedMonicPolynomial K n m g t).natDegree = n := by
  let r := residuePolynomialOnQuotient K n m g t
  let G := g.map (rootCoefficientMap K (n - m))
  let H := universalMonicCoefficientPolynomial K (n - m)
  have hG : G.Monic := hg.map _
  have hH : H.Monic := universalMonicCoefficientPolynomial_monic K (n - m)
  have hprod : (G * H).Monic := hG.mul hH
  have hGnat : G.natDegree = m := by
    dsimp [G]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K (n - m))), hdeg]
  have hHnat : H.natDegree = n - m :=
    universalMonicCoefficientPolynomial_natDegree K (n - m)
  have hprodNat : (G * H).natDegree = n := by
    rw [hG.natDegree_mul hH, hGnat, hHnat, Nat.add_sub_of_le hmn]
  have hprodDegree : (G * H).degree = ((n : ℕ) : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hprod.ne_zero, hprodNat]
  have hrlt : r.degree < (G * H).degree := by
    rw [hprodDegree]
    exact (residuePolynomialOnQuotient_degree_lt K n m g t).trans_le
      (WithBot.coe_le_coe.mpr hmn)
  change (r + G * H).natDegree = n
  exact Polynomial.natDegree_eq_of_degree_eq_some
    ((Polynomial.degree_add_eq_right_of_degree_lt hrlt).trans hprodDegree)

/-- The inverse coefficient morphism, sending `H` to `r_t + gH`. -/
noncomputable def affineMonicReconstruction
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) :
    AffineRootSpace K (n - m) ⟶ AffineRootSpace K n :=
  AffineSpace.homOfVector (AffineRootSpace K (n - m) ↘ Spec (.of K))
    (fun j ↦ (reconstructedMonicPolynomial K n m g t).coeff j.down)

@[reassoc (attr := simp)]
theorem affineMonicReconstruction_over
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) :
    affineMonicReconstruction K n m g t ≫
        (AffineRootSpace K n ↘ Spec (.of K)) =
      (AffineRootSpace K (n - m) ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

theorem universalMonicCoefficientPolynomial_map_affineMonicReconstruction
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (universalMonicCoefficientPolynomial K n).map
        (affineMonicReconstruction K n m g t).appTop.hom =
      reconstructedMonicPolynomial K n m g t := by
  exact universalMonicCoefficientPolynomial_map_homOfVector K _ _ _
    (reconstructedMonicPolynomial_monic K n m g hg hdeg hmn t)
    (reconstructedMonicPolynomial_natDegree K n m g hg hdeg hmn t)

theorem affineMonicReconstruction_rootCoefficientMap
    (n m : ℕ) (g : Polynomial K)
    (t : ResidueUnitPoint K m g) (a : K) :
    (affineMonicReconstruction K n m g t).appTop
        (rootCoefficientMap K n a) =
      rootCoefficientMap K (n - m) a := by
  unfold rootCoefficientMap
  change (affineMonicReconstruction K n m g t).appTop
      ((AffineRootSpace K n ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  change (((AffineRootSpace K n ↘ Spec (.of K)).appTop ≫
      (affineMonicReconstruction K n m g t).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (affineMonicReconstruction_over K n m g t)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]
  rfl

theorem universalMonicRemainder_map_affineMonicReconstruction
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (universalMonicRemainder K n g hg).map
        (affineMonicReconstruction K n m g t).appTop.hom =
      residuePolynomialOnQuotient K n m g t := by
  let r := residuePolynomialOnQuotient K n m g t
  let G := g.map (rootCoefficientMap K (n - m))
  let H := universalMonicCoefficientPolynomial K (n - m)
  have hG : G.Monic := hg.map _
  have hGnat : G.natDegree = m := by
    dsimp [G]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K (n - m))), hdeg]
  have hrdeg : r.degree < G.degree := by
    rw [Polynomial.degree_eq_natDegree hG.ne_zero, hGnat]
    exact residuePolynomialOnQuotient_degree_lt K n m g t
  have hc : (affineMonicReconstruction K n m g t).appTop.hom.comp
      (rootCoefficientMap K n) = rootCoefficientMap K (n - m) := by
    ext a
    exact affineMonicReconstruction_rootCoefficientMap K n m g t a
  unfold universalMonicRemainder
  rw [Polynomial.map_modByMonic _ (hg.map _),
    universalMonicCoefficientPolynomial_map_affineMonicReconstruction
      K n m g hg hdeg hmn t,
    Polynomial.map_map, hc]
  change (r + G * H) %ₘ G = r
  rw [Polynomial.add_modByMonic,
    (Polynomial.modByMonic_eq_self_iff hG).2 hrdeg,
    (Polynomial.modByMonic_eq_zero_iff_dvd hG).2 (dvd_mul_right G H),
    add_zero]

theorem affineMonicReconstruction_comp_residue
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstruction K n m g t ≫
        affineMonicResidueMultiplication K n m g hg =
      (AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t ≫
        residueUnitImmersion K m g := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicResidueMultiplication_over,
      affineMonicReconstruction_over]
    calc
      (AffineRootSpace K (n - m) ↘ Spec (.of K)) =
          (AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫
            𝟙 (Spec (.of K)) := (Category.comp_id _).symm
      _ = (AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫
          (t ≫ residueUnitProjection K m g) := by rw [ht]
      _ = ((AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t ≫
          residueUnitImmersion K m g) ≫
            (AffineRootSpace K m ↘ Spec (.of K)) := by
              simp only [residueUnitProjection, Category.assoc]
  · intro j
    change (affineMonicReconstruction K n m g t).appTop
        ((affineMonicResidueMultiplication K n m g hg).appTop
          (AffineSpace.coord (Spec (.of K)) j)) = _
    rw [affineMonicResidueMultiplication_appTop_coord]
    change (affineMonicReconstruction K n m g t).appTop
        ((universalMonicRemainder K n g hg).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      universalMonicRemainder_map_affineMonicReconstruction
        K n m g hg hdeg hmn t]
    unfold residuePolynomialOnQuotient
    rw [Polynomial.coeff_map, universalResiduePolynomial_coeff]

/-- The reconstructed polynomial is coprime to `g`, because its prescribed
remainder is a unit modulo `g`. -/
noncomputable def affineMonicReconstructionToSymmetric
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    AffineRootSpace K (n - m) ⟶ SymmetricCoprimeMonicSpace K n m g :=
  IsOpenImmersion.lift (SymmetricCoprimeMonicOpen K n m g).ι
    (affineMonicReconstruction K n m g t) (by
      rw [(SymmetricCoprimeMonicOpen K n m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hcomp := affineMonicReconstruction_comp_residue
        K n m g hg hdeg hmn t ht
      rw [← affineMonicResidueMultiplication_preimage_residueUnitOpen
        K n m g hg hdeg hmn]
      change (affineMonicReconstruction K n m g t ≫
          affineMonicResidueMultiplication K n m g hg).base x ∈
        ResidueUnitOpen K m g
      rw [hcomp]
      exact (((AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t).base x).2)

@[reassoc (attr := simp)]
theorem affineMonicReconstructionToSymmetric_fac
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstructionToSymmetric K n m g hg hdeg hmn t ht ≫
        (SymmetricCoprimeMonicOpen K n m g).ι =
      affineMonicReconstruction K n m g t := by
  exact IsOpenImmersion.lift_fac _ _ _

theorem affineMonicReconstructionToSymmetric_comp_residueToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstructionToSymmetric K n m g hg hdeg hmn t ht ≫
        symmetricCoprimeMonicResidueMultiplicationToUnit
          K n m g hg hdeg hmn =
      (AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t := by
  let : IsOpenImmersion (residueUnitImmersion K m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion K m g)).1
  rw [Category.assoc,
    symmetricCoprimeMonicResidueMultiplicationToUnit_fac]
  unfold symmetricCoprimeMonicResidueMultiplication
  rw [← Category.assoc,
    affineMonicReconstructionToSymmetric_fac]
  exact affineMonicReconstruction_comp_residue
    K n m g hg hdeg hmn t ht

/-- The affine quotient space maps into the symmetric residue fiber. -/
noncomputable def affineMonicReconstructionToFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    AffineRootSpace K (n - m) ⟶
      SymmetricResidueUnitFiber K n m g hg hdeg hmn t :=
  pullback.lift
    (affineMonicReconstructionToSymmetric K n m g hg hdeg hmn t ht)
    (AffineRootSpace K (n - m) ↘ Spec (.of K))
    (affineMonicReconstructionToSymmetric_comp_residueToUnit
      K n m g hg hdeg hmn t ht)

@[reassoc (attr := simp)]
theorem affineMonicReconstructionToFiber_fst
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstructionToFiber K n m g hg hdeg hmn t ht ≫
        symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
          K n m g hg hdeg hmn t =
      affineMonicReconstructionToSymmetric K n m g hg hdeg hmn t ht := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem affineMonicReconstructionToFiber_snd
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstructionToFiber K n m g hg hdeg hmn t ht ≫
        symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t =
      (AffineRootSpace K (n - m) ↘ Spec (.of K)) := by
  exact pullback.lift_snd _ _ _

/-- Euclidean division defines the map from the symmetric fiber to its free
quotient-polynomial coordinate. -/
noncomputable def symmetricResidueUnitFiberToQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    SymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      AffineRootSpace K (n - m) :=
  symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
      K n m g hg hdeg hmn t ≫
    (SymmetricCoprimeMonicOpen K n m g).ι ≫
      affineMonicQuotient K n m g hg

theorem universalMonicQuotient_map_affineMonicReconstruction
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (universalMonicQuotient K n g hg).map
        (affineMonicReconstruction K n m g t).appTop.hom =
      universalMonicCoefficientPolynomial K (n - m) := by
  let r := residuePolynomialOnQuotient K n m g t
  let G := g.map (rootCoefficientMap K (n - m))
  let H := universalMonicCoefficientPolynomial K (n - m)
  have hG : G.Monic := hg.map _
  have hGnat : G.natDegree = m := by
    dsimp [G]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective (rootCoefficientMap K (n - m))), hdeg]
  have hrdeg : r.degree < G.degree := by
    rw [Polynomial.degree_eq_natDegree hG.ne_zero, hGnat]
    exact residuePolynomialOnQuotient_degree_lt K n m g t
  have hc : (affineMonicReconstruction K n m g t).appTop.hom.comp
      (rootCoefficientMap K n) = rootCoefficientMap K (n - m) := by
    ext a
    exact affineMonicReconstruction_rootCoefficientMap K n m g t a
  unfold universalMonicQuotient
  rw [Polynomial.map_divByMonic _ (hg.map _),
    universalMonicCoefficientPolynomial_map_affineMonicReconstruction
      K n m g hg hdeg hmn t,
    Polynomial.map_map, hc]
  change (r + G * H) /ₘ G = H
  exact (Polynomial.div_modByMonic_unique H r hG ⟨rfl, hrdeg⟩).1

theorem affineMonicReconstruction_comp_affineMonicQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    affineMonicReconstruction K n m g t ≫
        affineMonicQuotient K n m g hg =
      𝟙 (AffineRootSpace K (n - m)) := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicQuotient_over,
      affineMonicReconstruction_over, Category.id_comp]
  · intro j
    rw [Scheme.Hom.comp_appTop]
    rw [CommRingCat.comp_apply]
    unfold affineMonicQuotient
    rw [AffineSpace.homOfVector_appTop_coord]
    change (affineMonicReconstruction K n m g t).appTop
        ((universalMonicQuotient K n g hg).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      universalMonicQuotient_map_affineMonicReconstruction
        K n m g hg hdeg hmn t,
      universalMonicCoefficientPolynomial_coeff_lt]
    rfl

theorem affineMonicReconstructionToFiber_comp_toQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    affineMonicReconstructionToFiber K n m g hg hdeg hmn t ht ≫
        symmetricResidueUnitFiberToQuotient K n m g hg hdeg hmn t =
      𝟙 (AffineRootSpace K (n - m)) := by
  unfold symmetricResidueUnitFiberToQuotient
  rw [← Category.assoc,
    affineMonicReconstructionToFiber_fst,
    ← Category.assoc, affineMonicReconstructionToSymmetric_fac]
  exact affineMonicReconstruction_comp_affineMonicQuotient
    K n m g hg hdeg hmn t

/-- The symmetric residue fiber viewed in the ambient affine monic
coefficient space. -/
noncomputable def symmetricResidueUnitFiberToAffineMonicSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    SymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      AffineRootSpace K n :=
  symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
      K n m g hg hdeg hmn t ≫
    (SymmetricCoprimeMonicOpen K n m g).ι

theorem symmetricResidueUnitFiberToAffineMonicSpace_comp_residue
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    symmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t ≫
        affineMonicResidueMultiplication K n m g hg =
      symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t ≫ t ≫
        residueUnitImmersion K m g := by
  unfold symmetricResidueUnitFiberToAffineMonicSpace
  rw [Category.assoc]
  change symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
      K n m g hg hdeg hmn t ≫
      symmetricCoprimeMonicResidueMultiplication K n m g hg = _
  rw [← symmetricCoprimeMonicResidueMultiplicationToUnit_fac]
  rw [← Category.assoc, symmetricResidueUnitFiber_condition,
    Category.assoc]
  all_goals assumption

@[reassoc (attr := simp)]
theorem symmetricCoprimeMonicResidueMultiplicationToUnit_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n) :
    symmetricCoprimeMonicResidueMultiplicationToUnit
        K n m g hg hdeg hmn ≫ residueUnitProjection K m g =
      symmetricCoprimeMonicProjection K n m g := by
  unfold residueUnitProjection symmetricCoprimeMonicProjection
  rw [← Category.assoc,
    symmetricCoprimeMonicResidueMultiplicationToUnit_fac]
  unfold symmetricCoprimeMonicResidueMultiplication
  rw [Category.assoc, affineMonicResidueMultiplication_over]

@[reassoc (attr := simp)]
theorem symmetricResidueUnitFiberToQuotient_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    symmetricResidueUnitFiberToQuotient K n m g hg hdeg hmn t ≫
        (AffineRootSpace K (n - m) ↘ Spec (.of K)) =
      symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t := by
  unfold symmetricResidueUnitFiberToQuotient
  simp only [Category.assoc, affineMonicQuotient_over]
  change symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
      K n m g hg hdeg hmn t ≫ symmetricCoprimeMonicProjection K n m g = _
  rw [← symmetricCoprimeMonicResidueMultiplicationToUnit_over
    K n m g hg hdeg hmn]
  simp only [← Category.assoc, symmetricResidueUnitFiber_condition]
  rw [Category.assoc, ht, Category.comp_id]

theorem universalMonicRemainder_map_symmetricFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (universalMonicRemainder K n g hg).map
        (symmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom =
      (universalResiduePolynomial K m).map
        ((symmetricResidueUnitFiberProjection
          K n m g hg hdeg hmn t ≫ t ≫
            residueUnitImmersion K m g).appTop.hom) := by
  rw [← universalResiduePolynomial_map_affineMonicResidueMultiplication
    K n m g hg hdeg]
  rw [Polynomial.map_map]
  congr 1
  have e := congrArg Scheme.Hom.appTop
    (symmetricResidueUnitFiberToAffineMonicSpace_comp_residue
      K n m g hg hdeg hmn t)
  rw [Scheme.Hom.comp_appTop] at e
  exact congrArg CommRingCat.Hom.hom e

@[reassoc (attr := simp)]
theorem symmetricResidueUnitFiberToAffineMonicSpace_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    symmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t ≫
        (AffineRootSpace K n ↘ Spec (.of K)) =
      symmetricResidueUnitFiberProjection K n m g hg hdeg hmn t := by
  unfold symmetricResidueUnitFiberToAffineMonicSpace
  change symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
      K n m g hg hdeg hmn t ≫ symmetricCoprimeMonicProjection K n m g = _
  rw [← symmetricCoprimeMonicResidueMultiplicationToUnit_over
    K n m g hg hdeg hmn]
  rw [← Category.assoc, symmetricResidueUnitFiber_condition,
    Category.assoc, ht, Category.comp_id]
  all_goals assumption

theorem symmetricResidueUnitFiberToAffineMonicSpace_rootCoefficientMap
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K)))
    (a : K) :
    (symmetricResidueUnitFiberToAffineMonicSpace
      K n m g hg hdeg hmn t).appTop (rootCoefficientMap K n a) =
      (symmetricResidueUnitFiberProjection
        K n m g hg hdeg hmn t).appTop
          ((Scheme.ΓSpecIso (.of K)).inv a) := by
  unfold rootCoefficientMap
  change (((AffineRootSpace K n ↘ Spec (.of K)).appTop ≫
      (symmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t).appTop)
          ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (symmetricResidueUnitFiberToAffineMonicSpace_over
      K n m g hg hdeg hmn t ht)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]

theorem symmetricResidueUnitFiberToQuotient_rootCoefficientMap
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K)))
    (a : K) :
    (symmetricResidueUnitFiberToQuotient
      K n m g hg hdeg hmn t).appTop
        (rootCoefficientMap K (n - m) a) =
      (symmetricResidueUnitFiberProjection
        K n m g hg hdeg hmn t).appTop
          ((Scheme.ΓSpecIso (.of K)).inv a) := by
  unfold rootCoefficientMap
  change (((AffineRootSpace K (n - m) ↘ Spec (.of K)).appTop ≫
      (symmetricResidueUnitFiberToQuotient
        K n m g hg hdeg hmn t).appTop)
          ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  have e := congrArg Scheme.Hom.appTop
    (symmetricResidueUnitFiberToQuotient_over
      K n m g hg hdeg hmn t ht)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]

theorem universalMonicCoefficientPolynomial_map_symmetricFiberToQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (universalMonicCoefficientPolynomial K (n - m)).map
        (symmetricResidueUnitFiberToQuotient
          K n m g hg hdeg hmn t).appTop.hom =
      (universalMonicQuotient K n g hg).map
        (symmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom := by
  rw [← universalMonicCoefficientPolynomial_map_affineMonicQuotient
    K n m g hg hdeg hmn]
  rw [Polynomial.map_map]
  unfold symmetricResidueUnitFiberToQuotient
    symmetricResidueUnitFiberToAffineMonicSpace
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
  rfl

theorem residuePolynomialOnQuotient_map_symmetricFiberToQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    (residuePolynomialOnQuotient K n m g t).map
        (symmetricResidueUnitFiberToQuotient
          K n m g hg hdeg hmn t).appTop.hom =
      (universalMonicRemainder K n g hg).map
        (symmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom := by
  rw [universalMonicRemainder_map_symmetricFiber
    K n m g hg hdeg hmn t]
  unfold residuePolynomialOnQuotient
  rw [Polynomial.map_map]
  congr 1
  have hmaps :
      symmetricResidueUnitFiberToQuotient
          K n m g hg hdeg hmn t ≫
            (AffineRootSpace K (n - m) ↘ Spec (.of K)) ≫ t ≫
              residueUnitImmersion K m g =
        symmetricResidueUnitFiberProjection
          K n m g hg hdeg hmn t ≫ t ≫
            residueUnitImmersion K m g := by
    rw [← Category.assoc,
      symmetricResidueUnitFiberToQuotient_over
        K n m g hg hdeg hmn t ht]
  have e := congrArg Scheme.Hom.appTop hmaps
  rw [Scheme.Hom.comp_appTop] at e
  exact congrArg CommRingCat.Hom.hom e

theorem reconstructedMonicPolynomial_map_symmetricFiberToQuotient
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    (reconstructedMonicPolynomial K n m g t).map
        (symmetricResidueUnitFiberToQuotient
          K n m g hg hdeg hmn t).appTop.hom =
      (universalMonicCoefficientPolynomial K n).map
        (symmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom := by
  let φ := symmetricResidueUnitFiberToQuotient
    K n m g hg hdeg hmn t
  let f := symmetricResidueUnitFiberToAffineMonicSpace
    K n m g hg hdeg hmn t
  have hc : φ.appTop.hom.comp (rootCoefficientMap K (n - m)) =
      f.appTop.hom.comp (rootCoefficientMap K n) := by
    ext a
    change φ.appTop (rootCoefficientMap K (n - m) a) =
      f.appTop (rootCoefficientMap K n a)
    rw [symmetricResidueUnitFiberToQuotient_rootCoefficientMap
      K n m g hg hdeg hmn t ht,
      symmetricResidueUnitFiberToAffineMonicSpace_rootCoefficientMap
        K n m g hg hdeg hmn t ht]
  have hgmap :
      (g.map (rootCoefficientMap K (n - m))).map φ.appTop.hom =
        (g.map (rootCoefficientMap K n)).map f.appTop.hom := by
    rw [Polynomial.map_map, Polynomial.map_map, hc]
  unfold reconstructedMonicPolynomial
  rw [Polynomial.map_add, Polynomial.map_mul]
  change (residuePolynomialOnQuotient K n m g t).map φ.appTop.hom +
      (g.map (rootCoefficientMap K (n - m))).map φ.appTop.hom *
        (universalMonicCoefficientPolynomial K (n - m)).map φ.appTop.hom = _
  rw [residuePolynomialOnQuotient_map_symmetricFiberToQuotient
      K n m g hg hdeg hmn t ht,
    hgmap,
    universalMonicCoefficientPolynomial_map_symmetricFiberToQuotient
      K n m g hg hdeg hmn t]
  rw [show
      (universalMonicRemainder K n g hg).map f.appTop.hom =
        (universalMonicCoefficientPolynomial K n).map f.appTop.hom %ₘ
          (g.map (rootCoefficientMap K n)).map f.appTop.hom by
        unfold universalMonicRemainder
        rw [Polynomial.map_modByMonic _ (hg.map _)],
    show
      (universalMonicQuotient K n g hg).map f.appTop.hom =
        (universalMonicCoefficientPolynomial K n).map f.appTop.hom /ₘ
          (g.map (rootCoefficientMap K n)).map f.appTop.hom by
        unfold universalMonicQuotient
        rw [Polynomial.map_divByMonic _ (hg.map _)],
    Polynomial.modByMonic_add_div]

theorem symmetricResidueUnitFiberToQuotient_comp_reconstruction
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    symmetricResidueUnitFiberToQuotient K n m g hg hdeg hmn t ≫
        affineMonicReconstruction K n m g t =
      symmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicReconstruction_over,
      symmetricResidueUnitFiberToQuotient_over,
      symmetricResidueUnitFiberToAffineMonicSpace_over]
    all_goals exact ht
  · intro j
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    unfold affineMonicReconstruction
    rw [AffineSpace.homOfVector_appTop_coord]
    change (symmetricResidueUnitFiberToQuotient
        K n m g hg hdeg hmn t).appTop
          ((reconstructedMonicPolynomial K n m g t).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      reconstructedMonicPolynomial_map_symmetricFiberToQuotient
        K n m g hg hdeg hmn t ht,
      Polynomial.coeff_map,
      universalMonicCoefficientPolynomial_coeff_lt]

set_option backward.isDefEq.respectTransparency.types false in
theorem symmetricResidueUnitFiber_hom_ext
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) {X : Scheme.{u}}
    {f k : X ⟶ SymmetricResidueUnitFiber K n m g hg hdeg hmn t}
    (hfst : f ≫ symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
        K n m g hg hdeg hmn t =
      k ≫ symmetricResidueUnitFiberToSymmetricCoprimeMonicSpace
        K n m g hg hdeg hmn t)
    (hsnd : f ≫ symmetricResidueUnitFiberProjection
        K n m g hg hdeg hmn t =
      k ≫ symmetricResidueUnitFiberProjection
        K n m g hg hdeg hmn t) : f = k := by
  exact pullback.hom_ext hfst hsnd

set_option backward.isDefEq.respectTransparency.types false in
theorem symmetricResidueUnitFiberToQuotient_comp_toFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    symmetricResidueUnitFiberToQuotient K n m g hg hdeg hmn t ≫
        affineMonicReconstructionToFiber K n m g hg hdeg hmn t ht =
      𝟙 (SymmetricResidueUnitFiber K n m g hg hdeg hmn t) := by
  apply symmetricResidueUnitFiber_hom_ext K n m g hg hdeg hmn t
  · rw [Category.assoc, affineMonicReconstructionToFiber_fst]
    apply (cancel_mono (SymmetricCoprimeMonicOpen K n m g).ι).1
    rw [Category.assoc, affineMonicReconstructionToSymmetric_fac]
    rw [symmetricResidueUnitFiberToQuotient_comp_reconstruction
      K n m g hg hdeg hmn t ht]
    unfold symmetricResidueUnitFiberToAffineMonicSpace
    simp
  · rw [Category.assoc, affineMonicReconstructionToFiber_snd,
      symmetricResidueUnitFiberToQuotient_over]
    simp
    all_goals exact ht

/-- The symmetric residue fiber is the target-independent affine space of
free monic quotients. -/
noncomputable def symmetricResidueUnitFiberIsoAffineRootSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    SymmetricResidueUnitFiber K n m g hg hdeg hmn t ≅
      AffineRootSpace K (n - m) where
  hom := symmetricResidueUnitFiberToQuotient K n m g hg hdeg hmn t
  inv := affineMonicReconstructionToFiber K n m g hg hdeg hmn t ht
  hom_inv_id := symmetricResidueUnitFiberToQuotient_comp_toFiber
    K n m g hg hdeg hmn t ht
  inv_hom_id := affineMonicReconstructionToFiber_comp_toQuotient
    K n m g hg hdeg hmn t ht


theorem isAffine_fullResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsAffine (FullResidueUnitFiber K n m g hg hdeg hm hmn t) := by
  let : IsAffine (RootSpace K n g) := by
    change IsAffine ((AffineRootSpace K n).basicOpen _)
    infer_instance
  let : IsAffine (ResidueUnitSpace K m g) :=
    isAffine_residueUnitSpace K m g
  let : IsAffine (Spec (.of K)) := inferInstance
  dsimp [FullResidueUnitFiber]
  infer_instance

theorem isAffineHom_fullResidueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsAffineHom
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) := by
  let : IsAffine (FullResidueUnitFiber K n m g hg hdeg hm hmn t) :=
    isAffine_fullResidueUnitFiber K n m g hg hdeg hm hmn t
  let : IsAffine (Spec (.of K)) := inferInstance
  infer_instance

theorem locallyOfFinitePresentation_fullResidueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    LocallyOfFinitePresentation
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) := by
  let : LocallyOfFinitePresentation
      (fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn) :=
    locallyOfFinitePresentation_fullResidueMultiplicationToUnit
      K n m g hg hdeg hm hmn
  dsimp [fullResidueUnitFiberProjection, FullResidueUnitFiber]
  infer_instance

theorem finitePresentation_fullResidueUnitFiber_appTop
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t).appTop.hom.FinitePresentation := by
  let : IsAffine (FullResidueUnitFiber K n m g hg hdeg hm hmn t) :=
    isAffine_fullResidueUnitFiber K n m g hg hdeg hm hmn t
  let : IsAffine (Spec (.of K)) := inferInstance
  let : LocallyOfFinitePresentation
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) :=
    locallyOfFinitePresentation_fullResidueUnitFiberProjection
      K n m g hg hdeg hm hmn t
  exact (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t).finitePresentation_appTop

theorem quasiCompact_fullResidueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    QuasiCompact
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) := by
  let : IsAffineHom
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) :=
    isAffineHom_fullResidueUnitFiberProjection
      K n m g hg hdeg hm hmn t
  infer_instance

theorem isLocallyNoetherian_fullResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsLocallyNoetherian
      (FullResidueUnitFiber K n m g hg hdeg hm hmn t) := by
  let : LocallyOfFinitePresentation
      (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t) :=
    locallyOfFinitePresentation_fullResidueUnitFiberProjection
      K n m g hg hdeg hm hmn t
  exact LocallyOfFiniteType.isLocallyNoetherian
    (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t)

theorem isNoetherian_fullResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsNoetherian (FullResidueUnitFiber K n m g hg hdeg hm hmn t) := by
  let : IsAffine (FullResidueUnitFiber K n m g hg hdeg hm hmn t) :=
    isAffine_fullResidueUnitFiber K n m g hg hdeg hm hmn t
  let : IsLocallyNoetherian
      (FullResidueUnitFiber K n m g hg hdeg hm hmn t) :=
    isLocallyNoetherian_fullResidueUnitFiber K n m g hg hdeg hm hmn t
  exact AlgebraicGeometry.IsNoetherian.mk

/-- Scheme-theoretic fiber of the genuinely unit-valued multiplication
map over a unit point. -/
def ResidueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (t : ResidueUnitPoint K m g) : Scheme.{u} :=
  pullback (residueMultiplicationToUnit K n m g hg) t

/-- The unit fiber maps to the maximal unit-valued root domain. -/
def residueUnitFiberToDomain
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (t : ResidueUnitPoint K m g) :
    ResidueUnitFiber K n m g hg t ⟶ ResidueUnitDomain K n m g hg :=
  pullback.fst _ _

/-- Structural map of the unit fiber. -/
def residueUnitFiberProjection
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (t : ResidueUnitPoint K m g) :
    ResidueUnitFiber K n m g hg t ⟶ Spec (.of K) :=
  pullback.snd _ _

/-- The defining square of the multiplication fiber over a unit point. -/
theorem residueUnitFiber_condition
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (t : ResidueUnitPoint K m g) :
    residueUnitFiberToDomain K n m g hg t ≫
        residueMultiplicationToUnit K n m g hg =
      residueUnitFiberProjection K n m g hg t ≫ t := by
  exact pullback.condition

/-- Fibers over unit points are affine. -/
theorem isAffine_residueUnitFiber
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (t : ResidueUnitPoint K m g) :
    IsAffine (ResidueUnitFiber K n m g hg t) := by
  let : IsAffine (ResidueUnitDomain K n m g hg) :=
    isAffine_residueUnitDomain K n m g hg
  let : IsAffine (ResidueUnitSpace K m g) :=
    isAffine_residueUnitSpace K m g
  let : IsAffine (Spec (.of K)) := inferInstance
  dsimp [ResidueUnitFiber]
  infer_instance

end SawinGeometry

namespace SawinGeometry

open AlgebraicGeometry.Scheme

/-- Relative `q`-power Frobenius on Sawin's ordered affine root space. -/
noncomputable def affineRootFrobenius (q n : ℕ) :
    AffineRootSpace (ZMod q) n ⟶ AffineRootSpace (ZMod q) n :=
  AffineSpace.homOfVector
    (AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q)))
    (fun i ↦ AffineSpace.coord (Spec (.of (ZMod q))) i ^ q)

@[simp]
theorem affineRootFrobenius_over (q n : ℕ) :
    affineRootFrobenius q n ≫
        (AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))) =
      AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q)) := by
  exact AffineSpace.homOfVector_over _ _

@[simp]
theorem affineRootFrobenius_coord (q n : ℕ) (i : RootIndex n) :
    (affineRootFrobenius q n).appTop
        (AffineSpace.coord (Spec (.of (ZMod q))) i) =
      AffineSpace.coord (Spec (.of (ZMod q))) i ^ q := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

noncomputable instance affineRootSpaceCharP
    (q m : ℕ) [Fact q.Prime] :
    CharP Γ(AffineRootSpace (ZMod q) m, ⊤) q :=
  CharP.of_ringHom_of_ne_zero (rootCoefficientMap (ZMod q) m) q
    ((show q.Prime from Fact.out).ne_zero)

/-- Coefficientwise Frobenius on the universal residue polynomial agrees
with pullback along Frobenius on its affine coefficient space. -/
theorem affineRootFrobenius_universalResiduePolynomial
    (q m : ℕ) [Fact q.Prime] :
    (universalResiduePolynomial (ZMod q) m).map
        (affineRootFrobenius q m).appTop.hom =
      (universalResiduePolynomial (ZMod q) m).map
        (frobenius Γ(AffineRootSpace (ZMod q) m, ⊤) q) := by
  unfold universalResiduePolynomial
  rw [Polynomial.map_sum, Polynomial.map_sum]
  apply Finset.sum_congr rfl
  intro i _
  simp [affineRootFrobenius_coord, frobenius_def]

/-- The universal resultant cutting out the unit target is carried to its
`q`-th power by coefficient-space Frobenius. -/
theorem affineRootFrobenius_residueUnitSection
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    (affineRootFrobenius q m).appTop
        (residueUnitSection (ZMod q) m g) =
      residueUnitSection (ZMod q) m g ^ q := by
  let A := Γ(AffineRootSpace (ZMod q) m, ⊤)
  let φ := (affineRootFrobenius q m).appTop.hom
  let F := g.map (rootCoefficientMap (ZMod q) m)
  let R := universalResiduePolynomial (ZMod q) m
  let fr := frobenius A q
  have hFφ : F.map φ = F := by
    dsimp [F, φ]
    rw [Polynomial.map_map]
    congr 1
    ext a
    unfold rootCoefficientMap
    change (affineRootFrobenius q m).appTop
        ((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop
          ((Scheme.ΓSpecIso (.of (ZMod q))).inv a)) = _
    change (((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop ≫
        (affineRootFrobenius q m).appTop)
          ((Scheme.ΓSpecIso (.of (ZMod q))).inv a)) = _
    have e := congrArg Scheme.Hom.appTop (affineRootFrobenius_over q m)
    rw [Scheme.Hom.comp_appTop] at e
    rw [e]
    rfl
  have hFfr : F.map fr = F := by
    dsimp [F, fr]
    rw [Polynomial.map_map]
    congr 1
    ext a
    change rootCoefficientMap (ZMod q) m a ^ q =
      rootCoefficientMap (ZMod q) m a
    rw [← map_pow, ZMod.pow_card]
  have hR : R.map φ = R.map fr := by
    exact affineRootFrobenius_universalResiduePolynomial q m
  unfold residueUnitSection
  change φ (Polynomial.resultant F R m m) = _
  calc
    φ (Polynomial.resultant F R m m) =
        Polynomial.resultant (F.map φ) (R.map φ) m m := by
      rw [Polynomial.resultant_map_map]
    _ = Polynomial.resultant (F.map fr) (R.map fr) m m := by
      rw [hFφ, hFfr, hR]
    _ = fr (Polynomial.resultant F R m m) := by
      rw [Polynomial.resultant_map_map]
    _ = Polynomial.resultant F R m m ^ q := by
      simp [fr, frobenius_def]

theorem affineRootFrobenius_preimage_residueUnitOpen
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    affineRootFrobenius q m ⁻¹ᵁ ResidueUnitOpen (ZMod q) m g =
      ResidueUnitOpen (ZMod q) m g := by
  unfold ResidueUnitOpen
  rw [Scheme.preimage_basicOpen_top,
    affineRootFrobenius_residueUnitSection q m g]
  exact Scheme.basicOpen_pow (AffineRootSpace (ZMod q) m)
    (residueUnitSection (ZMod q) m g)
    (show 0 < q from (show q.Prime from Fact.out).pos)

/-- Frobenius restricted to the resultant-open unit target. -/
noncomputable def residueUnitFrobenius
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    ResidueUnitSpace (ZMod q) m g ⟶ ResidueUnitSpace (ZMod q) m g :=
  (Scheme.isoOfEq (AffineRootSpace (ZMod q) m)
      (affineRootFrobenius_preimage_residueUnitOpen q m g).symm).hom ≫
    affineRootFrobenius q m ∣_ ResidueUnitOpen (ZMod q) m g

@[reassoc]
theorem residueUnitFrobenius_ι
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    residueUnitFrobenius q m g ≫ residueUnitImmersion (ZMod q) m g =
      residueUnitImmersion (ZMod q) m g ≫ affineRootFrobenius q m := by
  unfold residueUnitFrobenius residueUnitImmersion
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
    Scheme.isoOfEq_hom_ι]

/-- Frobenius pullback on the small pro-étale site of affine root space. -/
noncomputable def affineRootFrobeniusProEtPullback (q n : ℕ) :
    (AffineRootSpace (ZMod q) n).ProEt ⥤
      (AffineRootSpace (ZMod q) n).ProEt :=
  ProEt.baseChange (affineRootFrobenius q n)

theorem affineRootFrobeniusProEtPullback_isContinuous (q n : ℕ) :
    (affineRootFrobeniusProEtPullback q n).IsContinuous
      (ProEt.topology (AffineRootSpace (ZMod q) n))
      (ProEt.topology (AffineRootSpace (ZMod q) n)) :=
  ProEt.baseChange_isContinuous (affineRootFrobenius q n)

/-- The induced coefficient-sheaf map on affine root space. -/
noncomputable def affineRootFrobeniusCoefficientPullback
    (q n ell : ℕ) [Fact ell.Prime] :=
  ProEt.ellAdicCoefficientPullback (affineRootFrobenius q n) ell

/-- The induced map from ordinary ell-adic cohomology to cohomology with the
Frobenius-precomposed coefficient sheaf. -/
noncomputable def affineRootFrobeniusCohomologyPullback
    (q n ell degree : ℕ) [Fact ell.Prime] :
    (AffineRootSpace (ZMod q) n).EllAdicCohomology ell degree →+
      ProEt.BaseChangedEllAdicCohomology
        (affineRootFrobenius q n) ell degree :=
  ProEt.ellAdicCohomologyPullback (affineRootFrobenius q n) ell degree

/-- Frobenius on the prime-field base. -/
noncomputable def rootBaseFrobenius (q : ℕ) [Fact q.Prime] :
    Spec (.of (ZMod q)) ⟶ Spec (.of (ZMod q)) :=
  Spec.map (CommRingCat.ofHom (frobenius (ZMod q) q))

@[simp]
theorem rootBaseFrobenius_eq_id (q : ℕ) [Fact q.Prime] :
    rootBaseFrobenius q = 𝟙 (Spec (.of (ZMod q))) := by
  change Spec.map (CommRingCat.ofHom (frobenius (ZMod q) q)) =
    𝟙 (Spec (.of (ZMod q)))
  simp

/-- The absolute Frobenius presentation: base Frobenius followed by
`q`-power coordinates. -/
noncomputable def affineRootAbsoluteFrobenius (q n : ℕ) [Fact q.Prime] :
    AffineRootSpace (ZMod q) n ⟶ AffineRootSpace (ZMod q) n :=
  AffineSpace.homOfVector
    ((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))) ≫
      rootBaseFrobenius q)
    (fun i ↦ AffineSpace.coord (Spec (.of (ZMod q))) i ^ q)

theorem affineRootAbsoluteFrobenius_eq (q n : ℕ) [Fact q.Prime] :
    affineRootAbsoluteFrobenius q n = affineRootFrobenius q n := by
  apply AffineSpace.hom_ext
  · unfold affineRootAbsoluteFrobenius affineRootFrobenius
    rw [AffineSpace.homOfVector_over, AffineSpace.homOfVector_over,
      rootBaseFrobenius_eq_id, Category.comp_id]
  · intro i
    unfold affineRootAbsoluteFrobenius affineRootFrobenius
    rw [AffineSpace.homOfVector_appTop_coord,
      AffineSpace.homOfVector_appTop_coord]

theorem map_eval₂ {R A B : Type*} [Semiring R] [CommSemiring A]
    [CommSemiring B] (h : A →+* B) (f : R →+* A) (x : A)
    (g : Polynomial R) :
    h (Polynomial.eval₂ f x g) =
      Polynomial.eval₂ (h.comp f) (h x) g := by
  induction g using Polynomial.induction_on' with
  | add g k ihg ihk => simp only [Polynomial.eval₂_add, map_add, ihg, ihk]
  | monomial d a => simp only [Polynomial.eval₂_monomial, map_mul, map_pow,
      RingHom.coe_comp, Function.comp_apply]

theorem eval₂_frobenius_zmod {R : Type*} [CommRing R]
    (q : ℕ) [Fact q.Prime] [CharP R q]
    (f : ZMod q →+* R) (x : R) (g : Polynomial (ZMod q)) :
    Polynomial.eval₂ f (x ^ q) g = (Polynomial.eval₂ f x g) ^ q := by
  induction g using Polynomial.induction_on' with
  | add g h ihg ihh =>
      rw [Polynomial.eval₂_add, Polynomial.eval₂_add, add_pow_char, ihg, ihh]
  | monomial d a =>
      rw [Polynomial.eval₂_monomial, Polynomial.eval₂_monomial,
        mul_pow, ← map_pow, ZMod.pow_card, ← pow_mul, ← pow_mul, Nat.mul_comm]

theorem affineRootFrobenius_rootCoefficientMap
    (q n : ℕ) [Fact q.Prime] (a : ZMod q) :
    (affineRootFrobenius q n).appTop (rootCoefficientMap (ZMod q) n a) =
      rootCoefficientMap (ZMod q) n a := by
  unfold rootCoefficientMap
  change (affineRootFrobenius q n).appTop
      ((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop
        ((Scheme.ΓSpecIso (.of (ZMod q))).inv a)) = _
  change (((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop ≫
      (affineRootFrobenius q n).appTop)
        ((Scheme.ΓSpecIso (.of (ZMod q))).inv a)) = _
  have e := congrArg Scheme.Hom.appTop (affineRootFrobenius_over q n)
  rw [Scheme.Hom.comp_appTop] at e
  rw [e]
  rfl

/-- Frobenius on ordered roots agrees with coefficientwise Frobenius on
the universal monic root polynomial. -/
theorem affineRootFrobenius_universalRootPolynomial
    (q n : ℕ) [Fact q.Prime] :
    (universalRootPolynomial (ZMod q) n).map
        (affineRootFrobenius q n).appTop.hom =
      (universalRootPolynomial (ZMod q) n).map
        (frobenius Γ(AffineRootSpace (ZMod q) n, ⊤) q) := by
  unfold universalRootPolynomial
  rw [Polynomial.map_prod, Polynomial.map_prod]
  apply Finset.prod_congr rfl
  intro i _
  simp [affineRootFrobenius_coord, frobenius_def]

/-- Reduction of the universal root polynomial modulo the fixed modulus
commutes with Frobenius. -/
theorem affineRootFrobenius_universalRootRemainder
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic) :
    (universalRootRemainder (ZMod q) n g hg).map
        (affineRootFrobenius q n).appTop.hom =
      (universalRootRemainder (ZMod q) n g hg).map
        (frobenius Γ(AffineRootSpace (ZMod q) n, ⊤) q) := by
  let A := Γ(AffineRootSpace (ZMod q) n, ⊤)
  let φ := (affineRootFrobenius q n).appTop.hom
  let fr := frobenius A q
  let F := g.map (rootCoefficientMap (ZMod q) n)
  let P := universalRootPolynomial (ZMod q) n
  have hFφ : F.map φ = F := by
    dsimp [F, φ]
    rw [Polynomial.map_map]
    congr 1
    ext a
    exact affineRootFrobenius_rootCoefficientMap q n a
  have hFfr : F.map fr = F := by
    dsimp [F, fr]
    rw [Polynomial.map_map]
    congr 1
    ext a
    change rootCoefficientMap (ZMod q) n a ^ q =
      rootCoefficientMap (ZMod q) n a
    rw [← map_pow, ZMod.pow_card]
  have hP : P.map φ = P.map fr := by
    exact affineRootFrobenius_universalRootPolynomial q n
  unfold universalRootRemainder
  change ((P %ₘ F).map φ) = ((P %ₘ F).map fr)
  rw [Polynomial.map_modByMonic φ (hg.map _),
    Polynomial.map_modByMonic fr (hg.map _), hFφ, hFfr, hP]

/-- The affine residue multiplication map commutes with Frobenius. -/
theorem affineRootFrobenius_affineResidueMultiplication
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic) :
    affineRootFrobenius q n ≫
        affineResidueMultiplication (ZMod q) n m g hg =
      affineResidueMultiplication (ZMod q) n m g hg ≫
        affineRootFrobenius q m := by
  apply AffineSpace.hom_ext
  · simp only [Category.assoc, affineResidueMultiplication_over,
      affineRootFrobenius_over]
  · intro i
    change (affineRootFrobenius q n).appTop
        ((affineResidueMultiplication (ZMod q) n m g hg).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) i)) =
      (affineResidueMultiplication (ZMod q) n m g hg).appTop
        ((affineRootFrobenius q m).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) i))
    rw [affineResidueMultiplication_appTop_coord,
      affineRootFrobenius_coord, map_pow,
      affineResidueMultiplication_appTop_coord]
    have h := congrArg (fun p ↦ p.coeff i.down)
      (affineRootFrobenius_universalRootRemainder q n m g hg)
    simpa only [Polynomial.coeff_map, frobenius_def] using h

theorem affineRootFrobenius_rootEvaluationSection
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) (i : Fin n) :
    (affineRootFrobenius q n).appTop
        (rootEvaluationSection (ZMod q) n g i) =
      rootEvaluationSection (ZMod q) n g i ^ q := by
  let : CharP Γ(AffineRootSpace (ZMod q) n, ⊤) q :=
    CharP.of_ringHom_of_ne_zero (rootCoefficientMap (ZMod q) n) q
      ((show q.Prime from Fact.out).ne_zero)
  unfold rootEvaluationSection
  rw [map_eval₂]
  have hc : (affineRootFrobenius q n).appTop.hom.comp
      (rootCoefficientMap (ZMod q) n) = rootCoefficientMap (ZMod q) n := by
    ext a
    exact affineRootFrobenius_rootCoefficientMap q n a
  rw [hc, affineRootFrobenius_coord]
  exact eval₂_frobenius_zmod q _ _ _

theorem affineRootFrobenius_rootAvoidanceSection
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    (affineRootFrobenius q n).appTop
        (rootAvoidanceSection (ZMod q) n g) =
      rootAvoidanceSection (ZMod q) n g ^ q := by
  unfold rootAvoidanceSection
  rw [map_prod]
  simp_rw [affineRootFrobenius_rootEvaluationSection q n g]
  exact Finset.prod_pow Finset.univ q
    (fun i ↦ rootEvaluationSection (ZMod q) n g i)

theorem affineRootFrobenius_preimage_rootSpaceOpen
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    affineRootFrobenius q n ⁻¹ᵁ RootSpaceOpen (ZMod q) n g =
      RootSpaceOpen (ZMod q) n g := by
  unfold RootSpaceOpen
  rw [Scheme.preimage_basicOpen_top,
    affineRootFrobenius_rootAvoidanceSection q n g]
  exact Scheme.basicOpen_pow (AffineRootSpace (ZMod q) n)
    (rootAvoidanceSection (ZMod q) n g)
    (show 0 < q from (show q.Prime from Fact.out).pos)

/-- Frobenius restricted to Sawin's root-avoidance basic open. -/
noncomputable def rootFrobenius
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    RootSpace (ZMod q) n g ⟶ RootSpace (ZMod q) n g :=
  (Scheme.isoOfEq (AffineRootSpace (ZMod q) n)
      (affineRootFrobenius_preimage_rootSpaceOpen q n g).symm).hom ≫
    affineRootFrobenius q n ∣_ RootSpaceOpen (ZMod q) n g

@[reassoc]
theorem rootFrobenius_ι
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    rootFrobenius q n g ≫ (RootSpaceOpen (ZMod q) n g).ι =
      (RootSpaceOpen (ZMod q) n g).ι ≫ affineRootFrobenius q n := by
  unfold rootFrobenius
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
    Scheme.isoOfEq_hom_ι]

/-- The coordinate description of affine Frobenius is conjugate, via the
standard affine-space presentation, to `Spec.map` of the ring Frobenius. -/
noncomputable def affineRootFrobeniusSpec
    (q n : ℕ) [Fact q.Prime] :
    AffineRootSpace (ZMod q) n ⟶ AffineRootSpace (ZMod q) n :=
  (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).hom ≫
    Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q)) ≫
    (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).inv

theorem affineRootFrobeniusSpec_eq
    (q n : ℕ) [Fact q.Prime] :
    affineRootFrobeniusSpec q n = affineRootFrobenius q n := by
  apply AffineSpace.hom_ext
  · rw [affineRootFrobenius_over]
    unfold affineRootFrobeniusSpec
    simp only [Category.assoc, AffineSpace.SpecIso_inv_over]
    rw [← Spec.map_comp]
    have hC : (CommRingCat.ofHom MvPolynomial.C :
        CommRingCat.of (ZMod q) ⟶
          CommRingCat.of (MvPolynomial (RootIndex n) (ZMod q))) ≫
          CommRingCat.ofHom
            (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q) =
        CommRingCat.ofHom MvPolynomial.C := by
      apply CommRingCat.hom_ext
      exact RingHom.ext_zmod _ _
    rw [hC]
    apply (cancel_epi
      (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).inv).1
    simp
  · intro i
    unfold affineRootFrobeniusSpec
    change (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).hom.appTop
      ((Spec.map (CommRingCat.ofHom
        (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q))).appTop
        ((AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).inv.appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) i))) = _
    rw [AffineSpace.SpecIso_inv_appTop_coord,
      affineRootFrobenius_coord]
    change ((Scheme.ΓSpecIso (.of
          (MvPolynomial (RootIndex n) (ZMod q)))).inv ≫
        (Spec.map (CommRingCat.ofHom
          (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q))).appTop ≫
        (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).hom.appTop)
          (MvPolynomial.X i) = _
    rw [← Scheme.ΓSpecIso_inv_naturality_assoc]
    change (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))).hom.appTop
      ((Scheme.ΓSpecIso (.of
        (MvPolynomial (RootIndex n) (ZMod q)))).inv
          (MvPolynomial.X i ^ q)) = _
    rw [map_pow]
    rw [map_pow]
    have hcoord := AffineSpace.SpecIso_inv_appTop_coord
      (n := RootIndex n) (.of (ZMod q)) i
    rw [← hcoord, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop]
    simp

/-- Every element is integral over the image of Frobenius: it satisfies
`X ^ q - x`. -/
theorem frobenius_isIntegral
    {R : Type*} [CommRing R] (q : ℕ) [ExpChar R q] (hq : 0 < q) :
    (frobenius R q).IsIntegral := by
  intro x
  refine ⟨Polynomial.X ^ q - Polynomial.C x,
    Polynomial.monic_X_pow_sub_C _ hq.ne', ?_⟩
  simp [frobenius_def]

theorem specFrobenius_surjective
    (q n : ℕ) [Fact q.Prime] :
    Surjective (Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q))) := by
  constructor
  intro P
  refine ⟨P, ?_⟩
  apply PrimeSpectrum.ext
  ext x
  change x ^ q ∈ P.asIdeal ↔ x ∈ P.asIdeal
  exact P.2.pow_mem_iff_mem _
    (show 0 < q from (show q.Prime from Fact.out).pos)

theorem specFrobenius_universallyInjective
    (q n : ℕ) [Fact q.Prime] :
    UniversallyInjective (Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q))) := by
  apply ((tfae_universallyInjective
    (Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q)))).out 0 1).mpr
  intro K _ g₁ g₂ h
  change g₁ ≫ Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q)) =
    g₂ ≫ Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q)) at h
  rw [← Spec.map_preimage g₁, ← Spec.map_preimage g₂] at h ⊢
  rw [← Spec.map_comp, ← Spec.map_comp, Spec.map_inj] at h
  apply congrArg (fun k => Spec.map k)
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro x
  have hx := DFunLike.congr_fun (CommRingCat.hom_ext_iff.mp h) x
  change (Spec.preimage g₁).hom (x ^ q) =
    (Spec.preimage g₂).hom (x ^ q) at hx
  rw [map_pow, map_pow] at hx
  let : CharP K q := CharP.of_ringHom_of_ne_zero
    (Spec.preimage g₁).hom q
      (show q ≠ 0 from (show q.Prime from Fact.out).ne_zero)
  have hsub :
      ((Spec.preimage g₁).hom x - (Spec.preimage g₂).hom x) ^ q = 0 := by
    rw [sub_pow_char, hx, sub_self]
  exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hsub)

theorem specFrobenius_integral
    (q n : ℕ) [Fact q.Prime] :
    IsIntegralHom (Spec.map (CommRingCat.ofHom
      (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q))) := by
  rw [IsIntegralHom.SpecMap_iff]
  exact frobenius_isIntegral q (show q.Prime from Fact.out).pos

/-- An integral, surjective, universally injective morphism is a universal
homeomorphism on every pro-étale base change. -/
theorem baseChangeIsHomeomorph_of_integral_surjective_universallyInjective
    {X Y : Scheme} (f : X ⟶ Y)
    [IsIntegralHom f] [Surjective f] [UniversallyInjective f] :
    ∀ U : Y.ProEt, IsHomeomorph (pullback.fst U.hom f).base := by
  intro U
  let p := pullback.fst U.hom f
  let : IsIntegralHom p := inferInstance
  let : Surjective p := inferInstance
  have hp_injective : Function.Injective p :=
    UniversallyInjective.universally_injective
      (f := f) (pullback.snd U.hom f) U.hom p
        (IsPullback.of_hasPullback U.hom f)
  rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
  exact ⟨p.continuous, p.isClosedMap,
    ⟨hp_injective, p.surjective⟩⟩

theorem specFrobeniusBaseChangeIsHomeomorph
    (q n : ℕ) [Fact q.Prime] :
    ∀ U : (Spec (.of (MvPolynomial (RootIndex n) (ZMod q)))).ProEt,
      IsHomeomorph (pullback.fst U.hom
        (Spec.map (CommRingCat.ofHom
          (frobenius (MvPolynomial (RootIndex n) (ZMod q)) q)))).base := by
  let := specFrobenius_integral q n
  let := specFrobenius_surjective q n
  let := specFrobenius_universallyInjective q n
  exact baseChangeIsHomeomorph_of_integral_surjective_universallyInjective _

theorem affineRootFrobenius_integral
    (q n : ℕ) [Fact q.Prime] :
    IsIntegralHom (affineRootFrobenius q n) := by
  rw [← affineRootFrobeniusSpec_eq]
  unfold affineRootFrobeniusSpec
  let := specFrobenius_integral q n
  infer_instance

theorem affineRootFrobenius_surjective
    (q n : ℕ) [Fact q.Prime] :
    Surjective (affineRootFrobenius q n) := by
  rw [← affineRootFrobeniusSpec_eq]
  unfold affineRootFrobeniusSpec
  let := specFrobenius_surjective q n
  infer_instance

theorem affineRootFrobenius_universallyInjective
    (q n : ℕ) [Fact q.Prime] :
    UniversallyInjective (affineRootFrobenius q n) := by
  rw [← affineRootFrobeniusSpec_eq]
  unfold affineRootFrobeniusSpec
  let : MorphismProperty.RespectsIso (@UniversallyInjective) :=
    UniversallyInjective.respectsIso
  rw [MorphismProperty.cancel_left_of_respectsIso @UniversallyInjective,
    MorphismProperty.cancel_right_of_respectsIso @UniversallyInjective]
  exact specFrobenius_universallyInjective q n

theorem affineRootFrobeniusBaseChangeIsHomeomorph
    (q n : ℕ) [Fact q.Prime] :
    ∀ U : (AffineRootSpace (ZMod q) n).ProEt,
      IsHomeomorph (pullback.fst U.hom
        (affineRootFrobenius q n)).base := by
  let := affineRootFrobenius_integral q n
  let := affineRootFrobenius_surjective q n
  let := affineRootFrobenius_universallyInjective q n
  exact baseChangeIsHomeomorph_of_integral_surjective_universallyInjective _

theorem restrict_self_surjective_of_surjective
    {X : Scheme} (f : X ⟶ X) [Surjective f]
    (U : X.Opens) (hU : f ⁻¹ᵁ U = U) :
    Surjective ((Scheme.isoOfEq X hU.symm).hom ≫ f ∣_ U) := by
  constructor
  intro y
  obtain ⟨x, hx⟩ := f.surjective y.1
  have hxU : x ∈ f ⁻¹ᵁ U := by
    change f x ∈ U
    rw [hx]
    exact y.2
  let z : f ⁻¹ᵁ U := ⟨x, hxU⟩
  obtain ⟨w, hw⟩ := (Scheme.isoOfEq X hU.symm).hom.surjective z
  refine ⟨w, ?_⟩
  apply Subtype.ext
  rw [Scheme.Hom.comp_apply]
  rw [morphismRestrict_base_coe]
  rw [congrArg Subtype.val hw, hx]

theorem rootFrobenius_integral
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    IsIntegralHom (rootFrobenius q n g) := by
  unfold rootFrobenius
  let := affineRootFrobenius_integral q n
  infer_instance

theorem rootFrobenius_surjective
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    Surjective (rootFrobenius q n g) := by
  unfold rootFrobenius
  let := affineRootFrobenius_surjective q n
  exact restrict_self_surjective_of_surjective _ _
    (affineRootFrobenius_preimage_rootSpaceOpen q n g)

theorem rootFrobenius_universallyInjective
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    UniversallyInjective (rootFrobenius q n g) := by
  unfold rootFrobenius
  let : MorphismProperty.RespectsIso (@UniversallyInjective) :=
    UniversallyInjective.respectsIso
  let : MorphismProperty.IsStableUnderBaseChange (@UniversallyInjective) :=
    UniversallyInjective.isStableUnderBaseChange
  rw [MorphismProperty.cancel_left_of_respectsIso @UniversallyInjective]
  apply MorphismProperty.of_isPullback (isPullback_morphismRestrict
    (affineRootFrobenius q n) (RootSpaceOpen (ZMod q) n g)).flip
  exact affineRootFrobenius_universallyInjective q n

theorem rootFrobeniusBaseChangeIsHomeomorph
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    ∀ U : (RootSpace (ZMod q) n g).ProEt,
      IsHomeomorph (pullback.fst U.hom (rootFrobenius q n g)).base := by
  let := rootFrobenius_integral q n g
  let := rootFrobenius_surjective q n g
  let := rootFrobenius_universallyInjective q n g
  exact baseChangeIsHomeomorph_of_integral_surjective_universallyInjective _

/-- The restricted ordered-root Frobenius commutes with residue
multiplication into affine coefficient space. -/
theorem rootFrobenius_residueMultiplication
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic) :
    rootFrobenius q n g ≫
        residueMultiplication (ZMod q) n m g hg =
      residueMultiplication (ZMod q) n m g hg ≫
        affineRootFrobenius q m := by
  unfold residueMultiplication
  rw [← Category.assoc, rootFrobenius_ι, Category.assoc,
    affineRootFrobenius_affineResidueMultiplication]
  simp only [Category.assoc]

/-- The global factorization through the unit target is Frobenius
equivariant. -/
theorem rootFrobenius_fullResidueMultiplicationToUnit
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n) :
    rootFrobenius q n g ≫
        fullResidueMultiplicationToUnit
          (ZMod q) n m g hg hdeg hm hmn =
      fullResidueMultiplicationToUnit
          (ZMod q) n m g hg hdeg hm hmn ≫
        residueUnitFrobenius q m g := by
  let : IsOpenImmersion (residueUnitImmersion (ZMod q) m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion (ZMod q) m g)).1
  rw [Category.assoc, Category.assoc,
    fullResidueMultiplicationToUnit_fac,
    residueUnitFrobenius_ι,
    ← Category.assoc,
    fullResidueMultiplicationToUnit_fac,
    rootFrobenius_residueMultiplication]

/-- Scheme morphisms between spectra of the prime field are unique. -/
theorem specZMod_hom_ext (q : ℕ)
    (f g : Spec (.of (ZMod q)) ⟶ Spec (.of (ZMod q))) : f = g := by
  apply ext_of_isAffine
  apply (cancel_epi (Scheme.ΓSpecIso (.of (ZMod q))).inv).1
  apply (cancel_mono (Scheme.ΓSpecIso (.of (ZMod q))).hom).1
  apply CommRingCat.hom_ext
  exact RingHom.ext_zmod _ _

/-- Every prime-field point of the residue-unit target lies over the unique
prime-field point.  This discharges the structural compatibility hypothesis
in the Euclidean-division description of a symmetric residue fiber. -/
theorem residueUnitPoint_over_zmod
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) :
    t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))) :=
  specZMod_hom_ext q _ _

/-- Over the finite prime field, every symmetric residue fiber of degree at
least `m` is canonically the affine space of its free monic quotient. -/
noncomputable def symmetricResidueUnitFiberIsoAffineRootSpaceZMod
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    SymmetricResidueUnitFiber (ZMod q) n m g hg hdeg hmn t ≅
      AffineRootSpace (ZMod q) (n - m) :=
  symmetricResidueUnitFiberIsoAffineRootSpace
    (ZMod q) n m g hg hdeg hmn t
      (residueUnitPoint_over_zmod q m g t)

/-- The resultant defining the residue-unit open becomes a unit after
restriction to that open. -/
theorem residueUnitImmersion_appTop_section_isUnit
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K) :
    IsUnit ((residueUnitImmersion K m g).appTop
      (residueUnitSection K m g)) := by
  rw [residueUnitImmersion, Scheme.Opens.ι_appTop]
  change IsUnit
    (((AffineRootSpace K m).toRingedSpace.presheaf.map
      (homOfLE (x := (ResidueUnitOpen K m g).ι ''ᵁ ⊤) le_top).op).hom
        (residueUnitSection K m g))
  rw [(ResidueUnitOpen K m g).ι_image_top]
  exact (AffineRootSpace K m).toRingedSpace.isUnit_res_basicOpen
    (residueUnitSection K m g)

/-- Pullback along any morphism into the residue-unit space preserves the
unit resultant. -/
theorem residueUnitMorphism_section_isUnit
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f : X ⟶ ResidueUnitSpace K m g) :
    IsUnit (((f ≫ residueUnitImmersion K m g).appTop)
      (residueUnitSection K m g)) := by
  rw [Scheme.Hom.comp_appTop]
  exact (residueUnitImmersion_appTop_section_isUnit K m g).map
    f.appTop.hom

/-- The residue polynomial represented over the source of a morphism into
the unit target. -/
noncomputable def residuePolynomialAlong
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f : X ⟶ ResidueUnitSpace K m g) : Polynomial Γ(X, ⊤) :=
  (universalResiduePolynomial K m).map
    (f ≫ residueUnitImmersion K m g).appTop.hom

/-- The fixed modulus transported to the same source ring. -/
noncomputable def residueModulusAlong
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f : X ⟶ ResidueUnitSpace K m g) : Polynomial Γ(X, ⊤) :=
  g.map ((f ≫ residueUnitImmersion K m g).appTop.hom.comp
    (rootCoefficientMap K m))

theorem residueModulusAlong_monic
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (f : X ⟶ ResidueUnitSpace K m g) :
    (residueModulusAlong K m g f).Monic := by
  exact hg.map _

/-- Invertibility of the universal resultant yields a Bézout identity over
the source ring of every unit-valued family.  This is the regular, relative
form of division by the residues contributed by the other Young blocks. -/
theorem residuePolynomialAlong_isCoprime
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f : X ⟶ ResidueUnitSpace K m g) :
    IsCoprime (residueModulusAlong K m g f)
      (residuePolynomialAlong K m g f) := by
  have hmap :
      (residueModulusAlong K m g f).resultant
          (residuePolynomialAlong K m g f) m m =
        (f ≫ residueUnitImmersion K m g).appTop
          (residueUnitSection K m g) := by
    unfold residueModulusAlong residuePolynomialAlong residueUnitSection
    rw [← Polynomial.map_map, Polynomial.resultant_map_map]
  have hunit : IsUnit
      ((residueModulusAlong K m g f).resultant
        (residuePolynomialAlong K m g f) m m) := by
    rw [hmap]
    exact residueUnitMorphism_section_isUnit K m g f
  have hmoddeg :
      (residueModulusAlong K m g f).natDegree ≤ m := by
    unfold residueModulusAlong
    exact (Polynomial.natDegree_map_le (f := _)
      (p := g)).trans_eq hdeg
  have hunivdeg : (universalResiduePolynomial K m).natDegree ≤ m := by
    apply Polynomial.natDegree_le_of_degree_le
    exact (Polynomial.degree_sum_fin_lt fun j : Fin m =>
      AffineSpace.coord (Spec (.of K)) (ULift.up j)).le
  have hpdeg :
      (residuePolynomialAlong K m g f).natDegree ≤ m := by
    unfold residuePolynomialAlong
    exact (Polynomial.natDegree_map_le (f := _)
      (p := universalResiduePolynomial K m)).trans hunivdeg
  obtain ⟨a, b, _ha, _hb, hab⟩ :=
    Polynomial.exists_mul_add_mul_eq_C_resultant
      (residueModulusAlong K m g f)
      (residuePolynomialAlong K m g f)
      hmoddeg hpdeg (Or.inl hm.ne')
  let c : Γ(X, ⊤) := ↑hunit.unit⁻¹
  refine ⟨Polynomial.C c * a, Polynomial.C c * b, ?_⟩
  rw [mul_assoc, mul_assoc, ← mul_add, mul_comm a, mul_comm b, hab,
    ← Polynomial.C_mul]
  simpa [c] using congrArg Polynomial.C hunit.val_inv_mul

/-- A polynomial representative for the inverse of a unit-valued residue. -/
noncomputable def residuePolynomialInverseAlong
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f : X ⟶ ResidueUnitSpace K m g) : Polynomial Γ(X, ⊤) :=
  let h := residuePolynomialAlong_isCoprime K m g hg hdeg hm f
  Classical.choose h.choose_spec

theorem residuePolynomialInverseAlong_bezout
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f : X ⟶ ResidueUnitSpace K m g) :
    let h := residuePolynomialAlong_isCoprime K m g hg hdeg hm f
    h.choose * residueModulusAlong K m g f +
        residuePolynomialInverseAlong K m g hg hdeg hm f *
          residuePolynomialAlong K m g f = 1 := by
  dsimp [residuePolynomialInverseAlong]
  exact (residuePolynomialAlong_isCoprime
    K m g hg hdeg hm f).choose_spec.choose_spec

/-- The chosen Bézout representative is a right inverse modulo the transported
modulus.  The trivial global-section ring is handled separately, so no
nonemptiness hypothesis on the source scheme is needed. -/
theorem residuePolynomial_mul_inverse_modByMonic
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f : X ⟶ ResidueUnitSpace K m g) :
    (residuePolynomialAlong K m g f *
        residuePolynomialInverseAlong K m g hg hdeg hm f) %ₘ
          residueModulusAlong K m g f = 1 := by
  let M := residueModulusAlong K m g f
  let P := residuePolynomialAlong K m g f
  let I := residuePolynomialInverseAlong K m g hg hdeg hm f
  let A := (residuePolynomialAlong_isCoprime
    K m g hg hdeg hm f).choose
  have hbez : A * M + I * P = 1 := by
    exact residuePolynomialInverseAlong_bezout K m g hg hdeg hm f
  have hdvd : M ∣ P * I - 1 := by
    refine ⟨-A, ?_⟩
    dsimp only [M, P, I, A] at hbez ⊢
    linear_combination hbez
  have hcongr := Polynomial.modByMonic_eq_of_dvd_sub
    (residueModulusAlong_monic K m g hg f) hdvd
  change (P * I) %ₘ M = 1
  rw [hcongr]
  by_cases hnontrivial : Nontrivial Γ(X, ⊤)
  · let : Nontrivial Γ(X, ⊤) := hnontrivial
    apply (Polynomial.modByMonic_eq_self_iff
      (residueModulusAlong_monic K m g hg f)).mpr
    have hMdeg : M.natDegree = m := by
      dsimp [M, residueModulusAlong]
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective _), hdeg]
    rw [Polynomial.degree_one,
      Polynomial.degree_eq_natDegree
        (residueModulusAlong_monic K m g hg f).ne_zero,
      hMdeg]
    exact_mod_cast hm
  · have : Subsingleton Γ(X, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

/-- Two unit-valued families over the same ground-field morphism transport
the fixed modulus to the same polynomial over their source ring. -/
theorem residueModulusAlong_eq_of_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    residueModulusAlong K m g f = residueModulusAlong K m g k := by
  unfold residueModulusAlong
  congr 1
  apply RingHom.ext
  intro a
  have hfk' : f ≫ residueUnitImmersion K m g ≫
        (AffineRootSpace K m ↘ Spec (.of K)) =
      k ≫ residueUnitImmersion K m g ≫
        (AffineRootSpace K m ↘ Spec (.of K)) := by
    simpa only [residueUnitProjection, Category.assoc] using hfk
  unfold rootCoefficientMap
  change (f ≫ residueUnitImmersion K m g ≫
      (AffineRootSpace K m ↘ Spec (.of K))).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a) =
    (k ≫ residueUnitImmersion K m g ≫
      (AffineRootSpace K m ↘ Spec (.of K))).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)
  simpa only using congrArg (fun z : X ⟶ Spec (.of K) =>
    z.appTop ((Scheme.ΓSpecIso (.of K)).inv a)) hfk'

/-- Reduction modulo a monic polynomial preserves coprimality over an
arbitrary commutative coefficient ring. -/
theorem isCoprime_modByMonic_right_iff_commRing
    {R : Type*} [CommRing R] (M P : Polynomial R) (hM : M.Monic) :
    IsCoprime M (P %ₘ M) ↔ IsCoprime M P := by
  let r := P %ₘ M
  let q := P /ₘ M
  have hdiv : r + M * q = P := P.modByMonic_add_div M
  constructor
  · rintro ⟨a, b, hab⟩
    refine ⟨a - b * q, b, ?_⟩
    dsimp only [r, q] at hdiv hab ⊢
    linear_combination hab - b * hdiv
  · rintro ⟨a, b, hab⟩
    refine ⟨a + b * q, b, ?_⟩
    dsimp only [r, q] at hdiv hab ⊢
    linear_combination hab + b * hdiv

/-- A coprime pair with a monic first polynomial has unit padded resultant.
This version works over the possibly trivial global-section ring of a scheme. -/
theorem isUnit_resultant_padded_of_monic_isCoprime
    {R : Type*} [CommRing R] (M P : Polynomial R) (m : ℕ)
    (hM : M.Monic) (hMdeg : M.natDegree = m)
    (hPdeg : P.natDegree ≤ m) (hcop : IsCoprime M P) :
    IsUnit (M.resultant P m m) := by
  by_cases hnontrivial : Nontrivial R
  · let : Nontrivial R := hnontrivial
    have hdefault : IsUnit (M.resultant P) :=
      (Polynomial.isUnit_resultant_iff_isCoprime hM).mpr hcop
    have hpad : M.resultant P m m = M.resultant P := by
      calc
        M.resultant P m m =
            M.resultant P M.natDegree
              (P.natDegree + (m - P.natDegree)) := by
          congr 2
          · exact hMdeg.symm
          · exact (Nat.add_sub_of_le hPdeg).symm
        _ = M.coeff M.natDegree ^ (m - P.natDegree) *
              M.resultant P := by
          rw [Polynomial.resultant_add_right_deg] <;> simp
        _ = M.resultant P := by simp [hM.coeff_natDegree]
    rw [hpad]
    exact hdefault
  · have : Subsingleton R := not_nontrivial_iff_subsingleton.mp hnontrivial
    exact isUnit_iff_exists_inv'.mpr ⟨0, Subsingleton.elim _ _⟩

/-- The residue ratio `f / k`, represented by its degree-`<m` remainder. -/
noncomputable def residueRatioPolynomial
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) : Polynomial Γ(X, ⊤) :=
  (residuePolynomialAlong K m g f *
      residuePolynomialInverseAlong K m g hg hdeg hm k) %ₘ
        residueModulusAlong K m g k

/-- The residue ratio is again coprime to the transported modulus. -/
theorem residueRatioPolynomial_isCoprime
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    IsCoprime (residueModulusAlong K m g k)
      (residueRatioPolynomial K m g hg hdeg hm f k) := by
  let M := residueModulusAlong K m g k
  let Pf := residuePolynomialAlong K m g f
  let Pk := residuePolynomialAlong K m g k
  let Ik := residuePolynomialInverseAlong K m g hg hdeg hm k
  have hMf : residueModulusAlong K m g f = M := by
    exact residueModulusAlong_eq_of_over K m g f k hfk
  have hf : IsCoprime M Pf := by
    rw [← hMf]
    exact residuePolynomialAlong_isCoprime K m g hg hdeg hm f
  have hkbez :
      (residuePolynomialAlong_isCoprime
          K m g hg hdeg hm k).choose * M + Ik * Pk = 1 := by
    exact residuePolynomialInverseAlong_bezout K m g hg hdeg hm k
  have hk : IsCoprime M Ik := by
    refine ⟨(residuePolynomialAlong_isCoprime
      K m g hg hdeg hm k).choose, Pk, ?_⟩
    simpa only [mul_comm Pk Ik] using hkbez
  apply (isCoprime_modByMonic_right_iff_commRing
    M (Pf * Ik) (residueModulusAlong_monic K m g hg k)).mpr
  exact hf.mul_right hk

/-- Ambient coefficient-space morphism represented by the residue ratio. -/
noncomputable def residueRatioAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) : X ⟶ AffineRootSpace K m :=
  AffineSpace.homOfVector (k ≫ residueUnitProjection K m g)
    (fun j => (residueRatioPolynomial
      K m g hg hdeg hm f k).coeff j.down)

@[reassoc (attr := simp)]
theorem residueRatioAmbient_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    residueRatioAmbient K m g hg hdeg hm f k ≫
        (AffineRootSpace K m ↘ Spec (.of K)) =
      k ≫ residueUnitProjection K m g := by
  exact AffineSpace.homOfVector_over _ _

@[simp]
theorem residueRatioAmbient_appTop_coord
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) (j : Fin m) :
    (residueRatioAmbient K m g hg hdeg hm f k).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (residueRatioPolynomial K m g hg hdeg hm f k).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

theorem universalResiduePolynomial_map_residueRatioAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    (universalResiduePolynomial K m).map
        (residueRatioAmbient K m g hg hdeg hm f k).appTop.hom =
      residueRatioPolynomial K m g hg hdeg hm f k := by
  let r := residueRatioPolynomial K m g hg hdeg hm f k
  by_cases hnontrivial : Nontrivial Γ(X, ⊤)
  · let : Nontrivial Γ(X, ⊤) := hnontrivial
    have hrdeg : r.degree < (m : WithBot ℕ) := by
      have hraw := Polynomial.degree_modByMonic_lt
        (residuePolynomialAlong K m g f *
          residuePolynomialInverseAlong K m g hg hdeg hm k)
        (residueModulusAlong_monic K m g hg k)
      change r.degree < (residueModulusAlong K m g k).degree at hraw
      rw [Polynomial.degree_eq_natDegree
        (residueModulusAlong_monic K m g hg k).ne_zero] at hraw
      have hMdeg : (residueModulusAlong K m g k).natDegree = m := by
        unfold residueModulusAlong
        rw [Polynomial.natDegree_map_eq_of_injective
          (RingHom.injective _), hdeg]
      rwa [hMdeg] at hraw
    rw [universalResiduePolynomial, Polynomial.map_sum]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
      Polynomial.map_pow, residueRatioAmbient_appTop_coord]
    change (∑ x : Fin m,
      Polynomial.C (r.coeff x) * Polynomial.X ^ x.1) = r
    by_cases hr : r = 0
    · simp [hr]
    have hrnat : r.natDegree < m :=
      (Polynomial.natDegree_lt_iff_degree_lt hr).mpr hrdeg
    rw [Fin.sum_univ_eq_sum_range
      (fun i : ℕ => Polynomial.C (r.coeff i) * Polynomial.X ^ i) m]
    exact (r.as_sum_range_C_mul_X_pow' hrnat).symm
  · have : Subsingleton Γ(X, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

theorem residueUnitMorphism_rootCoefficientMap
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f : X ⟶ ResidueUnitSpace K m g) (a : K) :
    (f ≫ residueUnitImmersion K m g).appTop
        (rootCoefficientMap K m a) =
      (f ≫ residueUnitProjection K m g).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a) := by
  unfold rootCoefficientMap residueUnitProjection
  change (((AffineRootSpace K m ↘ Spec (.of K)).appTop ≫
      (f ≫ residueUnitImmersion K m g).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  rw [← Scheme.Hom.comp_appTop]
  rfl

theorem residueRatioAmbient_rootCoefficientMap
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) (a : K) :
    (residueRatioAmbient K m g hg hdeg hm f k).appTop
        (rootCoefficientMap K m a) =
      (k ≫ residueUnitProjection K m g).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a) := by
  unfold rootCoefficientMap
  change (((AffineRootSpace K m ↘ Spec (.of K)).appTop ≫
      (residueRatioAmbient K m g hg hdeg hm f k).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  rw [← Scheme.Hom.comp_appTop, residueRatioAmbient_over]

theorem residueRatioAmbient_residueUnitSection
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    (residueRatioAmbient K m g hg hdeg hm f k).appTop
        (residueUnitSection K m g) =
      (residueModulusAlong K m g k).resultant
        (residueRatioPolynomial K m g hg hdeg hm f k) m m := by
  have hc :
      (residueRatioAmbient K m g hg hdeg hm f k).appTop.hom.comp
          (rootCoefficientMap K m) =
        (k ≫ residueUnitImmersion K m g).appTop.hom.comp
          (rootCoefficientMap K m) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply,
      residueRatioAmbient_rootCoefficientMap,
      residueUnitMorphism_rootCoefficientMap]
  unfold residueUnitSection residueModulusAlong
  rw [← Polynomial.resultant_map_map,
    universalResiduePolynomial_map_residueRatioAmbient,
    Polynomial.map_map, hc]

theorem residueRatioAmbient_residueUnitSection_isUnit
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    IsUnit ((residueRatioAmbient K m g hg hdeg hm f k).appTop
      (residueUnitSection K m g)) := by
  rw [residueRatioAmbient_residueUnitSection]
  by_cases hnontrivial : Nontrivial Γ(X, ⊤)
  · let : Nontrivial Γ(X, ⊤) := hnontrivial
    have hMdeg : (residueModulusAlong K m g k).natDegree = m := by
      unfold residueModulusAlong
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective _), hdeg]
    have hRdeg :
        (residueRatioPolynomial K m g hg hdeg hm f k).natDegree ≤ m := by
      unfold residueRatioPolynomial
      exact (Polynomial.natDegree_modByMonic_le _
        (residueModulusAlong_monic K m g hg k)).trans_eq hMdeg
    exact isUnit_resultant_padded_of_monic_isCoprime
      (residueModulusAlong K m g k)
      (residueRatioPolynomial K m g hg hdeg hm f k) m
      (residueModulusAlong_monic K m g hg k) hMdeg hRdeg
      (residueRatioPolynomial_isCoprime K m g hg hdeg hm f k hfk)
  · have : Subsingleton Γ(X, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact isUnit_iff_exists_inv'.mpr ⟨0, Subsingleton.elim _ _⟩

/-- Division in the residue-unit group, constructed from the relative
Bézout inverse in global sections. -/
noncomputable def residueRatioMorphism
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    X ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (residueRatioAmbient K m g hg hdeg hm f k) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈
          residueRatioAmbient K m g hg hdeg hm f k ⁻¹ᵁ
            ResidueUnitOpen K m g := by
        unfold ResidueUnitOpen
        rw [Scheme.preimage_basicOpen_top]
        rw [X.basicOpen_of_isUnit
          (residueRatioAmbient_residueUnitSection_isUnit
            K m g hg hdeg hm f k hfk)]
        trivial
      exact hx)

@[reassoc (attr := simp)]
theorem residueRatioMorphism_fac
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    residueRatioMorphism K m g hg hdeg hm f k hfk ≫
        residueUnitImmersion K m g =
      residueRatioAmbient K m g hg hdeg hm f k := by
  exact IsOpenImmersion.lift_fac _ _ _

@[reassoc (attr := simp)]
theorem residueRatioMorphism_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    residueRatioMorphism K m g hg hdeg hm f k hfk ≫
        residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g := by
  unfold residueUnitProjection
  rw [← Category.assoc, residueRatioMorphism_fac,
    residueRatioAmbient_over]
  simp only [residueUnitProjection]

/-- Relative fiber of symmetric degree-`n` multiplication over a varying
unit-valued family. -/
noncomputable def RelativeSymmetricResidueUnitFiber
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) : Scheme.{u} :=
  pullback
    (symmetricCoprimeMonicResidueMultiplicationToUnit
      K n m g hg hdeg hmn) t

noncomputable def relativeSymmetricResidueUnitFiberToSymmetric
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      SymmetricCoprimeMonicSpace K n m g :=
  pullback.fst _ _

noncomputable def relativeSymmetricResidueUnitFiberToBase
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶ X :=
  pullback.snd _ _

theorem relativeSymmetricResidueUnitFiber_condition
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToSymmetric
        K n m g hg hdeg hmn t ≫
        symmetricCoprimeMonicResidueMultiplicationToUnit
          K n m g hg hdeg hmn =
      relativeSymmetricResidueUnitFiberToBase
        K n m g hg hdeg hmn t ≫ t := by
  exact pullback.condition

/-- The relative affine quotient bundle over `X`. -/
noncomputable def RelativeAffineRootSpace
    (K : Type u) [Field K] {X : Scheme.{u}}
    (r : ℕ) (p : X ⟶ Spec (.of K)) : Scheme.{u} :=
  pullback p (AffineRootSpace K r ↘ Spec (.of K))

noncomputable def relativeAffineRootSpaceToBase
    (K : Type u) [Field K] {X : Scheme.{u}}
    (r : ℕ) (p : X ⟶ Spec (.of K)) :
    RelativeAffineRootSpace K r p ⟶ X :=
  pullback.fst _ _

noncomputable def relativeAffineRootSpaceToAffine
    (K : Type u) [Field K] {X : Scheme.{u}}
    (r : ℕ) (p : X ⟶ Spec (.of K)) :
    RelativeAffineRootSpace K r p ⟶ AffineRootSpace K r :=
  pullback.snd _ _

theorem relativeAffineRootSpace_condition
    (K : Type u) [Field K] {X : Scheme.{u}}
    (r : ℕ) (p : X ⟶ Spec (.of K)) :
    relativeAffineRootSpaceToBase K r p ≫ p =
      relativeAffineRootSpaceToAffine K r p ≫
        (AffineRootSpace K r ↘ Spec (.of K)) := by
  exact pullback.condition

/-- Euclidean division on the large symmetric block, retaining the varying
base parameter. -/
noncomputable def relativeSymmetricResidueUnitFiberToRelativeAffine
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g) :=
  pullback.lift
    (relativeSymmetricResidueUnitFiberToBase
      K n m g hg hdeg hmn t)
    (relativeSymmetricResidueUnitFiberToSymmetric
        K n m g hg hdeg hmn t ≫
      (SymmetricCoprimeMonicOpen K n m g).ι ≫
      affineMonicQuotient K n m g hg) (by
        rw [Category.assoc, Category.assoc, affineMonicQuotient_over]
        calc
          relativeSymmetricResidueUnitFiberToBase
                K n m g hg hdeg hmn t ≫
              (t ≫ residueUnitProjection K m g) =
            (relativeSymmetricResidueUnitFiberToBase
                K n m g hg hdeg hmn t ≫ t) ≫
              residueUnitProjection K m g := by simp
          _ = (relativeSymmetricResidueUnitFiberToSymmetric
                  K n m g hg hdeg hmn t ≫
                symmetricCoprimeMonicResidueMultiplicationToUnit
                  K n m g hg hdeg hmn) ≫
              residueUnitProjection K m g := by
                rw [relativeSymmetricResidueUnitFiber_condition]
          _ = relativeSymmetricResidueUnitFiberToSymmetric
                K n m g hg hdeg hmn t ≫
              symmetricCoprimeMonicProjection K n m g := by
                rw [Category.assoc,
                  symmetricCoprimeMonicResidueMultiplicationToUnit_over]
          _ = relativeSymmetricResidueUnitFiberToSymmetric
                K n m g hg hdeg hmn t ≫
              (SymmetricCoprimeMonicOpen K n m g).ι ≫
              (AffineRootSpace K n ↘ Spec (.of K)) := by
                rfl)

@[reassoc (attr := simp)]
theorem relativeSymmetricResidueUnitFiberToRelativeAffine_base
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToRelativeAffine
        K n m g hg hdeg hmn t ≫
      relativeAffineRootSpaceToBase K (n - m)
        (t ≫ residueUnitProjection K m g) =
    relativeSymmetricResidueUnitFiberToBase
      K n m g hg hdeg hmn t := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem relativeSymmetricResidueUnitFiberToRelativeAffine_affine
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToRelativeAffine
        K n m g hg hdeg hmn t ≫
      relativeAffineRootSpaceToAffine K (n - m)
        (t ≫ residueUnitProjection K m g) =
    relativeSymmetricResidueUnitFiberToSymmetric
        K n m g hg hdeg hmn t ≫
      (SymmetricCoprimeMonicOpen K n m g).ι ≫
      affineMonicQuotient K n m g hg := by
  exact pullback.lift_snd _ _ _

variable (K : Type u) [Field K]

/-- The universal reconstructed polynomial `r_t + gH` over a varying base. -/
noncomputable def relativeReconstructedMonicPolynomial
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    Polynomial Γ(RelativeAffineRootSpace K (n - m)
      (t ≫ residueUnitProjection K m g), ⊤) :=
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  let tY : Y ⟶ ResidueUnitSpace K m g :=
    relativeAffineRootSpaceToBase K (n - m)
      (t ≫ residueUnitProjection K m g) ≫ t
  residuePolynomialAlong K m g tY +
    residueModulusAlong K m g tY *
      (universalMonicCoefficientPolynomial K (n - m)).map
        (relativeAffineRootSpaceToAffine K (n - m)
          (t ≫ residueUnitProjection K m g)).appTop.hom

theorem relativeReconstructedMonicPolynomial_monic
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g)
    [Nontrivial Γ(RelativeAffineRootSpace K (n - m)
      (t ≫ residueUnitProjection K m g), ⊤)] :
    (relativeReconstructedMonicPolynomial
      K n m g hg hdeg hmn t).Monic := by
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  let tY : Y ⟶ ResidueUnitSpace K m g :=
    relativeAffineRootSpaceToBase K (n - m)
      (t ≫ residueUnitProjection K m g) ≫ t
  let r := residuePolynomialAlong K m g tY
  let G := residueModulusAlong K m g tY
  let H := (universalMonicCoefficientPolynomial K (n - m)).map
    (relativeAffineRootSpaceToAffine K (n - m)
      (t ≫ residueUnitProjection K m g)).appTop.hom
  have hG : G.Monic := residueModulusAlong_monic K m g hg tY
  have hH : H.Monic :=
    (universalMonicCoefficientPolynomial_monic K (n - m)).map _
  have hprod : (G * H).Monic := hG.mul hH
  have hGnat : G.natDegree = m := by
    dsimp [G, residueModulusAlong]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective _), hdeg]
  have hHnat : H.natDegree = n - m := by
    dsimp [H]
    rw [(universalMonicCoefficientPolynomial_monic K
      (n - m)).natDegree_map,
      universalMonicCoefficientPolynomial_natDegree]
  have hprodNat : (G * H).natDegree = n := by
    rw [hG.natDegree_mul hH, hGnat, hHnat, Nat.add_sub_of_le hmn]
  have hprodDegree : (G * H).degree = ((n : ℕ) : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hprod.ne_zero, hprodNat]
  have hrdeg : r.degree < (m : WithBot ℕ) := by
    dsimp [r, residuePolynomialAlong]
    apply Polynomial.degree_map_le.trans_lt
    exact Polynomial.degree_sum_fin_lt fun j : Fin m =>
      AffineSpace.coord (Spec (.of K)) (ULift.up j)
  have hrlt : r.degree < (G * H).degree := by
    rw [hprodDegree]
    exact hrdeg.trans_le (WithBot.coe_le_coe.mpr hmn)
  have hdegree : (r + G * H).degree = ((n : ℕ) : WithBot ℕ) :=
    (Polynomial.degree_add_eq_right_of_degree_lt hrlt).trans hprodDegree
  have hnat : (r + G * H).natDegree = n :=
    Polynomial.natDegree_eq_of_degree_eq_some hdegree
  change (r + G * H).Monic
  rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hnat,
    Polynomial.coeff_add,
    Polynomial.coeff_eq_zero_of_degree_lt (hrlt.trans_eq hprodDegree),
    zero_add]
  simpa only [hprodNat] using hprod.coeff_natDegree

theorem relativeReconstructedMonicPolynomial_natDegree
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g)
    [Nontrivial Γ(RelativeAffineRootSpace K (n - m)
      (t ≫ residueUnitProjection K m g), ⊤)] :
    (relativeReconstructedMonicPolynomial
      K n m g hg hdeg hmn t).natDegree = n := by
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  let tY : Y ⟶ ResidueUnitSpace K m g :=
    relativeAffineRootSpaceToBase K (n - m)
      (t ≫ residueUnitProjection K m g) ≫ t
  let r := residuePolynomialAlong K m g tY
  let G := residueModulusAlong K m g tY
  let H := (universalMonicCoefficientPolynomial K (n - m)).map
    (relativeAffineRootSpaceToAffine K (n - m)
      (t ≫ residueUnitProjection K m g)).appTop.hom
  have hG : G.Monic := residueModulusAlong_monic K m g hg tY
  have hH : H.Monic :=
    (universalMonicCoefficientPolynomial_monic K (n - m)).map _
  have hprod : (G * H).Monic := hG.mul hH
  have hGnat : G.natDegree = m := by
    dsimp [G, residueModulusAlong]
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective _), hdeg]
  have hHnat : H.natDegree = n - m := by
    dsimp [H]
    rw [(universalMonicCoefficientPolynomial_monic K
      (n - m)).natDegree_map,
      universalMonicCoefficientPolynomial_natDegree]
  have hprodNat : (G * H).natDegree = n := by
    rw [hG.natDegree_mul hH, hGnat, hHnat, Nat.add_sub_of_le hmn]
  have hprodDegree : (G * H).degree = ((n : ℕ) : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hprod.ne_zero, hprodNat]
  have hrdeg : r.degree < (m : WithBot ℕ) := by
    dsimp [r, residuePolynomialAlong]
    apply Polynomial.degree_map_le.trans_lt
    exact Polynomial.degree_sum_fin_lt fun j : Fin m =>
      AffineSpace.coord (Spec (.of K)) (ULift.up j)
  have hrlt : r.degree < (G * H).degree := by
    rw [hprodDegree]
    exact hrdeg.trans_le (WithBot.coe_le_coe.mpr hmn)
  change (r + G * H).natDegree = n
  exact Polynomial.natDegree_eq_of_degree_eq_some
    ((Polynomial.degree_add_eq_right_of_degree_lt hrlt).trans hprodDegree)

/-- Coefficient morphism reconstructing the large monic polynomial over the
relative affine quotient bundle. -/
noncomputable def relativeAffineMonicReconstruction
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g) ⟶
      AffineRootSpace K n :=
  AffineSpace.homOfVector
    (relativeAffineRootSpaceToBase K (n - m)
      (t ≫ residueUnitProjection K m g) ≫ t ≫
        residueUnitProjection K m g)
    (fun j => (relativeReconstructedMonicPolynomial
      K n m g hg hdeg hmn t).coeff j.down)

@[reassoc (attr := simp)]
theorem relativeAffineMonicReconstruction_over
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstruction K n m g hg hdeg hmn t ≫
        (AffineRootSpace K n ↘ Spec (.of K)) =
      relativeAffineRootSpaceToBase K (n - m)
          (t ≫ residueUnitProjection K m g) ≫ t ≫
        residueUnitProjection K m g := by
  exact AffineSpace.homOfVector_over _ _

theorem universalMonicCoefficientPolynomial_map_relativeReconstruction
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (universalMonicCoefficientPolynomial K n).map
        (relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t).appTop.hom =
      relativeReconstructedMonicPolynomial
        K n m g hg hdeg hmn t := by
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  by_cases hnontrivial : Nontrivial Γ(Y, ⊤)
  · let : Nontrivial Γ(Y, ⊤) := hnontrivial
    exact universalMonicCoefficientPolynomial_map_homOfVector K _ _ _
      (relativeReconstructedMonicPolynomial_monic
        K n m g hg hdeg hmn t)
      (relativeReconstructedMonicPolynomial_natDegree
        K n m g hg hdeg hmn t)
  · have : Subsingleton Γ(Y, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

theorem relativeAffineMonicReconstruction_rootCoefficientMap
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) (a : K) :
    (relativeAffineMonicReconstruction
      K n m g hg hdeg hmn t).appTop (rootCoefficientMap K n a) =
      ((relativeAffineRootSpaceToBase K (n - m)
          (t ≫ residueUnitProjection K m g) ≫ t ≫
        residueUnitImmersion K m g).appTop
          (rootCoefficientMap K m a)) := by
  unfold rootCoefficientMap
  have e :
      relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t ≫
          (AffineRootSpace K n ↘ Spec (.of K)) =
        (relativeAffineRootSpaceToBase K (n - m)
            (t ≫ residueUnitProjection K m g) ≫ t ≫
          residueUnitImmersion K m g) ≫
            (AffineRootSpace K m ↘ Spec (.of K)) := by
    rw [relativeAffineMonicReconstruction_over]
    simp only [residueUnitProjection, Category.assoc]
  have e' := congrArg Scheme.Hom.appTop e
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at e'
  exact congrArg (fun h => h ((Scheme.ΓSpecIso (.of K)).inv a)) e'

theorem universalMonicRemainder_map_relativeReconstruction
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (universalMonicRemainder K n g hg).map
        (relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t).appTop.hom =
      residuePolynomialAlong K m g
        (relativeAffineRootSpaceToBase K (n - m)
          (t ≫ residueUnitProjection K m g) ≫ t) := by
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  by_cases hnontrivial : Nontrivial Γ(Y, ⊤)
  · let : Nontrivial Γ(Y, ⊤) := hnontrivial
    let tY : Y ⟶ ResidueUnitSpace K m g :=
      relativeAffineRootSpaceToBase K (n - m)
        (t ≫ residueUnitProjection K m g) ≫ t
    let r := residuePolynomialAlong K m g tY
    let G := residueModulusAlong K m g tY
    let H := (universalMonicCoefficientPolynomial K (n - m)).map
      (relativeAffineRootSpaceToAffine K (n - m)
        (t ≫ residueUnitProjection K m g)).appTop.hom
    have hG : G.Monic := residueModulusAlong_monic K m g hg tY
    have hGnat : G.natDegree = m := by
      dsimp [G, residueModulusAlong]
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective _), hdeg]
    have hrdeg : r.degree < G.degree := by
      rw [Polynomial.degree_eq_natDegree hG.ne_zero, hGnat]
      dsimp [r, residuePolynomialAlong]
      apply Polynomial.degree_map_le.trans_lt
      exact Polynomial.degree_sum_fin_lt fun j : Fin m =>
        AffineSpace.coord (Spec (.of K)) (ULift.up j)
    have hc :
        (relativeAffineMonicReconstruction
            K n m g hg hdeg hmn t).appTop.hom.comp
            (rootCoefficientMap K n) =
          (tY ≫ residueUnitImmersion K m g).appTop.hom.comp
            (rootCoefficientMap K m) := by
      ext a
      exact relativeAffineMonicReconstruction_rootCoefficientMap
        K n m g hg hdeg hmn t a
    unfold universalMonicRemainder
    rw [Polynomial.map_modByMonic _ (hg.map _),
      universalMonicCoefficientPolynomial_map_relativeReconstruction
        K n m g hg hdeg hmn t,
      Polynomial.map_map, hc]
    change (r + G * H) %ₘ G = r
    rw [Polynomial.add_modByMonic,
      (Polynomial.modByMonic_eq_self_iff hG).2 hrdeg,
      (Polynomial.modByMonic_eq_zero_iff_dvd hG).2 (dvd_mul_right G H),
      add_zero]
  · have : Subsingleton Γ(Y, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

theorem relativeAffineMonicReconstruction_comp_residue
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstruction K n m g hg hdeg hmn t ≫
        affineMonicResidueMultiplication K n m g hg =
      relativeAffineRootSpaceToBase K (n - m)
          (t ≫ residueUnitProjection K m g) ≫ t ≫
        residueUnitImmersion K m g := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicResidueMultiplication_over,
      relativeAffineMonicReconstruction_over]
    simp only [residueUnitProjection, Category.assoc]
  · intro j
    change (relativeAffineMonicReconstruction
        K n m g hg hdeg hmn t).appTop
        ((affineMonicResidueMultiplication K n m g hg).appTop
          (AffineSpace.coord (Spec (.of K)) j)) = _
    rw [affineMonicResidueMultiplication_appTop_coord]
    change (relativeAffineMonicReconstruction
        K n m g hg hdeg hmn t).appTop
        ((universalMonicRemainder K n g hg).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      universalMonicRemainder_map_relativeReconstruction
        K n m g hg hdeg hmn t]
    unfold residuePolynomialAlong
    rw [Polynomial.coeff_map, universalResiduePolynomial_coeff]
    congr 1

noncomputable def relativeAffineMonicReconstructionToSymmetric
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g) ⟶
      SymmetricCoprimeMonicSpace K n m g :=
  IsOpenImmersion.lift (SymmetricCoprimeMonicOpen K n m g).ι
    (relativeAffineMonicReconstruction K n m g hg hdeg hmn t) (by
      rw [(SymmetricCoprimeMonicOpen K n m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hcomp := relativeAffineMonicReconstruction_comp_residue
        K n m g hg hdeg hmn t
      rw [← affineMonicResidueMultiplication_preimage_residueUnitOpen
        K n m g hg hdeg hmn]
      change (relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t ≫
        affineMonicResidueMultiplication K n m g hg).base x ∈
          ResidueUnitOpen K m g
      rw [hcomp]
      exact (((relativeAffineRootSpaceToBase K (n - m)
        (t ≫ residueUnitProjection K m g) ≫ t).base x).2))

@[reassoc (attr := simp)]
theorem relativeAffineMonicReconstructionToSymmetric_fac
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstructionToSymmetric
          K n m g hg hdeg hmn t ≫
        (SymmetricCoprimeMonicOpen K n m g).ι =
      relativeAffineMonicReconstruction
        K n m g hg hdeg hmn t := by
  exact IsOpenImmersion.lift_fac _ _ _

theorem relativeAffineMonicReconstructionToSymmetric_comp_residueToUnit
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstructionToSymmetric
          K n m g hg hdeg hmn t ≫
        symmetricCoprimeMonicResidueMultiplicationToUnit
          K n m g hg hdeg hmn =
      relativeAffineRootSpaceToBase K (n - m)
          (t ≫ residueUnitProjection K m g) ≫ t := by
  let : IsOpenImmersion (residueUnitImmersion K m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion K m g)).1
  rw [Category.assoc,
    symmetricCoprimeMonicResidueMultiplicationToUnit_fac]
  unfold symmetricCoprimeMonicResidueMultiplication
  rw [← Category.assoc,
    relativeAffineMonicReconstructionToSymmetric_fac]
  exact relativeAffineMonicReconstruction_comp_residue
    K n m g hg hdeg hmn t

noncomputable def relativeAffineMonicReconstructionToFiber
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g) ⟶
      RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t :=
  pullback.lift
    (relativeAffineMonicReconstructionToSymmetric
      K n m g hg hdeg hmn t)
    (relativeAffineRootSpaceToBase K (n - m)
      (t ≫ residueUnitProjection K m g))
    (relativeAffineMonicReconstructionToSymmetric_comp_residueToUnit
      K n m g hg hdeg hmn t)

@[reassoc (attr := simp)]
theorem relativeAffineMonicReconstructionToFiber_fst
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstructionToFiber
          K n m g hg hdeg hmn t ≫
        relativeSymmetricResidueUnitFiberToSymmetric
          K n m g hg hdeg hmn t =
      relativeAffineMonicReconstructionToSymmetric
        K n m g hg hdeg hmn t := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem relativeAffineMonicReconstructionToFiber_snd
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstructionToFiber
          K n m g hg hdeg hmn t ≫
        relativeSymmetricResidueUnitFiberToBase
          K n m g hg hdeg hmn t =
      relativeAffineRootSpaceToBase K (n - m)
        (t ≫ residueUnitProjection K m g) := by
  exact pullback.lift_snd _ _ _

theorem universalMonicQuotient_map_relativeReconstruction
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (universalMonicQuotient K n g hg).map
        (relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t).appTop.hom =
      (universalMonicCoefficientPolynomial K (n - m)).map
        (relativeAffineRootSpaceToAffine K (n - m)
          (t ≫ residueUnitProjection K m g)).appTop.hom := by
  let Y := RelativeAffineRootSpace K (n - m)
    (t ≫ residueUnitProjection K m g)
  by_cases hnontrivial : Nontrivial Γ(Y, ⊤)
  · let : Nontrivial Γ(Y, ⊤) := hnontrivial
    let tY : Y ⟶ ResidueUnitSpace K m g :=
      relativeAffineRootSpaceToBase K (n - m)
        (t ≫ residueUnitProjection K m g) ≫ t
    let r := residuePolynomialAlong K m g tY
    let G := residueModulusAlong K m g tY
    let H := (universalMonicCoefficientPolynomial K (n - m)).map
      (relativeAffineRootSpaceToAffine K (n - m)
        (t ≫ residueUnitProjection K m g)).appTop.hom
    have hG : G.Monic := residueModulusAlong_monic K m g hg tY
    have hGnat : G.natDegree = m := by
      dsimp [G, residueModulusAlong]
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective _), hdeg]
    have hrdeg : r.degree < G.degree := by
      rw [Polynomial.degree_eq_natDegree hG.ne_zero, hGnat]
      dsimp [r, residuePolynomialAlong]
      apply Polynomial.degree_map_le.trans_lt
      exact Polynomial.degree_sum_fin_lt fun j : Fin m =>
        AffineSpace.coord (Spec (.of K)) (ULift.up j)
    have hc :
        (relativeAffineMonicReconstruction
            K n m g hg hdeg hmn t).appTop.hom.comp
            (rootCoefficientMap K n) =
          (tY ≫ residueUnitImmersion K m g).appTop.hom.comp
            (rootCoefficientMap K m) := by
      ext a
      exact relativeAffineMonicReconstruction_rootCoefficientMap
        K n m g hg hdeg hmn t a
    unfold universalMonicQuotient
    rw [Polynomial.map_divByMonic _ (hg.map _),
      universalMonicCoefficientPolynomial_map_relativeReconstruction
        K n m g hg hdeg hmn t,
      Polynomial.map_map, hc]
    change (r + G * H) /ₘ G = H
    exact (Polynomial.div_modByMonic_unique H r hG ⟨rfl, hrdeg⟩).1
  · have : Subsingleton Γ(Y, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

theorem relativeAffineMonicReconstruction_comp_quotient
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstruction K n m g hg hdeg hmn t ≫
        affineMonicQuotient K n m g hg =
      relativeAffineRootSpaceToAffine K (n - m)
        (t ≫ residueUnitProjection K m g) := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc, affineMonicQuotient_over,
      relativeAffineMonicReconstruction_over]
    exact relativeAffineRootSpace_condition K (n - m)
      (t ≫ residueUnitProjection K m g)
  · intro j
    rw [Scheme.Hom.comp_appTop]
    rw [CommRingCat.comp_apply]
    unfold affineMonicQuotient
    rw [AffineSpace.homOfVector_appTop_coord]
    change (relativeAffineMonicReconstruction
        K n m g hg hdeg hmn t).appTop
          ((universalMonicQuotient K n g hg).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      universalMonicQuotient_map_relativeReconstruction
        K n m g hg hdeg hmn t,
      Polynomial.coeff_map,
      universalMonicCoefficientPolynomial_coeff_lt]

set_option backward.isDefEq.respectTransparency.types false in
theorem relativeAffineRootSpace_hom_ext
    {X : Scheme.{u}} (r : ℕ) (p : X ⟶ Spec (.of K))
    {Y : Scheme.{u}}
    {f k : Y ⟶ RelativeAffineRootSpace K r p}
    (hfst : f ≫ relativeAffineRootSpaceToBase K r p =
      k ≫ relativeAffineRootSpaceToBase K r p)
    (hsnd : f ≫ relativeAffineRootSpaceToAffine K r p =
      k ≫ relativeAffineRootSpaceToAffine K r p) : f = k := by
  exact pullback.hom_ext hfst hsnd

set_option backward.isDefEq.respectTransparency.types false in
theorem relativeAffineMonicReconstructionToFiber_comp_toRelativeAffine
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeAffineMonicReconstructionToFiber
          K n m g hg hdeg hmn t ≫
        relativeSymmetricResidueUnitFiberToRelativeAffine
          K n m g hg hdeg hmn t =
      𝟙 (RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g)) := by
  apply relativeAffineRootSpace_hom_ext
  · rw [Category.assoc,
      relativeSymmetricResidueUnitFiberToRelativeAffine_base,
      relativeAffineMonicReconstructionToFiber_snd]
    simp
  · rw [Category.assoc,
      relativeSymmetricResidueUnitFiberToRelativeAffine_affine,
      ← Category.assoc,
      relativeAffineMonicReconstructionToFiber_fst,
      ← Category.assoc,
      relativeAffineMonicReconstructionToSymmetric_fac,
      relativeAffineMonicReconstruction_comp_quotient]
    simp

noncomputable def relativeSymmetricResidueUnitFiberToAffineMonicSpace
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t ⟶
      AffineRootSpace K n :=
  relativeSymmetricResidueUnitFiberToSymmetric
      K n m g hg hdeg hmn t ≫
    (SymmetricCoprimeMonicOpen K n m g).ι

theorem relativeSymmetricResidueUnitFiberToAffine_comp_residue
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t ≫
        affineMonicResidueMultiplication K n m g hg =
      relativeSymmetricResidueUnitFiberToBase
          K n m g hg hdeg hmn t ≫ t ≫
        residueUnitImmersion K m g := by
  unfold relativeSymmetricResidueUnitFiberToAffineMonicSpace
  rw [Category.assoc]
  change relativeSymmetricResidueUnitFiberToSymmetric
      K n m g hg hdeg hmn t ≫
      symmetricCoprimeMonicResidueMultiplication K n m g hg = _
  rw [← symmetricCoprimeMonicResidueMultiplicationToUnit_fac]
  rw [← Category.assoc,
    relativeSymmetricResidueUnitFiber_condition,
    Category.assoc]
  all_goals assumption

theorem universalMonicRemainder_map_relativeSymmetricFiber
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (universalMonicRemainder K n g hg).map
        (relativeSymmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom =
      residuePolynomialAlong K m g
        (relativeSymmetricResidueUnitFiberToBase
          K n m g hg hdeg hmn t ≫ t) := by
  rw [← universalResiduePolynomial_map_affineMonicResidueMultiplication
    K n m g hg hdeg]
  rw [Polynomial.map_map]
  unfold residuePolynomialAlong
  congr 1
  have e := congrArg Scheme.Hom.appTop
    (relativeSymmetricResidueUnitFiberToAffine_comp_residue
      K n m g hg hdeg hmn t)
  rw [Scheme.Hom.comp_appTop] at e
  exact congrArg CommRingCat.Hom.hom e

@[reassoc (attr := simp)]
theorem relativeSymmetricResidueUnitFiberToAffineMonicSpace_over
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t ≫
        (AffineRootSpace K n ↘ Spec (.of K)) =
      relativeSymmetricResidueUnitFiberToBase
          K n m g hg hdeg hmn t ≫ t ≫
        residueUnitProjection K m g := by
  unfold relativeSymmetricResidueUnitFiberToAffineMonicSpace
  change relativeSymmetricResidueUnitFiberToSymmetric
      K n m g hg hdeg hmn t ≫
      symmetricCoprimeMonicProjection K n m g = _
  rw [← symmetricCoprimeMonicResidueMultiplicationToUnit_over
    K n m g hg hdeg hmn]
  rw [← Category.assoc,
    relativeSymmetricResidueUnitFiber_condition]
  simp only [Category.assoc]

theorem universalMonicCoefficientPolynomial_map_relativeFiberToQuotient
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (universalMonicCoefficientPolynomial K (n - m)).map
        (relativeSymmetricResidueUnitFiberToRelativeAffine
          K n m g hg hdeg hmn t ≫
          relativeAffineRootSpaceToAffine K (n - m)
            (t ≫ residueUnitProjection K m g)).appTop.hom =
      (universalMonicQuotient K n g hg).map
        (relativeSymmetricResidueUnitFiberToAffineMonicSpace
          K n m g hg hdeg hmn t).appTop.hom := by
  rw [relativeSymmetricResidueUnitFiberToRelativeAffine_affine]
  rw [← universalMonicCoefficientPolynomial_map_affineMonicQuotient
    K n m g hg hdeg hmn]
  rw [Polynomial.map_map]
  unfold relativeSymmetricResidueUnitFiberToAffineMonicSpace
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
  rfl

theorem relativeReconstructedPolynomial_map_relativeFiber
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    (relativeReconstructedMonicPolynomial
        K n m g hg hdeg hmn t).map
      (relativeSymmetricResidueUnitFiberToRelativeAffine
        K n m g hg hdeg hmn t).appTop.hom =
    (universalMonicCoefficientPolynomial K n).map
      (relativeSymmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t).appTop.hom := by
  let φ := relativeSymmetricResidueUnitFiberToRelativeAffine
    K n m g hg hdeg hmn t
  let f := relativeSymmetricResidueUnitFiberToAffineMonicSpace
    K n m g hg hdeg hmn t
  let b := relativeAffineRootSpaceToBase K (n - m)
    (t ≫ residueUnitProjection K m g)
  let a := relativeAffineRootSpaceToAffine K (n - m)
    (t ≫ residueUnitProjection K m g)
  have hr :
      (residuePolynomialAlong K m g (b ≫ t)).map φ.appTop.hom =
        (universalMonicRemainder K n g hg).map f.appTop.hom := by
    rw [universalMonicRemainder_map_relativeSymmetricFiber
      K n m g hg hdeg hmn t]
    unfold residuePolynomialAlong
    rw [Polynomial.map_map]
    congr 1
    have hmaps : φ ≫ b ≫ t ≫ residueUnitImmersion K m g =
        relativeSymmetricResidueUnitFiberToBase
            K n m g hg hdeg hmn t ≫ t ≫
          residueUnitImmersion K m g := by
      dsimp [φ, b]
      rw [← Category.assoc,
        relativeSymmetricResidueUnitFiberToRelativeAffine_base]
    have e := congrArg Scheme.Hom.appTop hmaps
    rw [Scheme.Hom.comp_appTop] at e
    exact congrArg CommRingCat.Hom.hom e
  have hG :
      (residueModulusAlong K m g (b ≫ t)).map φ.appTop.hom =
        (g.map (rootCoefficientMap K n)).map f.appTop.hom := by
    unfold residueModulusAlong
    rw [Polynomial.map_map, Polynomial.map_map]
    congr 1
    apply RingHom.ext
    intro x
    unfold rootCoefficientMap
    have hmaps :
        (φ ≫ b ≫ t ≫ residueUnitImmersion K m g) ≫
            (AffineRootSpace K m ↘ Spec (.of K)) =
          f ≫ (AffineRootSpace K n ↘ Spec (.of K)) := by
      rw [relativeSymmetricResidueUnitFiberToAffineMonicSpace_over]
      dsimp [φ, b]
      rw [← Category.assoc,
        relativeSymmetricResidueUnitFiberToRelativeAffine_base]
      simp only [residueUnitProjection, Category.assoc]
    have e := congrArg Scheme.Hom.appTop hmaps
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at e
    exact congrArg
      (fun h => h ((Scheme.ΓSpecIso (.of K)).inv x)) e
  have hH :
      ((universalMonicCoefficientPolynomial K (n - m)).map
          a.appTop.hom).map φ.appTop.hom =
        (universalMonicQuotient K n g hg).map f.appTop.hom := by
    rw [Polynomial.map_map]
    exact universalMonicCoefficientPolynomial_map_relativeFiberToQuotient
      K n m g hg hdeg hmn t
  unfold relativeReconstructedMonicPolynomial
  rw [Polynomial.map_add, Polynomial.map_mul, hr, hG, hH]
  rw [show
      (universalMonicRemainder K n g hg).map f.appTop.hom =
        (universalMonicCoefficientPolynomial K n).map f.appTop.hom %ₘ
          (g.map (rootCoefficientMap K n)).map f.appTop.hom by
        unfold universalMonicRemainder
        rw [Polynomial.map_modByMonic _ (hg.map _)],
    show
      (universalMonicQuotient K n g hg).map f.appTop.hom =
        (universalMonicCoefficientPolynomial K n).map f.appTop.hom /ₘ
          (g.map (rootCoefficientMap K n)).map f.appTop.hom by
        unfold universalMonicQuotient
        rw [Polynomial.map_divByMonic _ (hg.map _)],
    Polynomial.modByMonic_add_div]

theorem relativeFiberToRelativeAffine_comp_reconstruction
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToRelativeAffine
          K n m g hg hdeg hmn t ≫
        relativeAffineMonicReconstruction
          K n m g hg hdeg hmn t =
      relativeSymmetricResidueUnitFiberToAffineMonicSpace
        K n m g hg hdeg hmn t := by
  apply AffineSpace.hom_ext
  · rw [Category.assoc,
      relativeAffineMonicReconstruction_over,
      relativeSymmetricResidueUnitFiberToAffineMonicSpace_over]
    rw [← Category.assoc,
      relativeSymmetricResidueUnitFiberToRelativeAffine_base]
  · intro j
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    unfold relativeAffineMonicReconstruction
    rw [AffineSpace.homOfVector_appTop_coord]
    change (relativeSymmetricResidueUnitFiberToRelativeAffine
        K n m g hg hdeg hmn t).appTop
          ((relativeReconstructedMonicPolynomial
            K n m g hg hdeg hmn t).coeff j.down) = _
    rw [← Polynomial.coeff_map,
      relativeReconstructedPolynomial_map_relativeFiber
        K n m g hg hdeg hmn t,
      Polynomial.coeff_map,
      universalMonicCoefficientPolynomial_coeff_lt]

set_option backward.isDefEq.respectTransparency.types false in
theorem relativeSymmetricResidueUnitFiber_hom_ext
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) {Y : Scheme.{u}}
    {f k : Y ⟶ RelativeSymmetricResidueUnitFiber
      K n m g hg hdeg hmn t}
    (hfst : f ≫ relativeSymmetricResidueUnitFiberToSymmetric
        K n m g hg hdeg hmn t =
      k ≫ relativeSymmetricResidueUnitFiberToSymmetric
        K n m g hg hdeg hmn t)
    (hsnd : f ≫ relativeSymmetricResidueUnitFiberToBase
        K n m g hg hdeg hmn t =
      k ≫ relativeSymmetricResidueUnitFiberToBase
        K n m g hg hdeg hmn t) : f = k := by
  exact pullback.hom_ext hfst hsnd

set_option backward.isDefEq.respectTransparency.types false in
theorem relativeFiberToRelativeAffine_comp_reconstructionToFiber
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    relativeSymmetricResidueUnitFiberToRelativeAffine
          K n m g hg hdeg hmn t ≫
        relativeAffineMonicReconstructionToFiber
          K n m g hg hdeg hmn t =
      𝟙 (RelativeSymmetricResidueUnitFiber
        K n m g hg hdeg hmn t) := by
  apply relativeSymmetricResidueUnitFiber_hom_ext
  · rw [Category.assoc,
      relativeAffineMonicReconstructionToFiber_fst]
    apply (cancel_mono (SymmetricCoprimeMonicOpen K n m g).ι).1
    rw [Category.assoc,
      relativeAffineMonicReconstructionToSymmetric_fac]
    rw [relativeFiberToRelativeAffine_comp_reconstruction
      K n m g hg hdeg hmn t]
    unfold relativeSymmetricResidueUnitFiberToAffineMonicSpace
    simp
  · rw [Category.assoc,
      relativeAffineMonicReconstructionToFiber_snd,
      relativeSymmetricResidueUnitFiberToRelativeAffine_base]
    simp

/-- Relative large-block Euclidean division is a scheme isomorphism over
the varying residue-unit base. -/
noncomputable def relativeSymmetricResidueUnitFiberIsoRelativeAffine
    {X : Scheme.{u}} (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hmn : m ≤ n)
    (t : X ⟶ ResidueUnitSpace K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn t ≅
      RelativeAffineRootSpace K (n - m)
        (t ≫ residueUnitProjection K m g) where
  hom := relativeSymmetricResidueUnitFiberToRelativeAffine
    K n m g hg hdeg hmn t
  inv := relativeAffineMonicReconstructionToFiber
    K n m g hg hdeg hmn t
  hom_inv_id :=
    relativeFiberToRelativeAffine_comp_reconstructionToFiber
      K n m g hg hdeg hmn t
  inv_hom_id :=
    relativeAffineMonicReconstructionToFiber_comp_toRelativeAffine
      K n m g hg hdeg hmn t

/-- The scheme-level large-block product fiber after dividing a prescribed
target family by the residue contributed by the remaining blocks is
independent of the prescribed target. -/
noncomputable def relativeLargeBlockProductFiberIso
    (K : Type u) [Field K] {X : Scheme.{u}}
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (target rest : X ⟶ ResidueUnitSpace K m g)
    (hover : target ≫ residueUnitProjection K m g =
      rest ≫ residueUnitProjection K m g) :
    RelativeSymmetricResidueUnitFiber K n m g hg hdeg hmn
        (residueRatioMorphism K m g hg hdeg hm target rest hover) ≅
      RelativeAffineRootSpace K (n - m)
        (rest ≫ residueUnitProjection K m g) := by
  rw [← residueRatioMorphism_over K m g hg hdeg hm target rest hover]
  exact relativeSymmetricResidueUnitFiberIsoRelativeAffine
    K n m g hg hdeg hmn
      (residueRatioMorphism K m g hg hdeg hm target rest hover)

/-- Product of two unit-valued residue families, represented by its unique
degree-`<m` remainder. -/
noncomputable def residueProductPolynomial
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g) : Polynomial Γ(X, ⊤) :=
  (residuePolynomialAlong K m g f *
      residuePolynomialAlong K m g k) %ₘ
        residueModulusAlong K m g k

theorem residueProductPolynomial_isCoprime
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    IsCoprime (residueModulusAlong K m g k)
      (residueProductPolynomial K m g f k) := by
  let M := residueModulusAlong K m g k
  let Pf := residuePolynomialAlong K m g f
  let Pk := residuePolynomialAlong K m g k
  have hMf : residueModulusAlong K m g f = M :=
    residueModulusAlong_eq_of_over K m g f k hfk
  have hf : IsCoprime M Pf := by
    rw [← hMf]
    exact residuePolynomialAlong_isCoprime K m g hg hdeg hm f
  have hk : IsCoprime M Pk :=
    residuePolynomialAlong_isCoprime K m g hg hdeg hm k
  apply (isCoprime_modByMonic_right_iff_commRing
    M (Pf * Pk) (residueModulusAlong_monic K m g hg k)).mpr
  exact hf.mul_right hk

noncomputable def residueProductAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g) : X ⟶ AffineRootSpace K m :=
  AffineSpace.homOfVector (k ≫ residueUnitProjection K m g)
    (fun j => (residueProductPolynomial K m g f k).coeff j.down)

@[reassoc (attr := simp)]
theorem residueProductAmbient_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    residueProductAmbient K m g f k ≫
        (AffineRootSpace K m ↘ Spec (.of K)) =
      k ≫ residueUnitProjection K m g := by
  exact AffineSpace.homOfVector_over _ _

@[simp]
theorem residueProductAmbient_appTop_coord
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g) (j : Fin m) :
    (residueProductAmbient K m g f k).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      (residueProductPolynomial K m g f k).coeff j := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

theorem universalResiduePolynomial_map_residueProductAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    (universalResiduePolynomial K m).map
        (residueProductAmbient K m g f k).appTop.hom =
      residueProductPolynomial K m g f k := by
  let r := residueProductPolynomial K m g f k
  by_cases hnontrivial : Nontrivial Γ(X, ⊤)
  · let : Nontrivial Γ(X, ⊤) := hnontrivial
    have hrdeg : r.degree < (m : WithBot ℕ) := by
      have hraw := Polynomial.degree_modByMonic_lt
        (residuePolynomialAlong K m g f *
          residuePolynomialAlong K m g k)
        (residueModulusAlong_monic K m g hg k)
      change r.degree < (residueModulusAlong K m g k).degree at hraw
      rw [Polynomial.degree_eq_natDegree
        (residueModulusAlong_monic K m g hg k).ne_zero] at hraw
      have hMdeg : (residueModulusAlong K m g k).natDegree = m := by
        unfold residueModulusAlong
        rw [Polynomial.natDegree_map_eq_of_injective
          (RingHom.injective _), hdeg]
      rwa [hMdeg] at hraw
    rw [universalResiduePolynomial, Polynomial.map_sum]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
      Polynomial.map_pow, residueProductAmbient_appTop_coord]
    change (∑ x : Fin m,
      Polynomial.C (r.coeff x) * Polynomial.X ^ x.1) = r
    by_cases hr : r = 0
    · simp [hr]
    have hrnat : r.natDegree < m :=
      (Polynomial.natDegree_lt_iff_degree_lt hr).mpr hrdeg
    rw [Fin.sum_univ_eq_sum_range
      (fun i : ℕ => Polynomial.C (r.coeff i) * Polynomial.X ^ i) m]
    exact (r.as_sum_range_C_mul_X_pow' hrnat).symm
  · have : Subsingleton Γ(X, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact Subsingleton.elim _ _

theorem residueProductAmbient_rootCoefficientMap
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K)
    (f k : X ⟶ ResidueUnitSpace K m g) (a : K) :
    (residueProductAmbient K m g f k).appTop
        (rootCoefficientMap K m a) =
      (k ≫ residueUnitProjection K m g).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a) := by
  unfold rootCoefficientMap
  change (((AffineRootSpace K m ↘ Spec (.of K)).appTop ≫
      (residueProductAmbient K m g f k).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
  rw [← Scheme.Hom.comp_appTop, residueProductAmbient_over]

theorem residueProductAmbient_residueUnitSection
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m)
    (f k : X ⟶ ResidueUnitSpace K m g) :
    (residueProductAmbient K m g f k).appTop
        (residueUnitSection K m g) =
      (residueModulusAlong K m g k).resultant
        (residueProductPolynomial K m g f k) m m := by
  have hc :
      (residueProductAmbient K m g f k).appTop.hom.comp
          (rootCoefficientMap K m) =
        (k ≫ residueUnitImmersion K m g).appTop.hom.comp
          (rootCoefficientMap K m) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply,
      residueProductAmbient_rootCoefficientMap,
      residueUnitMorphism_rootCoefficientMap]
  unfold residueUnitSection residueModulusAlong
  rw [← Polynomial.resultant_map_map,
    universalResiduePolynomial_map_residueProductAmbient K m g hg hdeg,
    Polynomial.map_map, hc]

theorem residueProductAmbient_residueUnitSection_isUnit
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    IsUnit ((residueProductAmbient K m g f k).appTop
      (residueUnitSection K m g)) := by
  rw [residueProductAmbient_residueUnitSection K m g hg hdeg]
  by_cases hnontrivial : Nontrivial Γ(X, ⊤)
  · let : Nontrivial Γ(X, ⊤) := hnontrivial
    have hMdeg : (residueModulusAlong K m g k).natDegree = m := by
      unfold residueModulusAlong
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective _), hdeg]
    have hRdeg :
        (residueProductPolynomial K m g f k).natDegree ≤ m := by
      unfold residueProductPolynomial
      exact (Polynomial.natDegree_modByMonic_le _
        (residueModulusAlong_monic K m g hg k)).trans_eq hMdeg
    exact isUnit_resultant_padded_of_monic_isCoprime
      (residueModulusAlong K m g k)
      (residueProductPolynomial K m g f k) m
      (residueModulusAlong_monic K m g hg k) hMdeg hRdeg
      (residueProductPolynomial_isCoprime
        K m g hg hdeg hm f k hfk)
  · have : Subsingleton Γ(X, ⊤) :=
      not_nontrivial_iff_subsingleton.mp hnontrivial
    exact isUnit_iff_exists_inv'.mpr ⟨0, Subsingleton.elim _ _⟩

/-- Multiplication in the relative residue-unit group scheme. -/
noncomputable def residueProductMorphism
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    X ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (residueProductAmbient K m g f k) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈
          residueProductAmbient K m g f k ⁻¹ᵁ
            ResidueUnitOpen K m g := by
        unfold ResidueUnitOpen
        rw [Scheme.preimage_basicOpen_top]
        rw [X.basicOpen_of_isUnit
          (residueProductAmbient_residueUnitSection_isUnit
            K m g hg hdeg hm f k hfk)]
        trivial
      exact hx)

@[reassoc (attr := simp)]
theorem residueProductMorphism_fac
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    residueProductMorphism K m g hg hdeg hm f k hfk ≫
        residueUnitImmersion K m g =
      residueProductAmbient K m g f k := by
  exact IsOpenImmersion.lift_fac _ _ _

@[reassoc (attr := simp)]
theorem residueProductMorphism_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (f k : X ⟶ ResidueUnitSpace K m g)
    (hfk : f ≫ residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g) :
    residueProductMorphism K m g hg hdeg hm f k hfk ≫
        residueUnitProjection K m g =
      k ≫ residueUnitProjection K m g := by
  unfold residueUnitProjection
  rw [← Category.assoc, residueProductMorphism_fac,
    residueProductAmbient_over]
  simp only [residueUnitProjection]

/-- Pulling the unit resultant back to the coprime-monic open works in every
degree, including the small Young blocks. -/
theorem affineMonicResidueMultiplication_residueUnitSection_eq_general
    (K : Type u) [Field K] (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    (affineMonicResidueMultiplication K n m g hg).appTop
        (residueUnitSection K m g) =
      monicCoprimeSection K n m g := by
  by_cases hmn : m ≤ n
  · exact affineMonicResidueMultiplication_residueUnitSection_eq
      K n m g hg hdeg hmn
  · have hnm : n ≤ m := Nat.le_of_lt (Nat.lt_of_not_ge hmn)
    let F := g.map (rootCoefficientMap K n)
    let P := universalMonicCoefficientPolynomial K n
    let r := universalMonicRemainder K n g hg
    have hFmonic : F.Monic := hg.map _
    have hFdeg : F.natDegree = m := by
      dsimp [F]
      rw [Polynomial.natDegree_map_eq_of_injective
        (RingHom.injective (rootCoefficientMap K n)), hdeg]
    have hPdeg : P.natDegree = n :=
      universalMonicCoefficientPolynomial_natDegree K n
    have hrle : r.natDegree ≤ m := by
      by_cases hnontrivial : Nontrivial Γ(AffineRootSpace K n, ⊤)
      · let : Nontrivial Γ(AffineRootSpace K n, ⊤) := hnontrivial
        have hrdeg : r.degree < (m : WithBot ℕ) :=
          universalMonicRemainder_degree_lt K n m g hg hdeg
        by_cases hr0 : r = 0
        · simp [hr0]
        · exact (Polynomial.natDegree_lt_iff_degree_lt hr0).mpr hrdeg |>.le
      · have : Subsingleton Γ(AffineRootSpace K n, ⊤) :=
          not_nontrivial_iff_subsingleton.mp hnontrivial
        simp only [Subsingleton.elim r 0, Polynomial.natDegree_zero,
          Nat.zero_le]
    have hq : (P /ₘ F).natDegree + m ≤ m := by
      rw [Polynomial.natDegree_divByMonic P hFmonic, hPdeg, hFdeg,
        Nat.sub_eq_zero_of_le hnm]
      simp
    have hmodRaw := Polynomial.resultant_add_mul_right
      F r (P /ₘ F) m m hq (by rw [hFdeg])
    have hmod : F.resultant r m m = F.resultant P m m := by
      have hr : r = P %ₘ F := rfl
      rw [hr] at hmodRaw
      rw [P.modByMonic_add_div F] at hmodRaw
      exact hmodRaw.symm
    have hcoeff : F.coeff m = 1 := by
      simpa [hFdeg] using hFmonic.coeff_natDegree
    have hpad : F.resultant P m m = F.resultant P m n := by
      calc
        F.resultant P m m = F.resultant P m (n + (m - n)) := by
          rw [Nat.add_sub_of_le hnm]
        _ = F.coeff m ^ (m - n) * F.resultant P m n := by
          exact Polynomial.resultant_add_right_deg
            F P m n (m - n) (by rw [hPdeg])
        _ = F.resultant P m n := by rw [hcoeff]; simp
    calc
      (affineMonicResidueMultiplication K n m g hg).appTop
          (residueUnitSection K m g) = F.resultant r m m := by
        exact affineMonicResidueMultiplication_residueUnitSection
          K n m g hg hdeg
      _ = F.resultant P m m := hmod
      _ = F.resultant P m n := hpad
      _ = monicCoprimeSection K n m g := rfl

/-- Residue multiplication from every symmetric coprime-monic block into the
unit group, without a lower bound on the block degree. -/
noncomputable def symmetricCoprimeMonicResidueToUnitGeneral
    (K : Type u) [Field K] (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    SymmetricCoprimeMonicSpace K n m g ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (symmetricCoprimeMonicResidueMultiplication K n m g hg) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : (SymmetricCoprimeMonicOpen K n m g).ι.base x ∈
          affineMonicResidueMultiplication K n m g hg ⁻¹ᵁ
            ResidueUnitOpen K m g := by
        unfold ResidueUnitOpen SymmetricCoprimeMonicOpen
        rw [Scheme.preimage_basicOpen_top,
          affineMonicResidueMultiplication_residueUnitSection_eq_general
            K n m g hg hdeg]
        exact x.2
      exact hx)

@[reassoc (attr := simp)]
theorem symmetricCoprimeMonicResidueToUnitGeneral_fac
    (K : Type u) [Field K] (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    symmetricCoprimeMonicResidueToUnitGeneral K n m g hg hdeg ≫
        residueUnitImmersion K m g =
      symmetricCoprimeMonicResidueMultiplication K n m g hg := by
  exact IsOpenImmersion.lift_fac _ _ _

@[reassoc (attr := simp)]
theorem symmetricCoprimeMonicResidueToUnitGeneral_over
    (K : Type u) [Field K] (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) :
    symmetricCoprimeMonicResidueToUnitGeneral K n m g hg hdeg ≫
        residueUnitProjection K m g =
      symmetricCoprimeMonicProjection K n m g := by
  unfold residueUnitProjection symmetricCoprimeMonicProjection
  rw [← Category.assoc, symmetricCoprimeMonicResidueToUnitGeneral_fac]
  unfold symmetricCoprimeMonicResidueMultiplication
  rw [Category.assoc, affineMonicResidueMultiplication_over]

/-- A decomposition of `Fin n` into finitely many labelled blocks.  Its
block-permutation group is the Young subgroup attached to that decomposition. -/
structure PermutationBlockDecomposition (n : ℕ) where
  Index : Type
  fintypeIndex : Fintype Index
  size : Index → ℕ
  blockEquiv : (Σ i, Fin (size i)) ≃ Fin n

namespace PermutationBlockDecomposition

instance {n : ℕ} (B : PermutationBlockDecomposition n) : Fintype B.Index :=
  B.fintypeIndex

/-- Apply one permutation independently inside each block. -/
def blockPermutation {n : ℕ} (B : PermutationBlockDecomposition n)
    (pi : ∀ i, Equiv.Perm (Fin (B.size i))) : Equiv.Perm (Fin n) :=
  B.blockEquiv.symm.trans ((Equiv.sigmaCongrRight pi).trans B.blockEquiv)

@[simp]
theorem blockPermutation_apply {n : ℕ} (B : PermutationBlockDecomposition n)
    (pi : ∀ i, Equiv.Perm (Fin (B.size i))) (i : B.Index)
    (x : Fin (B.size i)) :
    B.blockPermutation pi (B.blockEquiv ⟨i, x⟩) =
      B.blockEquiv ⟨i, pi i x⟩ := by
  simp [blockPermutation]

/-- The product of the block symmetric groups embeds in `S_n`. -/
def blockPermutationHom {n : ℕ} (B : PermutationBlockDecomposition n) :
    (∀ i, Equiv.Perm (Fin (B.size i))) →* Equiv.Perm (Fin n) where
  toFun := B.blockPermutation
  map_one' := by
    ext x
    obtain ⟨⟨i, y⟩, rfl⟩ := B.blockEquiv.surjective x
    simp
  map_mul' pi rho := by
    ext x
    obtain ⟨⟨i, y⟩, rfl⟩ := B.blockEquiv.surjective x
    simp

/-- The Young subgroup is literally embedded in the full symmetric group. -/
theorem blockPermutationHom_injective {n : ℕ}
    (B : PermutationBlockDecomposition n) :
    Function.Injective B.blockPermutationHom := by
  intro pi rho h
  change B.blockPermutation pi = B.blockPermutation rho at h
  funext i
  ext x
  have hx := Equiv.congr_fun h (B.blockEquiv ⟨i, x⟩)
  have hsigma :
      (⟨i, pi i x⟩ : Σ j, Fin (B.size j)) = ⟨i, rho i x⟩ := by
    apply B.blockEquiv.injective
    simpa only [blockPermutation_apply] using hx
  injection hsigma with _ hsecond
  exact congrArg Fin.val hsecond

end PermutationBlockDecomposition

/-- A symmetric coprime-monic Young block as an object over the ground field. -/
noncomputable def symmetricYoungBlockOver
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i : B.Index) :
    Over (Spec (.of K)) :=
  Over.mk (symmetricCoprimeMonicProjection K (B.size i) m g)

/-- Fiber product over the ground field of all Young blocks except a selected
large block. -/
noncomputable abbrev symmetricYoungRestProduct
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index) :
    Over (Spec (.of K)) :=
  ∏ᶜ fun j : {j : B.Index // j ≠ i₀} =>
    symmetricYoungBlockOver K m g B j.1

/-- Projection from the remaining-block product to one block. -/
noncomputable def symmetricYoungRestProjection
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (j : {j : B.Index // j ≠ i₀}) :
    (symmetricYoungRestProduct K m g B i₀).left ⟶
      SymmetricCoprimeMonicSpace K (B.size j.1) m g :=
  (Pi.π (fun j : {j : B.Index // j ≠ i₀} =>
    symmetricYoungBlockOver K m g B j.1) j).left

@[reassoc (attr := simp)]
theorem symmetricYoungRestProjection_over
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (j : {j : B.Index // j ≠ i₀}) :
    symmetricYoungRestProjection K m g B i₀ j ≫
        symmetricCoprimeMonicProjection K (B.size j.1) m g =
      (symmetricYoungRestProduct K m g B i₀).hom := by
  exact (Pi.π (fun j : {j : B.Index // j ≠ i₀} =>
    symmetricYoungBlockOver K m g B j.1) j).w

/-- The constant residue polynomial `1` over an arbitrary scheme over `K`. -/
noncomputable def residueOneAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (p : X ⟶ Spec (.of K)) : X ⟶ AffineRootSpace K m :=
  AffineSpace.homOfVector p (fun j => if (j.down : ℕ) = 0 then 1 else 0)

@[reassoc (attr := simp)]
theorem residueOneAmbient_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (p : X ⟶ Spec (.of K)) :
    residueOneAmbient K m p ≫ (AffineRootSpace K m ↘ Spec (.of K)) = p := by
  exact AffineSpace.homOfVector_over _ _

@[simp]
theorem residueOneAmbient_appTop_coord
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (p : X ⟶ Spec (.of K)) (j : Fin m) :
    (residueOneAmbient K m p).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
      if (j : ℕ) = 0 then 1 else 0 := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

theorem universalResiduePolynomial_map_residueOneAmbient
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (hm : 0 < m) (p : X ⟶ Spec (.of K)) :
    (universalResiduePolynomial K m).map
        (residueOneAmbient K m p).appTop.hom = 1 := by
  classical
  rw [universalResiduePolynomial, Polynomial.map_sum]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
    Polynomial.map_pow, residueOneAmbient_appTop_coord]
  let j₀ : Fin m := ⟨0, hm⟩
  rw [Finset.sum_eq_single j₀]
  · simp [j₀]
  · intro j _hj hj
    have hj0 : (j : ℕ) ≠ 0 := by
      intro h
      apply hj
      exact Fin.ext h
    simp [hj0]
  · simp

theorem residueOneAmbient_residueUnitSection
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K)) :
    (residueOneAmbient K m p).appTop (residueUnitSection K m g) = 1 := by
  unfold residueUnitSection
  rw [← Polynomial.resultant_map_map,
    universalResiduePolynomial_map_residueOneAmbient K m hm p]
  rw [Polynomial.map_map, Polynomial.resultant_one_right]
  have hgcoeff : g.coeff m = 1 := by
    rw [← hdeg]
    exact hg.coeff_natDegree
  have hcoeff :
      (g.map ((residueOneAmbient K m p).appTop.hom.comp
        (rootCoefficientMap K m))).coeff m = 1 := by
    rw [Polynomial.coeff_map, hgcoeff, map_one]
  rw [hcoeff]
  simp

/-- The identity section of the relative residue-unit group. -/
noncomputable def residueOneMorphism
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K)) : X ⟶ ResidueUnitSpace K m g :=
  IsOpenImmersion.lift (ResidueUnitOpen K m g).ι
    (residueOneAmbient K m p) (by
      rw [(ResidueUnitOpen K m g).range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ residueOneAmbient K m p ⁻¹ᵁ ResidueUnitOpen K m g := by
        unfold ResidueUnitOpen
        rw [Scheme.preimage_basicOpen_top]
        rw [X.basicOpen_of_isUnit]
        · trivial
        · rw [residueOneAmbient_residueUnitSection K m g hg hdeg hm p]
          exact isUnit_one
      exact hx)

@[reassoc (attr := simp)]
theorem residueOneMorphism_fac
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K)) :
    residueOneMorphism K m g hg hdeg hm p ≫ residueUnitImmersion K m g =
      residueOneAmbient K m p := by
  exact IsOpenImmersion.lift_fac _ _ _

@[reassoc (attr := simp)]
theorem residueOneMorphism_over
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K)) :
    residueOneMorphism K m g hg hdeg hm p ≫ residueUnitProjection K m g = p := by
  unfold residueUnitProjection
  rw [← Category.assoc, residueOneMorphism_fac, residueOneAmbient_over]

/-- A residue-unit family with a fixed structural morphism to the ground
field. -/
def ResidueUnitFamilyOver
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (p : X ⟶ Spec (.of K)) :=
  {f : X ⟶ ResidueUnitSpace K m g //
    f ≫ residueUnitProjection K m g = p}

/-- Identity in the relative residue-unit family. -/
noncomputable def residueOneFamilyOver
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K)) : ResidueUnitFamilyOver K m g p :=
  ⟨residueOneMorphism K m g hg hdeg hm p,
    residueOneMorphism_over K m g hg hdeg hm p⟩

/-- Product of two residue-unit families over the same base. -/
noncomputable def residueFamilyProduct
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K))
    (f k : ResidueUnitFamilyOver K m g p) :
    ResidueUnitFamilyOver K m g p :=
  ⟨residueProductMorphism K m g hg hdeg hm f.1 k.1
      (f.2.trans k.2.symm), by
    rw [residueProductMorphism_over]
    exact k.2⟩

/-- Ordered finite product of residue-unit families.  No commutativity law is
needed for the construction: a fixed list order is sufficient. -/
noncomputable def residueFamilyListProduct
    (K : Type u) [Field K] {X : Scheme.{u}}
    (m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m)
    (p : X ⟶ Spec (.of K))
    (families : List (ResidueUnitFamilyOver K m g p)) :
    ResidueUnitFamilyOver K m g p :=
  families.foldr (residueFamilyProduct K m g hg hdeg hm p)
    (residueOneFamilyOver K m g hg hdeg hm p)

/-- Residue contributed by one of the remaining symmetric Young blocks. -/
noncomputable def symmetricYoungRestFactorResidueFamily
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (j : {j : B.Index // j ≠ i₀}) :
    ResidueUnitFamilyOver K m g
      (symmetricYoungRestProduct K m g B i₀).hom :=
  ⟨symmetricYoungRestProjection K m g B i₀ j ≫
      symmetricCoprimeMonicResidueToUnitGeneral
        K (B.size j.1) m g hg hdeg, by
    rw [Category.assoc,
      symmetricCoprimeMonicResidueToUnitGeneral_over,
      symmetricYoungRestProjection_over]⟩

/-- Product residue of all Young blocks except the selected large block. -/
noncomputable def symmetricYoungRestResidueFamily
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index) :
    ResidueUnitFamilyOver K m g
      (symmetricYoungRestProduct K m g B i₀).hom := by
  classical
  exact residueFamilyListProduct K m g hg hdeg hm
    (symmetricYoungRestProduct K m g B i₀).hom
    ((Finset.univ : Finset {j : B.Index // j ≠ i₀}).toList.map
      (symmetricYoungRestFactorResidueFamily K m g hg hdeg B i₀))

/-- The prescribed target pulled back to the remaining-block parameter
scheme. -/
noncomputable def symmetricYoungTargetFamily
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (t : ResidueUnitPoint K m g) :
    (symmetricYoungRestProduct K m g B i₀).left ⟶
      ResidueUnitSpace K m g :=
  (symmetricYoungRestProduct K m g B i₀).hom ≫ t

theorem symmetricYoungTargetFamily_over
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    symmetricYoungTargetFamily K m g B i₀ t ≫
        residueUnitProjection K m g =
      (symmetricYoungRestProduct K m g B i₀).hom := by
  unfold symmetricYoungTargetFamily
  rw [Category.assoc, ht, Category.comp_id]

/-- Symmetric Young-quotient fiber with a selected large block; the other
blocks form its base and contribute the residue by multiplication. -/
noncomputable def LargeYoungSymmetricResidueFiber
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀) (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) : Scheme.{u} :=
  RelativeSymmetricResidueUnitFiber K (B.size i₀) m g hg hdeg hlarge
    (residueRatioMorphism K m g hg hdeg hm
      (symmetricYoungTargetFamily K m g B i₀ t)
      (symmetricYoungRestResidueFamily K m g hg hdeg hm B i₀).1
      ((symmetricYoungTargetFamily_over K m g B i₀ t ht).trans
        (symmetricYoungRestResidueFamily K m g hg hdeg hm B i₀).2.symm))

/-- Scheme form of Sawin's large-block quotient lemma: after quotienting by
the Young subgroup, every target fiber is a fixed relative affine space over
the product of the remaining symmetric blocks. -/
noncomputable def largeYoungSymmetricResidueFiberIso
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀) (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    LargeYoungSymmetricResidueFiber K m g hg hdeg hm B i₀ hlarge t ht ≅
      RelativeAffineRootSpace K (B.size i₀ - m)
        (symmetricYoungRestProduct K m g B i₀).hom := by
  let E := relativeLargeBlockProductFiberIso
    K (B.size i₀) m g hg hdeg hm hlarge
      (symmetricYoungTargetFamily K m g B i₀ t)
      (symmetricYoungRestResidueFamily K m g hg hdeg hm B i₀).1
      ((symmetricYoungTargetFamily_over K m g B i₀ t ht).trans
        (symmetricYoungRestResidueFamily K m g hg hdeg hm B i₀).2.symm)
  exact E.trans (eqToIso (congrArg
    (RelativeAffineRootSpace K (B.size i₀ - m))
    (symmetricYoungRestResidueFamily
      K m g hg hdeg hm B i₀).2))

/-! Locally finite-type morphisms are closed under finite products in an
over-category.  Mathlib provides this through the finite-limit theorem for
`MorphismProperty.Over`; the following explicit diagram transport makes the
result directly usable for the Young-block product. -/

abbrev LocallyOfFiniteTypeProperty : MorphismProperty Scheme :=
  @LocallyOfFiniteType

instance locallyOfFiniteType_hasOfPostcompProperty :
    LocallyOfFiniteTypeProperty.HasOfPostcompProperty
      LocallyOfFiniteTypeProperty where
  of_postcomp f g _hfg hcomp := by
    let : LocallyOfFiniteType (f ≫ g) := hcomp
    exact locallyOfFiniteType_of_comp f g

noncomputable def locallyOfFiniteTypeOverDiagram
    {S : Scheme} {J : Type} [Finite J]
    (F : Discrete J ⥤ Over S)
    (hF : ∀ j, LocallyOfFiniteType (F.obj j).hom) :
    Discrete J ⥤ (LocallyOfFiniteTypeProperty.Over ⊤ S) where
  obj j := MorphismProperty.Over.mk ⊤ (F.obj j).hom (hF j)
  map f := MorphismProperty.Over.homMk (F.map f).left (F.map f).w
  map_id j := by
    apply MorphismProperty.Over.Hom.ext
    change (F.map (𝟙 j)).left = 𝟙 _
    rw [F.map_id]
    rfl
  map_comp f g := by
    apply MorphismProperty.Over.Hom.ext
    change (F.map (f ≫ g)).left = (F.map f).left ≫ (F.map g).left
    rw [F.map_comp]
    rfl

theorem locallyOfFiniteType_limit_over
    {S : Scheme} {J : Type} [Finite J]
    (F : Discrete J ⥤ Over S)
    (hF : ∀ j, LocallyOfFiniteType (F.obj j).hom) :
    LocallyOfFiniteType (limit F).hom := by
  let P : MorphismProperty Scheme := @LocallyOfFiniteType
  let D := locallyOfFiniteTypeOverDiagram F hF
  let U := MorphismProperty.Over.forget P ⊤ S
  have hDU : D ⋙ U = F := by
    rfl
  let e₀ : U.obj (limit D) ≅ limit (D ⋙ U) :=
    preservesLimitIso U D
  let e₁ : limit (D ⋙ U) ≅ limit F :=
    HasLimit.isoOfNatIso (eqToIso hDU)
  let e : U.obj (limit D) ≅ limit F := e₀ ≪≫ e₁
  have hdom : LocallyOfFiniteType (U.obj (limit D)).hom :=
    (limit D).prop
  have he : e.hom.left ≫ (limit F).hom = (U.obj (limit D)).hom := by
    exact e.hom.w
  rw [← he] at hdom
  let : IsIso e.hom.left := by
    refine ⟨⟨e.inv.left, ?_, ?_⟩⟩
    · simpa using congrArg (fun k => k.left) e.hom_inv_id
    · simpa using congrArg (fun k => k.left) e.inv_hom_id
  exact (MorphismProperty.cancel_left_of_respectsIso
    P e.hom.left (limit F).hom).mp hdom

theorem locallyOfFiniteType_affineRootSpace_projection
    (K : Type) [Field K] (r : ℕ) :
    LocallyOfFiniteType (AffineRootSpace K r ↘ Spec (.of K)) := by
  let : Smooth (AffineRootSpace K r ↘ Spec (.of K)) :=
    smooth_affineRootSpace_projection K r
  infer_instance

theorem locallyOfFiniteType_symmetricYoungRestProduct
    (K : Type) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index) :
    LocallyOfFiniteType (symmetricYoungRestProduct K m g B i₀).hom := by
  apply locallyOfFiniteType_limit_over
  intro j
  dsimp [symmetricYoungBlockOver]
  let : Smooth
      (symmetricCoprimeMonicProjection K (B.size j.as) m g) :=
    smooth_symmetricCoprimeMonicProjection K (B.size j.as) m g
  infer_instance

theorem locallyOfFiniteType_relativeAffineRootSpaceToBase
    (K : Type) [Field K] {X : Scheme} (r : ℕ)
    (p : X ⟶ Spec (.of K)) :
    LocallyOfFiniteType (relativeAffineRootSpaceToBase K r p) := by
  let : LocallyOfFiniteType (AffineRootSpace K r ↘ Spec (.of K)) :=
    locallyOfFiniteType_affineRootSpace_projection K r
  unfold relativeAffineRootSpaceToBase RelativeAffineRootSpace
  infer_instance

/-- The product of the nonselected Young blocks is affine.  We prove this
directly from the realization of products in an over-category as wide
pullbacks: the centre is `Spec K`, and every leg is a principal open in an
affine coefficient space.  This also covers the empty product. -/
noncomputable instance symmetricYoungRestProduct_isAffine
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index) :
    IsAffine (symmetricYoungRestProduct K m g B i₀).left := by
  let F : Discrete {j : B.Index // j ≠ i₀} ⥤ Over (Spec (.of K)) :=
    Discrete.functor fun j ↦ symmetricYoungBlockOver K m g B j
  let c : Cone
      (Over.ConstructProducts.widePullbackDiagramOfDiagramOver
        (Spec (.of K)) F) :=
    Over.ConstructProducts.conesEquivInverseObj
      (Spec (.of K)) F (limit.cone F)
  have hc : IsLimit c :=
    IsLimit.ofRightAdjoint
      (Over.ConstructProducts.conesEquiv (Spec (.of K)) F).toAdjunction
      (limit.isLimit F)
  let : ∀ i, IsAffine
      ((Over.ConstructProducts.widePullbackDiagramOfDiagramOver
        (Spec (.of K)) F).obj i) := fun i ↦ by
    obtain - | j := i
    · dsimp [F, Over.ConstructProducts.widePullbackDiagramOfDiagramOver,
        WidePullbackShape.wideCospan]
      infer_instance
    · dsimp [F, Over.ConstructProducts.widePullbackDiagramOfDiagramOver,
        WidePullbackShape.wideCospan]
      exact isAffine_symmetricCoprimeMonicSpace K
        (B.size j.1) m g
  exact Scheme.isAffine_of_isLimit c hc

/-- A relative affine coefficient space over an affine base is affine. -/
noncomputable instance relativeAffineRootSpace_isAffine
    (K : Type u) [Field K] {X : Scheme.{u}} [IsAffine X]
    (r : ℕ) (p : X ⟶ Spec (.of K)) :
    IsAffine (RelativeAffineRootSpace K r p) := by
  unfold RelativeAffineRootSpace
  infer_instance

/-- Every large-block symmetric Young fiber is affine, by the explicit
Euclidean-division isomorphism. -/
noncomputable instance largeYoungSymmetricResidueFiber_isAffine
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀) (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    IsAffine
      (LargeYoungSymmetricResidueFiber K m g hg hdeg hm B i₀ hlarge t ht) := by
  exact IsAffine.of_isIso
    (largeYoungSymmetricResidueFiberIso
      K m g hg hdeg hm B i₀ hlarge t ht).hom

/-- Any two target fibers of a fixed large Young quotient are isomorphic:
both are the same relative affine coefficient space over the product of the
remaining blocks. -/
noncomputable def largeYoungSymmetricResidueFiberTargetIso
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t' : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K)))
    (ht' : t' ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    LargeYoungSymmetricResidueFiber K m g hg hdeg hm B i₀ hlarge t ht ≅
      LargeYoungSymmetricResidueFiber K m g hg hdeg hm B i₀ hlarge t' ht' :=
  (largeYoungSymmetricResidueFiberIso
      K m g hg hdeg hm B i₀ hlarge t ht).trans
    (largeYoungSymmetricResidueFiberIso
      K m g hg hdeg hm B i₀ hlarge t' ht').symm

/-- Structure morphism of a large Young quotient fiber to the ground field.
It first remembers the remaining symmetric blocks and then uses their common
structure morphism. -/
noncomputable def largeYoungSymmetricResidueFiberProjection
    (K : Type u) [Field K] (m : ℕ) (g : Polynomial K)
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀) (t : ResidueUnitPoint K m g)
    (ht : t ≫ residueUnitProjection K m g = 𝟙 (Spec (.of K))) :
    LargeYoungSymmetricResidueFiber K m g hg hdeg hm B i₀ hlarge t ht ⟶
      Spec (.of K) :=
  relativeSymmetricResidueUnitFiberToBase
      K (B.size i₀) m g hg hdeg hlarge
      (residueRatioMorphism K m g hg hdeg hm
        (symmetricYoungTargetFamily K m g B i₀ t)
        (symmetricYoungRestResidueFamily K m g hg hdeg hm B i₀).1
        ((symmetricYoungTargetFamily_over K m g B i₀ t ht).trans
          (symmetricYoungRestResidueFamily
            K m g hg hdeg hm B i₀).2.symm)) ≫
    (symmetricYoungRestProduct K m g B i₀).hom

/-- More generally, an arbitrary scheme admits at most one morphism to the
spectrum of the prime field. -/
theorem schemeToSpecZMod_hom_ext {X : Scheme} (q : ℕ)
    (f g : X ⟶ Spec (.of (ZMod q))) : f = g := by
  apply ext_of_isAffine
  apply (cancel_epi (Scheme.ΓSpecIso (.of (ZMod q))).inv).1
  apply CommRingCat.hom_ext
  exact RingHom.ext_zmod _ _

/-- The explicit large Young quotient fiber is locally of finite type over
the prime field.  This is the hypothesis needed to place its affine model in
a finite-dimensional projective space. -/
theorem locallyOfFiniteType_largeYoungSymmetricResidueFiberProjection
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LocallyOfFiniteType
      (largeYoungSymmetricResidueFiberProjection
        (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) := by
  let pRest := (symmetricYoungRestProduct (ZMod q) m g B i₀).hom
  let pRel := relativeAffineRootSpaceToBase
    (ZMod q) (B.size i₀ - m) pRest
  let pY := pRel ≫ pRest
  let e := largeYoungSymmetricResidueFiberIso
    (ZMod q) m g hg hdeg hm B i₀ hlarge t ht
  let : LocallyOfFiniteType pRest :=
    locallyOfFiniteType_symmetricYoungRestProduct
      (ZMod q) m g B i₀
  let : LocallyOfFiniteType pRel :=
    locallyOfFiniteType_relativeAffineRootSpaceToBase
      (ZMod q) (B.size i₀ - m) pRest
  have hpY : LocallyOfFiniteType pY := by
    dsimp only [pY]
    infer_instance
  have he : e.hom ≫ pY =
      largeYoungSymmetricResidueFiberProjection
        (ZMod q) m g hg hdeg hm B i₀ hlarge t ht :=
    schemeToSpecZMod_hom_ext q _ _
  rw [← he]
  exact MorphismProperty.comp_mem @LocallyOfFiniteType _ _
    (by infer_instance) hpY

noncomputable instance
    largeYoungSymmetricResidueFiberProjection_locallyOfFiniteType
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    LocallyOfFiniteType
      (largeYoungSymmetricResidueFiberProjection
        (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) :=
  locallyOfFiniteType_largeYoungSymmetricResidueFiberProjection
    q m g hg hdeg hm B i₀ hlarge t ht

/-- The projective closure of the affine large Young quotient fiber. -/
noncomputable abbrev LargeYoungSymmetricResidueFiberProjectiveClosure
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) : Scheme :=
  affineFiniteTypeProjectiveClosure (ZMod q)
    (LargeYoungSymmetricResidueFiber
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)

/-- Open immersion of the large Young quotient fiber into its projective
closure. -/
noncomputable abbrev largeYoungSymmetricResidueFiberProjectiveClosureOpen
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :=
  affineFiniteTypeProjectiveClosureOpen (ZMod q)
    (LargeYoungSymmetricResidueFiber
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)

/-- Proper structure morphism of the projective closure. -/
noncomputable abbrev
    largeYoungSymmetricResidueFiberProjectiveClosureProjection
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :=
  affineFiniteTypeProjectiveClosureProjection (ZMod q)
    (LargeYoungSymmetricResidueFiber
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)

/-- The compactification square is a square over the original structure
morphism. -/
theorem largeYoungSymmetricResidueFiberProjectiveClosureOpen_over
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    largeYoungSymmetricResidueFiberProjectiveClosureOpen
        q m g hg hdeg hm B i₀ hlarge t ht ≫
      largeYoungSymmetricResidueFiberProjectiveClosureProjection
        q m g hg hdeg hm B i₀ hlarge t ht =
      largeYoungSymmetricResidueFiberProjection
        (ZMod q) m g hg hdeg hm B i₀ hlarge t ht := by
  exact schemeToSpecZMod_hom_ext q _ _

/-- Over a finite prime field, the target-to-target large Young isomorphism
is automatically a morphism over the ground field. -/
theorem largeYoungSymmetricResidueFiberTargetIso_over_zmod
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t' : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht' : t' ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    (largeYoungSymmetricResidueFiberTargetIso
      (ZMod q) m g hg hdeg hm B i₀ hlarge t t' ht ht').hom ≫
        largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht' =
      largeYoungSymmetricResidueFiberProjection
        (ZMod q) m g hg hdeg hm B i₀ hlarge t ht := by
  exact schemeToSpecZMod_hom_ext q _ _

/-- Base change of the target-independent large Young quotient to the chosen
algebraic closure.  This is the actual geometric-fiber isomorphism on which
compactly supported `Q_ℓ`-cohomology is computed. -/
noncomputable def largeYoungSymmetricResidueFiberGeometricIso
    (q m : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q))
    (hg : g.Monic) (hdeg : g.natDegree = m) (hm : 0 < m)
    {n : ℕ} (B : PermutationBlockDecomposition n) (i₀ : B.Index)
    (hlarge : m ≤ B.size i₀)
    (t t' : ResidueUnitPoint (ZMod q) m g)
    (ht : t ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q))))
    (ht' : t' ≫ residueUnitProjection (ZMod q) m g =
      𝟙 (Spec (.of (ZMod q)))) :
    Scheme.ProEt.GeometricFiber q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t ht) ≅
      Scheme.ProEt.GeometricFiber q
        (largeYoungSymmetricResidueFiberProjection
          (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht') :=
  asIso (Scheme.ProEt.geometricFiberMap q
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t ht)
    (largeYoungSymmetricResidueFiberProjection
      (ZMod q) m g hg hdeg hm B i₀ hlarge t' ht')
    (largeYoungSymmetricResidueFiberTargetIso
      (ZMod q) m g hg hdeg hm B i₀ hlarge t t' ht ht').hom
    (largeYoungSymmetricResidueFiberTargetIso_over_zmod
      q m g hg hdeg hm B i₀ hlarge t t' ht ht'))

/-! A geometric point of the base-changed scheme is used in the trace
formula only as a point over the chosen copy of `Fbar_q`.  The pullback
universal property identifies those relative points with the ordinary
`Fbar_q`-valued points of the original `F_q`-scheme. -/

/-- `Fbar_q`-valued points of an `F_q`-scheme are exactly the
`Fbar_q`-relative points of its geometric fiber. -/
noncomputable def geometricRationalPointEquiv
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    (Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) ≃
      {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q p //
        y ≫ pullback.snd p (Scheme.ProEt.geometricPoint q) = 𝟙 _} where
  toFun x := ⟨pullback.lift x (𝟙 _) (by
      simpa using schemeToSpecZMod_hom_ext q (x ≫ p)
        (Scheme.ProEt.geometricPoint q)), pullback.lift_snd _ _ _⟩
  invFun y := y.1 ≫ pullback.fst p (Scheme.ProEt.geometricPoint q)
  left_inv x := pullback.lift_fst _ _ _
  right_inv y := by
    apply Subtype.ext
    apply pullback.hom_ext
    · exact pullback.lift_fst _ _ _
    · rw [pullback.lift_snd]
      exact y.2.symm

@[simp]
theorem geometricRationalPointEquiv_fst
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    (geometricRationalPointEquiv X q p x).1 ≫
        pullback.fst p (Scheme.ProEt.geometricPoint q) = x :=
  (geometricRationalPointEquiv X q p).symm_apply_apply x

/-- Passage to the geometric fiber intertwines an endomorphism defined over
`F_q` with its action on `Fbar_q`-relative points. -/
theorem geometricRationalPointEquiv_map
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p)
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    (geometricRationalPointEquiv X q p x).1 ≫
        Scheme.ProEt.geometricFiberMap q p p f hf =
      (geometricRationalPointEquiv X q p (x ≫ f)).1 := by
  apply pullback.hom_ext
  · rw [Category.assoc,
      Scheme.ProEt.geometricFiberMap_fst,
      ← Category.assoc,
      geometricRationalPointEquiv_fst,
      geometricRationalPointEquiv_fst]
  · rw [Category.assoc,
      Scheme.ProEt.geometricFiberMap_snd]
    exact (geometricRationalPointEquiv X q p x).2.trans
      (geometricRationalPointEquiv X q p (x ≫ f)).2.symm

/-- Frobenius-fixed points before base change are equivalently relative
fixed points of the base-changed Frobenius.  This is the point-side bridge
used when the Lefschetz trace is formed on geometric cohomology. -/
noncomputable def geometricFrobeniusFixedPointEquiv
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p) :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X // x ≫ f = x} ≃
      {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q p //
            y ≫ pullback.snd p (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
        y.1 ≫ Scheme.ProEt.geometricFiberMap q p p f hf = y.1} where
  toFun x := ⟨geometricRationalPointEquiv X q p x.1, by
    rw [geometricRationalPointEquiv_map, x.2]⟩
  invFun y := ⟨(geometricRationalPointEquiv X q p).symm y.1, by
    let x := (geometricRationalPointEquiv X q p).symm y.1
    apply (geometricRationalPointEquiv X q p).injective
    apply Subtype.ext
    have hmap := geometricRationalPointEquiv_map X q p f hf x
    have hxy : geometricRationalPointEquiv X q p x = y.1 :=
      (geometricRationalPointEquiv X q p).apply_symm_apply y.1
    rw [← hmap, hxy]
    exact y.2⟩
  left_inv x := by
    apply Subtype.ext
    exact (geometricRationalPointEquiv X q p).symm_apply_apply x.1
  right_inv y := by
    apply Subtype.ext
    exact (geometricRationalPointEquiv X q p).apply_symm_apply y.1

/-- The `q`-power automorphism of the chosen algebraic closure, viewed
contravariantly as an automorphism of its affine spectrum.  This is the
arithmetic base Frobenius; the geometric Frobenius used in cohomology is its
inverse below. -/
noncomputable def geometricBaseArithmeticFrobenius
    (q : ℕ) [Fact q.Prime] :
    Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))) :=
  Spec.map
    (frobeniusEquiv (AlgebraicClosure (ZMod q)) q).toCommRingCatIso.hom

noncomputable instance geometricBaseArithmeticFrobenius_isIso
    (q : ℕ) [Fact q.Prime] :
    IsIso (geometricBaseArithmeticFrobenius q) := by
  unfold geometricBaseArithmeticFrobenius
  infer_instance

/-- The algebraic-closure Frobenius fixes the prime-field base. -/
theorem geometricBaseArithmeticFrobenius_over (q : ℕ) [Fact q.Prime] :
    geometricBaseArithmeticFrobenius q ≫ Scheme.ProEt.geometricPoint q =
      Scheme.ProEt.geometricPoint q :=
  schemeToSpecZMod_hom_ext q _ _

/-- Geometric Frobenius is the inverse of arithmetic Frobenius on the
algebraically closed base.  With the source transport in
`geometricRelativePointSemilinearAction`, this convention produces the
usual `q`-power Frobenius on rational coordinates. -/
noncomputable def geometricBaseFrobenius (q : ℕ) [Fact q.Prime] :
    Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))) :=
  inv (geometricBaseArithmeticFrobenius q)

noncomputable instance geometricBaseFrobenius_isIso
    (q : ℕ) [Fact q.Prime] : IsIso (geometricBaseFrobenius q) := by
  unfold geometricBaseFrobenius
  infer_instance

theorem geometricBaseFrobenius_over (q : ℕ) [Fact q.Prime] :
  geometricBaseFrobenius q ≫ Scheme.ProEt.geometricPoint q =
      Scheme.ProEt.geometricPoint q := by
  apply (cancel_epi (geometricBaseArithmeticFrobenius q)).1
  simp [geometricBaseFrobenius,
    geometricBaseArithmeticFrobenius_over]

/-- Under the pullback point equivalence, the semilinear base action is
ordinary precomposition by the inverse automorphism of the geometric
point.  This records the precise point convention needed in the Lefschetz
comparison. -/
theorem geometricRationalPointEquiv_baseAction
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ Scheme.ProEt.geometricPoint q =
      Scheme.ProEt.geometricPoint q) [IsIso b]
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    (geometricRationalPointEquiv X q p).symm
        (Scheme.ProEt.geometricRelativePointBaseAction X q p b hb
          (geometricRationalPointEquiv X q p x)) =
      inv b ≫ x := by
  change (inv b ≫ (geometricRationalPointEquiv X q p x).1 ≫
      Scheme.ProEt.geometricFiberBaseMap q p b hb) ≫
        pullback.fst p (Scheme.ProEt.geometricPoint q) = inv b ≫ x
  simp only [Category.assoc, Scheme.ProEt.geometricFiberBaseMap_fst]
  rw [geometricRationalPointEquiv_fst]

/-- The combined geometric-fiber/base action corresponds exactly to
precomposition by the inverse base automorphism followed by the original
`F_q`-morphism. -/
theorem geometricRationalPointEquiv_semilinearAction
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p)
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ Scheme.ProEt.geometricPoint q =
      Scheme.ProEt.geometricPoint q) [IsIso b]
    (x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X) :
    (geometricRationalPointEquiv X q p).symm
        (Scheme.ProEt.geometricRelativePointSemilinearAction
          X q p f hf b hb (geometricRationalPointEquiv X q p x)) =
      inv b ≫ x ≫ f := by
  change (inv b ≫ (geometricRationalPointEquiv X q p x).1 ≫
      Scheme.ProEt.geometricFiberMap q p p f hf ≫
      Scheme.ProEt.geometricFiberBaseMap q p b hb) ≫
        pullback.fst p (Scheme.ProEt.geometricPoint q) =
      inv b ≫ x ≫ f
  simp only [Category.assoc, Scheme.ProEt.geometricFiberBaseMap_fst,
    Scheme.ProEt.geometricFiberMap_fst]
  change inv b ≫
      ((geometricRationalPointEquiv X q p x).1 ≫
        pullback.fst p (Scheme.ProEt.geometricPoint q)) ≫ f =
    inv b ≫ x ≫ f
  rw [geometricRationalPointEquiv_fst]

/-- Fixed relative geometric points of a semilinear action are exactly the
ordinary geometric points fixed by the corresponding transported action.
This is the fixed-point form used to state the geometric Lefschetz formula
without conflating absolute scheme Frobenius with Galois Frobenius. -/
noncomputable def geometricSemilinearFixedPointEquiv
    (X : Scheme) (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (f : X ⟶ X) (hf : f ≫ p = p)
    (b : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
      Spec (.of (AlgebraicClosure (ZMod q))))
    (hb : b ≫ Scheme.ProEt.geometricPoint q =
      Scheme.ProEt.geometricPoint q) [IsIso b] :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶ X //
        inv b ≫ x ≫ f = x} ≃
      {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q p //
            y ≫ pullback.snd p (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
        Scheme.ProEt.geometricRelativePointSemilinearAction
          X q p f hf b hb y = y} where
  toFun x := ⟨geometricRationalPointEquiv X q p x.1, by
    apply (geometricRationalPointEquiv X q p).symm.injective
    rw [geometricRationalPointEquiv_semilinearAction, x.2]
    exact (geometricRationalPointEquiv X q p).symm_apply_apply x.1 |>.symm⟩
  invFun y := ⟨(geometricRationalPointEquiv X q p).symm y.1, by
    have hfixed := congrArg (geometricRationalPointEquiv X q p).symm y.2
    have hcomp := geometricRationalPointEquiv_semilinearAction
      X q p f hf b hb ((geometricRationalPointEquiv X q p).symm y.1)
    rw [(geometricRationalPointEquiv X q p).apply_symm_apply y.1] at hcomp
    exact hcomp.symm.trans hfixed⟩
  left_inv x := by
    apply Subtype.ext
    exact (geometricRationalPointEquiv X q p).symm_apply_apply x.1
  right_inv y := by
    apply Subtype.ext
    exact (geometricRationalPointEquiv X q p).apply_symm_apply y.1

/-- A prime-field-valued point of the residue-unit target is a closed
immersion.  It is a section of the target's structural morphism, because the
prime field has no nontrivial endomorphism. -/
theorem residueUnitPoint_isClosedImmersion
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) : IsClosedImmersion t := by
  apply isClosedImmersion_of_comp_eq_id
    (residueUnitProjection (ZMod q) m g) t
  exact specZMod_hom_ext q _ _

/-- The literal fiber is a closed subscheme of ordered root space. -/
theorem fullResidueUnitFiberToRootSpace_isClosedImmersion
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsClosedImmersion
      (fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) := by
  let : IsClosedImmersion t := residueUnitPoint_isClosedImmersion q m g t
  unfold fullResidueUnitFiberToRootSpace FullResidueUnitFiber
  infer_instance

/-- Composing the closed fiber embedding with the principal-open root-space
chart realizes the fiber as a locally closed subscheme of affine root space. -/
theorem fullResidueUnitFiberToAffineRootSpace_isImmersion
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsImmersion
      (fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen (ZMod q) n g).ι) := by
  let : IsClosedImmersion
      (fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToRootSpace_isClosedImmersion
      q n m g hg hdeg hm hmn t
  infer_instance

/-- The locally closed affine embedding is quasi-compact, so its
scheme-theoretic image will make the fiber an open subscheme. -/
theorem fullResidueUnitFiberToAffineRootSpace_quasiCompact
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    QuasiCompact
      (fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen (ZMod q) n g).ι) := by
  let : IsClosedImmersion
      (fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToRootSpace_isClosedImmersion
      q n m g hg hdeg hm hmn t
  let : QuasiCompact (RootSpaceOpen (ZMod q) n g).ι := by
    unfold RootSpaceOpen
    infer_instance
  infer_instance

/-- The literal residue-unit fiber as a locally closed subscheme of the
standard projective compactification of ordered affine root space. -/
noncomputable def fullResidueUnitFiberToProjectiveRootSpace
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t ⟶
      AlgebraicGeometry.ProjectiveCompactification.ProjectiveSpace
        (ZMod q) (RootIndex n) :=
  fullResidueUnitFiberToRootSpace
      (ZMod q) n m g hg hdeg hm hmn t ≫
    (RootSpaceOpen (ZMod q) n g).ι ≫
    AlgebraicGeometry.ProjectiveCompactification.affineSpaceToProjective
      (ZMod q) (RootIndex n)

theorem fullResidueUnitFiberToProjectiveRootSpace_isImmersion
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsImmersion (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t) := by
  unfold fullResidueUnitFiberToProjectiveRootSpace
  let : IsClosedImmersion
      (fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToRootSpace_isClosedImmersion
      q n m g hg hdeg hm hmn t
  infer_instance

theorem fullResidueUnitFiberToProjectiveRootSpace_quasiCompact
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    QuasiCompact (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t) := by
  unfold fullResidueUnitFiberToProjectiveRootSpace
  let : IsClosedImmersion
      (fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToRootSpace_isClosedImmersion
      q n m g hg hdeg hm hmn t
  let : QuasiCompact (RootSpaceOpen (ZMod q) n g).ι := by
    unfold RootSpaceOpen
    infer_instance
  infer_instance

/-- The projective realization of the literal residue fiber is a morphism
over the prime field. -/
@[reassoc]
theorem fullResidueUnitFiberToProjectiveRootSpace_over
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberToProjectiveRootSpace
          q n m g hg hdeg hm hmn t ≫
        AlgebraicGeometry.ProjectiveCompactification.projectiveSpaceProjection
          (ZMod q) (RootIndex n) =
      fullResidueUnitFiberProjection
        (ZMod q) n m g hg hdeg hm hmn t := by
  unfold fullResidueUnitFiberToProjectiveRootSpace
  simp only [Category.assoc,
    AlgebraicGeometry.ProjectiveCompactification.affineSpaceToProjective_over]
  change fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        rootSpaceProjection (ZMod q) n g =
      fullResidueUnitFiberProjection
        (ZMod q) n m g hg hdeg hm hmn t
  rw [← fullResidueMultiplicationToUnit_over
    (ZMod q) n m g hg hdeg hm hmn]
  simp only [← Category.assoc, fullResidueUnitFiber_condition]
  rw [Category.assoc]
  have ht : t ≫ residueUnitProjection (ZMod q) m g = 𝟙 _ :=
    specZMod_hom_ext q _ _
  rw [ht, Category.comp_id]

/-- Scheme-theoretic closure of a full residue-unit fiber in projective
ordered-root space. -/
noncomputable abbrev FullResidueUnitFiberProjectiveClosure
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) : Scheme :=
  AlgebraicGeometry.ProperClosure
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t)

/-- The fiber is a genuine open subscheme of its projective closure. -/
noncomputable def fullResidueUnitFiberProjectiveClosureOpen
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberProjectiveClosure
        q n m g hg hdeg hm hmn t :=
  AlgebraicGeometry.properClosureOpen
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t)

/-- Proper structural map of the projective closure. -/
noncomputable def fullResidueUnitFiberProjectiveClosureProjection
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberProjectiveClosure
        q n m g hg hdeg hm hmn t ⟶ Spec (.of (ZMod q)) :=
  AlgebraicGeometry.properClosureProjection
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t)
    (AlgebraicGeometry.ProjectiveCompactification.projectiveSpaceProjection
      (ZMod q) (RootIndex n))

/-- The canonical open immersion into the projective closure lies over the
prime field; composing it with the proper structure morphism recovers the
literal fiber projection. -/
@[reassoc]
theorem fullResidueUnitFiberProjectiveClosureOpen_over
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t =
      fullResidueUnitFiberProjection
        (ZMod q) n m g hg hdeg hm hmn t := by
  unfold fullResidueUnitFiberProjectiveClosureOpen
    fullResidueUnitFiberProjectiveClosureProjection
    AlgebraicGeometry.properClosureProjection
  rw [← Category.assoc,
    AlgebraicGeometry.properClosureOpen_imageι]
  exact fullResidueUnitFiberToProjectiveRootSpace_over
    q n m g hg hdeg hm hmn t

theorem fullResidueUnitFiberProjectiveClosureOpen_isOpenImmersion
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsOpenImmersion (fullResidueUnitFiberProjectiveClosureOpen
      q n m g hg hdeg hm hmn t) := by
  let : IsImmersion (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToProjectiveRootSpace_isImmersion
      q n m g hg hdeg hm hmn t
  let : QuasiCompact (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberToProjectiveRootSpace_quasiCompact
      q n m g hg hdeg hm hmn t
  unfold fullResidueUnitFiberProjectiveClosureOpen
  infer_instance

theorem fullResidueUnitFiberProjectiveClosureProjection_isProper
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsProper (fullResidueUnitFiberProjectiveClosureProjection
      q n m g hg hdeg hm hmn t) := by
  let : IsProper
      (AlgebraicGeometry.ProjectiveCompactification.projectiveSpaceProjection
        (ZMod q) (RootIndex n)) :=
    AlgebraicGeometry.ProjectiveCompactification.projectiveSpaceProjection_isProper
      (ZMod q) (RootIndex n)
  unfold fullResidueUnitFiberProjectiveClosureProjection
  infer_instance

/-- The canonical projective closure is locally Noetherian.  This is the
finiteness property of the geometric ambient space needed before invoking
the finiteness theorem for constructible compact-support cohomology: the
closure is proper, hence locally of finite type, over the Noetherian prime
field. -/
theorem fullResidueUnitFiberProjectiveClosure_isLocallyNoetherian
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsLocallyNoetherian (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t) := by
  let pbar := fullResidueUnitFiberProjectiveClosureProjection
    q n m g hg hdeg hm hmn t
  let : IsProper pbar :=
    fullResidueUnitFiberProjectiveClosureProjection_isProper
      q n m g hg hdeg hm hmn t
  exact LocallyOfFiniteType.isLocallyNoetherian pbar

/-- Properness over a field also makes the canonical projective closure a
Noetherian scheme (not merely locally Noetherian), since a proper morphism
is quasi-compact. -/
theorem fullResidueUnitFiberProjectiveClosure_isNoetherian
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsNoetherian (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t) := by
  let pbar := fullResidueUnitFiberProjectiveClosureProjection
    q n m g hg hdeg hm hmn t
  let : IsProper pbar :=
    fullResidueUnitFiberProjectiveClosureProjection_isProper
      q n m g hg hdeg hm hmn t
  let : IsLocallyNoetherian (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberProjectiveClosure_isLocallyNoetherian
      q n m g hg hdeg hm hmn t
  let : CompactSpace (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t) :=
    (quasiCompact_iff_compactSpace pbar).mp inferInstance
  exact AlgebraicGeometry.IsNoetherian.mk

/-- Every prime-field valued point of affine root space is fixed by the
coordinatewise `q`-power Frobenius. -/
theorem affinePoint_frobenius_fixed
    (q m : ℕ) [Fact q.Prime]
    (x : Spec (.of (ZMod q)) ⟶ AffineRootSpace (ZMod q) m) :
    x ≫ affineRootFrobenius q m = x := by
  apply AffineSpace.hom_ext
  · exact specZMod_hom_ext q _ _
  · intro i
    change x.appTop
        ((affineRootFrobenius q m).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) i)) = _
    rw [affineRootFrobenius_coord, map_pow]
    apply (Scheme.ΓSpecIso (.of (ZMod q))).commRingCatIsoToRingEquiv.injective
    rw [map_pow]
    exact ZMod.pow_card _

/-- Every prime-field valued point of the resultant-open unit target is fixed
by its restricted Frobenius. -/
theorem residueUnitPoint_frobenius_fixed
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) :
    t ≫ residueUnitFrobenius q m g = t := by
  let : IsOpenImmersion (residueUnitImmersion (ZMod q) m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion (ZMod q) m g)).1
  rw [Category.assoc, residueUnitFrobenius_ι]
  exact affinePoint_frobenius_fixed q m
    (t ≫ residueUnitImmersion (ZMod q) m g)

/-- The geometric Frobenius endomorphism of an actual full unit fiber. -/
noncomputable def fullResidueUnitFiberFrobenius
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t :=
  pullback.lift
    (fullResidueUnitFiberToRootSpace
      (ZMod q) n m g hg hdeg hm hmn t ≫ rootFrobenius q n g)
    (fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t)
    (by
      rw [Category.assoc,
        rootFrobenius_fullResidueMultiplicationToUnit]
      simp only [← Category.assoc,
        fullResidueUnitFiber_condition]
      rw [Category.assoc, residueUnitPoint_frobenius_fixed])

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberFrobenius_toRootSpace
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t =
      fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫ rootFrobenius q n g := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberFrobenius_over
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t =
      fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t := by
  exact pullback.lift_snd _ _ _

/-- The `q`-power endomorphism on an arbitrary algebra over `ZMod q`.
Unlike Mathlib's `frobenius`, this also covers the zero ring, which occurs
as the global sections of the empty affine scheme. -/
noncomputable def frobeniusOverZMod
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) : R →+* R := by
  classical
  exact if h : Nontrivial R then
      letI : Nontrivial R := h
      letI : CharP R q := CharP.of_ringHom_of_ne_zero ι q
        (show q ≠ 0 from (show q.Prime from Fact.out).ne_zero)
      frobenius R q
    else
      RingHom.id R

@[simp]
theorem frobeniusOverZMod_apply
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) (x : R) :
    frobeniusOverZMod q ι x = x ^ q := by
  classical
  unfold frobeniusOverZMod
  split_ifs with h
  · rfl
  · have : Subsingleton R := not_nontrivial_iff_subsingleton.mp h
    exact Subsingleton.elim _ _

/-- The structural ring map on global sections for an affine scheme over the
prime field. -/
noncomputable def globalSectionsZModMap
    (X : Scheme) (q : ℕ) (p : X ⟶ Spec (.of (ZMod q))) :
    ZMod q →+* Γ(X, ⊤) :=
  ((Scheme.ΓSpecIso (.of (ZMod q))).inv ≫ p.appTop).hom

/-- Absolute Frobenius on an affine `ZMod q`-scheme, including the empty
scheme. -/
noncomputable def affineSchemeFrobeniusOver
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) : X ⟶ X :=
  X.isoSpec.hom ≫
    Spec.map (CommRingCat.ofHom
      (frobeniusOverZMod q (globalSectionsZModMap X q p))) ≫
    X.isoSpec.inv

theorem affineSchemeFrobeniusOver_naturality
    {X Y : Scheme} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pY : Y ⟶ Spec (.of (ZMod q))) :
    affineSchemeFrobeniusOver X q pX ≫ f =
      f ≫ affineSchemeFrobeniusOver Y q pY := by
  have hfr :
      Spec.map (CommRingCat.ofHom
          (frobeniusOverZMod q (globalSectionsZModMap X q pX))) ≫
          Spec.map f.appTop =
        Spec.map f.appTop ≫
          Spec.map (CommRingCat.ofHom
            (frobeniusOverZMod q (globalSectionsZModMap Y q pY))) := by
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    ext x
    simp
  unfold affineSchemeFrobeniusOver
  simp only [Category.assoc]
  rw [← Scheme.isoSpec_inv_naturality f]
  rw [← Category.assoc
    (Spec.map (CommRingCat.ofHom
      (frobeniusOverZMod q (globalSectionsZModMap X q pX))))
    (Spec.map f.appTop) Y.isoSpec.inv]
  rw [hfr]
  simp only [Category.assoc]
  rw [Scheme.isoSpec_hom_naturality_assoc]

theorem frobeniusOverZMod_isIntegral
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) : (frobeniusOverZMod q ι).IsIntegral := by
  intro x
  refine ⟨Polynomial.X ^ q - Polynomial.C x,
    Polynomial.monic_X_pow_sub_C _
      (show 0 < q from (show q.Prime from Fact.out).pos).ne', ?_⟩
  simp

theorem specFrobeniusOverZMod_surjective
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) :
    Surjective (Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι))) := by
  constructor
  intro P
  refine ⟨P, ?_⟩
  apply PrimeSpectrum.ext
  ext x
  change frobeniusOverZMod q ι x ∈ P.asIdeal ↔ x ∈ P.asIdeal
  rw [frobeniusOverZMod_apply]
  exact P.2.pow_mem_iff_mem _
    (show 0 < q from (show q.Prime from Fact.out).pos)

theorem specFrobeniusOverZMod_universallyInjective
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) :
    UniversallyInjective
      (Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι))) := by
  apply ((tfae_universallyInjective
    (Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι)))).out 0 1).mpr
  intro K _ g₁ g₂ h
  change g₁ ≫ Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι)) =
    g₂ ≫ Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι)) at h
  rw [← Spec.map_preimage g₁, ← Spec.map_preimage g₂] at h ⊢
  rw [← Spec.map_comp, ← Spec.map_comp, Spec.map_inj] at h
  apply congrArg (fun k => Spec.map k)
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro x
  have hx := DFunLike.congr_fun (CommRingCat.hom_ext_iff.mp h) x
  change (Spec.preimage g₁).hom (frobeniusOverZMod q ι x) =
    (Spec.preimage g₂).hom (frobeniusOverZMod q ι x) at hx
  rw [frobeniusOverZMod_apply, map_pow, map_pow] at hx
  let : CharP K q :=
    (CharP.charP_iff_prime_eq_zero (show q.Prime from Fact.out)).2 (by
      rw [← map_natCast (Spec.preimage g₁).hom]
      change (Spec.preimage g₁).hom ((q : R)) = 0
      have hqR : (q : R) = 0 := by
        rw [← map_natCast ι, CharP.cast_eq_zero, map_zero]
      rw [hqR, map_zero])
  have hsub :
      ((Spec.preimage g₁).hom x - (Spec.preimage g₂).hom x) ^ q = 0 := by
    rw [sub_pow_char, hx, sub_self]
  exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hsub)

theorem specFrobeniusOverZMod_integral
    (q : ℕ) [Fact q.Prime] {R : Type*} [CommRing R]
    (ι : ZMod q →+* R) :
    IsIntegralHom
      (Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι))) := by
  rw [IsIntegralHom.SpecMap_iff]
  exact frobeniusOverZMod_isIntegral q ι

theorem affineSchemeFrobeniusOver_integral
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    IsIntegralHom (affineSchemeFrobeniusOver X q p) := by
  unfold affineSchemeFrobeniusOver
  let := specFrobeniusOverZMod_integral q (globalSectionsZModMap X q p)
  infer_instance

theorem affineSchemeFrobeniusOver_surjective
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    Surjective (affineSchemeFrobeniusOver X q p) := by
  unfold affineSchemeFrobeniusOver
  let := specFrobeniusOverZMod_surjective q (globalSectionsZModMap X q p)
  infer_instance

theorem affineSchemeFrobeniusOver_universallyInjective
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    UniversallyInjective (affineSchemeFrobeniusOver X q p) := by
  unfold affineSchemeFrobeniusOver
  let : MorphismProperty.RespectsIso (@UniversallyInjective) :=
    UniversallyInjective.respectsIso
  rw [MorphismProperty.cancel_left_of_respectsIso @UniversallyInjective,
    MorphismProperty.cancel_right_of_respectsIso @UniversallyInjective]
  exact specFrobeniusOverZMod_universallyInjective q
    (globalSectionsZModMap X q p)

theorem affineSchemeFrobeniusOverBaseChangeIsHomeomorph
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q))) :
    ∀ U : X.ProEt,
      IsHomeomorph
        (pullback.fst U.hom (affineSchemeFrobeniusOver X q p)).base := by
  let := affineSchemeFrobeniusOver_integral X q p
  let := affineSchemeFrobeniusOver_surjective X q p
  let := affineSchemeFrobeniusOver_universallyInjective X q p
  exact baseChangeIsHomeomorph_of_integral_surjective_universallyInjective _

theorem affineSchemeFrobeniusOver_Spec
    {R : Type} [CommRing R] (q : ℕ) [Fact q.Prime]
    (p : Spec (.of R) ⟶ Spec (.of (ZMod q))) (ι : ZMod q →+* R) :
    affineSchemeFrobeniusOver (Spec (.of R)) q p =
      Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι)) := by
  unfold affineSchemeFrobeniusOver
  rw [Scheme.isoSpec_Spec_hom, Scheme.isoSpec_Spec_inv]
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  ext x
  simp

theorem affineSchemeFrobeniusOver_eq_conjugate
    {X : Scheme} [IsAffine X] {R : Type} [CommRing R]
    (e : X ≅ Spec (.of R)) (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (pR : Spec (.of R) ⟶ Spec (.of (ZMod q)))
    (ι : ZMod q →+* R) :
    affineSchemeFrobeniusOver X q pX =
      e.hom ≫ Spec.map (CommRingCat.ofHom (frobeniusOverZMod q ι)) ≫
        e.inv := by
  apply (cancel_mono e.hom).1
  rw [affineSchemeFrobeniusOver_naturality e.hom q pX pR,
    affineSchemeFrobeniusOver_Spec q pR ι]
  simp

theorem affineSchemeFrobeniusOver_affineRoot_eq
    (q n : ℕ) [Fact q.Prime] :
    affineSchemeFrobeniusOver (AffineRootSpace (ZMod q) n) q
        (AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))) =
      affineRootFrobenius q n := by
  rw [affineSchemeFrobeniusOver_eq_conjugate
    (AffineSpace.SpecIso (RootIndex n) (.of (ZMod q))) q
    (AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q)))
    (Spec.map (CommRingCat.ofHom MvPolynomial.C)) MvPolynomial.C]
  rw [← affineRootFrobeniusSpec_eq]
  unfold affineRootFrobeniusSpec
  congr 2
  apply congrArg Spec.map
  apply CommRingCat.hom_ext
  apply DFunLike.ext _ _
  intro x
  exact frobeniusOverZMod_apply q MvPolynomial.C x

noncomputable instance rootSpace_isAffine
    {K : Type} [CommRing K] (n : ℕ) (g : Polynomial K) :
    IsAffine (RootSpace K n g) := by
  change IsAffine ((AffineRootSpace K n).basicOpen _)
  infer_instance

theorem affineSchemeFrobeniusOver_rootSpace_eq
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    affineSchemeFrobeniusOver (RootSpace (ZMod q) n g) q
        (rootSpaceProjection (ZMod q) n g) =
      rootFrobenius q n g := by
  apply (cancel_mono (RootSpaceOpen (ZMod q) n g).ι).1
  rw [affineSchemeFrobeniusOver_naturality
      (RootSpaceOpen (ZMod q) n g).ι q
      (rootSpaceProjection (ZMod q) n g)
      (AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))),
    affineSchemeFrobeniusOver_affineRoot_eq,
    rootFrobenius_ι]

theorem affineSchemeFrobeniusOver_specZMod_eq_id
    (q : ℕ) [Fact q.Prime]
    (p : Spec (.of (ZMod q)) ⟶ Spec (.of (ZMod q))) :
    affineSchemeFrobeniusOver (Spec (.of (ZMod q))) q p = 𝟙 _ :=
  specZMod_hom_ext q _ _

/-- A ring map into a field of characteristic `q` is pointwise fixed by
`q`-power Frobenius exactly when it factors through the prime field. -/
theorem ringHom_frobenius_fixed_iff_descendsToZMod
    (q : ℕ) [Fact q.Prime]
    {R F : Type} [CommRing R] [Field F] [CharP F q]
    (f : R →+* F) :
    (∀ x : R, f x ^ q = f x) ↔
      ∃ f₀ : R →+* ZMod q,
        (ZMod.castHom (m := q) dvd_rfl F).comp f₀ = f := by
  let ι : ZMod q →+* F := ZMod.castHom (m := q) dvd_rfl F
  constructor
  · intro hfixed
    have hrange : ι.fieldRange = (⊥ : Subfield F) :=
      ZMod.fieldRange_castHom_eq_bot q
    let e : ZMod q ≃+* ι.fieldRange := ι.rangeRestrictFieldEquiv
    let f₀ : R →+* ZMod q :=
      { toFun := fun x => e.symm ⟨f x, by
            rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
            exact hfixed x⟩
        map_one' := by
          rw [show (⟨f 1, by
            rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
            exact hfixed 1⟩ : ι.fieldRange) = 1 by ext; simp]
          exact e.symm.map_one
        map_mul' := by
          intro x y
          rw [show (⟨f (x * y), by
            rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
            exact hfixed (x * y)⟩ : ι.fieldRange) =
              ⟨f x, by
                rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
                exact hfixed x⟩ *
              ⟨f y, by
                rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
                exact hfixed y⟩ by ext; exact f.map_mul x y]
          exact e.symm.map_mul _ _
        map_zero' := by
          rw [show (⟨f 0, by
            rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
            exact hfixed 0⟩ : ι.fieldRange) = 0 by ext; simp]
          exact e.symm.map_zero
        map_add' := by
          intro x y
          rw [show (⟨f (x + y), by
            rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
            exact hfixed (x + y)⟩ : ι.fieldRange) =
              ⟨f x, by
                rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
                exact hfixed x⟩ +
              ⟨f y, by
                rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
                exact hfixed y⟩ by ext; exact f.map_add x y]
          exact e.symm.map_add _ _ }
    refine ⟨f₀, ?_⟩
    ext x
    change ι (f₀ x) = f x
    exact ι.rangeRestrictFieldEquiv_apply_symm_apply
      ⟨f x, by
        rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
        exact hfixed x⟩
  · rintro ⟨f₀, hf₀⟩ x
    have hx := DFunLike.congr_fun hf₀ x
    change (ZMod.castHom (m := q) dvd_rfl F) (f₀ x) = f x at hx
    rw [← hx, ← map_pow, ZMod.pow_card]

/-- A geometric point of an affine spectrum is Frobenius-fixed exactly when
it descends to a rational point over the prime field. -/
theorem specPoint_frobenius_fixed_iff_descendsToZMod
    (q : ℕ) [Fact q.Prime]
    {R F : Type} [CommRing R] [Field F] [CharP F q]
    (p : Spec (.of R) ⟶ Spec (.of (ZMod q)))
    (x : Spec (.of F) ⟶ Spec (.of R)) :
    x ≫ affineSchemeFrobeniusOver (Spec (.of R)) q p = x ↔
      ∃ x₀ : Spec (.of (ZMod q)) ⟶ Spec (.of R),
        Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F)) ≫ x₀ = x := by
  let ιR : ZMod q →+* R :=
    ((Spec.preimage p).hom)
  let f : R →+* F := (Spec.preimage x).hom
  rw [affineSchemeFrobeniusOver_Spec q p ιR]
  constructor
  · intro hfixed
    have hring : ∀ y : R, f y ^ q = f y := by
      have hmaps :
          (CommRingCat.ofHom (frobeniusOverZMod q ιR)) ≫
              (CommRingCat.ofHom f) =
            CommRingCat.ofHom f := by
        apply Spec.map_injective
        simpa [f] using hfixed
      intro y
      have hy := DFunLike.congr_fun (CommRingCat.hom_ext_iff.mp hmaps) y
      simpa [frobeniusOverZMod_apply] using hy
    obtain ⟨f₀, hf₀⟩ :=
      (ringHom_frobenius_fixed_iff_descendsToZMod q f).mp hring
    refine ⟨Spec.map (CommRingCat.ofHom f₀), ?_⟩
    rw [← Spec.map_comp]
    calc
      Spec.map (CommRingCat.ofHom f₀ ≫
          CommRingCat.ofHom (ZMod.castHom (m := q) dvd_rfl F)) =
          Spec.map (CommRingCat.ofHom f) := by
            congr 1
            exact CommRingCat.hom_ext hf₀
      _ = x := by simpa [f] using Spec.map_preimage x
  · rintro ⟨x₀, hx₀⟩
    obtain ⟨f₀, rfl⟩ := Spec.map_surjective (R := .of R)
      (S := .of (ZMod q)) x₀
    rw [← Spec.map_comp] at hx₀
    have hxmap : Spec.map (CommRingCat.ofHom f) = x := by
      simpa [f] using Spec.map_preimage x
    rw [← hxmap, Spec.map_inj] at hx₀
    rw [← hxmap]
    rw [← Spec.map_comp]
    rw [Spec.map_inj]
    apply CommRingCat.hom_ext
    ext y
    change f (frobeniusOverZMod q ιR y) = f y
    rw [frobeniusOverZMod_apply, map_pow]
    have hy := DFunLike.congr_fun (CommRingCat.hom_ext_iff.mp hx₀) y
    change (ZMod.castHom (m := q) dvd_rfl F) (f₀ y) = f y at hy
    rw [← hy, ← map_pow, ZMod.pow_card]

/-- The fixed-point/rational-point equivalence for an arbitrary affine
scheme over the prime field. -/
theorem affinePoint_frobenius_fixed_iff_descendsToZMod
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (p : X ⟶ Spec (.of (ZMod q)))
    (x : Spec (.of F) ⟶ X) :
    x ≫ affineSchemeFrobeniusOver X q p = x ↔
      ∃ x₀ : Spec (.of (ZMod q)) ⟶ X,
        Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F)) ≫ x₀ = x := by
  let pR : Spec (.of Γ(X, ⊤)) ⟶ Spec (.of (ZMod q)) :=
    X.isoSpec.inv ≫ p
  let y : Spec (.of F) ⟶ Spec (.of Γ(X, ⊤)) := x ≫ X.isoSpec.hom
  have hnat :
      affineSchemeFrobeniusOver X q p ≫ X.isoSpec.hom =
        X.isoSpec.hom ≫
          affineSchemeFrobeniusOver (Spec (.of Γ(X, ⊤))) q pR :=
    affineSchemeFrobeniusOver_naturality X.isoSpec.hom q p pR
  constructor
  · intro hfixed
    have hyfixed :
        y ≫ affineSchemeFrobeniusOver (Spec (.of Γ(X, ⊤))) q pR = y := by
      dsimp only [y]
      rw [Category.assoc, ← hnat, ← Category.assoc, hfixed]
    obtain ⟨y₀, hy₀⟩ :=
      (specPoint_frobenius_fixed_iff_descendsToZMod
        q pR y).mp hyfixed
    refine ⟨y₀ ≫ X.isoSpec.inv, ?_⟩
    rw [← Category.assoc, hy₀]
    simp [y]
  · rintro ⟨x₀, hx₀⟩
    apply (cancel_mono X.isoSpec.hom).1
    rw [Category.assoc, hnat, ← Category.assoc]
    let y₀ : Spec (.of (ZMod q)) ⟶ Spec (.of Γ(X, ⊤)) :=
      x₀ ≫ X.isoSpec.hom
    have hy₀ :
        Spec.map (CommRingCat.ofHom
            (ZMod.castHom (m := q) dvd_rfl F)) ≫ y₀ = y := by
      dsimp only [y₀, y]
      rw [← Category.assoc, hx₀]
    have hyfixed :=
      (specPoint_frobenius_fixed_iff_descendsToZMod
        q pR y).mpr ⟨y₀, hy₀⟩
    exact hyfixed

/-- Frobenius-fixed geometric points of an affine prime-field scheme are
equivalent, as a type, to its prime-field rational points. -/
noncomputable def affineFrobeniusFixedGeometricPointEquiv
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (p : X ⟶ Spec (.of (ZMod q))) :
    (Spec (.of (ZMod q)) ⟶ X) ≃
      {x : Spec (.of F) ⟶ X //
        x ≫ affineSchemeFrobeniusOver X q p = x} := by
  let base : Spec (.of F) ⟶ Spec (.of (ZMod q)) :=
    Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F))
  let toFixed : (Spec (.of (ZMod q)) ⟶ X) →
      {x : Spec (.of F) ⟶ X //
        x ≫ affineSchemeFrobeniusOver X q p = x} :=
    fun x₀ => ⟨base ≫ x₀,
      (affinePoint_frobenius_fixed_iff_descendsToZMod
        X q F p (base ≫ x₀)).mpr ⟨x₀, rfl⟩⟩
  refine Equiv.ofBijective toFixed ⟨?_, ?_⟩
  · intro x₀ y₀ h
    have hval := congrArg Subtype.val h
    let f := ZMod.castHom (m := q) dvd_rfl F
    let : Mono (CommRingCat.ofHom f) :=
      ConcreteCategory.mono_of_injective _ f.injective
    have : Epi base := by
      dsimp only [base]
      infer_instance
    exact (cancel_epi base).mp hval
  · rintro ⟨x, hx⟩
    obtain ⟨x₀, hx₀⟩ :=
      (affinePoint_frobenius_fixed_iff_descendsToZMod
        X q F p x).mp hx
    refine ⟨x₀, ?_⟩
    apply Subtype.ext
    exact hx₀

/-- Algebra maps from an essentially finite-type algebra to a finite ring
form a finite type: evaluation on one finite generating set is injective. -/
noncomputable instance finiteAlgHom_of_essFiniteType
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Algebra.EssFiniteType R A]
    [Finite B] : Finite (A →ₐ[R] B) := by
  let s := Algebra.EssFiniteType.finset R A
  let eval : (A →ₐ[R] B) → (s → B) := fun f x => f x
  apply Finite.of_injective eval
  intro f g h
  apply Algebra.EssFiniteType.algHom_ext
  intro x hx
  exact congrFun h ⟨x, hx⟩

/-- Every ring map between algebras over `ZMod q` is automatically a
`ZMod q`-algebra map, since maps out of `ZMod q` are unique. -/
noncomputable def ringHomToZModAlgHom
    (q : ℕ) (A B : Type*) [CommRing A] [CommRing B]
    [Algebra (ZMod q) A] [Algebra (ZMod q) B]
    (f : A →+* B) : A →ₐ[ZMod q] B where
  toRingHom := f
  commutes' x := by
    have h := RingHom.ext_zmod
      (f.comp (algebraMap (ZMod q) A)) (algebraMap (ZMod q) B)
    exact DFunLike.congr_fun h x

theorem ringHomToZModAlgHom_injective
    (q : ℕ) (A B : Type*) [CommRing A] [CommRing B]
    [Algebra (ZMod q) A] [Algebra (ZMod q) B] :
    Function.Injective (ringHomToZModAlgHom q A B) := by
  intro f g h
  exact DFunLike.ext _ _ fun x => DFunLike.congr_fun h x

/-- Ring maps into the prime field are equivalently algebra maps over that
prime field. -/
noncomputable def ringHomEquivZModAlgHom
    (q : ℕ) (A : Type*) [CommRing A] [Algebra (ZMod q) A] :
    (A →+* ZMod q) ≃ (A →ₐ[ZMod q] ZMod q) where
  toFun := ringHomToZModAlgHom q A (ZMod q)
  invFun f := f.toRingHom
  left_inv _ := rfl
  right_inv _ := rfl

/-- Affine-scheme points over a prime field are equivalently algebra maps
to that field.  The base-linearity is automatic because a ring map out of
`ZMod q` is unique. -/
noncomputable def specHomEquivZModAlgHom
    (q : ℕ) (A : Type) [CommRing A] [Algebra (ZMod q) A] :
    (Spec (.of (ZMod q)) ⟶ Spec (.of A)) ≃ (A →ₐ[ZMod q] ZMod q) where
  toFun f := ringHomToZModAlgHom q A (ZMod q) (Spec.preimage f).hom
  invFun f := Spec.map (CommRingCat.ofHom f.toRingHom)
  left_inv f := by
    change Spec.map (CommRingCat.ofHom (Spec.preimage f).hom) = f
    exact Spec.map_preimage f
  right_inv f := by
    apply AlgHom.ext
    intro x
    change (Spec.preimage (Spec.map (CommRingCat.ofHom f.toRingHom))).hom x = f x
    rw [Spec.preimage_map]
    rfl

/-- Scheme-valued rational points of the universal residue family are
exactly the congruent ordered pairwise-coprime polynomial triples. -/
noncomputable def universalResidueTripleFactorizationPointEquivCongruent
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hgdeg : g.natDegree = m) (htdeg : t.degree < (m : WithBot ℕ))
    (hm : m ≤ 3 * d) :
    (Spec (.of (ZMod q)) ⟶
      Spec (.of (UniversalResidueTripleFactorizationRing
        (ZMod q) d m g t hg hgdeg htdeg hm))) ≃
      CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t :=
  (specHomEquivZModAlgHom q
      (UniversalResidueTripleFactorizationRing
        (ZMod q) d m g t hg hgdeg htdeg hm)).trans
    (CongruentPairwiseCoprimeTriple.universalResidueTripleFactorizationHomEquivCongruent
      hg hgdeg htdeg hm)

/-- Cardinal form of the exact rational-point classification. -/
theorem universalResidueTripleFactorizationPoint_natCard_eq
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hgdeg : g.natDegree = m) (htdeg : t.degree < (m : WithBot ℕ))
    (hm : m ≤ 3 * d) :
    Nat.card (Spec (.of (ZMod q)) ⟶
      Spec (.of (UniversalResidueTripleFactorizationRing
        (ZMod q) d m g t hg hgdeg htdeg hm))) =
      Nat.card (CongruentPairwiseCoprimeTriple
        (ZMod q) (ZMod q) d g t) :=
  Nat.card_congr
    (universalResidueTripleFactorizationPointEquivCongruent
      q d m g t hg hgdeg htdeg hm)

/-- Over any characteristic-`q` field, the Frobenius-fixed geometric points
of the universal residue family are exactly its congruent prime-field
triples.  This is the fixed-point form consumed by the trace formula. -/
noncomputable def
    universalResidueTripleFactorizationFixedGeometricPointEquivCongruent
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hgdeg : g.natDegree = m) (htdeg : t.degree < (m : WithBot ℕ))
    (hm : m ≤ 3 * d) :
    {x : Spec (.of F) ⟶
        Spec (.of (UniversalResidueTripleFactorizationRing
          (ZMod q) d m g t hg hgdeg htdeg hm)) //
      x ≫ affineSchemeFrobeniusOver
        (Spec (.of (UniversalResidueTripleFactorizationRing
          (ZMod q) d m g t hg hgdeg htdeg hm))) q
        (universalResidueTripleFactorizationProjection
          (ZMod q) d m g t hg hgdeg htdeg hm) = x} ≃
      CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t :=
  (affineFrobeniusFixedGeometricPointEquiv
      (Spec (.of (UniversalResidueTripleFactorizationRing
        (ZMod q) d m g t hg hgdeg htdeg hm))) q F
      (universalResidueTripleFactorizationProjection
        (ZMod q) d m g t hg hgdeg htdeg hm)).symm.trans
    (universalResidueTripleFactorizationPointEquivCongruent
      q d m g t hg hgdeg htdeg hm)

/-- The concrete congruent-triple type is finite. -/
noncomputable instance finiteCongruentPairwiseCoprimeTriple
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    Finite (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) := by
  let : Finite (Polynomial.MonicDegreeEq (ZMod q) d) := by
    apply Finite.of_injective
      (fun f : Polynomial.MonicDegreeEq (ZMod q) d =>
        fun i : Fin d => f.1.coeff i)
    intro f h heq
    apply Subtype.ext
    apply Polynomial.ext
    intro n
    by_cases hn : n < d
    · exact congrFun heq ⟨n, hn⟩
    by_cases hnd : n = d
    · subst n
      rw [show f.1.coeff d = 1 by
        simpa only [f.natDegree] using f.monic.coeff_natDegree,
        show h.1.coeff d = 1 by
          simpa only [h.natDegree] using h.monic.coeff_natDegree]
    · have hdn : d < n := by omega
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn),
        Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn)]
  apply Finite.of_injective
    (fun x : CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t =>
      (x.factor₁, x.factor₂, x.factor₃))
  intro x y h
  apply CongruentPairwiseCoprimeTriple.ext
  · exact congrArg Prod.fst h
  · exact congrArg (fun z => z.2.1) h
  · exact congrArg (fun z => z.2.2) h

noncomputable instance fintypeCongruentPairwiseCoprimeTriple
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    Fintype (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) :=
  Fintype.ofFinite _

noncomputable instance decidableEqCongruentPairwiseCoprimeTriple
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    DecidableEq (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) :=
  Classical.decEq _

/-- The identity matrix on the literal rational-point classification. -/
noncomputable def universalResidueTripleRationalPointTraceMatrix
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    Matrix
      (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t)
      (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) ℂ :=
  by classical exact 1

/-- The trace of the rational-point identity matrix is the exact number of
congruent ordered pairwise-coprime triples. -/
theorem universalResidueTripleRationalPointTraceMatrix_trace
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :
    (universalResidueTripleRationalPointTraceMatrix q d g t).trace =
      (Nat.card
        (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) : ℂ) := by
  classical
  unfold universalResidueTripleRationalPointTraceMatrix Matrix.trace
  rw [Nat.card_eq_fintype_card]
  simp

/-- Every characteristic root of the literal point-count matrix has norm
one.  This is the finite fixed-point weight bound before cohomological
compression supplies the square-root saving. -/
theorem universalResidueTripleRationalPointTraceMatrix_root_norm_le_one
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (z : ℂ)
    (hz : z ∈
      (universalResidueTripleRationalPointTraceMatrix q d g t).charpoly.roots) :
    ‖z‖ ≤ 1 := by
  classical
  unfold universalResidueTripleRationalPointTraceMatrix at hz
  rw [Matrix.charpoly_one, Polynomial.roots_pow] at hz
  change z ∈ Fintype.card
    (CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t) •
      (Polynomial.X - Polynomial.C (1 : ℂ)).roots at hz
  rw [Polynomial.roots_X_sub_C] at hz
  simp only [Multiset.mem_nsmul, Multiset.mem_singleton] at hz
  rw [hz.2]
  norm_num

/-- Ring maps from a finite-type `ZMod q`-algebra to a finite
`ZMod q`-algebra form a finite type. -/
theorem finiteRingHom_of_zmodEssFiniteType
    (q : ℕ) {A B : Type*} [CommRing A] [CommRing B]
    [Algebra (ZMod q) A] [Algebra (ZMod q) B]
    [Algebra.EssFiniteType (ZMod q) A] [Finite B] : Finite (A →+* B) :=
  by
    let : Finite (A →ₐ[ZMod q] B) :=
      finiteAlgHom_of_essFiniteType
    exact Finite.of_injective (ringHomToZModAlgHom q A B)
      (ringHomToZModAlgHom_injective q A B)

/-- An affine finite-presentation scheme over a finite prime field has only
finitely many points over any finite extension field. -/
theorem affinePointFinite_of_finitePresentation
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [Finite F]
    (p : X ⟶ Spec (.of (ZMod q)))
    (hp : p.appTop.hom.FinitePresentation) :
    Finite (Spec (.of F) ⟶ X) := by
  let ιX : ZMod q →+* Γ(X, ⊤) := globalSectionsZModMap X q p
  let : Algebra (ZMod q) Γ(X, ⊤) := ιX.toAlgebra
  let ιF : ZMod q →+* F := ZMod.castHom (m := q) dvd_rfl F
  let : Algebra (ZMod q) F := ιF.toAlgebra
  have hγ : ((Scheme.ΓSpecIso (.of (ZMod q))).inv.hom).FinitePresentation :=
    RingHom.FinitePresentation.of_bijective
      (ConcreteCategory.bijective_of_isIso
        (Scheme.ΓSpecIso (.of (ZMod q))).inv)
  have hfp : ιX.FinitePresentation := hp.comp hγ
  let : Algebra.FiniteType (ZMod q) Γ(X, ⊤) :=
    RingHom.finiteType_algebraMap.mp
      (RingHom.FiniteType.of_finitePresentation hfp)
  let toRingHom : (Spec (.of F) ⟶ X) → (Γ(X, ⊤) →+* F) :=
    fun x => (Spec.preimage (x ≫ X.isoSpec.hom)).hom
  let : Finite (Γ(X, ⊤) →+* F) :=
    finiteRingHom_of_zmodEssFiniteType q
  apply Finite.of_injective toRingHom
  intro x y h
  apply (cancel_mono X.isoSpec.hom).mp
  rw [← Spec.map_preimage (x ≫ X.isoSpec.hom),
    ← Spec.map_preimage (y ≫ X.isoSpec.hom)]
  congr 1
  exact CommRingCat.hom_ext h

/-- Every prime-field valued point of an affine prime-field scheme is fixed
by its absolute Frobenius.  The proof is functorial and therefore also
covers the empty target scheme (where there are no such points). -/
theorem affinePoint_affineSchemeFrobeniusOver_fixed
    (X : Scheme) [IsAffine X] (q : ℕ) [Fact q.Prime]
    (p : X ⟶ Spec (.of (ZMod q)))
    (x : Spec (.of (ZMod q)) ⟶ X) :
    x ≫ affineSchemeFrobeniusOver X q p = x := by
  have h := affineSchemeFrobeniusOver_naturality x q (𝟙 _) p
  rw [affineSchemeFrobeniusOver_specZMod_eq_id, Category.id_comp] at h
  exact h.symm

noncomputable instance fullResidueUnitFiber_isAffine
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsAffine
      (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :=
  isAffine_fullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t

theorem affineSchemeFrobeniusOver_fullResidueUnitFiber_eq
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    affineSchemeFrobeniusOver
        (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t) =
      fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t := by
  apply pullback.hom_ext
  · change affineSchemeFrobeniusOver
          (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) q
          (fullResidueUnitFiberProjection
            (ZMod q) n m g hg hdeg hm hmn t) ≫
        fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t =
      fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t
    rw [affineSchemeFrobeniusOver_naturality
        (fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t)
        (rootSpaceProjection (ZMod q) n g),
      affineSchemeFrobeniusOver_rootSpace_eq,
      fullResidueUnitFiberFrobenius_toRootSpace]
  · change affineSchemeFrobeniusOver
          (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) q
          (fullResidueUnitFiberProjection
            (ZMod q) n m g hg hdeg hm hmn t) ≫
        fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t =
      fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t
    rw [affineSchemeFrobeniusOver_naturality
        (fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t) (𝟙 _),
      affineSchemeFrobeniusOver_specZMod_eq_id, Category.comp_id,
      fullResidueUnitFiberFrobenius_over]

/-- Every `F_q`-valued point of a full residue-unit fiber is a fixed point
of the fiber Frobenius.  This is the rational-point half of the fixed-point
identification used in Grothendieck--Lefschetz. -/
theorem fullResidueUnitFiberPoint_frobenius_fixed
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of (ZMod q)) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :
    x ≫ fullResidueUnitFiberFrobenius
      q n m g hg hdeg hm hmn t = x := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affinePoint_affineSchemeFrobeniusOver_fixed _ q _ x

/-- A geometric point of the full residue-unit fiber is fixed by Frobenius
if and only if it is the scalar extension of an `F_q`-rational point.  This
completes the fixed-point identification needed on the geometric side of
Grothendieck--Lefschetz. -/
theorem fullResidueUnitFiberGeometricPoint_frobenius_fixed_iff_descends
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :
    x ≫ fullResidueUnitFiberFrobenius
        q n m g hg hdeg hm hmn t = x ↔
      ∃ x₀ : Spec (.of (ZMod q)) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t,
        Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F)) ≫ x₀ = x := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affinePoint_frobenius_fixed_iff_descendsToZMod
    _ q F _ x

/-- The fixed geometric points of the full residue-unit fiber are precisely
its `F_q`-rational points. -/
noncomputable def fullResidueUnitFiberRationalPointEquivFixedGeometricPoint
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (Spec (.of (ZMod q)) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) ≃
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t = x} := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineFrobeniusFixedGeometricPointEquiv
    _ q F _

/-- Rational points of the full residue-unit fiber form a finite type. -/
noncomputable instance fullResidueUnitFiberRationalPointFinite
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite (Spec (.of (ZMod q)) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) := by
  exact affinePointFinite_of_finitePresentation _ q (ZMod q) _
    (finitePresentation_fullResidueUnitFiber_appTop
      (ZMod q) n m g hg hdeg hm hmn t)

/-- The Frobenius-fixed geometric point type is finite, even when the
ambient field itself is infinite. -/
noncomputable instance fullResidueUnitFiberFixedGeometricPointFinite
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberFrobenius
        q n m g hg hdeg hm hmn t = x} :=
  Finite.of_equiv
    (Spec (.of (ZMod q)) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberRationalPointEquivFixedGeometricPoint
      q n m F g hg hdeg hm hmn t)

/-- Consequently the rational-point count is literally the finite fixed
geometric-point count. -/
theorem fullResidueUnitFiber_rationalPoint_natCard_eq_fixedGeometricPoint
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (Spec (.of (ZMod q)) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) =
      Nat.card {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t = x} :=
  Nat.card_congr
    (fullResidueUnitFiberRationalPointEquivFixedGeometricPoint
      q n m F g hg hdeg hm hmn t)

theorem fullResidueUnitFiberFrobeniusBaseChangeIsHomeomorph
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    ∀ U : (FullResidueUnitFiber
        (ZMod q) n m g hg hdeg hm hmn t).ProEt,
      IsHomeomorph (pullback.fst U.hom
        (fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t)).base := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineSchemeFrobeniusOverBaseChangeIsHomeomorph _ q _

/-- Pullback by Frobenius on ordinary ell-adic cohomology of a full unit
fiber. -/
noncomputable def fullResidueUnitFiberFrobeniusCohomologyPullback
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t).EllAdicCohomology ell degree →+
      ProEt.BaseChangedEllAdicCohomology
        (fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t) ell degree :=
  ProEt.ellAdicCohomologyPullback
    (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t) ell degree

/-- The coefficient comparison on a full unit fiber is an additive
equivalence: the universal-homeomorphism theorem removes the
Frobenius-precomposed constant coefficient sheaf. -/
noncomputable def fullResidueUnitFiberFrobeniusCohomologyComparisonEquiv
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t).EllAdicCohomology ell degree ≃+
      ProEt.BaseChangedEllAdicCohomology
        (fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t) ell degree :=
  ProEt.ellAdicCohomologyComparisonEquivOfHomeomorph
    (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t) ell degree
    (fullResidueUnitFiberFrobeniusBaseChangeIsHomeomorph
      q n m g hg hdeg hm hmn t)

@[simp]
theorem fullResidueUnitFiberFrobeniusCohomologyComparisonEquiv_apply
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : (FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t).EllAdicCohomology ell degree) :
    fullResidueUnitFiberFrobeniusCohomologyComparisonEquiv
      q n m ell degree g hg hdeg hm hmn t x =
    fullResidueUnitFiberFrobeniusCohomologyPullback
      q n m ell degree g hg hdeg hm hmn t x := by
  rfl

/-- For any proper compactification of a full residue-unit fiber, Frobenius
pullback of the constant coefficient sheaf induces the corresponding
compact-support comparison equivalence.  Thus the eventual trace formula
may use the original constant sheaf after Frobenius pullback; this statement
does not assume that the fiber is nonempty. -/
noncomputable def fullResidueUnitFiberFrobeniusCompactSupportComparisonEquiv
    (q n m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar] :
    Scheme.ProEt.CompactlySupportedEllAdicCohomology
        j pbar ell degree ≃+
      Scheme.ProEt.BaseChangedCompactlySupportedEllAdicCohomology
        j (fullResidueUnitFiberFrobenius
          q n m g hg hdeg hm hmn t) ell degree :=
  Scheme.ProEt.compactlySupportedCohomologyComparisonEquivOfHomeomorph
    j pbar
    (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t)
    ell degree
    (fullResidueUnitFiberFrobeniusBaseChangeIsHomeomorph
      q n m g hg hdeg hm hmn t)

/-- Frobenius pullback on the small pro-étale site of the root-avoidance open. -/
noncomputable def rootFrobeniusProEtPullback
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    (RootSpace (ZMod q) n g).ProEt ⥤ (RootSpace (ZMod q) n g).ProEt :=
  ProEt.baseChange (rootFrobenius q n g)

theorem rootFrobeniusProEtPullback_isContinuous
    (q n : ℕ) [Fact q.Prime] (g : Polynomial (ZMod q)) :
    (rootFrobeniusProEtPullback q n g).IsContinuous
      (ProEt.topology (RootSpace (ZMod q) n g))
      (ProEt.topology (RootSpace (ZMod q) n g)) :=
  ProEt.baseChange_isContinuous (rootFrobenius q n g)

/-- The Frobenius-induced coefficient-sheaf map on the root-avoidance open. -/
noncomputable def rootFrobeniusCoefficientPullback
    (q n ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) :=
  ProEt.ellAdicCoefficientPullback (rootFrobenius q n g) ell

/-- Ordinary ell-adic cohomology of root space has its expected additive
group structure. -/
noncomputable instance rootEllAdicCohomologyAddCommGroup
    (q n ell degree : ℕ) [Fact ell.Prime] (g : Polynomial (ZMod q)) :
    AddCommGroup (RootEllAdicCohomology (ZMod q) n g ell degree) :=
  inferInstanceAs <| AddCommGroup
    ((RootSpace (ZMod q) n g).EllAdicCohomology ell degree)

/-- The induced map from root-space ell-adic cohomology to cohomology with
the Frobenius-precomposed coefficient sheaf. -/
noncomputable def rootFrobeniusCohomologyPullback
    (q n ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) :
    RootEllAdicCohomology (ZMod q) n g ell degree →+
      ProEt.BaseChangedEllAdicCohomology
        (rootFrobenius q n g) ell degree :=
  ProEt.ellAdicCohomologyPullback (rootFrobenius q n g) ell degree

end SawinGeometry

end

/-! ## Finite families of prime polynomials -/

namespace PrimePolynomials

/-- Monic irreducible polynomials of one prescribed degree over the prime
field `ZMod p`. -/
abbrev OfDegree (p d : ℕ) :=
  {f : Polynomial (ZMod p) // f.Monic ∧ Irreducible f ∧ f.natDegree = d}

@[simp]
theorem monic {p d : ℕ} (f : OfDegree p d) : (f : Polynomial (ZMod p)).Monic :=
  f.property.1

@[simp]
theorem irreducible {p d : ℕ} (f : OfDegree p d) :
    Irreducible (f : Polynomial (ZMod p)) :=
  f.property.2.1

@[simp]
theorem natDegree {p d : ℕ} (f : OfDegree p d) :
    (f : Polynomial (ZMod p)).natDegree = d :=
  f.property.2.2

theorem val_injective {p d : ℕ} :
    Function.Injective (fun f : OfDegree p d ↦ (f : Polynomial (ZMod p))) :=
  Subtype.val_injective

/-- A polynomial in `OfDegree p d` is determined by its `d` coefficients
strictly below the monic leading coefficient. -/
theorem coeffBelow_injective (p d : ℕ) :
    Function.Injective (fun f : OfDegree p d ↦
      fun j : Fin d ↦ (f : Polynomial (ZMod p)).coeff j) := by
  intro f g h
  apply Subtype.ext
  apply Polynomial.ext
  intro n
  by_cases hn : n < d
  · exact congrFun h ⟨n, hn⟩
  by_cases hnd : n = d
  · subst n
    have hf : (f : Polynomial (ZMod p)).coeff d = 1 := by
      simpa only [natDegree f] using (monic f).coeff_natDegree
    have hg : (g : Polynomial (ZMod p)).coeff d = 1 := by
      simpa only [natDegree g] using (monic g).coeff_natDegree
    rw [hf, hg]
  · have hdn : d < n := by omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn),
      Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa using hdn)]

instance finite (p d : ℕ) [NeZero p] : Finite (OfDegree p d) := by
  let : Fintype (Fin d → ZMod p) := inferInstance
  exact Finite.of_injective _ (coeffBelow_injective p d)

noncomputable instance fintype (p d : ℕ) [NeZero p] : Fintype (OfDegree p d) :=
  Fintype.ofFinite _

/-- Every positive degree occurs. -/
theorem nonempty (p d : ℕ) [Fact p.Prime] (hd : d ≠ 0) :
    Nonempty (OfDegree p d) := by
  obtain ⟨f, hmonic, hirr, hdeg⟩ :=
    PolynomialInfrastructure.exists_monic_irreducible_natDegree p d hd
  exact ⟨⟨f, hmonic, hirr, hdeg⟩⟩

/-- Prime-polynomial families of even positive degree are nonempty, as used
at every level of Pilatte's construction. -/
theorem nonempty_even (p d : ℕ) [Fact p.Prime] (hd : d ≠ 0) :
    Nonempty (OfDegree p (2 * d)) :=
  nonempty p (2 * d) (by omega)

end PrimePolynomials

namespace Construction

/-- The exact integer form of Pilatte's degree window
`(7/20) k² ≤ 2i < (7/20) (k+1)²`. -/
def degreeIndices (k : ℕ) : Finset ℕ :=
  (Finset.range (7 * (k + 1) ^ 2 + 1)).filter fun i ↦
    7 * k ^ 2 ≤ 40 * i ∧ 40 * i < 7 * (k + 1) ^ 2

@[simp]
theorem mem_degreeIndices {k i : ℕ} :
    i ∈ degreeIndices k ↔
      i < 7 * (k + 1) ^ 2 + 1 ∧
      7 * k ^ 2 ≤ 40 * i ∧ 40 * i < 7 * (k + 1) ^ 2 := by
  simp [degreeIndices]

/-- A canonical integer in the degree window. -/
def canonicalDegreeIndex (k : ℕ) : ℕ :=
  (7 * k ^ 2) / 40 + 1

theorem canonicalDegreeIndex_mem {k : ℕ} (hk : 3 ≤ k) :
    canonicalDegreeIndex k ∈ degreeIndices k := by
  let a := 7 * k ^ 2
  let i := a / 40 + 1
  have hrem : a % 40 < 40 := Nat.mod_lt _ (by norm_num)
  have hdecomp : a % 40 + 40 * (a / 40) = a := Nat.mod_add_div a 40
  have hlower : a ≤ 40 * i := by
    dsimp only [i]
    omega
  have hnear : 40 * i ≤ a + 40 := by
    dsimp only [i]
    omega
  have hgap : a + 40 < 7 * (k + 1) ^ 2 := by
    dsimp only [a]
    nlinarith
  have hupper : 40 * i < 7 * (k + 1) ^ 2 := hnear.trans_lt hgap
  have hirange : i < 7 * (k + 1) ^ 2 + 1 := by omega
  simpa only [canonicalDegreeIndex, a, i, mem_degreeIndices] using
    And.intro hirange (And.intro hlower hupper)

/-- The canonical degree index satisfies the strict disjoint-trial degree
condition used after canceling a shared prime factor. -/
theorem four_mul_canonicalDegreeIndex_lt_sq {k : ℕ} (hk : 4 ≤ k) :
    4 * canonicalDegreeIndex k < k ^ 2 := by
  let a := 7 * k ^ 2
  have hdecomp : a % 40 + 40 * (a / 40) = a := Nat.mod_add_div a 40
  have hdiv : 40 * (a / 40) ≤ a := by omega
  unfold canonicalDegreeIndex
  change 4 * (a / 40 + 1) < k ^ 2
  dsimp only [a] at hdiv ⊢
  nlinarith

/-- For the three equal prime degrees used in Pilatte's construction, the
modulus degree is at most `20/21` of the total degree.  This is the exact
integer form of the parameter `θ = 20/21` in Sawin's theorem. -/
theorem modulus_degree_in_sawin_range {k : ℕ} (hk : 3 ≤ k) :
    21 * k ^ 2 ≤ 20 * (6 * canonicalDegreeIndex k) := by
  have hi := (mem_degreeIndices.mp (canonicalDegreeIndex_mem hk)).2.1
  omega

/-- The degree left after imposing the progression has a uniform positive
margin: it is at least `k²/20`. -/
theorem sawin_degree_excess {k : ℕ} (hk : 3 ≤ k) :
    k ^ 2 ≤ 20 * (6 * canonicalDegreeIndex k - k ^ 2) := by
  have hrange := modulus_degree_in_sawin_range hk
  have hle : k ^ 2 ≤ 6 * canonicalDegreeIndex k := by omega
  omega

theorem degreeIndices_nonempty {k : ℕ} (hk : 3 ≤ k) :
    (degreeIndices k).Nonempty :=
  ⟨canonicalDegreeIndex k, canonicalDegreeIndex_mem hk⟩

/-- The finite family `F_k`: an index in the degree window together with a
monic irreducible polynomial of the corresponding even degree. -/
def LevelPolynomial (p k : ℕ) :=
  Σ i : ↑(degreeIndices k), PrimePolynomials.OfDegree p (2 * (i : ℕ))

instance levelPolynomialFinite (p k : ℕ) [NeZero p] :
    Finite (LevelPolynomial p k) := by
  unfold LevelPolynomial
  infer_instance

noncomputable instance levelPolynomialFintype (p k : ℕ) [NeZero p] :
    Fintype (LevelPolynomial p k) :=
  Fintype.ofFinite _

/-- The polynomial underlying a member of a construction level. -/
def LevelPolynomial.val {p k : ℕ} (f : LevelPolynomial p k) :
    Polynomial (ZMod p) := f.2

@[simp]
theorem LevelPolynomial.monic {p k : ℕ} (f : LevelPolynomial p k) :
    f.val.Monic :=
  PrimePolynomials.monic f.2

@[simp]
theorem LevelPolynomial.irreducible {p k : ℕ} (f : LevelPolynomial p k) :
    Irreducible f.val :=
  PrimePolynomials.irreducible f.2

@[simp]
theorem LevelPolynomial.natDegree {p k : ℕ} (f : LevelPolynomial p k) :
    f.val.natDegree = 2 * (f.1 : ℕ) :=
  PrimePolynomials.natDegree f.2

theorem LevelPolynomial.val_injective {p k : ℕ} :
    Function.Injective (LevelPolynomial.val : LevelPolynomial p k → Polynomial (ZMod p)) := by
  rintro ⟨i, f⟩ ⟨j, g⟩ h
  have hdeg := congrArg Polynomial.natDegree h
  simp only [LevelPolynomial.val, PrimePolynomials.natDegree] at hdeg
  have hij : i = j := by
    apply Subtype.ext
    omega
  subst j
  congr
  exact Subtype.ext h

/-- Every construction level from `3` onward contains at least one prime
polynomial. -/
theorem levelPolynomial_nonempty (p k : ℕ) [Fact p.Prime] (hk : 3 ≤ k) :
    Nonempty (LevelPolynomial p k) := by
  let i := canonicalDegreeIndex k
  have hi : i ∈ degreeIndices k := canonicalDegreeIndex_mem hk
  have hi0 : i ≠ 0 := by
    dsimp only [i, canonicalDegreeIndex]
    omega
  let hpoly := PrimePolynomials.nonempty_even p i hi0
  exact hpoly.map fun f ↦ ⟨⟨i, hi⟩, f⟩

end Construction

/-! ## Finite-field discrete logarithms -/

namespace CyclicLog

variable {G : Type*} [Group G] [IsCyclic G]

/-- The logarithm obtained by transporting a cyclic group through Mathlib's
multiplicative equivalence with `ZMod (Nat.card G)`.  The choice of generator
is internal to that equivalence. -/
noncomputable def log (x : G) : ZMod (Nat.card G) :=
  Multiplicative.toAdd ((zmodCyclicMulEquiv (G := G) inferInstance).symm x)

@[simp]
theorem log_one : log (1 : G) = 0 := by
  change Multiplicative.toAdd
    ((zmodCyclicMulEquiv (G := G) inferInstance).symm 1) = 0
  rw [map_one]
  rfl

/-- Multiplication becomes addition of discrete logarithms. -/
theorem log_mul (x y : G) : log (x * y) = log x + log y := by
  change Multiplicative.toAdd
    ((zmodCyclicMulEquiv (G := G) inferInstance).symm (x * y)) = _
  rw [map_mul]
  rfl

/-- The discrete logarithm loses no information. -/
theorem log_injective : Function.Injective (log (G := G)) := by
  intro x y h
  apply (zmodCyclicMulEquiv (G := G) inferInstance).symm.injective
  simpa [log] using h

/-- The unit with a prescribed discrete logarithm. -/
noncomputable def unitOfLog (r : ZMod (Nat.card G)) : G :=
  (zmodCyclicMulEquiv (G := G) inferInstance) (Multiplicative.ofAdd r)

@[simp]
theorem log_unitOfLog (r : ZMod (Nat.card G)) :
    log (unitOfLog (G := G) r) = r := by
  simp [log, unitOfLog]

end CyclicLog

namespace FiniteFieldEncoding

open PolynomialInfrastructure PrimePolynomials

variable (p : ℕ) [Fact p.Prime]

/-- The residue field at Pilatte's zero-indexed auxiliary irreducible
`g_i`, whose degree is `2i+1`. -/
noncomputable abbrev ResidueField (i : ℕ) :=
  AdjoinRoot (auxiliaryIrreducible p i)

noncomputable instance auxiliaryIrreducibleFact (i : ℕ) :
    Fact (Irreducible (auxiliaryIrreducible p i)) :=
  ⟨auxiliaryIrreducible_irreducible p i⟩

noncomputable instance residueFieldModuleFinite (i : ℕ) :
    Module.Finite (ZMod p) (ResidueField p i) :=
  (auxiliaryIrreducible_monic p i).finite_adjoinRoot

noncomputable instance residueFieldFinite (i : ℕ) :
    Finite (ResidueField p i) :=
  Module.finite_of_finite (ZMod p)

/-- The quotient by `g_i` has the expected `p^(2i+1)` elements. -/
theorem residueField_natCard (i : ℕ) :
    Nat.card (ResidueField p i) = p ^ (2 * i + 1) := by
  have hfin : Module.finrank (ZMod p) (ResidueField p i) =
      (auxiliaryIrreducible p i).natDegree := by
    exact (AdjoinRoot.powerBasis' (auxiliaryIrreducible_monic p i)).finrank
  rw [Module.natCard_eq_pow_finrank (K := ZMod p), hfin,
    auxiliaryIrreducible_natDegree]
  simpa only [Nat.card_eq_fintype_card, ZMod.card]

/-- Hence the multiplicative group has exactly `p^(2i+1)-1` elements,
which is the odd-position radix in Pilatte's mixed-base construction. -/
theorem residueField_units_natCard (i : ℕ) :
    Nat.card (ResidueField p i)ˣ = p ^ (2 * i + 1) - 1 := by
  rw [Nat.card_units, residueField_natCard]

/-- The principal ideal generated by the `i`th auxiliary irreducible. -/
noncomputable abbrev auxiliaryIdeal (i : ℕ) : Ideal (Polynomial (ZMod p)) :=
  Ideal.span {auxiliaryIrreducible p i}

theorem auxiliaryIdeals_pairwise (k : ℕ) :
    Pairwise (fun i j : Fin k =>
      IsCoprime (auxiliaryIdeal p i) (auxiliaryIdeal p j)) := by
  intro i j hij
  rw [auxiliaryIdeal, auxiliaryIdeal, Ideal.isCoprime_span_singleton_iff]
  exact auxiliaryIrreducible_coprime p (fun h => hij (Fin.ext h))

theorem auxiliaryIdeals_iInf (k : ℕ) :
    (⨅ i : Fin k, auxiliaryIdeal p i) =
      Ideal.span {modulusProduct p k} := by
  rw [show (⨅ i : Fin k, auxiliaryIdeal p i) =
      Ideal.span {∏ i : Fin k, auxiliaryIrreducible p i} by
    exact Ideal.iInf_span_singleton fun i j hij =>
      auxiliaryIrreducible_coprime p (fun h => hij (Fin.ext h))]
  rw [Fin.prod_univ_eq_prod_range]
  rfl

/-- Chinese remaindering identifies the quotient by the full auxiliary
modulus with the product of its residue fields. -/
noncomputable def modulusQuotientEquiv (k : ℕ) :
    (Polynomial (ZMod p) ⧸ Ideal.span {modulusProduct p k}) ≃+*
    (∀ i : Fin k, Polynomial (ZMod p) ⧸ auxiliaryIdeal p i)
  := (Ideal.quotientEquivAlgOfEq (ZMod p)
      (auxiliaryIdeals_iInf p k).symm).toRingEquiv.trans
    (Ideal.quotientInfRingEquivPiQuotient
      (fun i : Fin k => auxiliaryIdeal p i) (auxiliaryIdeals_pairwise p k))

/-- The Chinese-remainder equivalence sends the class of a polynomial to
its classes modulo the individual auxiliary irreducibles. -/
@[simp]
theorem modulusQuotientEquiv_mk_apply (k : ℕ)
    (a : Polynomial (ZMod p)) (i : Fin k) :
    (modulusQuotientEquiv p k
      (AdjoinRoot.mk (modulusProduct p k) a)) i =
        AdjoinRoot.mk (auxiliaryIrreducible p i) a := by
  change ((modulusQuotientEquiv p k :
      (Polynomial (ZMod p) ⧸ Ideal.span {modulusProduct p k}) ≃+*
        (∀ i : Fin k, Polynomial (ZMod p) ⧸ auxiliaryIdeal p i))
      (Ideal.Quotient.mk _ a)) i = Ideal.Quotient.mk _ a
  unfold modulusQuotientEquiv
  rw [RingEquiv.trans_apply]
  have hfirst :
      (Ideal.quotientEquivAlgOfEq (ZMod p)
          (auxiliaryIdeals_iInf p k).symm).toRingEquiv
          (Ideal.Quotient.mk (Ideal.span {modulusProduct p k}) a) =
        Ideal.Quotient.mk (⨅ i : Fin k, auxiliaryIdeal p i) a := by
    exact Ideal.quotientEquivAlgOfEq_mk (ZMod p)
      (auxiliaryIdeals_iInf p k).symm a
  rw [hfirst]
  change (Ideal.quotientInfToPiQuotient
      (fun j : Fin k => auxiliaryIdeal p j)
      (Ideal.Quotient.mk (⨅ j : Fin k, auxiliaryIdeal p j) a)) i = _
  exact Ideal.quotientInfToPiQuotient_mk'
    (fun j : Fin k => auxiliaryIdeal p j) a i

/-- Consequently the unit group of the quotient has exactly the Euler
product used as `progressionTotient`. -/
theorem modulusQuotient_units_natCard (k : ℕ) :
    Nat.card (AdjoinRoot (modulusProduct p k))ˣ =
      ∏ i ∈ Finset.range k, (p ^ (2 * i + 1) - 1) := by
  let e : (AdjoinRoot (modulusProduct p k))ˣ ≃*
      (∀ i : Fin k, (ResidueField p i)ˣ) :=
    (Units.mapEquiv (modulusQuotientEquiv p k).toMulEquiv).trans
      MulEquiv.piUnits
  rw [Nat.card_congr e.toEquiv, Nat.card_pi]
  simp_rw [residueField_units_natCard]
  exact Fin.prod_univ_eq_prod_range (fun i => p ^ (2 * i + 1) - 1) k

/-- A class modulo the squarefree auxiliary modulus is a unit exactly when
the represented polynomial is nonzero modulo every auxiliary factor. -/
theorem isUnit_modulusQuotient_mk_iff_fin (k : ℕ)
    (a : Polynomial (ZMod p)) :
    IsUnit (AdjoinRoot.mk (modulusProduct p k) a) ↔
      ∀ i : Fin k, ¬ auxiliaryIrreducible p i ∣ a := by
  constructor
  · intro h
    have hmap : IsUnit (modulusQuotientEquiv p k
        (AdjoinRoot.mk (modulusProduct p k) a)) :=
      h.map (modulusQuotientEquiv p k)
    rw [Pi.isUnit_iff] at hmap
    intro i
    have hi := hmap i
    rw [modulusQuotientEquiv_mk_apply] at hi
    change IsUnit (AdjoinRoot.mk (auxiliaryIrreducible p i) a) at hi
    rw [isUnit_iff_ne_zero] at hi
    exact fun hdiv => hi (AdjoinRoot.mk_eq_zero.mpr hdiv)
  · intro h
    have hmap : IsUnit (modulusQuotientEquiv p k
        (AdjoinRoot.mk (modulusProduct p k) a)) := by
      rw [Pi.isUnit_iff]
      intro i
      rw [modulusQuotientEquiv_mk_apply]
      change IsUnit (AdjoinRoot.mk (auxiliaryIrreducible p i) a)
      rw [isUnit_iff_ne_zero]
      exact fun hzero => h i (AdjoinRoot.mk_eq_zero.mp hzero)
    have hback : IsUnit ((modulusQuotientEquiv p k).symm
        (modulusQuotientEquiv p k
          (AdjoinRoot.mk (modulusProduct p k) a))) :=
      IsUnit.map (modulusQuotientEquiv p k).symm.toMonoidHom hmap
    have heq : (modulusQuotientEquiv p k).symm
        (modulusQuotientEquiv p k
          (AdjoinRoot.mk (modulusProduct p k) a)) =
        AdjoinRoot.mk (modulusProduct p k) a :=
      (modulusQuotientEquiv p k).symm_apply_apply _
    rw [heq] at hback
    exact hback

/-- Natural-index form of `isUnit_modulusQuotient_mk_iff_fin`, matching the
coprimality hypothesis in the progression estimate. -/
theorem isUnit_modulusQuotient_mk_iff (k : ℕ)
    (a : Polynomial (ZMod p)) :
    IsUnit (AdjoinRoot.mk (modulusProduct p k) a) ↔
      ∀ i < k, ¬ auxiliaryIrreducible p i ∣ a := by
  rw [isUnit_modulusQuotient_mk_iff_fin]
  constructor
  · intro h i hi
    exact h ⟨i, hi⟩
  · intro h i
    exact h i i.2

/-- The `ZMod`-valued discrete logarithm in the residue field. -/
noncomputable def logarithmZMod (i : ℕ) (x : (ResidueField p i)ˣ) :
    ZMod (Nat.card (ResidueField p i)ˣ) :=
  CyclicLog.log x

theorem logarithmZMod_mul (i : ℕ) (x y : (ResidueField p i)ˣ) :
    logarithmZMod p i (x * y) =
      logarithmZMod p i x + logarithmZMod p i y :=
  CyclicLog.log_mul x y

/-- The normalized natural representative of the logarithm; this is the
actual digit placed in the generalized-base expansion. -/
noncomputable def logarithm (i : ℕ) (x : (ResidueField p i)ˣ) : ℕ :=
  (logarithmZMod p i x).val

theorem logarithm_lt_radix (i : ℕ) (x : (ResidueField p i)ˣ) :
    logarithm p i x < p ^ (2 * i + 1) - 1 := by
  rw [← residueField_units_natCard p i]
  exact (logarithmZMod p i x).val_lt

/-- A residue-field unit whose discrete logarithm is the reduction of the
specified natural digit. -/
noncomputable def residueUnitOfDigit (i x : ℕ) : (ResidueField p i)ˣ :=
  CyclicLog.unitOfLog
    (x : ZMod (Nat.card (ResidueField p i)ˣ))

theorem logarithm_residueUnitOfDigit (i x : ℕ)
    (hx : x < p ^ (2 * i + 1) - 1) :
    logarithm p i (residueUnitOfDigit p i x) = x := by
  unfold logarithm logarithmZMod residueUnitOfDigit
  rw [CyclicLog.log_unitOfLog]
  apply ZMod.val_natCast_of_lt
  simpa only [residueField_units_natCard] using hx

/-- Equality of two products gives equality of the corresponding sums of
normalized logarithms modulo the odd-position radix. -/
theorem logarithm_sum_modEq_of_mul_eq (i : ℕ)
    {x₁ x₂ x₃ x₄ : (ResidueField p i)ˣ}
    (h : x₁ * x₂ = x₃ * x₄) :
    Nat.ModEq (p ^ (2 * i + 1) - 1)
      (logarithm p i x₁ + logarithm p i x₂)
      (logarithm p i x₃ + logarithm p i x₄) := by
  rw [← residueField_units_natCard p i]
  rw [← ZMod.natCast_eq_natCast_iff]
  simp only [Nat.cast_add, logarithm, ZMod.natCast_zmod_val]
  rw [← logarithmZMod_mul, ← logarithmZMod_mul, h]

/-- Equality of a product of three residue-field units with one unit gives
the corresponding congruence between the sum of three normalized discrete
logarithms and the fourth logarithm. -/
theorem logarithm_sum_three_modEq_of_mul_eq (i : ℕ)
    {x₁ x₂ x₃ y : (ResidueField p i)ˣ}
    (h : x₁ * x₂ * x₃ = y) :
    Nat.ModEq (p ^ (2 * i + 1) - 1)
      (logarithm p i x₁ + logarithm p i x₂ + logarithm p i x₃)
      (logarithm p i y) := by
  rw [← residueField_units_natCard p i]
  rw [← ZMod.natCast_eq_natCast_iff]
  simp only [Nat.cast_add, logarithm, ZMod.natCast_zmod_val]
  rw [← logarithmZMod_mul, ← logarithmZMod_mul, h]

/-- Conversely, a congruence between sums of normalized logarithms recovers
equality of the two products in the cyclic group. -/
theorem mul_eq_of_logarithm_sum_modEq (i : ℕ)
    {x₁ x₂ x₃ x₄ : (ResidueField p i)ˣ}
    (h : Nat.ModEq (p ^ (2 * i + 1) - 1)
      (logarithm p i x₁ + logarithm p i x₂)
      (logarithm p i x₃ + logarithm p i x₄)) :
    x₁ * x₂ = x₃ * x₄ := by
  rw [← residueField_units_natCard p i] at h
  have hz : logarithmZMod p i x₁ + logarithmZMod p i x₂ =
      logarithmZMod p i x₃ + logarithmZMod p i x₄ := by
    have hz' :
        ((logarithm p i x₁ + logarithm p i x₂ : ℕ) :
            ZMod (Nat.card (ResidueField p i)ˣ)) =
          ((logarithm p i x₃ + logarithm p i x₄ : ℕ) :
            ZMod (Nat.card (ResidueField p i)ˣ)) := by
      rw [ZMod.natCast_eq_natCast_iff]
      exact h
    simpa only [Nat.cast_add, logarithm, ZMod.natCast_zmod_val] using hz'
  apply CyclicLog.log_injective
  simpa only [logarithmZMod, CyclicLog.log_mul] using hz

/-- A polynomial determines a residue-field unit exactly when it is not
divisible by the defining irreducible.  Unlike the degree-bounded helper
below, this version applies to Pilatte's higher-degree input polynomials. -/
noncomputable def polynomialUnitOfNotDvd (i : ℕ) (f : Polynomial (ZMod p))
    (hf : ¬ auxiliaryIrreducible p i ∣ f) : (ResidueField p i)ˣ :=
  Units.mk0 (AdjoinRoot.mk (auxiliaryIrreducible p i) f)
    (AdjoinRoot.mk_eq_zero.not.mpr hf)

theorem polynomialUnitOfNotDvd_mul_coe (i : ℕ) (f h : Polynomial (ZMod p))
    (hf : ¬ auxiliaryIrreducible p i ∣ f)
    (hh : ¬ auxiliaryIrreducible p i ∣ h) :
    ↑(polynomialUnitOfNotDvd p i f hf * polynomialUnitOfNotDvd p i h hh) =
      AdjoinRoot.mk (auxiliaryIrreducible p i) (f * h) := by
  simp [polynomialUnitOfNotDvd]

/-- Polynomial Chinese remaindering realizes an arbitrary normalized list
of discrete-log digits simultaneously.  The resulting residue is a unit at
every auxiliary factor. -/
theorem exists_polynomial_with_logarithms (k : ℕ) (x : Fin k → ℕ)
    (hx : ∀ i : Fin k, x i < p ^ (2 * (i : ℕ) + 1) - 1) :
    ∃ a : Polynomial (ZMod p),
      ∃ ha : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ a,
        ∀ (i : ℕ) (hi : i < k),
          logarithm p i (polynomialUnitOfNotDvd p i a (ha i hi)) =
            x ⟨i, hi⟩ := by
  let I : Fin k → Ideal (Polynomial (ZMod p)) := fun i =>
    Ideal.span {auxiliaryIrreducible p i}
  have hI : Pairwise (fun i j : Fin k => IsCoprime (I i) (I j)) := by
    intro i j hij
    rw [Ideal.isCoprime_span_singleton_iff]
    exact auxiliaryIrreducible_coprime p (fun hval => hij (Fin.ext hval))
  let u : ∀ i : Fin k, (ResidueField p i)ˣ := fun i =>
    residueUnitOfDigit p i (x i)
  choose r hr using fun i : Fin k => AdjoinRoot.mk_surjective (u i).val
  obtain ⟨a, haIdeal⟩ := Ideal.exists_forall_sub_mem_ideal hI r
  have hmk (i : Fin k) :
      AdjoinRoot.mk (auxiliaryIrreducible p i) a =
        (u i).val := by
    calc
      AdjoinRoot.mk (auxiliaryIrreducible p i) a =
          AdjoinRoot.mk (auxiliaryIrreducible p i) (r i) :=
        AdjoinRoot.mk_eq_mk.mpr
          (Ideal.mem_span_singleton.mp (by simpa only [I] using haIdeal i))
      _ = (u i).val := hr i
  have ha : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ a := by
    intro i hi hdvd
    let j : Fin k := ⟨i, hi⟩
    have hz : AdjoinRoot.mk (auxiliaryIrreducible p i) a = 0 :=
      AdjoinRoot.mk_eq_zero.mpr hdvd
    have hu : (u j : ResidueField p i) ≠ 0 := Units.ne_zero _
    apply hu
    rw [← hmk j]
    exact hz
  refine ⟨a, ha, ?_⟩
  intro i hi
  let j : Fin k := ⟨i, hi⟩
  have heq : polynomialUnitOfNotDvd p i a (ha i hi) = u j := by
    apply Units.ext
    simpa only [polynomialUnitOfNotDvd, Units.val_mk0] using hmk j
  rw [heq]
  exact logarithm_residueUnitOfDigit p i (x j) (hx j)

/-- Polynomial congruence of a threefold product with a unit residue gives
the exact three-logarithm congruence used in the representation family. -/
theorem logarithm_sum_three_modEq_of_product_sub_dvd (i : ℕ)
    {f₁ f₂ f₃ a : Polynomial (ZMod p)}
    (h₁ : ¬ auxiliaryIrreducible p i ∣ f₁)
    (h₂ : ¬ auxiliaryIrreducible p i ∣ f₂)
    (h₃ : ¬ auxiliaryIrreducible p i ∣ f₃)
    (ha : ¬ auxiliaryIrreducible p i ∣ a)
    (hdvd : auxiliaryIrreducible p i ∣ f₁ * f₂ * f₃ - a) :
    Nat.ModEq (p ^ (2 * i + 1) - 1)
      (logarithm p i (polynomialUnitOfNotDvd p i f₁ h₁) +
        logarithm p i (polynomialUnitOfNotDvd p i f₂ h₂) +
        logarithm p i (polynomialUnitOfNotDvd p i f₃ h₃))
      (logarithm p i (polynomialUnitOfNotDvd p i a ha)) := by
  apply logarithm_sum_three_modEq_of_mul_eq p i
  apply Units.ext
  simp only [polynomialUnitOfNotDvd, Units.val_mul, Units.val_mk0]
  exact AdjoinRoot.mk_eq_mk.mpr hdvd

/-- An irreducible of even degree cannot be divisible by the odd-degree
auxiliary irreducible `g_i`. -/
theorem auxiliaryIrreducible_not_dvd_even_irreducible (i : ℕ)
    {f : Polynomial (ZMod p)} {d : ℕ} (hf : Irreducible f)
    (hdeg : f.natDegree = 2 * d) : ¬ auxiliaryIrreducible p i ∣ f := by
  intro hdvd
  have hassoc := (auxiliaryIrreducible_irreducible p i).associated_of_dvd hf hdvd
  have hdegrees : (auxiliaryIrreducible p i).natDegree = f.natDegree :=
    Polynomial.natDegree_eq_of_degree_eq
      (Polynomial.degree_eq_degree_of_associated hassoc)
  rw [auxiliaryIrreducible_natDegree, hdeg] at hdegrees
  omega

/-- The actual odd-position digit attached to a monic irreducible of even
degree.  Odd/even degree parity supplies the nonzero residue automatically. -/
noncomputable def primePolynomialLogarithm (i : ℕ) {d : ℕ}
    (f : PrimePolynomials.OfDegree p (2 * d)) : ℕ :=
  logarithm p i (polynomialUnitOfNotDvd p i f
    (auxiliaryIrreducible_not_dvd_even_irreducible p i
      (PrimePolynomials.irreducible f) (PrimePolynomials.natDegree f)))

theorem primePolynomialLogarithm_lt_radix (i : ℕ) {d : ℕ}
    (f : PrimePolynomials.OfDegree p (2 * d)) :
    primePolynomialLogarithm p i f < p ^ (2 * i + 1) - 1 :=
  logarithm_lt_radix p i _

/-- Equality of one prime-polynomial log coordinate is exactly congruence of
the two polynomials modulo the corresponding auxiliary irreducible. -/
theorem auxiliaryIrreducible_dvd_sub_of_primePolynomialLogarithm_eq
    (i : ℕ) {d₁ d₂ : ℕ}
    (f : PrimePolynomials.OfDegree p (2 * d₁))
    (g : PrimePolynomials.OfDegree p (2 * d₂))
    (hlog : primePolynomialLogarithm p i f =
      primePolynomialLogarithm p i g) :
    auxiliaryIrreducible p i ∣
      (f : Polynomial (ZMod p)) - (g : Polynomial (ZMod p)) := by
  let hf := auxiliaryIrreducible_not_dvd_even_irreducible p i
    (PrimePolynomials.irreducible f) (PrimePolynomials.natDegree f)
  let hg := auxiliaryIrreducible_not_dvd_even_irreducible p i
    (PrimePolynomials.irreducible g) (PrimePolynomials.natDegree g)
  let uf := polynomialUnitOfNotDvd p i f hf
  let ug := polynomialUnitOfNotDvd p i g hg
  have hlog' : logarithm p i uf = logarithm p i ug := by
    exact hlog
  have hz : logarithmZMod p i uf = logarithmZMod p i ug := by
    rw [← ZMod.natCast_zmod_val (logarithmZMod p i uf),
      ← ZMod.natCast_zmod_val (logarithmZMod p i ug)]
    exact congrArg (fun n : ℕ ↦
      (n : ZMod (Nat.card (ResidueField p i)ˣ))) hlog'
  have hu : uf = ug := CyclicLog.log_injective hz
  have hmk := congrArg (fun u : (ResidueField p i)ˣ ↦ (u : ResidueField p i)) hu
  exact AdjoinRoot.mk_eq_mk.mp hmk

/-- Equality of the first `k` prime-polynomial log coordinates aggregates to
congruence modulo the full product of the first `k` auxiliary irreducibles. -/
theorem modulusProduct_dvd_sub_of_primePolynomialLogarithms
    (k : ℕ) {d₁ d₂ : ℕ}
    (f : PrimePolynomials.OfDegree p (2 * d₁))
    (g : PrimePolynomials.OfDegree p (2 * d₂))
    (hlog : ∀ i < k, primePolynomialLogarithm p i f =
      primePolynomialLogarithm p i g) :
    modulusProduct p k ∣
      (f : Polynomial (ZMod p)) - (g : Polynomial (ZMod p)) := by
  apply modulusProduct_dvd
  intro i hi
  exact auxiliaryIrreducible_dvd_sub_of_primePolynomialLogarithm_eq p i f g
    (hlog i hi)

theorem primePolynomials_eq_of_logarithms_of_natDegree_lt
    (k : ℕ) {d₁ d₂ : ℕ}
    (f : PrimePolynomials.OfDegree p (2 * d₁))
    (g : PrimePolynomials.OfDegree p (2 * d₂))
    (hlog : ∀ i < k, primePolynomialLogarithm p i f =
      primePolynomialLogarithm p i g)
    (hdeg : ((f : Polynomial (ZMod p)) - (g : Polynomial (ZMod p))).natDegree <
      k ^ 2) :
    (f : Polynomial (ZMod p)) = (g : Polynomial (ZMod p)) := by
  apply PolynomialInfrastructure.eq_of_dvd_sub_of_natDegree_lt
    (modulusProduct_dvd_sub_of_primePolynomialLogarithms p k f g hlog)
  simpa only [modulusProduct_natDegree] using hdeg

/-- Log-digit congruence for four polynomial residues implies the polynomial
product congruence used in the Chinese-remainder step of the Sidon proof. -/
theorem auxiliaryIrreducible_dvd_product_sub_of_logarithm_modEq (i : ℕ)
    {f₁ f₂ f₃ f₄ : Polynomial (ZMod p)}
    (h₁ : ¬ auxiliaryIrreducible p i ∣ f₁)
    (h₂ : ¬ auxiliaryIrreducible p i ∣ f₂)
    (h₃ : ¬ auxiliaryIrreducible p i ∣ f₃)
    (h₄ : ¬ auxiliaryIrreducible p i ∣ f₄)
    (hlog : Nat.ModEq (p ^ (2 * i + 1) - 1)
      (logarithm p i (polynomialUnitOfNotDvd p i f₁ h₁) +
        logarithm p i (polynomialUnitOfNotDvd p i f₂ h₂))
      (logarithm p i (polynomialUnitOfNotDvd p i f₃ h₃) +
        logarithm p i (polynomialUnitOfNotDvd p i f₄ h₄))) :
    auxiliaryIrreducible p i ∣ f₁ * f₂ - f₃ * f₄ := by
  have hu := mul_eq_of_logarithm_sum_modEq p i hlog
  have hmk := congrArg (fun u : (ResidueField p i)ˣ ↦ (u : ResidueField p i)) hu
  simp only [polynomialUnitOfNotDvd_mul_coe] at hmk
  exact AdjoinRoot.mk_eq_mk.mp hmk

/-- A nonzero polynomial of degree below `g_i` determines a unit in the
residue field. -/
noncomputable def polynomialUnit (i : ℕ) (f : Polynomial (ZMod p))
    (hf₀ : f ≠ 0) (hfdeg : f.natDegree < (auxiliaryIrreducible p i).natDegree) :
    (ResidueField p i)ˣ :=
  Units.mk0 (AdjoinRoot.mk (auxiliaryIrreducible p i) f)
    (AdjoinRoot.mk_ne_zero_of_natDegree_lt
      (auxiliaryIrreducible_monic p i) hf₀ hfdeg)

theorem polynomialUnit_mul_coe (i : ℕ) (f h : Polynomial (ZMod p))
    (hf₀ : f ≠ 0) (hh₀ : h ≠ 0)
    (hfdeg : f.natDegree < (auxiliaryIrreducible p i).natDegree)
    (hhdeg : h.natDegree < (auxiliaryIrreducible p i).natDegree) :
    ↑(polynomialUnit p i f hf₀ hfdeg * polynomialUnit p i h hh₀ hhdeg) =
      AdjoinRoot.mk (auxiliaryIrreducible p i) (f * h) := by
  simp [polynomialUnit]

/-- A polynomial congruence modulo `g_i` becomes equality of the associated
products in the residue-field unit group. -/
theorem polynomialUnit_mul_eq_of_dvd_sub (i : ℕ)
    {f₁ f₂ f₃ f₄ : Polynomial (ZMod p)}
    (h₁₀ : f₁ ≠ 0) (h₂₀ : f₂ ≠ 0) (h₃₀ : f₃ ≠ 0) (h₄₀ : f₄ ≠ 0)
    (h₁d : f₁.natDegree < (auxiliaryIrreducible p i).natDegree)
    (h₂d : f₂.natDegree < (auxiliaryIrreducible p i).natDegree)
    (h₃d : f₃.natDegree < (auxiliaryIrreducible p i).natDegree)
    (h₄d : f₄.natDegree < (auxiliaryIrreducible p i).natDegree)
    (hdvd : auxiliaryIrreducible p i ∣ f₁ * f₂ - f₃ * f₄) :
    polynomialUnit p i f₁ h₁₀ h₁d * polynomialUnit p i f₂ h₂₀ h₂d =
      polynomialUnit p i f₃ h₃₀ h₃d * polynomialUnit p i f₄ h₄₀ h₄d := by
  apply Units.ext
  simp only [polynomialUnit_mul_coe]
  exact AdjoinRoot.mk_eq_mk.mpr hdvd

/-- Coordinatewise equality of the first `k` pair-log digits implies
divisibility by the product `g_0 ⋯ g_{k-1}`. -/
theorem modulusProduct_dvd_product_sub_of_logarithm_modEq (k : ℕ)
    {f₁ f₂ f₃ f₄ : Polynomial (ZMod p)}
    (h₁ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₁)
    (h₂ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₂)
    (h₃ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₃)
    (h₄ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₄)
    (hlog : ∀ (i : ℕ) (hi : i < k),
      Nat.ModEq (p ^ (2 * i + 1) - 1)
        (logarithm p i (polynomialUnitOfNotDvd p i f₁ (h₁ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₂ (h₂ i hi)))
        (logarithm p i (polynomialUnitOfNotDvd p i f₃ (h₃ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₄ (h₄ i hi)))) :
    modulusProduct p k ∣ f₁ * f₂ - f₃ * f₄ := by
  apply modulusProduct_dvd
  intro i hi
  exact auxiliaryIrreducible_dvd_product_sub_of_logarithm_modEq p i
    (h₁ i hi) (h₂ i hi) (h₃ i hi) (h₄ i hi) (hlog i hi)

/-- If the product difference is below the total modulus degree `k²`, the
coordinatewise log congruences force equality of polynomial products. -/
theorem product_eq_of_logarithm_modEq_of_natDegree_lt (k : ℕ)
    {f₁ f₂ f₃ f₄ : Polynomial (ZMod p)}
    (h₁ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₁)
    (h₂ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₂)
    (h₃ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₃)
    (h₄ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₄)
    (hlog : ∀ (i : ℕ) (hi : i < k),
      Nat.ModEq (p ^ (2 * i + 1) - 1)
        (logarithm p i (polynomialUnitOfNotDvd p i f₁ (h₁ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₂ (h₂ i hi)))
        (logarithm p i (polynomialUnitOfNotDvd p i f₃ (h₃ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₄ (h₄ i hi))))
    (hdeg : (f₁ * f₂ - f₃ * f₄).natDegree < k ^ 2) :
    f₁ * f₂ = f₃ * f₄ := by
  apply PolynomialInfrastructure.eq_of_dvd_sub_of_natDegree_lt
    (modulusProduct_dvd_product_sub_of_logarithm_modEq p k h₁ h₂ h₃ h₄ hlog)
  simpa only [modulusProduct_natDegree] using hdeg

/-- The complete algebraic core of the Sidon proof: sufficiently many
equal pair-log coordinates force equality of the unordered pair of monic
irreducible input polynomials. -/
theorem unordered_pair_eq_of_logarithm_modEq (k : ℕ)
    {f₁ f₂ f₃ f₄ : Polynomial (ZMod p)}
    (hirr₁ : Irreducible f₁) (hirr₂ : Irreducible f₂)
    (hirr₃ : Irreducible f₃) (hirr₄ : Irreducible f₄)
    (hmonic₁ : f₁.Monic) (hmonic₂ : f₂.Monic)
    (hmonic₃ : f₃.Monic) (hmonic₄ : f₄.Monic)
    (h₁ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₁)
    (h₂ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₂)
    (h₃ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₃)
    (h₄ : ∀ i < k, ¬ auxiliaryIrreducible p i ∣ f₄)
    (hlog : ∀ (i : ℕ) (hi : i < k),
      Nat.ModEq (p ^ (2 * i + 1) - 1)
        (logarithm p i (polynomialUnitOfNotDvd p i f₁ (h₁ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₂ (h₂ i hi)))
        (logarithm p i (polynomialUnitOfNotDvd p i f₃ (h₃ i hi)) +
          logarithm p i (polynomialUnitOfNotDvd p i f₄ (h₄ i hi))))
    (hdeg : (f₁ * f₂ - f₃ * f₄).natDegree < k ^ 2) :
    (f₁ = f₃ ∧ f₂ = f₄) ∨ (f₁ = f₄ ∧ f₂ = f₃) := by
  apply PolynomialInfrastructure.unordered_pair_eq_of_monic_irreducibles
    hirr₁ hirr₂ hirr₃ hirr₄ hmonic₁ hmonic₂ hmonic₃ hmonic₄
  exact product_eq_of_logarithm_modEq_of_natDegree_lt p k h₁ h₂ h₃ h₄ hlog hdeg

end FiniteFieldEncoding

/-! ## Deterministic construction parameters and encoded candidates -/

namespace Construction

open AuxiliaryDigits TargetExpansion FiniteFieldEncoding

/-- The finite type of the fifteen certified auxiliary digits. -/
abbrev AuxiliaryDigit := ↑auxiliaryDigitList.toFinset

theorem auxiliaryDigit_card : Fintype.card AuxiliaryDigit = 15 := by
  norm_num [AuxiliaryDigit, auxiliaryDigitList]

theorem auxiliaryDigit_natCard : Nat.card AuxiliaryDigit = 15 := by
  rw [Nat.card_eq_fintype_card]
  exact auxiliaryDigit_card

instance auxiliaryDigitNonempty : Nonempty AuxiliaryDigit :=
  ⟨10, by decide⟩

/-- A realization of all auxiliary and top digits in Pilatte's construction.
Probability enters only later by putting the product distribution on this
type; the encoding and Sidon argument are deterministic in `ω`. -/
structure Parameters (q : ℕ) [NeZero q] where
  auxiliary : ∀ k : ℕ, LevelPolynomial q k → Fin k → AuxiliaryDigit
  top : ∀ k : ℕ, LevelPolynomial q k → Fin (q ^ (3 * k))

variable (q : ℕ) [Fact q.Prime]

/-- The lower mixed-radix block, starting at log coordinate `i`, for one
even-degree prime polynomial and a string of auxiliary digits. -/
noncomputable def digitBlock {d : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d)) :
    (i n : ℕ) → (Fin n → AuxiliaryDigit) → List (ℕ × ℕ)
  | _, 0, _ => []
  | i, n + 1, r =>
      (oddRadix q i, primePolynomialLogarithm q i f) ::
      (103, (r 0).1) ::
      digitBlock f (i + 1) n (fun j ↦ r j.succ)

theorem auxiliaryDigit_mem (a : AuxiliaryDigit) : (a : ℕ) ∈ auxiliaryDigitSet := by
  change (a : ℕ) ∈ auxiliaryDigitList.toFinset
  exact a.property

/-- Every generated lower block is normalized for the common mixed radix. -/
theorem digitBlock_valid (hq : 3 ≤ q) {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) :
    MixedRadix.Valid (digitBlock q f i n r) := by
  induction n generalizing i with
  | zero => simp [digitBlock, MixedRadix.Valid]
  | succ n ih =>
      have ha := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r 0))
      rcases ha with ⟨ha1, ha51⟩
      have htail := ih (i := i + 1) (r := fun j ↦ r j.succ)
      simp only [digitBlock, MixedRadix.Valid]
      exact ⟨oddRadix_two_le hq, primePolynomialLogarithm_lt_radix q i f,
        by norm_num, by omega, htail⟩

/-- The place value of a recursively generated digit block. -/
def blockPlace (q : ℕ) : ℕ → ℕ → ℕ
  | _, 0 => 1
  | i, n + 1 => oddRadix q i * 103 * blockPlace q (i + 1) n

theorem blockPlace_add (i m n : ℕ) :
    blockPlace q i (m + n) =
      blockPlace q i m * blockPlace q (i + m) n := by
  induction m generalizing i with
  | zero => simp [blockPlace]
  | succ m ih =>
      rw [Nat.succ_add, blockPlace, blockPlace, ih (i + 1)]
      have hidx : i + 1 + m = i + (m + 1) := by omega
      rw [hidx]
      ring

theorem digitBlock_place {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) :
    MixedRadix.place (digitBlock q f i n r) = blockPlace q i n := by
  induction n generalizing i with
  | zero => simp [digitBlock, blockPlace, MixedRadix.place]
  | succ n ih =>
      simp only [digitBlock, MixedRadix.place_cons, blockPlace]
      rw [ih]
      ring

/-- All digit blocks of the same length and starting coordinate use the same
radices, independently of the polynomial and auxiliary-digit realization. -/
theorem digitBlock_bases_eq {d₁ d₂ i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (r s : Fin n → AuxiliaryDigit) :
    (digitBlock q f i n r).map Prod.fst =
      (digitBlock q g i n s).map Prod.fst := by
  induction n generalizing i with
  | zero => simp [digitBlock]
  | succ n ih =>
      simp only [digitBlock, List.map_cons]
      rw [ih (i := i + 1) (fun j ↦ r j.succ) (fun j ↦ s j.succ)]

theorem digitBlock_length {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) :
    (digitBlock q f i n r).length = 2 * n := by
  induction n generalizing i with
  | zero => simp [digitBlock]
  | succ n ih =>
      simp only [digitBlock, List.length_cons]
      rw [ih]
      omega

/-- At every complete digit-pair boundary, the sum of two lower blocks is
still normalized.  The logarithm carry is absorbed by the auxiliary radix
because every certified auxiliary digit is below `103/2`. -/
theorem digitBlock_pair_encode_lt_place (hq : 3 ≤ q)
    {d₁ d₂ i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (r s : Fin n → AuxiliaryDigit) :
    MixedRadix.encode (digitBlock q f i n r) +
        MixedRadix.encode (digitBlock q g i n s) < blockPlace q i n := by
  induction n generalizing i with
  | zero => simp [digitBlock, blockPlace, MixedRadix.encode]
  | succ n ih =>
      let b := oddRadix q i
      let ef := primePolynomialLogarithm q i f
      let eg := primePolynomialLogarithm q i g
      let af : ℕ := (r 0).1
      let ag : ℕ := (s 0).1
      let tf := MixedRadix.encode
        (digitBlock q f (i + 1) n (fun j ↦ r j.succ))
      let tg := MixedRadix.encode
        (digitBlock q g (i + 1) n (fun j ↦ s j.succ))
      let P := blockPlace q (i + 1) n
      have hb : 2 ≤ b := oddRadix_two_le hq
      have hef : ef < b := primePolynomialLogarithm_lt_radix q i f
      have heg : eg < b := primePolynomialLogarithm_lt_radix q i g
      have haf := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r 0))
      have hag := explicitAuxiliarySet.1 (auxiliaryDigit_mem (s 0))
      have haf' : af < 51 := by simpa [af] using haf.2
      have hag' : ag < 51 := by simpa [ag] using hag.2
      have htail : tf + tg < P := by
        exact ih (i := i + 1) (r := fun j ↦ r j.succ)
          (s := fun j ↦ s j.succ)
      have htail' : tf + tg + 1 ≤ P := Nat.succ_le_iff.mpr htail
      have hlocal :
          ef + b * (af + 103 * tf) + (eg + b * (ag + 103 * tg)) <
            b * 103 * (tf + tg + 1) := by
        nlinarith
      simp only [digitBlock, MixedRadix.encode_cons, blockPlace]
      change ef + b * (af + 103 * tf) + (eg + b * (ag + 103 * tg)) <
        b * 103 * P
      exact hlocal.trans_le (Nat.mul_le_mul_left (b * 103) htail')

/-- A single lower block occupies strictly less than half of its complete
pair place.  This quantitative slack prevents an added top digit from
propagating indefinitely. -/
theorem two_mul_digitBlock_encode_lt_place (hq : 3 ≤ q)
    {d i n : ℕ} (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) :
    2 * MixedRadix.encode (digitBlock q f i n r) < blockPlace q i n := by
  induction n generalizing i with
  | zero => simp [digitBlock, blockPlace, MixedRadix.encode]
  | succ n ih =>
      let b := oddRadix q i
      let e := primePolynomialLogarithm q i f
      let a : ℕ := (r 0).1
      let t := MixedRadix.encode
        (digitBlock q f (i + 1) n (fun j ↦ r j.succ))
      let P := blockPlace q (i + 1) n
      have hb : 2 ≤ b := oddRadix_two_le hq
      have he : e < b := primePolynomialLogarithm_lt_radix q i f
      have ha := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r 0))
      have ha' : a < 51 := by simpa [a] using ha.2
      have htail : 2 * t < P := by
        exact ih (i := i + 1) (r := fun j ↦ r j.succ)
      have htail' : 2 * t + 1 ≤ P := Nat.succ_le_iff.mpr htail
      have hlocal : 2 * (e + b * (a + 103 * t)) <
          b * 103 * (2 * t + 1) := by
        nlinarith
      simp only [digitBlock, MixedRadix.encode_cons, blockPlace]
      change 2 * (e + b * (a + 103 * t)) < b * 103 * P
      exact hlocal.trans_le (Nat.mul_le_mul_left (b * 103) htail')

/-- Restrict a finite family along an initial-segment inclusion. -/
def finRestrict {α : Type*} {m n : ℕ} (h : m ≤ n) (r : Fin n → α) :
    Fin m → α := fun j ↦ r ⟨j, j.isLt.trans_le h⟩

@[simp]
theorem finRestrict_zero {α : Type*} {m n : ℕ} (h : m + 1 ≤ n + 1)
    (r : Fin (n + 1) → α) : finRestrict h r 0 = r 0 := rfl

@[simp]
theorem finRestrict_succ {α : Type*} {m n : ℕ} (h : m + 1 ≤ n + 1)
    (r : Fin (n + 1) → α) (j : Fin m) :
    finRestrict h r j.succ =
      finRestrict (Nat.succ_le_succ_iff.mp h) (fun t ↦ r t.succ) j := rfl

/-- A lower digit block followed by an arbitrary, possibly unnormalized,
top coefficient.  This recursive form exposes carry propagation. -/
noncomputable def blockWithTopValue {d : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d)) :
    (i n : ℕ) → (Fin n → AuxiliaryDigit) → ℕ → ℕ
  | _, 0, _, z => z
  | i, n + 1, r, z =>
      primePolynomialLogarithm q i f + oddRadix q i *
        ((r 0).1 + 103 *
          blockWithTopValue f (i + 1) n (fun j ↦ r j.succ) z)

/-- Recursive `blockWithTopValue` agrees with the mixed-radix encoding plus
the top coefficient times the final place. -/
theorem blockWithTopValue_eq_encode_add_place_mul {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) (z : ℕ) :
    blockWithTopValue q f i n r z =
      MixedRadix.encode (digitBlock q f i n r) + blockPlace q i n * z := by
  induction n generalizing i with
  | zero => simp [blockWithTopValue, digitBlock, blockPlace, MixedRadix.encode]
  | succ n ih =>
      simp only [blockWithTopValue, digitBlock, MixedRadix.encode_cons, blockPlace]
      rw [ih (i := i + 1) (r := fun j ↦ r j.succ)]
      ring

theorem blockPlace_pos (q i n : ℕ) [Fact q.Prime] : 0 < blockPlace q i n := by
  induction n generalizing i with
  | zero => simp [blockPlace]
  | succ n ih =>
      rw [blockPlace]
      have hq : 2 ≤ q := (Fact.out : q.Prime).two_le
      exact Nat.mul_pos (Nat.mul_pos (oddRadix_pos hq) (by norm_num)) (ih (i + 1))

theorem blockPlace_mono_length (q i : ℕ) [Fact q.Prime] {m n : ℕ}
    (hmn : m ≤ n) : blockPlace q i m ≤ blockPlace q i n := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
  rw [blockPlace_add]
  have hp : 1 ≤ blockPlace q (i + m) d := blockPlace_pos q (i + m) d
  simpa only [Nat.mul_one] using Nat.mul_le_mul_left (blockPlace q i m) hp

/-- The auxiliary digit at the head of a nonempty block-with-top value is
recovered by one division and reduction modulo `103`. -/
theorem blockWithTopValue_head_aux (hq : 3 ≤ q) {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin (n + 1) → AuxiliaryDigit) (z : ℕ) :
    (blockWithTopValue q f i (n + 1) r z / oddRadix q i) % 103 = (r 0).1 := by
  have hb : 0 < oddRadix q i := oddRadix_pos (by omega)
  have he : primePolynomialLogarithm q i f < oddRadix q i :=
    primePolynomialLogarithm_lt_radix q i f
  have ha := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r 0))
  simp only [blockWithTopValue]
  rw [Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt he, zero_add,
    Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt]
  exact ha.2.trans_le (by norm_num)

/-- List-indexed counterpart of `digitBlock`, used for arbitrary prefix and
suffix decompositions without dependent transports. -/
noncomputable def digitBlockList {d : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d)) :
    ℕ → List AuxiliaryDigit → List (ℕ × ℕ)
  | _, [] => []
  | i, a :: as =>
      (oddRadix q i, primePolynomialLogarithm q i f) ::
      (103, (a : ℕ)) :: digitBlockList f (i + 1) as

/-- List-indexed digit block with an unnormalized top coefficient. -/
noncomputable def blockWithTopList {d : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d)) :
    ℕ → List AuxiliaryDigit → ℕ → ℕ
  | _, [], z => z
  | i, a :: as, z =>
      primePolynomialLogarithm q i f + oddRadix q i *
        ((a : ℕ) + 103 * blockWithTopList f (i + 1) as z)

theorem digitBlockList_ofFn {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) :
    digitBlockList q f i (List.ofFn r) = digitBlock q f i n r := by
  induction n generalizing i with
  | zero => simp [digitBlockList, digitBlock]
  | succ n ih =>
      rw [List.ofFn_succ]
      simp only [digitBlockList, digitBlock]
      rw [ih (i := i + 1) (r := fun j ↦ r j.succ)]

theorem blockWithTopList_ofFn {d i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) (z : ℕ) :
    blockWithTopList q f i (List.ofFn r) z =
      blockWithTopValue q f i n r z := by
  induction n generalizing i with
  | zero => simp [blockWithTopList, blockWithTopValue]
  | succ n ih =>
      rw [List.ofFn_succ]
      simp only [blockWithTopList, blockWithTopValue]
      rw [ih (i := i + 1) (r := fun j ↦ r j.succ)]

theorem blockWithTopList_eq_encode_add_place_mul {d i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (as : List AuxiliaryDigit) (z : ℕ) :
    blockWithTopList q f i as z =
      MixedRadix.encode (digitBlockList q f i as) +
        blockPlace q i as.length * z := by
  induction as generalizing i with
  | nil => simp [blockWithTopList, digitBlockList, blockPlace]
  | cons a as ih =>
      simp only [blockWithTopList, digitBlockList, MixedRadix.encode_cons,
        List.length_cons, blockPlace]
      rw [ih (i := i + 1)]
      ring

/-- Concatenating auxiliary lists splits a block-with-top value at the
corresponding complete-pair place. -/
theorem blockWithTopList_append {d i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (xs ys : List AuxiliaryDigit) (z : ℕ) :
    blockWithTopList q f i (xs ++ ys) z =
      MixedRadix.encode (digitBlockList q f i xs) +
        blockPlace q i xs.length *
          blockWithTopList q f (i + xs.length) ys z := by
  induction xs generalizing i with
  | nil => simp [blockWithTopList, digitBlockList, blockPlace]
  | cons a xs ih =>
      simp only [List.cons_append, blockWithTopList, digitBlockList,
        MixedRadix.encode_cons, List.length_cons, blockPlace]
      rw [ih (i := i + 1)]
      have hidx : i + 1 + xs.length = i + (xs.length + 1) := by omega
      rw [hidx]
      ring

theorem blockWithTopList_head_aux (hq : 3 ≤ q) {d i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (a : AuxiliaryDigit) (as : List AuxiliaryDigit) (z : ℕ) :
    (blockWithTopList q f i (a :: as) z / oddRadix q i) % 103 = (a : ℕ) := by
  have hb : 0 < oddRadix q i := oddRadix_pos (by omega)
  have he : primePolynomialLogarithm q i f < oddRadix q i :=
    primePolynomialLogarithm_lt_radix q i f
  have ha := explicitAuxiliarySet.1 (auxiliaryDigit_mem a)
  simp only [blockWithTopList]
  rw [Nat.add_mul_div_left _ _ hb, Nat.div_eq_of_lt he, zero_add,
    Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt]
  exact ha.2.trans_le (by norm_num)

theorem blockWithTopList_head_log {d i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (a : AuxiliaryDigit) (as : List AuxiliaryDigit) (z : ℕ) :
    blockWithTopList q f i (a :: as) z % oddRadix q i =
      primePolynomialLogarithm q i f := by
  have he : primePolynomialLogarithm q i f < oddRadix q i :=
    primePolynomialLogarithm_lt_radix q i f
  simp only [blockWithTopList, Nat.add_mul_mod_self_left]
  exact Nat.mod_eq_of_lt he

theorem two_mul_digitBlockList_encode_lt_place (hq : 3 ≤ q) {d i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d)) (as : List AuxiliaryDigit) :
    2 * MixedRadix.encode (digitBlockList q f i as) <
      blockPlace q i as.length := by
  have h := two_mul_digitBlock_encode_lt_place q hq (i := i) f as.get
  simpa only [← digitBlockList_ofFn, List.ofFn_get] using h

theorem digitBlockList_pair_encode_lt_place (hq : 3 ≤ q)
    {d₁ d₂ i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (as bs : List AuxiliaryDigit) (hlen : as.length = bs.length) :
    MixedRadix.encode (digitBlockList q f i as) +
        MixedRadix.encode (digitBlockList q g i bs) <
      blockPlace q i as.length := by
  have hf := two_mul_digitBlockList_encode_lt_place q hq (i := i) f as
  have hg := two_mul_digitBlockList_encode_lt_place q hq (i := i) g bs
  rw [← hlen] at hg
  omega

/-- At the head of a sum of two blocks, the normalized auxiliary digit is
the sum of the two auxiliary entries and the binary logarithm carry. -/
theorem blockWithTopList_pair_head_aux (hq : 3 ≤ q)
    {d₁ d₂ i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (a b : AuxiliaryDigit) (as bs : List AuxiliaryDigit) (z w : ℕ) :
    ((blockWithTopList q f i (a :: as) z +
        blockWithTopList q g i (b :: bs) w) / oddRadix q i) % 103 =
      (a : ℕ) + (b : ℕ) +
        (primePolynomialLogarithm q i f +
          primePolynomialLogarithm q i g) / oddRadix q i := by
  let B := oddRadix q i
  let ef := primePolynomialLogarithm q i f
  let eg := primePolynomialLogarithm q i g
  have hB : 0 < B := oddRadix_pos (by omega)
  have hef : ef < B := primePolynomialLogarithm_lt_radix q i f
  have heg : eg < B := primePolynomialLogarithm_lt_radix q i g
  have ha := explicitAuxiliarySet.1 (auxiliaryDigit_mem a)
  have hb := explicitAuxiliarySet.1 (auxiliaryDigit_mem b)
  have hcarry : (ef + eg) / B ≤ 1 := by
    simpa using MixedRadix.two_digit_carry_le_one hB hef heg (by omega : 0 ≤ 1)
  have hsmall : (a : ℕ) + (b : ℕ) + (ef + eg) / B < 103 := by
    norm_num at ha hb
    omega
  have hrearr :
      blockWithTopList q f i (a :: as) z +
          blockWithTopList q g i (b :: bs) w =
        ef + eg + B * ((a : ℕ) + (b : ℕ) +
          103 * (blockWithTopList q f (i + 1) as z +
            blockWithTopList q g (i + 1) bs w)) := by
    simp only [blockWithTopList]
    dsimp only [B, ef, eg]
    ring
  rw [hrearr, Nat.add_mul_div_left _ _ hB]
  rw [show (ef + eg) / B + ((a : ℕ) + (b : ℕ) + 103 *
        (blockWithTopList q f (i + 1) as z +
          blockWithTopList q g (i + 1) bs w)) =
      ((a : ℕ) + (b : ℕ) + (ef + eg) / B) + 103 *
        (blockWithTopList q f (i + 1) as z +
          blockWithTopList q g (i + 1) bs w) by omega,
    Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hsmall]

/-- Division at a common prefix boundary removes both normalized prefixes
from a sum of two block-with-top values. -/
theorem blockWithTopList_pair_add_div_append (hq : 3 ≤ q)
    {d₁ d₂ i : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (xs₁ xs₂ ys₁ ys₂ : List AuxiliaryDigit)
    (hlen : xs₁.length = xs₂.length) (z w : ℕ) :
    (blockWithTopList q f i (xs₁ ++ ys₁) z +
        blockWithTopList q g i (xs₂ ++ ys₂) w) /
        blockPlace q i xs₁.length =
      blockWithTopList q f (i + xs₁.length) ys₁ z +
        blockWithTopList q g (i + xs₂.length) ys₂ w := by
  rw [blockWithTopList_append, blockWithTopList_append]
  rw [← hlen]
  have hp := blockPlace_pos q i xs₁.length
  have hsmall := digitBlockList_pair_encode_lt_place q hq (i := i)
    f g xs₁ xs₂ hlen
  rw [show MixedRadix.encode (digitBlockList q f i xs₁) +
          blockPlace q i xs₁.length *
            blockWithTopList q f (i + xs₁.length) ys₁ z +
          (MixedRadix.encode (digitBlockList q g i xs₂) +
            blockPlace q i xs₁.length *
              blockWithTopList q g (i + xs₁.length) ys₂ w) =
        (MixedRadix.encode (digitBlockList q f i xs₁) +
          MixedRadix.encode (digitBlockList q g i xs₂)) +
          blockPlace q i xs₁.length *
            (blockWithTopList q f (i + xs₁.length) ys₁ z +
              blockWithTopList q g (i + xs₁.length) ys₂ w) by ring]
  rw [Nat.add_mul_div_left _ _ hp, Nat.div_eq_of_lt hsmall, zero_add]

/-- Taking `m` whole digit pairs from a longer block gives the block built
from the restricted auxiliary family. -/
theorem digitBlock_take {d i m n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (r : Fin n → AuxiliaryDigit) (hm : m ≤ n) :
    (digitBlock q f i n r).take (2 * m) =
      digitBlock q f i m (finRestrict hm r) := by
  induction m generalizing i n with
  | zero => simp [digitBlock]
  | succ m ih =>
      cases n with
      | zero => omega
      | succ n =>
          rw [show 2 * (m + 1) = Nat.succ (Nat.succ (2 * m)) by omega]
          simp only [digitBlock, List.take_succ_cons, finRestrict_zero,
            finRestrict_succ]
          rw [ih (i := i + 1) (n := n) (r := fun j ↦ r j.succ) (by omega)]

/-- The first `m` digit pairs use the same radices in blocks of any two
lengths at least `m`.  This is the unequal-level version of
`digitBlock_bases_eq`. -/
theorem digitBlock_take_bases_eq {d₁ d₂ i n₁ n₂ m : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (r : Fin n₁ → AuxiliaryDigit) (s : Fin n₂ → AuxiliaryDigit)
    (hm₁ : m ≤ n₁) (hm₂ : m ≤ n₂) :
    ((digitBlock q f i n₁ r).take (2 * m)).map Prod.fst =
      ((digitBlock q g i n₂ s).take (2 * m)).map Prod.fst := by
  induction m generalizing i n₁ n₂ with
  | zero => simp
  | succ m ih =>
      cases n₁ with
      | zero => omega
      | succ n₁ =>
          cases n₂ with
          | zero => omega
          | succ n₂ =>
              rw [show 2 * (m + 1) = Nat.succ (Nat.succ (2 * m)) by omega]
              simp only [digitBlock, List.take_succ_cons, List.map_cons, Prod.fst]
              rw [ih (i := i + 1) (n₁ := n₁) (n₂ := n₂)
                (r := fun j ↦ r j.succ) (s := fun j ↦ s j.succ)
                (by omega) (by omega)]

/-- Equality of the first `m` digit pairs recovers their discrete-log
coordinates, even when the two full blocks have unequal lengths. -/
theorem digitBlock_logarithm_eq_of_take_eq {d₁ d₂ i n₁ n₂ m : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (r : Fin n₁ → AuxiliaryDigit) (s : Fin n₂ → AuxiliaryDigit)
    (hm₁ : m ≤ n₁) (hm₂ : m ≤ n₂)
    (h : (digitBlock q f i n₁ r).take (2 * m) =
      (digitBlock q g i n₂ s).take (2 * m)) :
    ∀ j : Fin m, primePolynomialLogarithm q (i + j) f =
      primePolynomialLogarithm q (i + j) g := by
  induction m generalizing i n₁ n₂ with
  | zero => exact fun j ↦ Fin.elim0 j
  | succ m ih =>
      cases n₁ with
      | zero => omega
      | succ n₁ =>
          cases n₂ with
          | zero => omega
          | succ n₂ =>
              rw [show 2 * (m + 1) = Nat.succ (Nat.succ (2 * m)) by omega] at h
              simp only [digitBlock, List.take_succ_cons] at h
              injection h with hfirst hrest
              injection hrest with _hsecond htail
              intro j
              refine Fin.cases ?_ (fun j' ↦ ?_) j
              · simpa using congrArg Prod.snd hfirst
              · have hh := ih (i := i + 1) (n₁ := n₁) (n₂ := n₂)
                  (r := fun t ↦ r t.succ) (s := fun t ↦ s t.succ)
                  (by omega) (by omega) htail j'
                have hidx : i + (j'.succ : ℕ) = i + 1 + (j' : ℕ) := by
                  change i + ((j' : ℕ) + 1) = i + 1 + (j' : ℕ)
                  omega
                rw [hidx]
                exact hh

/-- Equality of the sums of two complete lower blocks recovers, at every
odd position, equality of the corresponding sums of logarithms modulo that
position's radix.  Division by the following auxiliary radix is legitimate
because the auxiliary digits absorb the binary logarithm carry. -/
theorem digitBlock_pair_log_modEq_of_encode_add_eq (hq : 3 ≤ q)
    {d₁ d₂ d₃ d₄ i n : ℕ}
    (f₁ : PrimePolynomials.OfDegree q (2 * d₁))
    (f₂ : PrimePolynomials.OfDegree q (2 * d₂))
    (f₃ : PrimePolynomials.OfDegree q (2 * d₃))
    (f₄ : PrimePolynomials.OfDegree q (2 * d₄))
    (r₁ : Fin n → AuxiliaryDigit) (r₂ : Fin n → AuxiliaryDigit)
    (r₃ : Fin n → AuxiliaryDigit) (r₄ : Fin n → AuxiliaryDigit)
    (h : MixedRadix.encode (digitBlock q f₁ i n r₁) +
        MixedRadix.encode (digitBlock q f₂ i n r₂) =
      MixedRadix.encode (digitBlock q f₃ i n r₃) +
        MixedRadix.encode (digitBlock q f₄ i n r₄)) :
    ∀ j : Fin n,
      Nat.ModEq (oddRadix q (i + j))
        (primePolynomialLogarithm q (i + j) f₁ +
          primePolynomialLogarithm q (i + j) f₂)
        (primePolynomialLogarithm q (i + j) f₃ +
          primePolynomialLogarithm q (i + j) f₄) := by
  induction n generalizing i with
  | zero => exact fun j ↦ Fin.elim0 j
  | succ n ih =>
      let b := oddRadix q i
      let e₁ := primePolynomialLogarithm q i f₁
      let e₂ := primePolynomialLogarithm q i f₂
      let e₃ := primePolynomialLogarithm q i f₃
      let e₄ := primePolynomialLogarithm q i f₄
      let a₁ : ℕ := (r₁ 0).1
      let a₂ : ℕ := (r₂ 0).1
      let a₃ : ℕ := (r₃ 0).1
      let a₄ : ℕ := (r₄ 0).1
      let t₁ := MixedRadix.encode
        (digitBlock q f₁ (i + 1) n (fun j ↦ r₁ j.succ))
      let t₂ := MixedRadix.encode
        (digitBlock q f₂ (i + 1) n (fun j ↦ r₂ j.succ))
      let t₃ := MixedRadix.encode
        (digitBlock q f₃ (i + 1) n (fun j ↦ r₃ j.succ))
      let t₄ := MixedRadix.encode
        (digitBlock q f₄ (i + 1) n (fun j ↦ r₄ j.succ))
      have hb : 0 < b := by have := oddRadix_two_le hq (i := i); omega
      have he₁ : e₁ < b := primePolynomialLogarithm_lt_radix q i f₁
      have he₂ : e₂ < b := primePolynomialLogarithm_lt_radix q i f₂
      have he₃ : e₃ < b := primePolynomialLogarithm_lt_radix q i f₃
      have he₄ : e₄ < b := primePolynomialLogarithm_lt_radix q i f₄
      have ha₁ := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r₁ 0))
      have ha₂ := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r₂ 0))
      have ha₃ := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r₃ 0))
      have ha₄ := explicitAuxiliarySet.1 (auxiliaryDigit_mem (r₄ 0))
      have ha₁' : a₁ < 51 := by simpa [a₁] using ha₁.2
      have ha₂' : a₂ < 51 := by simpa [a₂] using ha₂.2
      have ha₃' : a₃ < 51 := by simpa [a₃] using ha₃.2
      have ha₄' : a₄ < 51 := by simpa [a₄] using ha₄.2
      have hrearr :
          e₁ + e₂ + b * (a₁ + a₂ + 103 * (t₁ + t₂)) =
            e₃ + e₄ + b * (a₃ + a₄ + 103 * (t₃ + t₄)) := by
        dsimp only [b, e₁, e₂, e₃, e₄, a₁, a₂, a₃, a₄,
          t₁, t₂, t₃, t₄]
        simp only [digitBlock, MixedRadix.encode_cons] at h ⊢
        calc
          _ = MixedRadix.encode (digitBlock q f₁ i (n + 1) r₁) +
              MixedRadix.encode (digitBlock q f₂ i (n + 1) r₂) := by
                simp only [digitBlock, MixedRadix.encode_cons]
                ring
          _ = _ := h
          _ = _ := by
                ring
      have hhead : Nat.ModEq b (e₁ + e₂) (e₃ + e₄) := by
        change (e₁ + e₂) % b = (e₃ + e₄) % b
        have hmod := congrArg (fun z : ℕ ↦ z % b) hrearr
        simpa only [Nat.add_mul_mod_self_left] using hmod
      have hdiv := congrArg (fun z : ℕ ↦ z / b) hrearr
      rw [Nat.add_mul_div_left _ _ hb, Nat.add_mul_div_left _ _ hb] at hdiv
      have hc₁₂ : (e₁ + e₂) / b ≤ 1 := by
        simpa using MixedRadix.two_digit_carry_le_one hb he₁ he₂
          (by omega : 0 ≤ 1)
      have hc₃₄ : (e₃ + e₄) / b ≤ 1 := by
        simpa using MixedRadix.two_digit_carry_le_one hb he₃ he₄
          (by omega : 0 ≤ 1)
      have hu₁₂ : (e₁ + e₂) / b + a₁ + a₂ < 103 := by omega
      have hu₃₄ : (e₃ + e₄) / b + a₃ + a₄ < 103 := by omega
      have haux :
          ((e₁ + e₂) / b + a₁ + a₂) + 103 * (t₁ + t₂) =
            ((e₃ + e₄) / b + a₃ + a₄) + 103 * (t₃ + t₄) := by
        omega
      have htail := congrArg (fun z : ℕ ↦ z / 103) haux
      rw [Nat.add_mul_div_left _ _ (by norm_num),
        Nat.add_mul_div_left _ _ (by norm_num),
        Nat.div_eq_of_lt hu₁₂, Nat.div_eq_of_lt hu₃₄, zero_add, zero_add] at htail
      intro j
      refine Fin.cases ?_ (fun j' ↦ ?_) j
      · simpa [b, e₁, e₂, e₃, e₄] using hhead
      · have hh := ih (i := i + 1) (r₁ := fun t ↦ r₁ t.succ)
          (r₂ := fun t ↦ r₂ t.succ) (r₃ := fun t ↦ r₃ t.succ)
          (r₄ := fun t ↦ r₄ t.succ) htail j'
        have hidx : i + (j'.succ : ℕ) = i + 1 + (j' : ℕ) := by
          change i + ((j' : ℕ) + 1) = i + 1 + (j' : ℕ)
          omega
        rw [hidx]
        exact hh

/-- Equality of two digit blocks recovers every prime-polynomial log
coordinate in that block. -/
theorem digitBlock_logarithm_eq_of_eq {d₁ d₂ i n : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d₁))
    (g : PrimePolynomials.OfDegree q (2 * d₂))
    (r s : Fin n → AuxiliaryDigit)
    (h : digitBlock q f i n r = digitBlock q g i n s) :
    ∀ j : Fin n, primePolynomialLogarithm q (i + j) f =
      primePolynomialLogarithm q (i + j) g := by
  induction n generalizing i with
  | zero => exact fun j ↦ Fin.elim0 j
  | succ n ih =>
      simp only [digitBlock] at h
      injection h with hfirst hrest
      injection hrest with _hsecond htail
      intro j
      refine Fin.cases ?_ (fun j' ↦ ?_) j
      · simpa using congrArg Prod.snd hfirst
      · have hh := ih (i := i + 1) (fun t ↦ r t.succ)
          (fun t ↦ s t.succ) htail j'
        have hidx : i + (j'.succ : ℕ) = i + 1 + (j' : ℕ) := by
          change i + ((j' : ℕ) + 1) = i + 1 + (j' : ℕ)
          omega
        rw [hidx]
        exact hh

theorem oddRadix_mul_aux_gt_pow {i : ℕ} (hq : 2 ≤ q) :
    q ^ (2 * i + 1) < oddRadix q i * 103 := by
  have hp : 2 ≤ q ^ (2 * i + 1) := by
    have hone : 1 ≤ q ^ (2 * i) := Nat.one_le_pow _ _ (by omega)
    have hqle : q ≤ q ^ (2 * i) * q := by
      simpa only [one_mul] using Nat.mul_le_mul_right q hone
    exact hq.trans (by simpa only [pow_succ] using hqle)
  unfold oddRadix
  omega

/-- The product of the first `n` paired radices dominates the corresponding
power whose exponent is the sum of the odd positions. -/
theorem pow_le_blockPlace (hq : 2 ≤ q) (i n : ℕ) :
    q ^ (n * (2 * i + n)) ≤ blockPlace q i n := by
  induction n generalizing i with
  | zero => simp [blockPlace]
  | succ n ih =>
      have hfactor := (oddRadix_mul_aux_gt_pow q hq (i := i)).le
      have htail := ih (i + 1)
      rw [blockPlace]
      calc
        q ^ ((n + 1) * (2 * i + (n + 1))) =
            q ^ (2 * i + 1) * q ^ (n * (2 * (i + 1) + n)) := by
          rw [← pow_add]
          congr 1
          ring
        _ ≤ (oddRadix q i * 103) * q ^ (n * (2 * (i + 1) + n)) :=
          Nat.mul_le_mul_right _ hfactor
        _ ≤ (oddRadix q i * 103) * blockPlace q (i + 1) n :=
          Nat.mul_le_mul_left _ htail
        _ = oddRadix q i * 103 * blockPlace q (i + 1) n := by ring

theorem pow_lt_blockPlace (hq : 2 ≤ q) (i : ℕ) {n : ℕ} (hn : n ≠ 0) :
    q ^ (n * (2 * i + n)) < blockPlace q i n := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  have hfactor := oddRadix_mul_aux_gt_pow q hq (i := i)
  have htail := pow_le_blockPlace q hq (i + 1) n
  rw [blockPlace]
  calc
    q ^ ((n + 1) * (2 * i + (n + 1))) =
        q ^ (2 * i + 1) * q ^ (n * (2 * (i + 1) + n)) := by
      rw [← pow_add]
      congr 1
      ring
    _ < (oddRadix q i * 103) * q ^ (n * (2 * (i + 1) + n)) := by
      exact (Nat.mul_lt_mul_right (Nat.pow_pos (by omega : 0 < q))).2 hfactor
    _ ≤ (oddRadix q i * 103) * blockPlace q (i + 1) n :=
      Nat.mul_le_mul_left _ htail
    _ = oddRadix q i * 103 * blockPlace q (i + 1) n := by ring

/-- Three complete pairs above level `k` dominate twice the maximal
level-`k` top digit. -/
theorem two_mul_topBound_lt_blockPlace_three (hq : 2 ≤ q) (k : ℕ) :
    2 * q ^ (3 * k) < blockPlace q k 3 := by
  have hp := pow_lt_blockPlace q hq k (n := 3) (by norm_num)
  have hmul : 2 * q ^ (3 * k) ≤ q * q ^ (3 * k) :=
    Nat.mul_le_mul_right (q ^ (3 * k)) hq
  have hexp : 3 * k + 1 < 3 * (2 * k + 3) := by omega
  have hpow : q ^ (3 * k + 1) < q ^ (3 * (2 * k + 3)) :=
    (Nat.pow_lt_pow_iff_right (by omega : 1 < q)).mpr hexp
  calc
    2 * q ^ (3 * k) ≤ q * q ^ (3 * k) := hmul
    _ = q ^ (3 * k + 1) := by rw [pow_succ]; ring
    _ < q ^ (3 * (2 * k + 3)) := hpow
    _ < blockPlace q k 3 := by simpa using hp

/-- A three-pair prefix plus any legal level-`k` top digit is still below
the place above those pairs. -/
theorem digitBlockList_three_add_top_lt_place (hq : 3 ≤ q) {d k : ℕ}
    (f : PrimePolynomials.OfDegree q (2 * d))
    (as : List AuxiliaryDigit) (has : as.length = 3)
    {z : ℕ} (hz : z ≤ q ^ (3 * k)) :
    MixedRadix.encode (digitBlockList q f k as) + z < blockPlace q k 3 := by
  have hprefix := two_mul_digitBlockList_encode_lt_place q hq (i := k) f as
  rw [has] at hprefix
  have htop : 2 * z < blockPlace q k 3 :=
    (Nat.mul_le_mul_left 2 hz).trans_lt
      (two_mul_topBound_lt_blockPlace_three q (by omega) k)
  omega

/-- When `q ≥ 103`, one extra power of `q` per auxiliary radix gives a
simple upper bound for the paired-radix product. -/
theorem blockPlace_le_pow (hq : 103 ≤ q) (i n : ℕ) :
    blockPlace q i n ≤ q ^ (n * (2 * i + n + 1)) := by
  induction n generalizing i with
  | zero => simp [blockPlace]
  | succ n ih =>
      have hodd : oddRadix q i ≤ q ^ (2 * i + 1) := by
        unfold oddRadix
        omega
      have hfactor : oddRadix q i * 103 ≤ q ^ (2 * i + 2) := by
        calc
          oddRadix q i * 103 ≤ q ^ (2 * i + 1) * q :=
            Nat.mul_le_mul hodd hq
          _ = q ^ (2 * i + 2) := by
            simp only [pow_succ]
      rw [blockPlace]
      calc
        oddRadix q i * 103 * blockPlace q (i + 1) n ≤
            q ^ (2 * i + 2) * q ^ (n * (2 * (i + 1) + n + 1)) :=
          Nat.mul_le_mul hfactor (ih (i + 1))
        _ = q ^ ((n + 1) * (2 * i + (n + 1) + 1)) := by
          rw [← pow_add]
          congr 1
          ring

/-- The parameter space is inhabited whenever `q ≥ 2`; this is useful both
for deterministic statements and for the later product probability space. -/
noncomputable def defaultParameters (hq : 2 ≤ q) : Parameters q where
  auxiliary := fun _ _ _ ↦ ⟨10, by decide⟩
  top := fun k _ ↦ ⟨0, Nat.pow_pos (by omega : 0 < q)⟩

/-- All paired digits below the unnormalized top digit of a level-`k`
candidate. -/
noncomputable def lowerDigits (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) : List (ℕ × ℕ) :=
  digitBlock q f.2 0 k (ω.auxiliary k f)

/-- Auxiliary digits of a candidate as an ordinary list, for prefix/suffix
arguments in the Sidon proof. -/
noncomputable def auxiliaryList (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) : List AuxiliaryDigit :=
  List.ofFn (ω.auxiliary k f)

@[simp]
theorem auxiliaryList_length (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) : (auxiliaryList q ω f).length = k := by
  simp [auxiliaryList]

theorem lowerDigits_valid (hq : 3 ≤ q) (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    MixedRadix.Valid (lowerDigits q ω f) :=
  digitBlock_valid q hq f.2 (ω.auxiliary k f)

theorem lowerDigits_place (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    MixedRadix.place (lowerDigits q ω f) = blockPlace q 0 k :=
  digitBlock_place q f.2 (ω.auxiliary k f)

/-- The first `m` complete digit pairs of a level-`k` candidate. -/
noncomputable def prefixDigits (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) : List (ℕ × ℕ) :=
  digitBlock q f.2 0 m (finRestrict hm (ω.auxiliary k f))

theorem prefixDigits_eq_take (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) :
    prefixDigits q ω f hm = (lowerDigits q ω f).take (2 * m) := by
  symm
  exact digitBlock_take q f.2 (ω.auxiliary k f) hm

theorem prefixDigits_valid (hq : 3 ≤ q) (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) :
    MixedRadix.Valid (prefixDigits q ω f hm) :=
  digitBlock_valid q hq f.2 (finRestrict hm (ω.auxiliary k f))

theorem prefixDigits_place (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) :
    MixedRadix.place (prefixDigits q ω f hm) = blockPlace q 0 m :=
  digitBlock_place q f.2 (finRestrict hm (ω.auxiliary k f))

/-- The integer represented by the first `m` complete digit pairs. -/
noncomputable def prefixValue (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) : ℕ :=
  MixedRadix.encode (prefixDigits q ω f hm)

theorem prefixValue_pair_lt_place (hq : 3 ≤ q) (ω : Parameters q)
    {k l m : ℕ} (f : LevelPolynomial q k) (g : LevelPolynomial q l)
    (hmk : m ≤ k) (hml : m ≤ l) :
    prefixValue q ω f hmk + prefixValue q ω g hml < blockPlace q 0 m := by
  exact digitBlock_pair_encode_lt_place q hq f.2 g.2
    (finRestrict hmk (ω.auxiliary k f))
    (finRestrict hml (ω.auxiliary l g))

/-- Pilatte's integer `n_f`, with top digit in `{1,…,q^(3k)}`. -/
noncomputable def encoded (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) : ℕ :=
  MixedRadix.encode (lowerDigits q ω f) +
    MixedRadix.place (lowerDigits q ω f) * ((ω.top k f).val + 1)

theorem blockWithTopList_auxiliaryList (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    blockWithTopList q f.2 0 (auxiliaryList q ω f) ((ω.top k f).val + 1) =
      encoded q ω f := by
  rw [auxiliaryList, blockWithTopList_ofFn,
    blockWithTopValue_eq_encode_add_place_mul]
  rw [encoded, lowerDigits_place]
  rfl

/-- Adjoin a final normalized radix solely to bring the top digit under the
generic mixed-radix uniqueness theorem. -/
noncomputable def fullDigits (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) : List (ℕ × ℕ) :=
  lowerDigits q ω f ++ [(q ^ (3 * k) + 1, (ω.top k f).val + 1)]

theorem fullDigits_valid (hq : 3 ≤ q) (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    MixedRadix.Valid (fullDigits q ω f) := by
  rw [fullDigits, MixedRadix.valid_append]
  refine ⟨lowerDigits_valid q hq ω f, ?_⟩
  simp only [MixedRadix.Valid]
  have hpow : 0 < q ^ (3 * k) := Nat.pow_pos (by omega)
  exact ⟨by omega, by omega, trivial⟩

theorem fullDigits_encode (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    MixedRadix.encode (fullDigits q ω f) = encoded q ω f := by
  rw [fullDigits, MixedRadix.encode_append]
  simp [encoded, MixedRadix.encode, MixedRadix.place]

/-- Taking any whole number of digit pairs below level `k` never reaches the
extra top digit. -/
theorem fullDigits_take_lowerDigits (ω : Parameters q) {k m : ℕ}
    (f : LevelPolynomial q k) (hm : m ≤ k) :
    (fullDigits q ω f).take (2 * m) =
      (lowerDigits q ω f).take (2 * m) := by
  rw [fullDigits, List.take_append_of_le_length]
  change 2 * m ≤ (digitBlock q f.2 0 k (ω.auxiliary k f)).length
  rw [digitBlock_length q f.2 (ω.auxiliary k f)]
  omega

/-- Reduction modulo the place above `m` complete pairs removes all higher
digits, including the oversized top digit. -/
theorem encoded_mod_blockPlace (hq : 3 ≤ q) (ω : Parameters q)
    {k m : ℕ} (f : LevelPolynomial q k) (hm : m ≤ k) :
    encoded q ω f % blockPlace q 0 m = prefixValue q ω f hm := by
  have htake : (fullDigits q ω f).take (2 * m) =
      prefixDigits q ω f hm := by
    rw [fullDigits_take_lowerDigits q ω f hm, ← prefixDigits_eq_take]
  have hmod := MixedRadix.encode_mod_place_take
    (fullDigits_valid q hq ω f) (2 * m)
  rw [htake, prefixDigits_place q ω f hm] at hmod
  simpa only [fullDigits_encode, prefixValue] using hmod

/-- Equality of two candidate sums gives equality of their normalized lower
prefix sums through every level present in all four candidates. -/
theorem prefixValue_pair_eq_of_encoded_add_eq (hq : 3 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ m : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hm₁ : m ≤ k₁) (hm₂ : m ≤ k₂) (hm₃ : m ≤ k₃) (hm₄ : m ≤ k₄)
    (h : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    prefixValue q ω f₁ hm₁ + prefixValue q ω f₂ hm₂ =
      prefixValue q ω f₃ hm₃ + prefixValue q ω f₄ hm₄ := by
  let P := blockPlace q 0 m
  have hmod := congrArg (fun n : ℕ ↦ n % P) h
  rw [Nat.add_mod (encoded q ω f₁) (encoded q ω f₂) P,
    Nat.add_mod (encoded q ω f₃) (encoded q ω f₄) P] at hmod
  rw [encoded_mod_blockPlace q hq ω f₁ hm₁,
    encoded_mod_blockPlace q hq ω f₂ hm₂,
    encoded_mod_blockPlace q hq ω f₃ hm₃,
    encoded_mod_blockPlace q hq ω f₄ hm₄] at hmod
  have hleft := prefixValue_pair_lt_place q hq ω f₁ f₂ hm₁ hm₂
  have hright := prefixValue_pair_lt_place q hq ω f₃ f₄ hm₃ hm₄
  change _ % P = _ % P at hmod
  change _ < P at hleft
  change _ < P at hright
  simpa only [Nat.mod_eq_of_lt hleft, Nat.mod_eq_of_lt hright] using hmod

/-- The equal-sum identity yields the product-log congruences on every
coordinate present in all four candidates. -/
theorem pair_log_modEq_of_encoded_add_eq (hq : 3 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ m : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hm₁ : m ≤ k₁) (hm₂ : m ≤ k₂) (hm₃ : m ≤ k₃) (hm₄ : m ≤ k₄)
    (h : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    ∀ i < m,
      Nat.ModEq (oddRadix q i)
        (primePolynomialLogarithm q i f₁.2 +
          primePolynomialLogarithm q i f₂.2)
        (primePolynomialLogarithm q i f₃.2 +
          primePolynomialLogarithm q i f₄.2) := by
  have hpref := prefixValue_pair_eq_of_encoded_add_eq q hq ω
    f₁ f₂ f₃ f₄ hm₁ hm₂ hm₃ hm₄ h
  have hlogs := digitBlock_pair_log_modEq_of_encode_add_eq q hq
    f₁.2 f₂.2 f₃.2 f₄.2
    (finRestrict hm₁ (ω.auxiliary k₁ f₁))
    (finRestrict hm₂ (ω.auxiliary k₂ f₂))
    (finRestrict hm₃ (ω.auxiliary k₃ f₃))
    (finRestrict hm₄ (ω.auxiliary k₄ f₄)) hpref
  intro i hi
  simpa only [zero_add] using hlogs ⟨i, hi⟩

theorem fullDigits_bases_eq (ω : Parameters q) {k : ℕ}
    (f g : LevelPolynomial q k) :
    (fullDigits q ω f).map Prod.fst = (fullDigits q ω g).map Prod.fst := by
  simp only [fullDigits, List.map_append, List.map_cons, List.map_nil]
  rw [show (lowerDigits q ω f).map Prod.fst =
      (lowerDigits q ω g).map Prod.fst by
    exact digitBlock_bases_eq q f.2 g.2 (ω.auxiliary k f) (ω.auxiliary k g)]

theorem fullDigits_eq_of_encoded_eq (hq : 3 ≤ q) (ω : Parameters q)
    {k : ℕ} {f g : LevelPolynomial q k} (h : encoded q ω f = encoded q ω g) :
    fullDigits q ω f = fullDigits q ω g := by
  apply MixedRadix.encode_injective_of_valid
    (fullDigits_valid q hq ω f) (fullDigits_valid q hq ω g)
    (fullDigits_bases_eq q ω f g)
  simpa only [fullDigits_encode] using h

/-- Equal encoded integers have equal lower digit pairs through every level
present in both candidates. -/
theorem lowerDigits_take_eq_of_encoded_eq (hq : 3 ≤ q) (ω : Parameters q)
    {k l m : ℕ} {f : LevelPolynomial q k} {g : LevelPolynomial q l}
    (hmk : m ≤ k) (hml : m ≤ l) (h : encoded q ω f = encoded q ω g) :
    (lowerDigits q ω f).take (2 * m) =
      (lowerDigits q ω g).take (2 * m) := by
  have hbases :
      ((fullDigits q ω f).take (2 * m)).map Prod.fst =
        ((fullDigits q ω g).take (2 * m)).map Prod.fst := by
    rw [fullDigits_take_lowerDigits q ω f hmk,
      fullDigits_take_lowerDigits q ω g hml]
    exact digitBlock_take_bases_eq q f.2 g.2
      (ω.auxiliary k f) (ω.auxiliary l g) hmk hml
  have henc : MixedRadix.encode (fullDigits q ω f) =
      MixedRadix.encode (fullDigits q ω g) := by
    simpa only [fullDigits_encode] using h
  have hpref := MixedRadix.take_eq_of_encode_eq_of_valid (2 * m)
    (fullDigits_valid q hq ω f) (fullDigits_valid q hq ω g) hbases henc
  simpa only [fullDigits_take_lowerDigits q ω f hmk,
    fullDigits_take_lowerDigits q ω g hml] using hpref

/-- Equality across arbitrary levels recovers every logarithm coordinate
below their common prefix. -/
theorem logarithm_eq_of_encoded_eq_up_to (hq : 3 ≤ q) (ω : Parameters q)
    {k l m : ℕ} {f : LevelPolynomial q k} {g : LevelPolynomial q l}
    (hmk : m ≤ k) (hml : m ≤ l) (h : encoded q ω f = encoded q ω g) :
    ∀ i < m, primePolynomialLogarithm q i f.2 =
      primePolynomialLogarithm q i g.2 := by
  have hpref := lowerDigits_take_eq_of_encoded_eq q hq ω hmk hml h
  intro i hi
  have hh := digitBlock_logarithm_eq_of_take_eq q f.2 g.2
    (ω.auxiliary k f) (ω.auxiliary l g) hmk hml hpref ⟨i, hi⟩
  simpa using hh

theorem lowerDigits_eq_of_encoded_eq (hq : 3 ≤ q) (ω : Parameters q)
    {k : ℕ} {f g : LevelPolynomial q k} (h : encoded q ω f = encoded q ω g) :
    lowerDigits q ω f = lowerDigits q ω g := by
  have hfull := fullDigits_eq_of_encoded_eq q hq ω h
  have htake := congrArg (List.take (2 * k)) hfull
  have hlenf : (lowerDigits q ω f).length = 2 * k := by
    exact digitBlock_length q f.2 (ω.auxiliary k f)
  have hleng : (lowerDigits q ω g).length = 2 * k := by
    exact digitBlock_length q g.2 (ω.auxiliary k g)
  have htakef : List.take (2 * k) (fullDigits q ω f) = lowerDigits q ω f := by
    rw [fullDigits, ← hlenf]
    simp
  have htakeg : List.take (2 * k) (fullDigits q ω g) = lowerDigits q ω g := by
    rw [fullDigits, ← hleng]
    simp
  rw [htakef, htakeg] at htake
  exact htake

theorem logarithm_eq_of_encoded_eq (hq : 3 ≤ q) (ω : Parameters q)
    {k : ℕ} {f g : LevelPolynomial q k} (h : encoded q ω f = encoded q ω g) :
    ∀ i < k, primePolynomialLogarithm q i f.2 =
      primePolynomialLogarithm q i g.2 := by
  intro i hi
  have hb := lowerDigits_eq_of_encoded_eq q hq ω h
  have hh := digitBlock_logarithm_eq_of_eq q f.2 g.2
    (ω.auxiliary k f) (ω.auxiliary k g) hb ⟨i, hi⟩
  simpa using hh

theorem LevelPolynomial.natDegree_lt_sq {k : ℕ} (hk : 2 ≤ k)
    (f : LevelPolynomial q k) : f.val.natDegree < k ^ 2 := by
  have hu := (mem_degreeIndices.mp f.1.property).2.2
  rw [LevelPolynomial.natDegree]
  have hwindow : 7 * (k + 1) ^ 2 ≤ 20 * k ^ 2 := by
    nlinarith
  nlinarith

/-- Degree windows for two distinct levels are disjoint. -/
theorem LevelPolynomial.level_eq_of_val_eq {k l : ℕ}
    (f : LevelPolynomial q k) (g : LevelPolynomial q l)
    (h : f.val = g.val) : k = l := by
  have hdegree := congrArg Polynomial.natDegree h
  have hindex : (f.1 : ℕ) = (g.1 : ℕ) := by
    have htwo : 2 * (f.1 : ℕ) = 2 * (g.1 : ℕ) := by
      simpa only [LevelPolynomial.natDegree] using hdegree
    omega
  have hf := (mem_degreeIndices.mp f.1.property).2
  have hg := (mem_degreeIndices.mp g.1.property).2
  by_contra hkl
  rcases lt_or_gt_of_ne hkl with hlt | hgt
  · have hlin : k + 1 ≤ l := by omega
    have hsquare : (k + 1) ^ 2 ≤ l ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hlin
    rw [hindex] at hf
    nlinarith
  · have hlin : l + 1 ≤ k := by omega
    have hsquare : (l + 1) ^ 2 ≤ k ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hlin
    rw [hindex] at hf
    nlinarith

/-- A polynomial in level at most `k+1` has degree below `k²`, once the
fixed cutoff `k ≥ 4` has removed the small boundary cases. -/
theorem LevelPolynomial.natDegree_lt_sq_of_level_le_succ {k l : ℕ}
    (hk : 4 ≤ k) (hl : l ≤ k + 1) (f : LevelPolynomial q l) :
    f.val.natDegree < k ^ 2 := by
  have hu := (mem_degreeIndices.mp f.1.property).2.2
  have hlin : l + 1 ≤ k + 2 := by omega
  have hsquare : (l + 1) ^ 2 ≤ (k + 2) ^ 2 := by
    simpa only [pow_two] using Nat.mul_self_le_mul_self hlin
  have hkbound : 7 * (k + 2) ^ 2 ≤ 20 * k ^ 2 := by nlinarith
  rw [LevelPolynomial.natDegree]
  nlinarith

/-- Within a fixed level, the deterministic integer encoding is injective. -/
theorem encoded_injective_on_level (hq : 3 ≤ q) (ω : Parameters q)
    {k : ℕ} (hk : 2 ≤ k) :
    Function.Injective (encoded q ω : LevelPolynomial q k → ℕ) := by
  intro f g h
  have hlog := logarithm_eq_of_encoded_eq q hq ω h
  have hdeg : (f.val - g.val).natDegree < k ^ 2 := by
    exact (Polynomial.natDegree_sub_le _ _).trans_lt
      (max_lt (LevelPolynomial.natDegree_lt_sq q hk f)
        (LevelPolynomial.natDegree_lt_sq q hk g))
  have hval : f.val = g.val :=
    primePolynomials_eq_of_logarithms_of_natDegree_lt q k f.2 g.2 hlog hdeg
  exact LevelPolynomial.val_injective hval

theorem topDigit_bounds (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    1 ≤ (ω.top k f).val + 1 ∧ (ω.top k f).val + 1 ≤ q ^ (3 * k) := by
  exact ⟨by omega, (ω.top k f).isLt⟩

theorem place_le_encoded (ω : Parameters q) {k : ℕ}
    (f : LevelPolynomial q k) :
    MixedRadix.place (lowerDigits q ω f) ≤ encoded q ω f := by
  have htop := (topDigit_bounds q ω f).1
  have hmul := Nat.mul_le_mul_left
    (MixedRadix.place (lowerDigits q ω f)) htop
  unfold encoded
  omega

/-- The lower growth bound `q^(k²) < n_f`. -/
theorem pow_sq_lt_encoded (hq : 2 ≤ q) (ω : Parameters q) {k : ℕ}
    (hk : k ≠ 0) (f : LevelPolynomial q k) :
    q ^ (k ^ 2) < encoded q ω f := by
  have hp := pow_lt_blockPlace q hq 0 hk
  have hp' : q ^ (k ^ 2) < MixedRadix.place (lowerDigits q ω f) := by
    rw [lowerDigits_place]
    convert hp using 1 <;> ring
  exact hp'.trans_le (place_le_encoded q ω f)

theorem encoded_lt_place_mul_topBound (hq : 3 ≤ q) (ω : Parameters q)
    {k : ℕ} (f : LevelPolynomial q k) :
    encoded q ω f <
      MixedRadix.place (lowerDigits q ω f) * (q ^ (3 * k) + 1) := by
  have henc := MixedRadix.encode_lt_place (lowerDigits_valid q hq ω f)
  have htop := (topDigit_bounds q ω f).2
  unfold encoded
  calc
    MixedRadix.encode (lowerDigits q ω f) +
        MixedRadix.place (lowerDigits q ω f) * ((ω.top k f).val + 1) <
      MixedRadix.place (lowerDigits q ω f) +
        MixedRadix.place (lowerDigits q ω f) * q ^ (3 * k) :=
      Nat.add_lt_add_of_lt_of_le henc
        (Nat.mul_le_mul_left _ htop)
    _ = MixedRadix.place (lowerDigits q ω f) * (q ^ (3 * k) + 1) := by ring

theorem encoded_lt_pow (hq : 103 ≤ q) (ω : Parameters q)
    {k : ℕ} (f : LevelPolynomial q k) :
    encoded q ω f < q ^ (k ^ 2 + 4 * k + 1) := by
  have hbase : 3 ≤ q := hq.trans' (by norm_num)
  have henc := encoded_lt_place_mul_topBound q hbase ω f
  have hplace : MixedRadix.place (lowerDigits q ω f) ≤ q ^ (k ^ 2 + k) := by
    rw [lowerDigits_place]
    have hp := blockPlace_le_pow q hq 0 k
    convert hp using 1 <;> ring
  have hpowpos : 1 ≤ q ^ (3 * k) := Nat.pow_pos (by omega : 0 < q)
  have htop : q ^ (3 * k) + 1 ≤ q ^ (3 * k + 1) := by
    rw [pow_succ]
    have htwo : q ^ (3 * k) + 1 ≤ 2 * q ^ (3 * k) := by omega
    exact htwo.trans (by
      simpa only [mul_comm] using
        (Nat.mul_le_mul_right (q ^ (3 * k)) (by omega : 2 ≤ q)))
  calc
    encoded q ω f < MixedRadix.place (lowerDigits q ω f) *
        (q ^ (3 * k) + 1) := henc
    _ ≤ q ^ (k ^ 2 + k) * q ^ (3 * k + 1) := Nat.mul_le_mul hplace htop
    _ = q ^ (k ^ 2 + 4 * k + 1) := by
      rw [← pow_add]
      congr 1
      ring

/-- If equal encoded values come from ordered levels `k ≤ l`, their growth
bounds force `l ≤ k+1`. -/
theorem level_le_succ_of_encoded_eq_of_le (hq : 103 ≤ q)
    (ω : Parameters q) {k l : ℕ} (hk : 4 ≤ k) (hkl : k ≤ l)
    {f : LevelPolynomial q k} {g : LevelPolynomial q l}
    (h : encoded q ω f = encoded q ω g) : l ≤ k + 1 := by
  have hl0 : l ≠ 0 := by omega
  have hpowers : q ^ (l ^ 2) < q ^ (k ^ 2 + 4 * k + 1) := by
    calc
      q ^ (l ^ 2) < encoded q ω g := pow_sq_lt_encoded q (by omega) ω hl0 g
      _ = encoded q ω f := h.symm
      _ < q ^ (k ^ 2 + 4 * k + 1) := encoded_lt_pow q hq ω f
  have hexponents : l ^ 2 < k ^ 2 + 4 * k + 1 :=
    (Nat.pow_lt_pow_iff_right (by omega : 1 < q)).mp hpowers
  by_contra hnot
  have hlin : k + 2 ≤ l := by omega
  have hsquare : (k + 2) ^ 2 ≤ l ^ 2 := by
    simpa only [pow_two] using Nat.mul_self_le_mul_self hlin
  nlinarith

/-- In the ordered case, common-prefix logarithms and the degree windows
show that equality of encoded values already forces equality of levels. -/
theorem level_eq_of_encoded_eq_of_le (hq : 103 ≤ q)
    (ω : Parameters q) {k l : ℕ} (hk : 4 ≤ k) (hkl : k ≤ l)
    (f : LevelPolynomial q k) (g : LevelPolynomial q l)
    (h : encoded q ω f = encoded q ω g) : k = l := by
  have hlsucc := level_le_succ_of_encoded_eq_of_le q hq ω hk hkl h
  have hlog := logarithm_eq_of_encoded_eq_up_to q (by omega) ω
    (m := k) (f := f) (g := g) le_rfl hkl h
  have hfdeg := LevelPolynomial.natDegree_lt_sq q (by omega) f
  have hgdeg := LevelPolynomial.natDegree_lt_sq_of_level_le_succ q hk hlsucc g
  have hdeg : (f.val - g.val).natDegree < k ^ 2 :=
    (Polynomial.natDegree_sub_le _ _).trans_lt (max_lt hfdeg hgdeg)
  have hval : f.val = g.val :=
    primePolynomials_eq_of_logarithms_of_natDegree_lt q k f.2 g.2 hlog hdeg
  exact LevelPolynomial.level_eq_of_val_eq q f g hval

/-- Equality of encoded candidates from arbitrary levels at least four
forces those levels to agree. -/
theorem level_eq_of_encoded_eq (hq : 103 ≤ q) (ω : Parameters q)
    {k l : ℕ} (hk : 4 ≤ k) (hl : 4 ≤ l)
    (f : LevelPolynomial q k) (g : LevelPolynomial q l)
    (h : encoded q ω f = encoded q ω g) : k = l := by
  rcases le_total k l with hkl | hlk
  · exact level_eq_of_encoded_eq_of_le q hq ω hk hkl f g h
  · exact (level_eq_of_encoded_eq_of_le q hq ω hl hlk g f h.symm).symm

/-- The disjoint union of all construction levels at or above the fixed
cutoff used by the deterministic argument. -/
abbrev Candidate (q : ℕ) :=
  Σ k : {k : ℕ // 4 ≤ k}, LevelPolynomial q k

/-- The integer encoded by a construction candidate. -/
noncomputable def candidateValue (ω : Parameters q) (x : Candidate q) : ℕ :=
  encoded q ω x.2

/-- The complete mixed-level encoding is injective. -/
theorem candidateValue_injective (hq : 103 ≤ q) (ω : Parameters q) :
    Function.Injective (candidateValue q ω) := by
  rintro ⟨⟨k, hk⟩, f⟩ ⟨⟨l, hl⟩, g⟩ h
  change encoded q ω f = encoded q ω g at h
  have hkl : k = l := level_eq_of_encoded_eq q hq ω hk hl f g h
  subst l
  have hbase : 3 ≤ q := by omega
  have hk2 : 2 ≤ k := by omega
  have hfg : f = g := encoded_injective_on_level q hbase ω hk2 h
  subst g
  rfl

/-- A canonical candidate in level `n+4`; used only to witness that the
candidate family is infinite. -/
noncomputable def candidateAtOffset (n : ℕ) : Candidate q :=
  ⟨⟨n + 4, by omega⟩,
    Classical.choice (levelPolynomial_nonempty q (n + 4) (by omega))⟩

theorem candidateAtOffset_injective :
    Function.Injective (candidateAtOffset q) := by
  intro m n h
  have hh := congrArg (fun x : Candidate q ↦ (x.1 : ℕ)) h
  simpa only [candidateAtOffset, add_left_inj] using hh

/-- The deterministic set of all encoded candidates for one realization. -/
noncomputable def candidateSet (ω : Parameters q) : Set ℕ :=
  Set.range (candidateValue q ω)

theorem candidateSet_infinite (hq : 103 ≤ q) (ω : Parameters q) :
    (candidateSet q ω).Infinite := by
  have hinj : Function.Injective
      (fun n : ℕ ↦ candidateValue q ω (candidateAtOffset q n)) :=
    (candidateValue_injective q hq ω).comp (candidateAtOffset_injective q)
  exact (Set.infinite_range_of_injective hinj).mono (by
    rintro _ ⟨n, rfl⟩
    exact ⟨candidateAtOffset q n, rfl⟩)

/-! ### Auxiliary marker digits in two-candidate sums -/

/-- The normalized auxiliary coordinate at zero-indexed pair `i` in an
arbitrary natural number. -/
def auxiliaryTrace (n i : ℕ) : ℕ :=
  (n / (blockPlace q 0 i * oddRadix q i)) % 103

/-- At the shorter candidate's level, division removes the two normalized
lower prefixes and leaves the longer suffix plus the short top digit. -/
theorem sum_div_at_shorter_level (hq : 3 ≤ q) (ω : Parameters q)
    {k l : ℕ} (f : LevelPolynomial q l) (g : LevelPolynomial q k)
    (hkl : k ≤ l) :
    (encoded q ω f + encoded q ω g) / blockPlace q 0 k =
      blockWithTopList q f.2 k ((auxiliaryList q ω f).drop k)
          ((ω.top l f).val + 1) +
        ((ω.top k g).val + 1) := by
  let Lf := auxiliaryList q ω f
  let Lg := auxiliaryList q ω g
  have hlenf : Lf.length = l := by simp [Lf]
  have hleng : Lg.length = k := by simp [Lg]
  have htakef : (Lf.take k).length = k := by
    simp [List.length_take, hlenf, Nat.min_eq_left hkl]
  have hh := blockWithTopList_pair_add_div_append q hq (i := 0) f.2 g.2
    (Lf.take k) Lg (Lf.drop k) [] (by omega)
    ((ω.top l f).val + 1) ((ω.top k g).val + 1)
  calc
    _ = (blockWithTopList q f.2 0 Lf ((ω.top l f).val + 1) +
          blockWithTopList q g.2 0 Lg ((ω.top k g).val + 1)) /
        blockPlace q 0 k := by
          rw [blockWithTopList_auxiliaryList q ω f,
            blockWithTopList_auxiliaryList q ω g]
    _ = (blockWithTopList q f.2 0 (Lf.take k ++ Lf.drop k)
            ((ω.top l f).val + 1) +
          blockWithTopList q g.2 0 (Lg ++ []) ((ω.top k g).val + 1)) /
        blockPlace q 0 k := by
          rw [List.take_append_drop, List.append_nil]
    _ = _ := by
      simpa only [htakef, hleng, zero_add, blockWithTopList, Lf] using hh

/-- At every coordinate at least three pairs beyond the shorter level, the
quotient of the two-candidate sum is exactly the longer candidate's suffix. -/
theorem sum_div_blockPlace_eq_long_suffix (hq : 3 ≤ q)
    (ω : Parameters q) {k l j : ℕ}
    (f : LevelPolynomial q l) (g : LevelPolynomial q k)
    (hstart : k + 3 ≤ j) (hj : j < l) :
    (encoded q ω f + encoded q ω g) / blockPlace q 0 j =
      blockWithTopList q f.2 j
        ((auxiliaryList q ω f).drop k |>.drop (j - k))
        ((ω.top l f).val + 1) := by
  let T := (auxiliaryList q ω f).drop k
  let r := j - k
  let zf := (ω.top l f).val + 1
  let zg := (ω.top k g).val + 1
  have hkl : k ≤ l := by omega
  have hkr : k + r = j := by simp [r, Nat.add_sub_of_le (by omega : k ≤ j)]
  have hr3 : 3 ≤ r := by omega
  have hlenT : T.length = l - k := by
    simp [T, auxiliaryList_length]
  have hrlen : r < T.length := by omega
  have htake : (T.take r).length = r := by
    simp [List.length_take, Nat.min_eq_left hrlen.le]
  have hprefix := two_mul_digitBlockList_encode_lt_place q hq (i := k)
    f.2 (T.take r)
  rw [htake] at hprefix
  have hzg : zg ≤ q ^ (3 * k) := topDigit_bounds q ω g |>.2
  have htop3 : 2 * zg < blockPlace q k 3 :=
    (Nat.mul_le_mul_left 2 hzg).trans_lt
      (two_mul_topBound_lt_blockPlace_three q (by omega) k)
  have htop : 2 * zg < blockPlace q k r :=
    htop3.trans_le (blockPlace_mono_length q k hr3)
  have hsmall :
      MixedRadix.encode (digitBlockList q f.2 k (T.take r)) + zg <
        blockPlace q k r := by omega
  have hdivr :
      (blockWithTopList q f.2 k T zf + zg) / blockPlace q k r =
        blockWithTopList q f.2 j (T.drop r) zf := by
    calc
      _ = (blockWithTopList q f.2 k (T.take r ++ T.drop r) zf + zg) /
          blockPlace q k r := by rw [List.take_append_drop]
      _ = (MixedRadix.encode (digitBlockList q f.2 k (T.take r)) +
            blockPlace q k r * blockWithTopList q f.2 j (T.drop r) zf + zg) /
          blockPlace q k r := by
            rw [blockWithTopList_append, htake, hkr]
      _ = ((MixedRadix.encode (digitBlockList q f.2 k (T.take r)) + zg) +
            blockPlace q k r * blockWithTopList q f.2 j (T.drop r) zf) /
          blockPlace q k r := by congr 1 <;> omega
      _ = _ := by
        rw [Nat.add_mul_div_left _ _ (blockPlace_pos q k r),
          Nat.div_eq_of_lt hsmall, zero_add]
  have hplace : blockPlace q 0 j =
      blockPlace q 0 k * blockPlace q k r := by
    rw [← hkr, blockPlace_add q 0 k r, zero_add]
  calc
    (encoded q ω f + encoded q ω g) / blockPlace q 0 j =
        (encoded q ω f + encoded q ω g) /
          (blockPlace q 0 k * blockPlace q k r) := by
            rw [hplace]
    _ = ((encoded q ω f + encoded q ω g) / blockPlace q 0 k) /
          blockPlace q k r := by rw [Nat.div_div_eq_div_mul]
    _ = (blockWithTopList q f.2 k T zf + zg) / blockPlace q k r := by
          rw [sum_div_at_shorter_level q hq ω f g hkl]
    _ = _ := by simpa only [T, r, zf] using hdivr

/-- The longer candidate's logarithm digit can be read directly from a sum
once the shorter top has passed through three pairs. -/
theorem long_log_eq_logTrace_of_shorter (hq : 3 ≤ q)
    (ω : Parameters q) {k l j : ℕ}
    (f : LevelPolynomial q l) (g : LevelPolynomial q k)
    (hstart : k + 3 ≤ j) (hj : j < l) :
    ((encoded q ω f + encoded q ω g) / blockPlace q 0 j) % oddRadix q j =
      primePolynomialLogarithm q j f.2 := by
  have hdiv := sum_div_blockPlace_eq_long_suffix q hq ω f g hstart hj
  let U := (auxiliaryList q ω f).drop k |>.drop (j - k)
  have hlen : U.length = l - k - (j - k) := by
    simp only [U, List.length_drop, auxiliaryList_length]
  have hne : U ≠ [] := by
    intro hnil
    have hh := congrArg List.length hnil
    rw [hlen] at hh
    simp at hh
    omega
  obtain ⟨a, as, ha⟩ := List.exists_cons_of_ne_nil hne
  rw [hdiv]
  change blockWithTopList q f.2 j U ((ω.top l f).val + 1) % oddRadix q j = _
  rw [ha]
  exact blockWithTopList_head_log q f.2 a as ((ω.top l f).val + 1)

/-- Every auxiliary trace in the uncontaminated tail is one certified
auxiliary digit. -/
theorem auxiliaryTrace_mem_of_shorter_add_three_le (hq : 3 ≤ q)
    (ω : Parameters q) {k l j : ℕ}
    (f : LevelPolynomial q l) (g : LevelPolynomial q k)
    (hstart : k + 3 ≤ j) (hj : j < l) :
    auxiliaryTrace q (encoded q ω f + encoded q ω g) j ∈ auxiliaryDigitSet := by
  have hdiv := sum_div_blockPlace_eq_long_suffix q hq ω f g hstart hj
  let U := (auxiliaryList q ω f).drop k |>.drop (j - k)
  have hlen : U.length = l - k - (j - k) := by
    simp only [U, List.length_drop, auxiliaryList_length]
  have hne : U ≠ [] := by
    intro hnil
    have hh := congrArg List.length hnil
    rw [hlen] at hh
    simp at hh
    omega
  obtain ⟨a, as, ha⟩ := List.exists_cons_of_ne_nil hne
  have htrace : auxiliaryTrace q (encoded q ω f + encoded q ω g) j = (a : ℕ) := by
    unfold auxiliaryTrace
    rw [← Nat.div_div_eq_div_mul, hdiv]
    change (blockWithTopList q f.2 j U ((ω.top l f).val + 1) /
      oddRadix q j) % 103 = _
    rw [ha]
    exact blockWithTopList_head_aux q hq f.2 a as ((ω.top l f).val + 1)
  rw [htrace]
  exact auxiliaryDigit_mem a

/-- Below both candidate levels, the auxiliary coordinate of their sum is
in `A+A+{0,1}`. -/
theorem auxiliaryTrace_pairCarry_of_lt_levels (hq : 3 ≤ q)
    (ω : Parameters q) {k l i : ℕ}
    (f : LevelPolynomial q k) (g : LevelPolynomial q l)
    (hik : i < k) (hil : i < l) :
    PairCarryRepresentedBy auxiliaryDigitSet
      (auxiliaryTrace q (encoded q ω f + encoded q ω g) i) := by
  let Lf := auxiliaryList q ω f
  let Lg := auxiliaryList q ω g
  have hlenf : Lf.length = k := by simp [Lf]
  have hleng : Lg.length = l := by simp [Lg]
  have htakef : (Lf.take i).length = i := by simp [List.length_take, hlenf, Nat.min_eq_left hik.le]
  have htakeg : (Lg.take i).length = i := by simp [List.length_take, hleng, Nat.min_eq_left hil.le]
  have hdiv :
      (encoded q ω f + encoded q ω g) / blockPlace q 0 i =
        blockWithTopList q f.2 i (Lf.drop i) ((ω.top k f).val + 1) +
          blockWithTopList q g.2 i (Lg.drop i) ((ω.top l g).val + 1) := by
    have hh := blockWithTopList_pair_add_div_append q hq (i := 0) f.2 g.2
      (Lf.take i) (Lg.take i) (Lf.drop i) (Lg.drop i)
      (by omega) ((ω.top k f).val + 1) ((ω.top l g).val + 1)
    calc
      _ = (blockWithTopList q f.2 0 Lf ((ω.top k f).val + 1) +
            blockWithTopList q g.2 0 Lg ((ω.top l g).val + 1)) /
          blockPlace q 0 i := by
            rw [blockWithTopList_auxiliaryList q ω f,
              blockWithTopList_auxiliaryList q ω g]
      _ = (blockWithTopList q f.2 0 (Lf.take i ++ Lf.drop i)
              ((ω.top k f).val + 1) +
            blockWithTopList q g.2 0 (Lg.take i ++ Lg.drop i)
              ((ω.top l g).val + 1)) / blockPlace q 0 i := by
            rw [List.take_append_drop, List.take_append_drop]
      _ = _ := by simpa only [htakef, htakeg, zero_add] using hh
  have hdropf : Lf.drop i ≠ [] := by
    intro hnil
    have := congrArg List.length hnil
    simp [List.length_drop, hlenf] at this
    omega
  have hdropg : Lg.drop i ≠ [] := by
    intro hnil
    have := congrArg List.length hnil
    simp [List.length_drop, hleng] at this
    omega
  obtain ⟨a, as, haf⟩ := List.exists_cons_of_ne_nil hdropf
  obtain ⟨b, bs, hbg⟩ := List.exists_cons_of_ne_nil hdropg
  let ef := primePolynomialLogarithm q i f.2
  let eg := primePolynomialLogarithm q i g.2
  let carry := (ef + eg) / oddRadix q i
  have hcarry : carry ≤ 1 := by
    have hc := MixedRadix.two_digit_carry_le_one (carry := 0)
      (oddRadix_pos (by omega))
      (primePolynomialLogarithm_lt_radix q i f.2)
      (primePolynomialLogarithm_lt_radix q i g.2) (by omega)
    simpa only [carry, ef, eg, add_zero] using hc
  have htrace : auxiliaryTrace q (encoded q ω f + encoded q ω g) i =
      (a : ℕ) + (b : ℕ) + carry := by
    unfold auxiliaryTrace
    rw [← Nat.div_div_eq_div_mul, hdiv, haf, hbg]
    exact blockWithTopList_pair_head_aux q hq f.2 g.2 a b as bs
      ((ω.top k f).val + 1) ((ω.top l g).val + 1)
  exact ⟨a, auxiliaryDigit_mem a, b, auxiliaryDigit_mem b, carry, hcarry, htrace⟩

/-- If the second candidate ends at level `k`, then from coordinate `k+3`
onward its top coefficient has disappeared.  At that coordinate the
auxiliary trace is therefore the single auxiliary digit of the longer
candidate. -/
theorem auxiliaryTrace_mem_of_shorter_add_four_le (hq : 3 ≤ q)
    (ω : Parameters q) {k l : ℕ}
    (f : LevelPolynomial q l) (g : LevelPolynomial q k)
    (hlevels : k + 4 ≤ l) :
    auxiliaryTrace q (encoded q ω f + encoded q ω g) (k + 3) ∈
      auxiliaryDigitSet := by
  let Lf := auxiliaryList q ω f
  let Lg := auxiliaryList q ω g
  let zf := (ω.top l f).val + 1
  let zg := (ω.top k g).val + 1
  have hlenf : Lf.length = l := by simp [Lf]
  have hleng : Lg.length = k := by simp [Lg]
  have htakef : (Lf.take k).length = k := by
    simp [List.length_take, hlenf, Nat.min_eq_left (by omega : k ≤ l)]
  have hdivk :
      (encoded q ω f + encoded q ω g) / blockPlace q 0 k =
        blockWithTopList q f.2 k (Lf.drop k) zf + zg := by
    have hh := blockWithTopList_pair_add_div_append q hq (i := 0) f.2 g.2
      (Lf.take k) Lg (Lf.drop k) [] (by omega) zf zg
    calc
      _ = (blockWithTopList q f.2 0 Lf zf +
            blockWithTopList q g.2 0 Lg zg) / blockPlace q 0 k := by
              rw [blockWithTopList_auxiliaryList q ω f,
                blockWithTopList_auxiliaryList q ω g]
      _ = (blockWithTopList q f.2 0 (Lf.take k ++ Lf.drop k) zf +
            blockWithTopList q g.2 0 (Lg ++ []) zg) /
          blockPlace q 0 k := by
              rw [List.take_append_drop, List.append_nil]
      _ = _ := by
        simpa only [htakef, hleng, zero_add, blockWithTopList] using hh
  let T := Lf.drop k
  have hlenT : T.length = l - k := by simp [T, List.length_drop, hlenf]
  have hthree : (T.take 3).length = 3 := by
    simp [List.length_take, hlenT, Nat.min_eq_left (by omega : 3 ≤ l - k)]
  have hzg : zg ≤ q ^ (3 * k) := by
    exact topDigit_bounds q ω g |>.2
  have hsmall :
      MixedRadix.encode (digitBlockList q f.2 k (T.take 3)) + zg <
        blockPlace q k 3 :=
    digitBlockList_three_add_top_lt_place q hq f.2 (T.take 3) hthree hzg
  have hdivthree :
      (blockWithTopList q f.2 k T zf + zg) / blockPlace q k 3 =
        blockWithTopList q f.2 (k + 3) (T.drop 3) zf := by
    calc
      _ = (blockWithTopList q f.2 k (T.take 3 ++ T.drop 3) zf + zg) /
          blockPlace q k 3 := by rw [List.take_append_drop]
      _ = (MixedRadix.encode (digitBlockList q f.2 k (T.take 3)) +
            blockPlace q k 3 *
              blockWithTopList q f.2 (k + 3) (T.drop 3) zf + zg) /
          blockPlace q k 3 := by rw [blockWithTopList_append, hthree]
      _ = ((MixedRadix.encode (digitBlockList q f.2 k (T.take 3)) + zg) +
            blockPlace q k 3 *
              blockWithTopList q f.2 (k + 3) (T.drop 3) zf) /
          blockPlace q k 3 := by
            congr 1
            omega
      _ = _ := by
        rw [Nat.add_mul_div_left _ _ (blockPlace_pos q k 3),
          Nat.div_eq_of_lt hsmall, zero_add]
  have hdrop : T.drop 3 ≠ [] := by
    intro hnil
    have hh := congrArg List.length hnil
    simp [List.length_drop, hlenT] at hh
    omega
  obtain ⟨a, as, ha⟩ := List.exists_cons_of_ne_nil hdrop
  have hdivthree' :
      (blockWithTopList q f.2 k (Lf.drop k) zf + zg) / blockPlace q k 3 =
        blockWithTopList q f.2 (k + 3) (T.drop 3) zf := by
    simpa only [T] using hdivthree
  have htrace :
      auxiliaryTrace q (encoded q ω f + encoded q ω g) (k + 3) = (a : ℕ) := by
    unfold auxiliaryTrace
    rw [blockPlace_add q 0 k 3, zero_add]
    rw [← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul,
      hdivk, hdivthree', ha]
    simpa only [zero_add] using
      blockWithTopList_head_aux q hq f.2 a as zf
  rw [htrace]
  exact auxiliaryDigit_mem a

/-- The growth windows force the larger level in one representation of a
common pair sum to lie within one of the larger level in the other
representation.  This is the first alignment estimate in the Sidon proof. -/
theorem largest_level_le_succ_of_pair_sum_le (hq : 103 ≤ q)
    (ω : Parameters q) {k₁ k₃ k₄ : ℕ}
    (hk₁ : 4 ≤ k₁) (hk₄₃ : k₄ ≤ k₃)
    (f₁ : LevelPolynomial q k₁) (f₃ : LevelPolynomial q k₃)
    (f₄ : LevelPolynomial q k₄)
    (hsum : encoded q ω f₁ ≤ encoded q ω f₃ + encoded q ω f₄) :
    k₁ ≤ k₃ + 1 := by
  let E := k₃ ^ 2 + 4 * k₃ + 1
  have he : k₄ ^ 2 + 4 * k₄ + 1 ≤ E := by
    dsimp only [E]
    nlinarith
  have hpow : q ^ (k₄ ^ 2 + 4 * k₄ + 1) ≤ q ^ E :=
    Nat.pow_le_pow_right (by omega) he
  have hf₃ : encoded q ω f₃ < q ^ E := by
    simpa only [E] using encoded_lt_pow q hq ω f₃
  have hf₄ : encoded q ω f₄ < q ^ E :=
    (encoded_lt_pow q hq ω f₄).trans_le hpow
  have hdouble : q ^ E + q ^ E ≤ q ^ (E + 1) := by
    rw [pow_succ]
    calc
      q ^ E + q ^ E = 2 * q ^ E := by omega
      _ ≤ q * q ^ E := Nat.mul_le_mul_right _ (by omega)
      _ = q ^ E * q := by ac_rfl
  have hpowers : q ^ (k₁ ^ 2) < q ^ (E + 1) := by
    calc
      q ^ (k₁ ^ 2) < encoded q ω f₁ :=
        pow_sq_lt_encoded q (by omega) ω (by omega) f₁
      _ ≤ encoded q ω f₃ + encoded q ω f₄ := hsum
      _ < q ^ E + q ^ E := Nat.add_lt_add hf₃ hf₄
      _ ≤ q ^ (E + 1) := hdouble
  have hexponents : k₁ ^ 2 < E + 1 :=
    (Nat.pow_lt_pow_iff_right (by omega : 1 < q)).mp hpowers
  by_contra hnot
  have hlin : k₃ + 2 ≤ k₁ := by omega
  have hsquare : (k₃ + 2) ^ 2 ≤ k₁ ^ 2 := by
    simpa only [pow_two] using Nat.mul_self_le_mul_self hlin
  dsimp only [E] at hexponents
  nlinarith

/-- Once the larger levels have been aligned by growth, the auxiliary
marker forbids the smaller levels from differing by five or more. -/
theorem second_level_le_add_four_of_pair_sum_eq (hq : 103 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ : ℕ}
    (hk₂ : 4 ≤ k₂) (hk₂₁ : k₂ ≤ k₁) (hk₄₃ : k₄ ≤ k₃)
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    k₂ ≤ k₄ + 4 := by
  have hk₁ : 4 ≤ k₁ := hk₂.trans hk₂₁
  have hlarge : k₁ ≤ k₃ + 1 :=
    largest_level_le_succ_of_pair_sum_le q hq ω hk₁ hk₄₃ f₁ f₃ f₄ (by
      calc
        encoded q ω f₁ ≤ encoded q ω f₁ + encoded q ω f₂ := Nat.le_add_right _ _
        _ = encoded q ω f₃ + encoded q ω f₄ := hsum)
  by_contra hnot
  have hgap : k₄ + 5 ≤ k₂ := by omega
  have hright : k₄ + 4 ≤ k₃ := by omega
  have hpair := auxiliaryTrace_pairCarry_of_lt_levels q (by omega) ω f₁ f₂
    (i := k₄ + 3) (by omega) (by omega)
  have hsingle := auxiliaryTrace_mem_of_shorter_add_three_le q (by omega) ω
    f₃ f₄ (j := k₄ + 3) (by omega) (by omega)
  have htrace := congrArg (fun n : ℕ => auxiliaryTrace q n (k₄ + 3)) hsum
  obtain ⟨a, ha, b, hb, κ, hκ, hp⟩ := hpair
  have hsep := explicitAuxiliarySet.2.1 hsingle ha hb hκ
  exact hsep (htrace.symm.trans hp)

/-- The two ordered smaller levels in equal pair representations differ by
at most four in both directions. -/
theorem second_levels_close_of_pair_sum_eq (hq : 103 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ : ℕ}
    (hk₂ : 4 ≤ k₂) (hk₄ : 4 ≤ k₄)
    (hk₂₁ : k₂ ≤ k₁) (hk₄₃ : k₄ ≤ k₃)
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    k₂ ≤ k₄ + 4 ∧ k₄ ≤ k₂ + 4 := by
  exact ⟨second_level_le_add_four_of_pair_sum_eq q hq ω hk₂ hk₂₁ hk₄₃
      f₁ f₂ f₃ f₄ hsum,
    second_level_le_add_four_of_pair_sum_eq q hq ω hk₄ hk₄₃ hk₂₁
      f₃ f₄ f₁ f₂ hsum.symm⟩

/-! ### Interval Chinese remaindering -/

/-- Product of the auxiliary irreducibles with indices in `[a,b)`. -/
noncomputable def intervalModulus (q a b : ℕ) [Fact q.Prime] :
    Polynomial (ZMod q) :=
  ∏ i ∈ Finset.Ico a b, PolynomialInfrastructure.auxiliaryIrreducible q i

theorem intervalModulus_monic (q a b : ℕ) [Fact q.Prime] :
    (intervalModulus q a b).Monic := by
  apply Polynomial.monic_prod_of_monic
  intro i _hi
  exact PolynomialInfrastructure.auxiliaryIrreducible_monic q i

theorem sum_odd_Ico {a b : ℕ} (hab : a ≤ b) :
    ∑ i ∈ Finset.Ico a b, (2 * i + 1) = b ^ 2 - a ^ 2 := by
  induction b with
  | zero =>
      have ha : a = 0 := by omega
      subst a
      simp
  | succ b ih =>
      by_cases h : a ≤ b
      · have hset : Finset.Ico a (b + 1) = insert b (Finset.Ico a b) := by
          ext i
          simp
          omega
        rw [hset, Finset.sum_insert (by simp), ih h]
        have hsquare : a ^ 2 ≤ b ^ 2 := by
          simpa only [pow_two] using Nat.mul_self_le_mul_self h
        have hsquare' : a ^ 2 ≤ (b + 1) ^ 2 := hsquare.trans (by nlinarith)
        have hsub : b ^ 2 - a ^ 2 + a ^ 2 = b ^ 2 :=
          Nat.sub_add_cancel hsquare
        have hsub' : (b + 1) ^ 2 - a ^ 2 + a ^ 2 = (b + 1) ^ 2 :=
          Nat.sub_add_cancel hsquare'
        nlinarith
      · have ha : a = b + 1 := by omega
        subst a
        simp

theorem intervalModulus_natDegree (q a b : ℕ) [Fact q.Prime] (hab : a ≤ b) :
    (intervalModulus q a b).natDegree = b ^ 2 - a ^ 2 := by
  unfold intervalModulus
  rw [Polynomial.natDegree_prod_of_monic]
  · simpa only [PolynomialInfrastructure.auxiliaryIrreducible_natDegree] using
      sum_odd_Ico hab
  · intro i _hi
    exact PolynomialInfrastructure.auxiliaryIrreducible_monic q i

theorem intervalModulus_dvd {q a b : ℕ} [Fact q.Prime]
    {F : Polynomial (ZMod q)}
    (h : ∀ i, a ≤ i → i < b →
      PolynomialInfrastructure.auxiliaryIrreducible q i ∣ F) :
    intervalModulus q a b ∣ F := by
  unfold intervalModulus
  apply Finset.prod_dvd_of_coprime
  · intro i hi j hj hij
    exact PolynomialInfrastructure.auxiliaryIrreducible_coprime q hij
  · intro i hi
    have hii := Finset.mem_Ico.mp hi
    exact h i hii.1 hii.2

/-- Equality of the logarithm coordinates on an interval aggregates to a
single divisibility statement whose modulus has degree `b²-a²`. -/
theorem intervalModulus_dvd_sub_of_primePolynomialLogarithms
    {a b d₁ d₃ : ℕ}
    (f₁ : PrimePolynomials.OfDegree q (2 * d₁))
    (f₃ : PrimePolynomials.OfDegree q (2 * d₃))
    (hlog : ∀ i, a ≤ i → i < b →
      primePolynomialLogarithm q i f₁ = primePolynomialLogarithm q i f₃) :
    intervalModulus q a b ∣
      (f₁ : Polynomial (ZMod q)) - (f₃ : Polynomial (ZMod q)) := by
  apply intervalModulus_dvd
  intro i hai hib
  exact auxiliaryIrreducible_dvd_sub_of_primePolynomialLogarithm_eq q i f₁ f₃
    (hlog i hai hib)

/-- Equal encoded pair sums give product congruence modulo all auxiliary
irreducibles below any common level. -/
theorem modulusProduct_dvd_levelProduct_sub_of_encoded_add_eq (hq : 3 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ m : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hm₁ : m ≤ k₁) (hm₂ : m ≤ k₂) (hm₃ : m ≤ k₃) (hm₄ : m ≤ k₄)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    PolynomialInfrastructure.modulusProduct q m ∣
      f₁.val * f₂.val - f₃.val * f₄.val := by
  let hnot : ∀ {k : ℕ} (f : LevelPolynomial q k) (i : ℕ),
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ f.val :=
    fun f i => auxiliaryIrreducible_not_dvd_even_irreducible q i
      f.irreducible f.natDegree
  apply modulusProduct_dvd_product_sub_of_logarithm_modEq q m
    (fun i _hi => hnot f₁ i) (fun i _hi => hnot f₂ i)
    (fun i _hi => hnot f₃ i) (fun i _hi => hnot f₄ i)
  intro i hi
  have hlogs := pair_log_modEq_of_encoded_add_eq q hq ω f₁ f₂ f₃ f₄
    hm₁ hm₂ hm₃ hm₄ hsum i hi
  simpa only [primePolynomialLogarithm, oddRadix, LevelPolynomial.val] using hlogs

/-- On the uncontaminated interval above both smaller levels and below both
larger levels, an equal pair sum gives equality of the two larger
polynomials' logarithm coordinates, hence an interval divisibility. -/
theorem intervalModulus_dvd_larger_sub_of_encoded_add_eq (hq : 3 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ a b : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (ha₂ : k₂ + 3 ≤ a) (ha₄ : k₄ + 3 ≤ a)
    (hb₁ : b ≤ k₁) (hb₃ : b ≤ k₃)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    intervalModulus q a b ∣ f₁.val - f₃.val := by
  apply intervalModulus_dvd_sub_of_primePolynomialLogarithms
  intro i hai hib
  have hleft := long_log_eq_logTrace_of_shorter q hq ω f₁ f₂
    (j := i) (by omega) (by omega)
  have hright := long_log_eq_logTrace_of_shorter q hq ω f₃ f₄
    (j := i) (by omega) (by omega)
  calc
    primePolynomialLogarithm q i f₁.2 =
        ((encoded q ω f₁ + encoded q ω f₂) / blockPlace q 0 i) % oddRadix q i :=
      hleft.symm
    _ = ((encoded q ω f₃ + encoded q ω f₄) / blockPlace q 0 i) % oddRadix q i := by
      rw [hsum]
    _ = primePolynomialLogarithm q i f₃.2 := hright

/-- The degree-window upper inequality in an integer form convenient for
the final numerical comparison. -/
theorem LevelPolynomial.twenty_mul_natDegree_lt {k : ℕ}
    (f : LevelPolynomial q k) :
    20 * f.val.natDegree < 7 * (k + 1) ^ 2 := by
  have hu := (mem_degreeIndices.mp f.1.property).2.2
  rw [LevelPolynomial.natDegree]
  nlinarith

theorem LevelPolynomial.twenty_mul_natDegree_lt_of_level_le
    {k K : ℕ} (f : LevelPolynomial q k) (hkK : k ≤ K) :
    20 * f.val.natDegree < 7 * (K + 1) ^ 2 := by
  have hsquare : (k + 1) ^ 2 ≤ (K + 1) ^ 2 := by
    simpa only [pow_two] using Nat.mul_self_le_mul_self (by omega : k + 1 ≤ K + 1)
  exact (f.twenty_mul_natDegree_lt).trans_le (Nat.mul_le_mul_left 7 hsquare)

/-- Uniform upper degree bound for a difference of two products whose
larger and smaller factors lie below levels `K` and `S`, respectively. -/
theorem levelProduct_sub_twenty_mul_natDegree_lt
    {k₁ k₂ k₃ k₄ K S : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (h₁ : k₁ ≤ K) (h₃ : k₃ ≤ K) (h₂ : k₂ ≤ S) (h₄ : k₄ ≤ S) :
    20 * (f₁.val * f₂.val - f₃.val * f₄.val).natDegree <
      7 * (K + 1) ^ 2 + 7 * (S + 1) ^ 2 := by
  have hd₁ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₁ h₁
  have hd₂ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₂ h₂
  have hd₃ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₃ h₃
  have hd₄ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₄ h₄
  have hp₁₂ : (f₁.val * f₂.val).natDegree ≤
      f₁.val.natDegree + f₂.val.natDegree := Polynomial.natDegree_mul_le
  have hp₃₄ : (f₃.val * f₄.val).natDegree ≤
      f₃.val.natDegree + f₄.val.natDegree := Polynomial.natDegree_mul_le
  have hsub := Polynomial.natDegree_sub_le (f₁.val * f₂.val) (f₃.val * f₄.val)
  omega

/-- Uniform upper degree bound for the difference of the two larger
polynomials. -/
theorem larger_sub_twenty_mul_natDegree_lt {k₁ k₃ K : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₃ : LevelPolynomial q k₃)
    (h₁ : k₁ ≤ K) (h₃ : k₃ ≤ K) :
    20 * (f₁.val - f₃.val).natDegree < 7 * (K + 1) ^ 2 := by
  have hd₁ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₁ h₁
  have hd₃ := LevelPolynomial.twenty_mul_natDegree_lt_of_level_le (q := q) f₃ h₃
  have hsub := Polynomial.natDegree_sub_le f₁.val f₃.val
  omega

/-- The two degree lower bounds in Pilatte's proof are incompatible with
the degree-window constant `7/20`.  The explicit cutoff absorbs every
bounded shift introduced by the top digits and marker argument. -/
theorem sidon_degree_inequalities_impossible
    {K L S T : ℕ} (hcut : 1000 ≤ T)
    (hLK : L ≤ K) (hKL : K ≤ L + 1)
    (hTS : T ≤ S) (hST : S ≤ T + 4) (hSK : S ≤ K)
    (hprod : 20 * T ^ 2 < 7 * (K + 1) ^ 2 + 7 * (S + 1) ^ 2)
    (hinterval : L ≤ S + 3 ∨
      20 * L ^ 2 < 20 * (S + 3) ^ 2 + 7 * (K + 1) ^ 2) : False := by
  rcases hinterval with hnear | hinterval
  · have hK : K + 1 ≤ T + 9 := by omega
    have hS : S + 1 ≤ T + 5 := by omega
    have hKsq : (K + 1) ^ 2 ≤ (T + 9) ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hK
    have hSsq : (S + 1) ^ 2 ≤ (T + 5) ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hS
    have hweak : 20 * T ^ 2 <
        7 * (T + 9) ^ 2 + 7 * (T + 5) ^ 2 :=
      hprod.trans_le (Nat.add_le_add
        (Nat.mul_le_mul_left 7 hKsq) (Nat.mul_le_mul_left 7 hSsq))
    have hmul : 1000 * T ≤ T ^ 2 := by
      simpa only [pow_two] using Nat.mul_le_mul_right T hcut
    nlinarith
  · have hK : K + 1 ≤ L + 2 := by omega
    have hS₁ : S + 1 ≤ T + 5 := by omega
    have hS₃ : S + 3 ≤ T + 7 := by omega
    have hKsq : (K + 1) ^ 2 ≤ (L + 2) ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hK
    have hS₁sq : (S + 1) ^ 2 ≤ (T + 5) ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hS₁
    have hS₃sq : (S + 3) ^ 2 ≤ (T + 7) ^ 2 := by
      simpa only [pow_two] using Nat.mul_self_le_mul_self hS₃
    have hpweak : 20 * T ^ 2 <
        7 * (L + 2) ^ 2 + 7 * (T + 5) ^ 2 :=
      hprod.trans_le (Nat.add_le_add
        (Nat.mul_le_mul_left 7 hKsq) (Nat.mul_le_mul_left 7 hS₁sq))
    have hiweak : 20 * L ^ 2 <
        20 * (T + 7) ^ 2 + 7 * (L + 2) ^ 2 :=
      hinterval.trans_le (Nat.add_le_add
        (Nat.mul_le_mul_left 20 hS₃sq) (Nat.mul_le_mul_left 7 hKsq))
    have hLcut : 999 ≤ L := by omega
    have hLmul : 999 * L ≤ L ^ 2 := by
      simpa only [pow_two] using Nat.mul_le_mul_right L hLcut
    nlinarith

/-- All algebraic and numerical estimates for the nontrivial case of the
Sidon argument, parameterized by the larger/smaller extrema `K,L,S,T`. -/
theorem nontrivial_pair_sum_impossible (hq : 103 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ K L S T : ℕ}
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hcut : 1000 ≤ T)
    (hLK : L ≤ K) (hKL : K ≤ L + 1)
    (hTS : T ≤ S) (hST : S ≤ T + 4) (hSK : S ≤ K)
    (hk₁K : k₁ ≤ K) (hk₃K : k₃ ≤ K)
    (hk₂S : k₂ ≤ S) (hk₄S : k₄ ≤ S)
    (hTk₁ : T ≤ k₁) (hTk₂ : T ≤ k₂)
    (hTk₃ : T ≤ k₃) (hTk₄ : T ≤ k₄)
    (hLk₁ : L ≤ k₁) (hLk₃ : L ≤ k₃)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄)
    (hlarger_ne : f₁.val ≠ f₃.val)
    (hproduct_ne : f₁.val * f₂.val ≠ f₃.val * f₄.val) : False := by
  have hbase : 3 ≤ q := by omega
  have hdvdProduct := modulusProduct_dvd_levelProduct_sub_of_encoded_add_eq
    q hbase ω f₁ f₂ f₃ f₄ hTk₁ hTk₂ hTk₃ hTk₄ hsum
  have hProductSub : f₁.val * f₂.val - f₃.val * f₄.val ≠ 0 :=
    sub_ne_zero.mpr hproduct_ne
  have hProductLower := Polynomial.natDegree_le_of_dvd hdvdProduct hProductSub
  rw [PolynomialInfrastructure.modulusProduct_natDegree] at hProductLower
  have hProductUpper := levelProduct_sub_twenty_mul_natDegree_lt (q := q)
    f₁ f₂ f₃ f₄ hk₁K hk₃K hk₂S hk₄S
  have hprod : 20 * T ^ 2 <
      7 * (K + 1) ^ 2 + 7 * (S + 1) ^ 2 := by
    omega
  have hinterval : L ≤ S + 3 ∨
      20 * L ^ 2 < 20 * (S + 3) ^ 2 + 7 * (K + 1) ^ 2 := by
    rcases le_total L (S + 3) with hnear | hfar
    · exact Or.inl hnear
    · right
      have hdvdInterval := intervalModulus_dvd_larger_sub_of_encoded_add_eq
        q hbase ω f₁ f₂ f₃ f₄ (a := S + 3) (b := L)
        (by omega) (by omega) hLk₁ hLk₃ hsum
      have hLargerSub : f₁.val - f₃.val ≠ 0 := sub_ne_zero.mpr hlarger_ne
      have hIntervalLower := Polynomial.natDegree_le_of_dvd hdvdInterval hLargerSub
      rw [intervalModulus_natDegree q (S + 3) L hfar] at hIntervalLower
      have hIntervalUpper := larger_sub_twenty_mul_natDegree_lt (q := q)
        f₁ f₃ hk₁K hk₃K
      have hsquare : (S + 3) ^ 2 ≤ L ^ 2 := by
        simpa only [pow_two] using Nat.mul_self_le_mul_self hfar
      have hsub : L ^ 2 - (S + 3) ^ 2 + (S + 3) ^ 2 = L ^ 2 :=
        Nat.sub_add_cancel hsquare
      nlinarith
  exact sidon_degree_inequalities_impossible hcut hLK hKL hTS hST hSK hprod hinterval

/-- For ordered levels, equality of encoded pair sums forces equality of
the unordered pair of underlying prime polynomials. -/
theorem ordered_polynomial_pair_eq_of_encoded_add_eq (hq : 103 ≤ q)
    (ω : Parameters q) {k₁ k₂ k₃ k₄ : ℕ}
    (hk₂ : 1000 ≤ k₂) (hk₄ : 1000 ≤ k₄)
    (hk₂₁ : k₂ ≤ k₁) (hk₄₃ : k₄ ≤ k₃)
    (f₁ : LevelPolynomial q k₁) (f₂ : LevelPolynomial q k₂)
    (f₃ : LevelPolynomial q k₃) (f₄ : LevelPolynomial q k₄)
    (hsum : encoded q ω f₁ + encoded q ω f₂ =
      encoded q ω f₃ + encoded q ω f₄) :
    (f₁.val = f₃.val ∧ f₂.val = f₄.val) ∨
      (f₁.val = f₄.val ∧ f₂.val = f₃.val) := by
  by_cases hproduct : f₁.val * f₂.val = f₃.val * f₄.val
  · exact PolynomialInfrastructure.unordered_pair_eq_of_monic_irreducibles
      f₁.irreducible f₂.irreducible f₃.irreducible f₄.irreducible
      f₁.monic f₂.monic f₃.monic f₄.monic hproduct
  by_cases hlarger : f₁.val = f₃.val
  · have hk₁₃ : k₁ = k₃ := LevelPolynomial.level_eq_of_val_eq q f₁ f₃ hlarger
    subst k₃
    have hf₁₃ : f₁ = f₃ := LevelPolynomial.val_injective hlarger
    subst f₃
    have hencoded₂₄ : encoded q ω f₂ = encoded q ω f₄ :=
      Nat.add_left_cancel hsum
    have hk₂₄ : k₂ = k₄ := level_eq_of_encoded_eq q hq ω
      (by omega) (by omega) f₂ f₄ hencoded₂₄
    subst k₄
    have hf₂₄ : f₂ = f₄ := encoded_injective_on_level q (by omega) ω
      (by omega) hencoded₂₄
    subst f₄
    exact Or.inl ⟨rfl, rfl⟩
  have hk₁ : 4 ≤ k₁ := by omega
  have hk₃ : 4 ≤ k₃ := by omega
  have hlarge₁₃ : k₁ ≤ k₃ + 1 :=
    largest_level_le_succ_of_pair_sum_le q hq ω hk₁ hk₄₃ f₁ f₃ f₄ (by
      calc
        encoded q ω f₁ ≤ encoded q ω f₁ + encoded q ω f₂ := Nat.le_add_right _ _
        _ = encoded q ω f₃ + encoded q ω f₄ := hsum)
  have hlarge₃₁ : k₃ ≤ k₁ + 1 :=
    largest_level_le_succ_of_pair_sum_le q hq ω hk₃ hk₂₁ f₃ f₁ f₂ (by
      calc
        encoded q ω f₃ ≤ encoded q ω f₃ + encoded q ω f₄ := Nat.le_add_right _ _
        _ = encoded q ω f₁ + encoded q ω f₂ := hsum.symm)
  have hseconds := second_levels_close_of_pair_sum_eq q hq ω
    (by omega) (by omega) hk₂₁ hk₄₃ f₁ f₂ f₃ f₄ hsum
  rcases le_total k₁ k₃ with hk₁₃ | hk₃₁
  · rcases le_total k₂ k₄ with hk₂₄ | hk₄₂
    · exfalso
      apply nontrivial_pair_sum_impossible q hq ω f₁ f₂ f₃ f₄
        (K := k₃) (L := k₁) (S := k₄) (T := k₂)
      all_goals first | assumption | omega
    · exfalso
      apply nontrivial_pair_sum_impossible q hq ω f₁ f₂ f₃ f₄
        (K := k₃) (L := k₁) (S := k₂) (T := k₄)
      all_goals first | assumption | omega
  · rcases le_total k₂ k₄ with hk₂₄ | hk₄₂
    · exfalso
      apply nontrivial_pair_sum_impossible q hq ω f₁ f₂ f₃ f₄
        (K := k₁) (L := k₃) (S := k₄) (T := k₂)
      all_goals first | assumption | omega
    · exfalso
      apply nontrivial_pair_sum_impossible q hq ω f₁ f₂ f₃ f₄
        (K := k₁) (L := k₃) (S := k₂) (T := k₄)
      all_goals first | assumption | omega

/-! ### The deterministic Sidon set -/

/-- Candidates after discarding the finite prefix required by the explicit
degree comparison. -/
abbrev SidonCandidate (q : ℕ) :=
  Σ k : {k : ℕ // 1000 ≤ k}, LevelPolynomial q k

noncomputable def sidonCandidateValue (ω : Parameters q)
    (x : SidonCandidate q) : ℕ :=
  encoded q ω x.2

theorem sidonCandidate_eq_of_val_eq {x y : SidonCandidate q}
    (h : x.2.val = y.2.val) : x = y := by
  rcases x with ⟨⟨k, hk⟩, f⟩
  rcases y with ⟨⟨l, hl⟩, g⟩
  have hkl : k = l := LevelPolynomial.level_eq_of_val_eq q f g h
  subst l
  have hfg : f = g := LevelPolynomial.val_injective h
  subst g
  rfl

theorem ordered_sidonCandidate_pair_eq_of_add_eq (hq : 103 ≤ q)
    (ω : Parameters q) (x₁ x₂ x₃ x₄ : SidonCandidate q)
    (h₂₁ : (x₂.1 : ℕ) ≤ x₁.1) (h₄₃ : (x₄.1 : ℕ) ≤ x₃.1)
    (hsum : sidonCandidateValue q ω x₁ + sidonCandidateValue q ω x₂ =
      sidonCandidateValue q ω x₃ + sidonCandidateValue q ω x₄) :
    (x₁ = x₃ ∧ x₂ = x₄) ∨ (x₁ = x₄ ∧ x₂ = x₃) := by
  have hp := ordered_polynomial_pair_eq_of_encoded_add_eq q hq ω
    x₂.1.property x₄.1.property h₂₁ h₄₃ x₁.2 x₂.2 x₃.2 x₄.2 hsum
  rcases hp with h | h
  · exact Or.inl ⟨sidonCandidate_eq_of_val_eq (q := q) h.1,
      sidonCandidate_eq_of_val_eq (q := q) h.2⟩
  · exact Or.inr ⟨sidonCandidate_eq_of_val_eq (q := q) h.1,
      sidonCandidate_eq_of_val_eq (q := q) h.2⟩

theorem sidonCandidate_pair_eq_of_add_eq (hq : 103 ≤ q)
    (ω : Parameters q) (x₁ x₂ x₃ x₄ : SidonCandidate q)
    (hsum : sidonCandidateValue q ω x₁ + sidonCandidateValue q ω x₂ =
      sidonCandidateValue q ω x₃ + sidonCandidateValue q ω x₄) :
    (x₁ = x₃ ∧ x₂ = x₄) ∨ (x₁ = x₄ ∧ x₂ = x₃) := by
  rcases le_total (x₂.1 : ℕ) x₁.1 with h₂₁ | h₁₂
  · rcases le_total (x₄.1 : ℕ) x₃.1 with h₄₃ | h₃₄
    · exact ordered_sidonCandidate_pair_eq_of_add_eq q hq ω
        x₁ x₂ x₃ x₄ h₂₁ h₄₃ hsum
    · have h := ordered_sidonCandidate_pair_eq_of_add_eq q hq ω
        x₁ x₂ x₄ x₃ h₂₁ h₃₄ (by simpa [add_comm] using hsum)
      rcases h with h | h
      · exact Or.inr h
      · exact Or.inl h
  · rcases le_total (x₄.1 : ℕ) x₃.1 with h₄₃ | h₃₄
    · have h := ordered_sidonCandidate_pair_eq_of_add_eq q hq ω
        x₂ x₁ x₃ x₄ h₁₂ h₄₃ (by simpa [add_comm] using hsum)
      rcases h with h | h
      · exact Or.inr ⟨h.2, h.1⟩
      · exact Or.inl ⟨h.2, h.1⟩
    · have h := ordered_sidonCandidate_pair_eq_of_add_eq q hq ω
        x₂ x₁ x₄ x₃ h₁₂ h₃₄ (by simpa [add_comm] using hsum)
      rcases h with h | h
      · exact Or.inl ⟨h.2, h.1⟩
      · exact Or.inr ⟨h.2, h.1⟩

noncomputable def sidonCandidateSet (ω : Parameters q) : Set ℕ :=
  Set.range (sidonCandidateValue q ω)

theorem sidonCandidateSet_isSidon (hq : 103 ≤ q) (ω : Parameters q) :
    IsSidon (sidonCandidateSet q ω) := by
  intro a b c d ha hb hc hd hsum
  obtain ⟨x₁, rfl⟩ := ha
  obtain ⟨x₂, rfl⟩ := hb
  obtain ⟨x₃, rfl⟩ := hc
  obtain ⟨x₄, rfl⟩ := hd
  rcases sidonCandidate_pair_eq_of_add_eq q hq ω x₁ x₂ x₃ x₄ hsum with h | h
  · exact Or.inl ⟨congrArg (sidonCandidateValue q ω) h.1,
      congrArg (sidonCandidateValue q ω) h.2⟩
  · exact Or.inr ⟨congrArg (sidonCandidateValue q ω) h.1,
      congrArg (sidonCandidateValue q ω) h.2⟩

theorem sidonCandidateValue_injective (hq : 103 ≤ q) (ω : Parameters q) :
    Function.Injective (sidonCandidateValue q ω) := by
  rintro ⟨⟨k, hk⟩, f⟩ ⟨⟨l, hl⟩, g⟩ h
  change encoded q ω f = encoded q ω g at h
  have hkl : k = l := level_eq_of_encoded_eq q hq ω (by omega) (by omega) f g h
  subst l
  have hfg : f = g := encoded_injective_on_level q (by omega) ω
    (k := k) (by omega) h
  subst g
  rfl

noncomputable def sidonCandidateAtOffset (n : ℕ) : SidonCandidate q :=
  ⟨⟨n + 1000, by omega⟩,
    Classical.choice (levelPolynomial_nonempty q (n + 1000) (by omega))⟩

theorem sidonCandidateAtOffset_injective :
    Function.Injective (sidonCandidateAtOffset q) := by
  intro m n h
  have hh := congrArg (fun x : SidonCandidate q => (x.1 : ℕ)) h
  simpa only [sidonCandidateAtOffset, add_left_inj] using hh

theorem sidonCandidateSet_infinite (hq : 103 ≤ q) (ω : Parameters q) :
    (sidonCandidateSet q ω).Infinite := by
  have hinj : Function.Injective
      (fun n : ℕ => sidonCandidateValue q ω (sidonCandidateAtOffset q n)) :=
    (sidonCandidateValue_injective q hq ω).comp
      (sidonCandidateAtOffset_injective q)
  exact (Set.infinite_range_of_injective hinj).mono (by
    rintro _ ⟨n, rfl⟩
    exact ⟨sidonCandidateAtOffset q n, rfl⟩)

end Construction

/-! ## Congruent prime-polynomial triples -/

/-- Three-set inclusion--exclusion in the special situation where membership
in any two of the three sets forces membership in all three.  This is the
finite combinatorial identity behind the three-factor repeated-prime sieve. -/
theorem card_three_inclusion_exclusion
    {α : Type*} [Fintype α]
    (p q r : α → Prop) [DecidablePred p] [DecidablePred q]
    [DecidablePred r]
    (hpqr : ∀ x, (p x ∧ q x) ∨ (p x ∧ r x) ∨ (q x ∧ r x) →
      p x ∧ q x ∧ r x) :
    Fintype.card {x : α // ¬ p x ∧ ¬ q x ∧ ¬ r x} +
        Fintype.card {x : α // p x} +
        Fintype.card {x : α // q x} +
        Fintype.card {x : α // r x} =
      Fintype.card α +
        2 * Fintype.card {x : α // p x ∧ q x ∧ r x} := by
  classical
  simp_rw [Fintype.card_subtype]
  simp_rw [Finset.card_filter]
  rw [show Fintype.card α = ∑ _x : α, 1 by simp]
  rw [Finset.mul_sum]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x hx
  specialize hpqr x
  by_cases hp : p x <;> by_cases hq : q x <;> by_cases hr : r x <;>
    simp [hp, hq, hr] at hpqr ⊢

namespace RepresentationFamilies

open PolynomialInfrastructure PrimePolynomials FiniteFieldEncoding

variable (q : ℕ) [Fact q.Prime]

/-- The auxiliary modulus is coprime to every even-degree irreducible.
This is the cancellation fact used when two congruent triples share one
prime-polynomial factor. -/
theorem modulusProduct_isCoprime_primePolynomial (k d : ℕ)
    (f : OfDegree q (2 * d)) :
    IsCoprime (modulusProduct q k) (f : Polynomial (ZMod q)) := by
  unfold modulusProduct
  apply IsCoprime.prod_left
  intro i hi
  rw [(auxiliaryIrreducible_irreducible q i).coprime_iff_not_dvd]
  exact auxiliaryIrreducible_not_dvd_even_irreducible q i
    (PrimePolynomials.irreducible f) (PrimePolynomials.natDegree f)

/-- If two triples of same-degree prime polynomials are congruent modulo
`G_k` and share their first factor, then the remaining unordered pairs are
equal as soon as their product degree is below `deg G_k = k^2`.

This is the exact deterministic disjointness input in Pilatte's independent
trial extraction. -/
theorem remaining_pair_eq_of_shared_factor_modEq (k d : ℕ)
    (f g₁ g₂ h₁ h₂ : OfDegree q (2 * d))
    (hdeg : 4 * d < k ^ 2)
    (hcong : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) * g₁ * g₂ -
        (f : Polynomial (ZMod q)) * h₁ * h₂) :
    (g₁ = h₁ ∧ g₂ = h₂) ∨ (g₁ = h₂ ∧ g₂ = h₁) := by
  have hfactored : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) *
        ((g₁ : Polynomial (ZMod q)) * g₂ -
          (h₁ : Polynomial (ZMod q)) * h₂) := by
    convert hcong using 1 <;> ring
  have hdvd : modulusProduct q k ∣
      (g₁ : Polynomial (ZMod q)) * g₂ -
        (h₁ : Polynomial (ZMod q)) * h₂ :=
    (modulusProduct_isCoprime_primePolynomial q k d f).dvd_of_dvd_mul_left
      hfactored
  have hgdeg : ((g₁ : Polynomial (ZMod q)) * g₂).natDegree = 4 * d := by
    rw [Polynomial.natDegree_mul (PrimePolynomials.irreducible g₁).ne_zero
      (PrimePolynomials.irreducible g₂).ne_zero,
      PrimePolynomials.natDegree, PrimePolynomials.natDegree]
    omega
  have hhdeg : ((h₁ : Polynomial (ZMod q)) * h₂).natDegree = 4 * d := by
    rw [Polynomial.natDegree_mul (PrimePolynomials.irreducible h₁).ne_zero
      (PrimePolynomials.irreducible h₂).ne_zero,
      PrimePolynomials.natDegree, PrimePolynomials.natDegree]
    omega
  have hlt :
      ((g₁ : Polynomial (ZMod q)) * g₂ -
        (h₁ : Polynomial (ZMod q)) * h₂).natDegree <
          (modulusProduct q k).natDegree := by
    rw [modulusProduct_natDegree]
    exact (Polynomial.natDegree_sub_le _ _).trans_lt (by
      rw [hgdeg, hhdeg, max_self]
      exact hdeg)
  have hprod :
      (g₁ : Polynomial (ZMod q)) * g₂ =
        (h₁ : Polynomial (ZMod q)) * h₂ :=
    eq_of_dvd_sub_of_natDegree_lt hdvd hlt
  rcases unordered_pair_eq_of_monic_irreducibles
      (PrimePolynomials.irreducible g₁) (PrimePolynomials.irreducible g₂)
      (PrimePolynomials.irreducible h₁) (PrimePolynomials.irreducible h₂)
      (PrimePolynomials.monic g₁) (PrimePolynomials.monic g₂)
      (PrimePolynomials.monic h₁) (PrimePolynomials.monic h₂) hprod with h | h
  · exact Or.inl ⟨Subtype.ext h.1, Subtype.ext h.2⟩
  · exact Or.inr ⟨Subtype.ext h.1, Subtype.ext h.2⟩

/-- A convenient common-residue version of
`remaining_pair_eq_of_shared_factor_modEq`. -/
theorem remaining_pair_eq_of_shared_factor_common_residue (k d : ℕ)
    (a : Polynomial (ZMod q))
    (f g₁ g₂ h₁ h₂ : OfDegree q (2 * d))
    (hdeg : 4 * d < k ^ 2)
    (hg : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) * g₁ * g₂ - a)
    (hh : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) * h₁ * h₂ - a) :
    (g₁ = h₁ ∧ g₂ = h₂) ∨ (g₁ = h₂ ∧ g₂ = h₁) := by
  have hcong : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) * g₁ * g₂ -
        (f : Polynomial (ZMod q)) * h₁ * h₂ := by
    rcases hg with ⟨u, hu⟩
    rcases hh with ⟨v, hv⟩
    refine ⟨u - v, ?_⟩
    calc
      (f : Polynomial (ZMod q)) * g₁ * g₂ -
          (f : Polynomial (ZMod q)) * h₁ * h₂ =
          ((f : Polynomial (ZMod q)) * g₁ * g₂ - a) -
            ((f : Polynomial (ZMod q)) * h₁ * h₂ - a) := by ring
      _ = modulusProduct q k * u - modulusProduct q k * v := by
        rw [hu, hv]
      _ = modulusProduct q k * (u - v) := by ring
  exact remaining_pair_eq_of_shared_factor_modEq q k d f g₁ g₂ h₁ h₂
    hdeg hcong

/-- An unordered triple of distinct monic irreducibles of one even degree. -/
def PrimeTriple (q d : ℕ) :=
  {s : Finset (OfDegree q (2 * d)) // s.card = 3}

instance primeTripleFinite (d : ℕ) : Finite (PrimeTriple q d) := by
  unfold PrimeTriple
  infer_instance

noncomputable instance primeTripleFintype (d : ℕ) : Fintype (PrimeTriple q d) :=
  by
    unfold PrimeTriple
    infer_instance

/-- An ordering of the three elements of an unordered prime triple.  This
is the exact finite object counted by Sawin's ordered factorization
functions: the second component is a bijection from the three positions to
the underlying three-element finset. -/
def PrimeTripleOrdering (q d : ℕ) :=
  Σ T : PrimeTriple q d, Fin 3 ≃ ↥T.1

noncomputable instance primeTripleOrderingFintype (d : ℕ) :
    Fintype (PrimeTripleOrdering q d) := by
  unfold PrimeTripleOrdering
  infer_instance

/-- A three-element finset has exactly 3! = 6 orderings. -/
theorem primeTriple_ordering_card (d : ℕ) (T : PrimeTriple q d) :
    Fintype.card (Fin 3 ≃ ↥T.1) = 6 := by
  classical
  let e : Fin 3 ≃ ↥T.1 := Fintype.equivOfCardEq (by
    simp only [Fintype.card_fin, Fintype.card_coe, T.2])
  convert Fintype.card_equiv e using 1 <;> norm_num

/-- Consequently the ordered distinct triples are exactly six copies of the
unordered triples. -/
theorem primeTripleOrdering_card (d : ℕ) :
    Fintype.card (PrimeTripleOrdering q d) =
      6 * Fintype.card (PrimeTriple q d) := by
  classical
  unfold PrimeTripleOrdering
  rw [Fintype.card_sigma]
  simp [primeTriple_ordering_card q d, Nat.mul_comm]

/-- Product of the three prime polynomials underlying an unordered triple. -/
noncomputable def PrimeTriple.product {d : ℕ} (T : PrimeTriple q d) :
    Polynomial (ZMod q) :=
  ∏ f ∈ T.1, (f : Polynomial (ZMod q))

/-- A prime-triple product is monic. -/
theorem PrimeTriple.product_monic {d : ℕ} (T : PrimeTriple q d) :
    (T.product q).Monic := by
  unfold PrimeTriple.product
  apply Polynomial.monic_prod_of_monic
  intro f _hf
  exact PrimePolynomials.monic f

/-- The product of three degree-`2d` primes has degree `6d`. -/
theorem PrimeTriple.product_natDegree {d : ℕ} (T : PrimeTriple q d) :
    (T.product q).natDegree = 6 * d := by
  unfold PrimeTriple.product
  rw [Polynomial.natDegree_prod_of_monic]
  · simp only [PrimePolynomials.natDegree, Finset.sum_const_nat, T.2]
    ring
  · intro f _hf
    exact PrimePolynomials.monic f

/-- A product of the three even-degree prime factors is coprime to the
auxiliary modulus, whose irreducible factors all have odd degree. -/
theorem PrimeTriple.product_isCoprime_modulusProduct {d : ℕ}
    (T : PrimeTriple q d) (k : ℕ) :
    IsCoprime (T.product q) (modulusProduct q k) := by
  unfold PrimeTriple.product
  apply IsCoprime.prod_left
  intro f _hf
  exact (modulusProduct_isCoprime_primePolynomial q k d f).symm

/-- Every auxiliary odd-degree irreducible is coprime to the product of an
equal-even-degree prime triple. -/
theorem PrimeTriple.auxiliaryIrreducible_not_dvd_product {d : ℕ}
    (T : PrimeTriple q d) (i : ℕ) :
    ¬ auxiliaryIrreducible q i ∣ T.product q := by
  intro hdiv
  obtain ⟨f, hf, hif⟩ :=
    (auxiliaryIrreducible_irreducible q i).prime.dvd_finsetProd_iff
      (fun f : OfDegree q (2 * d) => (f : Polynomial (ZMod q))) |>.mp hdiv
  exact auxiliaryIrreducible_not_dvd_even_irreducible q i
    (PrimePolynomials.irreducible f) (PrimePolynomials.natDegree f) hif

/-- The finite family of unordered degree-`2d` prime triples in one
invertible residue class modulo `G_k`. -/
noncomputable def congruentPrimeTriples (k d : ℕ)
    (a : Polynomial (ZMod q)) : Finset (PrimeTriple q d) :=
  by
    classical
    exact Finset.univ.filter fun T => modulusProduct q k ∣ T.product q - a

/-- An ordering of an unordered distinct prime triple in one progression.
This dependent-sum presentation gives the exact ordered count without any
choice of a preferred ordering. -/
def CongruentPrimeTripleOrdering (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  Σ T : ↥(congruentPrimeTriples q k d a), Fin 3 ≃ ↥T.1.1

noncomputable instance congruentPrimeTripleOrderingFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentPrimeTripleOrdering q k d a) := by
  unfold CongruentPrimeTripleOrdering
  infer_instance

/-- Exact ordered-to-unordered conversion inside one progression. -/
theorem congruentPrimeTripleOrdering_card (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentPrimeTripleOrdering q k d a) =
      6 * (congruentPrimeTriples q k d a).card := by
  classical
  unfold CongruentPrimeTripleOrdering
  rw [Fintype.card_sigma]
  simp [primeTriple_ordering_card q d, Nat.mul_comm]

/-- Sawin's equal-degree factorization weight on an ordered triple: each of
the three degree-2d prime factors contributes its degree. -/
def primeTripleOrderingWeight (d : ℕ) : ℕ := (2 * d) ^ 3

/-- The total ordered factorization weight in a residue class is six times
the unordered count, times the common von-Mangoldt weight (2d)^3. -/
theorem sum_congruentPrimeTripleOrderingWeight (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    (∑ _T : CongruentPrimeTripleOrdering q k d a,
        primeTripleOrderingWeight d) =
      6 * (2 * d) ^ 3 * (congruentPrimeTriples q k d a).card := by
  classical
  calc
    (∑ _T : CongruentPrimeTripleOrdering q k d a,
        primeTripleOrderingWeight d) =
        Fintype.card (CongruentPrimeTripleOrdering q k d a) *
          primeTripleOrderingWeight d := by simp
    _ = (6 * (congruentPrimeTriples q k d a).card) *
          primeTripleOrderingWeight d := by
      rw [congruentPrimeTripleOrdering_card]
    _ = 6 * (2 * d) ^ 3 * (congruentPrimeTriples q k d a).card := by
      simp only [primeTripleOrderingWeight]
      ring

@[simp]
theorem mem_congruentPrimeTriples {k d : ℕ}
    {a : Polynomial (ZMod q)} {T : PrimeTriple q d} :
    T ∈ congruentPrimeTriples q k d a ↔
      modulusProduct q k ∣ T.product q - a := by
  simp only [congruentPrimeTriples, Finset.mem_filter, Finset.mem_univ,
    true_and]

/-- A common product residue forces the sum of the three discrete-log
digits of an unordered triple to equal the residue digit modulo the
corresponding odd radix. -/
theorem primeTriple_log_sum_modEq_of_common_residue (k d : ℕ)
    (a : Polynomial (ZMod q)) (T : PrimeTriple q d)
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a)
    (hT : modulusProduct q k ∣ T.product q - a)
    (i : ℕ) (hi : i < k) :
    Nat.ModEq (q ^ (2 * i + 1) - 1)
      (∑ f ∈ T.1, primePolynomialLogarithm q i f)
      (logarithm q i (polynomialUnitOfNotDvd q i a (ha i hi))) := by
  obtain ⟨f₁, f₂, f₃, h12, h13, h23, hset⟩ :=
    Finset.card_eq_three.mp T.property
  have hidvd : auxiliaryIrreducible q i ∣ T.product q - a :=
    (auxiliaryIrreducible_dvd_modulusProduct q hi).trans hT
  have h₁ := auxiliaryIrreducible_not_dvd_even_irreducible q i
    (PrimePolynomials.irreducible f₁) (PrimePolynomials.natDegree f₁)
  have h₂ := auxiliaryIrreducible_not_dvd_even_irreducible q i
    (PrimePolynomials.irreducible f₂) (PrimePolynomials.natDegree f₂)
  have h₃ := auxiliaryIrreducible_not_dvd_even_irreducible q i
    (PrimePolynomials.irreducible f₃) (PrimePolynomials.natDegree f₃)
  have hlog := logarithm_sum_three_modEq_of_product_sub_dvd q i
    h₁ h₂ h₃ (ha i hi) (by
      simpa [PrimeTriple.product, hset, h12, h13, h23, mul_assoc] using hidvd)
  simpa [hset, h12, h13, h23, primePolynomialLogarithm, add_assoc] using hlog

/-- Finite sets of monic irreducibles are determined by their polynomial
product.  This is the finite-set form of unique factorization needed below. -/
theorem primePolynomialFinset_eq_of_product_eq (d : ℕ)
    (s t : Finset (OfDegree q (2 * d)))
    (hprod : (∏ f ∈ s, (f : Polynomial (ZMod q))) =
      ∏ f ∈ t, (f : Polynomial (ZMod q))) :
    s = t := by
  apply Finset.Subset.antisymm
  · intro f hf
    have hdivS : (f : Polynomial (ZMod q)) ∣
        ∏ g ∈ s, (g : Polynomial (ZMod q)) :=
      Finset.dvd_prod_of_mem (fun g : OfDegree q (2 * d) =>
        (g : Polynomial (ZMod q))) hf
    have hdivT : (f : Polynomial (ZMod q)) ∣
        ∏ g ∈ t, (g : Polynomial (ZMod q)) := by
      rw [← hprod]
      exact hdivS
    obtain ⟨g, hgt, hfg⟩ :=
      (PrimePolynomials.irreducible f).prime.dvd_finsetProd_iff
        (fun g : OfDegree q (2 * d) =>
          (g : Polynomial (ZMod q))) |>.mp hdivT
    have hval : (f : Polynomial (ZMod q)) = g :=
      Polynomial.eq_of_monic_of_associated
        (PrimePolynomials.monic f) (PrimePolynomials.monic g)
        ((PrimePolynomials.irreducible f).associated_of_dvd
          (PrimePolynomials.irreducible g) hfg)
    have hfg' : f = g := Subtype.ext hval
    simpa only [hfg'] using hgt
  · intro f hf
    have hdivT : (f : Polynomial (ZMod q)) ∣
        ∏ g ∈ t, (g : Polynomial (ZMod q)) :=
      Finset.dvd_prod_of_mem (fun g : OfDegree q (2 * d) =>
        (g : Polynomial (ZMod q))) hf
    have hdivS : (f : Polynomial (ZMod q)) ∣
        ∏ g ∈ s, (g : Polynomial (ZMod q)) := by
      rw [hprod]
      exact hdivT
    obtain ⟨g, hgs, hfg⟩ :=
      (PrimePolynomials.irreducible f).prime.dvd_finsetProd_iff
        (fun g : OfDegree q (2 * d) =>
          (g : Polynomial (ZMod q))) |>.mp hdivS
    have hval : (f : Polynomial (ZMod q)) = g :=
      Polynomial.eq_of_monic_of_associated
        (PrimePolynomials.monic f) (PrimePolynomials.monic g)
        ((PrimePolynomials.irreducible f).associated_of_dvd
          (PrimePolynomials.irreducible g) hfg)
    have hfg' : f = g := Subtype.ext hval
    simpa only [hfg'] using hgs

/-- Two congruent unordered triples that share a prime polynomial are equal
when twice their polynomial degree is below the modulus degree. -/
theorem primeTriple_eq_of_shared_common_residue (k d : ℕ)
    (a : Polynomial (ZMod q)) (U V : PrimeTriple q d)
    (f : OfDegree q (2 * d)) (hfU : f ∈ U.1) (hfV : f ∈ V.1)
    (hdeg : 4 * d < k ^ 2)
    (hU : modulusProduct q k ∣ U.product q - a)
    (hV : modulusProduct q k ∣ V.product q - a) :
    U = V := by
  let pU : Polynomial (ZMod q) :=
    ∏ g ∈ U.1.erase f, (g : Polynomial (ZMod q))
  let pV : Polynomial (ZMod q) :=
    ∏ g ∈ V.1.erase f, (g : Polynomial (ZMod q))
  have hcong : modulusProduct q k ∣ U.product q - V.product q := by
    rcases hU with ⟨u, hu⟩
    rcases hV with ⟨v, hv⟩
    refine ⟨u - v, ?_⟩
    calc
      U.product q - V.product q =
          (U.product q - a) - (V.product q - a) := by ring
      _ = modulusProduct q k * u - modulusProduct q k * v := by
        rw [hu, hv]
      _ = modulusProduct q k * (u - v) := by ring
  have hfactorU : (f : Polynomial (ZMod q)) * pU = U.product q := by
    exact Finset.mul_prod_erase U.1
      (fun g : OfDegree q (2 * d) => (g : Polynomial (ZMod q))) hfU
  have hfactorV : (f : Polynomial (ZMod q)) * pV = V.product q := by
    exact Finset.mul_prod_erase V.1
      (fun g : OfDegree q (2 * d) => (g : Polynomial (ZMod q))) hfV
  have hfactored : modulusProduct q k ∣
      (f : Polynomial (ZMod q)) * (pU - pV) := by
    convert hcong using 1
    rw [mul_sub, hfactorU, hfactorV]
  have hdvd : modulusProduct q k ∣ pU - pV :=
    (modulusProduct_isCoprime_primePolynomial q k d f).dvd_of_dvd_mul_left
      hfactored
  have hcardU : (U.1.erase f).card = 2 := by
    rw [Finset.card_erase_of_mem hfU, U.property]
  have hcardV : (V.1.erase f).card = 2 := by
    rw [Finset.card_erase_of_mem hfV, V.property]
  have hpUdeg : pU.natDegree = 4 * d := by
    dsimp only [pU]
    rw [Polynomial.natDegree_prod_of_monic]
    · simp only [PrimePolynomials.natDegree, Finset.sum_const_nat,
        Nat.nsmul_eq_mul, hcardU]
      omega
    · intro g hg
      exact PrimePolynomials.monic g
  have hpVdeg : pV.natDegree = 4 * d := by
    dsimp only [pV]
    rw [Polynomial.natDegree_prod_of_monic]
    · simp only [PrimePolynomials.natDegree, Finset.sum_const_nat,
        Nat.nsmul_eq_mul, hcardV]
      omega
    · intro g hg
      exact PrimePolynomials.monic g
  have hlt : (pU - pV).natDegree < (modulusProduct q k).natDegree := by
    rw [modulusProduct_natDegree]
    exact (Polynomial.natDegree_sub_le _ _).trans_lt (by
      rw [hpUdeg, hpVdeg, max_self]
      exact hdeg)
  have hp : pU = pV := eq_of_dvd_sub_of_natDegree_lt hdvd hlt
  have herase : U.1.erase f = V.1.erase f :=
    primePolynomialFinset_eq_of_product_eq q d _ _ hp
  apply Subtype.ext
  calc
    U.1 = insert f (U.1.erase f) := (Finset.insert_erase hfU).symm
    _ = insert f (V.1.erase f) := congrArg (insert f) herase
    _ = V.1 := Finset.insert_erase hfV

/-- The unordered triples in one fixed nonzero residue class are a pairwise
disjoint family.  Thus their digit-success events use disjoint coordinates. -/
theorem congruentPrimeTriples_pairwise_disjoint (k d : ℕ)
    (a : Polynomial (ZMod q)) (hdeg : 4 * d < k ^ 2) :
    Set.Pairwise
      {T : PrimeTriple q d | modulusProduct q k ∣ T.product q - a}
      (fun U V => Disjoint U.1 V.1) := by
  intro U hU V hV hne
  rw [Finset.disjoint_left]
  intro f hfU hfV
  exact hne (primeTriple_eq_of_shared_common_residue q k d a U V f
    hfU hfV hdeg hU hV)

/-- Finset-packaged form of the pairwise-disjointness theorem, ready for
cardinality and probability arguments. -/
theorem congruentPrimeTriples_pairwise_disjoint_finset (k d : ℕ)
    (a : Polynomial (ZMod q)) (hdeg : 4 * d < k ^ 2) :
    Set.Pairwise (congruentPrimeTriples q k d a : Set (PrimeTriple q d))
      (fun U V => Disjoint U.1 V.1) := by
  intro U hU V hV hne
  exact congruentPrimeTriples_pairwise_disjoint q k d a hdeg
    ((mem_congruentPrimeTriples (q := q)).mp hU)
    ((mem_congruentPrimeTriples (q := q)).mp hV) hne

/-! ### Ordered triples and the finite quotient to unordered triples

Sawin's factorization functions count ordered factorizations.  The random
construction above uses unordered triples because disjointness is naturally a
statement about the underlying three-element finsets.  The following small
interface makes that conversion explicit.  We intentionally use the coarse
constant `6 = 3!`, since every unordered triple has exactly six orderings.
-/

/-- An ordered triple of prime polynomials of the common degree `2d`. -/
structure OrderedPrimeTriple (q d : ℕ) where
  first : OfDegree q (2 * d)
  second : OfDegree q (2 * d)
  third : OfDegree q (2 * d)

theorem orderedPrimeTriple_tuple_injective (d : ℕ) :
    Function.Injective
      (fun T : OrderedPrimeTriple q d => (T.first, T.second, T.third)) := by
  intro T V h
  cases T
  cases V
  simp_all

instance orderedPrimeTripleFinite (d : ℕ) : Finite (OrderedPrimeTriple q d) := by
  apply Finite.of_injective
    (fun T : OrderedPrimeTriple q d => (T.first, T.second, T.third))
  exact orderedPrimeTriple_tuple_injective q d

noncomputable instance orderedPrimeTripleFintype (d : ℕ) :
    Fintype (OrderedPrimeTriple q d) :=
  Fintype.ofFinite _

/-- The three entries of an ordered prime triple are pairwise distinct. -/
def OrderedPrimeTriple.IsDistinct {d : ℕ} (T : OrderedPrimeTriple q d) : Prop :=
  T.first ≠ T.second ∧ T.first ≠ T.third ∧ T.second ≠ T.third

/-- Product of the three entries of an ordered prime triple. -/
noncomputable def OrderedPrimeTriple.product {d : ℕ} (T : OrderedPrimeTriple q d) :
    Polynomial (ZMod q) :=
  (T.first : Polynomial (ZMod q)) * T.second * T.third

/-- All ordered equal-degree prime triples in one residue class, before the
repeated-prime sieve is applied. -/
def CongruentAllOrderedPrimeTriple (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : OrderedPrimeTriple q d //
    modulusProduct q k ∣ T.product - a}

instance congruentAllOrderedPrimeTripleFinite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentAllOrderedPrimeTriple q k d a) := by
  unfold CongruentAllOrderedPrimeTriple
  infer_instance

noncomputable instance congruentAllOrderedPrimeTripleFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentAllOrderedPrimeTriple q k d a) :=
  Fintype.ofFinite _

/-- The distinct locus inside the unsieved ordered progression family. -/
def CongruentDistinctOrderedPrimeTriple (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a // T.1.IsDistinct}

instance congruentDistinctOrderedPrimeTripleFinite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentDistinctOrderedPrimeTriple q k d a) := by
  apply Finite.of_injective
      (fun T : CongruentDistinctOrderedPrimeTriple q k d a => T.1)
  exact Subtype.val_injective

noncomputable instance congruentDistinctOrderedPrimeTripleFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentDistinctOrderedPrimeTriple q k d a) := by
  classical
  unfold CongruentDistinctOrderedPrimeTriple
  infer_instance

/-- The first repeated-prime diagonal in the ordered progression family. -/
def CongruentOrderedPrimeTripleEqual12 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.first = T.1.second}

/-- The second repeated-prime diagonal in the ordered progression family. -/
def CongruentOrderedPrimeTripleEqual13 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.first = T.1.third}

/-- The third repeated-prime diagonal in the ordered progression family. -/
def CongruentOrderedPrimeTripleEqual23 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.second = T.1.third}

/-- The common intersection of the three repeated-prime diagonals. -/
def CongruentOrderedPrimeTripleDiagonal (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.first = T.1.second ∧ T.1.first = T.1.third ∧
      T.1.second = T.1.third}

instance congruentOrderedPrimeTripleEqual12Finite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedPrimeTripleEqual12 q k d a) := by
  apply Finite.of_injective
      (fun T : CongruentOrderedPrimeTripleEqual12 q k d a => T.1)
  exact Subtype.val_injective

instance congruentOrderedPrimeTripleEqual13Finite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedPrimeTripleEqual13 q k d a) := by
  apply Finite.of_injective
      (fun T : CongruentOrderedPrimeTripleEqual13 q k d a => T.1)
  exact Subtype.val_injective

instance congruentOrderedPrimeTripleEqual23Finite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedPrimeTripleEqual23 q k d a) := by
  apply Finite.of_injective
      (fun T : CongruentOrderedPrimeTripleEqual23 q k d a => T.1)
  exact Subtype.val_injective

instance congruentOrderedPrimeTripleDiagonalFinite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedPrimeTripleDiagonal q k d a) := by
  apply Finite.of_injective
      (fun T : CongruentOrderedPrimeTripleDiagonal q k d a => T.1)
  exact Subtype.val_injective

noncomputable instance congruentOrderedPrimeTripleEqual12Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleEqual12 q k d a) := by
  classical
  unfold CongruentOrderedPrimeTripleEqual12
  infer_instance

noncomputable instance congruentOrderedPrimeTripleEqual13Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleEqual13 q k d a) := by
  classical
  unfold CongruentOrderedPrimeTripleEqual13
  infer_instance

noncomputable instance congruentOrderedPrimeTripleEqual23Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleEqual23 q k d a) := by
  classical
  unfold CongruentOrderedPrimeTripleEqual23
  infer_instance

noncomputable instance congruentOrderedPrimeTripleDiagonalFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleDiagonal q k d a) := by
  classical
  unfold CongruentOrderedPrimeTripleDiagonal
  infer_instance

/-- The `12` collision stratum with the full diagonal removed.  This is the
literal two-element block term in Sawin's partition formula (Lemma 9.12). -/
def CongruentOrderedPrimeTripleProper12 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.first = T.1.second ∧ T.1.first ≠ T.1.third}

/-- The `13` collision stratum with the full diagonal removed. -/
def CongruentOrderedPrimeTripleProper13 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.first = T.1.third ∧ T.1.first ≠ T.1.second}

/-- The `23` collision stratum with the full diagonal removed. -/
def CongruentOrderedPrimeTripleProper23 (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : CongruentAllOrderedPrimeTriple q k d a //
    T.1.second = T.1.third ∧ T.1.second ≠ T.1.first}

noncomputable instance congruentOrderedPrimeTripleProper12Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleProper12 q k d a) := by
  unfold CongruentOrderedPrimeTripleProper12
  infer_instance

noncomputable instance congruentOrderedPrimeTripleProper13Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleProper13 q k d a) := by
  unfold CongruentOrderedPrimeTripleProper13
  infer_instance

noncomputable instance congruentOrderedPrimeTripleProper23Fintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTripleProper23 q k d a) := by
  unfold CongruentOrderedPrimeTripleProper23
  infer_instance

/-- The five disjoint strata attached to the partitions of a three-element
set exhaust the ordered prime triples.  In source notation these are the
all-singleton term, the three possible two-element blocks, and the single
three-element block in Lemma 9.12. -/
theorem congruentOrderedPrimeTriple_proper_strata_partition (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentDistinctOrderedPrimeTriple q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleProper12 q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleProper13 q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleProper23 q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleDiagonal q k d a) =
      Fintype.card (CongruentAllOrderedPrimeTriple q k d a) := by
  classical
  change
    Fintype.card {T : CongruentAllOrderedPrimeTriple q k d a //
        T.1.IsDistinct} +
      Fintype.card {T : CongruentAllOrderedPrimeTriple q k d a //
        T.1.first = T.1.second ∧ T.1.first ≠ T.1.third} +
      Fintype.card {T : CongruentAllOrderedPrimeTriple q k d a //
        T.1.first = T.1.third ∧ T.1.first ≠ T.1.second} +
      Fintype.card {T : CongruentAllOrderedPrimeTriple q k d a //
        T.1.second = T.1.third ∧ T.1.second ≠ T.1.first} +
      Fintype.card {T : CongruentAllOrderedPrimeTriple q k d a //
        T.1.first = T.1.second ∧ T.1.first = T.1.third ∧
          T.1.second = T.1.third} =
      Fintype.card (CongruentAllOrderedPrimeTriple q k d a)
  simp_rw [Fintype.card_subtype, Finset.card_filter]
  rw [show Fintype.card (CongruentAllOrderedPrimeTriple q k d a) =
      ∑ _T : CongruentAllOrderedPrimeTriple q k d a, 1 by simp]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro T _hT
  simp only [OrderedPrimeTriple.IsDistinct]
  by_cases h12 : T.1.first = T.1.second <;>
    by_cases h13 : T.1.first = T.1.third <;>
      by_cases h23 : T.1.second = T.1.third <;> simp_all [eq_comm]

/-- For three factors, inclusion--exclusion removes repeated primes by the
exact identity

`distinct + equal₁₂ + equal₁₃ + equal₂₃ = all + 2 * diagonal`.

This is the equal-degree, three-factor combinatorial core of Sawin's Lemma
9.12. -/
theorem congruentOrderedPrimeTriple_inclusion_exclusion (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentDistinctOrderedPrimeTriple q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleEqual12 q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleEqual13 q k d a) +
        Fintype.card (CongruentOrderedPrimeTripleEqual23 q k d a) =
      Fintype.card (CongruentAllOrderedPrimeTriple q k d a) +
        2 * Fintype.card (CongruentOrderedPrimeTripleDiagonal q k d a) := by
  classical
  have hDistinct :
      Fintype.card (CongruentDistinctOrderedPrimeTriple q k d a) =
        Fintype.card
          {T : CongruentAllOrderedPrimeTriple q k d a //
            T.1.IsDistinct} :=
    Fintype.card_congr (Equiv.refl _)
  have hEqual12 :
      Fintype.card (CongruentOrderedPrimeTripleEqual12 q k d a) =
        Fintype.card
          {T : CongruentAllOrderedPrimeTriple q k d a //
            T.1.first = T.1.second} :=
    Fintype.card_congr (Equiv.refl _)
  have hEqual13 :
      Fintype.card (CongruentOrderedPrimeTripleEqual13 q k d a) =
        Fintype.card
          {T : CongruentAllOrderedPrimeTriple q k d a //
            T.1.first = T.1.third} :=
    Fintype.card_congr (Equiv.refl _)
  have hEqual23 :
      Fintype.card (CongruentOrderedPrimeTripleEqual23 q k d a) =
        Fintype.card
          {T : CongruentAllOrderedPrimeTriple q k d a //
            T.1.second = T.1.third} :=
    Fintype.card_congr (Equiv.refl _)
  have hDiagonal :
      Fintype.card (CongruentOrderedPrimeTripleDiagonal q k d a) =
        Fintype.card
          {T : CongruentAllOrderedPrimeTriple q k d a //
            T.1.first = T.1.second ∧ T.1.first = T.1.third ∧
              T.1.second = T.1.third} :=
    Fintype.card_congr (Equiv.refl _)
  let p : CongruentAllOrderedPrimeTriple q k d a → Prop :=
    fun T => T.1.first = T.1.second
  let r : CongruentAllOrderedPrimeTriple q k d a → Prop :=
    fun T => T.1.first = T.1.third
  let s : CongruentAllOrderedPrimeTriple q k d a → Prop :=
    fun T => T.1.second = T.1.third
  have hclosure : ∀ T, (p T ∧ r T) ∨ (p T ∧ s T) ∨ (r T ∧ s T) →
      p T ∧ r T ∧ s T := by
    intro T h
    rcases h with h | h | h
    · exact ⟨h.1, h.2, h.1.symm.trans h.2⟩
    · exact ⟨h.1, h.1.trans h.2, h.2⟩
    · exact ⟨h.1.trans h.2.symm, h.1, h.2⟩
  rw [hDistinct, hEqual12, hEqual13, hEqual23, hDiagonal]
  simp_rw [Fintype.card_subtype]
  simp_rw [Finset.card_filter]
  rw [show Fintype.card (CongruentAllOrderedPrimeTriple q k d a) =
      ∑ _T : CongruentAllOrderedPrimeTriple q k d a, 1 by simp]
  rw [Finset.mul_sum]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro T hT
  specialize hclosure T
  by_cases hp : p T <;> by_cases hr : r T <;> by_cases hs : s T <;>
    simp only [mul_ite, mul_one, mul_zero] at hclosure ⊢
  exact fun h => hp (hr.trans h)

/-- Multiplying the three-factor inclusion--exclusion identity by the common
von-Mangoldt weight gives its factorization-function form. -/
theorem congruentOrderedPrimeTriple_weighted_inclusion_exclusion (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    (2 * d) ^ 3 *
        (Fintype.card (CongruentDistinctOrderedPrimeTriple q k d a) +
          Fintype.card (CongruentOrderedPrimeTripleEqual12 q k d a) +
          Fintype.card (CongruentOrderedPrimeTripleEqual13 q k d a) +
          Fintype.card (CongruentOrderedPrimeTripleEqual23 q k d a)) =
      (2 * d) ^ 3 *
        (Fintype.card (CongruentAllOrderedPrimeTriple q k d a) +
          2 * Fintype.card
            (CongruentOrderedPrimeTripleDiagonal q k d a)) := by
  exact congrArg (fun n : ℕ => (2 * d) ^ 3 * n)
    (congruentOrderedPrimeTriple_inclusion_exclusion q k d a)

/-- Centered, normed form of the three-factor inclusion--exclusion identity.
This is the analytic triangle-inequality step in the equal-degree
specialization of Sawin's Lemmas 9.12--9.14: cancellation estimates for the
unsieved triple, the three pair diagonals, and the full diagonal combine to
give cancellation for the pairwise-distinct triple. -/
theorem norm_centered_three_factor_sieve
    (D A E12 E13 E23 T Davg Aavg E12avg E13avg E23avg Tavg : ℂ)
    (hlocal : D + E12 + E13 + E23 = A + 2 * T)
    (haverage : Davg + E12avg + E13avg + E23avg = Aavg + 2 * Tavg) :
    ‖D - Davg‖ ≤
      ‖A - Aavg‖ + 2 * ‖T - Tavg‖ +
        ‖E12 - E12avg‖ + ‖E13 - E13avg‖ + ‖E23 - E23avg‖ := by
  have hcenter :
      D - Davg =
        (A - Aavg) + 2 * (T - Tavg) -
          ((E12 - E12avg) + (E13 - E13avg) + (E23 - E23avg)) := by
    linear_combination hlocal - haverage
  rw [hcenter]
  calc
    ‖(A - Aavg) + 2 * (T - Tavg) -
        ((E12 - E12avg) + (E13 - E13avg) + (E23 - E23avg))‖ ≤
        ‖(A - Aavg) + 2 * (T - Tavg)‖ +
          ‖(E12 - E12avg) + (E13 - E13avg) + (E23 - E23avg)‖ :=
      norm_sub_le _ _
    _ ≤ (‖A - Aavg‖ + ‖2 * (T - Tavg)‖) +
          ((‖E12 - E12avg‖ + ‖E13 - E13avg‖) + ‖E23 - E23avg‖) := by
      apply add_le_add (norm_add_le _ _)
      calc
        ‖(E12 - E12avg) + (E13 - E13avg) + (E23 - E23avg)‖ ≤
            ‖(E12 - E12avg) + (E13 - E13avg)‖ + ‖E23 - E23avg‖ :=
          norm_add_le _ _
        _ ≤ (‖E12 - E12avg‖ + ‖E13 - E13avg‖) + ‖E23 - E23avg‖ :=
          add_le_add (norm_add_le _ _) le_rfl
    _ = ‖A - Aavg‖ + 2 * ‖T - Tavg‖ +
          ‖E12 - E12avg‖ + ‖E13 - E13avg‖ + ‖E23 - E23avg‖ := by
      rw [norm_mul]
      norm_num
      ring

/-- A source-aligned disjoint partition of the ordered three-factor locus.
The proper pair strata exclude the full diagonal, so the five displayed
functions are disjoint and have coefficient one. -/
structure ThreeFactorPartitionFamily
    (ι : Type*) [Fintype ι] where
  distinct : ι → ℂ
  all : ι → ℂ
  proper12 : ι → ℂ
  proper13 : ι → ℂ
  proper23 : ι → ℂ
  diagonal : ι → ℂ
  partition : ∀ i,
    distinct i + proper12 i + proper13 i + proper23 i + diagonal i = all i

/-- Finite averaging preserves the five-stratum partition identity. -/
theorem ThreeFactorPartitionFamily.average_partition
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (data : ThreeFactorPartitionFamily ι) :
    (∑ i, data.distinct i) / (Fintype.card ι : ℂ) +
        (∑ i, data.proper12 i) / (Fintype.card ι : ℂ) +
        (∑ i, data.proper13 i) / (Fintype.card ι : ℂ) +
        (∑ i, data.proper23 i) / (Fintype.card ι : ℂ) +
        (∑ i, data.diagonal i) / (Fintype.card ι : ℂ) =
      (∑ i, data.all i) / (Fintype.card ι : ℂ) := by
  have hcard : (Fintype.card ι : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  field_simp
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun i _hi => data.partition i)

/-- Centering a disjoint five-stratum partition and applying the triangle
inequality gives the precise analytic form of the `ω = 3` partition step. -/
theorem norm_centered_three_factor_partition
    (D A P12 P13 P23 T Davg Aavg P12avg P13avg P23avg Tavg : ℂ)
    (hlocal : D + P12 + P13 + P23 + T = A)
    (haverage : Davg + P12avg + P13avg + P23avg + Tavg = Aavg) :
    ‖D - Davg‖ ≤
      ‖A - Aavg‖ + ‖P12 - P12avg‖ + ‖P13 - P13avg‖ +
        ‖P23 - P23avg‖ + ‖T - Tavg‖ := by
  have hcenter :
      D - Davg = (A - Aavg) -
        ((P12 - P12avg) + (P13 - P13avg) +
          (P23 - P23avg) + (T - Tavg)) := by
    linear_combination hlocal - haverage
  rw [hcenter]
  calc
    ‖(A - Aavg) - ((P12 - P12avg) + (P13 - P13avg) +
        (P23 - P23avg) + (T - Tavg))‖ ≤
      ‖A - Aavg‖ + ‖(P12 - P12avg) + (P13 - P13avg) +
        (P23 - P23avg) + (T - Tavg)‖ := norm_sub_le _ _
    _ ≤ ‖A - Aavg‖ + ((‖P12 - P12avg‖ + ‖P13 - P13avg‖) +
        ‖P23 - P23avg‖ + ‖T - Tavg‖) := by
      gcongr
      calc
        ‖(P12 - P12avg) + (P13 - P13avg) +
            (P23 - P23avg) + (T - Tavg)‖ ≤
          ‖(P12 - P12avg) + (P13 - P13avg) + (P23 - P23avg)‖ +
            ‖T - Tavg‖ := norm_add_le _ _
        _ ≤ (‖P12 - P12avg‖ + ‖P13 - P13avg‖) +
            ‖P23 - P23avg‖ + ‖T - Tavg‖ := by
          gcongr
          calc
            ‖(P12 - P12avg) + (P13 - P13avg) + (P23 - P23avg)‖ ≤
                ‖(P12 - P12avg) + (P13 - P13avg)‖ +
                  ‖P23 - P23avg‖ := norm_add_le _ _
            _ ≤ (‖P12 - P12avg‖ + ‖P13 - P13avg‖) +
                  ‖P23 - P23avg‖ := by gcongr; exact norm_add_le _ _
    _ = ‖A - Aavg‖ + ‖P12 - P12avg‖ + ‖P13 - P13avg‖ +
        ‖P23 - P23avg‖ + ‖T - Tavg‖ := by ring

/-- Pointwise centered bound furnished by a disjoint five-stratum family. -/
theorem ThreeFactorPartitionFamily.norm_distinct_sub_average_le
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (data : ThreeFactorPartitionFamily ι) (a : ι) :
    ‖data.distinct a -
        (∑ i, data.distinct i) / (Fintype.card ι : ℂ)‖ ≤
      ‖data.all a - (∑ i, data.all i) / (Fintype.card ι : ℂ)‖ +
        ‖data.proper12 a -
          (∑ i, data.proper12 i) / (Fintype.card ι : ℂ)‖ +
        ‖data.proper13 a -
          (∑ i, data.proper13 i) / (Fintype.card ι : ℂ)‖ +
        ‖data.proper23 a -
          (∑ i, data.proper23 i) / (Fintype.card ι : ℂ)‖ +
        ‖data.diagonal a -
          (∑ i, data.diagonal i) / (Fintype.card ι : ℂ)‖ := by
  exact norm_centered_three_factor_partition
    (data.distinct a) (data.all a) (data.proper12 a) (data.proper13 a)
    (data.proper23 a) (data.diagonal a)
    ((∑ i, data.distinct i) / (Fintype.card ι : ℂ))
    ((∑ i, data.all i) / (Fintype.card ι : ℂ))
    ((∑ i, data.proper12 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.proper13 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.proper23 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.diagonal i) / (Fintype.card ι : ℂ))
    (data.partition a) data.average_partition

/-- A finite family of the six masses which occur in the equal-degree,
three-factor sieve.  The sole field is the pointwise specialization of
Sawin's Lemma 9.12; taking finite averages supplies the corresponding global
identity automatically. -/
structure ThreeFactorSieveFamily
    (ι : Type*) [Fintype ι] where
  distinct : ι → ℂ
  all : ι → ℂ
  equal12 : ι → ℂ
  equal13 : ι → ℂ
  equal23 : ι → ℂ
  diagonal : ι → ℂ
  inclusion_exclusion : ∀ i,
    distinct i + equal12 i + equal13 i + equal23 i =
      all i + 2 * diagonal i

/-- Averaging the pointwise sieve identity produces the exact identity
between the six global means. -/
theorem ThreeFactorSieveFamily.average_inclusion_exclusion
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (data : ThreeFactorSieveFamily ι) :
    (∑ i, data.distinct i) / (Fintype.card ι : ℂ) +
        (∑ i, data.equal12 i) / (Fintype.card ι : ℂ) +
        (∑ i, data.equal13 i) / (Fintype.card ι : ℂ) +
        (∑ i, data.equal23 i) / (Fintype.card ι : ℂ) =
      (∑ i, data.all i) / (Fintype.card ι : ℂ) +
        2 * ((∑ i, data.diagonal i) / (Fintype.card ι : ℂ)) := by
  have hsum :
      (∑ i, data.distinct i) + (∑ i, data.equal12 i) +
          (∑ i, data.equal13 i) + (∑ i, data.equal23 i) =
        (∑ i, data.all i) + 2 * (∑ i, data.diagonal i) := by
    simpa only [← Finset.sum_add_distrib, Finset.mul_sum] using
      Finset.sum_congr rfl (fun i _hi ↦ data.inclusion_exclusion i)
  have hcard : (Fintype.card ι : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  field_simp
  linear_combination hsum

/-- The centered distinct mass is controlled by the five centered source
strata.  This is the complete triangle-inequality part of Lemma 9.14 for
three equal degrees; the remaining input is a cancellation estimate for
each displayed stratum. -/
theorem ThreeFactorSieveFamily.norm_distinct_sub_average_le
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (data : ThreeFactorSieveFamily ι) (a : ι) :
    ‖data.distinct a -
        (∑ i, data.distinct i) / (Fintype.card ι : ℂ)‖ ≤
      ‖data.all a - (∑ i, data.all i) / (Fintype.card ι : ℂ)‖ +
        2 * ‖data.diagonal a -
          (∑ i, data.diagonal i) / (Fintype.card ι : ℂ)‖ +
        ‖data.equal12 a -
          (∑ i, data.equal12 i) / (Fintype.card ι : ℂ)‖ +
        ‖data.equal13 a -
          (∑ i, data.equal13 i) / (Fintype.card ι : ℂ)‖ +
        ‖data.equal23 a -
          (∑ i, data.equal23 i) / (Fintype.card ι : ℂ)‖ := by
  exact norm_centered_three_factor_sieve
    (data.distinct a) (data.all a) (data.equal12 a) (data.equal13 a)
    (data.equal23 a) (data.diagonal a)
    ((∑ i, data.distinct i) / (Fintype.card ι : ℂ))
    ((∑ i, data.all i) / (Fintype.card ι : ℂ))
    ((∑ i, data.equal12 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.equal13 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.equal23 i) / (Fintype.card ι : ℂ))
    ((∑ i, data.diagonal i) / (Fintype.card ι : ℂ))
    (data.inclusion_exclusion a) data.average_inclusion_exclusion

/-- Ordered, pairwise-distinct prime triples in one residue class. -/
def CongruentOrderedPrimeTriple (k d : ℕ)
    (a : Polynomial (ZMod q)) :=
  {T : OrderedPrimeTriple q d //
    T.IsDistinct ∧ modulusProduct q k ∣ T.product - a}

instance congruentOrderedPrimeTripleFinite (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedPrimeTriple q k d a) := by
  unfold CongruentOrderedPrimeTriple
  infer_instance

noncomputable instance congruentOrderedPrimeTripleFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype (CongruentOrderedPrimeTriple q k d a) :=
  Fintype.ofFinite _

/-- Forget the ordering of a distinct ordered triple. -/
noncomputable def CongruentOrderedPrimeTriple.toUnordered {k d : ℕ}
    {a : Polynomial (ZMod q)} (T : CongruentOrderedPrimeTriple q k d a) :
    ↥(congruentPrimeTriples q k d a) := by
  classical
  let s : Finset (OfDegree q (2 * d)) :=
    {T.1.first, T.1.second, T.1.third}
  have hs : s.card = 3 := by
    rcases T.2.1 with ⟨h12, h13, h23⟩
    simp [s, h12, h13, h23]
  let U : PrimeTriple q d := ⟨s, hs⟩
  refine ⟨U, (mem_congruentPrimeTriples (q := q)).2 ?_⟩
  have hprod : U.product q = T.1.product := by
    rcases T.2.1 with ⟨h12, h13, h23⟩
    simp [U, s, PrimeTriple.product, OrderedPrimeTriple.product,
      h12, h13, h23, mul_assoc]
  rw [hprod]
  exact T.2.2

/-- A pairwise-distinct ordered triple canonically enumerates its underlying
three-element finset. -/
noncomputable def orderedTripleFinEquiv {d : ℕ}
    (T : OrderedPrimeTriple q d) (hT : T.IsDistinct) :
    Fin 3 ≃ ↥({T.first, T.second, T.third} : Finset (OfDegree q (2 * d))) := by
  let f : Fin 3 →
      ↥({T.first, T.second, T.third} : Finset (OfDegree q (2 * d))) :=
    fun i => ![⟨T.first, by simp⟩, ⟨T.second, by simp⟩,
      ⟨T.third, by simp⟩] i
  apply Equiv.ofBijective f
  constructor
  · intro i j hij
    rcases hT with ⟨h12, h13, h23⟩
    fin_cases i <;> fin_cases j <;>
      simp_all [f, h12, h13, h23]
  · rintro ⟨x, hx⟩
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with h | h | h
    · refine ⟨0, ?_⟩
      apply Subtype.ext
      simpa [f] using h.symm
    · refine ⟨1, ?_⟩
      apply Subtype.ext
      simpa [f] using h.symm
    · refine ⟨2, ?_⟩
      apply Subtype.ext
      simpa [f] using h.symm

@[simp]
theorem orderedTripleFinEquiv_zero {d : ℕ}
    (T : OrderedPrimeTriple q d) (hT : T.IsDistinct) :
    ((orderedTripleFinEquiv q T hT 0 :
      ↥({T.first, T.second, T.third} : Finset (OfDegree q (2 * d)))) :
        OfDegree q (2 * d)) = T.first := by
  rfl

@[simp]
theorem orderedTripleFinEquiv_one {d : ℕ}
    (T : OrderedPrimeTriple q d) (hT : T.IsDistinct) :
    ((orderedTripleFinEquiv q T hT 1 :
      ↥({T.first, T.second, T.third} : Finset (OfDegree q (2 * d)))) :
        OfDegree q (2 * d)) = T.second := by
  rfl

@[simp]
theorem orderedTripleFinEquiv_two {d : ℕ}
    (T : OrderedPrimeTriple q d) (hT : T.IsDistinct) :
    ((orderedTripleFinEquiv q T hT 2 :
      ↥({T.first, T.second, T.third} : Finset (OfDegree q (2 * d)))) :
        OfDegree q (2 * d)) = T.third := by
  rfl

/-- Turn a nested-subtype presentation of a distinct ordered progression
triple into an ordering of its underlying unordered triple. -/
noncomputable def distinctToOrdering {k d : ℕ}
    {a : Polynomial (ZMod q)}
    (T : CongruentDistinctOrderedPrimeTriple q k d a) :
    CongruentPrimeTripleOrdering q k d a := by
  let V : CongruentOrderedPrimeTriple q k d a :=
    ⟨T.1.1, T.2, T.1.2⟩
  let U := V.toUnordered
  refine ⟨U, ?_⟩
  exact orderedTripleFinEquiv q V.1 V.2.1

@[simp]
theorem distinctToOrdering_zero {k d : ℕ}
    {a : Polynomial (ZMod q)}
    (T : CongruentDistinctOrderedPrimeTriple q k d a) :
    ((distinctToOrdering q T).2 0 : OfDegree q (2 * d)) = T.1.1.first := by
  rfl

@[simp]
theorem distinctToOrdering_one {k d : ℕ}
    {a : Polynomial (ZMod q)}
    (T : CongruentDistinctOrderedPrimeTriple q k d a) :
    ((distinctToOrdering q T).2 1 : OfDegree q (2 * d)) = T.1.1.second := by
  rfl

@[simp]
theorem distinctToOrdering_two {k d : ℕ}
    {a : Polynomial (ZMod q)}
    (T : CongruentDistinctOrderedPrimeTriple q k d a) :
    ((distinctToOrdering q T).2 2 : OfDegree q (2 * d)) = T.1.1.third := by
  rfl

theorem distinctToOrdering_injective {k d : ℕ}
    {a : Polynomial (ZMod q)} :
    Function.Injective
      (distinctToOrdering (q := q) (k := k) (d := d) (a := a)) := by
  intro T V h
  have htuple := congrArg
    (fun X : CongruentPrimeTripleOrdering q k d a =>
      ((X.2 0 : OfDegree q (2 * d)), (X.2 1 : OfDegree q (2 * d)),
        (X.2 2 : OfDegree q (2 * d)))) h
  have htuple' :
      (T.1.1.first, T.1.1.second, T.1.1.third) =
        (V.1.1.first, V.1.1.second, V.1.1.third) := by
    simpa using htuple
  apply Subtype.ext
  apply Subtype.ext
  exact orderedPrimeTriple_tuple_injective q d htuple'

/-- Decode an ordering of an unordered triple to the corresponding nested
ordered progression triple. -/
noncomputable def orderingToDistinct {k d : ℕ}
    {a : Polynomial (ZMod q)}
    (X : CongruentPrimeTripleOrdering q k d a) :
    CongruentDistinctOrderedPrimeTriple q k d a := by
  let T : OrderedPrimeTriple q d :=
    ⟨X.2 0, X.2 1, X.2 2⟩
  have hdistinct : T.IsDistinct := by
    refine ⟨?_, ?_, ?_⟩ <;> intro h
    · have hij := X.2.injective (Subtype.ext h)
      norm_num at hij
    · have hij := X.2.injective (Subtype.ext h)
      have := congrArg Fin.val hij
      norm_num at this
    · have hij := X.2.injective (Subtype.ext h)
      have := congrArg Fin.val hij
      norm_num at this
  have hprod : T.product = X.1.1.product q := by
    calc
      T.product = ∏ i : Fin 3,
          ((X.2 i : OfDegree q (2 * d)) : Polynomial (ZMod q)) := by
        rw [Fin.prod_univ_three]
        rfl
      _ = ∏ f : ↥X.1.1.1,
          ((f : OfDegree q (2 * d)) : Polynomial (ZMod q)) :=
        Equiv.prod_comp X.2
          (fun f : ↥X.1.1.1 =>
            ((f : OfDegree q (2 * d)) : Polynomial (ZMod q)))
      _ = X.1.1.product q := by
        simpa [PrimeTriple.product] using
          (Finset.prod_coe_sort X.1.1.1
            (fun f : OfDegree q (2 * d) =>
              (f : Polynomial (ZMod q))))
  refine ⟨⟨T, ?_⟩, hdistinct⟩
  rw [hprod]
  exact (mem_congruentPrimeTriples (q := q)).mp X.1.2

theorem orderingToDistinct_injective {k d : ℕ}
    {a : Polynomial (ZMod q)} :
    Function.Injective
      (orderingToDistinct (q := q) (k := k) (d := d) (a := a)) := by
  intro X Y h
  have htuple :
      ((X.2 0 : OfDegree q (2 * d)), (X.2 1 : OfDegree q (2 * d)),
          (X.2 2 : OfDegree q (2 * d))) =
        ((Y.2 0 : OfDegree q (2 * d)), (Y.2 1 : OfDegree q (2 * d)),
          (Y.2 2 : OfDegree q (2 * d))) := by
    have ht := congrArg
      (fun T : CongruentDistinctOrderedPrimeTriple q k d a =>
        (T.1.1.first, T.1.1.second, T.1.1.third)) h
    simpa [orderingToDistinct] using ht
  have h0 : (X.2 0 : OfDegree q (2 * d)) = Y.2 0 :=
    congrArg Prod.fst htuple
  have h1 : (X.2 1 : OfDegree q (2 * d)) = Y.2 1 :=
    congrArg (fun z => z.2.1) htuple
  have h2 : (X.2 2 : OfDegree q (2 * d)) = Y.2 2 :=
    congrArg (fun z => z.2.2) htuple
  have hUval : X.1.1.1 = Y.1.1.1 := by
    ext f
    constructor
    · intro hf
      obtain ⟨i, hi⟩ := X.2.surjective ⟨f, hf⟩
      fin_cases i
      · have : f = (X.2 0 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, h0]
        exact (Y.2 0).2
      · have : f = (X.2 1 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, h1]
        exact (Y.2 1).2
      · have : f = (X.2 2 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, h2]
        exact (Y.2 2).2
    · intro hf
      obtain ⟨i, hi⟩ := Y.2.surjective ⟨f, hf⟩
      fin_cases i
      · have : f = (Y.2 0 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, ← h0]
        exact (X.2 0).2
      · have : f = (Y.2 1 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, ← h1]
        exact (X.2 1).2
      · have : f = (Y.2 2 : OfDegree q (2 * d)) := by
          simpa using congrArg Subtype.val hi.symm
        rw [this, ← h2]
        exact (X.2 2).2
  have hU : X.1 = Y.1 := by
    apply Subtype.ext
    apply Subtype.ext
    exact hUval
  have hfun : ∀ i : Fin 3,
      (X.2 i : OfDegree q (2 * d)) = (Y.2 i : OfDegree q (2 * d)) := by
    intro i
    fin_cases i <;> assumption
  have heq_of_base_eq :
      ∀ (U V : ↥(congruentPrimeTriples q k d a)) (hUV : U = V)
        (e : Fin 3 ≃ ↥U.1.1) (f : Fin 3 ≃ ↥V.1.1),
        (∀ i, (e i : OfDegree q (2 * d)) = (f i : OfDegree q (2 * d))) →
          HEq e f := by
    intro U V hUV e f hef
    subst V
    apply heq_of_eq
    apply Equiv.ext
    intro i
    apply Subtype.ext
    exact hef i
  exact Sigma.ext hU (heq_of_base_eq X.1 Y.1 hU X.2 Y.2 hfun)

/-- The nested ordered distinct locus and the source's explicit ordering
type have exactly the same cardinality. -/
theorem card_congruentDistinctOrderedPrimeTriple_eq_ordering (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentDistinctOrderedPrimeTriple q k d a) =
      Fintype.card (CongruentPrimeTripleOrdering q k d a) := by
  apply le_antisymm
  · exact Fintype.card_le_of_injective (distinctToOrdering (q := q))
      (distinctToOrdering_injective (q := q))
  · exact Fintype.card_le_of_injective (orderingToDistinct (q := q))
      (orderingToDistinct_injective (q := q))

/-- A target type with exactly `3^3` slots over each unordered triple. -/
def OrderedTripleCode (k d : ℕ) (a : Polynomial (ZMod q)) :=
  Σ U : ↥(congruentPrimeTriples q k d a),
    (↥U.1.1 × ↥U.1.1 × ↥U.1.1)

noncomputable instance orderedTripleCodeFintype (k d : ℕ)
    (a : Polynomial (ZMod q)) : Fintype (OrderedTripleCode q k d a) := by
  unfold OrderedTripleCode
  infer_instance

/-- Record an ordered triple by its underlying unordered triple and its three
positions in that finset. -/
noncomputable def CongruentOrderedPrimeTriple.code {k d : ℕ}
    {a : Polynomial (ZMod q)} (T : CongruentOrderedPrimeTriple q k d a) :
    OrderedTripleCode q k d a := by
  classical
  let U := T.toUnordered
  refine ⟨U, ⟨T.1.first, ?_⟩, ⟨T.1.second, ?_⟩, ⟨T.1.third, ?_⟩⟩
  · simp [U, CongruentOrderedPrimeTriple.toUnordered]
  · simp [U, CongruentOrderedPrimeTriple.toUnordered]
  · simp [U, CongruentOrderedPrimeTriple.toUnordered]

theorem CongruentOrderedPrimeTriple.code_injective {k d : ℕ}
    {a : Polynomial (ZMod q)} :
    Function.Injective
      (CongruentOrderedPrimeTriple.code (q := q) (k := k) (d := d) (a := a)) := by
  intro T V h
  have htuple :
      (T.1.first, T.1.second, T.1.third) =
        (V.1.first, V.1.second, V.1.third) :=
    congrArg (fun z : OrderedTripleCode q k d a =>
      ((z.2.1 : OfDegree q (2 * d)),
        (z.2.2.1 : OfDegree q (2 * d)),
        (z.2.2.2 : OfDegree q (2 * d)))) h
  apply Subtype.ext
  exact orderedPrimeTriple_tuple_injective q d htuple

theorem orderedTripleCode_card (k d : ℕ) (a : Polynomial (ZMod q)) :
    Fintype.card (OrderedTripleCode q k d a) =
      27 * (congruentPrimeTriples q k d a).card := by
  classical
  unfold OrderedTripleCode
  rw [Fintype.card_sigma]
  simp only [Fintype.card_prod, Fintype.card_coe]
  have hthree : ∀ U : ↥(congruentPrimeTriples q k d a), U.1.1.card = 3 :=
    fun U => U.1.2
  simp_rw [hthree]
  simp
  ring

/-- Coarse ordered-to-unordered cardinality conversion. -/
theorem card_congruentOrderedPrimeTriple_le (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentOrderedPrimeTriple q k d a) ≤
      27 * (congruentPrimeTriples q k d a).card := by
  rw [← orderedTripleCode_card]
  exact Fintype.card_le_of_injective
    (CongruentOrderedPrimeTriple.code (q := q))
    (CongruentOrderedPrimeTriple.code_injective (q := q))

/-- An ordered count with a factor `27` in reserve implies exactly the
unordered abundance estimate consumed by the probability argument. -/
theorem unordered_count_of_ordered_count {k d L : ℕ}
    (a : Polynomial (ZMod q))
    (hcount : 27 * L ≤
      Fintype.card (CongruentOrderedPrimeTriple q k d a)) :
    L ≤ (congruentPrimeTriples q k d a).card := by
  have hupper := card_congruentOrderedPrimeTriple_le q k d a
  omega

end RepresentationFamilies

/-! ## The irreducible locus of the universal residue family

The smooth affine family constructed above parametrizes monic pairwise-coprime
triples.  Its irreducible locus is the literal ordered-prime progression count
used in the combinatorial argument.  The following equivalence records this
identification without passing through an informal point-counting convention.
-/

namespace SawinGeometry

open PolynomialInfrastructure PrimePolynomials RepresentationFamilies

/-- The irreducible locus inside the congruent pairwise-coprime triple type. -/
def CongruentIrreducibleTriple
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) :=
  {x : CongruentPairwiseCoprimeTriple (ZMod q) (ZMod q) d g t //
    Irreducible x.factor₁.1 ∧ Irreducible x.factor₂.1 ∧
      Irreducible x.factor₃.1}

private theorem coprime_of_distinct_monic_irreducible
    {q d : ℕ} [Fact q.Prime]
    (f h : OfDegree q d) (hne : f ≠ h) :
    IsCoprime (f : Polynomial (ZMod q)) h := by
  rw [(PrimePolynomials.irreducible f).coprime_iff_not_dvd]
  intro hdvd
  have hassoc := (PrimePolynomials.irreducible f).associated_of_dvd
    (PrimePolynomials.irreducible h) hdvd
  have heq : (f : Polynomial (ZMod q)) = h :=
    Polynomial.eq_of_monic_of_associated
      (PrimePolynomials.monic f) (PrimePolynomials.monic h) hassoc
  exact hne (Subtype.ext heq)

/-- Distinct ordered prime triples in one product residue class are exactly
the irreducible prime-field points of the smooth universal residue family. -/
noncomputable def congruentDistinctOrderedPrimeTripleEquivIrreducible
    (q k r : ℕ) [Fact q.Prime] (a : Polynomial (ZMod q)) :
    CongruentDistinctOrderedPrimeTriple q k r a ≃
      CongruentIrreducibleTriple q (2 * r) (modulusProduct q k)
        (a %ₘ modulusProduct q k) where
  toFun T := by
    let f₁ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.1.first
        (PrimePolynomials.monic T.1.1.first)
        (PrimePolynomials.natDegree T.1.1.first)
    let f₂ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.1.second
        (PrimePolynomials.monic T.1.1.second)
        (PrimePolynomials.natDegree T.1.1.second)
    let f₃ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.1.third
        (PrimePolynomials.monic T.1.1.third)
        (PrimePolynomials.natDegree T.1.1.third)
    refine ⟨⟨f₁, f₂, f₃, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
    · simpa [f₁, f₂, f₃, OrderedPrimeTriple.product] using
        (Polynomial.modByMonic_eq_of_dvd_sub
          (modulusProduct_monic q k) T.1.2)
    · exact coprime_of_distinct_monic_irreducible T.1.1.first T.1.1.second
        T.2.1
    · exact coprime_of_distinct_monic_irreducible T.1.1.first T.1.1.third
        T.2.2.1
    · exact coprime_of_distinct_monic_irreducible T.1.1.second T.1.1.third
        T.2.2.2
    · exact PrimePolynomials.irreducible T.1.1.first
    · exact PrimePolynomials.irreducible T.1.1.second
    · exact PrimePolynomials.irreducible T.1.1.third
  invFun x := by
    let f₁ : OfDegree q (2 * r) :=
      ⟨x.1.factor₁.1, x.1.factor₁.monic, x.2.1, x.1.factor₁.natDegree⟩
    let f₂ : OfDegree q (2 * r) :=
      ⟨x.1.factor₂.1, x.1.factor₂.monic, x.2.2.1, x.1.factor₂.natDegree⟩
    let f₃ : OfDegree q (2 * r) :=
      ⟨x.1.factor₃.1, x.1.factor₃.monic, x.2.2.2, x.1.factor₃.natDegree⟩
    let T : OrderedPrimeTriple q r := ⟨f₁, f₂, f₃⟩
    have hmod : T.product %ₘ modulusProduct q k =
        a %ₘ modulusProduct q k := by
      simpa [T, f₁, f₂, f₃, OrderedPrimeTriple.product] using
        x.1.product_mod
    have hdiv : modulusProduct q k ∣ T.product - a := by
      rw [← Polynomial.modByMonic_eq_zero_iff_dvd (modulusProduct_monic q k)]
      rw [Polynomial.sub_modByMonic]
      exact sub_eq_zero.mpr hmod
    have h12 : f₁ ≠ f₂ := by
      intro heq
      have hpoly : x.1.factor₁.1 = x.1.factor₂.1 := by
        simpa [f₁, f₂] using congrArg Subtype.val heq
      apply x.2.1.not_isUnit
      rw [← isCoprime_self]
      simpa only [hpoly] using x.1.coprime₁₂
    have h13 : f₁ ≠ f₃ := by
      intro heq
      have hpoly : x.1.factor₁.1 = x.1.factor₃.1 := by
        simpa [f₁, f₃] using congrArg Subtype.val heq
      apply x.2.1.not_isUnit
      rw [← isCoprime_self]
      simpa only [hpoly] using x.1.coprime₁₃
    have h23 : f₂ ≠ f₃ := by
      intro heq
      have hpoly : x.1.factor₂.1 = x.1.factor₃.1 := by
        simpa [f₂, f₃] using congrArg Subtype.val heq
      apply x.2.2.1.not_isUnit
      rw [← isCoprime_self]
      simpa only [hpoly] using x.1.coprime₂₃
    exact ⟨⟨T, hdiv⟩, h12, h13, h23⟩
  left_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    congr 1 <;> apply Subtype.ext <;> rfl
  right_inv x := by
    apply Subtype.ext
    apply CongruentPairwiseCoprimeTriple.ext <;> rfl

/-- Cardinal form of the exact identification of the arithmetic prime count
with the irreducible locus in the represented smooth family. -/
theorem congruentDistinctOrderedPrimeTriple_natCard_eq_irreducible
    (q k r : ℕ) [Fact q.Prime] (a : Polynomial (ZMod q)) :
    Nat.card (CongruentDistinctOrderedPrimeTriple q k r a) =
      Nat.card (CongruentIrreducibleTriple q (2 * r) (modulusProduct q k)
        (a %ₘ modulusProduct q k)) :=
  Nat.card_congr
    (congruentDistinctOrderedPrimeTripleEquivIrreducible q k r a)

end SawinGeometry

/-! ## The equal-degree Sawin estimate in finite cardinality form

This namespace records the exact specialization of Sawin's Lemma 9.9 used
by Pilatte.  Keeping the error term as a natural number avoids introducing
rounding conventions for square roots: the displayed quantity is a coarse
integer majorant of the two terms in Lemma 9.9 (with `ω = 3`).
-/

namespace SawinSpecialization

open PolynomialInfrastructure PrimePolynomials RepresentationFamilies

variable (q : ℕ) [Fact q.Prime]

/-! ### One-dimensional square-root cancellation

Sawin's higher-dimensional trace estimate ultimately generalizes the
classical Gauss-sum calculation.  Mathlib contains the exact Gauss-product
identity; the following two lemmas record its absolute-value consequence in
the complex normalization used below. -/

/-- A nontrivial complex Gauss sum over a finite field has squared norm equal
to the cardinality of the field. -/
theorem normSq_gaussSum_eq_card
    {F : Type*} [Field F] [Fintype F]
    {χ : MulChar F ℂ} (hχ : χ ≠ 1)
    {ψ : AddChar F ℂ} (hψ : ψ.IsPrimitive) :
    Complex.normSq (gaussSum χ ψ) = Fintype.card F := by
  have hprod := gaussSum_mul_gaussSum_eq_card hχ hψ
  rw [← star_gaussSum_eq] at hprod
  change gaussSum χ ψ * (starRingEnd ℂ) (gaussSum χ ψ) = _ at hprod
  rw [Complex.mul_conj] at hprod
  exact_mod_cast hprod

/-- Absolute-value form of the complex Gauss square-root estimate. -/
theorem norm_gaussSum_eq_sqrt_card
    {F : Type*} [Field F] [Fintype F]
    {χ : MulChar F ℂ} (hχ : χ ≠ 1)
    {ψ : AddChar F ℂ} (hψ : ψ.IsPrimitive) :
    ‖gaussSum χ ψ‖ = Real.sqrt (Fintype.card F) := by
  rw [Complex.norm_def, normSq_gaussSum_eq_card hχ hψ]

/-- Euler factor of the squarefree modulus `G_k`.  Since its irreducible
factors have degrees `1,3,...,2k-1`, this is exactly `|𝔽_q[t]/G_k|ˣ`. -/
def progressionTotient (k : ℕ) : ℕ :=
  ∏ i ∈ Finset.range k, (q ^ (2 * i + 1) - 1)

/-- The arithmetic Euler product is exactly the cardinality of the unit
group of the squarefree progression quotient. -/
theorem progressionTotient_eq_modulusQuotient_units_natCard (k : ℕ) :
    progressionTotient q k =
      Nat.card (AdjoinRoot (PolynomialInfrastructure.modulusProduct q k))ˣ := by
  exact (FiniteFieldEncoding.modulusQuotient_units_natCard q k).symm

/-- The finite quotient ring on which the progression characters live. -/
noncomputable abbrev ProgressionQuotient (k : ℕ) :=
  AdjoinRoot (PolynomialInfrastructure.modulusProduct q k)

noncomputable instance progressionQuotientFinite (k : ℕ) :
    Finite (ProgressionQuotient q k) := by
  let : ∀ i : Fin k,
      Finite (Polynomial (ZMod q) ⧸ FiniteFieldEncoding.auxiliaryIdeal q i) :=
    fun i ↦ FiniteFieldEncoding.residueFieldFinite q i
  let e := FiniteFieldEncoding.modulusQuotientEquiv q k
  exact Finite.of_injective e e.injective

/-- Complex multiplicative characters of the squarefree quotient.  A
`MulChar` is defined on the entire quotient ring and vanishes on nonunits. -/
noncomputable abbrev ProgressionCharacter (k : ℕ) :=
  MulChar (ProgressionQuotient q k) ℂ

noncomputable instance progressionCharacterFintype (k : ℕ) :
    Fintype (ProgressionCharacter q k) := Fintype.ofFinite _

/-- The exponent of the finite unit group remains nonzero after casting to
`ℂ`; this supplies the separably-closed-field roots-of-unity instance used by
finite character duality. -/
instance progressionExponentCastNeZero (k : ℕ) :
    NeZero ((Monoid.exponent (ProgressionQuotient q k)ˣ : ℕ) : ℂ) :=
  ⟨Nat.cast_ne_zero.mpr Monoid.exponent_ne_zero_of_finite⟩

/-- There are exactly `progressionTotient q k` complex characters of the
progression quotient. -/
theorem progressionCharacter_natCard (k : ℕ) :
    Nat.card (ProgressionCharacter q k) = progressionTotient q k := by
  calc
    Nat.card (ProgressionCharacter q k) =
        Nat.card (ProgressionQuotient q k)ˣ :=
      MulChar.card_eq_card_units_of_hasEnoughRootsOfUnity _ _
    _ = progressionTotient q k :=
      (progressionTotient_eq_modulusQuotient_units_natCard q k).symm

/-- The unit class represented by a polynomial coprime to every auxiliary
factor. -/
noncomputable def progressionUnit (k : ℕ) (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) :
    (ProgressionQuotient q k)ˣ :=
  (FiniteFieldEncoding.isUnit_modulusQuotient_mk_iff q k a |>.mpr ha).unit

@[simp]
theorem progressionUnit_val (k : ℕ) (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) :
    ↑(progressionUnit q k a ha) =
      AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k) a :=
  (FiniteFieldEncoding.isUnit_modulusQuotient_mk_iff q k a |>.mpr ha).unit_spec

/-- A polynomial representative of an invertible progression residue class.
The representative is chosen only to state the progression fiber; every sum
below is proved independent of this choice. -/
noncomputable def progressionUnitRepresentative (k : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : Polynomial (ZMod q) :=
  Classical.choose
    (AdjoinRoot.mk_surjective (R := ZMod q)
      (g := PolynomialInfrastructure.modulusProduct q k) (u : ProgressionQuotient q k))

@[simp]
theorem progressionUnitRepresentative_mk (k : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k)
        (progressionUnitRepresentative q k u) =
      (u : ProgressionQuotient q k) :=
  Classical.choose_spec
    (AdjoinRoot.mk_surjective (R := ZMod q)
      (g := PolynomialInfrastructure.modulusProduct q k) (u : ProgressionQuotient q k))

/-- A representative of a quotient unit is coprime to every irreducible
factor of the squarefree modulus. -/
theorem progressionUnitRepresentative_not_dvd (k : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    ∀ i < k, ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣
      progressionUnitRepresentative q k u := by
  apply (FiniteFieldEncoding.isUnit_modulusQuotient_mk_iff q k
    (progressionUnitRepresentative q k u)).mp
  rw [progressionUnitRepresentative_mk]
  exact u.isUnit

/-- Recovering the quotient unit from its chosen polynomial representative
returns the original unit. -/
theorem progressionUnit_representative (k : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    progressionUnit q k (progressionUnitRepresentative q k u)
        (progressionUnitRepresentative_not_dvd q k u) = u := by
  apply Units.ext
  rw [progressionUnit_val, progressionUnitRepresentative_mk]

/-- Invertibility modulo the squarefree product is equivalent to polynomial
coprimality with that product.  This identifies the source's global
coprimality restriction with the finite unit group indexing progression
classes. -/
theorem isUnit_modulusQuotient_mk_iff_isCoprime (k : ℕ)
    (f : Polynomial (ZMod q)) :
    IsUnit (AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k) f) ↔
      IsCoprime f (PolynomialInfrastructure.modulusProduct q k) := by
  rw [FiniteFieldEncoding.isUnit_modulusQuotient_mk_iff]
  unfold PolynomialInfrastructure.modulusProduct
  rw [IsCoprime.prod_right_iff]
  simp only [Finset.mem_range]
  constructor
  · intro h i hi
    rw [isCoprime_comm,
      (PolynomialInfrastructure.auxiliaryIrreducible_irreducible q i).coprime_iff_not_dvd]
    exact h i hi
  · intro h i hi
    have hiCoprime := h i hi
    rw [isCoprime_comm,
      (PolynomialInfrastructure.auxiliaryIrreducible_irreducible q i).coprime_iff_not_dvd]
      at hiCoprime
    exact hiCoprime

/-- The invertible quotient class of the product belonging to a prime
triple. -/
noncomputable def primeTripleUnit (k d : ℕ)
    (T : RepresentationFamilies.PrimeTriple q d) :
    (ProgressionQuotient q k)ˣ :=
  progressionUnit q k (T.product q) fun i _hi =>
    T.auxiliaryIrreducible_not_dvd_product q i

@[simp]
theorem primeTripleUnit_val (k d : ℕ)
    (T : RepresentationFamilies.PrimeTriple q d) :
    ↑(primeTripleUnit q k d T) =
      AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k)
        (T.product q) := by
  exact progressionUnit_val q k (T.product q) _

/-- The unit ratio whose being one is precisely the target progression
condition. -/
noncomputable def primeTripleRatio (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (T : RepresentationFamilies.PrimeTriple q d) :
    (ProgressionQuotient q k)ˣ :=
  (progressionUnit q k a ha)⁻¹ * primeTripleUnit q k d T

theorem primeTripleRatio_eq_one_iff (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (T : RepresentationFamilies.PrimeTriple q d) :
    primeTripleRatio q k d a ha T = 1 ↔
      PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a := by
  constructor
  · intro hratio
    have hu : primeTripleUnit q k d T = progressionUnit q k a ha := by
      calc
        primeTripleUnit q k d T =
            progressionUnit q k a ha * primeTripleRatio q k d a ha T := by
          simp [primeTripleRatio]
        _ = progressionUnit q k a ha := by rw [hratio, mul_one]
    apply AdjoinRoot.mk_eq_mk.mp
    simpa only [← primeTripleUnit_val q k d T,
      ← progressionUnit_val q k a ha] using congrArg Units.val hu
  · intro hdiv
    have hq :
        AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k)
            (T.product q) =
          AdjoinRoot.mk (PolynomialInfrastructure.modulusProduct q k) a :=
      AdjoinRoot.mk_eq_mk.mpr hdiv
    have hu : primeTripleUnit q k d T = progressionUnit q k a ha := by
      apply Units.ext
      simpa only [primeTripleUnit_val, progressionUnit_val] using hq
    simp [primeTripleRatio, hu]

/-- Orthogonality away from the identity for the full complex character
group of the progression quotient. -/
theorem progressionCharacter_sum_eq_zero {k : ℕ}
    {x : ProgressionQuotient q k} (hx : IsUnit x) (hne : x ≠ 1) :
    ∑ χ : ProgressionCharacter q k, χ x = 0 := by
  obtain ⟨χ₀, hχ₀⟩ :=
    MulChar.exists_apply_ne_one_of_hasEnoughRootsOfUnity
      (ProgressionQuotient q k) ℂ hne
  refine eq_zero_of_mul_eq_self_left hχ₀ ?_
  simp only [Finset.mul_sum, ← MulChar.mul_apply]
  exact Fintype.sum_bijective _ (Group.mulLeft_bijective χ₀) _ _
    fun χ' ↦ rfl

/-- Full character orthogonality in the normalization used by the finite
Fourier expansion. -/
theorem progressionCharacter_sum_eq {k : ℕ}
    (x : ProgressionQuotient q k) (hx : IsUnit x) :
    ∑ χ : ProgressionCharacter q k, χ x =
      if x = 1 then (progressionTotient q k : ℂ) else 0 := by
  split_ifs with h
  · subst x
    simp only [map_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      mul_one, ← Nat.card_eq_fintype_card]
    rw [progressionCharacter_natCard]
  · exact progressionCharacter_sum_eq_zero q hx h

/-- Character orthogonality has its full mass on a prime triple in the
prescribed progression. -/
theorem primeTriple_character_orthogonality_of_dvd (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (T : RepresentationFamilies.PrimeTriple q d)
    (hT : PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a) :
    ∑ χ : ProgressionCharacter q k,
        χ (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k) =
      (progressionTotient q k : ℂ) := by
  rw [progressionCharacter_sum_eq q]
  · have hu := (primeTripleRatio_eq_one_iff q k d a ha T).2 hT
    have hv :
        (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k) = 1 := by
      simpa only [Units.val_eq_one] using hu
    rw [if_pos hv]
  · exact (primeTripleRatio q k d a ha T).isUnit

/-- Character orthogonality vanishes on a prime triple outside the
prescribed progression. -/
theorem primeTriple_character_orthogonality_of_not_dvd (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (T : RepresentationFamilies.PrimeTriple q d)
    (hT : ¬ PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a) :
    ∑ χ : ProgressionCharacter q k,
        χ (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k) = 0 := by
  rw [progressionCharacter_sum_eq q]
  · have hv :
        (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k) ≠ 1 := by
      intro hval
      apply hT
      apply (primeTripleRatio_eq_one_iff q k d a ha T).1
      simpa only [Units.val_eq_one] using hval
    rw [if_neg hv]
  · exact (primeTripleRatio q k d a ha T).isUnit

/-- Exact finite Fourier expansion of the unordered prime-triple count,
before separating the trivial character and estimating the nontrivial
character contribution. -/
theorem primeTriple_fourier_identity_unfactored (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) :
    ∑ χ : ProgressionCharacter q k,
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          χ (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k) =
      (progressionTotient q k : ℂ) *
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  classical
  rw [Finset.sum_comm]
  rw [show (∑ T : RepresentationFamilies.PrimeTriple q d,
      ∑ χ : ProgressionCharacter q k,
        χ (↑(primeTripleRatio q k d a ha T) : ProgressionQuotient q k)) =
      ∑ T : RepresentationFamilies.PrimeTriple q d,
        if PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a
        then (progressionTotient q k : ℂ) else 0 by
      apply Finset.sum_congr rfl
      intro T _hT
      by_cases h : PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a
      · rw [if_pos h,
          primeTriple_character_orthogonality_of_dvd q k d a ha T h]
      · rw [if_neg h,
          primeTriple_character_orthogonality_of_not_dvd q k d a ha T h]]
  calc
    (∑ T : RepresentationFamilies.PrimeTriple q d,
        if PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a
        then (progressionTotient q k : ℂ) else 0) =
        (progressionTotient q k : ℂ) *
          ∑ T : RepresentationFamilies.PrimeTriple q d,
            if PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a
            then 1 else 0 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro T _hT
      split_ifs <;> ring
    _ = (progressionTotient q k : ℂ) *
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
      rw [Finset.sum_boole]
      rfl

/-- Factored form of the finite Fourier expansion.  The inner sum is the
prime-triple character sum to which Sawin's square-root-cancellation
estimate applies. -/
theorem primeTriple_fourier_identity (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) :
    ∑ χ : ProgressionCharacter q k,
        χ (↑((progressionUnit q k a ha)⁻¹) : ProgressionQuotient q k) *
          ∑ T : RepresentationFamilies.PrimeTriple q d,
            χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k) =
      (progressionTotient q k : ℂ) *
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  rw [← primeTriple_fourier_identity_unfactored q k d a ha]
  apply Finset.sum_congr rfl
  intro χ _hχ
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro T _hT
  simp only [primeTripleRatio, Units.val_mul, map_mul]

theorem progressionTotient_pos (k : ℕ) : 0 < progressionTotient q k := by
  unfold progressionTotient
  apply Finset.prod_pos
  intro i hi
  exact Nat.sub_pos_of_lt
    (Nat.one_lt_pow (by omega) ((Fact.out : q.Prime).one_lt))

theorem progressionTotient_le_pow_sq (k : ℕ) :
    progressionTotient q k ≤ q ^ (k ^ 2) := by
  induction k with
  | zero => simp [progressionTotient]
  | succ k ih =>
      rw [progressionTotient, Finset.prod_range_succ]
      change progressionTotient q k * (q ^ (2 * k + 1) - 1) ≤
        q ^ ((k + 1) ^ 2)
      calc
        progressionTotient q k * (q ^ (2 * k + 1) - 1) ≤
            q ^ (k ^ 2) * q ^ (2 * k + 1) :=
          Nat.mul_le_mul ih (Nat.sub_le _ _)
        _ = q ^ ((k + 1) ^ 2) := by
          rw [← pow_add]
          congr 1
          ring

/-- All monic polynomials of one exact degree, without irreducibility. -/
abbrev MonicOfDegree (d : ℕ) :=
  {f : Polynomial (ZMod q) // f.Monic ∧ f.natDegree = d}

theorem monicOfDegree_coeffBelow_injective (d : ℕ) :
    Function.Injective (fun f : MonicOfDegree q d =>
      fun j : Fin d => (f : Polynomial (ZMod q)).coeff j) := by
  intro f g h
  apply Subtype.ext
  apply Polynomial.ext
  intro n
  by_cases hn : n < d
  · exact congrFun h ⟨n, hn⟩
  by_cases hnd : n = d
  · subst n
    rw [show (f : Polynomial (ZMod q)).coeff d = 1 by
        simpa only [f.2.2] using f.2.1.coeff_natDegree,
      show (g : Polynomial (ZMod q)).coeff d = 1 by
        simpa only [g.2.2] using g.2.1.coeff_natDegree]
  · have hdn : d < n := by omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa [f.2.2] using hdn),
      Polynomial.coeff_eq_zero_of_natDegree_lt (by simpa [g.2.2] using hdn)]

instance monicOfDegreeFinite (d : ℕ) : Finite (MonicOfDegree q d) := by
  let : Fintype (Fin d → ZMod q) := inferInstance
  exact Finite.of_injective _ (monicOfDegree_coeffBelow_injective q d)

noncomputable instance monicOfDegreeFintype (d : ℕ) :
    Fintype (MonicOfDegree q d) :=
  Fintype.ofFinite _

theorem monicOfDegree_card_le_pow (d : ℕ) :
    Fintype.card (MonicOfDegree q d) ≤ q ^ d := by
  let f : MonicOfDegree q d → (Fin d → ZMod q) := fun P j => P.1.coeff j
  have hinj : Function.Injective f := monicOfDegree_coeffBelow_injective q d
  have hcard := Fintype.card_le_of_injective f hinj
  simpa only [Fintype.card_fun, Fintype.card_fin, ZMod.card] using hcard

/-- A monic degree-`d` polynomial is freely determined by its `d`
coefficients below the leading coefficient.  This exact count is the
ambient `q^d` normalization used by factorization functions. -/
theorem monicOfDegree_card (d : ℕ) :
    Fintype.card (MonicOfDegree q d) = q ^ d := by
  classical
  let e := (Polynomial.degreeLTEquiv (ZMod q) d).toEquiv
  let : Fintype (Polynomial.degreeLT (ZMod q) d) :=
    Fintype.ofEquiv (Fin d → ZMod q) e.symm
  calc
    Fintype.card (MonicOfDegree q d) =
        Fintype.card (Polynomial.degreeLT (ZMod q) d) :=
      Fintype.card_congr (Polynomial.monicEquivDegreeLT d)
    _ = Fintype.card (Fin d → ZMod q) :=
      Fintype.card_congr e
    _ = q ^ d := by simp

/-! ### Literal monic progression fibers

Sawin's statement is naturally indexed by all monic polynomials in one
arithmetic progression.  The coefficient-space sum used below is not merely
an injection into that fiber: division by the monic modulus gives an exact
equivalence with the whole fiber. -/

/-- Monic degree-`n` polynomials congruent to `a` modulo `G_k`. -/
abbrev MonicProgression (k n : ℕ) (a : Polynomial (ZMod q)) :=
  {F : MonicOfDegree q n //
    modulusProduct q k ∣ (F : Polynomial (ZMod q)) - a}

noncomputable instance monicProgressionFintype (k n : ℕ)
    (a : Polynomial (ZMod q)) : Fintype (MonicProgression q k n a) :=
  Fintype.ofFinite _

/-- Polynomial representatives of the same quotient class define
canonically equivalent monic progression fibers. -/
def monicProgressionCongruentEquiv (k n : ℕ)
    (a b : Polynomial (ZMod q))
    (hab : modulusProduct q k ∣ a - b) :
    MonicProgression q k n a ≃ MonicProgression q k n b where
  toFun F := ⟨F.1, by
    obtain ⟨u, hu⟩ := F.2
    obtain ⟨v, hv⟩ := hab
    refine ⟨u + v, ?_⟩
    calc
      (F.1 : Polynomial (ZMod q)) - b =
          ((F.1 : Polynomial (ZMod q)) - a) + (a - b) := by ring
      _ = modulusProduct q k * u + modulusProduct q k * v := by
        rw [hu, hv]
      _ = modulusProduct q k * (u + v) := by ring⟩
  invFun F := ⟨F.1, by
    obtain ⟨u, hu⟩ := F.2
    obtain ⟨v, hv⟩ := hab
    refine ⟨u - v, ?_⟩
    calc
      (F.1 : Polynomial (ZMod q)) - a =
          ((F.1 : Polynomial (ZMod q)) - b) - (a - b) := by ring
      _ = modulusProduct q k * u - modulusProduct q k * v := by
        rw [hu, hv]
      _ = modulusProduct q k * (u - v) := by ring⟩
  left_inv F := by rfl
  right_inv F := by rfl

@[simp]
theorem monicProgressionCongruentEquiv_val (k n : ℕ)
    (a b : Polynomial (ZMod q))
    (hab : modulusProduct q k ∣ a - b)
    (F : MonicProgression q k n a) :
    (monicProgressionCongruentEquiv q k n a b hab F).1 = F.1 := rfl

/-- Consequently every finite weighted progression sum depends only on the
class in `𝔽_q[t]/(G_k)`, not on the selected polynomial representative. -/
theorem sum_monicProgression_congruent (k n : ℕ)
    (a b : Polynomial (ZMod q))
    (hab : modulusProduct q k ∣ a - b)
    (w : Polynomial (ZMod q) → ℕ) :
    (∑ F : MonicProgression q k n a,
      w (F.1 : Polynomial (ZMod q))) =
      ∑ F : MonicProgression q k n b,
        w (F.1 : Polynomial (ZMod q)) := by
  classical
  have h := Equiv.sum_comp (monicProgressionCongruentEquiv q k n a b hab)
    (fun F : MonicProgression q k n b =>
      w (F.1 : Polynomial (ZMod q)))
  simpa using h

/-- Dependent equality of progression-fiber elements follows from equality
of their unit indices and equality of their underlying monic polynomials. -/
theorem monicProgression_heq_of_unit_eq {k n : ℕ}
    {u v : (ProgressionQuotient q k)ˣ} (huv : u = v)
    (F : MonicProgression q k n (progressionUnitRepresentative q k u))
    (H : MonicProgression q k n (progressionUnitRepresentative q k v))
    (hval : F.1 = H.1) : HEq F H := by
  subst v
  exact heq_of_eq (Subtype.ext hval)

/-- Monic degree-`n` polynomials belonging to invertible residue classes
modulo `G_k`. -/
abbrev CoprimeMonicOfDegree (k n : ℕ) :=
  {F : MonicOfDegree q n //
    IsCoprime (F : Polynomial (ZMod q)) (modulusProduct q k)}

noncomputable instance coprimeMonicOfDegreeFintype (k n : ℕ) :
    Fintype (CoprimeMonicOfDegree q k n) :=
  Fintype.ofFinite _

noncomputable instance progressionQuotientUnitsFintype (k : ℕ) :
    Fintype (ProgressionQuotient q k)ˣ :=
  Fintype.ofFinite _

/-- The unit residue class of a monic polynomial coprime to the modulus. -/
noncomputable def coprimeMonicResidueUnit (k n : ℕ)
    (F : CoprimeMonicOfDegree q k n) : (ProgressionQuotient q k)ˣ :=
  ((isUnit_modulusQuotient_mk_iff_isCoprime q k F.1).mpr F.2).unit

@[simp]
theorem coprimeMonicResidueUnit_val (k n : ℕ)
    (F : CoprimeMonicOfDegree q k n) :
    (coprimeMonicResidueUnit q k n F : ProgressionQuotient q k) =
      AdjoinRoot.mk (modulusProduct q k)
        (F.1 : Polynomial (ZMod q)) :=
  ((isUnit_modulusQuotient_mk_iff_isCoprime q k F.1).mpr F.2).unit_spec

/-- Exact partition of the coprime monic coefficient space by the unit
residue class modulo `G_k`. -/
noncomputable def coprimeMonicEquivSigmaProgression (k n : ℕ) :
    CoprimeMonicOfDegree q k n ≃
      Σ u : (ProgressionQuotient q k)ˣ,
        MonicProgression q k n (progressionUnitRepresentative q k u) where
  toFun F :=
    ⟨coprimeMonicResidueUnit q k n F,
      ⟨F.1, by
        apply AdjoinRoot.mk_eq_mk.mp
        calc
          AdjoinRoot.mk (modulusProduct q k)
              (F.1 : Polynomial (ZMod q)) =
              (coprimeMonicResidueUnit q k n F : ProgressionQuotient q k) :=
            (coprimeMonicResidueUnit_val q k n F).symm
          _ = AdjoinRoot.mk (modulusProduct q k)
              (progressionUnitRepresentative q k
                (coprimeMonicResidueUnit q k n F)) :=
            (progressionUnitRepresentative_mk q k _).symm⟩⟩
  invFun U :=
    ⟨U.2.1, (isUnit_modulusQuotient_mk_iff_isCoprime q k U.2.1).mp (by
      have hmk :
          AdjoinRoot.mk (modulusProduct q k)
              (U.2.1 : Polynomial (ZMod q)) =
            (U.1 : ProgressionQuotient q k) := by
        calc
          AdjoinRoot.mk (modulusProduct q k)
              (U.2.1 : Polynomial (ZMod q)) =
              AdjoinRoot.mk (modulusProduct q k)
                (progressionUnitRepresentative q k U.1) :=
            AdjoinRoot.mk_eq_mk.mpr U.2.2
          _ = (U.1 : ProgressionQuotient q k) :=
            progressionUnitRepresentative_mk q k U.1
      rw [hmk]
      exact U.1.isUnit)⟩
  left_inv F := by
    apply Subtype.ext
    rfl
  right_inv U := by
    rcases U with ⟨u, F⟩
    have hunit :
        coprimeMonicResidueUnit q k n
          ((fun U : Σ u : (ProgressionQuotient q k)ˣ,
              MonicProgression q k n (progressionUnitRepresentative q k u) =>
            ⟨U.2.1, (isUnit_modulusQuotient_mk_iff_isCoprime q k U.2.1).mp (by
              have hmk :
                  AdjoinRoot.mk (modulusProduct q k)
                      (U.2.1 : Polynomial (ZMod q)) =
                    (U.1 : ProgressionQuotient q k) := by
                calc
                  AdjoinRoot.mk (modulusProduct q k)
                      (U.2.1 : Polynomial (ZMod q)) =
                      AdjoinRoot.mk (modulusProduct q k)
                        (progressionUnitRepresentative q k U.1) :=
                    AdjoinRoot.mk_eq_mk.mpr U.2.2
                  _ = (U.1 : ProgressionQuotient q k) :=
                    progressionUnitRepresentative_mk q k U.1
              rw [hmk]
              exact U.1.isUnit)⟩) ⟨u, F⟩) = u := by
      apply Units.ext
      change AdjoinRoot.mk (modulusProduct q k)
          (F.1 : Polynomial (ZMod q)) = (u : ProgressionQuotient q k)
      calc
        AdjoinRoot.mk (modulusProduct q k)
            (F.1 : Polynomial (ZMod q)) =
            AdjoinRoot.mk (modulusProduct q k)
              (progressionUnitRepresentative q k u) :=
          AdjoinRoot.mk_eq_mk.mpr F.2
        _ = (u : ProgressionQuotient q k) :=
          progressionUnitRepresentative_mk q k u
    exact Sigma.ext hunit
      (monicProgression_heq_of_unit_eq q hunit _ _ rfl)

/-- Summation form of the preceding partition: the sum over all coprime
monic polynomials is the iterated sum over invertible residue classes and
the corresponding monic progression fibers. -/
theorem sum_coprimeMonic_eq_sum_unitProgressions (k n : ℕ)
    (w : Polynomial (ZMod q) → ℕ) :
    (∑ F : CoprimeMonicOfDegree q k n,
      w (F.1 : Polynomial (ZMod q))) =
      ∑ u : (ProgressionQuotient q k)ˣ,
        ∑ F : MonicProgression q k n (progressionUnitRepresentative q k u),
          w (F.1 : Polynomial (ZMod q)) := by
  classical
  have h := Equiv.sum_comp (coprimeMonicEquivSigmaProgression q k n)
    (fun U : Σ u : (ProgressionQuotient q k)ˣ,
        MonicProgression q k n (progressionUnitRepresentative q k u) =>
      w (U.2.1 : Polynomial (ZMod q)))
  calc
    (∑ F : CoprimeMonicOfDegree q k n,
        w (F.1 : Polynomial (ZMod q))) =
        ∑ F : CoprimeMonicOfDegree q k n,
          w (((coprimeMonicEquivSigmaProgression q k n F).2.1 :
            MonicOfDegree q n) : Polynomial (ZMod q)) := by rfl
    _ = ∑ U : Σ u : (ProgressionQuotient q k)ˣ,
          MonicProgression q k n (progressionUnitRepresentative q k u),
        w (U.2.1 : Polynomial (ZMod q)) := h
    _ = ∑ u : (ProgressionQuotient q k)ˣ,
        ∑ F : MonicProgression q k n (progressionUnitRepresentative q k u),
          w (F.1 : Polynomial (ZMod q)) := by rw [Fintype.sum_sigma]

/-- Add the low-degree residue to a monic multiple of `G_k`. -/
noncomputable def affineMonicPolynomial (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    MonicOfDegree q n := by
  let G := modulusProduct q k
  let F : Polynomial (ZMod q) := a + G * (P : Polynomial (ZMod q))
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hGdegree : G.natDegree = k ^ 2 := modulusProduct_natDegree q k
  have hprodMonic : (G * (P : Polynomial (ZMod q))).Monic :=
    hGMonic.mul P.2.1
  have hprodDegree : (G * (P : Polynomial (ZMod q))).natDegree = n := by
    rw [Polynomial.natDegree_mul hGMonic.ne_zero P.2.1.ne_zero,
      hGdegree, P.2.2]
    omega
  have haDegree : a.degree < (G * (P : Polynomial (ZMod q))).degree := by
    by_cases ha0 : a = 0
    · rw [ha0, Polynomial.degree_zero]
      rw [Polynomial.degree_eq_natDegree hprodMonic.ne_zero, hprodDegree]
      exact WithBot.bot_lt_coe n
    · rw [Polynomial.degree_eq_natDegree ha0,
        Polynomial.degree_eq_natDegree hprodMonic.ne_zero, hprodDegree]
      exact_mod_cast ha.trans_le hkn
  exact ⟨F, hprodMonic.add_of_right haDegree, by
    dsimp only [F]
    rw [Polynomial.natDegree_add_eq_right_of_degree_lt haDegree,
      hprodDegree]⟩

@[simp] theorem coe_affineMonicPolynomial (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    (affineMonicPolynomial q k n a ha hkn P : Polynomial (ZMod q)) =
      a + modulusProduct q k * (P : Polynomial (ZMod q)) := by
  rfl

theorem affineMonicPolynomial_mem_progression (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    modulusProduct q k ∣
      (affineMonicPolynomial q k n a ha hkn P : Polynomial (ZMod q)) - a := by
  refine ⟨(P : Polynomial (ZMod q)), ?_⟩
  change a + modulusProduct q k * (P : Polynomial (ZMod q)) - a = _
  ring

noncomputable def affineMonicProgression (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    MonicProgression q k n a :=
  ⟨affineMonicPolynomial q k n a ha hkn P,
    affineMonicPolynomial_mem_progression q k n a ha hkn P⟩

@[simp] theorem coe_affineMonicProgression (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    ((affineMonicProgression q k n a ha hkn P).1 : Polynomial (ZMod q)) =
      a + modulusProduct q k * (P : Polynomial (ZMod q)) := by
  exact coe_affineMonicPolynomial q k n a ha hkn P

/-- Divide a polynomial in the progression by `G_k` after subtracting its
residue.  Monicity and exact degree are preserved. -/
noncomputable def monicProgressionQuotient (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (F : MonicProgression q k n a) :
    MonicOfDegree q (n - k ^ 2) := by
  let G := modulusProduct q k
  let p := (F.1 : Polynomial (ZMod q)) - a
  have hFMonic : (F.1 : Polynomial (ZMod q)).Monic := F.1.2.1
  have hFDegree : (F.1 : Polynomial (ZMod q)).natDegree = n := F.1.2.2
  have haDegree : a.degree < (F.1 : Polynomial (ZMod q)).degree := by
    calc
      a.degree ≤ (a.natDegree : WithBot ℕ) := Polynomial.degree_le_natDegree
      _ < (n : ℕ) := WithBot.coe_lt_coe.mpr (ha.trans_le hkn)
      _ = (F.1 : Polynomial (ZMod q)).degree := by
        rw [Polynomial.degree_eq_natDegree hFMonic.ne_zero, hFDegree]
  have hpMonic : p.Monic := hFMonic.sub_of_left haDegree
  have hpDegree : p.natDegree = n := by
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
    · exact hFDegree
    · simpa only [hFDegree] using ha.trans_le hkn
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hGDegree : G.natDegree = k ^ 2 := modulusProduct_natDegree q k
  have hdegree : G.degree ≤ p.degree := by
    rw [Polynomial.degree_eq_natDegree hGMonic.ne_zero,
      Polynomial.degree_eq_natDegree hpMonic.ne_zero, hGDegree, hpDegree]
    exact_mod_cast hkn
  refine ⟨p /ₘ G, ?_, ?_⟩
  · rw [Polynomial.Monic]
    rw [Polynomial.leadingCoeff_divByMonic_of_monic hGMonic hdegree]
    exact hpMonic
  · rw [Polynomial.natDegree_divByMonic p hGMonic, hpDegree, hGDegree]

theorem affineMonicProgression_left_inv (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    monicProgressionQuotient q k n a ha hkn
      (affineMonicProgression q k n a ha hkn P) = P := by
  apply Subtype.ext
  change (a + modulusProduct q k * (P : Polynomial (ZMod q)) - a) /ₘ
      modulusProduct q k = (P : Polynomial (ZMod q))
  rw [show a + modulusProduct q k * (P : Polynomial (ZMod q)) - a =
      modulusProduct q k * (P : Polynomial (ZMod q)) by ring,
    Polynomial.mul_divByMonic_cancel_left _ (modulusProduct_monic q k)]

theorem affineMonicProgression_right_inv (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (F : MonicProgression q k n a) :
    affineMonicProgression q k n a ha hkn
      (monicProgressionQuotient q k n a ha hkn F) = F := by
  apply Subtype.ext
  apply Subtype.ext
  let G := modulusProduct q k
  let p := (F.1 : Polynomial (ZMod q)) - a
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hmod : p %ₘ G = 0 :=
    (Polynomial.modByMonic_eq_zero_iff_dvd hGMonic).2 F.2
  change a + G * (p /ₘ G) = (F.1 : Polynomial (ZMod q))
  calc
    a + G * (p /ₘ G) = a + (p %ₘ G + G * (p /ₘ G)) := by
      rw [hmod, zero_add]
    _ = a + p := by rw [Polynomial.modByMonic_add_div]
    _ = (F.1 : Polynomial (ZMod q)) := by dsimp only [p]; ring

/-- Exact equivalence between coefficient vectors and the entire monic
progression fiber. -/
noncomputable def monicProgressionEquiv (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) :
    MonicOfDegree q (n - k ^ 2) ≃ MonicProgression q k n a where
  toFun := affineMonicProgression q k n a ha hkn
  invFun := monicProgressionQuotient q k n a ha hkn
  left_inv := affineMonicProgression_left_inv q k n a ha hkn
  right_inv := affineMonicProgression_right_inv q k n a ha hkn

@[simp] theorem monicProgressionEquiv_apply (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (P : MonicOfDegree q (n - k ^ 2)) :
    monicProgressionEquiv q k n a ha hkn P =
      affineMonicProgression q k n a ha hkn P := rfl

/-- Reindex any finite progression sum by its monic quotient. -/
theorem sum_monicProgression_eq_affine (k n : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < k ^ 2)
    (hkn : k ^ 2 ≤ n) (w : Polynomial (ZMod q) → ℕ) :
    (∑ F : MonicProgression q k n a,
      w (F.1 : Polynomial (ZMod q))) =
      ∑ P : MonicOfDegree q (n - k ^ 2),
        w (a + modulusProduct q k * (P : Polynomial (ZMod q))) := by
  classical
  let e := monicProgressionEquiv q k n a ha hkn
  have h := (Equiv.sum_comp e
    (fun F : MonicProgression q k n a =>
      w (F.1 : Polynomial (ZMod q)))).symm
  simpa only [e, monicProgressionEquiv_apply,
    coe_affineMonicProgression] using h

/-! ### An elementary ceiling for one progression fiber -/

/-- If a prime-triple product is congruent to `a` modulo `G_k`, division of
`T.product - a` by the monic modulus produces a monic polynomial of the exact
excess degree `6d-k²`. -/
noncomputable def primeTripleResidueQuotient (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (T : ↥(RepresentationFamilies.congruentPrimeTriples q k d a))
    (hkm : k ^ 2 ≤ 6 * d) : MonicOfDegree q (6 * d - k ^ 2) := by
  let G := modulusProduct q k
  let p := T.1.product q - a
  have hprodMonic : (T.1.product q).Monic := T.1.product_monic q
  have hprodDegree : (T.1.product q).natDegree = 6 * d :=
    T.1.product_natDegree q
  have hprod0 : T.1.product q ≠ 0 := hprodMonic.ne_zero
  have haDegree : a.degree < (T.1.product q).degree := by
    calc
      a.degree ≤ (a.natDegree : WithBot ℕ) := Polynomial.degree_le_natDegree
      _ < (6 * d : ℕ) := WithBot.coe_lt_coe.mpr ha
      _ = (T.1.product q).degree := by
        rw [Polynomial.degree_eq_natDegree hprod0, hprodDegree]
  have hpMonic : p.Monic := hprodMonic.sub_of_left haDegree
  have hpDegree : p.natDegree = 6 * d := by
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
    · exact hprodDegree
    · simpa only [hprodDegree] using ha
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hGDegree : G.natDegree = k ^ 2 := modulusProduct_natDegree q k
  have hdegree : G.degree ≤ p.degree := by
    rw [Polynomial.degree_eq_natDegree hGMonic.ne_zero,
      Polynomial.degree_eq_natDegree hpMonic.ne_zero, hGDegree, hpDegree]
    exact_mod_cast hkm
  refine ⟨p /ₘ G, ?_, ?_⟩
  · rw [Polynomial.Monic]
    rw [Polynomial.leadingCoeff_divByMonic_of_monic hGMonic hdegree]
    exact hpMonic
  · rw [Polynomial.natDegree_divByMonic p hGMonic, hpDegree, hGDegree]

/-- The quotient map is injective: the congruence says the remainders vanish,
and unique factorization recovers the unordered triple from its product. -/
theorem primeTripleResidueQuotient_injective (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    Function.Injective
      (fun T : ↥(RepresentationFamilies.congruentPrimeTriples q k d a) =>
        primeTripleResidueQuotient q k d a ha T hkm) := by
  intro T U hquot
  let G := modulusProduct q k
  let pT := T.1.product q - a
  let pU := U.1.product q - a
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hdivT : G ∣ pT :=
    (RepresentationFamilies.mem_congruentPrimeTriples (q := q)).mp T.2
  have hdivU : G ∣ pU :=
    (RepresentationFamilies.mem_congruentPrimeTriples (q := q)).mp U.2
  have hmodT : pT %ₘ G = 0 :=
    (Polynomial.modByMonic_eq_zero_iff_dvd hGMonic).2 hdivT
  have hmodU : pU %ₘ G = 0 :=
    (Polynomial.modByMonic_eq_zero_iff_dvd hGMonic).2 hdivU
  have hquot' : pT /ₘ G = pU /ₘ G := congrArg Subtype.val hquot
  have hp : pT = pU := by
    calc
      pT = pT %ₘ G + G * (pT /ₘ G) :=
        (Polynomial.modByMonic_add_div pT G).symm
      _ = G * (pT /ₘ G) := by rw [hmodT, zero_add]
      _ = G * (pU /ₘ G) := by rw [hquot']
      _ = pU %ₘ G + G * (pU /ₘ G) := by rw [hmodU, zero_add]
      _ = pU := Polynomial.modByMonic_add_div pU G
  have hprod : T.1.product q = U.1.product q := by
    apply sub_left_inj.mp
    simpa only [pT, pU] using hp
  have hfinset : T.1.1 = U.1.1 :=
    RepresentationFamilies.primePolynomialFinset_eq_of_product_eq q d
      T.1.1 U.1.1 hprod
  apply Subtype.ext
  exact Subtype.ext hfinset

/-- The quotient parametrization writes the corresponding product in the
literal affine short interval `a + G_k · M_(6d-k²)`. -/
theorem primeTriple_product_eq_add_modulus_mul_quotient (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (T : ↥(RepresentationFamilies.congruentPrimeTriples q k d a))
    (hkm : k ^ 2 ≤ 6 * d) :
    T.1.product q = a + modulusProduct q k *
      (primeTripleResidueQuotient q k d a ha T hkm :
        Polynomial (ZMod q)) := by
  let G := modulusProduct q k
  let p := T.1.product q - a
  have hGMonic : G.Monic := modulusProduct_monic q k
  have hdiv : G ∣ p :=
    (RepresentationFamilies.mem_congruentPrimeTriples (q := q)).mp T.2
  have hmod : p %ₘ G = 0 :=
    (Polynomial.modByMonic_eq_zero_iff_dvd hGMonic).2 hdiv
  have hp : G * (p /ₘ G) = p := by
    calc
      G * (p /ₘ G) = p %ₘ G + G * (p /ₘ G) := by rw [hmod, zero_add]
      _ = p := Polynomial.modByMonic_add_div p G
  calc
    T.1.product q = a + (T.1.product q - a) := by ring
    _ = a + G * (p /ₘ G) := by rw [hp]
    _ = a + modulusProduct q k *
        (primeTripleResidueQuotient q k d a ha T hkm :
          Polynomial (ZMod q)) := by rfl

/-- The exact finite subset of monic quotient space corresponding to
three-distinct-prime factorizations in the short interval. -/
noncomputable def primeTripleResidueQuotientImage (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) : Finset (MonicOfDegree q (6 * d - k ^ 2)) :=
  Finset.univ.image (fun T => primeTripleResidueQuotient q k d a ha T hkm)

@[simp]
theorem mem_primeTripleResidueQuotientImage_iff (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) (P : MonicOfDegree q (6 * d - k ^ 2)) :
    P ∈ primeTripleResidueQuotientImage q k d a ha hkm ↔
      ∃ T : ↥(RepresentationFamilies.congruentPrimeTriples q k d a),
        primeTripleResidueQuotient q k d a ha T hkm = P := by
  simp [primeTripleResidueQuotientImage]

/-- The congruence count is exactly the cardinality of its distinct-prime
factorization locus inside monic quotient coefficient space. -/
theorem primeTripleResidueQuotientImage_card (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    (primeTripleResidueQuotientImage q k d a ha hkm).card =
      (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  unfold primeTripleResidueQuotientImage
  rw [Finset.card_image_of_injective Finset.univ
    (primeTripleResidueQuotient_injective q k d a ha hkm), Finset.card_univ,
    Fintype.card_coe]

/-- The source-facing three-prime locus in the affine coefficient space of
the short interval `a + G_k · M_(6d-k²)`. -/
noncomputable def shortIntervalThreePrimeLocus (k d : ℕ)
    (a : Polynomial (ZMod q)) : Finset (MonicOfDegree q (6 * d - k ^ 2)) := by
  classical
  exact Finset.univ.filter fun P =>
    ∃ T : RepresentationFamilies.PrimeTriple q d,
      T.product q = a + modulusProduct q k * (P : Polynomial (ZMod q))

@[simp]
theorem mem_shortIntervalThreePrimeLocus_iff (k d : ℕ)
    (a : Polynomial (ZMod q)) (P : MonicOfDegree q (6 * d - k ^ 2)) :
    P ∈ shortIntervalThreePrimeLocus q k d a ↔
      ∃ T : RepresentationFamilies.PrimeTriple q d,
        T.product q = a + modulusProduct q k * (P : Polynomial (ZMod q)) := by
  simp [shortIntervalThreePrimeLocus]

/-- The quotient image and the literal three-prime factorization locus are
the same finite subset of monic coefficient space. -/
theorem primeTripleResidueQuotientImage_eq_shortIntervalThreePrimeLocus
    (k d : ℕ) (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    primeTripleResidueQuotientImage q k d a ha hkm =
      shortIntervalThreePrimeLocus q k d a := by
  classical
  ext P
  rw [mem_primeTripleResidueQuotientImage_iff,
    mem_shortIntervalThreePrimeLocus_iff]
  constructor
  · rintro ⟨T, rfl⟩
    exact ⟨T.1,
      primeTriple_product_eq_add_modulus_mul_quotient q k d a ha T hkm⟩
  · rintro ⟨T, hprod⟩
    have hmem : T ∈ RepresentationFamilies.congruentPrimeTriples q k d a := by
      rw [RepresentationFamilies.mem_congruentPrimeTriples]
      refine ⟨(P : Polynomial (ZMod q)), ?_⟩
      rw [hprod]
      ring
    let Ts : ↥(RepresentationFamilies.congruentPrimeTriples q k d a) :=
      ⟨T, hmem⟩
    refine ⟨Ts, ?_⟩
    apply Subtype.ext
    change (T.product q - a) /ₘ modulusProduct q k =
      (P : Polynomial (ZMod q))
    have hsub : T.product q - a =
        modulusProduct q k * (P : Polynomial (ZMod q)) := by
      rw [hprod]
      ring
    rw [hsub, Polynomial.mul_divByMonic_cancel_left _
      (modulusProduct_monic q k)]

/-- The source's short-interval factorization count is literally the same
natural number as the progression count used by the probability layer. -/
theorem shortIntervalThreePrimeLocus_card (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    (shortIntervalThreePrimeLocus q k d a).card =
      (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  rw [← primeTripleResidueQuotientImage_eq_shortIntervalThreePrimeLocus
    q k d a ha hkm]
  exact primeTripleResidueQuotientImage_card q k d a ha hkm

/-- Canonical degree-bounded representative of a progression residue. -/
noncomputable def normalizedResidue (k : ℕ)
    (a : Polynomial (ZMod q)) : Polynomial (ZMod q) :=
  a %ₘ modulusProduct q k

/-- A normalized representative has degree strictly below the modulus degree
`k²` whenever the progression is nontrivial. -/
theorem normalizedResidue_natDegree_lt (k : ℕ) (hk : 1 ≤ k)
    (a : Polynomial (ZMod q)) :
    (normalizedResidue q k a).natDegree < k ^ 2 := by
  let G := modulusProduct q k
  have hGMonic : G.Monic := modulusProduct_monic q k
  by_cases hz : normalizedResidue q k a = 0
  · rw [hz, Polynomial.natDegree_zero]
    positivity
  · rw [Polynomial.natDegree_lt_iff_degree_lt hz]
    simpa only [normalizedResidue, G, modulusProduct_natDegree,
      Polynomial.degree_eq_natDegree hGMonic.ne_zero] using
      Polynomial.degree_modByMonic_lt a hGMonic

theorem modulusProduct_dvd_normalizedResidue_sub (k : ℕ)
    (a : Polynomial (ZMod q)) :
    modulusProduct q k ∣ normalizedResidue q k a - a := by
  exact Polynomial.dvd_modByMonic_sub a (modulusProduct q k)

/-- Divisibility by the modulus depends only on the residue class, so
subtracting the canonical remainder is equivalent to subtracting the
original representative. -/
theorem modulusProduct_dvd_sub_normalizedResidue_iff (k : ℕ)
    (F a : Polynomial (ZMod q)) :
    modulusProduct q k ∣ F - normalizedResidue q k a ↔
      modulusProduct q k ∣ F - a := by
  let G := modulusProduct q k
  let r := normalizedResidue q k a
  have hra : G ∣ r - a := modulusProduct_dvd_normalizedResidue_sub q k a
  constructor
  · rintro ⟨u, hu⟩
    rcases hra with ⟨v, hv⟩
    refine ⟨u + v, ?_⟩
    calc
      F - a = (F - r) + (r - a) := by ring
      _ = G * u + G * v := by rw [hu, hv]
      _ = G * (u + v) := by ring
  · rintro ⟨u, hu⟩
    rcases hra with ⟨v, hv⟩
    refine ⟨u - v, ?_⟩
    calc
      F - r = (F - a) - (r - a) := by ring
      _ = G * u - G * v := by rw [hu, hv]
      _ = G * (u - v) := by ring

/-- Replacing a representative by its canonical remainder gives the same
entire monic progression fiber. -/
noncomputable def monicProgressionNormalizedResidueEquiv (k n : ℕ)
    (a : Polynomial (ZMod q)) :
    MonicProgression q k n a ≃
      MonicProgression q k n (normalizedResidue q k a) where
  toFun F := ⟨F.1,
    (modulusProduct_dvd_sub_normalizedResidue_iff q k F.1 a).2 F.2⟩
  invFun F := ⟨F.1,
    (modulusProduct_dvd_sub_normalizedResidue_iff q k F.1 a).1 F.2⟩
  left_inv F := by rfl
  right_inv F := by rfl

@[simp] theorem monicProgressionNormalizedResidueEquiv_val (k n : ℕ)
    (a : Polynomial (ZMod q)) (F : MonicProgression q k n a) :
    (monicProgressionNormalizedResidueEquiv q k n a F).1 = F.1 := rfl

/-- Every finite weighted progression sum is invariant under canonical
residue normalization. -/
theorem sum_monicProgression_normalizedResidue (k n : ℕ)
    (a : Polynomial (ZMod q)) (w : Polynomial (ZMod q) → ℕ) :
    (∑ F : MonicProgression q k n (normalizedResidue q k a),
      w (F.1 : Polynomial (ZMod q))) =
      ∑ F : MonicProgression q k n a,
        w (F.1 : Polynomial (ZMod q)) := by
  classical
  have h := Equiv.sum_comp
    (monicProgressionNormalizedResidueEquiv q k n a)
    (fun F : MonicProgression q k n (normalizedResidue q k a) =>
      w (F.1 : Polynomial (ZMod q)))
  simpa using h.symm

/-- Replacing a polynomial by its canonical remainder does not change its
prime-triple progression fiber. -/
theorem congruentPrimeTriples_normalizedResidue (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    RepresentationFamilies.congruentPrimeTriples q k d
        (normalizedResidue q k a) =
      RepresentationFamilies.congruentPrimeTriples q k d a := by
  classical
  ext T
  simp only [RepresentationFamilies.mem_congruentPrimeTriples]
  let G := modulusProduct q k
  let r := normalizedResidue q k a
  have hra : G ∣ r - a := modulusProduct_dvd_normalizedResidue_sub q k a
  constructor
  · rintro ⟨u, hu⟩
    rcases hra with ⟨v, hv⟩
    refine ⟨u + v, ?_⟩
    calc
      T.product q - a = (T.product q - r) + (r - a) := by ring
      _ = G * u + G * v := by rw [hu, hv]
      _ = G * (u + v) := by ring
  · rintro ⟨u, hu⟩
    rcases hra with ⟨v, hv⟩
    refine ⟨u - v, ?_⟩
    calc
      T.product q - r = (T.product q - a) - (r - a) := by ring
      _ = G * u - G * v := by rw [hu, hv]
      _ = G * (u - v) := by ring

/-- Coprimality with every auxiliary factor is preserved by normalization. -/
theorem normalizedResidue_not_dvd (k : ℕ) (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    ∀ i < k, ¬ auxiliaryIrreducible q i ∣ normalizedResidue q k a := by
  intro i hi hdiv
  let g := auxiliaryIrreducible q i
  let G := modulusProduct q k
  let r := normalizedResidue q k a
  have hgG : g ∣ G := auxiliaryIrreducible_dvd_modulusProduct q hi
  have hraG : G ∣ r - a := modulusProduct_dvd_normalizedResidue_sub q k a
  have hra : g ∣ r - a := hgG.trans hraG
  apply ha i hi
  rcases hdiv with ⟨u, hu⟩
  rcases hra with ⟨v, hv⟩
  change r = g * u at hu
  refine ⟨u - v, ?_⟩
  calc
    a = r - (r - a) := by ring
    _ = r - g * v := by rw [hv]
    _ = g * u - g * v := by rw [hu]
    _ = g * (u - v) := by ring

/-- In the canonical degree range, every original progression count is
exactly the three-prime locus in its normalized affine short interval. -/
theorem canonical_shortIntervalThreePrimeLocus_card (k : ℕ) (hk : 3 ≤ k)
    (a : Polynomial (ZMod q)) :
    (shortIntervalThreePrimeLocus q k (Construction.canonicalDegreeIndex k)
        (normalizedResidue q k a)).card =
      (RepresentationFamilies.congruentPrimeTriples q k
        (Construction.canonicalDegreeIndex k) a).card := by
  have hkm : k ^ 2 ≤ 6 * Construction.canonicalDegreeIndex k := by
    have hrange := Construction.modulus_degree_in_sawin_range hk
    omega
  have ha0 := normalizedResidue_natDegree_lt q k (by omega) a
  have ha : (normalizedResidue q k a).natDegree <
      6 * Construction.canonicalDegreeIndex k := ha0.trans_le hkm
  rw [shortIntervalThreePrimeLocus_card q k
      (Construction.canonicalDegreeIndex k) (normalizedResidue q k a) ha hkm,
    congruentPrimeTriples_normalizedResidue q]

/-- The exact ordered von-Mangoldt weight of a coefficient vector in the
three-distinct-prime part of the affine short interval.  Every factor has
degree `2d`, and every unordered triple has six orderings, hence the common
weight `6 * (2d)^3`. -/
noncomputable def shortIntervalThreePrimeWeight (k d : ℕ)
    (a : Polynomial (ZMod q))
    (P : MonicOfDegree q (6 * d - k ^ 2)) : ℕ :=
  if P ∈ shortIntervalThreePrimeLocus q k d a then
    6 * (2 * d) ^ 3 else 0

/-- The equal-degree, three-distinct-prime ordered von-Mangoldt
factorization function on an arbitrary polynomial.  Unique factorization
means that existence of the underlying unordered triple is enough: its six
orderings all have weight `(2d)^3`. -/
noncomputable def equalDegreeDistinctThreePrimeWeight (d : ℕ)
    (F : Polynomial (ZMod q)) : ℕ :=
  if ∃ T : RepresentationFamilies.PrimeTriple q d, T.product q = F then
    6 * (2 * d) ^ 3 else 0

/-- The specialized factorization function is supported on polynomials
coprime to the auxiliary modulus. -/
theorem equalDegreeDistinctThreePrimeWeight_eq_zero_of_not_isCoprime
    (k d : ℕ) (F : Polynomial (ZMod q))
    (hF : ¬ IsCoprime F (modulusProduct q k)) :
    equalDegreeDistinctThreePrimeWeight q d F = 0 := by
  unfold equalDegreeDistinctThreePrimeWeight
  split_ifs with h
  · obtain ⟨T, rfl⟩ := h
    exact (hF (T.product_isCoprime_modulusProduct q k)).elim
  · rfl

/-- The monic degree-`6d` polynomial obtained by multiplying an unordered
triple of distinct monic degree-`2d` primes. -/
noncomputable def primeTripleProductMonic (d : ℕ)
    (T : RepresentationFamilies.PrimeTriple q d) :
    MonicOfDegree q (6 * d) :=
  ⟨T.product q, T.product_monic q, T.product_natDegree q⟩

/-- Unique factorization makes the prime-triple product map injective. -/
theorem primeTripleProductMonic_injective (d : ℕ) :
    Function.Injective (primeTripleProductMonic q d) := by
  intro T U h
  apply Subtype.ext
  exact RepresentationFamilies.primePolynomialFinset_eq_of_product_eq q d
    T.1 U.1 (congrArg Subtype.val h)

/-- The exact degree-`6d` factorization-type locus in the global monic
coefficient space. -/
noncomputable def primeTripleProductImage (d : ℕ) :
    Finset (MonicOfDegree q (6 * d)) :=
  Finset.univ.image (primeTripleProductMonic q d)

@[simp]
theorem mem_primeTripleProductImage_iff (d : ℕ)
    (F : MonicOfDegree q (6 * d)) :
    F ∈ primeTripleProductImage q d ↔
      ∃ T : RepresentationFamilies.PrimeTriple q d,
        T.product q = (F : Polynomial (ZMod q)) := by
  simp only [primeTripleProductImage, Finset.mem_image, Finset.mem_univ,
    true_and, primeTripleProductMonic]
  constructor
  · rintro ⟨T, hT⟩
    exact ⟨T, congrArg Subtype.val hT⟩
  · rintro ⟨T, hT⟩
    refine ⟨T, ?_⟩
    exact Subtype.ext hT

/-- The factorization-type locus has exactly one point for every unordered
prime triple. -/
theorem primeTripleProductImage_card (d : ℕ) :
    (primeTripleProductImage q d).card =
      Fintype.card (RepresentationFamilies.PrimeTriple q d) := by
  unfold primeTripleProductImage
  rw [Finset.card_image_of_injective Finset.univ
      (primeTripleProductMonic_injective q d),
    Finset.card_univ]

/-- The coefficient-space indicator is literally evaluation of the source
factorization function on the affine polynomial `a + GₖP`. -/
theorem shortIntervalThreePrimeWeight_eq_factorizationWeight (k d : ℕ)
    (a : Polynomial (ZMod q))
    (P : MonicOfDegree q (6 * d - k ^ 2)) :
    shortIntervalThreePrimeWeight q k d a P =
      equalDegreeDistinctThreePrimeWeight q d
        (a + modulusProduct q k * (P : Polynomial (ZMod q))) := by
  simp only [shortIntervalThreePrimeWeight,
    equalDegreeDistinctThreePrimeWeight,
    mem_shortIntervalThreePrimeLocus_iff]

/-- Summing the coefficient-space weight is exactly the common ordered
von-Mangoldt weight times the cardinality of the three-prime locus. -/
theorem sum_shortIntervalThreePrimeWeight (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    (∑ P : MonicOfDegree q (6 * d - k ^ 2),
      shortIntervalThreePrimeWeight q k d a P) =
      6 * (2 * d) ^ 3 * (shortIntervalThreePrimeLocus q k d a).card := by
  classical
  let W := 6 * (2 * d) ^ 3
  let L := shortIntervalThreePrimeLocus q k d a
  calc
    (∑ P : MonicOfDegree q (6 * d - k ^ 2),
        shortIntervalThreePrimeWeight q k d a P) =
        W * ∑ P : MonicOfDegree q (6 * d - k ^ 2),
          if P ∈ L then 1 else 0 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro P _hP
      simp only [shortIntervalThreePrimeWeight, W, L]
      split_ifs <;> simp_all
    _ = W * L.card := by simp
    _ = 6 * (2 * d) ^ 3 *
        (shortIntervalThreePrimeLocus q k d a).card := by rfl

/-- Consequently the entire affine coefficient-space mass is the source
factorization-function sum, with no change of normalization. -/
theorem sum_shortIntervalThreePrimeWeight_eq_factorizationWeight (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    (∑ P : MonicOfDegree q (6 * d - k ^ 2),
      shortIntervalThreePrimeWeight q k d a P) =
      ∑ P : MonicOfDegree q (6 * d - k ^ 2),
        equalDegreeDistinctThreePrimeWeight q d
          (a + modulusProduct q k * (P : Polynomial (ZMod q))) := by
  apply Finset.sum_congr rfl
  intro P _hP
  exact shortIntervalThreePrimeWeight_eq_factorizationWeight q k d a P

/-- In the admissible degree range, the coefficient-space factorization
sum is exactly the ordered weighted progression count. -/
theorem sum_shortIntervalThreePrimeWeight_eq_progression (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    (∑ P : MonicOfDegree q (6 * d - k ^ 2),
      shortIntervalThreePrimeWeight q k d a P) =
      6 * (2 * d) ^ 3 *
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  rw [sum_shortIntervalThreePrimeWeight,
    shortIntervalThreePrimeLocus_card q k d a ha hkm]

/-- The affine-short-interval coefficient sum and the literal ordered
progression sum are the same finite sum after unique factorization. -/
theorem sum_shortIntervalThreePrimeWeight_eq_orderedProgression (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    (∑ P : MonicOfDegree q (6 * d - k ^ 2),
      shortIntervalThreePrimeWeight q k d a P) =
      ∑ T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
        RepresentationFamilies.primeTripleOrderingWeight d := by
  rw [sum_shortIntervalThreePrimeWeight_eq_progression q k d a ha hkm,
    RepresentationFamilies.sum_congruentPrimeTripleOrderingWeight]

/-- After multiplication by the progression totient, the literal ordered
progression mass is still exactly the affine coefficient-space factorization
sum.  This is the form used as the second argument of the source deviation. -/
theorem orderedProgression_eq_shortIntervalWeightSum (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    progressionTotient q k *
        (∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
          RepresentationFamilies.primeTripleOrderingWeight d) =
      progressionTotient q k *
        ∑ P : MonicOfDegree q (6 * d - k ^ 2),
          shortIntervalThreePrimeWeight q k d a P := by
  congr 1
  exact (sum_shortIntervalThreePrimeWeight_eq_orderedProgression q k d
    a ha hkm).symm

/-- The literal ordered progression mass, not only the underlying unordered
fiber, is unchanged when the residue is replaced by its canonical remainder. -/
theorem sum_congruentPrimeTripleOrderingWeight_normalizedResidue (k d : ℕ)
    (a : Polynomial (ZMod q)) :
    (∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d
        (normalizedResidue q k a),
      RepresentationFamilies.primeTripleOrderingWeight d) =
      ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
        RepresentationFamilies.primeTripleOrderingWeight d := by
  rw [RepresentationFamilies.sum_congruentPrimeTripleOrderingWeight,
    RepresentationFamilies.sum_congruentPrimeTripleOrderingWeight,
    congruentPrimeTriples_normalizedResidue q]

/-- Normalization leaves the represented unit of the progression quotient
unchanged. -/
theorem progressionUnit_normalizedResidue (k : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    progressionUnit q k (normalizedResidue q k a)
        (normalizedResidue_not_dvd q k a ha) =
      progressionUnit q k a ha := by
  apply Units.ext
  rw [progressionUnit_val, progressionUnit_val]
  apply AdjoinRoot.mk_eq_mk.mpr
  exact modulusProduct_dvd_normalizedResidue_sub q k a

/-- Every residue fiber has at most `q^(6d-k²)` unordered prime triples.  This
is exact ambient counting, independent of any cancellation theorem. -/
theorem congruentPrimeTriples_card_le_pow_excess (k d : ℕ)
    (a : Polynomial (ZMod q)) (ha : a.natDegree < 6 * d)
    (hkm : k ^ 2 ≤ 6 * d) :
    (RepresentationFamilies.congruentPrimeTriples q k d a).card ≤
      q ^ (6 * d - k ^ 2) := by
  rw [← Fintype.card_coe, ← monicOfDegree_card q (6 * d - k ^ 2)]
  exact Fintype.card_le_of_injective
    (primeTripleResidueQuotient q k d a ha · hkm)
    (primeTripleResidueQuotient_injective q k d a ha hkm)

/-! ### A quantitative Gauss bound from the degree-`d` Galois field -/

/-- Elements of `𝔽_{q^d}` whose minimal polynomial over `𝔽_q` has degree
exactly `e`. -/
abbrev MinpolyDegreeElement (d e : ℕ) [NeZero d] :=
  {x : GaloisField q d // (minpoly (ZMod q) x).natDegree = e}

noncomputable instance minpolyDegreeElementFintype (d e : ℕ) [NeZero d] :
    Fintype (MinpolyDegreeElement q d e) :=
  Fintype.ofFinite _

noncomputable def minpolyAsMonic {d e : ℕ} [NeZero d]
    (x : MinpolyDegreeElement q d e) : MonicOfDegree q e :=
  ⟨minpoly (ZMod q) x.1,
    minpoly.monic (Algebra.IsIntegral.isIntegral x.1), x.2⟩

/-- A fiber of the minimal-polynomial map injects into the root set of that
polynomial. -/
noncomputable def minpolyFiberToRootSet {d e : ℕ} [NeZero d]
    (P : MonicOfDegree q e)
    (x : {x : MinpolyDegreeElement q d e //
      minpolyAsMonic (q := q) (d := d) (e := e) x = P}) :
    ↥((P.1).rootSet (GaloisField q d)) := by
  refine ⟨x.1.1, (P.2.1.mem_rootSet).2 ?_⟩
  have hpoly : minpoly (ZMod q) x.1.1 = P.1 :=
    congrArg Subtype.val x.2
  rw [← hpoly]
  exact minpoly.aeval (ZMod q) x.1.1

theorem minpolyFiberToRootSet_injective {d e : ℕ} [NeZero d]
    (P : MonicOfDegree q e) :
    Function.Injective
      (minpolyFiberToRootSet (q := q) (d := d) (e := e) P) := by
  intro x y h
  have hval : x.1.1 = y.1.1 :=
    congrArg
      (fun z : ↥((P.1).rootSet (GaloisField q d)) =>
        (z : GaloisField q d)) h
  apply Subtype.ext
  apply Subtype.ext
  exact hval

theorem minpoly_fiber_card_le {d e : ℕ} [NeZero d]
    (P : MonicOfDegree q e) :
    Fintype.card
        {x : MinpolyDegreeElement q d e //
          minpolyAsMonic (q := q) (d := d) (e := e) x = P} ≤ e := by
  classical
  calc
    Fintype.card
        {x : MinpolyDegreeElement q d e //
          minpolyAsMonic (q := q) (d := d) (e := e) x = P} ≤
        Fintype.card ↥((P.1).rootSet (GaloisField q d)) :=
      Fintype.card_le_of_injective
        (minpolyFiberToRootSet (q := q) (d := d) (e := e) P)
        (minpolyFiberToRootSet_injective (q := q) (d := d) (e := e) P)
    _ = Set.ncard ((P.1).rootSet (GaloisField q d)) :=
      Set.fintypeCard_eq_ncard _
    _ ≤ (P.1).natDegree := Polynomial.ncard_rootSet_le P.1 _
    _ = e := P.2.2

/-- The degree-`e` elements of `𝔽_{q^d}` are partitioned by their monic
minimal polynomial, and every part has at most `e` elements. -/
theorem minpolyDegreeElement_card_le {d e : ℕ} [NeZero d] :
    Fintype.card (MinpolyDegreeElement q d e) ≤ e * q ^ e := by
  classical
  let f : MinpolyDegreeElement q d e → MonicOfDegree q e :=
    minpolyAsMonic (q := q) (d := d) (e := e)
  have hcard : Fintype.card (MinpolyDegreeElement q d e) =
      ∑ P : MonicOfDegree q e,
        Fintype.card {x : MinpolyDegreeElement q d e // f x = P} := by
    rw [← Fintype.card_sigma]
    exact (Fintype.card_congr (Equiv.sigmaFiberEquiv f)).symm
  rw [hcard]
  calc
    (∑ P : MonicOfDegree q e,
        Fintype.card {x : MinpolyDegreeElement q d e // f x = P}) ≤
        ∑ _P : MonicOfDegree q e, e := by
      apply Finset.sum_le_sum
      intro P _hP
      simpa only [f] using minpoly_fiber_card_le q P
    _ = Fintype.card (MonicOfDegree q e) * e := by simp
    _ ≤ q ^ e * e := Nat.mul_le_mul_right e (monicOfDegree_card_le_pow q e)
    _ = e * q ^ e := Nat.mul_comm _ _

theorem minpoly_natDegree_dvd_extension {d : ℕ} [NeZero d]
    (x : GaloisField q d) :
    (minpoly (ZMod q) x).natDegree ∣ d := by
  have hdvd := minpoly.degree_dvd (K := ZMod q) (x := x)
    (Algebra.IsIntegral.isIntegral x)
  simpa only [GaloisField.finrank q (NeZero.ne d)] using
    hdvd

theorem minpoly_natDegree_pos {d : ℕ} [NeZero d]
    (x : GaloisField q d) :
    0 < (minpoly (ZMod q) x).natDegree := by
  rw [Polynomial.natDegree_pos_iff_degree_pos]
  exact Polynomial.degree_pos_of_irreducible
    (minpoly.irreducible (Algebra.IsIntegral.isIntegral x))

/-- A positive proper divisor of `d` is at most `d / 2`. -/
theorem properDivisor_le_half {e d : ℕ} (he : 0 < e)
    (hd : 0 < d) (hed : e ∣ d) (hne : e ≠ d) : e ≤ d / 2 := by
  obtain ⟨c, rfl⟩ := hed
  have hc : 2 ≤ c := by
    by_contra hcnot
    have : c ≤ 1 := by omega
    interval_cases c <;> simp_all
  apply (Nat.le_div_iff_mul_le (by omega)).2
  nlinarith

/-- Elements whose minimal polynomial does not have the full extension degree. -/
abbrev NonFullDegreeElement (d : ℕ) [NeZero d] :=
  {x : GaloisField q d // (minpoly (ZMod q) x).natDegree ≠ d}

noncomputable instance nonFullDegreeElementFintype (d : ℕ) [NeZero d] :
    Fintype (NonFullDegreeElement q d) := Fintype.ofFinite _

/-- A non-full-degree element belongs to a layer indexed by a degree at most
`d / 2`. -/
noncomputable def nonFullDegreeEmbedding {d : ℕ} [NeZero d]
    (x : NonFullDegreeElement q d) :
    Σ e : Fin (d / 2 + 1), MinpolyDegreeElement q d e := by
  let e := (minpoly (ZMod q) x.1).natDegree
  have he : e ≤ d / 2 := properDivisor_le_half
    (minpoly_natDegree_pos q x.1) (Nat.pos_of_ne_zero (NeZero.ne d))
    (minpoly_natDegree_dvd_extension q x.1) x.2
  exact ⟨⟨e, by omega⟩, ⟨x.1, rfl⟩⟩

theorem nonFullDegreeEmbedding_injective {d : ℕ} [NeZero d] :
    Function.Injective (nonFullDegreeEmbedding (q := q) (d := d)) := by
  intro x y h
  apply Subtype.ext
  exact congrArg
    (fun z : Σ e : Fin (d / 2 + 1), MinpolyDegreeElement q d e =>
      (z.2.1 : GaloisField q d)) h

/-- There are at most `d² q^(d/2)` elements in `𝔽_{q^d}` lying in proper
subextensions. -/
theorem nonFullDegreeElement_card_le {d : ℕ} [NeZero d] (hd : 2 ≤ d) :
    Fintype.card (NonFullDegreeElement q d) ≤ d ^ 2 * q ^ (d / 2) := by
  classical
  calc
    Fintype.card (NonFullDegreeElement q d) ≤
        Fintype.card
          (Σ e : Fin (d / 2 + 1), MinpolyDegreeElement q d e) :=
      Fintype.card_le_of_injective _ (nonFullDegreeEmbedding_injective q)
    _ = ∑ e : Fin (d / 2 + 1),
          Fintype.card (MinpolyDegreeElement q d e) := Fintype.card_sigma
    _ ≤ ∑ _e : Fin (d / 2 + 1), d * q ^ (d / 2) := by
      apply Finset.sum_le_sum
      intro e _he
      calc
        Fintype.card (MinpolyDegreeElement q d e) ≤ e * q ^ (e : ℕ) :=
          minpolyDegreeElement_card_le q
        _ ≤ d * q ^ (d / 2) := by
          have hehalf : (e : ℕ) ≤ d / 2 := by omega
          apply Nat.mul_le_mul
          · omega
          · exact Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) hehalf
    _ = (d / 2 + 1) * (d * q ^ (d / 2)) := by simp
    _ ≤ d ^ 2 * q ^ (d / 2) := by
      have hhalf : d / 2 + 1 ≤ d := by omega
      calc
        (d / 2 + 1) * (d * q ^ (d / 2)) ≤
            d * (d * q ^ (d / 2)) :=
          Nat.mul_le_mul_right _ hhalf
        _ = d ^ 2 * q ^ (d / 2) := by ring

/-- Cardinality of the family of monic irreducibles of degree `d`. -/
noncomputable def primePolynomialCount (d : ℕ) : ℕ :=
  Fintype.card (OfDegree q d)

/-- Unordered triples of distinct degree-`2d` primes are counted by the
corresponding binomial coefficient. -/
theorem primeTriple_card (d : ℕ) :
    Fintype.card (RepresentationFamilies.PrimeTriple q d) =
      Nat.choose (primePolynomialCount q (2 * d)) 3 := by
  simpa only [RepresentationFamilies.PrimeTriple, primePolynomialCount] using
    (Fintype.card_finset_len (α := OfDegree q (2 * d)) 3)

/-- The unspecialized ordered factorization count has the exact factor 3!.
This is the global main term paired with the progression-side identity above. -/
theorem primeTripleOrdering_card_eq (d : ℕ) :
    Fintype.card (RepresentationFamilies.PrimeTripleOrdering q d) =
      6 * Nat.choose (primePolynomialCount q (2 * d)) 3 := by
  rw [RepresentationFamilies.primeTripleOrdering_card, primeTriple_card]

/-- Including the common von-Mangoldt weight, the global mass is six times
(2d)^3 times choose(P_(2d), 3). -/
theorem sum_primeTripleOrderingWeight (d : ℕ) :
    (∑ _T : RepresentationFamilies.PrimeTripleOrdering q d,
        RepresentationFamilies.primeTripleOrderingWeight d) =
      6 * (2 * d) ^ 3 *
        Nat.choose (primePolynomialCount q (2 * d)) 3 := by
  classical
  calc
    (∑ _T : RepresentationFamilies.PrimeTripleOrdering q d,
        RepresentationFamilies.primeTripleOrderingWeight d) =
        Fintype.card (RepresentationFamilies.PrimeTripleOrdering q d) *
          RepresentationFamilies.primeTripleOrderingWeight d := by simp
    _ = (6 * Nat.choose (primePolynomialCount q (2 * d)) 3) *
          (2 * d) ^ 3 := by
      rw [primeTripleOrdering_card_eq]
      rfl
    _ = 6 * (2 * d) ^ 3 *
          Nat.choose (primePolynomialCount q (2 * d)) 3 := by ring

/-- Summing the source factorization function over the entire monic
degree-`6d` coefficient space gives exactly the global ordered prime-triple
mass. -/
theorem sum_equalDegreeDistinctThreePrimeWeight (d : ℕ) :
    (∑ F : MonicOfDegree q (6 * d),
      equalDegreeDistinctThreePrimeWeight q d
        (F : Polynomial (ZMod q))) =
      6 * (2 * d) ^ 3 *
        Nat.choose (primePolynomialCount q (2 * d)) 3 := by
  classical
  let W := 6 * (2 * d) ^ 3
  let L := primeTripleProductImage q d
  calc
    (∑ F : MonicOfDegree q (6 * d),
        equalDegreeDistinctThreePrimeWeight q d
          (F : Polynomial (ZMod q))) =
        W * ∑ F : MonicOfDegree q (6 * d),
          if F ∈ L then 1 else 0 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro F _hF
      simp only [equalDegreeDistinctThreePrimeWeight, W, L,
        mem_primeTripleProductImage_iff]
      split_ifs <;> simp_all
    _ = W * L.card := by simp
    _ = W * Fintype.card
        (RepresentationFamilies.PrimeTriple q d) := by
      rw [primeTripleProductImage_card]
    _ = 6 * (2 * d) ^ 3 *
        Nat.choose (primePolynomialCount q (2 * d)) 3 := by
      rw [primeTriple_card]

/-- The global main term in Sawin's theorem, written with its literal
coprimality restriction. -/
noncomputable def coprimeEqualDegreeDistinctThreePrimeWeightSum (k d : ℕ) : ℕ :=
  by
    classical
    exact ∑ F : MonicOfDegree q (6 * d),
      if IsCoprime (F : Polynomial (ZMod q)) (modulusProduct q k) then
        equalDegreeDistinctThreePrimeWeight q d
          (F : Polynomial (ZMod q))
      else 0

/-- The `if IsCoprime` presentation of the global source mass is exactly
the sum over the subtype of coprime monic polynomials.  This is the form
which can be partitioned by residue classes. -/
theorem coprimeEqualDegreeDistinctThreePrimeWeightSum_eq_subtype (k d : ℕ) :
    coprimeEqualDegreeDistinctThreePrimeWeightSum q k d =
      ∑ F : CoprimeMonicOfDegree q k (6 * d),
        equalDegreeDistinctThreePrimeWeight q d
          (F.1 : Polynomial (ZMod q)) := by
  classical
  unfold coprimeEqualDegreeDistinctThreePrimeWeightSum
  rw [← Finset.sum_filter]
  exact Finset.sum_subtype
    (Finset.univ.filter fun F : MonicOfDegree q (6 * d) =>
      IsCoprime (F : Polynomial (ZMod q)) (modulusProduct q k))
    (by simp) (fun F : MonicOfDegree q (6 * d) =>
      equalDegreeDistinctThreePrimeWeight q d
        (F : Polynomial (ZMod q)))

/-- In the even-degree specialization, Sawin's coprime global sum is the
unrestricted global sum and therefore has the exact binomial value. -/
theorem coprimeEqualDegreeDistinctThreePrimeWeightSum_eq (k d : ℕ) :
    coprimeEqualDegreeDistinctThreePrimeWeightSum q k d =
      6 * (2 * d) ^ 3 *
        Nat.choose (primePolynomialCount q (2 * d)) 3 := by
  classical
  rw [coprimeEqualDegreeDistinctThreePrimeWeightSum]
  calc
    (∑ F : MonicOfDegree q (6 * d),
      if IsCoprime (F : Polynomial (ZMod q)) (modulusProduct q k) then
        equalDegreeDistinctThreePrimeWeight q d
          (F : Polynomial (ZMod q))
      else 0) =
        ∑ F : MonicOfDegree q (6 * d),
          equalDegreeDistinctThreePrimeWeight q d
            (F : Polynomial (ZMod q)) := by
      apply Finset.sum_congr rfl
      intro F _hF
      by_cases hc : IsCoprime (F : Polynomial (ZMod q)) (modulusProduct q k)
      · simp [hc]
      · rw [if_neg hc,
          equalDegreeDistinctThreePrimeWeight_eq_zero_of_not_isCoprime
            q k d F hc]
    _ = 6 * (2 * d) ^ 3 *
        Nat.choose (primePolynomialCount q (2 * d)) 3 :=
      sum_equalDegreeDistinctThreePrimeWeight q d

/-- The minimal polynomial of a full-degree element is a monic irreducible
of degree `d`. -/
noncomputable def minpolyAsPrime {d : ℕ} [NeZero d]
    (x : MinpolyDegreeElement q d d) : OfDegree q d :=
  ⟨minpoly (ZMod q) x.1,
    minpoly.monic (Algebra.IsIntegral.isIntegral x.1),
    minpoly.irreducible (Algebra.IsIntegral.isIntegral x.1), x.2⟩

noncomputable def minpolyPrimeFiberToRootSet {d : ℕ} [NeZero d]
    (P : OfDegree q d)
    (x : {x : MinpolyDegreeElement q d d //
      minpolyAsPrime (q := q) (d := d) x = P}) :
    ↥((P.1).rootSet (GaloisField q d)) := by
  refine ⟨x.1.1, (P.2.1.mem_rootSet).2 ?_⟩
  have hpoly : minpoly (ZMod q) x.1.1 = P.1 :=
    congrArg Subtype.val x.2
  rw [← hpoly]
  exact minpoly.aeval (ZMod q) x.1.1

theorem minpolyPrimeFiberToRootSet_injective {d : ℕ} [NeZero d]
    (P : OfDegree q d) :
    Function.Injective
      (minpolyPrimeFiberToRootSet (q := q) (d := d) P) := by
  intro x y h
  have hval : x.1.1 = y.1.1 :=
    congrArg
      (fun z : ↥((P.1).rootSet (GaloisField q d)) =>
        (z : GaloisField q d)) h
  apply Subtype.ext
  apply Subtype.ext
  exact hval

theorem minpolyPrime_fiber_card_le {d : ℕ} [NeZero d]
    (P : OfDegree q d) :
    Fintype.card
        {x : MinpolyDegreeElement q d d //
          minpolyAsPrime (q := q) (d := d) x = P} ≤ d := by
  classical
  calc
    Fintype.card
        {x : MinpolyDegreeElement q d d //
          minpolyAsPrime (q := q) (d := d) x = P} ≤
        Fintype.card ↥((P.1).rootSet (GaloisField q d)) :=
      Fintype.card_le_of_injective
        (minpolyPrimeFiberToRootSet (q := q) (d := d) P)
        (minpolyPrimeFiberToRootSet_injective (q := q) (d := d) P)
    _ = Set.ncard ((P.1).rootSet (GaloisField q d)) :=
      Set.fintypeCard_eq_ncard _
    _ ≤ (P.1).natDegree := Polynomial.ncard_rootSet_le P.1 _
    _ = d := P.2.2.2

/-- Full-degree elements give the elementary upper half of Gauss's count:
there are at most `d` roots above each degree-`d` irreducible. -/
theorem fullDegreeElement_card_le {d : ℕ} [NeZero d] :
    Fintype.card (MinpolyDegreeElement q d d) ≤
      d * primePolynomialCount q d := by
  classical
  let f : MinpolyDegreeElement q d d → OfDegree q d :=
    minpolyAsPrime (q := q) (d := d)
  have hcard : Fintype.card (MinpolyDegreeElement q d d) =
      ∑ P : OfDegree q d,
        Fintype.card {x : MinpolyDegreeElement q d d // f x = P} := by
    rw [← Fintype.card_sigma]
    exact (Fintype.card_congr (Equiv.sigmaFiberEquiv f)).symm
  rw [hcard]
  calc
    (∑ P : OfDegree q d,
        Fintype.card {x : MinpolyDegreeElement q d d // f x = P}) ≤
        ∑ _P : OfDegree q d, d := by
      apply Finset.sum_le_sum
      intro P _hP
      simpa only [f] using minpolyPrime_fiber_card_le q P
    _ = Fintype.card (OfDegree q d) * d := by simp
    _ = d * primePolynomialCount q d := by
      rw [Nat.mul_comm]
      rfl

/-- A quantitative lower bound for the number of degree-`d` monic
irreducibles, derived solely from the finite extension `𝔽_{q^d}`. -/
theorem gauss_lower_bound {d : ℕ} (hd : 2 ≤ d) :
    q ^ d ≤ d * primePolynomialCount q d + d ^ 2 * q ^ (d / 2) := by
  let : NeZero d := ⟨by omega⟩
  classical
  let partition : GaloisField q d →
      MinpolyDegreeElement q d d ⊕ NonFullDegreeElement q d := fun x =>
    if h : (minpoly (ZMod q) x).natDegree = d then Sum.inl ⟨x, h⟩
    else Sum.inr ⟨x, h⟩
  let forget : MinpolyDegreeElement q d d ⊕ NonFullDegreeElement q d →
      GaloisField q d
    | Sum.inl x => x.1
    | Sum.inr x => x.1
  have hpartition_injective : Function.Injective partition := by
    intro x y hxy
    have hval := congrArg forget hxy
    have hforget (z : GaloisField q d) : forget (partition z) = z := by
      by_cases hz : (minpoly (ZMod q) z).natDegree = d
      · simp [partition, forget, hz]
      · simp [partition, forget, hz]
    rw [hforget x, hforget y] at hval
    exact hval
  have hpartition := Nat.card_le_card_of_injective partition hpartition_injective
  have hfullCard : Nat.card (MinpolyDegreeElement q d d) =
      Fintype.card (MinpolyDegreeElement q d d) := Nat.card_eq_fintype_card
  have hbadCard : Nat.card (NonFullDegreeElement q d) =
      Fintype.card (NonFullDegreeElement q d) := Nat.card_eq_fintype_card
  rw [Nat.card_sum, hfullCard, hbadCard] at hpartition
  have hfield := GaloisField.card q d (by omega)
  have hfull := fullDegreeElement_card_le q (d := d)
  have hbad := nonFullDegreeElement_card_le q hd
  omega

/-- The large fixed coefficient field makes the proper-subfield error much
smaller than the ambient field.  This deliberately crude estimate is enough
for every degree used below. -/
theorem twice_sq_le_pow_half (hq : 2 ^ 500 ≤ q) {d : ℕ} (hd : 2 ≤ d) :
    2 * d ^ 2 ≤ q ^ (d / 2) := by
  have hdexp : d ≤ 2 ^ d := Nat.lt_two_pow_self.le
  have hexp : 2 * d + 1 ≤ 500 * (d / 2) := by omega
  calc
    2 * d ^ 2 ≤ 2 * (2 ^ d) ^ 2 := Nat.mul_le_mul_left 2
      (Nat.pow_le_pow_left hdexp 2)
    _ = 2 ^ (2 * d + 1) := by
      rw [← pow_mul]
      ring_nf
    _ ≤ 2 ^ (500 * (d / 2)) := Nat.pow_le_pow_right (by omega) hexp
    _ = (2 ^ 500) ^ (d / 2) := by rw [pow_mul]
    _ ≤ q ^ (d / 2) := Nat.pow_le_pow_left hq _

/-- Convenient corollary of the Galois-field count: for `q ≥ 2^500`, at
least `q^d/(2d)` monic irreducibles have degree `d`. -/
theorem gauss_lower_bound_simple (hq : 2 ^ 500 ≤ q) {d : ℕ} (hd : 2 ≤ d) :
    q ^ d ≤ 2 * d * primePolynomialCount q d := by
  let A := q ^ d
  let B := d * primePolynomialCount q d
  let E := d ^ 2 * q ^ (d / 2)
  have hgauss : A ≤ B + E := by
    simpa only [A, B, E] using gauss_lower_bound q hd
  have herror : 2 * E ≤ A := by
    calc
      2 * E =
          (2 * d ^ 2) * q ^ (d / 2) := by ring
      _ ≤ q ^ (d / 2) * q ^ (d / 2) :=
        Nat.mul_le_mul_right _ (twice_sq_le_pow_half q hq hd)
      _ = q ^ (d / 2 + d / 2) := by rw [pow_add]
      _ ≤ q ^ d := Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) (by omega)
      _ = A := rfl
  have htwice : 2 * A ≤ 2 * B + 2 * E := by
    calc
      2 * A ≤ 2 * (B + E) := Nat.mul_le_mul_left 2 hgauss
      _ = 2 * B + 2 * E := by ring
  have hAB : A ≤ 2 * B := by omega
  simpa only [A, B, Nat.mul_assoc] using hAB

theorem six_mul_choose_three (n : ℕ) :
    6 * Nat.choose n 3 = n * (n - 1) * (n - 2) := by
  have hthree := Nat.choose_succ_right_eq n 2
  have htwo := Nat.choose_succ_right_eq n 1
  norm_num at hthree htwo
  nlinarith

theorem cube_le_twentyFour_mul_choose_three {n : ℕ} (hn : 4 ≤ n) :
    n ^ 3 ≤ 24 * Nat.choose n 3 := by
  have h₁ : n ≤ 2 * (n - 1) := by omega
  have h₂ : n ≤ 2 * (n - 2) := by omega
  calc
    n ^ 3 = (n * n) * n := by ring
    _ ≤ (n * (2 * (n - 1))) * (2 * (n - 2)) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left n h₁) h₂
    _ = 4 * (n * (n - 1) * (n - 2)) := by ring
    _ = 24 * Nat.choose n 3 := by rw [← six_mul_choose_three]; ring

theorem six_mul_degree_lt_field_pow (hq : 2 ^ 500 ≤ q) {d : ℕ}
    (hd : 2 ≤ d) : 6 * d < q ^ d := by
  have hdexp : d ≤ 2 ^ d := Nat.lt_two_pow_self.le
  have hexp : d + 3 < 500 * d := by omega
  calc
    6 * d < 8 * d := by omega
    _ ≤ 8 * 2 ^ d := Nat.mul_le_mul_left 8 hdexp
    _ = 2 ^ (d + 3) := by rw [pow_add]; norm_num; ring
    _ < 2 ^ (500 * d) := Nat.pow_lt_pow_right (by omega) hexp
    _ = (2 ^ 500) ^ d := by rw [pow_mul]
    _ ≤ q ^ d := Nat.pow_le_pow_left hq d

theorem four_le_primePolynomialCount (hq : 2 ^ 500 ≤ q) {d : ℕ}
    (hd : 2 ≤ d) : 4 ≤ primePolynomialCount q d := by
  have hgauss := gauss_lower_bound_simple q hq hd
  have hgrowth := six_mul_degree_lt_field_pow q hq hd
  by_contra hnot
  have hsmall : primePolynomialCount q d ≤ 3 := by omega
  have hupper : 2 * d * primePolynomialCount q d ≤ 6 * d := by
    nlinarith
  omega

/-- A cubed version of the simple Gauss lower bound, ready to compare with
the three-prime binomial main term. -/
theorem primePolynomialCount_cube_bound (hq : 2 ^ 500 ≤ q) {d : ℕ}
    (hd : 2 ≤ d) (hP : 4 ≤ primePolynomialCount q d) :
    q ^ (3 * d) ≤
      192 * d ^ 3 * Nat.choose (primePolynomialCount q d) 3 := by
  have hgauss := gauss_lower_bound_simple q hq hd
  have hcubed := Nat.pow_le_pow_left hgauss 3
  have hchoose := cube_le_twentyFour_mul_choose_three hP
  calc
    q ^ (3 * d) = (q ^ d) ^ 3 := by
      rw [show 3 * d = d * 3 by omega, pow_mul]
    _ ≤ (2 * d * primePolynomialCount q d) ^ 3 := hcubed
    _ = 8 * d ^ 3 * (primePolynomialCount q d) ^ 3 := by ring
    _ ≤ 8 * d ^ 3 * (24 * Nat.choose (primePolynomialCount q d) 3) :=
      Nat.mul_le_mul_left _ hchoose
    _ = 192 * d ^ 3 * Nat.choose (primePolynomialCount q d) 3 := by ring

/-- The multinomial coefficient `(3d)!/(d!)³` occurring in Sawin's
factorization function `F_{d,d,d}`. -/
def equalDegreeMultinomial (d : ℕ) : ℕ :=
  Nat.choose (3 * d) d * Nat.choose (2 * d) d

theorem equalDegreeMultinomial_le_two_pow (d : ℕ) :
    equalDegreeMultinomial d ≤ 2 ^ (5 * d) := by
  unfold equalDegreeMultinomial
  calc
    Nat.choose (3 * d) d * Nat.choose (2 * d) d ≤
        2 ^ (3 * d) * 2 ^ (2 * d) :=
      Nat.mul_le_mul (Nat.choose_le_two_pow _ _) (Nat.choose_le_two_pow _ _)
    _ = 2 ^ (5 * d) := by rw [← pow_add]; congr 1 <;> omega

/-- Explicit integer envelope with the two terms occurring in Sawin's
Lemma 9.9 after specialization to three equal degrees.  The half-integral
powers of `q` are rounded upward.  This is the quantitative target used by
the later distinct-prime specialization; deriving that specialization must
also include Sawin's Lemmas 9.12--9.14 sieve, rather than treating the outer
factor `2` as a substitute for the sieve. -/
def equalDegreeError (d m : ℕ) : ℕ :=
  2 * equalDegreeMultinomial d *
    (2 ^ (m - 2) * Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) *
        q ^ ((3 * d + 1 - m) / 2) +
      2 ^ (m - 3) * Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) *
        q ^ ((3 * d + 2 - m) / 2))

/-- The explicit `C₁`-coefficient in Sawin's Lemma 9.9 after specializing
the convolution to three equal degrees.  It bounds the compactly supported
cohomology group in the lower of the two contributing degrees. -/
def equalDegreeLowerRank (d m : ℕ) : ℕ :=
  equalDegreeMultinomial d * 2 ^ (m - 2) *
    Nat.choose (3 * d + 2 * m + 1) (3 * m + 1)

/-- The explicit `C₂`-coefficient in Sawin's Lemma 9.9 after specializing
the convolution to three equal degrees.  It bounds the compactly supported
cohomology group in the upper of the two contributing degrees. -/
def equalDegreeUpperRank (d m : ℕ) : ℕ :=
  equalDegreeMultinomial d * 2 ^ (m - 3) *
    Nat.choose (3 * d + 2 * m - 3) (3 * m - 4)

/-- The upward-rounded Deligne radius in the lower cohomological degree of
Sawin's Proposition 7.1. -/
def equalDegreeLowerRadius (d m : ℕ) : ℕ :=
  q ^ ((3 * d + 1 - m) / 2)

/-- The upward-rounded Deligne radius in the adjacent upper cohomological
degree of Sawin's Proposition 7.1. -/
def equalDegreeUpperRadius (d m : ℕ) : ℕ :=
  q ^ ((3 * d + 2 - m) / 2)

/-- The two terms printed in Lemma 9.9, with the factor `2` introduced by
the averaging step of Theorem 7.2, are exactly `equalDegreeError`.  This
identity keeps the lower and upper cohomological contributions separate
until the final arithmetic envelope. -/
theorem equalDegreeError_eq_two_mul_rankRadius (d m : ℕ) :
    equalDegreeError q d m =
      2 * (equalDegreeLowerRank d m * equalDegreeLowerRadius q d m +
        equalDegreeUpperRank d m * equalDegreeUpperRadius q d m) := by
  unfold equalDegreeError equalDegreeLowerRank equalDegreeUpperRank
    equalDegreeLowerRadius equalDegreeUpperRadius
  ring

/-! ### The two-degree Frobenius-trace layer

Sawin's Proposition 7.1 has a particularly small analytic core after the
characteristic-cycle calculation has been completed.  The compactly
supported cohomology contributing to the nonconstant progression error is
supported in two adjacent degrees.  In the lower degree it has dimension at
most `C₁`; in the upper degree it has dimension at most `C₂`.  Deligne's
weight theorem bounds every Frobenius eigenvalue in those degrees.  The next
definition and lemmas isolate the resulting finite-dimensional triangle
inequality.  They deliberately mention neither sheaves nor characteristic
cycles, so that the future geometric construction has an exact, minimal
certificate to produce. -/

/-! ### The finite fixed-point trace identity

Lemma 2.1 in Sawin's argument first identifies the trace on a finite
Frobenius-stable fiber with the weighted sum over its rational fixed points.
The genuinely cohomological part of Grothendieck--Lefschetz replaces that
finite permutation module by compactly supported cohomology.  The elementary
fixed-point identity itself is recorded here without any geometric
abstraction: it is an exact matrix calculation. -/

/-- The permutation matrix of `σ`, with the row indexed by a point weighted
by `w`.  Its trace is the weighted fixed-point count. -/
def weightedPermutationMatrix {X : Type*} [Fintype X] [DecidableEq X]
    (σ : Equiv.Perm X) (w : X → ℂ) : Matrix X X ℂ :=
  Matrix.diagonal w * σ.permMatrix ℂ

/-- A weighted permutation trace is exactly the sum of the weights at fixed
points.  This is the finite-linear-algebra core of the trace-function
identity in Sawin's Lemma 2.1. -/
theorem weightedPermutationMatrix_trace
    {X : Type*} [Fintype X] [DecidableEq X]
    (σ : Equiv.Perm X) (w : X → ℂ) :
    (weightedPermutationMatrix σ w).trace =
      ∑ x with σ x = x, w x := by
  classical
  unfold weightedPermutationMatrix Matrix.trace
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro i hi
  change (∑ x, Matrix.diagonal w i x * (σ.permMatrix ℂ) x i) = _
  simp only [Matrix.mul_apply, Matrix.diagonal_apply,
    Equiv.Perm.permMatrix, PEquiv.toMatrix_apply]
  rw [Finset.sum_eq_single (σ.symm i)]
  · simp [Equiv.apply_eq_iff_eq_symm_apply]
  · intro b hb hne
    simp [Equiv.apply_eq_iff_eq_symm_apply, hne]
  · simp

/-- Restriction of a permutation to a fiber of an invariant map. -/
def fiberPermutation {X Y : Type*} (p : X → Y) (σ : Equiv.Perm X)
    (hσ : ∀ x, p (σ x) = p x) (y : Y) :
    Equiv.Perm {x : X // p x = y} where
  toFun x := ⟨σ x, (hσ x).trans x.property⟩
  invFun x := ⟨σ.symm x, by
    rw [← hσ (σ.symm x), σ.apply_symm_apply]
    exact x.property⟩
  left_inv x := Subtype.ext (σ.symm_apply_apply x)
  right_inv x := Subtype.ext (σ.apply_symm_apply x)

/-- Fiberwise form of the weighted fixed-point trace identity.  In the
geometric application, `p` is the product-of-roots map and `σ` is arithmetic
Frobenius; its fixed points are precisely the rational factorizations in the
chosen progression fiber. -/
theorem weightedFiberPermutation_trace
    {X Y : Type*} [Fintype X] [DecidableEq X] [DecidableEq Y]
    (p : X → Y) (σ : Equiv.Perm X) (hσ : ∀ x, p (σ x) = p x)
    (y : Y) (w : X → ℂ) :
    (weightedPermutationMatrix (fiberPermutation p σ hσ y)
      (fun x => w x)).trace =
      ∑ x : {x : X // p x = y},
        if σ (x : X) = (x : X) then w x else 0 := by
  rw [weightedPermutationMatrix_trace]
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro x hx
  simp [fiberPermutation, Subtype.ext_iff]

open scoped Matrix.Norms.L2Operator in
/-- If every point weight has norm at most `radius`, then every
characteristic root of the corresponding weighted permutation matrix has
norm at most `radius`.  Thus the elementary fixed-point matrix already has
the precise root-radius format consumed by the two-degree trace layer. -/
theorem weightedPermutationMatrix_root_norm_le
    {X : Type*} [Fintype X] [DecidableEq X] [Nonempty X]
    (σ : Equiv.Perm X) (w : X → ℂ) (radius : ℝ)
    (hradius : 0 ≤ radius) (hw : ∀ x, ‖w x‖ ≤ radius)
    {z : ℂ} (hz : z ∈ (weightedPermutationMatrix σ w).charpoly.roots) :
    ‖z‖ ≤ radius := by
  have hwNorm : ‖w‖ ≤ radius :=
    (pi_norm_le_iff_of_nonneg hradius).2 hw
  have hzroot :
      Polynomial.IsRoot (weightedPermutationMatrix σ w).charpoly z :=
    (Polynomial.mem_roots'.mp hz).2
  have hzspec : z ∈ spectrum ℂ (weightedPermutationMatrix σ w) :=
    Matrix.mem_spectrum_of_isRoot_charpoly hzroot
  calc
    ‖z‖ ≤ ‖weightedPermutationMatrix σ w‖ :=
      spectrum.norm_le_norm_of_mem hzspec
    _ ≤ ‖Matrix.diagonal w‖ * ‖σ.permMatrix ℂ‖ :=
      Matrix.l2_opNorm_mul _ _
    _ ≤ ‖w‖ * 1 := by
      rw [Matrix.l2_opNorm_diagonal]
      exact mul_le_mul_of_nonneg_left (Matrix.permMatrix_l2_opNorm_le σ)
        (norm_nonneg w)
    _ ≤ radius := by simpa using hwNorm

/-! ### The finite Hopf trace identity

The next three lemmas formalize the linear-algebraic part of the passage
from a Frobenius action on a cochain complex to its action on cohomology.
They are independent of any theory of sheaves: the first is trace
additivity for an invariant subspace, the second is the first-isomorphism
identification of quotient-by-kernel with image, and the third combines
them.  Alternating the third identity over a bounded complex makes all
image traces cancel in adjacent degrees. -/

open Module.Basis

/-- Trace is additive across an invariant subspace and the induced
endomorphism of the quotient.  This is the exact-sequence trace identity
used in the finite-dimensional Hopf trace formula. -/
theorem trace_eq_trace_restrict_add_trace_quotient
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (W : Submodule K V) (e : V →ₗ[K] V) (he : W ≤ W.comap e) :
    LinearMap.trace K V e =
      LinearMap.trace K W (e.restrict he) +
        LinearMap.trace K (V ⧸ W) (W.mapQ W e he) := by
  let m := Module.Free.ChooseBasisIndex K W
  let bW : Module.Basis m K W := Module.Free.chooseBasis K W
  let n := Module.Free.ChooseBasisIndex K (V ⧸ W)
  let bQ : Module.Basis n K (V ⧸ W) := Module.Free.chooseBasis K (V ⧸ W)
  let b := sumQuot bW bQ
  rw [LinearMap.trace_eq_matrix_trace K b,
    LinearMap.trace_eq_matrix_trace K bW,
    LinearMap.trace_eq_matrix_trace K bQ]
  unfold Matrix.trace
  rw [Fintype.sum_sum_type]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _hi
    simp only [Matrix.diag_apply, b, sumQuot_inl, LinearMap.toMatrix_apply,
      LinearMap.restrict_apply]
    exact sumQuot_repr_inl_of_mem bW bQ _
      (he (Submodule.coe_mem (bW i))) i
  · apply Finset.sum_congr rfl
    intro j _hj
    simp only [Matrix.diag_apply, LinearMap.toMatrix_apply, sumQuot_repr_inr, b]
    rw [← sumQuot_inr bW bQ j, W.mapQ_apply]
    rfl

/-- For a commuting square, the induced action on the quotient by the
kernel is conjugate to the restricted action on the range.  Consequently
their traces agree. -/
theorem trace_restrict_range_eq_trace_quotient_ker
    {K V W : Type*} [Field K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (d : V →ₗ[K] W) (fV : V →ₗ[K] V) (fW : W →ₗ[K] W)
    (hcomm : fW.comp d = d.comp fV) :
    let hker : LinearMap.ker d ≤ (LinearMap.ker d).comap fV := by
      intro x hx
      rw [LinearMap.mem_ker] at hx
      change d (fV x) = 0
      have := LinearMap.congr_fun hcomm x
      simpa [hx] using this.symm
    let hrange : LinearMap.range d ≤ (LinearMap.range d).comap fW := by
      rintro _ ⟨x, rfl⟩
      exact ⟨fV x, (LinearMap.congr_fun hcomm x).symm⟩
    LinearMap.trace K (LinearMap.range d) (fW.restrict hrange) =
      LinearMap.trace K (V ⧸ LinearMap.ker d)
        ((LinearMap.ker d).mapQ (LinearMap.ker d) fV hker) := by
  dsimp only
  let hker : LinearMap.ker d ≤ (LinearMap.ker d).comap fV := by
    intro x hx
    rw [LinearMap.mem_ker] at hx
    change d (fV x) = 0
    have h := LinearMap.congr_fun hcomm x
    simpa [hx] using h.symm
  let hrange : LinearMap.range d ≤ (LinearMap.range d).comap fW := by
    rintro _ ⟨x, rfl⟩
    exact ⟨fV x, (LinearMap.congr_fun hcomm x).symm⟩
  let e := d.quotKerEquivRange
  let qmap := (LinearMap.ker d).mapQ (LinearMap.ker d) fV hker
  have hconj : fW.restrict hrange = e.conj qmap := by
    apply LinearMap.ext
    rintro ⟨y, hy⟩
    obtain ⟨x, rfl⟩ := hy
    apply Subtype.ext
    change fW (d x) =
      ((e (qmap (e.symm ⟨d x, ⟨x, rfl⟩⟩)) : LinearMap.range d) : W)
    rw [show e.symm ⟨d x, ⟨x, rfl⟩⟩ =
        (LinearMap.ker d).mkQ x by
      exact LinearMap.quotKerEquivRange_symm_apply_image d x ⟨x, rfl⟩]
    simp only [qmap, e]
    exact LinearMap.congr_fun hcomm x
  rw [hconj, LinearMap.trace_conj']

/-- A commuting differential decomposes the trace on its source into the
trace on cocycles killed by the differential and the trace on boundaries
in its target.  This is the local identity whose image terms telescope in
the Hopf trace formula. -/
theorem trace_eq_trace_ker_add_trace_range_of_commute
    {K V W : Type*} [Field K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (d : V →ₗ[K] W) (fV : V →ₗ[K] V) (fW : W →ₗ[K] W)
    (hcomm : fW.comp d = d.comp fV) :
    let hker : LinearMap.ker d ≤ (LinearMap.ker d).comap fV := by
      intro x hx
      rw [LinearMap.mem_ker] at hx
      change d (fV x) = 0
      have := LinearMap.congr_fun hcomm x
      simpa [hx] using this.symm
    let hrange : LinearMap.range d ≤ (LinearMap.range d).comap fW := by
      rintro _ ⟨x, rfl⟩
      exact ⟨fV x, (LinearMap.congr_fun hcomm x).symm⟩
    LinearMap.trace K V fV =
      LinearMap.trace K (LinearMap.ker d) (fV.restrict hker) +
        LinearMap.trace K (LinearMap.range d) (fW.restrict hrange) := by
  dsimp only
  let hker : LinearMap.ker d ≤ (LinearMap.ker d).comap fV := by
    intro x hx
    rw [LinearMap.mem_ker] at hx
    change d (fV x) = 0
    have h := LinearMap.congr_fun hcomm x
    simpa [hx] using h.symm
  let hrange : LinearMap.range d ≤ (LinearMap.range d).comap fW := by
    rintro _ ⟨x, rfl⟩
    exact ⟨fV x, (LinearMap.congr_fun hcomm x).symm⟩
  rw [trace_eq_trace_restrict_add_trace_quotient (LinearMap.ker d) fV hker]
  congr 1
  exact (trace_restrict_range_eq_trace_quotient_ker d fV fW hcomm).symm

/-- Alternating sum over the cohomological degrees `0,…,n-1`. -/
def alternatingSum {K : Type*} [CommRing K] (n : ℕ) (f : ℕ → K) : K :=
  ∑ i ∈ Finset.range n, (-1 : K) ^ i * f i

/-- In an alternating sum, adjacent boundary contributions telescope to
the two endpoint terms. -/
theorem alternatingSum_boundary (K : Type*) [CommRing K]
    (n : ℕ) (b : ℕ → K) :
    alternatingSum n (fun i ↦ b i + b (i + 1)) =
      b 0 - (-1 : K) ^ n * b n := by
  induction n with
  | zero => simp [alternatingSum]
  | succ n ih =>
      rw [alternatingSum, Finset.sum_range_succ]
      rw [show (∑ i ∈ Finset.range n, (-1 : K) ^ i *
          (b i + b (i + 1))) =
          alternatingSum n (fun i ↦ b i + b (i + 1)) by
        rfl, ih]
      rw [pow_succ]
      ring

/-- Abstract bounded Hopf trace formula.  If the trace in degree `i` is
the homology trace plus the incoming and outgoing boundary traces, then
the alternating trace on the complex equals the alternating trace on
homology.  The preceding exact-sequence lemmas produce `htrace` for a
finite-dimensional cochain complex and a commuting endomorphism. -/
theorem alternatingSum_eq_of_eq_homology_add_boundaries
    {K : Type*} [CommRing K]
    (n : ℕ) (chainTrace homologyTrace boundaryTrace : ℕ → K)
    (htrace : ∀ i < n,
      chainTrace i = homologyTrace i + boundaryTrace i + boundaryTrace (i + 1))
    (hzero : boundaryTrace 0 = 0) (hn : boundaryTrace n = 0) :
    alternatingSum n chainTrace = alternatingSum n homologyTrace := by
  calc
    alternatingSum n chainTrace =
        alternatingSum n (fun i ↦
          homologyTrace i + (boundaryTrace i + boundaryTrace (i + 1))) := by
      unfold alternatingSum
      apply Finset.sum_congr rfl
      intro i hi
      rw [htrace i (Finset.mem_range.mp hi)]
      ring
    _ = alternatingSum n homologyTrace +
        alternatingSum n (fun i ↦ boundaryTrace i + boundaryTrace (i + 1)) := by
      unfold alternatingSum
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _hi
      ring
    _ = alternatingSum n homologyTrace := by
      rw [alternatingSum_boundary, hzero, hn]
      ring

/-- A concrete bounded three-term cochain complex.  This is sufficient for
the two-adjacent-degree situation in Proposition 7.1 after padding by a
zero group at either end. -/
structure ThreeTermCochainComplex (K C₀ C₁ C₂ : Type*)
    [Field K]
    [AddCommGroup C₀] [Module K C₀]
    [AddCommGroup C₁] [Module K C₁]
    [AddCommGroup C₂] [Module K C₂] where
  d₀ : C₀ →ₗ[K] C₁
  d₁ : C₁ →ₗ[K] C₂
  d_comp : d₁.comp d₀ = 0

/-- An endomorphism of a three-term cochain complex: the two squares with
the differentials commute. -/
structure ThreeTermCochainEndomorphism
    {K C₀ C₁ C₂ : Type*} [Field K]
    [AddCommGroup C₀] [Module K C₀]
    [AddCommGroup C₁] [Module K C₁]
    [AddCommGroup C₂] [Module K C₂]
    (C : ThreeTermCochainComplex K C₀ C₁ C₂) where
  f₀ : C₀ →ₗ[K] C₀
  f₁ : C₁ →ₗ[K] C₁
  f₂ : C₂ →ₗ[K] C₂
  comm₀ : f₁.comp C.d₀ = C.d₀.comp f₀
  comm₁ : f₂.comp C.d₁ = C.d₁.comp f₁

namespace ThreeTermCochainComplex

variable {K C₀ C₁ C₂ : Type*} [Field K]
    [AddCommGroup C₀] [Module K C₀]
    [AddCommGroup C₁] [Module K C₁]
    [AddCommGroup C₂] [Module K C₂]
    (C : ThreeTermCochainComplex K C₀ C₁ C₂)

/-- Boundaries in the middle cycle space. -/
def middleBoundary : Submodule K (LinearMap.ker C.d₁) :=
  (LinearMap.range C.d₀).comap (LinearMap.ker C.d₁).subtype

/-- The three homology groups of a three-term complex. -/
abbrev homology₀ := LinearMap.ker C.d₀
abbrev homology₁ := (LinearMap.ker C.d₁) ⧸ C.middleBoundary
abbrev homology₂ := C₂ ⧸ LinearMap.range C.d₁

/-- Each cohomology group of the three-term complex has dimension at most
the dimension of the cochain space in the same degree.  This lets a
geometric construction discharge the numerical rank obligation using
explicit cochain-space bounds, without separately choosing bases of
cohomology. -/
theorem homology₀_finrank_le
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    Module.finrank K C.homology₀ ≤ Module.finrank K C₀ :=
  (LinearMap.ker C.d₀).finrank_le

theorem homology₁_finrank_le
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    Module.finrank K C.homology₁ ≤ Module.finrank K C₁ := by
  exact C.middleBoundary.finrank_quotient_le.trans
    (LinearMap.ker C.d₁).finrank_le

theorem homology₂_finrank_le
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    Module.finrank K C.homology₂ ≤ Module.finrank K C₂ :=
  (LinearMap.range C.d₁).finrank_quotient_le

/-- Summed form of the three degreewise cohomology bounds. -/
theorem homology_finrank_sum_le
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    Module.finrank K C.homology₀ + Module.finrank K C.homology₁ +
        Module.finrank K C.homology₂ ≤
      Module.finrank K C₀ + Module.finrank K C₁ +
        Module.finrank K C₂ := by
  exact Nat.add_le_add
    (Nat.add_le_add C.homology₀_finrank_le C.homology₁_finrank_le)
    C.homology₂_finrank_le

variable (F : ThreeTermCochainEndomorphism C)

theorem ker₀_invariant :
    LinearMap.ker C.d₀ ≤ (LinearMap.ker C.d₀).comap F.f₀ := by
  intro x hx
  rw [LinearMap.mem_ker] at hx
  change C.d₀ (F.f₀ x) = 0
  have h := LinearMap.congr_fun F.comm₀ x
  simpa [hx] using h.symm

theorem ker₁_invariant :
    LinearMap.ker C.d₁ ≤ (LinearMap.ker C.d₁).comap F.f₁ := by
  intro x hx
  rw [LinearMap.mem_ker] at hx
  change C.d₁ (F.f₁ x) = 0
  have h := LinearMap.congr_fun F.comm₁ x
  simpa [hx] using h.symm

theorem range₀_invariant :
    LinearMap.range C.d₀ ≤ (LinearMap.range C.d₀).comap F.f₁ := by
  rintro _ ⟨x, rfl⟩
  exact ⟨F.f₀ x, (LinearMap.congr_fun F.comm₀ x).symm⟩

theorem range₁_invariant :
    LinearMap.range C.d₁ ≤ (LinearMap.range C.d₁).comap F.f₂ := by
  rintro _ ⟨x, rfl⟩
  exact ⟨F.f₁ x, (LinearMap.congr_fun F.comm₁ x).symm⟩

/-- The endomorphism induced on middle cycles. -/
def cycle₁End : LinearMap.ker C.d₁ →ₗ[K] LinearMap.ker C.d₁ :=
  F.f₁.restrict (C.ker₁_invariant F)

theorem middleBoundary_invariant :
    C.middleBoundary ≤ C.middleBoundary.comap (C.cycle₁End F) := by
  rintro ⟨x, hxcycle⟩ hx
  change F.f₁ x ∈ LinearMap.range C.d₀
  change x ∈ LinearMap.range C.d₀ at hx
  obtain ⟨y, rfl⟩ := hx
  exact ⟨F.f₀ y, (LinearMap.congr_fun F.comm₀ y).symm⟩

/-- The induced endomorphisms on the three homology groups. -/
def homology₀End : C.homology₀ →ₗ[K] C.homology₀ :=
  F.f₀.restrict (C.ker₀_invariant F)

def homology₁End : C.homology₁ →ₗ[K] C.homology₁ :=
  C.middleBoundary.mapQ C.middleBoundary (C.cycle₁End F)
    (C.middleBoundary_invariant F)

def homology₂End : C.homology₂ →ₗ[K] C.homology₂ :=
  (LinearMap.range C.d₁).mapQ (LinearMap.range C.d₁) F.f₂
    (C.range₁_invariant F)

/-- The middle boundary subspace, viewed inside the cycle space, is
canonically equivalent to the range of the incoming differential. -/
noncomputable def middleBoundaryEquivRange :
    C.middleBoundary ≃ₗ[K] LinearMap.range C.d₀ where
  toFun x := ⟨x.1.1, x.2⟩
  invFun y := ⟨⟨y.1, by
    obtain ⟨x, hx⟩ := y.2
    rw [LinearMap.mem_ker]
    rw [← hx]
    have h := LinearMap.congr_fun C.d_comp x
    simpa using h⟩, y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The action on middle boundaries is conjugate to the restriction of the
next chain map to the range of the incoming differential. -/
theorem trace_middleBoundary_eq_trace_range
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    LinearMap.trace K C.middleBoundary
        ((C.cycle₁End F).restrict (C.middleBoundary_invariant F)) =
      LinearMap.trace K (LinearMap.range C.d₀)
        (F.f₁.restrict (C.range₀_invariant F)) := by
  let e := C.middleBoundaryEquivRange
  have hconj :
      F.f₁.restrict (C.range₀_invariant F) =
        e.conj ((C.cycle₁End F).restrict (C.middleBoundary_invariant F)) := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    rfl
  rw [hconj, LinearMap.trace_conj']

/-- Fully concrete three-term Hopf trace formula.  All homology groups and
their induced endomorphisms are constructed above from kernels, ranges,
and quotients; no homological trace identity remains as an assumption. -/
theorem hopf_trace
    [FiniteDimensional K C₀] [FiniteDimensional K C₁]
    [FiniteDimensional K C₂] :
    LinearMap.trace K C₀ F.f₀ - LinearMap.trace K C₁ F.f₁ +
        LinearMap.trace K C₂ F.f₂ =
      LinearMap.trace K C.homology₀ (C.homology₀End F) -
        LinearMap.trace K C.homology₁ (homology₁End C F) +
        LinearMap.trace K C.homology₂ (homology₂End C F) := by
  have h₀ := trace_eq_trace_ker_add_trace_range_of_commute
    C.d₀ F.f₀ F.f₁ F.comm₀
  have h₁ := trace_eq_trace_ker_add_trace_range_of_commute
    C.d₁ F.f₁ F.f₂ F.comm₁
  have hz := trace_eq_trace_restrict_add_trace_quotient
    C.middleBoundary (C.cycle₁End F) (C.middleBoundary_invariant F)
  have h₂ := trace_eq_trace_restrict_add_trace_quotient
    (LinearMap.range C.d₁) F.f₂ (C.range₁_invariant F)
  dsimp only [homology₀End, homology₁End, homology₂End,
    homology₀, homology₁, homology₂, cycle₁End] at ⊢
  dsimp only [cycle₁End] at hz
  have hb := C.trace_middleBoundary_eq_trace_range F
  dsimp only [cycle₁End] at hb
  rw [h₀, h₁, hz, h₂, hb]
  ring

end ThreeTermCochainComplex

noncomputable def endomorphismMatrixOfFinrankEq
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {n : ℕ} (f : V →ₗ[K] V)
    (hn : Module.finrank K V = n) : Matrix (Fin n) (Fin n) K :=
  LinearMap.toMatrix (Module.finBasisOfFinrankEq K V hn)
    (Module.finBasisOfFinrankEq K V hn) f

@[simp] theorem endomorphismMatrixOfFinrankEq_trace
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {n : ℕ} (f : V →ₗ[K] V)
    (hn : Module.finrank K V = n) :
    (endomorphismMatrixOfFinrankEq f hn).trace = LinearMap.trace K V f := by
  rw [LinearMap.trace_eq_matrix_trace K (Module.finBasisOfFinrankEq K V hn)]
  rfl

@[simp] theorem endomorphismMatrixOfFinrankEq_charpoly
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {n : ℕ} (f : V →ₗ[K] V)
    (hn : Module.finrank K V = n) :
    (endomorphismMatrixOfFinrankEq f hn).charpoly = f.charpoly := by
  exact LinearMap.charpoly_toMatrix f (Module.finBasisOfFinrankEq K V hn)

theorem trace_eq_zero_of_finrank_eq_zero
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (f : V →ₗ[K] V)
    (hzero : Module.finrank K V = 0) :
    LinearMap.trace K V f = 0 := by
  rw [← endomorphismMatrixOfFinrankEq_trace f hzero]
  simp [Matrix.trace]

/-- Finite spectral data for a complex error term supported in two adjacent
cohomological degrees.  The real numbers `lowerRadius` and `upperRadius` are
the respective bounds for the norms of individual Frobenius eigenvalues. -/
structure TwoDegreeTraceCertificate (error : ℂ) (lowerRank upperRank : ℕ)
    (lowerRadius upperRadius : ℝ) where
  lowerEigenvalue : Fin lowerRank → ℂ
  upperEigenvalue : Fin upperRank → ℂ
  error_eq_trace :
    error = (∑ i, lowerEigenvalue i) + ∑ i, upperEigenvalue i
  norm_lowerEigenvalue_le :
    ∀ i, ‖lowerEigenvalue i‖ ≤ lowerRadius
  norm_upperEigenvalue_le :
    ∀ i, ‖upperEigenvalue i‖ ≤ upperRadius

/-- A finite complex trace is bounded by its rank times a uniform spectral
radius.  This is the elementary inequality used once in each of the two
cohomological degrees in Sawin's Proposition 7.1. -/
theorem norm_fintype_sum_le_card_mul {ι : Type*} [Fintype ι]
    (z : ι → ℂ) (radius : ℝ) (hz : ∀ i, ‖z i‖ ≤ radius) :
    ‖∑ i, z i‖ ≤ Fintype.card ι * radius := by
  calc
    ‖∑ i, z i‖ ≤ ∑ i, ‖z i‖ := by
      simpa only using norm_sum_le (Finset.univ : Finset ι) z
    _ ≤ ∑ _i : ι, radius := Finset.sum_le_sum fun i _hi ↦ hz i
    _ = Fintype.card ι * radius := by simp

/-- If every member of a finite family has norm at most `bound`, then every
member differs from the family average by at most `2 * bound`.  This is the
purely analytic averaging step which changes Proposition 7.1's pointwise
trace estimate into the factor `2` in Sawin's Theorem 7.2. -/
theorem norm_sub_fintype_average_le_two_mul
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (f : ι → ℂ) (bound : ℝ) (hbound : ∀ i, ‖f i‖ ≤ bound) (a : ι) :
    ‖f a - (∑ i, f i) / (Fintype.card ι : ℂ)‖ ≤ 2 * bound := by
  have hcardNat : 0 < Fintype.card ι := Fintype.card_pos
  have hcardReal : (0 : ℝ) < Fintype.card ι := by exact_mod_cast hcardNat
  have hbound0 : 0 ≤ bound := (norm_nonneg (f a)).trans (hbound a)
  have havg : ‖(∑ i, f i) / (Fintype.card ι : ℂ)‖ ≤ bound := by
    rw [norm_div]
    simp only [Complex.norm_natCast]
    rw [div_le_iff₀ hcardReal]
    calc
      ‖∑ i, f i‖ ≤ ∑ i, ‖f i‖ := by
        simpa only using norm_sum_le (Finset.univ : Finset ι) f
      _ ≤ ∑ _i : ι, bound := Finset.sum_le_sum fun i _hi ↦ hbound i
      _ = bound * Fintype.card ι := by simp [mul_comm]
  calc
    ‖f a - (∑ i, f i) / (Fintype.card ι : ℂ)‖ ≤
        ‖f a‖ + ‖(∑ i, f i) / (Fintype.card ι : ℂ)‖ := norm_sub_le _ _
    _ ≤ bound + bound := add_le_add (hbound a) havg
    _ = 2 * bound := by ring

/-! ### Finite centered decompositions

Sawin's prime-power correction (Lemma 9.11) and set-partition sieve
(Lemma 9.12) both express the desired factorization mass as a finite signed
sum of auxiliary masses.  The following identities perform the centering
*after* such a decomposition.  Keeping this operation exact is important:
the invariant contribution cancels separately in every auxiliary family,
and only then is the triangle inequality applied. -/

/-- Centering commutes exactly with a finite sum of finite families. -/
theorem centered_fintype_sum
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : κ → ι → ℂ) (a : ι) :
    (∑ j, f j a) -
          (∑ i, ∑ j, f j i) / (Fintype.card ι : ℂ) =
      ∑ j, (f j a - (∑ i, f j i) / (Fintype.card ι : ℂ)) := by
  rw [Finset.sum_sub_distrib]
  congr 1
  calc
    (∑ i : ι, ∑ j : κ, f j i) / (Fintype.card ι : ℂ) =
        (∑ j : κ, ∑ i : ι, f j i) / (Fintype.card ι : ℂ) := by
      congr 1
      exact (Finset.sum_comm :
        (∑ i : ι, ∑ j : κ, f j i) = ∑ j : κ, ∑ i : ι, f j i)
    _ = ∑ j : κ, (∑ i : ι, f j i) / (Fintype.card ι : ℂ) := by
      rw [Finset.sum_div]

/-- The centered norm of a finite sum is bounded by the sum of the centered
norms of its terms. -/
theorem norm_centered_fintype_sum_le
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : κ → ι → ℂ) (a : ι) :
    ‖(∑ j, f j a) -
          (∑ i, ∑ j, f j i) / (Fintype.card ι : ℂ)‖ ≤
      ∑ j, ‖f j a - (∑ i, f j i) / (Fintype.card ι : ℂ)‖ := by
  rw [centered_fintype_sum]
  simpa only using norm_sum_le (Finset.univ : Finset κ)
    (fun j => f j a - (∑ i, f j i) / (Fintype.card ι : ℂ))

/-- Signed or weighted finite decompositions also commute with centering. -/
theorem centered_weighted_fintype_sum
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (c : κ → ℂ) (f : κ → ι → ℂ) (a : ι) :
    (∑ j, c j * f j a) -
          (∑ i, ∑ j, c j * f j i) / (Fintype.card ι : ℂ) =
      ∑ j, c j *
        (f j a - (∑ i, f j i) / (Fintype.card ι : ℂ)) := by
  calc
    (∑ j, c j * f j a) -
          (∑ i, ∑ j, c j * f j i) / (Fintype.card ι : ℂ) =
        ∑ j, (c j * f j a -
          (∑ i, c j * f j i) / (Fintype.card ι : ℂ)) := by
      rw [Finset.sum_sub_distrib]
      congr 1
      calc
        (∑ i : ι, ∑ j : κ, c j * f j i) /
              (Fintype.card ι : ℂ) =
            (∑ j : κ, ∑ i : ι, c j * f j i) /
              (Fintype.card ι : ℂ) := by
          congr 1
          exact (Finset.sum_comm :
            (∑ i : ι, ∑ j : κ, c j * f j i) =
              ∑ j : κ, ∑ i : ι, c j * f j i)
        _ = ∑ j : κ, (∑ i : ι, c j * f j i) /
              (Fintype.card ι : ℂ) := by
          rw [Finset.sum_div]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro j _hj
      rw [← Finset.mul_sum, mul_sub, mul_div_assoc]

/-- Triangle inequality for a centered signed finite decomposition. -/
theorem norm_centered_weighted_fintype_sum_le
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (c : κ → ℂ) (f : κ → ι → ℂ) (a : ι) :
    ‖(∑ j, c j * f j a) -
          (∑ i, ∑ j, c j * f j i) / (Fintype.card ι : ℂ)‖ ≤
      ∑ j, ‖c j‖ *
        ‖f j a - (∑ i, f j i) / (Fintype.card ι : ℂ)‖ := by
  rw [centered_weighted_fintype_sum]
  calc
    ‖∑ j, c j *
        (f j a - (∑ i, f j i) / (Fintype.card ι : ℂ))‖ ≤
        ∑ j, ‖c j *
          (f j a - (∑ i, f j i) / (Fintype.card ι : ℂ))‖ := by
      simpa only using norm_sum_le (Finset.univ : Finset κ)
        (fun j => c j *
          (f j a - (∑ i, f j i) / (Fintype.card ι : ℂ)))
    _ = _ := by simp only [norm_mul]

/-! ### The eight prime-power correction terms

On the unit group of the progression quotient, convolution of three
factorization functions can be written with two explicit summation
variables; the third factor is then forced.  Lemma 9.11 replaces each
von-Mangoldt factor by its prime part plus its proper-prime-power part.
The following checked eight-term expansion is exactly the resulting subset
expansion for three factors. -/

/-- Three-fold convolution on a finite group, with the third coordinate
solved from the equation `x * y * z = u`. -/
noncomputable def finiteTripleConvolution
    {G : Type*} [Fintype G] [Group G]
    (f₁ f₂ f₃ : G → ℂ) (u : G) : ℂ :=
  ∑ x : G, ∑ y : G, f₁ x * f₂ y * f₃ ((x * y)⁻¹ * u)

/-- Expanding prime plus proper-prime-power in each of three convolution
slots gives the eight correction terms used in Sawin's Lemma 9.11. -/
theorem finiteTripleConvolution_add
    {G : Type*} [Fintype G] [Group G]
    (f₁ e₁ f₂ e₂ f₃ e₃ : G → ℂ) (u : G) :
    finiteTripleConvolution (f₁ + e₁) (f₂ + e₂) (f₃ + e₃) u =
      finiteTripleConvolution f₁ f₂ f₃ u +
      finiteTripleConvolution e₁ f₂ f₃ u +
      finiteTripleConvolution f₁ e₂ f₃ u +
      finiteTripleConvolution f₁ f₂ e₃ u +
      finiteTripleConvolution e₁ e₂ f₃ u +
      finiteTripleConvolution e₁ f₂ e₃ u +
      finiteTripleConvolution f₁ e₂ e₃ u +
      finiteTripleConvolution e₁ e₂ e₃ u := by
  unfold finiteTripleConvolution
  simp only [Pi.add_apply, add_mul, mul_add, Finset.sum_add_distrib]
  ring

/-- The eight terms in the three-factor prime-power expansion, indexed by
the subsets of the three slots in a fixed binary order. -/
noncomputable def tripleConvolutionExpansionTerm
    {G : Type*} [Fintype G] [Group G]
    (f₁ e₁ f₂ e₂ f₃ e₃ : G → ℂ) : Fin 8 → G → ℂ
  | ⟨0, _⟩ => finiteTripleConvolution f₁ f₂ f₃
  | ⟨1, _⟩ => finiteTripleConvolution e₁ f₂ f₃
  | ⟨2, _⟩ => finiteTripleConvolution f₁ e₂ f₃
  | ⟨3, _⟩ => finiteTripleConvolution f₁ f₂ e₃
  | ⟨4, _⟩ => finiteTripleConvolution e₁ e₂ f₃
  | ⟨5, _⟩ => finiteTripleConvolution e₁ f₂ e₃
  | ⟨6, _⟩ => finiteTripleConvolution f₁ e₂ e₃
  | ⟨7, _⟩ => finiteTripleConvolution e₁ e₂ e₃

/-- Finite-sum form of the exact eight-term correction identity. -/
theorem finiteTripleConvolution_add_eq_sum
    {G : Type*} [Fintype G] [Group G]
    (f₁ e₁ f₂ e₂ f₃ e₃ : G → ℂ) (u : G) :
    finiteTripleConvolution (f₁ + e₁) (f₂ + e₂) (f₃ + e₃) u =
      ∑ j : Fin 8,
        tripleConvolutionExpansionTerm f₁ e₁ f₂ e₂ f₃ e₃ j u := by
  rw [finiteTripleConvolution_add]
  simp [tripleConvolutionExpansionTerm, Fin.sum_univ_succ]
  ring

/-- After the eight-term prime-power expansion, its centered deviation is
bounded by the sum of the eight separately centered deviations.  This is
the analytic triangle step of Lemma 9.11, independent of the later
geometric estimates for the individual terms. -/
theorem norm_centered_primePowerExpansion_le
    {G : Type*} [Fintype G] [Group G]
    (f₁ e₁ f₂ e₂ f₃ e₃ : G → ℂ) (u : G) :
    ‖finiteTripleConvolution (f₁ + e₁) (f₂ + e₂) (f₃ + e₃) u -
        (∑ v : G,
          finiteTripleConvolution (f₁ + e₁) (f₂ + e₂) (f₃ + e₃) v) /
          (Fintype.card G : ℂ)‖ ≤
      ∑ j : Fin 8,
        ‖tripleConvolutionExpansionTerm f₁ e₁ f₂ e₂ f₃ e₃ j u -
          (∑ v : G,
            tripleConvolutionExpansionTerm f₁ e₁ f₂ e₂ f₃ e₃ j v) /
              (Fintype.card G : ℂ)‖ := by
  simp_rw [finiteTripleConvolution_add_eq_sum]
  exact norm_centered_fintype_sum_le
    (tripleConvolutionExpansionTerm f₁ e₁ f₂ e₂ f₃ e₃) u

/-- The exact two-degree trace estimate: dimensions times the two spectral
radii bound the norm of the total error. -/
theorem TwoDegreeTraceCertificate.norm_error_le
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (certificate : TwoDegreeTraceCertificate error lowerRank upperRank
      lowerRadius upperRadius) :
    ‖error‖ ≤ lowerRank * lowerRadius + upperRank * upperRadius := by
  rw [certificate.error_eq_trace]
  calc
    ‖(∑ i, certificate.lowerEigenvalue i) +
        ∑ i, certificate.upperEigenvalue i‖ ≤
        ‖∑ i, certificate.lowerEigenvalue i‖ +
          ‖∑ i, certificate.upperEigenvalue i‖ := norm_add_le _ _
    _ ≤ lowerRank * lowerRadius + upperRank * upperRadius :=
      add_le_add
        (by
          simpa only [Fintype.card_fin] using
            norm_fintype_sum_le_card_mul certificate.lowerEigenvalue lowerRadius
              certificate.norm_lowerEigenvalue_le)
        (by
          simpa only [Fintype.card_fin] using
            norm_fintype_sum_le_card_mul certificate.upperEigenvalue upperRadius
              certificate.norm_upperEigenvalue_le)

/-- A natural-number version of the preceding estimate, convenient after
rounding the two half-integral powers of the finite-field cardinality upward.
No geometric information is lost here: the only inputs are the two rank
bounds and the individual eigenvalue bounds. -/
theorem TwoDegreeTraceCertificate.norm_error_le_nat
    {error : ℂ} {lowerRank upperRank lowerRadius upperRadius : ℕ}
    (certificate : TwoDegreeTraceCertificate error lowerRank upperRank
      lowerRadius upperRadius) :
    ‖error‖ ≤
        ((lowerRank * lowerRadius + upperRank * upperRadius : ℕ) : ℝ) := by
  simpa only [Nat.cast_add, Nat.cast_mul] using certificate.norm_error_le

/-- Deligne's weight estimate enters Sawin's argument as a root-radius
bound for a complex Frobenius matrix.  Over `ℂ`, the trace is the sum of the
roots of the characteristic polynomial, with multiplicity; hence a uniform
root-radius bound gives the expected rank-times-radius trace bound. -/
theorem norm_matrix_trace_le_finrank {r : ℕ}
    (A : Matrix (Fin r) (Fin r) ℂ) (radius : ℝ)
    (hroot : ∀ z, z ∈ (Matrix.charpoly A).roots → ‖z‖ ≤ radius) :
    ‖A.trace‖ ≤ r * radius := by
  rw [Matrix.trace_eq_sum_roots_charpoly]
  calc
    ‖A.charpoly.roots.sum‖ ≤
        (A.charpoly.roots.map fun z => ‖z‖).sum :=
      norm_multiset_sum_le _
    _ ≤ (A.charpoly.roots.map fun z => ‖z‖).card • radius := by
      apply Multiset.sum_le_card_nsmul
      intro x hx
      obtain ⟨z, hz, rfl⟩ := Multiset.mem_map.mp hx
      exact hroot z hz
    _ = r * radius := by
      have hsplits := IsAlgClosed.splits A.charpoly
      have hcard : A.charpoly.roots.card = r := by
        rw [← hsplits.natDegree_eq_card_roots,
          Matrix.charpoly_natDegree_eq_dim]
        simp
      simp only [Multiset.card_map, hcard, nsmul_eq_mul]

/-- Negating a complex matrix negates every characteristic root and hence
preserves any bound depending only on the complex norm.  This is the sign
change needed for the odd cohomological degree in the Hopf trace formula. -/
theorem matrix_neg_root_norm_le {r : ℕ}
    (A : Matrix (Fin r) (Fin r) ℂ) (radius : ℝ)
    (hroot : ∀ z, z ∈ A.charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (-A).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  have hzroot : (-A).charpoly.IsRoot z :=
    (Polynomial.mem_roots (Matrix.charpoly_monic (-A)).ne_zero).mp hz
  have hzspectrum : z ∈ spectrum ℂ (-A) :=
    Matrix.mem_spectrum_iff_isRoot_charpoly.mpr hzroot
  have hnegSpectrum : -z ∈ spectrum ℂ A := by
    rw [← spectrum.neg_eq A] at hzspectrum
    simpa only [Set.mem_neg, neg_neg] using hzspectrum
  have hnegRoot : A.charpoly.IsRoot (-z) :=
    Matrix.mem_spectrum_iff_isRoot_charpoly.mp hnegSpectrum
  have hnegMem : -z ∈ A.charpoly.roots :=
    (Polynomial.mem_roots (Matrix.charpoly_monic A).ne_zero).mpr hnegRoot
  simpa only [norm_neg] using hroot (-z) hnegMem

/-- A finite-order symmetry commuting with Frobenius does not enlarge the
Frobenius spectral radius.  Indeed, if `P ^ N = 1`, then
`(P * F) ^ N = F ^ N`; the spectral mapping theorem identifies every
`N`-th power of a twisted eigenvalue with the `N`-th power of an ordinary
Frobenius eigenvalue.  This is the exact algebraic step which transports one
Deligne bound to all permutation-twisted traces. -/
theorem matrix_mul_root_norm_le_of_commute_pow_eq_one {r N : ℕ}
    (P F : Matrix (Fin r) (Fin r) ℂ)
    (hN : 0 < N) (hcomm : Commute P F) (hP : P ^ N = 1)
    (radius : ℝ) (hradius : 0 ≤ radius)
    (hroot : ∀ z, z ∈ F.charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (P * F).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  have hzroot : (P * F).charpoly.IsRoot z :=
    (Polynomial.mem_roots (Matrix.charpoly_monic (P * F)).ne_zero).mp hz
  have hzspec : z ∈ spectrum ℂ (P * F) :=
    Matrix.mem_spectrum_iff_isRoot_charpoly.mpr hzroot
  have hzpow : z ^ N ∈ spectrum ℂ ((P * F) ^ N) :=
    spectrum.pow_mem_pow (P * F) N hzspec
  have hpow : (P * F) ^ N = F ^ N := by
    rw [hcomm.mul_pow, hP, one_mul]
  rw [hpow, spectrum.map_pow_of_pos F hN] at hzpow
  obtain ⟨w, hwspec, hzw⟩ := hzpow
  have hwroot : F.charpoly.IsRoot w :=
    Matrix.mem_spectrum_iff_isRoot_charpoly.mp hwspec
  have hw : w ∈ F.charpoly.roots :=
    (Polynomial.mem_roots (Matrix.charpoly_monic F).ne_zero).mpr hwroot
  have hnormpow : ‖z‖ ^ N = ‖w‖ ^ N := by
    rw [← norm_pow, ← hzw, norm_pow]
  have hpowle : ‖z‖ ^ N ≤ radius ^ N := by
    rw [hnormpow]
    exact pow_le_pow_left₀ (norm_nonneg w) (hroot w hw) N
  exact (pow_le_pow_iff_left₀ (norm_nonneg z) hradius hN.ne').mp hpowle

/-- Every characteristic root of an invariant-subspace restriction is a
characteristic root of the ambient endomorphism.  This is the elementary
spectral input needed to pass Deligne bounds to invariant and isotypic
summands. -/
theorem restrict_isRoot_charpoly_imp
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (F : Module.End K V) (W : Submodule K V) (hW : ∀ x ∈ W, F x ∈ W)
    (z : K) (hz : (F.restrict hW).charpoly.IsRoot z) :
    F.charpoly.IsRoot z := by
  rw [← Module.End.hasEigenvalue_iff_isRoot_charpoly] at hz ⊢
  rw [Module.End.hasEigenvalue_iff] at hz ⊢
  obtain ⟨x, hx, hx0⟩ := (Submodule.ne_bot_iff _).mp hz
  have hxval0 : x.1 ≠ 0 := fun h => hx0 (Subtype.ext h)
  apply (Submodule.ne_bot_iff _).mpr
  refine ⟨x.1, ?_, hxval0⟩
  exact Module.End.eigenspace_restrict_le_eigenspace F hW z
    ⟨x, hx, rfl⟩

/-- A root-radius bound on an ambient complex endomorphism descends to
every invariant subspace. -/
theorem restrict_root_norm_le
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (F : Module.End ℂ V) (W : Submodule ℂ V) (hW : ∀ x ∈ W, F x ∈ W)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq F rfl).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq
        (F.restrict hW) rfl).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  rw [endomorphismMatrixOfFinrankEq_charpoly] at hz
  have hzroot : (F.restrict hW).charpoly.IsRoot z :=
    (Polynomial.mem_roots (LinearMap.charpoly_monic _).ne_zero).mp hz
  have hzroot' : F.charpoly.IsRoot z :=
    restrict_isRoot_charpoly_imp F W hW z hzroot
  apply hroot z
  rw [endomorphismMatrixOfFinrankEq_charpoly]
  exact (Polynomial.mem_roots (LinearMap.charpoly_monic _).ne_zero).mpr hzroot'

/-- For an invariant subspace, the ambient characteristic polynomial is the
product of the restriction and quotient characteristic polynomials.  This
form, unlike mere inclusion of ground-field eigenvalues, remains useful
after embedding the coefficient field into `ℂ`. -/
theorem LinearMap.charpoly_eq_restrict_mul_quotient
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (F : Module.End K V) (W : Submodule K V) (hW : W ≤ W.comap F) :
    F.charpoly =
      (F.restrict hW).charpoly * (W.mapQ W F hW).charpoly := by
  let m := Fin (Module.finrank K W)
  let bW : Module.Basis m K W := Module.finBasis K W
  let n := Fin (Module.finrank K (V ⧸ W))
  let bQ : Module.Basis n K (V ⧸ W) := Module.finBasis K (V ⧸ W)
  let b := Module.Basis.sumQuot bW bQ
  let A : Matrix m m K := LinearMap.toMatrix bW bW (F.restrict hW)
  let B : Matrix m n K := Matrix.of fun i l ↦
    ((Module.Basis.sumQuot bW bQ).repr
      (F ((Module.Basis.sumQuot bW bQ) (Sum.inr l)))) (Sum.inl i)
  let D : Matrix n n K := LinearMap.toMatrix bQ bQ (W.mapQ W F hW)
  have hmatrix : LinearMap.toMatrix b b F = Matrix.fromBlocks A B 0 D := by
    ext u v
    cases u with
    | inl i =>
      cases v with
      | inl k =>
        simp only [b, Module.Basis.sumQuot_inl,
          Matrix.fromBlocks_apply₁₁, A, LinearMap.toMatrix_apply]
        apply Module.Basis.sumQuot_repr_inl_of_mem
      | inr l =>
        simp [b, LinearMap.toMatrix_apply, Matrix.fromBlocks_apply₁₂, B]
    | inr j =>
      cases v with
      | inl k =>
        suffices W.mkQ (F (bW k)) = 0 by
          simp [LinearMap.toMatrix_apply, b, this]
        rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
        exact hW (Submodule.coe_mem (bW k))
      | inr l =>
        simp only [LinearMap.toMatrix_apply,
          Module.Basis.sumQuot_repr_inr, Matrix.fromBlocks_apply₂₂, b, D]
        rw [← Module.Basis.sumQuot_inr bW bQ l, W.mapQ_apply]
        simp
  rw [← LinearMap.charpoly_toMatrix F b, hmatrix,
    Matrix.charpoly_fromBlocks_zero₂₁,
    LinearMap.charpoly_toMatrix, LinearMap.charpoly_toMatrix]

theorem restrict_charpoly_dvd
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (F : Module.End K V) (W : Submodule K V) (hW : W ≤ W.comap F) :
    (F.restrict hW).charpoly ∣ F.charpoly := by
  rw [LinearMap.charpoly_eq_restrict_mul_quotient F W hW]
  exact dvd_mul_right _ _

/-- Root-radius bounds descend to invariant subspaces after applying an
arbitrary coefficient-field embedding into the complex numbers. -/
theorem restrict_realization_root_norm_le
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (F : Module.End K V) (W : Submodule K V) (hW : W ≤ W.comap F)
    (σ : K →+* ℂ) (radius : ℝ)
    (hroot : ∀ z,
      z ∈ ((endomorphismMatrixOfFinrankEq F rfl).map σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z,
      z ∈ ((endomorphismMatrixOfFinrankEq
        (F.restrict hW) rfl).map σ).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  rw [Matrix.charpoly_map, endomorphismMatrixOfFinrankEq_charpoly] at hz
  apply hroot z
  rw [Matrix.charpoly_map, endomorphismMatrixOfFinrankEq_charpoly]
  exact Multiset.mem_of_le
    (Polynomial.roots.le_of_dvd
      ((LinearMap.charpoly_monic F).map σ).ne_zero
      (Polynomial.map_dvd σ (restrict_charpoly_dvd F W hW))) hz

/-- Matrix-level version of the two-degree cohomological data.  In the
eventual geometric construction these matrices are the Frobenius actions on
the two nonzero compactly supported cohomology groups. -/
structure TwoDegreeFrobeniusMatrices (error : ℂ)
    (lowerRank upperRank : ℕ) (lowerRadius upperRadius : ℝ) where
  lowerFrobenius : Matrix (Fin lowerRank) (Fin lowerRank) ℂ
  upperFrobenius : Matrix (Fin upperRank) (Fin upperRank) ℂ
  error_eq_trace :
    error = lowerFrobenius.trace + upperFrobenius.trace
  lower_root_norm_le :
    ∀ z, z ∈ lowerFrobenius.charpoly.roots → ‖z‖ ≤ lowerRadius
  upper_root_norm_le :
    ∀ z, z ∈ upperFrobenius.charpoly.roots → ‖z‖ ≤ upperRadius

/-- A concrete three-term cochain complex produces the two matrices needed
for the numerical Frobenius estimate.  This is the finite-dimensional
Grothendieck--Lefschetz step: Hopf trace moves the alternating cochain trace
to cohomology, the top vanishing removes the third term, and the sign in odd
degree is absorbed into the second matrix. -/
noncomputable def TwoDegreeFrobeniusMatrices.ofThreeTermCochainComplex
    {C₀ C₁ C₂ : Type*}
    [AddCommGroup C₀] [Module ℂ C₀] [FiniteDimensional ℂ C₀]
    [AddCommGroup C₁] [Module ℂ C₁] [FiniteDimensional ℂ C₁]
    [AddCommGroup C₂] [Module ℂ C₂] [FiniteDimensional ℂ C₂]
    (C : ThreeTermCochainComplex ℂ C₀ C₁ C₂)
    (F : ThreeTermCochainEndomorphism C)
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (herror : error =
      LinearMap.trace ℂ C₀ F.f₀ - LinearMap.trace ℂ C₁ F.f₁ +
        LinearMap.trace ℂ C₂ F.f₂)
    (hlower : Module.finrank ℂ C.homology₀ = lowerRank)
    (hupper : Module.finrank ℂ C.homology₁ = upperRank)
    (hvanish : Module.finrank ℂ C.homology₂ = 0)
    (hlowerRoot : ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq (C.homology₀End F) hlower).charpoly.roots →
        ‖z‖ ≤ lowerRadius)
    (hupperRoot : ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq (C.homology₁End F) hupper).charpoly.roots →
        ‖z‖ ≤ upperRadius) :
    TwoDegreeFrobeniusMatrices error lowerRank upperRank lowerRadius upperRadius where
  lowerFrobenius := endomorphismMatrixOfFinrankEq (C.homology₀End F) hlower
  upperFrobenius := -endomorphismMatrixOfFinrankEq (C.homology₁End F) hupper
  error_eq_trace := by
    rw [herror, C.hopf_trace F,
      trace_eq_zero_of_finrank_eq_zero (C.homology₂End F) hvanish]
    simp only [endomorphismMatrixOfFinrankEq_trace, Matrix.trace_neg]
    ring
  lower_root_norm_le := hlowerRoot
  upper_root_norm_le := matrix_neg_root_norm_le _ upperRadius hupperRoot

/-- Grothendieck--Lefschetz plus a Deligne root-radius estimate implies the
same two-degree numerical trace bound used by the list-level certificate. -/
theorem TwoDegreeFrobeniusMatrices.norm_error_le
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank
      lowerRadius upperRadius) :
    ‖error‖ ≤ lowerRank * lowerRadius + upperRank * upperRadius := by
  rw [data.error_eq_trace]
  calc
    ‖data.lowerFrobenius.trace + data.upperFrobenius.trace‖ ≤
        ‖data.lowerFrobenius.trace‖ + ‖data.upperFrobenius.trace‖ :=
      norm_add_le _ _
    _ ≤ lowerRank * lowerRadius + upperRank * upperRadius :=
      add_le_add
        (norm_matrix_trace_le_finrank data.lowerFrobenius lowerRadius
          data.lower_root_norm_le)
        (norm_matrix_trace_le_finrank data.upperFrobenius upperRadius
          data.upper_root_norm_le)

/-- Direct three-term cochain form of the Frobenius estimate.  All
linear-algebraic transitions from cochains to cohomology and from
endomorphisms to matrices are discharged here; a geometric application need
only supply the alternating trace identity, the three cohomology dimensions,
and Deligne's two root bounds. -/
theorem ThreeTermCochainComplex.norm_alternating_trace_le
    {C₀ C₁ C₂ : Type*}
    [AddCommGroup C₀] [Module ℂ C₀] [FiniteDimensional ℂ C₀]
    [AddCommGroup C₁] [Module ℂ C₁] [FiniteDimensional ℂ C₁]
    [AddCommGroup C₂] [Module ℂ C₂] [FiniteDimensional ℂ C₂]
    (C : ThreeTermCochainComplex ℂ C₀ C₁ C₂)
    (F : ThreeTermCochainEndomorphism C)
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (herror : error =
      LinearMap.trace ℂ C₀ F.f₀ - LinearMap.trace ℂ C₁ F.f₁ +
        LinearMap.trace ℂ C₂ F.f₂)
    (hlower : Module.finrank ℂ C.homology₀ = lowerRank)
    (hupper : Module.finrank ℂ C.homology₁ = upperRank)
    (hvanish : Module.finrank ℂ C.homology₂ = 0)
    (hlowerRoot : ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq (C.homology₀End F) hlower).charpoly.roots →
        ‖z‖ ≤ lowerRadius)
    (hupperRoot : ∀ z,
      z ∈ (endomorphismMatrixOfFinrankEq (C.homology₁End F) hupper).charpoly.roots →
        ‖z‖ ≤ upperRadius) :
    ‖error‖ ≤ lowerRank * lowerRadius + upperRank * upperRadius := by
  exact (TwoDegreeFrobeniusMatrices.ofThreeTermCochainComplex C F herror
    hlower hupper hvanish hlowerRoot hupperRoot).norm_error_le

/-- A fully bundled cochain-level Frobenius model for one complex trace.
The cochain spaces, differentials, and chain map are explicit; the only
geometric fields are the fixed-point trace identity, top-cohomology
vanishing, and the two characteristic-root bounds. -/
structure ThreeTermFrobeniusModel (error : ℂ) (radius : ℝ) where
  C₀ : Type
  C₁ : Type
  C₂ : Type
  [addCommGroup₀ : AddCommGroup C₀]
  [module₀ : Module ℂ C₀]
  [finiteDimensional₀ : FiniteDimensional ℂ C₀]
  [addCommGroup₁ : AddCommGroup C₁]
  [module₁ : Module ℂ C₁]
  [finiteDimensional₁ : FiniteDimensional ℂ C₁]
  [addCommGroup₂ : AddCommGroup C₂]
  [module₂ : Module ℂ C₂]
  [finiteDimensional₂ : FiniteDimensional ℂ C₂]
  complex : ThreeTermCochainComplex ℂ C₀ C₁ C₂
  frobenius : ThreeTermCochainEndomorphism complex
  error_eq_alternating_trace : error =
    LinearMap.trace ℂ C₀ frobenius.f₀ -
      LinearMap.trace ℂ C₁ frobenius.f₁ +
        LinearMap.trace ℂ C₂ frobenius.f₂
  top_finrank_eq_zero : Module.finrank ℂ complex.homology₂ = 0
  lower_root_norm_le : ∀ z,
    z ∈ (endomorphismMatrixOfFinrankEq
      (complex.homology₀End frobenius) rfl).charpoly.roots → ‖z‖ ≤ radius
  upper_root_norm_le : ∀ z,
    z ∈ (endomorphismMatrixOfFinrankEq
      (complex.homology₁End frobenius) rfl).charpoly.roots → ‖z‖ ≤ radius

namespace ThreeTermFrobeniusModel

/-- Rank of the degree-zero cohomology of a bundled Frobenius model. -/
noncomputable def lowerRank {error : ℂ} {radius : ℝ}
    (data : ThreeTermFrobeniusModel error radius) : ℕ := by
  letI : AddCommGroup data.C₀ := data.addCommGroup₀
  letI : Module ℂ data.C₀ := data.module₀
  letI : FiniteDimensional ℂ data.C₀ := data.finiteDimensional₀
  letI : AddCommGroup data.C₁ := data.addCommGroup₁
  letI : Module ℂ data.C₁ := data.module₁
  letI : FiniteDimensional ℂ data.C₁ := data.finiteDimensional₁
  letI : AddCommGroup data.C₂ := data.addCommGroup₂
  letI : Module ℂ data.C₂ := data.module₂
  letI : FiniteDimensional ℂ data.C₂ := data.finiteDimensional₂
  exact Module.finrank ℂ data.complex.homology₀

/-- Rank of the degree-one cohomology of a bundled Frobenius model. -/
noncomputable def upperRank {error : ℂ} {radius : ℝ}
    (data : ThreeTermFrobeniusModel error radius) : ℕ := by
  letI : AddCommGroup data.C₀ := data.addCommGroup₀
  letI : Module ℂ data.C₀ := data.module₀
  letI : FiniteDimensional ℂ data.C₀ := data.finiteDimensional₀
  letI : AddCommGroup data.C₁ := data.addCommGroup₁
  letI : Module ℂ data.C₁ := data.module₁
  letI : FiniteDimensional ℂ data.C₁ := data.finiteDimensional₁
  letI : AddCommGroup data.C₂ := data.addCommGroup₂
  letI : Module ℂ data.C₂ := data.module₂
  letI : FiniteDimensional ℂ data.C₂ := data.finiteDimensional₂
  exact Module.finrank ℂ data.complex.homology₁

/-- Total rank of the two cohomological degrees which remain after the top
vanishing in a bundled Frobenius model. -/
noncomputable def cohomologyRank {error : ℂ} {radius : ℝ}
    (data : ThreeTermFrobeniusModel error radius) : ℕ :=
  data.lowerRank + data.upperRank

/-- The bundled cochain model produces the exact two-degree matrix package
used by the finite trace estimate. -/
noncomputable def toTwoDegreeFrobeniusMatrices
    {error : ℂ} {radius : ℝ}
    (data : ThreeTermFrobeniusModel error radius) :
    TwoDegreeFrobeniusMatrices error data.lowerRank data.upperRank radius radius := by
  letI : AddCommGroup data.C₀ := data.addCommGroup₀
  letI : Module ℂ data.C₀ := data.module₀
  letI : FiniteDimensional ℂ data.C₀ := data.finiteDimensional₀
  letI : AddCommGroup data.C₁ := data.addCommGroup₁
  letI : Module ℂ data.C₁ := data.module₁
  letI : FiniteDimensional ℂ data.C₁ := data.finiteDimensional₁
  letI : AddCommGroup data.C₂ := data.addCommGroup₂
  letI : Module ℂ data.C₂ := data.module₂
  letI : FiniteDimensional ℂ data.C₂ := data.finiteDimensional₂
  exact TwoDegreeFrobeniusMatrices.ofThreeTermCochainComplex
    data.complex data.frobenius data.error_eq_alternating_trace
    rfl rfl data.top_finrank_eq_zero data.lower_root_norm_le
    data.upper_root_norm_le

end ThreeTermFrobeniusModel

/-- Frobenius data for every member of a finite family, with the invariant
(constant-sheaf) contribution removed by centering.  The trace values need
not equal the masses pointwise; the statement records precisely the weaker
and geometrically natural assertion that their deviations from their
respective averages agree. -/
structure TwoDegreeFrobeniusAverageData
    {ι : Type*} [Fintype ι] (mass : ι → ℂ)
    (lowerRank upperRank : ℕ) (lowerRadius upperRadius : ℝ) where
  traceValue : ι → ℂ
  centered_eq : ∀ a,
    mass a - (∑ i, mass i) / (Fintype.card ι : ℂ) =
      traceValue a - (∑ i, traceValue i) / (Fintype.card ι : ℂ)
  frobeniusMatrices : ∀ a,
    Nonempty (TwoDegreeFrobeniusMatrices (traceValue a)
      lowerRank upperRank lowerRadius upperRadius)

/-- A finite family of Lefschetz traces split into one common invariant
contribution and a two-degree reduced contribution.  The common summand is
allowed to be arbitrarily large; it disappears exactly under centering. -/
structure CommonMainTwoDegreeFrobeniusData
    {ι : Type*} [Fintype ι] (mass : ι → ℂ)
    (lowerRank upperRank : ℕ) (lowerRadius upperRadius : ℝ) where
  mainTerm : ℂ
  reducedMatrices : ∀ a,
    Nonempty (TwoDegreeFrobeniusMatrices (mass a - mainTerm)
      lowerRank upperRank lowerRadius upperRadius)

/-- Removing a common invariant trace changes neither centered values nor
the family average estimate. -/
noncomputable def CommonMainTwoDegreeFrobeniusData.toAverageData
    {ι : Type*} [Fintype ι] [Nonempty ι] (mass : ι → ℂ)
    {lowerRank upperRank : ℕ} {lowerRadius upperRadius : ℝ}
    (data : CommonMainTwoDegreeFrobeniusData mass
      lowerRank upperRank lowerRadius upperRadius) :
    TwoDegreeFrobeniusAverageData mass lowerRank upperRank
      lowerRadius upperRadius where
  traceValue a := mass a - data.mainTerm
  centered_eq a := by
    have hcard : (Fintype.card ι : ℂ) ≠ 0 := by
      exact_mod_cast Fintype.card_ne_zero
    simp only [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul,
      Finset.card_univ]
    field_simp
    ring
  frobeniusMatrices := data.reducedMatrices

/-- Proposition 7.1's pointwise Frobenius estimate, followed by the
centering argument of Theorem 7.2, bounds every mass by twice the common
rank--radius envelope. -/
theorem TwoDegreeFrobeniusAverageData.norm_mass_sub_average_le
    {ι : Type*} [Fintype ι] [Nonempty ι] (mass : ι → ℂ)
    {lowerRank upperRank : ℕ} {lowerRadius upperRadius : ℝ}
    (data : TwoDegreeFrobeniusAverageData mass lowerRank upperRank
      lowerRadius upperRadius) (a : ι) :
    ‖mass a - (∑ i, mass i) / (Fintype.card ι : ℂ)‖ ≤
      2 * (lowerRank * lowerRadius + upperRank * upperRadius) := by
  rw [data.centered_eq]
  apply norm_sub_fintype_average_le_two_mul
  intro i
  obtain ⟨matrices⟩ := data.frobeniusMatrices i
  exact matrices.norm_error_le

/-- Exact finite-dimensional form of Sawin's Proposition 7.1 followed by
Theorem 7.2 in the three-equal-degree specialization.  The hypotheses give
the two Frobenius matrices for every progression class, with the precise
Lemma 9.9 dimensions and the two adjacent Deligne radii.  Averaging then
produces exactly `equalDegreeError`, including its factor `2`. -/
theorem norm_sub_average_le_equalDegreeError
    {d m : ℕ} {ι : Type*} [Fintype ι] [Nonempty ι]
    (f : ι → ℂ)
    (hdata : ∀ i,
      Nonempty (TwoDegreeFrobeniusMatrices (f i)
        (equalDegreeLowerRank d m) (equalDegreeUpperRank d m)
        (equalDegreeLowerRadius q d m) (equalDegreeUpperRadius q d m)))
    (a : ι) :
    ‖f a - (∑ i, f i) / (Fintype.card ι : ℂ)‖ ≤
      (equalDegreeError q d m : ℝ) := by
  have hpoint : ∀ i,
      ‖f i‖ ≤
        (equalDegreeLowerRank d m : ℝ) * equalDegreeLowerRadius q d m +
          (equalDegreeUpperRank d m : ℝ) * equalDegreeUpperRadius q d m := by
    intro i
    obtain ⟨data⟩ := hdata i
    exact data.norm_error_le
  have h := norm_sub_fintype_average_le_two_mul f
    ((equalDegreeLowerRank d m : ℝ) * equalDegreeLowerRadius q d m +
      (equalDegreeUpperRank d m : ℝ) * equalDegreeUpperRadius q d m)
    hpoint a
  rw [equalDegreeError_eq_two_mul_rankRadius]
  simpa only [Nat.cast_mul, Nat.cast_add, Nat.cast_ofNat] using h

/-- The nontrivial-character contribution in the exact Fourier expansion
of one unordered equal-degree prime-triple progression count. -/
noncomputable def primeTripleFourierError (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) : ℂ :=
  ∑ χ ∈ @Finset.erase (ProgressionCharacter q k) (Classical.decEq _)
      Finset.univ 1,
    χ (↑((progressionUnit q k a ha)⁻¹) : ProgressionQuotient q k) *
      ∑ T : RepresentationFamilies.PrimeTriple q d,
        χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k)

/-- The inner character sum in Sawin's source normalization: ordered
distinct triples are counted separately and every factor contributes its
von-Mangoldt weight `2d`. -/
noncomputable def orderedWeightedPrimeTripleCharacterSum (k d : ℕ)
    (χ : ProgressionCharacter q k) : ℂ :=
  ∑ T : RepresentationFamilies.PrimeTriple q d,
    ∑ _σ : Fin 3 ≃ ↥T.1,
      (RepresentationFamilies.primeTripleOrderingWeight d : ℂ) *
        χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k)

/-- Summing over the six orderings multiplies the unordered character sum
by the exact common source weight `6 * (2d)^3`. -/
theorem orderedWeightedPrimeTripleCharacterSum_eq (k d : ℕ)
    (χ : ProgressionCharacter q k) :
    orderedWeightedPrimeTripleCharacterSum q k d χ =
      (6 * (2 * d) ^ 3 : ℕ) *
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k) := by
  classical
  unfold orderedWeightedPrimeTripleCharacterSum
  calc
    (∑ T : RepresentationFamilies.PrimeTriple q d,
        ∑ _σ : Fin 3 ≃ ↥T.1,
          (RepresentationFamilies.primeTripleOrderingWeight d : ℂ) *
            χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k)) =
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          (6 * (2 * d) ^ 3 : ℕ) *
            χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k) := by
      apply Finset.sum_congr rfl
      intro T _hT
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        RepresentationFamilies.primeTriple_ordering_card,
        RepresentationFamilies.primeTripleOrderingWeight, Nat.cast_mul,
        Nat.cast_ofNat, Nat.cast_pow]
      ring
    _ = (6 * (2 * d) ^ 3 : ℕ) *
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k) := by
      rw [Finset.mul_sum]

/-- The nontrivial ordered weighted character contribution appearing
literally in the `H^1_{d,d,d}` specialization of Sawin's Lemma 9.14. -/
noncomputable def orderedWeightedPrimeTripleFourierError (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) : ℂ :=
  ∑ χ ∈ @Finset.erase (ProgressionCharacter q k) (Classical.decEq _)
      Finset.univ 1,
    χ (↑((progressionUnit q k a ha)⁻¹) : ProgressionQuotient q k) *
      orderedWeightedPrimeTripleCharacterSum q k d χ

/-- The unweighted nontrivial Fourier contribution depends only on the
residue class, so canonical remainder normalization leaves it unchanged. -/
theorem primeTripleFourierError_normalizedResidue (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    primeTripleFourierError q k d (normalizedResidue q k a)
        (normalizedResidue_not_dvd q k a ha) =
      primeTripleFourierError q k d a ha := by
  unfold primeTripleFourierError
  rw [progressionUnit_normalizedResidue q k a ha]

/-- The literal ordered, weighted source Fourier contribution is likewise
invariant under choosing the canonical degree-bounded representative. -/
theorem orderedWeightedPrimeTripleFourierError_normalizedResidue (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    orderedWeightedPrimeTripleFourierError q k d (normalizedResidue q k a)
        (normalizedResidue_not_dvd q k a ha) =
      orderedWeightedPrimeTripleFourierError q k d a ha := by
  unfold orderedWeightedPrimeTripleFourierError
  rw [progressionUnit_normalizedResidue q k a ha]

/-- Source normalization changes the nontrivial Fourier error by precisely
the same positive integer factor as it changes the global and progression
masses. -/
theorem orderedWeightedPrimeTripleFourierError_eq (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    orderedWeightedPrimeTripleFourierError q k d a ha =
      (6 * (2 * d) ^ 3 : ℕ) * primeTripleFourierError q k d a ha := by
  classical
  unfold orderedWeightedPrimeTripleFourierError primeTripleFourierError
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro χ hχ
  rw [orderedWeightedPrimeTripleCharacterSum_eq]
  push_cast
  ring

/-- The trivial character contributes the global binomial count. -/
theorem trivial_primeTripleFourier_term (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    (1 : ProgressionCharacter q k)
          (↑((progressionUnit q k a ha)⁻¹) : ProgressionQuotient q k) *
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          (1 : ProgressionCharacter q k)
            (↑(primeTripleUnit q k d T) : ProgressionQuotient q k) =
      (Nat.choose (primePolynomialCount q (2 * d)) 3 : ℂ) := by
  simp only [MulChar.one_apply_coe, one_mul, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
  rw [Nat.card_eq_fintype_card, primeTriple_card]

/-- The exact main-term-plus-error identity underlying the specialized
Sawin estimate. -/
theorem primeTriple_main_add_fourierError (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    (Nat.choose (primePolynomialCount q (2 * d)) 3 : ℂ) +
        primeTripleFourierError q k d a ha =
      (progressionTotient q k : ℂ) *
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  classical
  have h := primeTriple_fourier_identity q k d a ha
  have hsplit := Finset.sum_erase_add
    (Finset.univ : Finset (ProgressionCharacter q k))
    (fun χ : ProgressionCharacter q k =>
      χ (↑((progressionUnit q k a ha)⁻¹) : ProgressionQuotient q k) *
        ∑ T : RepresentationFamilies.PrimeTriple q d,
          χ (↑(primeTripleUnit q k d T) : ProgressionQuotient q k))
    (Finset.mem_univ (1 : ProgressionCharacter q k))
  rw [h] at hsplit
  simpa only [primeTripleFourierError,
    trivial_primeTripleFourier_term q k d a ha, add_comm] using hsplit

/-- A single coarse envelope for both summands of Sawin's explicit error. -/
theorem equalDegreeError_le (d m : ℕ) :
    equalDegreeError q d m ≤
      2 ^ (8 * d + 3 * m + 3) * q ^ ((3 * d + 2 - m) / 2) := by
  let h := (3 * d + 2 - m) / 2
  let C := 2 ^ (8 * d + 3 * m + 2)
  have hM : 2 * equalDegreeMultinomial d ≤ 2 ^ (5 * d + 1) := by
    calc
      2 * equalDegreeMultinomial d ≤ 2 * 2 ^ (5 * d) :=
        Nat.mul_le_mul_left 2 (equalDegreeMultinomial_le_two_pow d)
      _ = 2 ^ (5 * d + 1) := by rw [pow_succ]; ring
  have hpow₁ : 2 ^ (m - 2) ≤ 2 ^ m :=
    Nat.pow_le_pow_right (by omega) (Nat.sub_le _ _)
  have hpow₂ : 2 ^ (m - 3) ≤ 2 ^ m :=
    Nat.pow_le_pow_right (by omega) (Nat.sub_le _ _)
  have hchoose₁ : Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) ≤
      2 ^ (3 * d + 2 * m + 1) := Nat.choose_le_two_pow _ _
  have hchoose₂ : Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) ≤
      2 ^ (3 * d + 2 * m + 1) := by
    calc
      Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) ≤
          2 ^ (3 * d + 2 * m - 3) := Nat.choose_le_two_pow _ _
      _ ≤ 2 ^ (3 * d + 2 * m + 1) :=
        Nat.pow_le_pow_right (by omega) (by omega)
  have hexp₁ : (3 * d + 1 - m) / 2 ≤ h := by
    dsimp only [h]
    omega
  have hterm₁ :
      2 * equalDegreeMultinomial d *
          (2 ^ (m - 2) * Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) *
            q ^ ((3 * d + 1 - m) / 2)) ≤ C * q ^ h := by
    calc
      2 * equalDegreeMultinomial d *
          (2 ^ (m - 2) * Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) *
            q ^ ((3 * d + 1 - m) / 2)) ≤
          2 ^ (5 * d + 1) *
            (2 ^ m * 2 ^ (3 * d + 2 * m + 1) * q ^ h) := by
        exact Nat.mul_le_mul hM
          (Nat.mul_le_mul (Nat.mul_le_mul hpow₁ hchoose₁)
            (Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) hexp₁))
      _ = C * q ^ h := by
        dsimp only [C]
        calc
          2 ^ (5 * d + 1) *
              (2 ^ m * 2 ^ (3 * d + 2 * m + 1) * q ^ h) =
              (2 ^ (5 * d + 1) *
                (2 ^ m * 2 ^ (3 * d + 2 * m + 1))) * q ^ h := by ring
          _ = 2 ^ (8 * d + 3 * m + 2) * q ^ h := by
            rw [← pow_add, ← pow_add]
            congr 2 <;> omega
  have hterm₂ :
      2 * equalDegreeMultinomial d *
          (2 ^ (m - 3) * Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) *
            q ^ ((3 * d + 2 - m) / 2)) ≤ C * q ^ h := by
    calc
      2 * equalDegreeMultinomial d *
          (2 ^ (m - 3) * Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) *
            q ^ ((3 * d + 2 - m) / 2)) ≤
          2 ^ (5 * d + 1) *
            (2 ^ m * 2 ^ (3 * d + 2 * m + 1) * q ^ h) := by
        exact Nat.mul_le_mul hM
          (Nat.mul_le_mul (Nat.mul_le_mul hpow₂ hchoose₂) (by rfl))
      _ = C * q ^ h := by
        dsimp only [C, h]
        calc
          2 ^ (5 * d + 1) *
              (2 ^ m * 2 ^ (3 * d + 2 * m + 1) *
                q ^ ((3 * d + 2 - m) / 2)) =
              (2 ^ (5 * d + 1) *
                (2 ^ m * 2 ^ (3 * d + 2 * m + 1))) *
                  q ^ ((3 * d + 2 - m) / 2) := by ring
          _ = 2 ^ (8 * d + 3 * m + 2) *
                q ^ ((3 * d + 2 - m) / 2) := by
            rw [← pow_add, ← pow_add]
            congr 2 <;> omega
  unfold equalDegreeError
  calc
    2 * equalDegreeMultinomial d *
        (2 ^ (m - 2) * Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) *
            q ^ ((3 * d + 1 - m) / 2) +
          2 ^ (m - 3) * Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) *
            q ^ ((3 * d + 2 - m) / 2)) =
        2 * equalDegreeMultinomial d *
            (2 ^ (m - 2) * Nat.choose (3 * d + 2 * m + 1) (3 * m + 1) *
              q ^ ((3 * d + 1 - m) / 2)) +
          2 * equalDegreeMultinomial d *
            (2 ^ (m - 3) * Nat.choose (3 * d + 2 * m - 3) (3 * m - 4) *
              q ^ ((3 * d + 2 - m) / 2)) := by ring
    _ ≤ C * q ^ h + C * q ^ h := Nat.add_le_add hterm₁ hterm₂
    _ = 2 ^ (8 * d + 3 * m + 3) * q ^ ((3 * d + 2 - m) / 2) := by
      dsimp only [C, h]
      rw [show 8 * d + 3 * m + 3 = (8 * d + 3 * m + 2) + 1 by omega,
        pow_succ]
      ring

/-- Coarse integer envelope for the already-sieved distinct-prime estimate
of Lemma 9.14.  Its binary coefficient is deliberately the same envelope
that dominates the two explicit Lemma 9.9 terms; the separate proof from
Lemma 9.14 must account for the repeated-prime inclusion--exclusion. -/
def sievedEqualDegreeError (d m : ℕ) : ℕ :=
  2 ^ (8 * d + 3 * m + 3) * q ^ ((3 * d + 2 - m) / 2)

/-- An explicit natural-number majorant for the closed-form right-hand side
of Sawin's Lemma 9.14 at θ = 20/21 and c = 0.  The elementary estimates
e < 3, 1 + 2θ < 3, (1 - θ)⁻¹ = 21, and
2^(θ/(1-θ)) = 2^20 put the factor multiplying √q below 2^28. -/
def sawinLemma914EqualDegreeError (d m : ℕ) : ℕ :=
  2 ^ (m + 1) * equalDegreeMultinomial d *
    2 ^ (28 * (3 * d - m)) *
    q ^ ((3 * d + 2 - m) / 2)

/-- Integer upper bound for the non-square-root part of the coefficient in
Lemma 9.14 at `θ = 20/21`: we use `1 + 2θ < 3`, `e < 3`,
`(1 - θ)⁻¹ = 21`, and `2^(θ/(1-θ)) = 2^20`. -/
def sawinThetaCoefficient : ℕ := 189 * 2 ^ 20

theorem sawinThetaCoefficient_lt_two_pow_28 :
    sawinThetaCoefficient < 2 ^ 28 := by
  norm_num [sawinThetaCoefficient]

/-- Raising the preceding coefficient estimate to the short-interval
dimension gives the exact binary factor used in the source envelope. -/
theorem sawinThetaCoefficient_pow_le (r : ℕ) :
    sawinThetaCoefficient ^ r ≤ 2 ^ (28 * r) := by
  calc
    sawinThetaCoefficient ^ r ≤ (2 ^ 28) ^ r :=
      Nat.pow_le_pow_left sawinThetaCoefficient_lt_two_pow_28.le r
    _ = 2 ^ (28 * r) := by rw [pow_mul]

/-- The linear inequality which absorbs the explicit absolute-constant reserve
in the canonical degree range.  It is separated from the exponent comparison
so that the latter does not carry the large lower-bound hypotheses. -/
theorem sourceEnvelope_linear_bound (d m : ℕ)
    (hm : 1000000 ≤ m) (hdegree : 20 * d ≤ 7 * m + 40) :
    81 * d ≤ 30 * m + 2 := by
  have hscale := Nat.mul_le_mul_left 81 hdegree
  have hlarge : 3200 ≤ 33 * m := by omega
  omega

/-- The purely linear exponent comparison used by the source envelope. -/
theorem sourceEnvelope_exponent_bound (d m : ℕ)
    (hrange : m ≤ 3 * d) (hlinear : 81 * d ≤ 30 * m + 2) :
    m + 1 + 5 * d + 28 * (3 * d - m) ≤
      8 * d + 3 * m + 3 := by
  omega

/-- In the canonical degree window, the explicit Lemma 9.14 expression fits
inside the simpler binary envelope used by the downstream arithmetic. -/
theorem sawinLemma914EqualDegreeError_le_sieved (d m : ℕ)
    (hm : 1000000 ≤ m) (hdegree : 20 * d ≤ 7 * m + 40)
    (hrange : m ≤ 3 * d) :
    sawinLemma914EqualDegreeError q d m ≤
      sievedEqualDegreeError q d m := by
  have hM : equalDegreeMultinomial d ≤ 2 ^ (5 * d) :=
    equalDegreeMultinomial_le_two_pow d
  have hlinear : 81 * d ≤ 30 * m + 2 :=
    sourceEnvelope_linear_bound d m hm hdegree
  have hexp :
      m + 1 + 5 * d + 28 * (3 * d - m) ≤
        8 * d + 3 * m + 3 :=
    sourceEnvelope_exponent_bound d m hrange hlinear
  have hcoef :
      2 ^ (m + 1) * equalDegreeMultinomial d *
          2 ^ (28 * (3 * d - m)) ≤
        2 ^ (8 * d + 3 * m + 3) := by
    calc
      2 ^ (m + 1) * equalDegreeMultinomial d *
          2 ^ (28 * (3 * d - m)) ≤
          (2 ^ (m + 1) * 2 ^ (5 * d)) *
            2 ^ (28 * (3 * d - m)) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hM)
      _ = 2 ^ (m + 1 + 5 * d + 28 * (3 * d - m)) := by
        rw [← pow_add, ← pow_add]
      _ ≤ 2 ^ (8 * d + 3 * m + 3) :=
        Nat.pow_le_pow_right (by omega) hexp
  unfold sawinLemma914EqualDegreeError sievedEqualDegreeError
  exact Nat.mul_le_mul_right _ hcoef

/-- The upper edge of the canonical degree choice, in the form needed to
compare the Lemma 9.14 coefficient with the coarse sieve envelope. -/
theorem canonicalPrimeDegree_upper (k : ℕ) :
    20 * (2 * Construction.canonicalDegreeIndex k) ≤ 7 * k ^ 2 + 40 := by
  have hdiv := Nat.div_mul_le_self (7 * k ^ 2) 40
  unfold Construction.canonicalDegreeIndex
  omega

theorem canonical_sawinLemma914EqualDegreeError_le_sieved {k : ℕ}
    (hk : 1000 ≤ k) :
    sawinLemma914EqualDegreeError q
        (2 * Construction.canonicalDegreeIndex k) (k ^ 2) ≤
      sievedEqualDegreeError q
        (2 * Construction.canonicalDegreeIndex k) (k ^ 2) := by
  apply sawinLemma914EqualDegreeError_le_sieved q
  · nlinarith
  · exact canonicalPrimeDegree_upper k
  · have hrange :=
      Construction.modulus_degree_in_sawin_range (by omega : 3 ≤ k)
    omega

/-- Convert a binary coefficient into a very small power of the fixed large
coefficient field. -/
theorem two_pow_le_largeField_pow (hq : 2 ^ 500 ≤ q) (a : ℕ) :
    2 ^ a ≤ q ^ (a / 500 + 1) := by
  have ha : a ≤ 500 * (a / 500 + 1) := by omega
  calc
    2 ^ a ≤ 2 ^ (500 * (a / 500 + 1)) :=
      Nat.pow_le_pow_right (by omega) ha
    _ = (2 ^ 500) ^ (a / 500 + 1) := by rw [pow_mul]
    _ ≤ q ^ (a / 500 + 1) := Nat.pow_le_pow_left hq _

theorem mainCoefficient_le_two_pow (d : ℕ) :
    192 * d ^ 3 ≤ 2 ^ (3 * d + 8) := by
  have hd : d ≤ 2 ^ d := Nat.lt_two_pow_self.le
  have hcubed : d ^ 3 ≤ (2 ^ d) ^ 3 := Nat.pow_le_pow_left hd 3
  calc
    192 * d ^ 3 ≤ 2 ^ 8 * (2 ^ d) ^ 3 := by
      exact Nat.mul_le_mul (by norm_num) hcubed
    _ = 2 ^ (3 * d + 8) := by
      rw [← pow_mul, ← pow_add]
      congr 1 <;> omega

/-- After multiplication by the modulus totient and the harmless
`192 d³` denominator from the Gauss bound, Sawin's error is still strictly
below the global three-prime scale. -/
theorem scaled_equalDegreeError_le_predecessor (hq : 2 ^ 500 ≤ q)
    {k d : ℕ} (hk : 1000 ≤ k) (hrange : 21 * k ^ 2 ≤ 60 * d) :
    192 * d ^ 3 * progressionTotient q k *
        equalDegreeError q d (k ^ 2) ≤ q ^ (3 * d - 1) := by
  let m := k ^ 2
  let h := (3 * d + 2 - m) / 2
  let A := 8 * d + 3 * m + 3
  let B := 11 * d + 3 * m + 11
  have hm : 1000000 ≤ m := by
    dsimp only [m]
    nlinarith
  have hklinear : 1000 * k ≤ m := by
    dsimp only [m]
    nlinarith
  have hrange' : 21 * m ≤ 60 * d := by simpa only [m] using hrange
  have hexp : m + h + (B / 500 + 1) < 3 * d := by
    dsimp only [h, B]
    omega
  have hφ := progressionTotient_le_pow_sq q k
  have hE := equalDegreeError_le q d m
  have hC := mainCoefficient_le_two_pow d
  have hbinary := two_pow_le_largeField_pow q hq B
  calc
    192 * d ^ 3 * progressionTotient q k * equalDegreeError q d (k ^ 2) =
        192 * d ^ 3 * progressionTotient q k * equalDegreeError q d m := by rfl
    _ ≤ 2 ^ (3 * d + 8) * q ^ m * (2 ^ A * q ^ h) := by
      exact Nat.mul_le_mul (Nat.mul_le_mul hC hφ) hE
    _ = 2 ^ B * q ^ (m + h) := by
      dsimp only [A, B]
      rw [pow_add, pow_add]
      ring
    _ ≤ q ^ (B / 500 + 1) * q ^ (m + h) :=
      Nat.mul_le_mul_right _ hbinary
    _ = q ^ (m + h + (B / 500 + 1)) := by
      rw [← pow_add]
      congr 1
      omega
    _ ≤ q ^ (3 * d - 1) :=
      Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) (by omega)

/-- The same numerical comparison for the distinct-prime sieve envelope
itself, rather than for the smaller unsieved two-term expression. -/
theorem scaled_sievedEqualDegreeError_le_predecessor (hq : 2 ^ 500 ≤ q)
    {k d : ℕ} (hk : 1000 ≤ k) (hrange : 21 * k ^ 2 ≤ 60 * d) :
    192 * d ^ 3 * progressionTotient q k *
        sievedEqualDegreeError q d (k ^ 2) ≤ q ^ (3 * d - 1) := by
  let m := k ^ 2
  let h := (3 * d + 2 - m) / 2
  let A := 8 * d + 3 * m + 3
  let B := 11 * d + 3 * m + 11
  have hm : 1000000 ≤ m := by
    dsimp only [m]
    nlinarith
  have hklinear : 1000 * k ≤ m := by
    dsimp only [m]
    nlinarith
  have hrange' : 21 * m ≤ 60 * d := by simpa only [m] using hrange
  have hexp : m + h + (B / 500 + 1) < 3 * d := by
    dsimp only [h, B]
    omega
  have hφ := progressionTotient_le_pow_sq q k
  have hC := mainCoefficient_le_two_pow d
  have hbinary := two_pow_le_largeField_pow q hq B
  calc
    192 * d ^ 3 * progressionTotient q k *
        sievedEqualDegreeError q d (k ^ 2) =
        192 * d ^ 3 * progressionTotient q k *
          (2 ^ A * q ^ h) := by rfl
    _ ≤ 2 ^ (3 * d + 8) * q ^ m * (2 ^ A * q ^ h) := by
      exact Nat.mul_le_mul (Nat.mul_le_mul hC hφ) le_rfl
    _ = 2 ^ B * q ^ (m + h) := by
      dsimp only [A, B]
      rw [pow_add, pow_add]
      ring
    _ ≤ q ^ (B / 500 + 1) * q ^ (m + h) :=
      Nat.mul_le_mul_right _ hbinary
    _ = q ^ (m + h + (B / 500 + 1)) := by
      rw [← pow_add]
      congr 1
      omega
    _ ≤ q ^ (3 * d - 1) :=
      Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) (by omega)

/-- The norm of a difference of embedded natural numbers is their natural
distance.  This is the exact bridge between Sawin's integer counting
statement and the complex Fourier normalization. -/
theorem norm_natCast_sub_natCast_eq_dist (x y : ℕ) :
    ‖(x : ℂ) - (y : ℂ)‖ = (Nat.dist x y : ℝ) := by
  rw [← dist_eq_norm]
  calc
    dist (x : ℂ) (y : ℂ) = dist (x : ℝ) (y : ℝ) := by
      simpa only [Complex.ofReal_natCast] using
        Complex.isometry_ofReal.dist_eq (x : ℝ) (y : ℝ)
    _ = (Nat.dist x y : ℝ) := by
      rcases le_total x y with h | h
      · have hR : (x : ℝ) ≤ y := by exact_mod_cast h
        simp [Real.dist_eq, Nat.dist, Nat.sub_eq_zero_of_le h,
          Nat.cast_sub h, abs_of_nonpos (sub_nonpos.mpr hR)]
      · have hR : (y : ℝ) ≤ x := by exact_mod_cast h
        simp [Real.dist_eq, Nat.dist, Nat.sub_eq_zero_of_le h,
        Nat.cast_sub h, abs_of_nonneg (sub_nonneg.mpr hR)]

/-- Dividing a cross-multiplied natural counting error by a positive Euler
factor gives exactly the absolute error between the progression count and
the global average. -/
theorem abs_natCast_sub_div_eq_dist_div (G P phi : ℕ) (hphi : 0 < phi) :
    |(P : ℝ) - (G : ℝ) / (phi : ℝ)| =
      (Nat.dist G (phi * P) : ℝ) / (phi : ℝ) := by
  have hphiR : (0 : ℝ) < phi := by exact_mod_cast hphi
  rw [show (P : ℝ) - (G : ℝ) / (phi : ℝ) =
      (((phi * P : ℕ) : ℝ) - (G : ℝ)) / (phi : ℝ) by
        field_simp
        norm_cast
        ring_nf]
  rw [abs_div, abs_of_pos hphiR]
  congr 1
  rcases le_total G (phi * P) with h | h
  · have hR : (G : ℝ) ≤ ((phi * P : ℕ) : ℝ) := by exact_mod_cast h
    rw [abs_of_nonneg (sub_nonneg.mpr hR)]
    simp only [Nat.dist, Nat.sub_eq_zero_of_le h, zero_add]
    norm_cast
  · have hR : ((phi * P : ℕ) : ℝ) ≤ (G : ℝ) := by exact_mod_cast h
    rw [abs_of_nonpos (sub_nonpos.mpr hR), neg_sub]
    simp only [Nat.dist, Nat.sub_eq_zero_of_le h, add_zero]
    norm_cast

theorem natDist_mul_le_iff_abs_sub_div_le
    (G P phi B : ℕ) (hphi : 0 < phi) :
    Nat.dist G (phi * P) ≤ phi * B ↔
      |(P : ℝ) - (G : ℝ) / (phi : ℝ)| ≤ (B : ℝ) := by
  rw [abs_natCast_sub_div_eq_dist_div G P phi hphi]
  have hphiR : (0 : ℝ) < phi := by exact_mod_cast hphi
  rw [div_le_iff₀ hphiR]
  norm_cast
  ring_nf

/-- In source normalization, the global ordered factorization mass plus
the nontrivial character contribution is exactly the totient times the
ordered progression mass. -/
theorem orderedWeightedPrimeTriple_main_add_fourierError (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    ((∑ _T : RepresentationFamilies.PrimeTripleOrdering q d,
        RepresentationFamilies.primeTripleOrderingWeight d : ℕ) : ℂ) +
        orderedWeightedPrimeTripleFourierError q k d a ha =
      ((progressionTotient q k *
        ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
          RepresentationFamilies.primeTripleOrderingWeight d : ℕ) : ℂ) := by
  rw [sum_primeTripleOrderingWeight,
    RepresentationFamilies.sum_congruentPrimeTripleOrderingWeight,
    orderedWeightedPrimeTripleFourierError_eq]
  push_cast
  calc
    (6 : ℂ) * (2 * d) ^ 3 *
          Nat.choose (primePolynomialCount q (2 * d)) 3 +
        (6 : ℂ) * (2 * d) ^ 3 * primeTripleFourierError q k d a ha =
        (6 : ℂ) * (2 * d) ^ 3 *
          ((Nat.choose (primePolynomialCount q (2 * d)) 3 : ℂ) +
            primeTripleFourierError q k d a ha) := by ring
    _ = (6 : ℂ) * (2 * d) ^ 3 *
        ((progressionTotient q k : ℂ) *
          (RepresentationFamilies.congruentPrimeTriples q k d a).card) := by
      rw [primeTriple_main_add_fourierError q k d a ha]
    _ = (progressionTotient q k : ℂ) *
        ((6 : ℂ) * (2 * d) ^ 3 *
          (RepresentationFamilies.congruentPrimeTriples q k d a).card) := by
      ring

/-- The norm of Sawin's literal ordered weighted nontrivial-character sum
is exactly the natural distance between its two integer masses. -/
theorem norm_orderedWeightedPrimeTripleFourierError_eq_dist (k d : ℕ)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    ‖orderedWeightedPrimeTripleFourierError q k d a ha‖ =
      (Nat.dist
        (∑ _T : RepresentationFamilies.PrimeTripleOrdering q d,
          RepresentationFamilies.primeTripleOrderingWeight d)
        (progressionTotient q k *
          ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
            RepresentationFamilies.primeTripleOrderingWeight d) : ℝ) := by
  let G := ∑ _T : RepresentationFamilies.PrimeTripleOrdering q d,
    RepresentationFamilies.primeTripleOrderingWeight d
  let P := progressionTotient q k *
    ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k d a,
      RepresentationFamilies.primeTripleOrderingWeight d
  let e := orderedWeightedPrimeTripleFourierError q k d a ha
  have hid : (G : ℂ) + e = (P : ℂ) := by
    simpa only [G, P, e] using
      orderedWeightedPrimeTriple_main_add_fourierError q k d a ha
  have he : e = -((G : ℂ) - (P : ℂ)) := by
    rw [neg_sub]
    exact eq_sub_of_add_eq (by simpa only [add_comm] using hid)
  rw [show orderedWeightedPrimeTripleFourierError q k d a ha = e by rfl,
    he, norm_neg, norm_natCast_sub_natCast_eq_dist]

/-- Natural-distance form of the literal equal-degree Lemma 9.14
specialization, after dividing the common ordered factorization weight.
Unlike a one-sided abundance estimate, this records the full progression
deviation proved in the source. -/
def HasSawinLemma914NatDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      Nat.dist
          (Nat.choose
            (primePolynomialCount q
              (2 * Construction.canonicalDegreeIndex k)) 3)
          (progressionTotient q k *
            (RepresentationFamilies.congruentPrimeTriples q k
              (Construction.canonicalDegreeIndex k) a).card) ≤
        progressionTotient q k *
          sawinLemma914EqualDegreeError q
            (2 * Construction.canonicalDegreeIndex k) (k ^ 2)

/-- The literal numerical envelope obtained by tracking the absolute
constant in Pilatte's Lemma 5.2 after setting `θ = 20/21`. -/
def trackedPilatteLemma52Error (d m : ℕ) : ℕ :=
  32 * equalDegreeMultinomial d *
    sawinThetaCoefficient ^ (3 * d - m) *
      q ^ ((3 * d - m + 1) / 2)

/-- Source-tracked form of Pilatte's Lemma 5.2 in the exact natural-distance
normalization used by the construction. -/
def HasTrackedPilatteLemma52 : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let d := 2 * Construction.canonicalDegreeIndex k
      let m := k ^ 2
      Nat.dist
          (Nat.choose (primePolynomialCount q d) 3)
          (progressionTotient q k *
            (RepresentationFamilies.congruentPrimeTriples q k
              (Construction.canonicalDegreeIndex k) a).card) ≤
        progressionTotient q k * trackedPilatteLemma52Error q d m

/-- The explicitly tracked source constant is dominated by the integral
envelope already used in the downstream arithmetic. -/
theorem trackedPilatteLemma52Error_le_sawinLemma914EqualDegreeError
    (d m : ℕ) (hm : 4 ≤ m) :
    trackedPilatteLemma52Error q d m ≤
      sawinLemma914EqualDegreeError q d m := by
  have h32 : 32 ≤ 2 ^ (m + 1) := by
    calc
      32 = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ (m + 1) :=
        Nat.pow_le_pow_right (by omega) (by omega)
  have htheta :
      sawinThetaCoefficient ^ (3 * d - m) ≤
        2 ^ (28 * (3 * d - m)) :=
    sawinThetaCoefficient_pow_le (3 * d - m)
  have hq :
      q ^ ((3 * d - m + 1) / 2) ≤
        q ^ ((3 * d + 2 - m) / 2) := by
    apply Nat.pow_le_pow_right (Fact.out : q.Prime).pos
    omega
  unfold trackedPilatteLemma52Error sawinLemma914EqualDegreeError
  gcongr

/-- The tracked form of Pilatte's lemma supplies the deviation interface
consumed by every later normalization. -/
theorem hasSawinLemma914NatDeviation_of_trackedPilatteLemma52
    (htracked : HasTrackedPilatteLemma52 q) :
    HasSawinLemma914NatDeviation q := by
  intro k hk a ha
  have hm : 4 ≤ k ^ 2 := by nlinarith
  have h := htracked k hk a ha
  dsimp only at h ⊢
  exact h.trans (Nat.mul_le_mul_left _
    (trackedPilatteLemma52Error_le_sawinLemma914EqualDegreeError
      q (2 * Construction.canonicalDegreeIndex k) (k ^ 2) hm))

/-- Source-order normalization of Lemma 9.14.  Both the global and
progression masses are multiplied by the exact common factor
`6 * (2d)^3`, coming respectively from the six orderings and the three
von-Mangoldt weights. -/
def HasSawinLemma914OrderedWeightedDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let d := 2 * Construction.canonicalDegreeIndex k
      let W := 6 * d ^ 3
      Nat.dist
          (W * Nat.choose (primePolynomialCount q d) 3)
          (progressionTotient q k *
            (W * (RepresentationFamilies.congruentPrimeTriples q k
              (Construction.canonicalDegreeIndex k) a).card)) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- Literal finite-sum form of the source specialization.  The first sum is
the global mass of Sawin's distinct-prime factorization function and the
second is its mass in the residue class of `a`; their summands are the exact
common von-Mangoldt weight `(2d)^3`. -/
def HasSawinLemma914SourceFactorizationSumDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (∑ _T : RepresentationFamilies.PrimeTripleOrdering q r,
            RepresentationFamilies.primeTripleOrderingWeight r)
          (progressionTotient q k *
            ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k r a,
              RepresentationFamilies.primeTripleOrderingWeight r) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- Sawin's specialization written solely as a factorization-function sum on
monic coefficient spaces.  The global sum ranges over all monic degree-`6r`
polynomials; the progression sum ranges over the affine short interval
`ā + Gₖ · M_(6r-k²)`.  No prime-triple or character encoding appears in this
interface. -/
def HasSawinLemma914AffineFactorizationDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (∑ F : MonicOfDegree q (6 * r),
            equalDegreeDistinctThreePrimeWeight q r
              (F : Polynomial (ZMod q)))
          (progressionTotient q k *
            ∑ P : MonicOfDegree q (6 * r - k ^ 2),
              equalDegreeDistinctThreePrimeWeight q r
                (normalizedResidue q k a + modulusProduct q k *
                  (P : Polynomial (ZMod q)))) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- The same affine statement with the coprimality restriction in the global
main term written exactly as in Sawin's Theorem 1.7. -/
def HasSawinLemma914CoprimeAffineFactorizationDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r)
          (progressionTotient q k *
            ∑ P : MonicOfDegree q (6 * r - k ^ 2),
              equalDegreeDistinctThreePrimeWeight q r
                (normalizedResidue q k a + modulusProduct q k *
                  (P : Polynomial (ZMod q)))) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- The coprime and unrestricted global terms coincide in this parity
specialization, so the two source-native affine formulations are equivalent. -/
theorem hasSawinLemma914CoprimeAffine_iff_affine :
    HasSawinLemma914CoprimeAffineFactorizationDeviation q ↔
      HasSawinLemma914AffineFactorizationDeviation q := by
  constructor <;> intro h k hk a ha
  · have hs := h k hk a ha
    simpa only [coprimeEqualDegreeDistinctThreePrimeWeightSum_eq,
      sum_equalDegreeDistinctThreePrimeWeight] using hs
  · have hs := h k hk a ha
    simpa only [coprimeEqualDegreeDistinctThreePrimeWeightSum_eq,
      sum_equalDegreeDistinctThreePrimeWeight] using hs

/-- The exact source progression mass over all monic degree-`6r`
polynomials in the residue class of `a`. -/
noncomputable def progressionEqualDegreeDistinctThreePrimeWeightSum
    (k r : ℕ) (a : Polynomial (ZMod q)) : ℕ :=
  ∑ F : MonicProgression q k (6 * r) a,
    equalDegreeDistinctThreePrimeWeight q r
      (F.1 : Polynomial (ZMod q))

/-- The local mass indexed intrinsically by a unit of the progression
quotient, using the fixed representative selected above. -/
noncomputable def unitProgressionEqualDegreeDistinctThreePrimeWeightSum
    (k r : ℕ) (u : (ProgressionQuotient q k)ˣ) : ℕ :=
  progressionEqualDegreeDistinctThreePrimeWeightSum q k r
    (progressionUnitRepresentative q k u)

/-! ### The concrete three-stratum specialization of Lemma 9.12

For three equal-degree factors the general partition-indexed formula in the
source has only the unsieved locus, three pair diagonals, and the full
diagonal.  The following functions retain precisely those six masses on the
finite group of invertible progression classes. -/

noncomputable def unitDistinctOrderedPrimeTripleWeight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentDistinctOrderedPrimeTriple q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitAllOrderedPrimeTripleWeight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentAllOrderedPrimeTriple q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleEqual12Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleEqual12 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleEqual13Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleEqual13 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleEqual23Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleEqual23 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleDiagonalWeight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleDiagonal q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleProper12Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleProper12 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleProper13Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleProper13 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

noncomputable def unitOrderedPrimeTripleProper23Weight (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ :=
  (((2 * r) ^ 3 * Fintype.card
    (CongruentOrderedPrimeTripleProper23 q k r
      (progressionUnitRepresentative q k u)) : ℕ) : ℂ)

/-! The three proper pair-collision strata are isomorphic by permuting the
ordered factors.  Commutativity preserves the product congruence, so their
masses agree pointwise in every progression class. -/

noncomputable def proper12EquivProper13 (k r : ℕ)
    (a : Polynomial (ZMod q)) :
    CongruentOrderedPrimeTripleProper12 q k r a ≃
      CongruentOrderedPrimeTripleProper13 q k r a where
  toFun T := by
    let V : OrderedPrimeTriple q r :=
      ⟨T.1.1.first, T.1.1.third, T.1.1.second⟩
    have hcong : modulusProduct q k ∣ V.product - a := by
      have h := T.1.2
      change modulusProduct q k ∣ T.1.1.product - a at h
      change modulusProduct q k ∣ V.product - a
      convert h using 1 <;> simp [V, OrderedPrimeTriple.product] <;> ring
    exact ⟨⟨V, hcong⟩, T.2⟩
  invFun T := by
    let V : OrderedPrimeTriple q r :=
      ⟨T.1.1.first, T.1.1.third, T.1.1.second⟩
    have hcong : modulusProduct q k ∣ V.product - a := by
      have h := T.1.2
      change modulusProduct q k ∣ T.1.1.product - a at h
      change modulusProduct q k ∣ V.product - a
      convert h using 1 <;> simp [V, OrderedPrimeTriple.product] <;> ring
    exact ⟨⟨V, hcong⟩, T.2⟩
  left_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    rfl
  right_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    rfl

noncomputable def proper12EquivProper23 (k r : ℕ)
    (a : Polynomial (ZMod q)) :
    CongruentOrderedPrimeTripleProper12 q k r a ≃
      CongruentOrderedPrimeTripleProper23 q k r a where
  toFun T := by
    let V : OrderedPrimeTriple q r :=
      ⟨T.1.1.third, T.1.1.first, T.1.1.second⟩
    have hcong : modulusProduct q k ∣ V.product - a := by
      have h := T.1.2
      change modulusProduct q k ∣ T.1.1.product - a at h
      change modulusProduct q k ∣ V.product - a
      convert h using 1 <;> simp [V, OrderedPrimeTriple.product] <;> ring
    exact ⟨⟨V, hcong⟩, T.2⟩
  invFun T := by
    let V : OrderedPrimeTriple q r :=
      ⟨T.1.1.second, T.1.1.third, T.1.1.first⟩
    have hcong : modulusProduct q k ∣ V.product - a := by
      have h := T.1.2
      change modulusProduct q k ∣ T.1.1.product - a at h
      change modulusProduct q k ∣ V.product - a
      convert h using 1 <;> simp [V, OrderedPrimeTriple.product] <;> ring
    exact ⟨⟨V, hcong⟩, T.2⟩
  left_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    rfl
  right_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    rfl

theorem card_proper12_eq_proper13 (k r : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentOrderedPrimeTripleProper12 q k r a) =
      Fintype.card (CongruentOrderedPrimeTripleProper13 q k r a) :=
  Fintype.card_congr (proper12EquivProper13 q k r a)

theorem card_proper12_eq_proper23 (k r : ℕ)
    (a : Polynomial (ZMod q)) :
    Fintype.card (CongruentOrderedPrimeTripleProper12 q k r a) =
      Fintype.card (CongruentOrderedPrimeTripleProper23 q k r a) :=
  Fintype.card_congr (proper12EquivProper23 q k r a)

theorem unitProper13Weight_eq_proper12 (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    unitOrderedPrimeTripleProper13Weight q k r u =
      unitOrderedPrimeTripleProper12Weight q k r u := by
  unfold unitOrderedPrimeTripleProper13Weight
    unitOrderedPrimeTripleProper12Weight
  rw [← card_proper12_eq_proper13]

theorem unitProper23Weight_eq_proper12 (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    unitOrderedPrimeTripleProper23Weight q k r u =
      unitOrderedPrimeTripleProper12Weight q k r u := by
  unfold unitOrderedPrimeTripleProper23Weight
    unitOrderedPrimeTripleProper12Weight
  rw [← card_proper12_eq_proper23]

/-- The concrete five disjoint partition strata on progression units. -/
noncomputable def unitOrderedPrimeTriplePartitionFamily (k r : ℕ) :
    ThreeFactorPartitionFamily ((ProgressionQuotient q k)ˣ) where
  distinct := unitDistinctOrderedPrimeTripleWeight q k r
  all := unitAllOrderedPrimeTripleWeight q k r
  proper12 := unitOrderedPrimeTripleProper12Weight q k r
  proper13 := unitOrderedPrimeTripleProper13Weight q k r
  proper23 := unitOrderedPrimeTripleProper23Weight q k r
  diagonal := unitOrderedPrimeTripleDiagonalWeight q k r
  partition := by
    intro u
    simp only [unitDistinctOrderedPrimeTripleWeight,
      unitAllOrderedPrimeTripleWeight,
      unitOrderedPrimeTripleProper12Weight,
      unitOrderedPrimeTripleProper13Weight,
      unitOrderedPrimeTripleProper23Weight,
      unitOrderedPrimeTripleDiagonalWeight]
    norm_cast
    calc
      (2 * r) ^ 3 * Fintype.card
            (CongruentDistinctOrderedPrimeTriple q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleProper12 q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleProper13 q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleProper23 q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleDiagonal q k r
              (progressionUnitRepresentative q k u)) =
        (2 * r) ^ 3 *
          (Fintype.card (CongruentDistinctOrderedPrimeTriple q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleProper12 q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleProper13 q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleProper23 q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleDiagonal q k r
              (progressionUnitRepresentative q k u))) := by ring
      _ = (2 * r) ^ 3 * Fintype.card
          (CongruentAllOrderedPrimeTriple q k r
            (progressionUnitRepresentative q k u)) := by
        rw [congruentOrderedPrimeTriple_proper_strata_partition]

/-! ### The full diagonal is elementary

The one-block stratum of Lemma 9.12 does not require a cohomological
estimate.  Under Chinese remaindering, a diagonal triple in a fixed unit
class gives a cube root in each of the `k` residue fields.  A cubic has at
most three roots in a field, so this stratum has at most `3^k` elements.
The next lemmas formalize this argument and compare it with the much larger
published Lemma 9.14 envelope. -/

/-- A cubic equation has at most three roots in a finite field. -/
theorem ncard_cubeRoots_le_three
    (K : Type*) [Field K] [Finite K] (a : K) :
    Set.ncard {x : K | x ^ 3 = a} ≤ 3 := by
  let P : Polynomial K := Polynomial.X ^ 3 - Polynomial.C a
  have hsubset : {x : K | x ^ 3 = a} ⊆ P.rootSet K := by
    intro x hx
    change x ^ 3 = a at hx
    rw [Polynomial.mem_rootSet]
    refine ⟨Polynomial.X_pow_sub_C_ne_zero (by omega) a, ?_⟩
    simp [P, Polynomial.aeval_def, hx]
  calc
    Set.ncard {x : K | x ^ 3 = a} ≤ Set.ncard (P.rootSet K) :=
      Set.ncard_mono hsubset
    _ ≤ P.natDegree := Polynomial.ncard_rootSet_le P K
    _ = 3 := by simp [P]

/-- Restricting a cubic equation to nonzero field elements preserves the
same three-root bound. -/
theorem natCard_units_cubeRoots_le_three
    (K : Type*) [Field K] [Finite K] (a : Kˣ) :
    Nat.card {x : Kˣ // x ^ 3 = a} ≤ 3 := by
  let f : {x : Kˣ // x ^ 3 = a} → {x : K // x ^ 3 = (a : K)} :=
    fun x => ⟨(x.1 : K), by
      simpa only [Units.val_pow_eq_pow_val] using
        congrArg (fun u : Kˣ => (u : K)) x.2⟩
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply Units.ext
    exact congrArg Subtype.val h
  calc
    Nat.card {x : Kˣ // x ^ 3 = a} ≤
        Nat.card {x : K // x ^ 3 = (a : K)} :=
      Nat.card_le_card_of_injective f hf
    _ = Set.ncard {x : K | x ^ 3 = (a : K)} := by
      exact Nat.card_coe_set_eq _
    _ ≤ 3 := ncard_cubeRoots_le_three K (a : K)

/-- The CRT equivalence on the unit group of the squarefree progression
quotient. -/
noncomputable def progressionUnitsCRTEquiv (k : ℕ) :
    (ProgressionQuotient q k)ˣ ≃*
      (∀ i : Fin k, (FiniteFieldEncoding.ResidueField q i)ˣ) :=
  (Units.mapEquiv (FiniteFieldEncoding.modulusQuotientEquiv q k).toMulEquiv).trans
    MulEquiv.piUnits

/-- A unit has at most `3^k` cube roots modulo the product of the first `k`
auxiliary irreducibles. -/
theorem natCard_progressionUnit_cubeRoots_le (k : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    Nat.card {x : (ProgressionQuotient q k)ˣ // x ^ 3 = u} ≤ 3 ^ k := by
  classical
  let E := progressionUnitsCRTEquiv q k
  let target := ∀ i : Fin k,
    {y : (FiniteFieldEncoding.ResidueField q i)ˣ // y ^ 3 = E u i}
  let f : {x : (ProgressionQuotient q k)ˣ // x ^ 3 = u} → target :=
    fun x i => ⟨E x.1 i, by
      have h := congrArg E x.2
      exact congrFun (by simpa only [map_pow] using h) i⟩
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply E.injective
    funext i
    exact congrArg (fun z : target => (z i).1) h
  calc
    Nat.card {x : (ProgressionQuotient q k)ˣ // x ^ 3 = u} ≤
        Nat.card target := Nat.card_le_card_of_injective f hf
    _ = ∏ i : Fin k,
          Nat.card {y : (FiniteFieldEncoding.ResidueField q i)ˣ //
            y ^ 3 = E u i} := Nat.card_pi
    _ ≤ ∏ _i : Fin k, 3 := by
      apply Finset.prod_le_prod
      · intro i _hi
        positivity
      · intro i _hi
        exact natCard_units_cubeRoots_le_three
          (FiniteFieldEncoding.ResidueField q i) (E u i)
    _ = 3 ^ k := by simp

/-- The invertible progression class of one even-degree prime polynomial. -/
noncomputable def primePolynomialProgressionUnit (k r : ℕ)
    (p : OfDegree q (2 * r)) : (ProgressionQuotient q k)ˣ :=
  progressionUnit q k p.1 fun i _hi =>
    FiniteFieldEncoding.auxiliaryIrreducible_not_dvd_even_irreducible
      q i (PrimePolynomials.irreducible p) (PrimePolynomials.natDegree p)

@[simp] theorem primePolynomialProgressionUnit_val (k r : ℕ)
    (p : OfDegree q (2 * r)) :
    (primePolynomialProgressionUnit q k r p : ProgressionQuotient q k) =
      AdjoinRoot.mk (modulusProduct q k) p.1 :=
  progressionUnit_val q k p.1 _

/-! ### Explicit Fourier coefficients of the two remaining strata

The unsieved ordered family and one proper pair family are the only
non-elementary terms left after the partition and symmetry reductions.  The
next identities expose their Fourier coefficients as elementary expressions
in the prime power sums `S_e(χ)`.  Thus the later Frobenius estimate acts on
the literal source expressions `S₁(χ)^3` and `S₂(χ)S₁(χ)-S₃(χ)` rather than
on an abstract family. -/

theorem sum_triple_eq_cube {α : Type*} [Fintype α] (f : α → ℂ) :
    (∑ x : α × α × α, f x.1 * f x.2.1 * f x.2.2) =
      (∑ x, f x) ^ 3 := by
  rw [pow_three]
  simp only [Fintype.sum_prod_type]
  rw [Finset.sum_mul_sum]
  rw [Finset.sum_mul_sum]
  simp only [mul_assoc]
  simp only [Finset.mul_sum]

/-- The degree-`2r` prime sum twisted by the `e`th power of a progression
character. -/
noncomputable def primePolynomialCharacterSum (k r e : ℕ)
    (χ : ProgressionCharacter q k) : ℂ :=
  ∑ p : OfDegree q (2 * r),
    χ (↑((primePolynomialProgressionUnit q k r p) ^ e) :
      ProgressionQuotient q k)

/-- The invertible progression class of an ordered prime-triple product. -/
noncomputable def orderedPrimeTripleProgressionUnit (k r : ℕ)
    (T : OrderedPrimeTriple q r) : (ProgressionQuotient q k)ˣ :=
  progressionUnit q k T.product fun i _hi => by
    unfold OrderedPrimeTriple.product
    rw [(auxiliaryIrreducible_irreducible q i).prime.dvd_mul]
    push Not
    constructor
    · rw [(auxiliaryIrreducible_irreducible q i).prime.dvd_mul]
      push Not
      exact ⟨
        FiniteFieldEncoding.auxiliaryIrreducible_not_dvd_even_irreducible
          q i (PrimePolynomials.irreducible T.first)
            (PrimePolynomials.natDegree T.first),
        FiniteFieldEncoding.auxiliaryIrreducible_not_dvd_even_irreducible
          q i (PrimePolynomials.irreducible T.second)
            (PrimePolynomials.natDegree T.second)⟩
    · exact FiniteFieldEncoding.auxiliaryIrreducible_not_dvd_even_irreducible
        q i (PrimePolynomials.irreducible T.third)
          (PrimePolynomials.natDegree T.third)

@[simp] theorem orderedPrimeTripleProgressionUnit_val (k r : ℕ)
    (T : OrderedPrimeTriple q r) :
    (orderedPrimeTripleProgressionUnit q k r T : ProgressionQuotient q k) =
      AdjoinRoot.mk (modulusProduct q k) T.product :=
  progressionUnit_val q k T.product _

theorem orderedPrimeTripleProgressionUnit_eq_mul (k r : ℕ)
    (T : OrderedPrimeTriple q r) :
    orderedPrimeTripleProgressionUnit q k r T =
      primePolynomialProgressionUnit q k r T.first *
        primePolynomialProgressionUnit q k r T.second *
          primePolynomialProgressionUnit q k r T.third := by
  apply Units.ext
  simp only [orderedPrimeTripleProgressionUnit_val, Units.val_mul,
    primePolynomialProgressionUnit_val]
  rfl

def orderedPrimeTripleEquiv (r : ℕ) :
    OrderedPrimeTriple q r ≃
      OfDegree q (2 * r) × OfDegree q (2 * r) × OfDegree q (2 * r) where
  toFun T := (T.first, T.second, T.third)
  invFun T := ⟨T.1, T.2.1, T.2.2⟩
  left_inv T := by cases T; rfl
  right_inv T := by rcases T with ⟨x, y, z⟩; rfl

/-- The unsieved ordered-triple Fourier coefficient is the cube of the
single-prime coefficient. -/
theorem sum_orderedPrimeTriple_character_eq_cube (k r : ℕ)
    (χ : ProgressionCharacter q k) :
    (∑ T : OrderedPrimeTriple q r,
        χ (↑(orderedPrimeTripleProgressionUnit q k r T) :
          ProgressionQuotient q k)) =
      (primePolynomialCharacterSum q k r 1 χ) ^ 3 := by
  simp only [orderedPrimeTripleProgressionUnit_eq_mul, Units.val_mul,
    map_mul, primePolynomialCharacterSum, pow_one, pow_three]
  rw [Fintype.sum_equiv (orderedPrimeTripleEquiv q r)
    (fun T : OrderedPrimeTriple q r =>
      χ (primePolynomialProgressionUnit q k r T.first : ProgressionQuotient q k) *
        χ (primePolynomialProgressionUnit q k r T.second : ProgressionQuotient q k) *
          χ (primePolynomialProgressionUnit q k r T.third : ProgressionQuotient q k))
    (fun T : OfDegree q (2 * r) × OfDegree q (2 * r) × OfDegree q (2 * r) =>
      χ (primePolynomialProgressionUnit q k r T.1 : ProgressionQuotient q k) *
        χ (primePolynomialProgressionUnit q k r T.2.1 : ProgressionQuotient q k) *
          χ (primePolynomialProgressionUnit q k r T.2.2 : ProgressionQuotient q k))
    (by intro T; rfl)]
  simpa only [pow_three] using sum_triple_eq_cube
    (fun p : OfDegree q (2 * r) =>
      χ (primePolynomialProgressionUnit q k r p : ProgressionQuotient q k))

/-- The Fourier coefficient of the proper `12` pair stratum, indexed by its
repeated prime and its distinct third prime. -/
noncomputable def primeProperPairCharacterSum (k r : ℕ)
    (χ : ProgressionCharacter q k) : ℂ :=
  ∑ p : OfDegree q (2 * r),
    ∑ s ∈ (Finset.univ.erase p),
      χ (↑((primePolynomialProgressionUnit q k r p) ^ 2 *
        primePolynomialProgressionUnit q k r s) : ProgressionQuotient q k)

/-- Removing the full diagonal gives exactly `S₂(χ)S₁(χ)-S₃(χ)`. -/
theorem primeProperPairCharacterSum_eq (k r : ℕ)
    (χ : ProgressionCharacter q k) :
    primeProperPairCharacterSum q k r χ =
      primePolynomialCharacterSum q k r 2 χ *
        primePolynomialCharacterSum q k r 1 χ -
          primePolynomialCharacterSum q k r 3 χ := by
  classical
  unfold primeProperPairCharacterSum primePolynomialCharacterSum
  simp only [Units.val_mul, map_mul, Finset.mul_sum]
  have herase : ∀ p : OfDegree q (2 * r),
      ∑ s ∈ Finset.univ.erase p,
          χ (↑((primePolynomialProgressionUnit q k r p) ^ 2) :
              ProgressionQuotient q k) *
            χ (↑(primePolynomialProgressionUnit q k r s) :
              ProgressionQuotient q k) =
        χ (↑((primePolynomialProgressionUnit q k r p) ^ 2) :
              ProgressionQuotient q k) *
            ∑ s : OfDegree q (2 * r),
              χ (↑(primePolynomialProgressionUnit q k r s) :
                ProgressionQuotient q k) -
          χ (↑((primePolynomialProgressionUnit q k r p) ^ 3) :
            ProgressionQuotient q k) := by
    intro p
    rw [← Finset.mul_sum]
    have hsum :
        (∑ s ∈ Finset.univ.erase p,
            χ (↑(primePolynomialProgressionUnit q k r s) :
              ProgressionQuotient q k)) =
          (∑ s : OfDegree q (2 * r),
              χ (↑(primePolynomialProgressionUnit q k r s) :
                ProgressionQuotient q k)) -
            χ (↑(primePolynomialProgressionUnit q k r p) :
              ProgressionQuotient q k) := by
      apply eq_sub_of_add_eq
      exact Finset.sum_erase_add Finset.univ _ (Finset.mem_univ p)
    rw [hsum]
    simp only [Units.val_pow_eq_pow_val, map_pow]
    ring
  simp_rw [herase]
  rw [Finset.sum_sub_distrib]
  rw [← Finset.sum_mul]
  simp only [pow_one, Finset.mul_sum]

/-- Fourier inversion for the fiber of any finite family of progression
units. -/
theorem progressionUnit_fiber_fourier_identity
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ)
    (u : (ProgressionQuotient q k)ˣ) :
    ((progressionTotient q k * Fintype.card {a : α // f a = u} : ℕ) : ℂ) =
      ∑ χ : ProgressionCharacter q k,
        χ (↑(u⁻¹) : ProgressionQuotient q k) *
          ∑ a : α, χ (↑(f a) : ProgressionQuotient q k) := by
  classical
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  calc
    ((progressionTotient q k * Fintype.card {a : α // f a = u} : ℕ) : ℂ) =
        ∑ a : α, if f a = u then (progressionTotient q k : ℂ) else 0 := by
      push_cast
      rw [Fintype.card_subtype]
      rw [Finset.card_eq_sum_ones]
      push_cast
      rw [Finset.mul_sum]
      rw [← Finset.sum_filter]
      simp only [mul_one]
    _ = ∑ a : α,
        ∑ χ : ProgressionCharacter q k,
          χ (↑(u⁻¹) : ProgressionQuotient q k) *
            χ (↑(f a) : ProgressionQuotient q k) := by
      apply Finset.sum_congr rfl
      intro a _ha
      simp_rw [← map_mul]
      rw [← Units.val_mul]
      rw [progressionCharacter_sum_eq q]
      · congr 1
        apply propext
        constructor
        · intro h
          have hunit : u⁻¹ * f a = 1 := (inv_mul_eq_one).mpr h.symm
          exact congrArg Units.val hunit
        · intro h
          have hunit : u⁻¹ * f a = 1 := by
            apply Units.ext
            simpa only [Units.val_mul, Units.val_inv_eq_inv_val,
              Units.val_one] using h
          exact ((inv_mul_eq_one).mp hunit).symm
      · exact (u⁻¹ * f a).isUnit
    _ = _ := rfl

theorem orderedPrimeTripleProgressionUnit_eq_iff (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) (T : OrderedPrimeTriple q r) :
    orderedPrimeTripleProgressionUnit q k r T = u ↔
      modulusProduct q k ∣
        T.product - progressionUnitRepresentative q k u := by
  constructor
  · intro h
    have hv := congrArg Units.val h
    rw [orderedPrimeTripleProgressionUnit_val,
      ← progressionUnitRepresentative_mk q k u] at hv
    exact AdjoinRoot.mk_eq_mk.mp hv
  · intro h
    apply Units.ext
    rw [orderedPrimeTripleProgressionUnit_val,
      ← progressionUnitRepresentative_mk q k u]
    exact AdjoinRoot.mk_eq_mk.mpr h

noncomputable def orderedPrimeTripleFiberEquiv (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    {T : OrderedPrimeTriple q r //
        orderedPrimeTripleProgressionUnit q k r T = u} ≃
      CongruentAllOrderedPrimeTriple q k r
        (progressionUnitRepresentative q k u) where
  toFun T := ⟨T.1,
    (orderedPrimeTripleProgressionUnit_eq_iff q k r u T.1).mp T.2⟩
  invFun T := ⟨T.1,
    (orderedPrimeTripleProgressionUnit_eq_iff q k r u T.1).mpr T.2⟩
  left_inv T := by apply Subtype.ext; rfl
  right_inv T := by apply Subtype.ext; rfl

/-- Exact Fourier inversion for the unsieved ordered progression mass. -/
theorem orderedPrimeTriple_all_fourier_identity (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    ((progressionTotient q k *
        Fintype.card (CongruentAllOrderedPrimeTriple q k r
          (progressionUnitRepresentative q k u)) : ℕ) : ℂ) =
      ∑ χ : ProgressionCharacter q k,
        χ (↑(u⁻¹) : ProgressionQuotient q k) *
          (primePolynomialCharacterSum q k r 1 χ) ^ 3 := by
  rw [← Fintype.card_congr (orderedPrimeTripleFiberEquiv q k r u)]
  rw [progressionUnit_fiber_fourier_identity q k
    (orderedPrimeTripleProgressionUnit q k r) u]
  apply Finset.sum_congr rfl
  intro χ _hχ
  rw [sum_orderedPrimeTriple_character_eq_cube q k r χ]

/-- A repeated prime and a distinct third prime, the intrinsic parameters of
the proper `12` collision stratum. -/
def ProperPrimePair (q r : ℕ) :=
  Σ p : OfDegree q (2 * r), {s : OfDegree q (2 * r) // s ≠ p}

noncomputable instance properPrimePairFintype (r : ℕ) :
    Fintype (ProperPrimePair q r) := by
  unfold ProperPrimePair
  infer_instance

noncomputable def properPrimePairProgressionUnit (k r : ℕ)
    (x : ProperPrimePair q r) : (ProgressionQuotient q k)ˣ :=
  (primePolynomialProgressionUnit q k r x.1) ^ 2 *
    primePolynomialProgressionUnit q k r x.2.1

theorem sum_properPrimePair_character (k r : ℕ)
    (χ : ProgressionCharacter q k) :
    (∑ x : ProperPrimePair q r,
        χ (↑(properPrimePairProgressionUnit q k r x) :
          ProgressionQuotient q k)) =
      primeProperPairCharacterSum q k r χ := by
  classical
  unfold ProperPrimePair properPrimePairProgressionUnit
    primeProperPairCharacterSum
  rw [Fintype.sum_sigma]
  apply Finset.sum_congr rfl
  intro p _hp
  change
    (∑ s : {s : OfDegree q (2 * r) // s ≠ p},
        χ (↑((primePolynomialProgressionUnit q k r p) ^ 2 *
          primePolynomialProgressionUnit q k r s.1) :
            ProgressionQuotient q k)) =
      ∑ s ∈ Finset.univ.erase p,
        χ (↑((primePolynomialProgressionUnit q k r p) ^ 2 *
          primePolynomialProgressionUnit q k r s) :
            ProgressionQuotient q k)
  rw [← Finset.filter_ne' Finset.univ p]
  rw [← Finset.sum_subtype_eq_sum_filter]
  apply Finset.sum_congr
  · ext s
    simp
  · intro s _hs
    rfl

def properPrimePairOrderedTriple (r : ℕ) (x : ProperPrimePair q r) :
    OrderedPrimeTriple q r :=
  ⟨x.1, x.1, x.2.1⟩

theorem orderedPrimeTripleProgressionUnit_pair (k r : ℕ)
    (x : ProperPrimePair q r) :
    orderedPrimeTripleProgressionUnit q k r
        (properPrimePairOrderedTriple q r x) =
      properPrimePairProgressionUnit q k r x := by
  rw [orderedPrimeTripleProgressionUnit_eq_mul]
  unfold properPrimePairProgressionUnit properPrimePairOrderedTriple
  rw [pow_two]

noncomputable def properPrimePairFiberEquiv (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    {x : ProperPrimePair q r //
        properPrimePairProgressionUnit q k r x = u} ≃
      CongruentOrderedPrimeTripleProper12 q k r
        (progressionUnitRepresentative q k u) where
  toFun x := by
    let T := properPrimePairOrderedTriple q r x.1
    have hunit : orderedPrimeTripleProgressionUnit q k r T = u := by
      rw [orderedPrimeTripleProgressionUnit_pair]
      exact x.2
    have hcong := (orderedPrimeTripleProgressionUnit_eq_iff q k r u T).mp hunit
    refine ⟨⟨T, hcong⟩, ?_⟩
    exact ⟨rfl, x.1.2.2.symm⟩
  invFun T := by
    let x : ProperPrimePair q r :=
      ⟨T.1.1.first, ⟨T.1.1.third, T.2.2.symm⟩⟩
    refine ⟨x, ?_⟩
    rw [← orderedPrimeTripleProgressionUnit_pair q k r x]
    have hT : properPrimePairOrderedTriple q r x = T.1.1 := by
      apply orderedPrimeTriple_tuple_injective q r
      simp only [properPrimePairOrderedTriple, x]
      rw [T.2.1]
    rw [hT]
    exact (orderedPrimeTripleProgressionUnit_eq_iff q k r u T.1.1).mpr T.1.2
  left_inv x := by
    rcases x with ⟨⟨p, ⟨s, hsp⟩⟩, hu⟩
    rfl
  right_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    simp only [properPrimePairOrderedTriple]
    rw [T.2.1]

/-- Exact Fourier inversion for the representative proper-pair progression
mass. -/
theorem orderedPrimeTriple_proper12_fourier_identity (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    ((progressionTotient q k *
        Fintype.card (CongruentOrderedPrimeTripleProper12 q k r
          (progressionUnitRepresentative q k u)) : ℕ) : ℂ) =
      ∑ χ : ProgressionCharacter q k,
        χ (↑(u⁻¹) : ProgressionQuotient q k) *
          primeProperPairCharacterSum q k r χ := by
  rw [← Fintype.card_congr (properPrimePairFiberEquiv q k r u)]
  rw [progressionUnit_fiber_fourier_identity q k
    (properPrimePairProgressionUnit q k r) u]
  apply Finset.sum_congr rfl
  intro χ _hχ
  rw [sum_properPrimePair_character q k r χ]

/-- The nontrivial-character part of Fourier inversion for an arbitrary
finite family valued in progression units. -/
noncomputable def progressionUnitFiberFourierError
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ := by
  classical
  exact
    ∑ χ ∈ (@Finset.univ (ProgressionCharacter q k) _).erase 1,
      χ (↑(u⁻¹) : ProgressionQuotient q k) *
        ∑ a : α, χ (↑(f a) : ProgressionQuotient q k)

/-- Separating the trivial character in the generic Fourier inversion gives
the total family cardinality plus the nontrivial-character error. -/
theorem progressionUnit_fiber_main_add_error
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ)
    (u : (ProgressionQuotient q k)ˣ) :
    ((progressionTotient q k * Fintype.card {a : α // f a = u} : ℕ) : ℂ) =
      Fintype.card α + progressionUnitFiberFourierError q k f u := by
  classical
  rw [progressionUnit_fiber_fourier_identity q k f u]
  unfold progressionUnitFiberFourierError
  rw [← Finset.sum_erase_add _ _
    (Finset.mem_univ (1 : ProgressionCharacter q k))]
  simp only [MulChar.one_apply, Units.isUnit, if_true, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul, mul_one]
  ring

/-- The sigma type of all fibers of a unit-valued finite family. -/
noncomputable def progressionUnitFiberSigma
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ) :=
  Σ u : (ProgressionQuotient q k)ˣ, {a : α // f a = u}

/-- The disjoint union of all fibers is the original finite family. -/
noncomputable def progressionUnitFiberSigmaEquiv
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ) :
    progressionUnitFiberSigma q k f ≃ α where
  toFun x := x.2.1
  invFun a := ⟨f a, ⟨a, rfl⟩⟩
  left_inv x := by
    rcases x with ⟨u, ⟨a, ha⟩⟩
    subst u
    rfl
  right_inv a := rfl

/-- Consequently the sum of all fiber cardinalities is the family
cardinality. -/
theorem sum_progressionUnit_fiber_card
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ) :
    (∑ u : (ProgressionQuotient q k)ˣ,
        Fintype.card {a : α // f a = u}) = Fintype.card α := by
  rw [← Fintype.card_sigma]
  exact Fintype.card_congr (progressionUnitFiberSigmaEquiv q k f)

/-- Exact centered form of generic unit-group Fourier inversion.  This is
the bridge from source character sums to the two progression-mass deviations
needed in the three-factor partition. -/
theorem progressionUnit_fiber_centered_eq_error_div
    {α : Type*} [Fintype α]
    (k : ℕ) (f : α → (ProgressionQuotient q k)ˣ)
    (u : (ProgressionQuotient q k)ˣ) :
    (Fintype.card {a : α // f a = u} : ℂ) -
        (∑ v : (ProgressionQuotient q k)ˣ,
          (Fintype.card {a : α // f a = v} : ℂ)) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      progressionUnitFiberFourierError q k f u /
        (progressionTotient q k : ℂ) := by
  have hφ : (progressionTotient q k : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (progressionTotient_pos q k))
  have hden :
      (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
        (progressionTotient q k : ℂ) := by
    rw [← Nat.card_eq_fintype_card,
      ← progressionTotient_eq_modulusQuotient_units_natCard q k]
  have hmain := progressionUnit_fiber_main_add_error q k f u
  rw [hden, ← Nat.cast_sum]
  rw [sum_progressionUnit_fiber_card q k f]
  apply (eq_div_iff hφ).2
  push_cast at hmain
  rw [sub_mul, div_mul_cancel₀ _ hφ]
  linear_combination hmain

/-- Scaling a finite family by an integer weight scales its centered Fourier
identity by the same factor. -/
theorem progressionUnit_fiber_weighted_centered_eq_error_div
    {α : Type*} [Fintype α]
    (k w : ℕ) (f : α → (ProgressionQuotient q k)ˣ)
    (u : (ProgressionQuotient q k)ˣ) :
    ((w * Fintype.card {a : α // f a = u} : ℕ) : ℂ) -
        (∑ v : (ProgressionQuotient q k)ˣ,
          ((w * Fintype.card {a : α // f a = v} : ℕ) : ℂ)) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      (w : ℂ) * progressionUnitFiberFourierError q k f u /
        (progressionTotient q k : ℂ) := by
  have h := progressionUnit_fiber_centered_eq_error_div q k f u
  push_cast
  rw [← Finset.mul_sum]
  calc
    (w : ℂ) * Fintype.card {a : α // f a = u} -
        (w : ℂ) * (∑ v : (ProgressionQuotient q k)ˣ,
          (Fintype.card {a : α // f a = v} : ℂ)) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      (w : ℂ) * ((Fintype.card {a : α // f a = u} : ℂ) -
        (∑ v : (ProgressionQuotient q k)ˣ,
          (Fintype.card {a : α // f a = v} : ℂ)) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)) := by ring
    _ = (w : ℂ) * (progressionUnitFiberFourierError q k f u /
        (progressionTotient q k : ℂ)) := by rw [h]
    _ = _ := by ring

theorem card_orderedPrimeTriple_fiber (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    Fintype.card {T : OrderedPrimeTriple q r //
        orderedPrimeTripleProgressionUnit q k r T = u} =
      Fintype.card (CongruentAllOrderedPrimeTriple q k r
        (progressionUnitRepresentative q k u)) :=
  Fintype.card_congr (orderedPrimeTripleFiberEquiv q k r u)

theorem card_properPrimePair_fiber (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    Fintype.card {x : ProperPrimePair q r //
        properPrimePairProgressionUnit q k r x = u} =
      Fintype.card (CongruentOrderedPrimeTripleProper12 q k r
        (progressionUnitRepresentative q k u)) :=
  Fintype.card_congr (properPrimePairFiberEquiv q k r u)

theorem unitAllOrderedPrimeTripleWeight_centered_eq_error_div
    (k r : ℕ) (u : (ProgressionQuotient q k)ˣ) :
    unitAllOrderedPrimeTripleWeight q k r u -
        (∑ v, unitAllOrderedPrimeTripleWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      (((2 * r) ^ 3 : ℕ) : ℂ) *
          progressionUnitFiberFourierError q k
            (orderedPrimeTripleProgressionUnit q k r) u /
        (progressionTotient q k : ℂ) := by
  have h := progressionUnit_fiber_weighted_centered_eq_error_div q k
    ((2 * r) ^ 3) (orderedPrimeTripleProgressionUnit q k r) u
  simp_rw [card_orderedPrimeTriple_fiber q k r] at h
  exact h

theorem unitProper12Weight_centered_eq_error_div
    (k r : ℕ) (u : (ProgressionQuotient q k)ˣ) :
    unitOrderedPrimeTripleProper12Weight q k r u -
        (∑ v, unitOrderedPrimeTripleProper12Weight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      (((2 * r) ^ 3 : ℕ) : ℂ) *
          progressionUnitFiberFourierError q k
            (properPrimePairProgressionUnit q k r) u /
        (progressionTotient q k : ℂ) := by
  have h := progressionUnit_fiber_weighted_centered_eq_error_div q k
    ((2 * r) ^ 3) (properPrimePairProgressionUnit q k r) u
  simp_rw [card_properPrimePair_fiber q k r] at h
  exact h

/-- The unsieved nontrivial Fourier error written directly as the source
character expression `S₁(χ)³`. -/
noncomputable def allPrimeTripleCharacterError (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ := by
  classical
  exact
    ∑ χ ∈ (@Finset.univ (ProgressionCharacter q k) _).erase 1,
      χ (↑(u⁻¹) : ProgressionQuotient q k) *
        (primePolynomialCharacterSum q k r 1 χ) ^ 3

/-- The representative proper-pair nontrivial Fourier error, namely the
source expression `S₂(χ)S₁(χ)-S₃(χ)`. -/
noncomputable def properPrimePairCharacterError (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) : ℂ := by
  classical
  exact
    ∑ χ ∈ (@Finset.univ (ProgressionCharacter q k) _).erase 1,
      χ (↑(u⁻¹) : ProgressionQuotient q k) *
        (primePolynomialCharacterSum q k r 2 χ *
          primePolynomialCharacterSum q k r 1 χ -
            primePolynomialCharacterSum q k r 3 χ)

theorem progressionUnitFiberFourierError_all_eq (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    progressionUnitFiberFourierError q k
        (orderedPrimeTripleProgressionUnit q k r) u =
      allPrimeTripleCharacterError q k r u := by
  classical
  unfold progressionUnitFiberFourierError allPrimeTripleCharacterError
  apply Finset.sum_congr rfl
  intro χ _hχ
  rw [sum_orderedPrimeTriple_character_eq_cube q k r χ]

theorem progressionUnitFiberFourierError_pair_eq (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) :
    progressionUnitFiberFourierError q k
        (properPrimePairProgressionUnit q k r) u =
      properPrimePairCharacterError q k r u := by
  classical
  unfold progressionUnitFiberFourierError properPrimePairCharacterError
  apply Finset.sum_congr rfl
  intro χ _hχ
  rw [sum_properPrimePair_character q k r χ,
    primeProperPairCharacterSum_eq q k r χ]

/-- The exact remaining two-family character estimate after every
factorization, sieve, symmetry, and progression normalization has been
removed. -/
def HasSawinLemma914AllAndOnePairCharacterCancellation : Prop :=
  ∀ k : ℕ, 1000 ≤ k →
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    ∀ u : (ProgressionQuotient q k)ˣ,
      ‖allPrimeTripleCharacterError q k r u‖ +
        3 * ‖properPrimePairCharacterError q k r u‖ ≤
      ((progressionTotient q k *
        (4 * sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ)

/-- A diagonal ordered prime triple maps to the cube root represented by
its common prime factor. -/
noncomputable def diagonalPrimeToCubeRoot (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ)
    (T : CongruentOrderedPrimeTripleDiagonal q k r
      (progressionUnitRepresentative q k u)) :
    {x : (ProgressionQuotient q k)ˣ // x ^ 3 = u} := by
  let p := T.1.1.first
  refine ⟨primePolynomialProgressionUnit q k r p, ?_⟩
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, primePolynomialProgressionUnit_val]
  rw [← progressionUnitRepresentative_mk q k u]
  apply AdjoinRoot.mk_eq_mk.mpr
  have hprod := T.1.2
  change modulusProduct q k ∣
    T.1.1.product - progressionUnitRepresentative q k u at hprod
  have hprodEq : T.1.1.product =
      (p.1 : Polynomial (ZMod q)) ^ 3 := by
    unfold OrderedPrimeTriple.product
    rw [← T.2.1, ← T.2.2.1]
    simp only [p, pow_three]
    ring
  rw [hprodEq] at hprod
  exact hprod

/-- Since a degree-`2r` polynomial is shorter than the modulus, the
diagonal-to-cube-root map is injective. -/
theorem diagonalPrimeToCubeRoot_injective (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) (hrk : 2 * r < k ^ 2) :
    Function.Injective (diagonalPrimeToCubeRoot q k r u) := by
  intro T V h
  have hunit : primePolynomialProgressionUnit q k r T.1.1.first =
      primePolynomialProgressionUnit q k r V.1.1.first := by
    have h' := congrArg Subtype.val h
    change primePolynomialProgressionUnit q k r T.1.1.first =
      primePolynomialProgressionUnit q k r V.1.1.first at h'
    exact h'
  have hquot := congrArg (fun z : (ProgressionQuotient q k)ˣ =>
      (z : ProgressionQuotient q k)) hunit
  rw [primePolynomialProgressionUnit_val,
    primePolynomialProgressionUnit_val] at hquot
  have hdvd : modulusProduct q k ∣
      (T.1.1.first : Polynomial (ZMod q)) - V.1.1.first :=
    AdjoinRoot.mk_eq_mk.mp hquot
  have hdeg : ((T.1.1.first : Polynomial (ZMod q)) - V.1.1.first).natDegree <
      (modulusProduct q k).natDegree := by
    rw [modulusProduct_natDegree]
    exact (Polynomial.natDegree_sub_le _ _).trans_lt (by
      simp only [PrimePolynomials.natDegree, max_self, hrk])
  have hpval : (T.1.1.first : Polynomial (ZMod q)) = V.1.1.first :=
    eq_of_dvd_sub_of_natDegree_lt hdvd hdeg
  have hp : T.1.1.first = V.1.1.first := Subtype.ext hpval
  apply Subtype.ext
  apply Subtype.ext
  apply orderedPrimeTriple_tuple_injective q r
  exact Prod.ext hp (Prod.ext (T.2.1.symm.trans (hp.trans V.2.1))
    (T.2.2.1.symm.trans (hp.trans V.2.2.1)))

/-- The diagonal progression stratum has the elementary CRT bound `3^k`. -/
theorem card_congruentDiagonal_le_cubeRoots (k r : ℕ)
    (u : (ProgressionQuotient q k)ˣ) (hrk : 2 * r < k ^ 2) :
    Fintype.card
        (CongruentOrderedPrimeTripleDiagonal q k r
          (progressionUnitRepresentative q k u)) ≤ 3 ^ k := by
  calc
    Fintype.card
        (CongruentOrderedPrimeTripleDiagonal q k r
          (progressionUnitRepresentative q k u)) ≤
        Nat.card {x : (ProgressionQuotient q k)ˣ // x ^ 3 = u} := by
      rw [Nat.card_eq_fintype_card]
      exact Fintype.card_le_of_injective (diagonalPrimeToCubeRoot q k r u)
        (diagonalPrimeToCubeRoot_injective q k r u hrk)
    _ ≤ 3 ^ k := natCard_progressionUnit_cubeRoots_le q k u

theorem three_pow_le_two_pow_sq_add_one (k : ℕ) :
    3 ^ k ≤ 2 ^ (k ^ 2 + 1) := by
  calc
    3 ^ k ≤ 4 ^ k := Nat.pow_le_pow_left (by omega) k
    _ = 2 ^ (2 * k) := by rw [show 4 = 2 ^ 2 by norm_num, pow_mul]
    _ ≤ 2 ^ (k ^ 2 + 1) := Nat.pow_le_pow_right (by omega) (by nlinarith)

theorem two_pow_succ_le_sawinLemma914EqualDegreeError (d m : ℕ) :
    2 ^ (m + 1) ≤ sawinLemma914EqualDegreeError q d m := by
  have hchoose₁ : 0 < Nat.choose (3 * d) d := Nat.choose_pos (by omega)
  have hchoose₂ : 0 < Nat.choose (2 * d) d := Nat.choose_pos (by omega)
  have hM : 1 ≤ equalDegreeMultinomial d := by
    unfold equalDegreeMultinomial
    exact (Nat.one_le_iff_ne_zero).2
      (Nat.ne_of_gt (Nat.mul_pos hchoose₁ hchoose₂))
  unfold sawinLemma914EqualDegreeError
  calc
    2 ^ (m + 1) = 2 ^ (m + 1) * 1 * 1 * 1 := by ring
    _ ≤ 2 ^ (m + 1) * equalDegreeMultinomial d *
          2 ^ (28 * (3 * d - m)) * q ^ ((3 * d + 2 - m) / 2) := by
      gcongr
      · exact Nat.one_le_pow _ 2 (by omega)
      · exact Nat.one_le_pow _ q (Fact.out : q.Prime).pos

/-- In the canonical degree range, the centered full-diagonal mass costs
only two sixths of the published error envelope. -/
theorem canonical_unitDiagonal_centered_le (k : ℕ) (hk : 1000 ≤ k)
    (u : (ProgressionQuotient q k)ˣ) :
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    ‖unitOrderedPrimeTripleDiagonalWeight q k r u -
        (∑ v, unitOrderedPrimeTripleDiagonalWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      ((2 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := by
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  have hrk : 2 * r < k ^ 2 := by
    have hfour := Construction.four_mul_canonicalDegreeIndex_lt_sq
      (by omega : 4 ≤ k)
    dsimp only [r]
    omega
  have hpoint : ∀ v : (ProgressionQuotient q k)ˣ,
      ‖unitOrderedPrimeTripleDiagonalWeight q k r v‖ ≤
        (((2 * r) ^ 3 * 3 ^ k : ℕ) : ℝ) := by
    intro v
    unfold unitOrderedPrimeTripleDiagonalWeight
    simp only [norm_natCast]
    exact_mod_cast Nat.mul_le_mul_left ((2 * r) ^ 3)
      (card_congruentDiagonal_le_cubeRoots q k r v hrk)
  have hcenter := norm_sub_fintype_average_le_two_mul
    (unitOrderedPrimeTripleDiagonalWeight q k r)
    ((((2 * r) ^ 3 * 3 ^ k : ℕ) : ℝ)) hpoint u
  have hthree : 3 ^ k ≤ sawinLemma914EqualDegreeError q d (k ^ 2) := by
    exact (three_pow_le_two_pow_sq_add_one k).trans
      (two_pow_succ_le_sawinLemma914EqualDegreeError q d (k ^ 2))
  calc
    ‖unitOrderedPrimeTripleDiagonalWeight q k r u -
        (∑ v, unitOrderedPrimeTripleDiagonalWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
        2 * ((((2 * r) ^ 3 * 3 ^ k : ℕ) : ℝ)) := hcenter
    _ ≤ ((2 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := by
      have hd : d = 2 * r := rfl
      rw [hd] at hthree ⊢
      exact_mod_cast (show 2 * ((2 * r) ^ 3 * 3 ^ k) ≤
          2 * (2 * r) ^ 3 * sawinLemma914EqualDegreeError q (2 * r) (k ^ 2) by
        have h := Nat.mul_le_mul_left 2
          (Nat.mul_le_mul_left ((2 * r) ^ 3) hthree)
        simpa only [mul_assoc] using h)

/-- The literal progression strata form a `ThreeFactorSieveFamily`; its
pointwise identity is exactly the already-proved three-factor
inclusion--exclusion formula, multiplied by the common von-Mangoldt weight. -/
noncomputable def unitOrderedPrimeTripleSieveFamily (k r : ℕ) :
    ThreeFactorSieveFamily ((ProgressionQuotient q k)ˣ) where
  distinct := unitDistinctOrderedPrimeTripleWeight q k r
  all := unitAllOrderedPrimeTripleWeight q k r
  equal12 := unitOrderedPrimeTripleEqual12Weight q k r
  equal13 := unitOrderedPrimeTripleEqual13Weight q k r
  equal23 := unitOrderedPrimeTripleEqual23Weight q k r
  diagonal := unitOrderedPrimeTripleDiagonalWeight q k r
  inclusion_exclusion := by
    intro u
    simp only [unitDistinctOrderedPrimeTripleWeight,
      unitAllOrderedPrimeTripleWeight, unitOrderedPrimeTripleEqual12Weight,
      unitOrderedPrimeTripleEqual13Weight,
      unitOrderedPrimeTripleEqual23Weight,
      unitOrderedPrimeTripleDiagonalWeight]
    norm_cast
    calc
      (2 * r) ^ 3 * Fintype.card
          (CongruentDistinctOrderedPrimeTriple q k r
            (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleEqual12 q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleEqual13 q k r
              (progressionUnitRepresentative q k u)) +
          (2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleEqual23 q k r
              (progressionUnitRepresentative q k u)) =
        (2 * r) ^ 3 *
          (Fintype.card (CongruentDistinctOrderedPrimeTriple q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleEqual12 q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleEqual13 q k r
              (progressionUnitRepresentative q k u)) +
            Fintype.card (CongruentOrderedPrimeTripleEqual23 q k r
              (progressionUnitRepresentative q k u))) := by ring
      _ = (2 * r) ^ 3 *
          (Fintype.card (CongruentAllOrderedPrimeTriple q k r
              (progressionUnitRepresentative q k u)) +
            2 * Fintype.card (CongruentOrderedPrimeTripleDiagonal q k r
              (progressionUnitRepresentative q k u))) :=
        congruentOrderedPrimeTriple_weighted_inclusion_exclusion q k r _
      _ = (2 * r) ^ 3 * Fintype.card
            (CongruentAllOrderedPrimeTriple q k r
              (progressionUnitRepresentative q k u)) +
          2 * ((2 * r) ^ 3 * Fintype.card
            (CongruentOrderedPrimeTripleDiagonal q k r
              (progressionUnitRepresentative q k u))) := by ring

/-- Replacing an admissible polynomial residue by the fixed representative
of its unit class does not change its literal progression mass. -/
theorem unitProgressionEqualDegreeDistinctThreePrimeWeightSum_progressionUnit
    (k r : ℕ) (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) :
    unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r
        (progressionUnit q k a ha) =
      progressionEqualDegreeDistinctThreePrimeWeightSum q k r a := by
  unfold unitProgressionEqualDegreeDistinctThreePrimeWeightSum
    progressionEqualDegreeDistinctThreePrimeWeightSum
  have hclass :
      AdjoinRoot.mk (modulusProduct q k)
          (progressionUnitRepresentative q k (progressionUnit q k a ha)) =
        AdjoinRoot.mk (modulusProduct q k) a := by
    calc
      AdjoinRoot.mk (modulusProduct q k)
          (progressionUnitRepresentative q k (progressionUnit q k a ha)) =
          ((progressionUnit q k a ha : (ProgressionQuotient q k)ˣ) :
            ProgressionQuotient q k) :=
        progressionUnitRepresentative_mk q k _
      _ = AdjoinRoot.mk (modulusProduct q k) a :=
        progressionUnit_val q k a ha
  exact sum_monicProgression_congruent q k (6 * r)
    (progressionUnitRepresentative q k (progressionUnit q k a ha)) a
    (AdjoinRoot.mk_eq_mk.mp hclass)
    (equalDegreeDistinctThreePrimeWeight q r)

/-- Exact global partition identity for the source factorization function:
the coprime mass is the sum of the local masses over all invertible residue
classes. -/
theorem sum_unitProgressionEqualDegreeDistinctThreePrimeWeightSum (k r : ℕ) :
    (∑ u : (ProgressionQuotient q k)ˣ,
      unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r u) =
      coprimeEqualDegreeDistinctThreePrimeWeightSum q k r := by
  rw [coprimeEqualDegreeDistinctThreePrimeWeightSum_eq_subtype]
  exact (sum_coprimeMonic_eq_sum_unitProgressions q k (6 * r)
    (equalDegreeDistinctThreePrimeWeight q r)).symm

/-- The arithmetic mean of the local unit-indexed progression masses is
literally the coprime global mass divided by the Euler totient. -/
theorem average_unitProgressionEqualDegreeDistinctThreePrimeWeightSum
    (k r : ℕ) :
    (∑ u : (ProgressionQuotient q k)ˣ,
        (unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r u : ℂ)) /
        (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
      (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
        (progressionTotient q k : ℂ) := by
  have hcard : Fintype.card (ProgressionQuotient q k)ˣ =
      progressionTotient q k := by
    rw [← Nat.card_eq_fintype_card,
      ← progressionTotient_eq_modulusQuotient_units_natCard]
  rw [hcard]
  congr 1
  norm_cast
  exact sum_unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r

theorem progressionEqualDegreeDistinctThreePrimeWeightSum_eq_affine
    (k r : ℕ) (a : Polynomial (ZMod q))
    (ha : a.natDegree < k ^ 2) (hkm : k ^ 2 ≤ 6 * r) :
    progressionEqualDegreeDistinctThreePrimeWeightSum q k r a =
      ∑ P : MonicOfDegree q (6 * r - k ^ 2),
        equalDegreeDistinctThreePrimeWeight q r
          (a + modulusProduct q k * (P : Polynomial (ZMod q))) := by
  exact sum_monicProgression_eq_affine q k (6 * r) a ha hkm
    (equalDegreeDistinctThreePrimeWeight q r)

/-- In the admissible degree range, the distinct stratum of the concrete
three-factor sieve is literally the source factorization-function mass in
the corresponding progression.  This closes the ordered/unordered and
chosen-representative normalization at the level of each unit class. -/
theorem unitDistinctOrderedPrimeTripleWeight_eq_unitProgression
    (k r : ℕ) (u : (ProgressionQuotient q k)ˣ)
    (hk : 0 < k) (hkm : k ^ 2 ≤ 6 * r) :
    unitDistinctOrderedPrimeTripleWeight q k r u =
      (unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r u : ℂ) := by
  let a := progressionUnitRepresentative q k u
  let b := normalizedResidue q k a
  have hb0 : b.natDegree < k ^ 2 :=
    normalizedResidue_natDegree_lt q k hk a
  have hb : b.natDegree < 6 * r := hb0.trans_le hkm
  have hprog :
      progressionEqualDegreeDistinctThreePrimeWeightSum q k r a =
        ∑ P : MonicOfDegree q (6 * r - k ^ 2),
          shortIntervalThreePrimeWeight q k r b P := by
    calc
      progressionEqualDegreeDistinctThreePrimeWeightSum q k r a =
          progressionEqualDegreeDistinctThreePrimeWeightSum q k r b := by
        unfold progressionEqualDegreeDistinctThreePrimeWeightSum
        exact (sum_monicProgression_normalizedResidue q k (6 * r) a
          (equalDegreeDistinctThreePrimeWeight q r)).symm
      _ = ∑ P : MonicOfDegree q (6 * r - k ^ 2),
          equalDegreeDistinctThreePrimeWeight q r
            (b + modulusProduct q k * (P : Polynomial (ZMod q))) :=
        progressionEqualDegreeDistinctThreePrimeWeightSum_eq_affine
          q k r b hb0 hkm
      _ = ∑ P : MonicOfDegree q (6 * r - k ^ 2),
          shortIntervalThreePrimeWeight q k r b P :=
        (sum_shortIntervalThreePrimeWeight_eq_factorizationWeight
          q k r b).symm
  have hordered :
      (∑ P : MonicOfDegree q (6 * r - k ^ 2),
          shortIntervalThreePrimeWeight q k r b P) =
        ∑ T : CongruentPrimeTripleOrdering q k r b,
          primeTripleOrderingWeight r :=
    sum_shortIntervalThreePrimeWeight_eq_orderedProgression
      q k r b hb hkm
  have hcard :
      Fintype.card (CongruentDistinctOrderedPrimeTriple q k r a) =
        Fintype.card (CongruentPrimeTripleOrdering q k r b) := by
    rw [card_congruentDistinctOrderedPrimeTriple_eq_ordering,
      congruentPrimeTripleOrdering_card,
      congruentPrimeTripleOrdering_card,
      congruentPrimeTriples_normalizedResidue]
  rw [unitDistinctOrderedPrimeTripleWeight,
    unitProgressionEqualDegreeDistinctThreePrimeWeightSum, hprog, hordered]
  norm_cast
  change (2 * r) ^ 3 *
      Fintype.card (CongruentDistinctOrderedPrimeTriple q k r a) =
    ∑ _T : CongruentPrimeTripleOrdering q k r b,
      primeTripleOrderingWeight r
  calc
    (2 * r) ^ 3 *
        Fintype.card (CongruentDistinctOrderedPrimeTriple q k r a) =
      (2 * r) ^ 3 *
        Fintype.card (CongruentPrimeTripleOrdering q k r b) := by rw [hcard]
    _ = ∑ _T : CongruentPrimeTripleOrdering q k r b,
        primeTripleOrderingWeight r := by
      simp [primeTripleOrderingWeight, Nat.mul_comm]

/-- Sawin's specialization in its literal arithmetic-progression form: the
global coprime mass and the progression mass over all monic polynomials are
compared after multiplication by the exact Euler totient. -/
def HasSawinLemma914ProgressionFactorizationDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r)
          (progressionTotient q k *
            progressionEqualDegreeDistinctThreePrimeWeightSum q k r
              (normalizedResidue q k a)) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- Sawin's progression estimate with the original representative `a`,
before replacing it by the canonical remainder.  This is the closest direct
translation of the notation `f \equiv a (mod g)` in Theorem 1.7: the fiber
itself, rather than a chosen quotient parametrization, is the summation
domain. -/
def HasSawinLemma914OriginalProgressionFactorizationDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r)
          (progressionTotient q k *
            progressionEqualDegreeDistinctThreePrimeWeightSum q k r a) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- Theorem 1.7 in its published average-value normalization.  The
progression sum is compared to the global coprime sum divided by the exact
Euler totient; its right side is the specialized representation constant
times the square-root scale. -/
def HasSawinTheorem17AverageFactorizationDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      |(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℝ) -
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℝ) /
            (progressionTotient q k : ℝ)| ≤
        (W * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ)

/-- The exact centered estimate left after applying the three-block
inclusion--exclusion formula in Lemma 9.12.  Unlike the final distinct-prime
bound, its left side displays separately the unsieved term, the three pair
diagonals, and the full diagonal. -/
def HasSawinLemma914SieveStrataAverageBounds : Prop :=
  ∀ k : ℕ, 1000 ≤ k →
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    let data := unitOrderedPrimeTripleSieveFamily q k r
    ∀ u : (ProgressionQuotient q k)ˣ,
      ‖data.all u - (∑ v, data.all v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        2 * ‖data.diagonal u - (∑ v, data.diagonal v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.equal12 u - (∑ v, data.equal12 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.equal13 u - (∑ v, data.equal13 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.equal23 u - (∑ v, data.equal23 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      ((6 * d ^ 3 *
        sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ)

/-- The same Lemma 9.12 input in its disjoint, source-indexed partition
form.  Each proper pair term corresponds to a two-element block and the
