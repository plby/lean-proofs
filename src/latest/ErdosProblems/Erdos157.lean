structure CanonicalProgressionLargeYoungTraceData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  mainTrace : (Fin 3 → Equiv.Perm (Fin (2 * r))) → ℚ_[ell]
  range_trace : ∀ u pi,
    FrobeniusRepresentationFamily.alternatingTwistedTrace
      (progressionCanonicalLargeYoungRangeFamily
        q k r ell topDegree hk hkm finite u) pi = mainTrace pi
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ ((progressionCanonicalLargeYoungKerCoordinateFamily
      q k r ell topDegree hk hkm finite u degree).frobeniusRealizationMatrix
        sigma).charpoly.roots → ‖z‖ ≤ radius
  ambientRankBudget : ℕ
  reduced_rank_bound : ∀ u,
    (∑ degree : Fin (topDegree + 1),
      (progressionCanonicalLargeYoungKerCoordinateFamily
        q k r ell topDegree hk hkm finite u degree).rank) ≤
      ambientRankBudget
  weighted_rank_bound :
    exteriorWeightedDegreeSum (2 * r) ^ 3 * ambientRankBudget ≤ rankBudget

namespace CanonicalProgressionLargeYoungTraceData

noncomputable def reduced_lefschetz
    {q k r ell : ℕ} [Fact q.Prime] [Fact ell.Prime]
    {hk : 1 ≤ k} {hkm : k ^ 2 ≤ 3 * (2 * r)}
    {sigma : ℚ_[ell] →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    (data : CanonicalProgressionLargeYoungTraceData
      q k r ell hk hkm sigma radius rankBudget)
    (u : (ProgressionQuotient q k)ˣ)
    (pi : Fin 3 → Equiv.Perm (Fin (2 * r))) :
    FrobeniusRepresentationFamily.alternatingTwistedTrace
        (progressionCanonicalLargeYoungKerCoordinateFamily
          q k r ell data.topDegree hk hkm data.finite u) pi =
      progressionFullDistinctThreeBlockPointTrace
          q k r ell hk hkm u pi - data.mainTrace pi := by
  let raw := progressionCanonicalFrobeniusFamily
    q k r ell data.topDegree hk hkm data.finite u
  let range := progressionCanonicalLargeYoungRangeFamily
    q k r ell data.topDegree hk hkm data.finite u
  let ker := progressionCanonicalLargeYoungKerFamily
    q k r ell data.topDegree hk hkm data.finite u
  have hsplit :
      FrobeniusRepresentationFamily.alternatingTwistedTrace
          (fun degree => (range degree).prod (ker degree)) pi =
        FrobeniusRepresentationFamily.alternatingTwistedTrace raw pi := by
    apply FrobeniusRepresentationFamily.alternatingTwistedTrace_eq_of_equiv
    intro degree
    exact (progressionCanonicalFullFrobeniusFamily
      q k r ell data.topDegree hk hkm data.finite u degree).restrictedIsotypicEquivRangeProdKer
        (threeBlockPermutationFamilyHom (2 * r))
        (progressionCanonicalLargeYoungSelection
          q k r ell data.topDegree hk hkm data.finite u degree)
  rw [FrobeniusRepresentationFamily.alternatingTwistedTrace_prod] at hsplit
  have hraw : FrobeniusRepresentationFamily.alternatingTwistedTrace raw pi =
      progressionFullDistinctThreeBlockPointTrace
        q k r ell hk hkm u pi :=
    progressionCanonicalFrobeniusFamily_lefschetz_of_normalizedGL
      q k r ell data.topDegree hk hkm data.finite
        data.normalized_lefschetz u pi
  have hrange :
      FrobeniusRepresentationFamily.alternatingTwistedTrace range pi =
        data.mainTrace pi := data.range_trace u pi
  have hker :
      FrobeniusRepresentationFamily.alternatingTwistedTrace ker pi =
        progressionFullDistinctThreeBlockPointTrace
          q k r ell hk hkm u pi - data.mainTrace pi := by
    rw [hraw, hrange] at hsplit
    exact eq_sub_of_add_eq' hsplit
  rw [FrobeniusRepresentationFamily.alternatingTwistedTrace_eq_of_equiv
    (progressionCanonicalLargeYoungKerFamily
      q k r ell data.topDegree hk hkm data.finite u)
    (progressionCanonicalLargeYoungKerCoordinateFamily
      q k r ell data.topDegree hk hkm data.finite u)
    (fun degree => (progressionCanonicalLargeYoungKerFamily
      q k r ell data.topDegree hk hkm data.finite u degree).coordinateEquiv)
    pi]
  exact hker

end CanonicalProgressionLargeYoungTraceData

namespace CanonicalProgressionLargeYoungTraceData

noncomputable def reducedVirtualCharacterCohomologyData
    {q k r ell : ℕ} [Fact q.Prime] [Fact ell.Prime]
    {hk : 1 ≤ k} {hkm : k ^ 2 ≤ 3 * (2 * r)}
    {sigma : ℚ_[ell] →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    (data : CanonicalProgressionLargeYoungTraceData
      q k r ell hk hkm sigma radius rankBudget)
    (u : (ProgressionQuotient q k)ˣ) :
    ThreeBlockVirtualCharacterCohomologyData.{0}
      ℚ_[ell] data.topDegree (2 * r)
      (fun pi => progressionFullDistinctThreeBlockPointTrace
        q k r ell hk hkm u pi - data.mainTrace pi)
      sigma radius rankBudget := by
  apply ThreeBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    data.topDegree (2 * r)
    (fun pi => progressionFullDistinctThreeBlockPointTrace
      q k r ell hk hkm u pi - data.mainTrace pi)
    sigma radius rankBudget
    (fun a b c =>
      (2 * r).choose a * ((2 * r).choose b * (2 * r).choose c) *
        data.ambientRankBudget)
    (progressionCanonicalLargeYoungKerCoordinateFamily
      q k r ell data.topDegree hk hkm data.finite u)
  · exact data.reduced_lefschetz u
  · intro degree z hz
    exact data.reduced_root_bound u degree z hz
  · intro a b c
    have h := FrobeniusRepresentationFamily.sum_characterInvariantRank_le_mul_finrank
      (progressionCanonicalLargeYoungKerCoordinateFamily
        q k r ell data.topDegree hk hkm data.finite u)
      (threeBlockExteriorFreeRepresentation ℚ_[ell] (2 * r)
        (a : ℕ) (b : ℕ) (c : ℕ)).dual (by
          exact data.reduced_rank_bound u)
    rw [Subspace.dual_finrank_eq,
      threeBlockExteriorFreeRepresentation_finrank] at h
    exact h
  · rw [threeBlock_weighted_finrank_sum]
    exact data.weighted_rank_bound

end CanonicalProgressionLargeYoungTraceData

def HasCanonicalProgressionLargeYoungTraceCohomology
    (q : ℕ) [Fact q.Prime] : Prop :=
  ∀ k : ℕ, ∀ hk : 1000 ≤ k,
