      properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix_trace,
      lower, upper] using hc
  · exact data.lower_root_bound
  · exact data.upper_root_bound

/-- The semilinear geometric three-cycle fixed locus has exactly the source
ordered-distinct progression mass divided by the common root-ordering
weight. -/
theorem fullResidueUnitFiberDistinctGeometricCycleFixedPoint_card_eq_progression
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (SawinSpecialization.ProgressionQuotient q k)ˣ) :
    Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
      q (3 * (2 * r)) (k ^ 2)
      (modulusProduct q k)
      (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u)
      (threeBlockCyclePermutation (2 * r))) =
      (2 * r) ^ 3 * Nat.card
        (CongruentDistinctOrderedPrimeTriple q k r
          (SawinSpecialization.progressionUnitRepresentative q k u)) := by
  open SawinSpecialization in
  rw [← Nat.card_congr
    (fullResidueUnitFiberDistinctGeometricTwistedFixedPointEquiv
      q (3 * (2 * r)) (k ^ 2)
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u)
      (threeBlockCyclePermutation (2 * r)))]
  rw [threeBlockDistinctFixedPoint_card_eq_triple_card
    q (2 * r) (k ^ 2) (by omega) (AlgebraicClosure (ZMod q))
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u)]
  rw [progressionResidueUnitPoint_polynomial q k hk u]
  rw [← congruentDistinctOrderedPrimeTriple_natCard_eq_irreducible q k r
    (progressionUnitRepresentative q k u)]

/-- The two-cycle semilinear geometric fixed locus is exactly the source
proper-pair progression mass divided by its common root-ordering weight. -/
theorem properPairResidueFiberDistinctGeometricCycleFixedPoint_card_eq_progression
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r)
    (u : (SawinSpecialization.ProgressionQuotient q k)ˣ) :
    Nat.card (ProperPairResidueFiberDistinctGeometricTwistedFixedPoint
      q (2 * r) (k ^ 2)
      (modulusProduct q k)
      (SawinSpecialization.progressionUnitRepresentative q k u %ₘ
        modulusProduct q k)
      (modulusProduct_monic q k)
      ![finRotate (2 * r), finRotate (2 * r)]) =
      (2 * r) ^ 2 * Nat.card {x : ProperPrimePair q r //
        SawinSpecialization.properPrimePairProgressionUnit q k r x = u} := by
  open SawinSpecialization in
  rw [← Nat.card_congr
    (properPairResidueFiberDistinctGeometricTwistedFixedPointEquiv
      q (2 * r) (k ^ 2)
      (modulusProduct q k)
      (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
      (modulusProduct_monic q k)
      ![finRotate (2 * r), finRotate (2 * r)])]
  rw [properPairResidueFiberDistinctFixedPoint_natCard_eq
    q (2 * r) (k ^ 2) (AlgebraicClosure (ZMod q))
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
    (by
      simpa only [normalizedResidue] using
        normalizedResidue_natDegree_lt q k hk
          (progressionUnitRepresentative q k u))
    (finRotate (2 * r)) (finRotate (2 * r))]
  rw [properPairTwistedTupleCount_finRotate_eq_cycle
    q (2 * r) (by omega) (AlgebraicClosure (ZMod q))]
  rw [twoBlockCycleTuple_card_eq_pair_card
    q (2 * r) (by omega) (AlgebraicClosure (ZMod q))
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)]
  rw [congruentIrreducibleProperPair_natCard_eq_fiber q k r u]

end Erdos157.SawinGeometry

namespace Erdos157.SawinGeometry

open Polynomial
open PolynomialInfrastructure PrimePolynomials RepresentationFamilies

/-- Ordered monic irreducible triples satisfying a residue congruence, with
no distinctness or pairwise-coprimality condition between the three factors. -/
structure CongruentOrderedIrreducibleTriple
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q)) where
  factor : Fin 3 → Polynomial.MonicDegreeEq (ZMod q) d
  product_mod : (∏ b : Fin 3, (factor b).1) %ₘ g = t
  irreducible : ∀ b : Fin 3, Irreducible (factor b).1

namespace CongruentOrderedIrreducibleTriple

@[ext]
theorem ext
    {q d : ℕ} [Fact q.Prime] {g t : Polynomial (ZMod q)}
    {x y : CongruentOrderedIrreducibleTriple q d g t}
    (h : x.factor = y.factor) : x = y := by
  cases x
  cases y
  cases h
  rfl

end CongruentOrderedIrreducibleTriple

/-- Within-block distinctness is sufficient for irreducibility of the
factor descended from that Frobenius block. -/
theorem threeBlockDescendedFactor_irreducible_of_block_injective
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3)
    (hblock : Function.Injective (threeBlockFixedBlock q d F x b).1) :
    Irreducible (threeBlockDescendedFactor q d F x b) := by
  apply irreducible_of_distinct_frobenius_orbit q d F
    ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩)
  · exact hd
  · exact threeBlockDescendedFactor_monic q d F x b
  · exact threeBlockDescendedFactor_natDegree q d F x b
  · exact threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd F x b
  · intro i j hij
    apply hblock
    have hi := threeBlockFixedBlock_eq_frobenius_iterate q d hd F x b i
    have hj := threeBlockFixedBlock_eq_frobenius_iterate q d hd F x b j
    exact hi.trans (hij.trans hj.symm)

/-- Fixed tuples whose coordinates are distinct separately in each of the
three Frobenius blocks. Coordinates belonging to different blocks may agree. -/
abbrev ThreeBlockBlockwiseInjectiveFixedTupleData
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :=
  {x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d) //
    ∀ b : Fin 3,
      Function.Injective
        (threeBlockFixedBlock q d F ⟨x.coords, x.twisted_fixed⟩ b).1}

/-- The unrestricted ordered irreducible triple represented by a blockwise
injective fixed tuple. -/
noncomputable def threeBlockBlockwiseFixedTupleToTriple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    ThreeBlockBlockwiseInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t →
      CongruentOrderedIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t) := by
  intro x
  let xf : {z : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) z = z} :=
    ⟨x.1.coords, x.1.twisted_fixed⟩
  let factors : Fin 3 → Polynomial.MonicDegreeEq (ZMod q) d := fun b =>
    Polynomial.MonicDegreeEq.mk (threeBlockDescendedFactor q d F xf b)
      (threeBlockDescendedFactor_monic q d F xf b)
      (threeBlockDescendedFactor_natDegree q d F xf b)
  refine {
    factor := factors
    product_mod := ?_
    irreducible := ?_ }
  · rw [show (∏ b : Fin 3, (factors b).1) =
        descendedTupleRootPolynomial q (3 * d) F
          (threeBlockCyclePermutation d) xf by
      rw [descendedTupleRootPolynomial_threeBlock_factorization]
      rfl]
    exact fullResidueUnitFiberFixedTupleData_descended_mod_eq
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d) x.1
  · intro b
    exact threeBlockDescendedFactor_irreducible_of_block_injective
      q d hd F xf b (x.2 b)

theorem threeBlockBlockwiseFixedTupleToTriple_factor
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : ThreeBlockBlockwiseInjectiveFixedTupleData
      q d m F g hg hdeg hm hmn t) (b : Fin 3) :
    ((threeBlockBlockwiseFixedTupleToTriple
      q d m hd F g hg hdeg hm hmn t x).factor b).1 =
      threeBlockDescendedFactor q d F
        ⟨x.1.coords, x.1.twisted_fixed⟩ b := by
  rfl

theorem orderedIrreducibleTripleRootChoiceCoords_factor_aeval
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentOrderedIrreducibleTriple q d g t)
    (roots : ∀ b, ((T.factor b).1).rootSet F)
    (b : Fin 3) (j : Fin d) :
    Polynomial.aeval
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
          (finProdFinEquiv (b, j)))
        (T.factor b).1 = 0 := by
  have hfac := irreducible_map_eq_prod_frobeniusOrbit q d F
    (T.factor b).1 (T.factor b).monic (T.irreducible b)
    (T.factor b).natDegree (roots b)
  have hroot : ((T.factor b).1.map
      (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      ((frobeniusEquiv F q)^[j.1] (roots b).1) := by
    rw [hfac, Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := j)
    · exact Finset.mem_univ j
    · simp
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  rw [threeBlockRootChoiceCoords_apply]
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem orderedIrreducibleTripleRootChoiceCoords_avoids
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hgt : IsCoprime g t)
    (T : CongruentOrderedIrreducibleTriple q d g t)
    (roots : ∀ b, ((T.factor b).1).rootSet F) :
    ∀ i : Fin (3 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1) i) g ≠ 0 := by
  intro i hgeval
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  let z := threeBlockRootChoiceCoords q d F
    (fun b => (roots b).1) (finProdFinEquiv (b, j))
  let P := ∏ c : Fin 3, (T.factor c).1
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  have hgzero : Polynomial.aeval z g = 0 := by
    simpa [Polynomial.aeval_def, hι, z] using hgeval
  have hbzero := orderedIrreducibleTripleRootChoiceCoords_factor_aeval
    q d F g t T roots b j
  have hPzero : Polynomial.aeval z P = 0 := by
    dsimp only [P]
    rw [map_prod]
    apply Finset.prod_eq_zero (i := b)
    · exact Finset.mem_univ b
    · exact hbzero
  have hremzero : Polynomial.aeval z (P %ₘ g) = 0 := by
    have hdiv := congrArg (Polynomial.aeval z)
      (Polynomial.modByMonic_add_div P g)
    simp only [map_add, map_mul, hgzero, zero_mul, add_zero, hPzero] at hdiv
    exact hdiv
  have htzero : Polynomial.aeval z t = 0 := by
    rw [← T.product_mod]
    exact hremzero
  exact (aeval_ne_zero_of_isCoprime hgt z).elim
    (fun h => h hgzero) (fun h => h htzero)

theorem orderedIrreducibleTripleRootChoiceCoords_rootPolynomial
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentOrderedIrreducibleTriple q d g t)
    (roots : ∀ b, ((T.factor b).1).rootSet F) :
    tupleRootPolynomial (3 * d) F
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) =
      (∏ b : Fin 3, (T.factor b).1).map
        (ZMod.castHom (m := q) dvd_rfl F) := by
  classical
  have hfactor : ∀ b : Fin 3,
      (T.factor b).1.map (ZMod.castHom (m := q) dvd_rfl F) =
        ∏ j : Fin d, (Polynomial.X - Polynomial.C
          ((frobeniusEquiv F q)^[j.1] (roots b).1)) := by
    intro b
    exact irreducible_map_eq_prod_frobeniusOrbit q d F
      (T.factor b).1 (T.factor b).monic (T.irreducible b)
      (T.factor b).natDegree (roots b)
  rw [Polynomial.map_prod]
  simp_rw [hfactor]
  unfold tupleRootPolynomial
  change (∏ i : Fin (3 * d),
      (Polynomial.X - Polynomial.C
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1) i))) =
    ∏ b : Fin 3, ∏ j : Fin d,
      (Polynomial.X - Polynomial.C
        ((frobeniusEquiv F q)^[j.1] (roots b).1))
  rw [← Finset.prod_product' Finset.univ Finset.univ]
  rw [Finset.univ_product_univ]
  calc
    _ = ∏ p : Fin 3 × Fin d,
        (Polynomial.X - Polynomial.C
          (threeBlockRootChoiceCoords q d F
            (fun b => (roots b).1) (finProdFinEquiv p))) :=
      (Equiv.prod_comp (finProdFinEquiv (m := 3) (n := d))
        (fun i => Polynomial.X - Polynomial.C
          (threeBlockRootChoiceCoords q d F
            (fun b => (roots b).1) i))).symm
    _ = _ := by
      apply Finset.prod_congr rfl
      intro p _hp
      rcases p with ⟨b, j⟩
      rw [threeBlockRootChoiceCoords_apply]

theorem orderedIrreducibleTripleRootChoiceCoords_mod
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (T : CongruentOrderedIrreducibleTriple q d g t)
    (roots : ∀ b, ((T.factor b).1).rootSet F) :
    tupleRootPolynomial (3 * d) F
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) %ₘ
          g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F) := by
  rw [orderedIrreducibleTripleRootChoiceCoords_rootPolynomial
    q d F g t T roots]
  rw [← Polynomial.map_modByMonic _ hg]
  simpa using congrArg
    (Polynomial.map (ZMod.castHom (m := q) dvd_rfl F)) T.product_mod

/-- Root choices for an unrestricted ordered irreducible triple produce a
blockwise-injective fixed tuple. -/
noncomputable def threeBlockRootChoicesToBlockwiseFixedTuple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, ((T.factor b).1).rootSet F) :
    ThreeBlockBlockwiseInjectiveFixedTupleData
      q d m F g hg hdeg hm hmn t := by
  let r := residueUnitPointPolynomial q m g t
  let y := threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
  have hyavoid : ∀ i : Fin (3 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0 := by
    exact orderedIrreducibleTripleRootChoiceCoords_avoids q d F g r
      (residueUnitPointPolynomial_isCoprime q m g hg hdeg t) T roots
  have hymod : tupleRootPolynomial (3 * d) F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      r.map (ZMod.castHom (m := q) dvd_rfl F) := by
    exact orderedIrreducibleTripleRootChoiceCoords_mod
      q d F g r hg T roots
  have hytwist : twistedTupleFrobenius q (3 * d) F
      (threeBlockCyclePermutation d) y = y := by
    exact threeBlockRootChoiceCoords_twisted_fixed q d hd F
      (fun b => (T.factor b).1) T.irreducible
      (fun b => (T.factor b).natDegree) roots
  refine ⟨{
    coords := y
    avoids := hyavoid
    residue_condition := ?_
    twisted_fixed := hytwist }, ?_⟩
  · exact fullResidueUnitFiber_residue_condition_of_mod_eq
      q (3 * d) m F g hg hdeg hm hmn t y hyavoid hymod
  · intro b
    unfold threeBlockFixedBlock
    change Function.Injective
      (fun j : Fin d => y (finProdFinEquiv (b, j)))
    simpa only [y, threeBlockRootChoiceCoords_apply] using
      irreducibleRoot_frobeniusOrbit_injective q d F
        (T.factor b).1 (T.irreducible b) (T.factor b).natDegree (roots b)

theorem threeBlockRootChoicesToBlockwiseFixedTuple_factor
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, ((T.factor b).1).rootSet F)
    (b : Fin 3) :
    ((threeBlockBlockwiseFixedTupleToTriple
      q d m hd F g hg hdeg hm hmn t
      (threeBlockRootChoicesToBlockwiseFixedTuple
        q d m hd F g hg hdeg hm hmn t T roots)).factor b).1 =
      (T.factor b).1 := by
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  rw [threeBlockBlockwiseFixedTupleToTriple_factor]
  rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd]
  rw [irreducible_map_eq_prod_frobeniusOrbit q d F
    (T.factor b).1 (T.factor b).monic (T.irreducible b)
    (T.factor b).natDegree (roots b)]
  apply Finset.prod_congr rfl
  intro j _hj
  congr 3
  unfold threeBlockFixedBlock threeBlockRootChoicesToBlockwiseFixedTuple
  simp only [threeBlockRootChoiceCoords_apply, coe_frobeniusEquiv, Function.iterate_zero, id_eq]
  rw [Equiv.symm_apply_apply]

theorem threeBlockRootChoicesToBlockwiseFixedTuple_toTriple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, ((T.factor b).1).rootSet F) :
    threeBlockBlockwiseFixedTupleToTriple
      q d m hd F g hg hdeg hm hmn t
      (threeBlockRootChoicesToBlockwiseFixedTuple
        q d m hd F g hg hdeg hm hmn t T roots) = T := by
  apply CongruentOrderedIrreducibleTriple.ext
  funext b
  apply Subtype.ext
  exact threeBlockRootChoicesToBlockwiseFixedTuple_factor
    q d m hd F g hg hdeg hm hmn t T roots b

noncomputable def threeBlockBlockwiseFixedTupleFiberInitialRoots
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (x : {x : ThreeBlockBlockwiseInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockBlockwiseFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T}) :
    ∀ b : Fin 3, ((T.factor b).1).rootSet F := by
  intro b
  refine ⟨threeBlockFixedTupleInitial
    q d m hd F g hg hdeg hm hmn t x.1.1 b, ?_⟩
  rw [(T.factor b).monic.mem_rootSet]
  have hroot := threeBlockFixedTupleInitial_isRoot_descendedFactor
    q d m hd F g hg hdeg hm hmn t x.1.1 b
  rw [← threeBlockBlockwiseFixedTupleToTriple_factor
    q d m hd F g hg hdeg hm hmn t x.1 b] at hroot
  rw [x.2] at hroot
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem threeBlockBlockwiseFixedTupleFiberInitialRoots_injective
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    Function.Injective
      (threeBlockBlockwiseFixedTupleFiberInitialRoots
        q d m hd F g hg hdeg hm hmn t T) := by
  intro x y hxy
  apply Subtype.ext
  apply Subtype.ext
  apply threeBlockFixedTupleInitial_injective
    q d m hd F g hg hdeg hm hmn t
  funext b
  exact congrArg Subtype.val (congrFun hxy b)

noncomputable def threeBlockBlockwiseFixedTupleFiberEquivRoots
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    {x : ThreeBlockBlockwiseInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockBlockwiseFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} ≃
      ∀ b : Fin 3, ((T.factor b).1).rootSet F where
  toFun := threeBlockBlockwiseFixedTupleFiberInitialRoots
    q d m hd F g hg hdeg hm hmn t T
  invFun roots :=
    ⟨threeBlockRootChoicesToBlockwiseFixedTuple
      q d m hd F g hg hdeg hm hmn t T roots,
      threeBlockRootChoicesToBlockwiseFixedTuple_toTriple
        q d m hd F g hg hdeg hm hmn t T roots⟩
  left_inv x := by
    apply Subtype.ext
    apply Subtype.ext
    apply threeBlockFixedTupleInitial_injective
      q d m hd F g hg hdeg hm hmn t
    funext b
    simp [threeBlockFixedTupleInitial,
      threeBlockBlockwiseFixedTupleFiberInitialRoots,
      threeBlockRootChoicesToBlockwiseFixedTuple,
      threeBlockRootChoiceCoords]
  right_inv roots := by
    funext b
    apply Subtype.ext
    simp [threeBlockBlockwiseFixedTupleFiberInitialRoots,
      threeBlockFixedTupleInitial,
      threeBlockRootChoicesToBlockwiseFixedTuple,
      threeBlockRootChoiceCoords]
    rw [Equiv.symm_apply_apply]

theorem threeBlockBlockwiseFixedTupleToTriple_fiber_card_eq
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    Nat.card {x : ThreeBlockBlockwiseInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockBlockwiseFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} = d ^ 3 := by
  classical
  let P : Fin 3 → Type := fun b => ((T.factor b).1).rootSet F
  let (b : Fin 3) : Finite (P b) :=
    ((T.factor b).1.rootSet_finite F).to_subtype
  have hP : ∀ b, Nat.card (P b) = d := by
    intro b
    change Nat.card ((T.factor b).1.rootSet F) = d
    calc
      Nat.card ((T.factor b).1.rootSet F) =
          ((T.factor b).1.rootSet F).ncard := Nat.card_coe_set_eq _
      _ = Fintype.card ((T.factor b).1.rootSet F) :=
        (Set.fintypeCard_eq_ncard ((T.factor b).1.rootSet F)).symm
      _ = (T.factor b).1.natDegree := Polynomial.card_rootSet_eq_natDegree
        (F := ZMod q) (K := F)
        (PerfectField.separable_of_irreducible (T.irreducible b))
        (IsAlgClosed.splits _)
      _ = d := (T.factor b).natDegree
  calc
    Nat.card {x : ThreeBlockBlockwiseInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockBlockwiseFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} =
        Nat.card (∀ b, P b) := Nat.card_congr
          (threeBlockBlockwiseFixedTupleFiberEquivRoots
            q d m hd F g hg hdeg hm hmn t T)
    _ = ∏ b, Nat.card (P b) := Nat.card_pi
    _ = ∏ _ : Fin 3, d := by
      apply Finset.prod_congr rfl
      intro b _hb
      exact hP b
    _ = d ^ 3 := by simp [pow_succ]

/-- The repository's literal unsieved prime-triple type is exactly the
unrestricted irreducible triple type for the progression modulus. -/
noncomputable def congruentAllOrderedPrimeTripleEquivOrderedIrreducible
    (q k r : ℕ) [Fact q.Prime] (a : Polynomial (ZMod q)) :
    CongruentAllOrderedPrimeTriple q k r a ≃
      CongruentOrderedIrreducibleTriple q (2 * r)
        (modulusProduct q k) (a %ₘ modulusProduct q k) where
  toFun T := by
    let f₁ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.first
        (PrimePolynomials.monic T.1.first)
        (PrimePolynomials.natDegree T.1.first)
    let f₂ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.second
        (PrimePolynomials.monic T.1.second)
        (PrimePolynomials.natDegree T.1.second)
    let f₃ : Polynomial.MonicDegreeEq (ZMod q) (2 * r) :=
      Polynomial.MonicDegreeEq.mk T.1.third
        (PrimePolynomials.monic T.1.third)
        (PrimePolynomials.natDegree T.1.third)
    refine {
      factor := ![f₁, f₂, f₃]
      product_mod := ?_
      irreducible := ?_ }
    · simpa [f₁, f₂, f₃, OrderedPrimeTriple.product,
        Fin.prod_univ_succ, mul_assoc] using
        (Polynomial.modByMonic_eq_of_dvd_sub
          (modulusProduct_monic q k) T.2)
    · intro b
      fin_cases b
      · exact PrimePolynomials.irreducible T.1.first
      · exact PrimePolynomials.irreducible T.1.second
      · exact PrimePolynomials.irreducible T.1.third
  invFun x := by
    let f₁ : OfDegree q (2 * r) :=
      ⟨(x.factor 0).1, (x.factor 0).monic,
        x.irreducible 0, (x.factor 0).natDegree⟩
    let f₂ : OfDegree q (2 * r) :=
      ⟨(x.factor 1).1, (x.factor 1).monic,
        x.irreducible 1, (x.factor 1).natDegree⟩
    let f₃ : OfDegree q (2 * r) :=
      ⟨(x.factor 2).1, (x.factor 2).monic,
        x.irreducible 2, (x.factor 2).natDegree⟩
    let T : OrderedPrimeTriple q r := ⟨f₁, f₂, f₃⟩
    have hmod : T.product %ₘ modulusProduct q k =
        a %ₘ modulusProduct q k := by
      simpa [T, f₁, f₂, f₃, OrderedPrimeTriple.product,
        Fin.prod_univ_succ, mul_assoc] using x.product_mod
    refine ⟨T, ?_⟩
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd
      (modulusProduct_monic q k)]
    rw [Polynomial.sub_modByMonic]
    exact sub_eq_zero.mpr hmod
  left_inv T := by
    apply Subtype.ext
    apply orderedPrimeTriple_tuple_injective q r
    congr 1 <;> apply Subtype.ext <;> rfl
  right_inv x := by
    apply CongruentOrderedIrreducibleTriple.ext
    funext b
    fin_cases b <;> apply Subtype.ext <;> rfl

noncomputable instance finiteCongruentOrderedIrreducibleTriple_modulusProduct
    (q k r : ℕ) [Fact q.Prime] (a : Polynomial (ZMod q)) :
    Finite (CongruentOrderedIrreducibleTriple q (2 * r)
      (modulusProduct q k) (a %ₘ modulusProduct q k)) :=
  Finite.of_equiv (CongruentAllOrderedPrimeTriple q k r a)
    (congruentAllOrderedPrimeTripleEquivOrderedIrreducible q k r a)

theorem congruentAllOrderedPrimeTriple_natCard_eq_orderedIrreducible
    (q k r : ℕ) [Fact q.Prime] (a : Polynomial (ZMod q)) :
    Nat.card (CongruentAllOrderedPrimeTriple q k r a) =
      Nat.card (CongruentOrderedIrreducibleTriple q (2 * r)
        (modulusProduct q k) (a %ₘ modulusProduct q k)) :=
  Nat.card_congr
    (congruentAllOrderedPrimeTripleEquivOrderedIrreducible q k r a)

/-- Globally, the blockwise fixed locus has the expected root-ordering
multiplicity over the unrestricted ordered irreducible triples. -/
theorem threeBlockBlockwiseFixedTuple_card_eq_triple_card
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [Finite (CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))] :
    Nat.card (ThreeBlockBlockwiseInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) =
      d ^ 3 * Nat.card (CongruentOrderedIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
  classical
  let f := threeBlockBlockwiseFixedTupleToTriple
    q d m hd F g hg hdeg hm hmn t
  let : Fintype (CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) := Fintype.ofFinite _
  let (T : CongruentOrderedIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
      Finite {x // f x = T} := by
    let P : Fin 3 → Type := fun b => ((T.factor b).1).rootSet F
    let (b : Fin 3) : Finite (P b) :=
      ((T.factor b).1.rootSet_finite F).to_subtype
    exact Finite.of_equiv (∀ b, P b)
      (threeBlockBlockwiseFixedTupleFiberEquivRoots
        q d m hd F g hg hdeg hm hmn t T).symm
  calc
    Nat.card (ThreeBlockBlockwiseInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) =
        Nat.card (Σ T, {x // f x = T}) :=
      (Nat.card_congr (Equiv.sigmaFiberEquiv f)).symm
    _ = ∑ T, Nat.card {x // f x = T} := Nat.card_sigma
    _ = ∑ _ : CongruentOrderedIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t), d ^ 3 := by
      apply Finset.sum_congr rfl
      intro T _hT
      exact threeBlockBlockwiseFixedTupleToTriple_fiber_card_eq
        q d m hd F g hg hdeg hm hmn t T
    _ = d ^ 3 * Nat.card (CongruentOrderedIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
      simp [Nat.card_eq_fintype_card, Nat.mul_comm]

/-- The exact source normalization: blockwise-distinct three-cycle tuples
count every ordered progression triple, including triples with repeated
factors in different blocks. -/
theorem threeBlockBlockwiseFixedTuple_card_eq_allOrderedPrimeTriple
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (SawinSpecialization.ProgressionQuotient q k)ˣ) :
    Nat.card (ThreeBlockBlockwiseInjectiveFixedTupleData
      q (2 * r) (k ^ 2) (AlgebraicClosure (ZMod q))
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u)) =
      (2 * r) ^ 3 * Nat.card
        (CongruentAllOrderedPrimeTriple q k r
          (SawinSpecialization.progressionUnitRepresentative q k u)) := by
  let a := SawinSpecialization.progressionUnitRepresentative q k u
  have hpoly : residueUnitPointPolynomial q (k ^ 2) (modulusProduct q k)
      (progressionResidueUnitPoint q k hk u) =
      a %ₘ modulusProduct q k := by
    exact progressionResidueUnitPoint_polynomial q k hk u
  let : Finite (CongruentOrderedIrreducibleTriple q (2 * r)
      (modulusProduct q k)
      (residueUnitPointPolynomial q (k ^ 2) (modulusProduct q k)
        (progressionResidueUnitPoint q k hk u))) := by
    rw [hpoly]
    infer_instance
  rw [threeBlockBlockwiseFixedTuple_card_eq_triple_card
    q (2 * r) (k ^ 2) (by omega) (AlgebraicClosure (ZMod q))
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u)]
  rw [hpoly]
  exact congrArg ((2 * r) ^ 3 * ·)
    (congruentAllOrderedPrimeTriple_natCard_eq_orderedIrreducible
      q k r a).symm

