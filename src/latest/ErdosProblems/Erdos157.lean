      (((2 * r) ^ 2 * Nat.card {x : ProperPrimePair q r //
        properPrimePairProgressionUnit q k r x = u} : ℕ) : ℚ_[ell]) := by
  unfold normalizedWeightedAverage progressionProperPairPointTrace
  rw [properPairResidueFiberDistinctPointTrace_virtualAverage_eq
    q (2 * r) (k ^ 2) ell (by omega)
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
