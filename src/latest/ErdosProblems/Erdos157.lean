    rw [Category.assoc, invariantSubschemeMap_subschemeι,
      ← Category.assoc, invariantSubschemeMap_subschemeι,
      Category.assoc, IsIso.hom_inv_id, Category.comp_id,
      Category.id_comp]
  · apply (cancel_mono I.subschemeι).1
    rw [Category.assoc, invariantSubschemeMap_subschemeι,
