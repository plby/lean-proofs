  lower_le : lowerDegree ≤ topDegree
  upper_le : upperDegree ≤ topDegree
  degrees_ne : lowerDegree ≠ upperDegree
  concentration :
    letI := finite
    ∀ degree ≤ topDegree, degree ≠ lowerDegree → degree ≠ upperDegree →
      properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
        q d m ℓ degree g t hg π = 0
  lower_root_bound :
    letI := finite lowerDegree
    ∀ z, z ∈ (properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
      q d m ℓ lowerDegree g t hg π σ).charpoly.roots →
      ‖z‖ ≤ radius
  upper_root_bound :
    letI := finite upperDegree
    ∀ z, z ∈ (properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
      q d m ℓ upperDegree g t hg π σ).charpoly.roots →
      ‖z‖ ≤ radius

/-- The canonical proper-pair geometric data produce the exact signed
two-degree matrix certificate, with no change of trace or spectrum. -/
noncomputable def ProperPairDistinctCanonicalTwoDegreeGeometricData.toMatrices
    {q d m ℓ topDegree lowerDegree upperDegree : ℕ}
    [Fact q.Prime] [Fact ℓ.Prime]
    {g t : Polynomial (ZMod q)} {hg : g.Monic}
    {π : Fin 2 → Equiv.Perm (Fin d)}
    {σ : ℚ_[ℓ] →+* ℂ} {radius : ℝ}
    (data : ProperPairDistinctCanonicalTwoDegreeGeometricData
      q d m ℓ topDegree lowerDegree upperDegree g t hg π σ radius) :
