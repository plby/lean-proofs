/-- Arithmetic blockwise fixed points are the semilinear geometric fixed
points governing the geometric compact-support Frobenius action. -/
noncomputable def
    fullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPointEquiv
    (q d m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          FullResidueUnitFiberBlockwiseDistinct
            (ZMod q) d m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
        q d m g hg hdeg hm hmn t = x} ≃
    {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q
            (fullResidueUnitFiberBlockwiseDistinctProjection
              q d m g hg hdeg hm hmn t) //
        y ≫ pullback.snd
          (fullResidueUnitFiberBlockwiseDistinctProjection
            q d m g hg hdeg hm hmn t)
          (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
      Scheme.ProEt.geometricRelativePointSemilinearAction
        (FullResidueUnitFiberBlockwiseDistinct
          (ZMod q) d m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberBlockwiseDistinctProjection
          q d m g hg hdeg hm hmn t)
        (fullResidueUnitFiberBlockwiseDistinctPermutation
          (ZMod q) d m g hg hdeg hm hmn t)
        (schemeToSpecZMod_hom_ext q _ _)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y} := by
  let e₀ :
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            FullResidueUnitFiberBlockwiseDistinct
              (ZMod q) d m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius
          q d m g hg hdeg hm hmn t = x} ≃
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            FullResidueUnitFiberBlockwiseDistinct
              (ZMod q) d m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberBlockwiseDistinctPermutation
              (ZMod q) d m g hg hdeg hm hmn t ≫
            schemeFrobeniusOver
              (FullResidueUnitFiberBlockwiseDistinct
                (ZMod q) d m g hg hdeg hm hmn t) q
              (fullResidueUnitFiberBlockwiseDistinctProjection
                q d m g hg hdeg hm hmn t) = x} :=
    { toFun := fun x => ⟨x.1, by
        simpa only [fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius,
          schemeFrobeniusOver_fullResidueUnitFiberBlockwiseDistinct_eq]
          using x.2⟩
      invFun := fun x => ⟨x.1, by
        simpa only [fullResidueUnitFiberBlockwiseDistinctTwistedFrobenius,
          schemeFrobeniusOver_fullResidueUnitFiberBlockwiseDistinct_eq]
          using x.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact e₀.trans
    (geometricFrobeniusTwistedFixedPointEquiv
      (FullResidueUnitFiberBlockwiseDistinct
        (ZMod q) d m g hg hdeg hm hmn t) q
      (fullResidueUnitFiberBlockwiseDistinctProjection
        q d m g hg hdeg hm hmn t)
      (fullResidueUnitFiberBlockwiseDistinctPermutation
        (ZMod q) d m g hg hdeg hm hmn t)
      (schemeToSpecZMod_hom_ext q _ _))

abbrev FullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPoint
    (q d m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :=
  {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
        Scheme.ProEt.GeometricFiber q
          (fullResidueUnitFiberBlockwiseDistinctProjection
            q d m g hg hdeg hm hmn t) //
      y ≫ pullback.snd
        (fullResidueUnitFiberBlockwiseDistinctProjection
          q d m g hg hdeg hm hmn t)
        (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
    Scheme.ProEt.geometricRelativePointSemilinearAction
      (FullResidueUnitFiberBlockwiseDistinct
        (ZMod q) d m g hg hdeg hm hmn t) q
      (fullResidueUnitFiberBlockwiseDistinctProjection
        q d m g hg hdeg hm hmn t)
      (fullResidueUnitFiberBlockwiseDistinctPermutation
        (ZMod q) d m g hg hdeg hm hmn t)
      (schemeToSpecZMod_hom_ext q _ _)
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y}

def HasBlockwiseDistinctCanonicalTwistedGeometricGrothendieckLefschetz
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ degree g hg hdeg hm hmn t)] : Prop :=
  fullResidueUnitFiberBlockwiseDistinctCanonicalTwistedAlternatingTrace
      q d m ℓ topDegree g hg hdeg hm hmn t =
    (Nat.card (FullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPoint
      q d m g hg hdeg hm hmn t) : ℚ_[ℓ])

theorem
    hasBlockwiseDistinctCanonicalTwistedGrothendieckLefschetz_iff_geometric
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberBlockwiseDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ degree g hg hdeg hm hmn t)] :
    HasBlockwiseDistinctCanonicalTwistedGrothendieckLefschetz
        q d m ℓ topDegree (AlgebraicClosure (ZMod q))
        g hg hdeg hm hmn t ↔
      HasBlockwiseDistinctCanonicalTwistedGeometricGrothendieckLefschetz
        q d m ℓ topDegree g hg hdeg hm hmn t := by
  unfold HasBlockwiseDistinctCanonicalTwistedGrothendieckLefschetz
    HasBlockwiseDistinctCanonicalTwistedGeometricGrothendieckLefschetz
  rw [Nat.card_congr
    (fullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPointEquiv
      q d m g hg hdeg hm hmn t)]

/-- The semilinear geometric fixed locus of the unsieved three-block cycle
has exactly the ordered progression mass (including repeated factors), up to
the common root-ordering weight.  This is the geometric normalization needed
for the `all` term in the inclusion--exclusion argument. -/
abbrev ProgressionBlockwiseDistinctGeometricTwistedFixedPoint
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (SawinSpecialization.ProgressionQuotient q k)ˣ) :=
  FullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPoint
    q (2 * r) (k ^ 2)
    (modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
    (Nat.pow_pos (lt_of_lt_of_le Nat.zero_lt_one hk)) hkm
    (progressionResidueUnitPoint q k hk u)

theorem
    fullResidueUnitFiberBlockwiseDistinctGeometricCycleFixedPoint_card_eq_progression
    (q k r : ℕ) [Fact q.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (SawinSpecialization.ProgressionQuotient q k)ˣ) :
    Nat.card
        (ProgressionBlockwiseDistinctGeometricTwistedFixedPoint
          q k r hk hkm u) =
      (2 * r) ^ 3 * Nat.card
        (CongruentAllOrderedPrimeTriple q k r
          (SawinSpecialization.progressionUnitRepresentative q k u)) := by
  rw [← Nat.card_congr
    (fullResidueUnitFiberBlockwiseDistinctGeometricTwistedFixedPointEquiv
      q (2 * r) (k ^ 2)
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k)
      (Nat.pow_pos (lt_of_lt_of_le Nat.zero_lt_one hk)) hkm
      (progressionResidueUnitPoint q k hk u))]
  exact fullResidueUnitFiberBlockwiseDistinctFixedPoint_card_eq_allOrdered
    q k r hk hr hkm u

end Erdos157.SawinGeometry

