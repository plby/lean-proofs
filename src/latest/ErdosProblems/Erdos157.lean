  toFun := properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    q d m ell degree g t hg
  map_one' :=
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_one
      q d m ell degree g t hg
  map_mul' π ρ :=
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
      q d m ell degree g t hg π ρ

