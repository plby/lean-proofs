      ((baseChange (inv fbar)).map
          ((equivariantBaseChangeBetween jX jY e ebar he).hom.app U)).left ≫
      ((equivariantBaseChangeBetween jY jZ f fbar hf).hom.app
          ((baseChange (inv e)).obj U)).left ≫
      ((map jZ).map ((baseChangeCompOfEq (inv f) (inv e)
        (inv (e ≫ f)) IsIso.inv_comp).inv.app U)).left ≫
      pullback.snd U.hom (inv (e ≫ f)) = _
  slice_lhs 4 5 =>
    exact baseChangeCompOfEq_inv_app_left_snd
      (inv f) (inv e) (inv (e ≫ f)) IsIso.inv_comp U
  slice_lhs 3 4 =>
    exact equivariantBaseChangeBetween_hom_app_left_snd
      jY jZ f fbar hf ((baseChange (inv e)).obj U)
  slice_lhs 2 4 =>
    exact baseChange_map_left_fst_assoc (inv fbar)
      ((equivariantBaseChangeBetween jX jY e ebar he).hom.app U)
      (((baseChange (inv e)).obj U).hom ≫ f)
