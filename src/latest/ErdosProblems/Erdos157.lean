  unfold unitOrderedPrimeTripleProper12Weight
  push_cast
  simp_rw [Nat.card_eq_fintype_card, card_properPrimePair_fiber]
  have hsum :
      (∑ v : (ProgressionQuotient q k)ˣ,
        ((2 * r : ℂ) ^ 3 *
          Fintype.card (CongruentOrderedPrimeTripleProper12 q k r
