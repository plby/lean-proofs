      (H ≫ E) ≫ (S ≫ f) = (H ≫ F) ≫ (R ≫ f) :=
    (Category.assoc H E (S ≫ f)).trans
      ((congrArg (fun k => H ≫ k) hESf).trans
        ((congrArg (fun k => H ≫ k) (Category.assoc F R f)).trans
          (Category.assoc H F (R ≫ f)).symm))
  have hcomp := baseChangeCompOfEq_hom_app_left_fst_fst
    (inv fbar) (inv ebar) (inv (ebar ≫ fbar)) IsIso.inv_comp
      ((map jX).obj U)
