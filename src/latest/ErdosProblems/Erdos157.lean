      simpa only [normalizedResidue] using
        normalizedResidue_natDegree_lt q k hk
          (progressionUnitRepresentative q k u))
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)]
  rw [congruentIrreducibleProperPair_natCard_eq_fiber q k r u]

theorem map_progressionProperPairPointTrace_centeredAverage
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (sigma : ℚ_[ell] →+* ℂ)
    (u : (ProgressionQuotient q k)ˣ) :
    sigma ((2 * r : ℚ_[ell]) *
      normalizedWeightedAverage ℚ_[ell]
        (Fin 2 → Equiv.Perm (Fin (2 * r)))
        (fun pi =>
          permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 0) *
            permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 1))
        (centeredTraceFamily ℚ_[ell]
          (Fin 2 → Equiv.Perm (Fin (2 * r)))
