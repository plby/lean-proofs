/-- The direct `S₁³` and `S₂S₁-S₃` character cancellation estimate implies
the exact two-family centered progression bound. -/
theorem hasSawinLemma914AllAndOnePairAverageBounds_of_characterCancellation
    (hchar : HasSawinLemma914AllAndOnePairCharacterCancellation q) :
    HasSawinLemma914AllAndOnePairAverageBounds q := by
  intro k hk
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  intro u
  have hchar' := hchar k hk u
  rw [← progressionUnitFiberFourierError_all_eq q k r u,
    ← progressionUnitFiberFourierError_pair_eq q k r u] at hchar'
  change
    ‖unitAllOrderedPrimeTripleWeight q k r u -
        (∑ v, unitAllOrderedPrimeTripleWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
      3 * ‖unitOrderedPrimeTripleProper12Weight q k r u -
        (∑ v, unitOrderedPrimeTripleProper12Weight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      ((4 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ)
  rw [unitAllOrderedPrimeTripleWeight_centered_eq_error_div q k r u,
    unitProper12Weight_centered_eq_error_div q k r u]
  have hφR : (0 : ℝ) < progressionTotient q k := by
    exact_mod_cast progressionTotient_pos q k
  simp only [norm_div, norm_mul, norm_natCast]
  rw [show (((2 * r) ^ 3 : ℕ) : ℝ) = (d ^ 3 : ℝ) by simp [d]]
  calc
    (d ^ 3 : ℝ) *
          ‖progressionUnitFiberFourierError q k
            (orderedPrimeTripleProgressionUnit q k r) u‖ /
          (progressionTotient q k : ℝ) +
        3 * ((d ^ 3 : ℝ) *
          ‖progressionUnitFiberFourierError q k
            (properPrimePairProgressionUnit q k r) u‖ /
          (progressionTotient q k : ℝ)) =
      (d ^ 3 : ℝ) /
          (progressionTotient q k : ℝ) *
        (‖progressionUnitFiberFourierError q k
            (orderedPrimeTripleProgressionUnit q k r) u‖ +
          3 * ‖progressionUnitFiberFourierError q k
            (properPrimePairProgressionUnit q k r) u‖) := by ring
    _ ≤ (d ^ 3 : ℝ) / (progressionTotient q k : ℝ) *
        ((progressionTotient q k *
          (4 * sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ) := by
      gcongr
    _ = ((4 * d ^ 3 *
        sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := by
      push_cast
      field_simp

/-- Conversely, the centered two-family progression estimate gives the
literal `S₁³` and `S₂S₁-S₃` character cancellation bound.  Positivity of
the common degree weight and of the quotient totient makes every
normalization reversible. -/
theorem hasSawinLemma914AllAndOnePairCharacterCancellation_of_averageBounds
    (havg : HasSawinLemma914AllAndOnePairAverageBounds q) :
    HasSawinLemma914AllAndOnePairCharacterCancellation q := by
  intro k hk
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  intro u
  have h := havg k hk u
  change
    ‖unitAllOrderedPrimeTripleWeight q k r u -
        (∑ v, unitAllOrderedPrimeTripleWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
      3 * ‖unitOrderedPrimeTripleProper12Weight q k r u -
        (∑ v, unitOrderedPrimeTripleProper12Weight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      ((4 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ)
    at h
  rw [unitAllOrderedPrimeTripleWeight_centered_eq_error_div q k r u,
    unitProper12Weight_centered_eq_error_div q k r u,
    progressionUnitFiberFourierError_all_eq q k r u,
    progressionUnitFiberFourierError_pair_eq q k r u] at h
  have hφ : (0 : ℝ) < progressionTotient q k := by
    exact_mod_cast progressionTotient_pos q k
  have hrpos : 0 < r := by
    dsimp only [r, Construction.canonicalDegreeIndex]
    omega
  have hdpos : (0 : ℝ) < d ^ 3 := by
    positivity
  simp only [norm_div, norm_mul, norm_natCast] at h
  rw [show (((2 * r) ^ 3 : ℕ) : ℝ) = (d ^ 3 : ℝ) by simp [d]] at h
  have hscaled :
      (d ^ 3 : ℝ) / (progressionTotient q k : ℝ) *
          (‖allPrimeTripleCharacterError q k r u‖ +
            3 * ‖properPrimePairCharacterError q k r u‖) ≤
        (d ^ 3 : ℝ) / (progressionTotient q k : ℝ) *
          ((progressionTotient q k *
            (4 * sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ) := by
    calc
      (d ^ 3 : ℝ) / (progressionTotient q k : ℝ) *
          (‖allPrimeTripleCharacterError q k r u‖ +
            3 * ‖properPrimePairCharacterError q k r u‖) =
        (d ^ 3 : ℝ) * ‖allPrimeTripleCharacterError q k r u‖ /
            (progressionTotient q k : ℝ) +
          3 * ((d ^ 3 : ℝ) *
            ‖properPrimePairCharacterError q k r u‖ /
              (progressionTotient q k : ℝ)) := by ring
      _ ≤ ((4 * d ^ 3 *
          sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := h
      _ = (d ^ 3 : ℝ) / (progressionTotient q k : ℝ) *
          ((progressionTotient q k *
            (4 * sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ) := by
        push_cast
        field_simp
  exact (mul_le_mul_iff_of_pos_left (div_pos hdpos hφ)).mp hscaled

