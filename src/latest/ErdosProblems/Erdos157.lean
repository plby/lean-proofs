/-! ### A concrete complex realization of `Q_ell`

The weight statements below compare algebraic Frobenius eigenvalues with
their images in `ℂ`.  A field embedding `Q_ell → ℂ` is noncanonical, but its
existence is a theorem: `Q_ell` has cardinality at most the continuum, while
a transcendence basis of `ℂ/ℚ` has cardinality exactly the continuum.  The
following construction records that choice in Lean instead of leaving an
extra embedding parameter in the final geometric package. -/

open Cardinal Set
open scoped Cardinal

theorem padic_cardinalMk_le_continuum (p : ℕ) [Fact p.Prime] :
    #(ℚ_[p]) ≤ 𝔠 := by
  calc
    #(ℚ_[p]) ≤ #(PadicSeq p) := by
      unfold Padic
      exact Cardinal.mk_quotient_le
    _ ≤ #(ℕ → ℚ) := Cardinal.mk_subtype_le _
    _ = #ℚ ^ #ℕ := by rw [Cardinal.power_def]
    _ = ℵ₀ ^ ℵ₀ := by rw [Cardinal.mkRat, Cardinal.mk_nat]
    _ = 𝔠 := Cardinal.power_aleph0_of_le_continuum
      (by norm_num) Cardinal.aleph0_le_continuum

/-- Every characteristic-zero field of cardinality at most the continuum
embeds, as an abstract field, into `ℂ`. -/
theorem exists_ringHom_to_complex_of_cardinal_le_continuum
    (K : Type) [Field K] [CharZero K]
    (hK : #K ≤ 𝔠) : Nonempty (K →+* ℂ) := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℚ K
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis ℚ ℂ
  have htcard : #t = 𝔠 := by
    have hC := IsAlgClosed.cardinal_le_max_transcendence_basis'
      ((fun x : t => (x : ℂ))) ht
    rw [Cardinal.mk_complex, Cardinal.mkRat] at hC
    have ht_le : #t ≤ 𝔠 := by
      rw [← Cardinal.mk_complex]
      exact Cardinal.mk_subtype_le t
    have hmax : max #t ℵ₀ = 𝔠 := by
      apply le_antisymm
      · exact max_le ht_le aleph0_le_continuum
      · simpa [max_assoc, max_comm, max_left_comm] using hC
    by_cases htsmall : #t ≤ ℵ₀
    · have hbad : 𝔠 ≤ ℵ₀ := by
        simpa [max_eq_right htsmall] using hmax.symm.le
      exact (not_le_of_gt aleph0_lt_continuum hbad).elim
    · have haleph : ℵ₀ ≤ #t := le_of_not_ge htsmall
      simpa [max_eq_left haleph] using hmax
  have hs_le : #s ≤ #t := by
    calc
      #s ≤ #K := Cardinal.mk_subtype_le s
      _ ≤ 𝔠 := hK
      _ = #t := htcard.symm
  obtain ⟨e⟩ := (Cardinal.le_def s t).mp hs_le
  let y : s → ℂ := fun x => (e x : t)
  have hy : AlgebraicIndependent ℚ y := by
    change AlgebraicIndependent ℚ ((fun z : t => (z : ℂ)) ∘ e)
    exact ht.1.comp e e.injective
  let baseAlg : Algebra.adjoin ℚ
      (Set.range fun x : s => (x : K)) →ₐ[ℚ] ℂ :=
    (MvPolynomial.aeval y).comp hs.1.aevalEquiv.symm.toAlgHom
  let base : Algebra.adjoin ℚ
      (Set.range fun x : s => (x : K)) →+* ℂ := baseAlg.toRingHom
  have hbase : Function.Injective base := by
    exact (algebraicIndependent_iff_injective_aeval.1 hy).comp
      hs.1.aevalEquiv.symm.injective
  let : Algebra (Algebra.adjoin ℚ
      (Set.range fun x : s => (x : K))) ℂ := base.toAlgebra
  let : Algebra.IsAlgebraic
      (Algebra.adjoin ℚ (Set.range fun x : s => (x : K))) K :=
    hs.isAlgebraic
  let : Module.IsTorsionFree
      (Algebra.adjoin ℚ (Set.range fun x : s => (x : K))) ℂ :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (by
      simpa [base, RingHom.algebraMap_toAlgebra] using hbase)
  let lift := IsAlgClosed.lift
    (R := Algebra.adjoin ℚ (Set.range fun x : s => (x : K)))
    (S := K) (M := ℂ)
  exact ⟨lift.toRingHom⟩

/-- A fixed abstract embedding `Q_p → ℂ`, used to state all subsequent
Deligne root bounds without an additional existential parameter. -/
noncomputable def padicToComplex (p : ℕ) [Fact p.Prime] : ℚ_[p] →+* ℂ :=
  Classical.choice
    (exists_ringHom_to_complex_of_cardinal_le_continuum
      ℚ_[p] (padic_cardinalMk_le_continuum p))

/-! ### The exact common-main geometric target

The raw point-trace family contains a top-cohomology contribution which is
independent of the progression unit.  We subtract that contribution before
applying the virtual Mangoldt projector.  The common term then cancels from
the centered unit average, while the remaining cohomology has precisely the
rank and Frobenius-radius budget of Sawin's Lemma 9.14. -/

noncomputable def progressionReducedThreeBlockPointTrace
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (mainTrace : (Fin 3 → Equiv.Perm (Fin (2 * r))) → ℚ_[ell])
    (u : (ProgressionQuotient q k)ˣ) :
    (Fin 3 → Equiv.Perm (Fin (2 * r))) → ℚ_[ell] :=
  fun pi => progressionFullDistinctThreeBlockPointTrace
    q k r ell hk hkm u pi - mainTrace pi

/-- Fully normalized statement of the remaining geometric theorem.  It is
indexed by the literal progression fibers and uses the fixed abstract
embedding `Q_2 → ℂ`.  The top trace is common to all fibers; the trace
identity, two-degree concentration, Deligne weights, and characteristic-cycle
bound for the reduced family are exactly the fields of
`ThreeBlockVirtualCharacterCohomologyData`. -/
def HasCommonMainThreeBlockVirtualCohomology
    (q : ℕ) [Fact q.Prime] : Prop :=
  ∀ k : ℕ, ∀ hk : 1000 ≤ k,
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    let m := k ^ 2
    let radius := sawinLemma914FrobeniusRadius q d m
    ∃ topDegree : ℕ,
      ∃ mainTrace : (Fin 3 → Equiv.Perm (Fin d)) → ℚ_[2],
        ∀ u : (ProgressionQuotient q k)ˣ,
          Nonempty (ThreeBlockVirtualCharacterCohomologyData.{0}
            ℚ_[2] topDegree d
            (progressionReducedThreeBlockPointTrace q k r 2
              (by omega) (by
                have hrange := Construction.modulus_degree_in_sawin_range
                  (by omega : 3 ≤ k)
                omega) mainTrace u)
            (padicToComplex 2) radius
            (sawinLemma914AverageTraceRank d m))

/-- The common-main nonconstant cohomology theorem implies exactly Sawin's
unit-group average estimate.  The common top trace cancels algebraically, and
the factor `2` is supplied by centering the bounded reduced traces. -/
theorem hasSawinLemma914DistinctUnitAverageBound_of_commonMainThreeBlock
    (q : ℕ) [Fact q.Prime]
    (hgeom : HasCommonMainThreeBlockVirtualCohomology q) :
    HasSawinLemma914DistinctUnitAverageBound q := by
  intro k hk
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let m := k ^ 2
  let radius := sawinLemma914FrobeniusRadius q d m
  have hr : 1 ≤ r := by
    dsimp only [r, Construction.canonicalDegreeIndex]
    omega
  have hkm : k ^ 2 ≤ 3 * (2 * r) := by
    have hrange := Construction.modulus_degree_in_sawin_range
      (by omega : 3 ≤ k)
    dsimp only [r]
    omega
  obtain ⟨topDegree, mainTrace, data⟩ := hgeom k hk
  let weight : (Fin 3 → Equiv.Perm (Fin (2 * r))) → ℚ_[2] := fun pi =>
    permutationVirtualMangoldt ℚ_[2] (Fin (2 * r)) (pi 0) *
      permutationVirtualMangoldt ℚ_[2] (Fin (2 * r)) (pi 1) *
      permutationVirtualMangoldt ℚ_[2] (Fin (2 * r)) (pi 2)
  let raw : (ProgressionQuotient q k)ˣ → ℚ_[2] := fun u =>
    normalizedWeightedAverage ℚ_[2]
      (Fin 3 → Equiv.Perm (Fin (2 * r))) weight
      (progressionFullDistinctThreeBlockPointTrace q k r 2
        (by omega) hkm u)
  let main : ℚ_[2] := normalizedWeightedAverage ℚ_[2]
    (Fin 3 → Equiv.Perm (Fin (2 * r))) weight mainTrace
  let reduced : (ProgressionQuotient q k)ˣ → ℚ_[2] := fun u =>
    normalizedWeightedAverage ℚ_[2]
      (Fin 3 → Equiv.Perm (Fin (2 * r))) weight
      (progressionReducedThreeBlockPointTrace q k r 2
        (by omega) hkm mainTrace u)
  have hreduced_eq (u : (ProgressionQuotient q k)ˣ) :
      reduced u = raw u - main := by
    dsimp only [reduced, raw, main, progressionReducedThreeBlockPointTrace]
    exact normalizedWeightedAverage_sub ℚ_[2]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
      weight
      (progressionFullDistinctThreeBlockPointTrace q k r 2
        (by omega) hkm u) mainTrace
  have hraw_eq (u : (ProgressionQuotient q k)ˣ) :
      padicToComplex 2 (raw u) =
        unitDistinctOrderedPrimeTripleWeight q k r u := by
    dsimp only [raw, weight]
    rw [progressionFullDistinctThreeBlockPointTrace_virtualAverage_eq
      q k r 2 (by omega) hr hkm]
    unfold unitDistinctOrderedPrimeTripleWeight
    exact map_natCast (padicToComplex 2) _
  have hred (u : (ProgressionQuotient q k)ˣ) :
      ‖padicToComplex 2 (reduced u)‖ ≤
        (sawinLemma914AverageTraceRank d m : ℝ) * radius := by
    obtain ⟨du⟩ := data u
    have h := du.norm_virtualAverage_le
      (by positivity : 0 ≤ (radius : ℝ))
    change ‖padicToComplex 2 (normalizedWeightedAverage ℚ_[2]
      (Fin 3 → Equiv.Perm (Fin (2 * r))) weight
      (progressionReducedThreeBlockPointTrace q k r 2
        (by omega) hkm mainTrace u))‖ ≤ _ at h
    change ‖padicToComplex 2 (reduced u)‖ ≤ _
    simpa only [d, m, radius, reduced, weight] using h
  intro u
  have hcenter := norm_sub_fintype_average_le_two_mul
    (fun v : (ProgressionQuotient q k)ˣ => padicToComplex 2 (reduced v))
    ((sawinLemma914AverageTraceRank d m : ℝ) * radius) hred u
  have hred_map (v : (ProgressionQuotient q k)ˣ) :
      padicToComplex 2 (reduced v) =
        unitDistinctOrderedPrimeTripleWeight q k r v -
          padicToComplex 2 main := by
    rw [hreduced_eq, map_sub, hraw_eq]
  simp_rw [hred_map] at hcenter
  have hcard : (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hleft :
      (unitDistinctOrderedPrimeTripleWeight q k r u - padicToComplex 2 main) -
          (∑ v : (ProgressionQuotient q k)ˣ,
              (unitDistinctOrderedPrimeTripleWeight q k r v -
                padicToComplex 2 main)) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) =
        unitDistinctOrderedPrimeTripleWeight q k r u -
          (∑ v, unitDistinctOrderedPrimeTripleWeight q k r v) /
            (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) := by
    simp only [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul,
      Finset.card_univ]
    field_simp
    ring
  rw [hleft] at hcenter
  calc
    ‖unitDistinctOrderedPrimeTripleWeight q k r u -
        (∑ v, unitDistinctOrderedPrimeTripleWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      2 * ((sawinLemma914AverageTraceRank d m : ℝ) * radius) := hcenter
    _ = 2 * (sawinLemma914AverageTraceRank d m : ℝ) *
        (sawinLemma914FrobeniusRadius q d m : ℝ) := by
      dsimp only [radius]
      ring
    _ = ((6 * d ^ 3 * sawinLemma914EqualDegreeError q d m : ℕ) : ℝ) :=
      two_mul_sawinLemma914AverageTraceRank_mul_radius q d m
    _ = ((6 * (2 * Construction.canonicalDegreeIndex k) ^ 3 *
        sawinLemma914EqualDegreeError q
          (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) : ℝ) := by
      rfl

end Erdos157.SawinGeometry

namespace Erdos157

/-- The common-main three-block cohomology package is sufficient for the
exact conclusion of Problem 157.  This is the final assembly interface used
while constructing the unconditional geometric package below. -/
theorem erdos_157_of_sawinPrime_commonMainThreeBlock
    (hgeom : SawinGeometry.HasCommonMainThreeBlockVirtualCohomology
      sawinPrime) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  apply erdos_157_of_sawinPrime_theorem17AverageFactorizationDeviation
  apply SawinSpecialization.hasSawinTheorem17Average_of_distinctUnitAverage
  exact
    SawinGeometry.hasSawinLemma914DistinctUnitAverageBound_of_commonMainThreeBlock
      sawinPrime hgeom

end Erdos157

/-! ### Direct-sum Frobenius families

The common top-cohomology contribution is split from the nonconstant
summand degree by degree.  The following product realization is the finite
linear-algebra form of that direct sum.  It preserves twisted traces by
addition, ranks by addition, and Frobenius root bounds by factorization of
the characteristic polynomial. -/

namespace Erdos157.SawinGeometry

open SawinSpecialization PolynomialInfrastructure

/- The equivalent induction--restriction formulation is recorded in the
mathematical writeup.  Lean uses the restricted-invariant characterization
below directly, avoiding a costly universe-lift conversion in `Rep`. -/
/-
namespace FrobeniusReciprocity

universe uK uH uG uX uY

variable {K : Type uK} {H : Type uH} {G : Type uG}
  {X : Type uX} {Y : Type uY} [Field K] [Group H] [Group G]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]

/-- Frobenius reciprocity stated directly for intertwining maps. -/
noncomputable def intertwiningIndResEquiv
    (φ : H →* G) (A : Representation K H X)
    (B : Representation K G Y) :
    Representation.IntertwiningMap (Representation.ind φ A) B ≃ₗ[K]
      Representation.IntertwiningMap A (B.comp φ) :=
  ((Rep.homLinearEquiv
      (Rep.ind φ (Rep.of.{max uX uY} A))
      (Rep.of.{max uX uY} B)).symm.trans
    (Rep.indResHomEquiv φ
      (Rep.of.{max uX uY} A) (Rep.of.{max uX uY} B))).trans
      (Rep.homLinearEquiv
        (Rep.of.{max uX uY} A) (Rep.res φ (Rep.of.{max uX uY} B)))

theorem intertwiningIndResEquiv_ne_zero_iff
    (φ : H →* G) (A : Representation K H X)
    (B : Representation K G Y)
    (f : Representation.IntertwiningMap (Representation.ind φ A) B) :
    intertwiningIndResEquiv φ A B f ≠ 0 ↔ f ≠ 0 := by
  exact (intertwiningIndResEquiv φ A B).map_ne_zero_iff

/-- Maps from the one-dimensional trivial representation are the invariant
vectors, with no finiteness assumption on the group. -/
def trivialIntertwiningEquivInvariants
    (A : Representation K G Y) :
    Representation.IntertwiningMap (1 : Representation K G K) A ≃ₗ[K]
      A.invariants where
  toFun f := ⟨f 1, by
    intro g
    have hf : f ((1 : Representation K G K) g 1) = A g (f 1) :=
      Representation.IntertwiningMap.isIntertwining
        (1 : Representation K G K) A f g 1
    simpa using hf.symm⟩
  invFun y :=
    { toLinearMap :=
        { toFun := fun a => a • y.1
          map_add' := fun a b => add_smul a b y.1
          map_smul' := fun a b => by simp [mul_smul] }
      isIntertwining' := fun g => by
        apply LinearMap.ext
        intro a
        change a • y.1 = A g (a • y.1)
        rw [map_smul, y.2 g] }
  left_inv f := by
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro a
    change a • f 1 = f a
    simpa using (f.map_smul a 1).symm
  right_inv y := by
    apply Subtype.ext
    simp
  map_add' f h := by
    apply Subtype.ext
    rfl
  map_smul' a f := by
    apply Subtype.ext
    rfl

theorem trivialIntertwiningEquivInvariants_ne_zero_iff
    (A : Representation K G Y)
    (f : Representation.IntertwiningMap (1 : Representation K G K) A) :
    trivialIntertwiningEquivInvariants A f ≠ 0 ↔ f ≠ 0 := by
  exact (trivialIntertwiningEquivInvariants A).map_ne_zero_iff

/-- The Young permutation-module multiplicity space is the invariant space
of the restricted representation. -/
noncomputable def inducedTrivialIntertwiningEquivInvariants
    (φ : H →* G) (B : Representation K G Y) :
    Representation.IntertwiningMap
        (Representation.ind φ (1 : Representation K H K)) B ≃ₗ[K]
      Representation.invariants (B.comp φ) :=
  (intertwiningIndResEquiv φ (1 : Representation K H K) B).trans
    (trivialIntertwiningEquivInvariants (B.comp φ))

theorem inducedTrivialIntertwiningEquivInvariants_ne_zero_iff
    (φ : H →* G) (B : Representation K G Y)
    (f : Representation.IntertwiningMap
      (Representation.ind φ (1 : Representation K H K)) B) :
    inducedTrivialIntertwiningEquivInvariants φ B f ≠ 0 ↔ f ≠ 0 := by
  exact (inducedTrivialIntertwiningEquivInvariants φ B).map_ne_zero_iff

theorem exists_nonzero_inducedTrivialIntertwining_iff
    (φ : H →* G) (B : Representation K G Y) :
    (∃ f : Representation.IntertwiningMap
        (Representation.ind φ (1 : Representation K H K)) B, f ≠ 0) ↔
      Nontrivial (Representation.invariants (B.comp φ)) := by
  constructor
  · rintro ⟨f, hf⟩
    let y := inducedTrivialIntertwiningEquivInvariants φ B f
    have hy : y ≠ 0 :=
      (inducedTrivialIntertwiningEquivInvariants_ne_zero_iff φ B f).2 hf
    exact (nontrivial_iff_exists_ne (0 :
      Representation.invariants (B.comp φ))).2 ⟨y, hy⟩
  · intro h
    haveI := h
    obtain ⟨y, hy⟩ := exists_ne (0 :
      Representation.invariants (B.comp φ))
    let f := (inducedTrivialIntertwiningEquivInvariants φ B).symm y
    refine ⟨f, ?_⟩
    intro hf
    have : y = 0 := by
      rw [← (inducedTrivialIntertwiningEquivInvariants φ B).apply_symm_apply y]
      simp [f, hf]
    exact hy this

end FrobeniusReciprocity
-/

namespace FrobeniusRepresentation

variable {K G V W : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]
    [AddCommGroup W] [Module K W]

/-- An equivariant linear equivalence that also intertwines Frobenius. -/
structure Equiv
    (A : FrobeniusRepresentation K G V)
    (B : FrobeniusRepresentation K G W) where
  linearEquiv : V ≃ₗ[K] W
  map_representation : ∀ g v,
    linearEquiv (A.representation g v) = B.representation g (linearEquiv v)
  map_frobenius : ∀ v,
    linearEquiv (A.frobenius v) = B.frobenius (linearEquiv v)

namespace Equiv

/-- Reverse a Frobenius-equivariant equivalence. -/
def symm
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    (e : Equiv A B) : Equiv B A where
  linearEquiv := e.linearEquiv.symm
  map_representation := by
    intro g w
    apply e.linearEquiv.injective
    simpa using (e.map_representation g (e.linearEquiv.symm w)).symm
  map_frobenius := by
    intro w
    apply e.linearEquiv.injective
    simpa using (e.map_frobenius (e.linearEquiv.symm w)).symm

/-- Compose Frobenius-equivariant equivalences. -/
def trans {U : Type*} [AddCommGroup U] [Module K U]
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    {C : FrobeniusRepresentation K G U}
    (e : Equiv A B) (f : Equiv B C) : Equiv A C where
  linearEquiv := e.linearEquiv.trans f.linearEquiv
  map_representation := by
    intro g v
    simp only [LinearEquiv.trans_apply, e.map_representation,
      f.map_representation]
  map_frobenius := by
    intro v
    simp only [LinearEquiv.trans_apply, e.map_frobenius,
      f.map_frobenius]

/-- Twisted traces are invariant under a Frobenius-equivariant equivalence. -/
theorem twistedTrace_eq
    [FiniteDimensional K V] [FiniteDimensional K W]
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    (e : FrobeniusRepresentation.Equiv A B) (g : G) :
    B.twistedTrace g = A.twistedTrace g := by
  unfold twistedTrace
  rw [show B.representation g * B.frobenius =
      e.linearEquiv.conj (A.representation g * A.frobenius) by
    apply LinearMap.ext
    intro w
    change B.representation g (B.frobenius w) =
      e.linearEquiv
        (A.representation g (A.frobenius (e.linearEquiv.symm w)))
    have hf : e.linearEquiv (A.frobenius (e.linearEquiv.symm w)) =
        B.frobenius w := by
      simpa using e.map_frobenius (e.linearEquiv.symm w)
    have hr := e.map_representation g
      (A.frobenius (e.linearEquiv.symm w))
    exact (hr.trans (congrArg (B.representation g) hf)).symm]
  exact LinearMap.trace_conj' _ _

/-- Frobenius characteristic polynomials are invariant under the same
equivalence. -/
theorem frobenius_charpoly_eq
    [FiniteDimensional K V] [FiniteDimensional K W]
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    (e : FrobeniusRepresentation.Equiv A B) :
    B.frobenius.charpoly = A.frobenius.charpoly := by
  rw [show B.frobenius = e.linearEquiv.conj A.frobenius by
    apply LinearMap.ext
    intro w
    change B.frobenius w =
      e.linearEquiv (A.frobenius (e.linearEquiv.symm w))
    simpa using (e.map_frobenius (e.linearEquiv.symm w)).symm]
  exact LinearEquiv.charpoly_conj _ _

/-- The underlying group characters are likewise invariant under an
equivariant equivalence. -/
theorem representation_character_eq
    [FiniteDimensional K V] [FiniteDimensional K W]
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    (e : FrobeniusRepresentation.Equiv A B) (g : G) :
    B.representation.character g = A.representation.character g := by
  unfold Representation.character
  rw [show B.representation g = e.linearEquiv.conj (A.representation g) by
    apply LinearMap.ext
    intro w
    change B.representation g w =
      e.linearEquiv (A.representation g (e.linearEquiv.symm w))
    simpa using (e.map_representation g (e.linearEquiv.symm w)).symm]
  exact LinearMap.trace_conj' _ _

end Equiv

noncomputable def prod
    (A : FrobeniusRepresentation K G V)
    (B : FrobeniusRepresentation K G W) :
    FrobeniusRepresentation K G (V × W) where
  representation := A.representation.prod B.representation
  frobenius := A.frobenius.prodMap B.frobenius
  commutes := by
    intro g
    apply LinearMap.ext
    intro x
    apply Prod.ext
    · exact LinearMap.congr_fun (A.commutes g) x.1
    · exact LinearMap.congr_fun (B.commutes g) x.2

theorem prod_twistedTrace
    [FiniteDimensional K V] [FiniteDimensional K W]
    (A : FrobeniusRepresentation K G V)
    (B : FrobeniusRepresentation K G W) (g : G) :
    (A.prod B).twistedTrace g = A.twistedTrace g + B.twistedTrace g := by
  unfold twistedTrace prod
  rw [show
    (A.representation.prod B.representation g) *
        A.frobenius.prodMap B.frobenius =
      (A.representation g * A.frobenius).prodMap
        (B.representation g * B.frobenius) by
      ext x <;> rfl]
  exact LinearMap.trace_prodMap' _ _

theorem prod_frobeniusRealizationMatrix_charpoly
    [FiniteDimensional K V] [FiniteDimensional K W]
    (A : FrobeniusRepresentation K G V)
    (B : FrobeniusRepresentation K G W) (sigma : K →+* ℂ) :
    ((A.prod B).frobeniusRealizationMatrix sigma).charpoly =
      (A.frobeniusRealizationMatrix sigma).charpoly *
        (B.frobeniusRealizationMatrix sigma).charpoly := by
  unfold frobeniusRealizationMatrix prod
  rw [Matrix.charpoly_map, Matrix.charpoly_map, Matrix.charpoly_map]
  simp only [SawinSpecialization.endomorphismMatrixOfFinrankEq_charpoly,
    LinearMap.charpoly_prodMap, Polynomial.map_mul]

theorem prod_frobeniusRealizationMatrix_root_norm_le
    [FiniteDimensional K V] [FiniteDimensional K W]
    (A : FrobeniusRepresentation K G V)
    (B : FrobeniusRepresentation K G W) (sigma : K →+* ℂ)
    (radius : ℝ)
    (hA : ∀ z,
      z ∈ (A.frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius)
    (hB : ∀ z,
      z ∈ (B.frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z, z ∈ ((A.prod B).frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius := by
  intro z hz
  rw [prod_frobeniusRealizationMatrix_charpoly] at hz
  rw [Polynomial.roots_mul (mul_ne_zero
    (Matrix.charpoly_monic _).ne_zero
    (Matrix.charpoly_monic _).ne_zero)] at hz
  rcases Multiset.mem_add.mp hz with hz | hz
  · exact hA z hz
  · exact hB z hz

/-- Restriction to a subspace stable under both the group action and
Frobenius. -/
noncomputable def restrictStable
    (A : FrobeniusRepresentation K G V) (U : Submodule K V)
    (hG : ∀ g, U ≤ U.comap (A.representation g))
    (hF : ∀ x ∈ U, A.frobenius x ∈ U) :
    FrobeniusRepresentation K G U where
  representation := A.representation.subrepresentation U hG
  frobenius := A.frobenius.restrict hF
  commutes := by
    intro g
    ext x
    change A.frobenius (A.representation g x) =
      A.representation g (A.frobenius x)
    exact LinearMap.congr_fun (A.commutes g) x

theorem idempotent_range_stable
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hcomm : ∀ g, Commute e (A.representation g)) :
    ∀ g, LinearMap.range e ≤
      (LinearMap.range e).comap (A.representation g) := by
  intro g x hx
  obtain ⟨y, rfl⟩ := hx
  exact ⟨A.representation g y, by
    exact LinearMap.congr_fun (hcomm g).eq y⟩

theorem idempotent_ker_stable
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hcomm : ∀ g, Commute e (A.representation g)) :
    ∀ g, LinearMap.ker e ≤
      (LinearMap.ker e).comap (A.representation g) := by
  intro g x hx
  change e (A.representation g x) = 0
  have hc := LinearMap.congr_fun (hcomm g).eq x
  change e (A.representation g x) = A.representation g (e x) at hc
  rw [hc]
  rw [LinearMap.mem_ker.mp hx, map_zero]

theorem idempotent_range_frobenius_stable
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hcomm : Commute e A.frobenius) :
    ∀ x ∈ LinearMap.range e, A.frobenius x ∈ LinearMap.range e := by
  intro x hx
  obtain ⟨y, rfl⟩ := hx
  exact ⟨A.frobenius y, by
    exact LinearMap.congr_fun hcomm.eq y⟩

theorem idempotent_ker_frobenius_stable
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hcomm : Commute e A.frobenius) :
    ∀ x ∈ LinearMap.ker e, A.frobenius x ∈ LinearMap.ker e := by
  intro x hx
  change e (A.frobenius x) = 0
  have hc := LinearMap.congr_fun hcomm.eq x
  change e (A.frobenius x) = A.frobenius (e x) at hc
  rw [hc]
  rw [LinearMap.mem_ker.mp hx, map_zero]

noncomputable def rangePart
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hG : ∀ g, Commute e (A.representation g))
    (hF : Commute e A.frobenius) :
    FrobeniusRepresentation K G (LinearMap.range e) :=
  A.restrictStable (LinearMap.range e)
    (A.idempotent_range_stable e hG)
    (A.idempotent_range_frobenius_stable e hF)

noncomputable def kerPart
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (hG : ∀ g, Commute e (A.representation g))
    (hF : Commute e A.frobenius) :
    FrobeniusRepresentation K G (LinearMap.ker e) :=
  A.restrictStable (LinearMap.ker e)
    (A.idempotent_ker_stable e hG)
    (A.idempotent_ker_frobenius_stable e hF)

/-- An idempotent commuting with the symmetry and Frobenius actions splits
the entire Frobenius representation into its range and kernel parts. -/
noncomputable def equivRangeProdKer
    (A : FrobeniusRepresentation K G V) (e : Module.End K V)
    (he : IsIdempotentElem e)
    (hG : ∀ g, Commute e (A.representation g))
    (hF : Commute e A.frobenius) :
    Equiv A ((A.rangePart e hG hF).prod (A.kerPart e hG hF)) where
  linearEquiv :=
    (LinearMap.range e).prodEquivOfIsCompl (LinearMap.ker e)
      (LinearMap.IsIdempotentElem.isCompl he) |>.symm
  map_representation := by
    intro g v
    let E := (LinearMap.range e).prodEquivOfIsCompl
      (LinearMap.ker e) (LinearMap.IsIdempotentElem.isCompl he)
    apply E.injective
    rw [E.apply_symm_apply]
    change A.representation g v =
      (A.representation g ((E.symm v).1 : V)) +
        A.representation g ((E.symm v).2 : V)
    rw [← map_add]
    congr 1
    exact (E.apply_symm_apply v).symm
  map_frobenius := by
    intro v
    let E := (LinearMap.range e).prodEquivOfIsCompl
      (LinearMap.ker e) (LinearMap.IsIdempotentElem.isCompl he)
    apply E.injective
    rw [E.apply_symm_apply]
    change A.frobenius v =
      A.frobenius ((E.symm v).1 : V) +
        A.frobenius ((E.symm v).2 : V)
    rw [← map_add]
    congr 1
    exact (E.apply_symm_apply v).symm

/-- Products preserve Frobenius-equivariant equivalences. -/
noncomputable def Equiv.prodCongr
    {X Y : Type*}
    [AddCommGroup X] [Module K X]
    [AddCommGroup Y] [Module K Y]
    {A : FrobeniusRepresentation K G V}
    {B : FrobeniusRepresentation K G W}
    {C : FrobeniusRepresentation K G X}
    {D : FrobeniusRepresentation K G Y}
    (e : Equiv A B) (f : Equiv C D) :
    Equiv (A.prod C) (B.prod D) where
  linearEquiv := LinearEquiv.prodCongr e.linearEquiv f.linearEquiv
  map_representation := by
    intro g v
    apply Prod.ext
    · exact e.map_representation g v.1
    · exact f.map_representation g v.2
  map_frobenius := by
    intro v
    apply Prod.ext
    · exact e.map_frobenius v.1
    · exact f.map_frobenius v.2

def Equiv.refl (A : FrobeniusRepresentation K G V) : Equiv A A where
  linearEquiv := LinearEquiv.refl K V
  map_representation := by simp
  map_frobenius := by simp

section IsotypicProjector

variable [Finite G] [NeZero (Nat.card G : K)]

/-- The index type of the full `G`-isotypic decomposition of a semisimple
representation.  This is deliberately formed before any restriction to a
subgroup: in the application, `G` is the full symmetric group. -/
abbrev IsotypicIndex (A : FrobeniusRepresentation K G V) :=
  isotypicComponents (MonoidAlgebra K G) A.representation.asModule

/-- The invariant space of an isotypic component after restriction to the
Young subgroup attached to `B`.  Naming the type keeps the canonical
restriction-of-scalars module instance local to its construction. -/
noncomputable def YoungSubgroupInvariantSpace {n : ℕ}
    {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (c : A.IsotypicIndex) (B : PermutationBlockDecomposition n) : Type _ :=
  {v : W //
    v ∈ (c.1 : Submodule (MonoidAlgebra K (Equiv.Perm (Fin n)))
      A.representation.asModule) ∧
    ∀ h, A.representation (B.blockPermutationHom h) v = v}

/-- A full-symmetric-group isotypic type occurs in the Young permutation
module attached to the block decomposition `B`. -/
def IsotypicOccursInYoungPermutationModule {n : ℕ}
    {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (c : A.IsotypicIndex) (B : PermutationBlockDecomposition n) : Prop :=
  Nontrivial (A.YoungSubgroupInvariantSpace c B)

/-- Frobenius reciprocity identifies occurrence in a Young permutation
module with a nonzero invariant vector after restriction to the Young
subgroup. -/
theorem isotypicOccursInYoungPermutationModule_iff_invariants_nontrivial
    {n : ℕ} {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (c : A.IsotypicIndex) (B : PermutationBlockDecomposition n) :
    A.IsotypicOccursInYoungPermutationModule c B ↔
      Nontrivial (A.YoungSubgroupInvariantSpace c B) := by
  rfl

/-- Intrinsic large-block cutoff: select an isotypic type exactly when it
occurs in a Young permutation module having at least one block of size `m`
or larger.  This formulation avoids assuming a Specht classification API:
Young's rule identifies it with the usual partition cutoff. -/
def IsLargeYoungIsotypic {n : ℕ}
    {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (m : ℕ) (c : A.IsotypicIndex) : Prop :=
  ∃ B : PermutationBlockDecomposition n,
    (∃ i, m ≤ B.size i) ∧ A.IsotypicOccursInYoungPermutationModule c B

/-- The complementary cutoff is precisely nonoccurrence in every Young
permutation module having a block of size at least `m`. -/
theorem not_isLargeYoungIsotypic_iff {n : ℕ}
    {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (m : ℕ) (c : A.IsotypicIndex) :
    ¬ A.IsLargeYoungIsotypic m c ↔
      ∀ B : PermutationBlockDecomposition n,
        (∃ i, m ≤ B.size i) →
          ¬ A.IsotypicOccursInYoungPermutationModule c B := by
  constructor
  · intro h B hlarge hoccur
    exact h ⟨B, hlarge, hoccur⟩
  · rintro h ⟨B, hlarge, hoccur⟩
    exact h B hlarge hoccur

/-- Equivalently, every large-block Young subgroup has only the zero vector
in the complementary isotypic constituent. -/
theorem not_isLargeYoungIsotypic_iff_invariantSpace_subsingleton {n : ℕ}
    {W : Type*} [AddCommGroup W] [Module K W]
    (A : FrobeniusRepresentation K (Equiv.Perm (Fin n)) W)
    (m : ℕ) (c : A.IsotypicIndex) :
    ¬ A.IsLargeYoungIsotypic m c ↔
      ∀ B : PermutationBlockDecomposition n,
        (∃ i, m ≤ B.size i) →
          Subsingleton (A.YoungSubgroupInvariantSpace c B) := by
  rw [not_isLargeYoungIsotypic_iff]
  simp only [IsotypicOccursInYoungPermutationModule,
    not_nontrivial_iff_subsingleton]

/-- The module endomorphism which is the identity on the selected full-group
isotypic components and zero on all remaining components. -/
noncomputable def isotypicSubsetModuleProjection
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    Module.End (MonoidAlgebra K G) A.representation.asModule := by
  classical
  let E := IsSemisimpleModule.endAlgEquiv K (MonoidAlgebra K G)
    A.representation.asModule
  exact E.symm (fun c => if select c then 1 else 0)

theorem isotypicSubsetModuleProjection_apply_of_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : select c) (x : c.1) :
    A.isotypicSubsetModuleProjection select
        (x : A.representation.asModule) = x := by
  classical
  let E := IsSemisimpleModule.endAlgEquiv K (MonoidAlgebra K G)
    A.representation.asModule
  have hcomponent :
      (E (A.isotypicSubsetModuleProjection select) c) x = x := by
    simp [isotypicSubsetModuleProjection, E, hc]
  exact congrArg Subtype.val hcomponent

theorem isotypicSubsetModuleProjection_apply_of_not_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : ¬ select c) (x : c.1) :
    A.isotypicSubsetModuleProjection select
        (x : A.representation.asModule) = 0 := by
  classical
  let E := IsSemisimpleModule.endAlgEquiv K (MonoidAlgebra K G)
    A.representation.asModule
  have hcomponent :
      (E (A.isotypicSubsetModuleProjection select) c) x = 0 := by
    simp [isotypicSubsetModuleProjection, E, hc]
  exact congrArg Subtype.val hcomponent

theorem isotypicSubsetModuleProjection_idempotent
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    IsIdempotentElem (A.isotypicSubsetModuleProjection select) := by
  classical
  let E := IsSemisimpleModule.endAlgEquiv K (MonoidAlgebra K G)
    A.representation.asModule
  change A.isotypicSubsetModuleProjection select *
      A.isotypicSubsetModuleProjection select =
    A.isotypicSubsetModuleProjection select
  apply E.injective
  ext c x
  by_cases h : select c
  · simp [isotypicSubsetModuleProjection, E, h]
  · simp [isotypicSubsetModuleProjection, E, h]

/-- A coordinatewise scalar on the isotypic decomposition commutes with
every full-group module endomorphism. -/
theorem isotypicSubsetModuleProjection_commutes
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (f : Module.End (MonoidAlgebra K G) A.representation.asModule) :
    Commute (A.isotypicSubsetModuleProjection select) f := by
  classical
  let E := IsSemisimpleModule.endAlgEquiv K (MonoidAlgebra K G)
    A.representation.asModule
  apply E.injective
  ext c x
  by_cases h : select c
  · simp [isotypicSubsetModuleProjection, E, h]
  · simp [isotypicSubsetModuleProjection, E, h]

/-- The selected-isotypic projector transported back to the underlying
`K`-vector space. -/
noncomputable def isotypicSubsetProjection
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) : Module.End K V :=
  A.representation.asModuleEquiv.conj
    ((A.isotypicSubsetModuleProjection select).restrictScalars K)

theorem isotypicSubsetProjection_apply_of_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : select c) (x : c.1) :
    A.isotypicSubsetProjection select (A.representation.asModuleEquiv x) =
      A.representation.asModuleEquiv x := by
  change A.representation.asModuleEquiv
      (A.isotypicSubsetModuleProjection select x) =
    A.representation.asModuleEquiv x
  rw [A.isotypicSubsetModuleProjection_apply_of_selected select c hc x]

theorem isotypicSubsetProjection_apply_of_not_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : ¬ select c) (x : c.1) :
    A.isotypicSubsetProjection select (A.representation.asModuleEquiv x) = 0 := by
  change A.representation.asModuleEquiv
      (A.isotypicSubsetModuleProjection select x) = 0
  rw [A.isotypicSubsetModuleProjection_apply_of_not_selected select c hc x]
  exact map_zero A.representation.asModuleEquiv

/-- The full-group submodule obtained by summing exactly the selected
isotypic components. -/
noncomputable def selectedIsotypicSubmodule
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    Submodule (MonoidAlgebra K G) A.representation.asModule := by
  classical
  exact ⨆ c : A.IsotypicIndex, if select c then c.1 else ⊥

/-- The coordinatewise `0/1` projector has exactly the selected isotypic
sum as its range. -/
theorem isotypicSubsetModuleProjection_range
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    LinearMap.range (A.isotypicSubsetModuleProjection select) =
      A.selectedIsotypicSubmodule select := by
  classical
  apply le_antisymm
  · rintro y ⟨x, rfl⟩
    have htop : (⨆ c : A.IsotypicIndex, c.1) = ⊤ :=
      ((sSup_eq_iSup' _).symm.trans
        (sSup_isotypicComponents (MonoidAlgebra K G)
          A.representation.asModule))
    have hx : x ∈ ⨆ c : A.IsotypicIndex, c.1 := by
      rw [htop]
      exact Submodule.mem_top
    apply Submodule.iSup_induction
      (fun c : A.IsotypicIndex => c.1)
      (motive := fun z =>
        A.isotypicSubsetModuleProjection select z ∈
          A.selectedIsotypicSubmodule select) hx
    · intro c z hz
      let zc : c.1 := ⟨z, hz⟩
      by_cases hc : select c
      · rw [show z = (zc : A.representation.asModule) by rfl,
          A.isotypicSubsetModuleProjection_apply_of_selected select c hc zc]
        have hle : c.1 ≤ A.selectedIsotypicSubmodule select := by
          unfold selectedIsotypicSubmodule
          exact le_iSup_of_le c (by rw [if_pos hc])
        exact hle hz
      · rw [show z = (zc : A.representation.asModule) by rfl,
          A.isotypicSubsetModuleProjection_apply_of_not_selected select c hc zc]
        exact Submodule.zero_mem _
    · rw [map_zero]
      exact Submodule.zero_mem _
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  · unfold selectedIsotypicSubmodule
    apply iSup_le
    intro c
    by_cases hc : select c
    · simp only [hc, if_true]
      intro x hx
      let xc : c.1 := ⟨x, hx⟩
      refine ⟨x, ?_⟩
      rw [show x = (xc : A.representation.asModule) by rfl,
        A.isotypicSubsetModuleProjection_apply_of_selected select c hc xc]
    · rw [if_neg hc]
      exact bot_le

/-- One full-group isotypic component transported to the underlying
`K`-vector space. -/
noncomputable def isotypicSubspace
    (A : FrobeniusRepresentation K G V) (c : A.IsotypicIndex) :
    Submodule K V :=
  (c.1.restrictScalars K).map A.representation.asModuleEquiv.toLinearMap

theorem isotypicSubspace_le_projection_range_of_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : select c) :
    A.isotypicSubspace c ≤ LinearMap.range (A.isotypicSubsetProjection select) := by
  rintro v ⟨x, hx, rfl⟩
  let xc : c.1 := ⟨x, hx⟩
  refine ⟨A.representation.asModuleEquiv xc, ?_⟩
  exact A.isotypicSubsetProjection_apply_of_selected select c hc xc

theorem isotypicSubspace_le_projection_ker_of_not_selected
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop)
    (c : A.IsotypicIndex) (hc : ¬ select c) :
    A.isotypicSubspace c ≤ LinearMap.ker (A.isotypicSubsetProjection select) := by
  rintro v ⟨x, hx, rfl⟩
  let xc : c.1 := ⟨x, hx⟩
  exact A.isotypicSubsetProjection_apply_of_not_selected select c hc xc

/-- Frobenius, viewed as an endomorphism of the full-group module. -/
noncomputable def frobeniusAsModuleEnd
    (A : FrobeniusRepresentation K G V) :
    Module.End (MonoidAlgebra K G) A.representation.asModule :=
  Representation.IntertwiningMap.equivLinearMapAsModule
    A.representation A.representation
    { toLinearMap := A.frobenius
      isIntertwining' := A.commutes }

@[simp]
theorem frobeniusAsModuleEnd_apply
    (A : FrobeniusRepresentation K G V)
    (v : A.representation.asModule) :
    A.frobeniusAsModuleEnd v =
      A.representation.asModuleEquiv.symm
        (A.frobenius (A.representation.asModuleEquiv v)) := by
  rfl

theorem isotypicSubsetProjection_idempotent
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    IsIdempotentElem (A.isotypicSubsetProjection select) := by
  let p := A.isotypicSubsetModuleProjection select
  have hp : IsIdempotentElem p :=
    A.isotypicSubsetModuleProjection_idempotent select
  have hpK : IsIdempotentElem (p.restrictScalars K) := by
    change (p * p).restrictScalars K = p.restrictScalars K
    rw [hp.eq]
  exact hpK.map A.representation.asModuleEquiv.conjRingEquiv.toRingHom

theorem isotypicSubsetProjection_commutes_representation
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) (g : G) :
    Commute (A.isotypicSubsetProjection select) (A.representation g) := by
  change A.isotypicSubsetProjection select * A.representation g =
    A.representation g * A.isotypicSubsetProjection select
  ext v
  let p := A.isotypicSubsetModuleProjection select
  let x := A.representation.asModuleEquiv.symm v
  have hp := p.map_smul (MonoidAlgebra.of K G g) x
  apply A.representation.asModuleEquiv.symm.injective
  simpa [isotypicSubsetProjection, p, x] using hp

theorem isotypicSubsetProjection_commutes_frobenius
    (A : FrobeniusRepresentation K G V)
    (select : A.IsotypicIndex → Prop) :
    Commute (A.isotypicSubsetProjection select) A.frobenius := by
  let p := A.isotypicSubsetModuleProjection select
  let f := A.frobeniusAsModuleEnd
  have hc : Commute p f := A.isotypicSubsetModuleProjection_commutes select f
  change A.isotypicSubsetProjection select * A.frobenius =
    A.frobenius * A.isotypicSubsetProjection select
  ext v
  let x := A.representation.asModuleEquiv.symm v
  have hv := LinearMap.congr_fun hc.eq x
  apply A.representation.asModuleEquiv.symm.injective
  simpa [isotypicSubsetProjection, p, f, x] using hv

end IsotypicProjector

end FrobeniusRepresentation

namespace FiniteFrobeniusRepresentation

universe uK uG uV uW uU

variable {K : Type uK} {G : Type uG} [Field K] [Group G]

/-- Frobenius-equivariant equivalence between packaged finite-dimensional
representations. -/
def Equiv
    (A : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (B : FiniteFrobeniusRepresentation.{uK, uG, uW} K G) :
    Type (max uV uW) :=
  letI := A.addCommGroup
  letI := A.module
  letI := B.addCommGroup
  letI := B.module
  FrobeniusRepresentation.Equiv A.data B.data

def Equiv.symm
    {A : FiniteFrobeniusRepresentation.{uK, uG, uV} K G}
    {B : FiniteFrobeniusRepresentation.{uK, uG, uW} K G}
    (e : Equiv A B) : Equiv B A := by
  letI := A.addCommGroup
  letI := A.module
  letI := B.addCommGroup
  letI := B.module
  exact FrobeniusRepresentation.Equiv.symm e

def Equiv.trans
    {A : FiniteFrobeniusRepresentation.{uK, uG, uV} K G}
    {B : FiniteFrobeniusRepresentation.{uK, uG, uW} K G}
    {C : FiniteFrobeniusRepresentation.{uK, uG, uU} K G}
    (e : Equiv A B) (f : Equiv B C) : Equiv A C := by
  letI := A.addCommGroup
  letI := A.module
  letI := B.addCommGroup
  letI := B.module
  letI := C.addCommGroup
  letI := C.module
  exact FrobeniusRepresentation.Equiv.trans e f

theorem Equiv.twistedTrace_eq
    {A : FiniteFrobeniusRepresentation.{uK, uG, uV} K G}
    {B : FiniteFrobeniusRepresentation.{uK, uG, uW} K G}
    (e : Equiv A B) (g : G) :
    B.twistedTrace g = A.twistedTrace g := by
  let := A.addCommGroup
  let := A.module
  let := A.finiteDimensional
  let := B.addCommGroup
  let := B.module
  let := B.finiteDimensional
  exact FrobeniusRepresentation.Equiv.twistedTrace_eq e g

/-- The zero-dimensional Frobenius representation. -/
noncomputable def zero : FiniteFrobeniusRepresentation K G where
  V := Fin 0 → K
  addCommGroup := inferInstance
  module := inferInstance
  finiteDimensional := inferInstance
  data :=
    { representation := 1
      frobenius := 0
      commutes := by intro g; simp }

@[simp] theorem zero_twistedTrace (g : G) :
    (zero : FiniteFrobeniusRepresentation K G).twistedTrace g = 0 := by
  unfold zero twistedTrace FrobeniusRepresentation.twistedTrace
  simp

@[simp] theorem zero_rank :
    (zero : FiniteFrobeniusRepresentation K G).rank = 0 := by
  unfold zero rank
  simp

theorem zero_frobeniusRealizationMatrix_roots_eq_zero (sigma : K →+* ℂ) :
    ((zero : FiniteFrobeniusRepresentation K G).frobeniusRealizationMatrix
      sigma).charpoly.roots = 0 := by
  rw [← Multiset.card_eq_zero]
  rw [← (IsAlgClosed.splits _).natDegree_eq_card_roots]
  simp only [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  change Module.finrank K (Fin 0 → K) = 0
  simp

theorem zero_frobeniusRealizationMatrix_root_norm_le
    (sigma : K →+* ℂ) (radius : ℝ) :
    ∀ z, z ∈ ((zero : FiniteFrobeniusRepresentation K G).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  rw [zero_frobeniusRealizationMatrix_roots_eq_zero] at hz
  simp at hz

/-- Coordinate realization on the standard finite free module.  Besides
making matrices explicit, this lowers an arbitrary finite-dimensional
cohomology object to the universe of its coefficient field. -/
noncomputable def coordinate
    (P : FiniteFrobeniusRepresentation K G) :
    FiniteFrobeniusRepresentation K G := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  let e := (Module.finBasis K P.V).equivFun
  exact
    { V := Fin P.rank → K
      addCommGroup := inferInstance
      module := inferInstance
      finiteDimensional := inferInstance
      data :=
        { representation := e.conjRingEquiv.toMonoidHom.comp P.data.representation
          frobenius := e.conj P.data.frobenius
          commutes := by
            intro g
            change e.conjRingEquiv P.data.frobenius *
                e.conjRingEquiv (P.data.representation g) =
              e.conjRingEquiv (P.data.representation g) *
                e.conjRingEquiv P.data.frobenius
            rw [← map_mul, ← map_mul, P.data.commutes] } }

/-- The coordinate realization is Frobenius- and group-equivariantly
equivalent to the original packaged module. -/
noncomputable def coordinateEquiv
    (P : FiniteFrobeniusRepresentation K G) : Equiv P P.coordinate := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  letI := P.coordinate.addCommGroup
  letI := P.coordinate.module
  letI := P.coordinate.finiteDimensional
  let e := (Module.finBasis K P.V).equivFun
  change FrobeniusRepresentation.Equiv P.data P.coordinate.data
  exact
    { linearEquiv := e
      map_representation := by
        intro g v
        change e (P.data.representation g v) =
          (e.conj (P.data.representation g)) (e v)
        simp
      map_frobenius := by
        intro v
        change e (P.data.frobenius v) = (e.conj P.data.frobenius) (e v)
        simp }

theorem coordinate_twistedTrace
    (P : FiniteFrobeniusRepresentation K G) (g : G) :
    P.coordinate.twistedTrace g = P.twistedTrace g := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  let := P.coordinate.addCommGroup
  let := P.coordinate.module
  let := P.coordinate.finiteDimensional
  exact Equiv.twistedTrace_eq P.coordinateEquiv g

theorem coordinate_rank
    (P : FiniteFrobeniusRepresentation K G) :
    P.coordinate.rank = P.rank := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  unfold coordinate rank
  simp

theorem coordinate_frobeniusRealizationMatrix_charpoly
    (P : FiniteFrobeniusRepresentation K G) (sigma : K →+* ℂ) :
    (P.coordinate.frobeniusRealizationMatrix sigma).charpoly =
      (P.frobeniusRealizationMatrix sigma).charpoly := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  let := P.coordinate.addCommGroup
  let := P.coordinate.module
  let := P.coordinate.finiteDimensional
  unfold frobeniusRealizationMatrix
    FrobeniusRepresentation.frobeniusRealizationMatrix
  rw [Matrix.charpoly_map, Matrix.charpoly_map]
  simp only [SawinSpecialization.endomorphismMatrixOfFinrankEq_charpoly]
  rw [FrobeniusRepresentation.Equiv.frobenius_charpoly_eq P.coordinateEquiv]

theorem coordinate_frobeniusRealizationMatrix_root_norm_le
    (P : FiniteFrobeniusRepresentation K G) (sigma : K →+* ℂ)
    (radius : ℝ)
    (h : ∀ z, z ∈ (P.frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius) :
    ∀ z, z ∈ (P.coordinate.frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius := by
  rw [coordinate_frobeniusRealizationMatrix_charpoly]
  exact h

noncomputable def prod
    (A B : FiniteFrobeniusRepresentation K G) :
    FiniteFrobeniusRepresentation K G where
  V := A.V × B.V
  addCommGroup := by
    letI := A.addCommGroup
    letI := B.addCommGroup
    infer_instance
  module := by
    letI := A.addCommGroup
    letI := A.module
    letI := B.addCommGroup
    letI := B.module
    infer_instance
  finiteDimensional := by
    let := A.addCommGroup
    let := A.module
    let := A.finiteDimensional
    let := B.addCommGroup
    let := B.module
    let := B.finiteDimensional
    infer_instance
  data := by
    letI := A.addCommGroup
    letI := A.module
    letI := B.addCommGroup
    letI := B.module
    exact A.data.prod B.data

theorem prod_twistedTrace
    (A B : FiniteFrobeniusRepresentation K G) (g : G) :
    (A.prod B).twistedTrace g = A.twistedTrace g + B.twistedTrace g := by
  let := A.addCommGroup
  let := A.module
  let := A.finiteDimensional
  let := B.addCommGroup
  let := B.module
  let := B.finiteDimensional
  exact FrobeniusRepresentation.prod_twistedTrace A.data B.data g

theorem prod_rank
    (A B : FiniteFrobeniusRepresentation K G) :
    (A.prod B).rank = A.rank + B.rank := by
  let := A.addCommGroup
  let := A.module
  let := A.finiteDimensional
  let := B.addCommGroup
  let := B.module
  let := B.finiteDimensional
  exact Module.finrank_prod

theorem prod_frobeniusRealizationMatrix_charpoly
    (A B : FiniteFrobeniusRepresentation K G) (sigma : K →+* ℂ) :
    ((A.prod B).frobeniusRealizationMatrix sigma).charpoly =
      (A.frobeniusRealizationMatrix sigma).charpoly *
        (B.frobeniusRealizationMatrix sigma).charpoly := by
  let := A.addCommGroup
  let := A.module
  let := A.finiteDimensional
  let := B.addCommGroup
  let := B.module
  let := B.finiteDimensional
  exact FrobeniusRepresentation.prod_frobeniusRealizationMatrix_charpoly
    A.data B.data sigma

theorem prod_frobeniusRealizationMatrix_root_norm_le
    (A B : FiniteFrobeniusRepresentation K G) (sigma : K →+* ℂ)
    (radius : ℝ)
    (hA : ∀ z, z ∈ (A.frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius)
    (hB : ∀ z, z ∈ (B.frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius) :
    ∀ z, z ∈ ((A.prod B).frobeniusRealizationMatrix sigma).charpoly.roots →
      ‖z‖ ≤ radius := by
  let := A.addCommGroup
  let := A.module
  let := A.finiteDimensional
  let := B.addCommGroup
  let := B.module
  let := B.finiteDimensional
  exact FrobeniusRepresentation.prod_frobeniusRealizationMatrix_root_norm_le
    A.data B.data sigma radius hA hB

abbrev End
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) : Type _ :=
  letI := P.addCommGroup
  letI := P.module
  Module.End K P.V

def CommutesRepresentation
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End) : Prop := by
  letI := P.addCommGroup
  letI := P.module
  exact ∀ g, Commute e (P.data.representation g)

def CommutesFrobenius
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End) : Prop := by
  letI := P.addCommGroup
  letI := P.module
  exact Commute e P.data.frobenius

noncomputable def rangePart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End)
    (hG : P.CommutesRepresentation e)
    (hF : P.CommutesFrobenius e) :
    FiniteFrobeniusRepresentation.{uK, uG, uV} K G := by
  letI := P.addCommGroup
  letI := P.module
  exact
    { V := LinearMap.range e
      addCommGroup := inferInstance
      module := inferInstance
      finiteDimensional := by
        let := P.finiteDimensional
        infer_instance
      data := P.data.rangePart e hG hF }

noncomputable def kerPart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End)
    (hG : P.CommutesRepresentation e)
    (hF : P.CommutesFrobenius e) :
    FiniteFrobeniusRepresentation.{uK, uG, uV} K G := by
  letI := P.addCommGroup
  letI := P.module
  exact
    { V := LinearMap.ker e
      addCommGroup := inferInstance
      module := inferInstance
      finiteDimensional := by
        let := P.finiteDimensional
        infer_instance
      data := P.data.kerPart e hG hF }

noncomputable def equivRangeProdKer
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End) (he : IsIdempotentElem e)
    (hG : P.CommutesRepresentation e)
    (hF : P.CommutesFrobenius e) :
    Equiv P ((P.rangePart e hG hF).prod (P.kerPart e hG hF)) := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  letI := (P.rangePart e hG hF).addCommGroup
  letI := (P.rangePart e hG hF).module
  letI := (P.kerPart e hG hF).addCommGroup
  letI := (P.kerPart e hG hF).module
  exact P.data.equivRangeProdKer e he hG hF

noncomputable def Equiv.prodCongr
    {A B C D : FiniteFrobeniusRepresentation K G}
    (e : Equiv A B) (f : Equiv C D) :
    Equiv (A.prod C) (B.prod D) := by
  letI := A.addCommGroup
  letI := A.module
  letI := B.addCommGroup
  letI := B.module
  letI := C.addCommGroup
  letI := C.module
  letI := D.addCommGroup
  letI := D.module
  exact FrobeniusRepresentation.Equiv.prodCongr e f

def IsCentralIdempotent
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (e : P.End) : Prop := by
  letI := P.addCommGroup
  letI := P.module
  exact IsIdempotentElem e ∧
    P.CommutesRepresentation e ∧ P.CommutesFrobenius e

section IsotypicProjector

variable [Finite G] [NeZero (Nat.card G : K)]

/-- The index type of the full-group isotypic decomposition of a packaged
finite Frobenius representation. -/
abbrev IsotypicIndex
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) : Type _ := by
  letI := P.addCommGroup
  letI := P.module
  exact ↥P.data.IsotypicIndex

/-- The selected-isotypic projector on a packaged representation. -/
noncomputable def isotypicSubsetProjection
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (select : P.IsotypicIndex → Prop) : P.End := by
  letI := P.addCommGroup
  letI := P.module
  exact P.data.isotypicSubsetProjection select

theorem isotypicSubsetProjection_isCentralIdempotent
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (select : P.IsotypicIndex → Prop) :
    P.IsCentralIdempotent (P.isotypicSubsetProjection select) := by
  let := P.addCommGroup
  let := P.module
  exact ⟨P.data.isotypicSubsetProjection_idempotent select,
    P.data.isotypicSubsetProjection_commutes_representation select,
    P.data.isotypicSubsetProjection_commutes_frobenius select⟩

variable {H : Type*} [Group H]

/-- Reinterpret an endomorphism after restricting the group action along a
homomorphism. -/
noncomputable def restrictEnd
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (e : P.End) : (P.restrict phi).End := by
  letI := P.addCommGroup
  letI := P.module
  exact e

/-- Centrality for the full group implies centrality after restriction to
any subgroup; Frobenius commutation is unchanged. -/
theorem restrictEnd_isCentralIdempotent
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (e : P.End) (he : P.IsCentralIdempotent e) :
    (P.restrict phi).IsCentralIdempotent (P.restrictEnd phi e) := by
  let := P.addCommGroup
  let := P.module
  exact ⟨he.1, fun h => he.2.1 (phi h), he.2.2⟩

/-- First cut into full-group isotypic components, then restrict the action
to `H`.  This is the order required in Sawin's argument. -/
noncomputable def restrictedIsotypicProjection
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (select : P.IsotypicIndex → Prop) : (P.restrict phi).End :=
  P.restrictEnd phi (P.isotypicSubsetProjection select)

theorem restrictedIsotypicProjection_isCentralIdempotent
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (select : P.IsotypicIndex → Prop) :
    (P.restrict phi).IsCentralIdempotent
      (P.restrictedIsotypicProjection phi select) :=
  P.restrictEnd_isCentralIdempotent phi (P.isotypicSubsetProjection select)
    (P.isotypicSubsetProjection_isCentralIdempotent select)

end IsotypicProjector

/-- The endomorphism induced by an element of the symmetry-group algebra. -/
noncomputable def groupAlgebraEnd
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (z : MonoidAlgebra K G) :
    P.End := by
  letI := P.addCommGroup
  letI := P.module
  exact P.data.representation.asAlgebraHom z

/-- A central idempotent of the group algebra acts as an idempotent commuting
with both the symmetry action and Frobenius.  The last assertion uses only
that Frobenius commutes with every group element and linearity of the group
algebra action. -/
theorem groupAlgebraEnd_isCentralIdempotent
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G)
    (z : MonoidAlgebra K G)
    (hidem : IsIdempotentElem z)
    (hcentral : z ∈ Submonoid.center (MonoidAlgebra K G)) :
    P.IsCentralIdempotent (P.groupAlgebraEnd z) := by
  let := P.addCommGroup
  let := P.module
  refine ⟨hidem.map P.data.representation.asAlgebraHom, ?_, ?_⟩
  · intro g
    change Commute (P.data.representation.asAlgebraHom z)
      (P.data.representation g)
    change P.data.representation.asAlgebraHom z * P.data.representation g =
      P.data.representation g * P.data.representation.asAlgebraHom z
    rw [← P.data.representation.asAlgebraHom_of g,
      ← map_mul, ← map_mul]
    exact congrArg P.data.representation.asAlgebraHom
      (Submonoid.mem_center_iff.1 hcentral
        (MonoidAlgebra.of K G g)).symm
  · have hF : ∀ w : MonoidAlgebra K G,
        Commute (P.data.representation.asAlgebraHom w) P.data.frobenius := by
      intro w
      induction w using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy =>
          rw [map_add]
          exact hx.add_left hy
      | single g a =>
          rw [Representation.asAlgebraHom_single]
          exact ((show Commute P.data.frobenius
            (P.data.representation g) from P.data.commutes g).symm).smul_left a
    exact hF z

noncomputable def centralRangePart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (e : P.End)
    (h : P.IsCentralIdempotent e) :
    FiniteFrobeniusRepresentation.{uK, uG, uV} K G := by
  letI := P.addCommGroup
  letI := P.module
  exact P.rangePart e h.2.1 h.2.2

noncomputable def centralKerPart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (e : P.End)
    (h : P.IsCentralIdempotent e) :
    FiniteFrobeniusRepresentation.{uK, uG, uV} K G := by
  letI := P.addCommGroup
  letI := P.module
  exact P.kerPart e h.2.1 h.2.2

noncomputable def centralEquivRangeProdKer
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (e : P.End)
    (h : P.IsCentralIdempotent e) :
    Equiv P ((P.centralRangePart e h).prod (P.centralKerPart e h)) := by
  letI := P.addCommGroup
  letI := P.module
  exact P.equivRangeProdKer e h.1 h.2.1 h.2.2

section RestrictedIsotypicParts

variable [Finite G] [NeZero (Nat.card G : K)]
variable {H : Type*} [Group H]

/-- The selected full-group isotypic range, after restriction of the group
action to `H`. -/
noncomputable def restrictedIsotypicRangePart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (select : P.IsotypicIndex → Prop) :
    FiniteFrobeniusRepresentation K H :=
  (P.restrict phi).centralRangePart
    (P.restrictedIsotypicProjection phi select)
    (P.restrictedIsotypicProjection_isCentralIdempotent phi select)

/-- The complementary full-group isotypic kernel, after restriction of the
group action to `H`. -/
noncomputable def restrictedIsotypicKerPart
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (select : P.IsotypicIndex → Prop) :
    FiniteFrobeniusRepresentation K H :=
  (P.restrict phi).centralKerPart
    (P.restrictedIsotypicProjection phi select)
    (P.restrictedIsotypicProjection_isCentralIdempotent phi select)

/-- The canonical range/kernel decomposition produced by a selected set of
full-group isotypic components, viewed after subgroup restriction. -/
noncomputable def restrictedIsotypicEquivRangeProdKer
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) (phi : H →* G)
    (select : P.IsotypicIndex → Prop) :
    Equiv (P.restrict phi)
      ((P.restrictedIsotypicRangePart phi select).prod
        (P.restrictedIsotypicKerPart phi select)) :=
  (P.restrict phi).centralEquivRangeProdKer
    (P.restrictedIsotypicProjection phi select)
    (P.restrictedIsotypicProjection_isCentralIdempotent phi select)

end RestrictedIsotypicParts

def Equiv.refl
    (P : FiniteFrobeniusRepresentation.{uK, uG, uV} K G) : Equiv P P := by
  letI := P.addCommGroup
  letI := P.module
  exact FrobeniusRepresentation.Equiv.refl P.data

end FiniteFrobeniusRepresentation

universe wP

/-- A uniform family of central idempotents whose ranges are identified with
one common Frobenius family.  The kernels are the reduced, nonconstant
summands. -/
structure CentralProjectorFamilyData
    (K G I J : Type*) [Field K] [Group G]
    (family : I → J → FiniteFrobeniusRepresentation.{_, _, wP} K G) where
  mainFamily : J → FiniteFrobeniusRepresentation.{_, _, wP} K G
  projector : ∀ i j, (family i j).End
  central : ∀ i j, (family i j).IsCentralIdempotent (projector i j)
  rangeEquiv : ∀ i j, FiniteFrobeniusRepresentation.Equiv
    ((family i j).centralRangePart (projector i j) (central i j))
    (mainFamily j)

namespace CentralProjectorFamilyData

variable {K G I J : Type*} [Field K] [Group G]
    {family : I → J → FiniteFrobeniusRepresentation.{_, _, wP} K G}

noncomputable def reducedFamily
    (data : CentralProjectorFamilyData K G I J family) :
    I → J → FiniteFrobeniusRepresentation.{_, _, wP} K G :=
  fun i j => (family i j).centralKerPart
    (data.projector i j) (data.central i j)

noncomputable def split
    (data : CentralProjectorFamilyData K G I J family)
    (i : I) (j : J) : FiniteFrobeniusRepresentation.Equiv
      (family i j)
      ((data.mainFamily j).prod (data.reducedFamily i j)) :=
  ((family i j).centralEquivRangeProdKer
    (data.projector i j) (data.central i j)).trans
      (FiniteFrobeniusRepresentation.Equiv.prodCongr
        (data.rangeEquiv i j)
        (FiniteFrobeniusRepresentation.Equiv.refl (data.reducedFamily i j)))

end CentralProjectorFamilyData

/-- A family-level source package in the representation-theoretically correct
order: select isotypic components for the full group `G`, form the canonical
projector, and only then restrict its action along `phi : H →* G`. -/
structure RestrictedIsotypicProjectorFamilyData
    (K G H I J : Type*) [Field K] [Group G] [Finite G]
    [NeZero (Nat.card G : K)] [Group H]
    (phi : H →* G)
    (family : I → J → FiniteFrobeniusRepresentation.{_, _, wP} K G) where
  selected : ∀ i j, (family i j).IsotypicIndex → Prop
  mainFamily : J → FiniteFrobeniusRepresentation.{_, _, wP} K H
  rangeEquiv : ∀ i j, FiniteFrobeniusRepresentation.Equiv
    ((family i j).restrictedIsotypicRangePart phi (selected i j))
    (mainFamily j)

namespace RestrictedIsotypicProjectorFamilyData

variable {K G H I J : Type*} [Field K] [Group G] [Finite G]
    [NeZero (Nat.card G : K)] [Group H]
    {phi : H →* G}
    {family : I → J → FiniteFrobeniusRepresentation.{_, _, wP} K G}

/-- Forget the full-group origin of the projector, yielding the existing
central-projector package on the restricted family. -/
noncomputable def toCentralProjectorFamilyData
    (data : RestrictedIsotypicProjectorFamilyData
      K G H I J phi family) :
    CentralProjectorFamilyData K H I J
      (fun i j => (family i j).restrict phi) where
  mainFamily := data.mainFamily
  projector i j :=
    (family i j).restrictedIsotypicProjection phi (data.selected i j)
  central i j :=
    (family i j).restrictedIsotypicProjection_isCentralIdempotent
      phi (data.selected i j)
  rangeEquiv := data.rangeEquiv

end RestrictedIsotypicProjectorFamilyData

namespace FrobeniusRepresentationFamily

universe w w'

variable {K G : Type*} [Field K] [Group G]

/-- Alternating twisted traces agree degree by degree under equivariant
Frobenius equivalences. -/
theorem alternatingTwistedTrace_eq_of_equiv
    {topDegree : ℕ}
    (A : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K G)
    (B : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w'} K G)
    (e : ∀ degree, FiniteFrobeniusRepresentation.Equiv
      (A degree) (B degree)) (g : G) :
    alternatingTwistedTrace B g = alternatingTwistedTrace A g := by
  unfold alternatingTwistedTrace
  apply Finset.sum_congr rfl
  intro degree _
  rw [FiniteFrobeniusRepresentation.Equiv.twistedTrace_eq
    (e degree) g]

theorem alternatingTwistedTrace_prod
    {topDegree : ℕ}
    (A B : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K G)
    (g : G) :
    alternatingTwistedTrace (fun degree => (A degree).prod (B degree)) g =
      alternatingTwistedTrace A g + alternatingTwistedTrace B g := by
  unfold alternatingTwistedTrace
  simp_rw [FiniteFrobeniusRepresentation.prod_twistedTrace, mul_add]
  exact Finset.sum_add_distrib

end FrobeniusRepresentationFamily

universe w

/-- A literal raw compact-support cohomology family together with a
degreewise Frobenius-equivariant decomposition into common and reduced
summands.  Unlike a bare trace identity, `split` records the actual
decomposition of cohomology representations. -/
structure ThreeBlockSplitCohomologyData
    (K I : Type*) [Field K]
    (topDegree d : ℕ)
    (rawTrace : I → (Fin 3 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)] where
  rawFamily : I → Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K
      (Fin 3 → Equiv.Perm (Fin d))
  mainFamily : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K
      (Fin 3 → Equiv.Perm (Fin d))
  reducedFamily : I → Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K
      (Fin 3 → Equiv.Perm (Fin d))
  split : ∀ i degree, FiniteFrobeniusRepresentation.Equiv
    (rawFamily i degree)
      ((mainFamily degree).prod (reducedFamily i degree))
  raw_lefschetz : ∀ i pi,
    FrobeniusRepresentationFamily.alternatingTwistedTrace
      (rawFamily i) pi = rawTrace i pi
  reduced_root_bound : ∀ i degree z,
    z ∈ ((reducedFamily i degree).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius
  rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) → ℕ
  reduced_rank_bound : ∀ i,
    ∀ a b c : Fin (Fintype.card (Fin d) + 1),
    (∑ degree : Fin (topDegree + 1),
      (reducedFamily i degree).characterInvariantRank
        (threeBlockExteriorFreeRepresentation K d
          (a : ℕ) (b : ℕ) (c : ℕ)).dual) ≤ rankBudgetAt a b c
  weighted_rank_bound :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        ∑ c : Fin (Fintype.card (Fin d) + 1),
          (a : ℕ) * (b : ℕ) * (c : ℕ) * rankBudgetAt a b c) ≤ rankBudget

/-- A raw three-block Lefschetz family split degreewise into a common
summand and a residue-dependent reduced summand.  This is the precise
algebraic shape of the constant/nonconstant decomposition in Sawin's
Theorem 7.2. -/
structure ThreeBlockCommonSummandCohomologyData
    (K I : Type*) [Field K]
    (topDegree d : ℕ)
    (rawTrace : I → (Fin 3 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)] where
  mainFamily : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K
      (Fin 3 → Equiv.Perm (Fin d))
  reducedFamily : I → Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K
      (Fin 3 → Equiv.Perm (Fin d))
  raw_lefschetz : ∀ i pi,
    FrobeniusRepresentationFamily.alternatingTwistedTrace
      (fun degree => (mainFamily degree).prod (reducedFamily i degree)) pi =
        rawTrace i pi
  reduced_root_bound : ∀ i degree z,
    z ∈ ((reducedFamily i degree).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius
  rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) → ℕ
  reduced_rank_bound : ∀ i,
    ∀ a b c : Fin (Fintype.card (Fin d) + 1),
    (∑ degree : Fin (topDegree + 1),
      (reducedFamily i degree).characterInvariantRank
        (threeBlockExteriorFreeRepresentation K d
          (a : ℕ) (b : ℕ) (c : ℕ)).dual) ≤ rankBudgetAt a b c
  weighted_rank_bound :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        ∑ c : Fin (Fintype.card (Fin d) + 1),
          (a : ℕ) * (b : ℕ) * (c : ℕ) * rankBudgetAt a b c) ≤ rankBudget

namespace ThreeBlockSplitCohomologyData

variable {K I : Type*} [Field K]
    {topDegree d : ℕ}
    {rawTrace : I → (Fin 3 → Equiv.Perm (Fin d)) → K}
    {sigma : K →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)]

/-- Construct a split three-block package from one total rank estimate for
the reduced cohomology.  The exterior-character rank budgets then follow
uniformly from the ambient dimension. -/
noncomputable def ofAmbientRank
    (rawFamily : I → Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 3 → Equiv.Perm (Fin d)))
    (mainFamily : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 3 → Equiv.Perm (Fin d)))
    (reducedFamily : I → Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 3 → Equiv.Perm (Fin d)))
    (split : ∀ i degree, FiniteFrobeniusRepresentation.Equiv
      (rawFamily i degree)
        ((mainFamily degree).prod (reducedFamily i degree)))
    (raw_lefschetz : ∀ i pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (rawFamily i) pi = rawTrace i pi)
    (reduced_root_bound : ∀ i degree z,
      z ∈ ((reducedFamily i degree).frobeniusRealizationMatrix
        sigma).charpoly.roots → ‖z‖ ≤ radius)
    (ambientRankBudget : ℕ)
    (reduced_rank_bound : ∀ i,
      (∑ degree : Fin (topDegree + 1),
        (reducedFamily i degree).rank) ≤ ambientRankBudget)
    (weighted_rank_bound :
      exteriorWeightedDegreeSum d ^ 3 * ambientRankBudget ≤ rankBudget) :
    ThreeBlockSplitCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget where
  rawFamily := rawFamily
  mainFamily := mainFamily
  reducedFamily := reducedFamily
  split := split
  raw_lefschetz := raw_lefschetz
  reduced_root_bound := reduced_root_bound
  rankBudgetAt a b c :=
    d.choose a * (d.choose b * d.choose c) * ambientRankBudget
  reduced_rank_bound := by
    intro i a b c
    have h := FrobeniusRepresentationFamily.sum_characterInvariantRank_le_mul_finrank
      (reducedFamily i)
      (threeBlockExteriorFreeRepresentation K d
        (a : ℕ) (b : ℕ) (c : ℕ)).dual (reduced_rank_bound i)
    rw [Subspace.dual_finrank_eq,
      threeBlockExteriorFreeRepresentation_finrank] at h
    exact h
  weighted_rank_bound := by
    rw [threeBlock_weighted_finrank_sum]
    exact weighted_rank_bound

/-- Forgetting the literal raw family retains the trace-level common/reduced
package.  The required raw trace identity follows from the degreewise
equivalence and the Grothendieck--Lefschetz formula. -/
noncomputable def toCommonSummand
    (data : ThreeBlockSplitCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget) :
    ThreeBlockCommonSummandCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget where
  mainFamily := data.mainFamily
  reducedFamily := data.reducedFamily
  raw_lefschetz := by
    intro i pi
    rw [FrobeniusRepresentationFamily.alternatingTwistedTrace_eq_of_equiv
      (data.rawFamily i)
      (fun degree => (data.mainFamily degree).prod
        (data.reducedFamily i degree)) (data.split i) pi]
    exact data.raw_lefschetz i pi
  reduced_root_bound := data.reduced_root_bound
  rankBudgetAt := data.rankBudgetAt
  reduced_rank_bound := data.reduced_rank_bound
  weighted_rank_bound := data.weighted_rank_bound

end ThreeBlockSplitCohomologyData

namespace ThreeBlockCommonSummandCohomologyData

variable {K I : Type*} [Field K]
    {topDegree d : ℕ}
    {rawTrace : I → (Fin 3 → Equiv.Perm (Fin d)) → K}
    {sigma : K →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)]

noncomputable def mainTrace
    (data : ThreeBlockCommonSummandCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget) :
    (Fin 3 → Equiv.Perm (Fin d)) → K :=
  FrobeniusRepresentationFamily.alternatingTwistedTrace data.mainFamily

theorem reduced_lefschetz
    (data : ThreeBlockCommonSummandCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget)
    (i : I) (pi : Fin 3 → Equiv.Perm (Fin d)) :
    FrobeniusRepresentationFamily.alternatingTwistedTrace
        (data.reducedFamily i) pi =
      rawTrace i pi - data.mainTrace pi := by
  have h := data.raw_lefschetz i pi
  rw [FrobeniusRepresentationFamily.alternatingTwistedTrace_prod] at h
  rw [add_comm] at h
  exact eq_sub_of_add_eq h

noncomputable def reducedVirtualCharacterCohomologyData
    (data : ThreeBlockCommonSummandCohomologyData.{w}
      K I topDegree d rawTrace sigma radius rankBudget)
    (i : I) :
    ThreeBlockVirtualCharacterCohomologyData.{w}
      K topDegree d (fun pi => rawTrace i pi - data.mainTrace pi)
        sigma radius rankBudget := by
  apply ThreeBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    topDegree d (fun pi => rawTrace i pi - data.mainTrace pi)
    sigma radius rankBudget data.rankBudgetAt
    (data.reducedFamily i)
  · exact data.reduced_lefschetz i
  · exact data.reduced_root_bound i
  · exact data.reduced_rank_bound i
  · exact data.weighted_rank_bound

end ThreeBlockCommonSummandCohomologyData

/-! The canonical geometric family lives one universe above its coefficient
field because compact-support sheaf cohomology is universe-lifted.  Finite
dimensionality allows us to pass to the coordinate realization above, which
is a genuinely universe-small Frobenius representation and preserves every
twisted trace and Frobenius characteristic polynomial. -/

/-- Grothendieck--Lefschetz for the normalized permutation/Frobenius
representation, stated directly on the geometric fixed-point locus. -/
def HasDistinctCanonicalTwistedGeometricGrothendieckLefschetzUnitNormalized
    (q n m ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (pi : Equiv.Perm (Fin n))
    (hfinite : ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ell degree g hg hdeg hm hmn t)) : Prop :=
  letI := hfinite
  FrobeniusRepresentationFamily.alternatingTwistedTrace
      (fullResidueUnitFiberDistinctCanonicalFiniteFrobeniusRepresentationFamily
        q n m ell topDegree g hg hdeg hm hmn t) pi =
    (Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
      q n m g hg hdeg hm hmn t pi) : ℚ_[ell])

/-- The normalized three-block family satisfies its point-trace identity
whenever normalized Grothendieck--Lefschetz holds for the corresponding
block permutation. -/
theorem fullResidueUnitFiberDistinctCanonicalThreeBlock_lefschetz_of_normalizedGL
    (q d m ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (hfinite : ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * d) m ell degree g hg hdeg hm hmn t))
    (hGL : ∀ pi : Fin 3 → Equiv.Perm (Fin d),
      HasDistinctCanonicalTwistedGeometricGrothendieckLefschetzUnitNormalized
        q (3 * d) m ell topDegree g hg hdeg hm hmn t
          (threeBlockPermutationFamily d pi) hfinite) :
    ∀ pi : Fin 3 → Equiv.Perm (Fin d),
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (fun degree =>
          letI := hfinite degree
          fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentation
            q d m ell degree g hg hdeg hm hmn t) pi =
        fullResidueUnitFiberDistinctThreeBlockPointTrace
          q d m ell g hg hdeg hm hmn t pi := by
  intro pi
  have h := hGL pi
  unfold HasDistinctCanonicalTwistedGeometricGrothendieckLefschetzUnitNormalized at h
  exact h

noncomputable abbrev ProgressionFullDistinctCanonicalCohomology
    (q k r ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ) :=
  FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
    q (3 * (2 * r)) (k ^ 2) ell degree
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u)

theorem canonicalThreeBlockDegreeRange {k : ℕ} (hk : 3 ≤ k) :
    k ^ 2 ≤ 3 * (2 * Construction.canonicalDegreeIndex k) := by
  have hrange := Construction.modulus_degree_in_sawin_range hk
  omega

/-- The concrete canonical compact-support family, transported degreewise to
finite coordinate spaces over `Q_ell`. -/
noncomputable def progressionCanonicalCoordinateFamily
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u)) :
    (ProgressionQuotient q k)ˣ → Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation ℚ_[ell]
        (Fin 3 → Equiv.Perm (Fin (2 * r))) :=
  fun u degree =>
    letI := hfinite u degree
    let hpos : 0 < k ^ 2 := Nat.pow_pos (by omega)
    (fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentation
      q (2 * r) (k ^ 2) ell degree
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) hpos hkm
      (progressionResidueUnitPoint q k hk u)).coordinate

/-- The canonical family before transporting its finite-dimensional
cohomology spaces to coordinate spaces. -/
noncomputable def progressionCanonicalFullFrobeniusFamily
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u)) :
    (ProgressionQuotient q k)ˣ → Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{0, 0, 1} ℚ_[ell]
        (Equiv.Perm (Fin (3 * (2 * r)))) :=
  fun u degree =>
    letI := hfinite u degree
    let hpos : 0 < k ^ 2 := Nat.pow_pos (by omega)
    fullResidueUnitFiberDistinctCanonicalFiniteFrobeniusRepresentation
      q (3 * (2 * r)) (k ^ 2) ell degree
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) hpos hkm
      (progressionResidueUnitPoint q k hk u)

/-- The same canonical family after restricting the genuine full symmetric
group action to the three equal coordinate blocks. -/
noncomputable def progressionCanonicalFrobeniusFamily
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u)) :
    (ProgressionQuotient q k)ˣ → Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{0, 0, 1} ℚ_[ell]
        (Fin 3 → Equiv.Perm (Fin (2 * r))) :=
  fun u degree =>
    letI := hfinite u degree
    let hpos : 0 < k ^ 2 := Nat.pow_pos (by omega)
    fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentation
      q (2 * r) (k ^ 2) ell degree
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) hpos hkm
      (progressionResidueUnitPoint q k hk u)

@[simp]
theorem progressionCanonicalFrobeniusFamily_eq_full_restrict
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u))
    (u : (ProgressionQuotient q k)ˣ) (degree : Fin (topDegree + 1)) :
    progressionCanonicalFrobeniusFamily
        q k r ell topDegree hk hkm hfinite u degree =
      (progressionCanonicalFullFrobeniusFamily
        q k r ell topDegree hk hkm hfinite u degree).restrict
          (threeBlockPermutationFamilyHom (2 * r)) := by
  rfl

/-- The symmetric-group order is nonzero in the characteristic-zero
coefficient field used for the isotypic decomposition. -/
local instance progressionPermutationNatCardNeZero
    (ell n : ℕ) [Fact ell.Prime] :
    NeZero (Nat.card (Equiv.Perm (Fin n)) : ℚ_[ell]) := by
  constructor
  exact_mod_cast (Nat.card_pos (α := Equiv.Perm (Fin n))).ne'

/-- The exact large-part cutoff from Sawin's Lemma 4.2, expressed without
choosing Specht labels: an isotypic type is selected iff it occurs in a
Young permutation module having a block of size at least `m = k²`. -/
noncomputable def progressionCanonicalLargeYoungSelection
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u))
    (u : (ProgressionQuotient q k)ˣ) (degree : Fin (topDegree + 1)) :
    (progressionCanonicalFullFrobeniusFamily
      q k r ell topDegree hk hkm hfinite u degree).IsotypicIndex → Prop :=
  by
    let P := progressionCanonicalFullFrobeniusFamily
      q k r ell topDegree hk hkm hfinite u degree
    letI := P.addCommGroup
    letI := P.module
    exact fun c => P.data.IsLargeYoungIsotypic (k ^ 2) c

/-- Uniform normalized Grothendieck--Lefschetz statement for the canonical
progression family. -/
def HasProgressionCanonicalNormalizedGrothendieckLefschetz
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u)) : Prop :=
  ∀ u pi,
    HasDistinctCanonicalTwistedGeometricGrothendieckLefschetzUnitNormalized
      q (3 * (2 * r)) (k ^ 2) ell topDegree
      (modulusProduct q k) (modulusProduct_monic q k)
      (modulusProduct_natDegree q k) (by positivity) hkm
      (progressionResidueUnitPoint q k hk u)
      (threeBlockPermutationFamily (2 * r) pi) (hfinite u)

/-- The uniform normalized trace formula is exactly the Lefschetz field
needed by the literal canonical family. -/
theorem progressionCanonicalFrobeniusFamily_lefschetz_of_normalizedGL
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u))
    (hGL : HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm hfinite) :
    ∀ u pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (progressionCanonicalFrobeniusFamily
          q k r ell topDegree hk hkm hfinite u) pi =
      progressionFullDistinctThreeBlockPointTrace
        q k r ell hk hkm u pi := by
  intro u pi
  exact fullResidueUnitFiberDistinctCanonicalThreeBlock_lefschetz_of_normalizedGL
    q (2 * r) (k ^ 2) ell topDegree
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u) (hfinite u) (hGL u) pi

/-- Coordinate transport preserves the entire alternating twisted trace. -/
theorem progressionCanonicalCoordinateFamily_alternatingTwistedTrace
    (q k r ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
      ∀ degree : Fin (topDegree + 1),
        FiniteDimensional ℚ_[ell]
          (ProgressionFullDistinctCanonicalCohomology
            q k r ell degree hk hkm u))
    (u : (ProgressionQuotient q k)ˣ)
    (pi : Fin 3 → Equiv.Perm (Fin (2 * r))) :
    FrobeniusRepresentationFamily.alternatingTwistedTrace
        (progressionCanonicalCoordinateFamily
          q k r ell topDegree hk hkm hfinite u) pi =
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (progressionCanonicalFrobeniusFamily
          q k r ell topDegree hk hkm hfinite u) pi := by
  apply FrobeniusRepresentationFamily.alternatingTwistedTrace_eq_of_equiv
  intro degree
  exact (progressionCanonicalFrobeniusFamily
    q k r ell topDegree hk hkm hfinite u degree).coordinateEquiv

/-- Literal source data on the canonical compact-support objects.  The raw
family is the actual cohomology family in its natural universe; the common
and reduced summands are universe-small coordinate models. -/
structure CanonicalProgressionThreeBlockSplitData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  mainFamily : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{0, 0, 0} ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
  reducedFamily : (ProgressionQuotient q k)ˣ → Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{0, 0, 0} ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
  split : ∀ u degree, FiniteFrobeniusRepresentation.Equiv
    (progressionCanonicalFrobeniusFamily
      q k r ell topDegree hk hkm finite u degree)
    ((mainFamily degree).prod (reducedFamily u degree))
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ ((reducedFamily u degree).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius
  rankBudgetAt : Fin (Fintype.card (Fin (2 * r)) + 1) →
    Fin (Fintype.card (Fin (2 * r)) + 1) →
    Fin (Fintype.card (Fin (2 * r)) + 1) → ℕ
  reduced_rank_bound : ∀ u,
    ∀ a b c : Fin (Fintype.card (Fin (2 * r)) + 1),
    (∑ degree : Fin (topDegree + 1),
      (reducedFamily u degree).characterInvariantRank
        (threeBlockExteriorFreeRepresentation ℚ_[ell] (2 * r)
          (a : ℕ) (b : ℕ) (c : ℕ)).dual) ≤ rankBudgetAt a b c
  weighted_rank_bound :
    (∑ a : Fin (Fintype.card (Fin (2 * r)) + 1),
      ∑ b : Fin (Fintype.card (Fin (2 * r)) + 1),
        ∑ c : Fin (Fintype.card (Fin (2 * r)) + 1),
          (a : ℕ) * (b : ℕ) * (c : ℕ) * rankBudgetAt a b c) ≤ rankBudget

/-- A source-facing refinement in which the characteristic-cycle theorem is
recorded as one total Betti bound.  The exterior-character budgets are
derived algebraically by `ThreeBlockSplitCohomologyData.ofAmbientRank`. -/
structure CanonicalProgressionThreeBlockAmbientSplitData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  mainFamily : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{0, 0, 0} ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
  reducedFamily : (ProgressionQuotient q k)ˣ → Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{0, 0, 0} ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
  split : ∀ u degree, FiniteFrobeniusRepresentation.Equiv
    (progressionCanonicalFrobeniusFamily
      q k r ell topDegree hk hkm finite u degree)
    ((mainFamily degree).prod (reducedFamily u degree))
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ ((reducedFamily u degree).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius
  ambientRankBudget : ℕ
  reduced_rank_bound : ∀ u,
    (∑ degree : Fin (topDegree + 1),
      (reducedFamily u degree).rank) ≤ ambientRankBudget
  weighted_rank_bound :
    exteriorWeightedDegreeSum (2 * r) ^ 3 * ambientRankBudget ≤ rankBudget

/-- The geometric common/nonconstant decomposition in projector form.  It
is enough to construct one central idempotent on each genuine compact-support
representation and identify all its ranges with a common family. -/
structure CanonicalProgressionThreeBlockCentralProjectorData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  projectorData : CentralProjectorFamilyData
    ℚ_[ell] (Fin 3 → Equiv.Perm (Fin (2 * r)))
    ((ProgressionQuotient q k)ˣ) (Fin (topDegree + 1))
    (progressionCanonicalFrobeniusFamily
      q k r ell topDegree hk hkm finite)
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ ((projectorData.reducedFamily u degree).frobeniusRealizationMatrix
      sigma).charpoly.roots → ‖z‖ ≤ radius
  ambientRankBudget : ℕ
  reduced_rank_bound : ∀ u,
    (∑ degree : Fin (topDegree + 1),
      (projectorData.reducedFamily u degree).rank) ≤ ambientRankBudget
  weighted_rank_bound :
    exteriorWeightedDegreeSum (2 * r) ^ 3 * ambientRankBudget ≤ rankBudget

/-- The source-faithful version of the preceding package.  Its projector is
the canonical 0/1 projector on selected isotypic components of the genuine
full `S_(3d)` action; the three-block action appears only after restriction.
Thus this structure matches the order of operations in Sawin's Theorem 7.2. -/
structure CanonicalProgressionFullSymmetricIsotypicProjectorData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  projectorData : RestrictedIsotypicProjectorFamilyData
    ℚ_[ell]
    (Equiv.Perm (Fin (3 * (2 * r))))
    (Fin 3 → Equiv.Perm (Fin (2 * r)))
    ((ProgressionQuotient q k)ˣ) (Fin (topDegree + 1))
    (threeBlockPermutationFamilyHom (2 * r))
    (progressionCanonicalFullFrobeniusFamily
      q k r ell topDegree hk hkm finite)
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ ((projectorData.toCentralProjectorFamilyData.reducedFamily
      u degree).frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius
  ambientRankBudget : ℕ
  reduced_rank_bound : ∀ u,
    (∑ degree : Fin (topDegree + 1),
      (projectorData.toCentralProjectorFamilyData.reducedFamily
        u degree).rank) ≤ ambientRankBudget
  weighted_rank_bound :
    exteriorWeightedDegreeSum (2 * r) ^ 3 * ambientRankBudget ≤ rankBudget

/-- Sawin's source package with the cutoff fixed to the intrinsic large-block
Young condition.  The range is the geometrically constant part of Lemma 4.2;
the kernel is exactly the collection of constituents controlled by
Proposition 7.1. -/
structure CanonicalProgressionLargeYoungGeometricData
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (rankBudget : ℕ) where
  topDegree : ℕ
  finite : ∀ u : (ProgressionQuotient q k)ˣ,
    ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProgressionFullDistinctCanonicalCohomology
          q k r ell degree hk hkm u)
  mainFamily : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{0, 0, 1} ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
  rangeEquiv : ∀ u degree,
    FiniteFrobeniusRepresentation.Equiv
      ((progressionCanonicalFullFrobeniusFamily
        q k r ell topDegree hk hkm finite u degree).restrictedIsotypicRangePart
          (threeBlockPermutationFamilyHom (2 * r))
          (progressionCanonicalLargeYoungSelection
            q k r ell topDegree hk hkm finite u degree))
      (mainFamily degree)
  normalized_lefschetz :
    HasProgressionCanonicalNormalizedGrothendieckLefschetz
      q k r ell topDegree hk hkm finite
  reduced_root_bound : ∀ u degree z,
    z ∈ (((progressionCanonicalFullFrobeniusFamily
      q k r ell topDegree hk hkm finite u degree).restrictedIsotypicKerPart
        (threeBlockPermutationFamilyHom (2 * r))
        (progressionCanonicalLargeYoungSelection
          q k r ell topDegree hk hkm finite u degree)).frobeniusRealizationMatrix
            sigma).charpoly.roots → ‖z‖ ≤ radius
  ambientRankBudget : ℕ
  reduced_rank_bound : ∀ u,
    (∑ degree : Fin (topDegree + 1),
      ((progressionCanonicalFullFrobeniusFamily
        q k r ell topDegree hk hkm finite u degree).restrictedIsotypicKerPart
          (threeBlockPermutationFamilyHom (2 * r))
          (progressionCanonicalLargeYoungSelection
            q k r ell topDegree hk hkm finite u degree)).rank) ≤
      ambientRankBudget
  weighted_rank_bound :
    exteriorWeightedDegreeSum (2 * r) ^ 3 * ambientRankBudget ≤ rankBudget

