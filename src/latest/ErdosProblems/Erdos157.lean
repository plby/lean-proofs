noncomputable def fullResidueUnitFiberDistinctPermutationAction
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    Equiv.Perm (Fin n) →*
      End (FullResidueUnitFiberDistinct
        K n m g hg hdeg hm hmn t) where
  toFun := fullResidueUnitFiberDistinctPermutation
    K n m g hg hdeg hm hmn t ∘ Equiv.symm
  map_one' := by
    apply End.ext
    change fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t (1 : Equiv.Perm (Fin n)).symm = 𝟙 _
    rw [show (1 : Equiv.Perm (Fin n)).symm = 1 by rfl]
    exact fullResidueUnitFiberDistinctPermutation_one
      K n m g hg hdeg hm hmn t
  map_mul' σ τ := by
    change fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t (σ * τ).symm =
      fullResidueUnitFiberDistinctPermutation
          K n m g hg hdeg hm hmn t τ.symm ≫
        fullResidueUnitFiberDistinctPermutation
          K n m g hg hdeg hm hmn t σ.symm
    rw [show (σ * τ).symm = τ.symm * σ.symm by rfl]
    exact (fullResidueUnitFiberDistinctPermutation_comp
      K n m g hg hdeg hm hmn t τ.symm σ.symm).symm

noncomputable def
    fullResidueUnitFiberDistinctProjectiveClosurePermutationAction
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Equiv.Perm (Fin n) →*
      End (FullResidueUnitFiberDistinctProjectiveClosure
        q n m g hg hdeg hm hmn t) where
  toFun σ := fullResidueUnitFiberDistinctProjectiveClosurePermutation
    q n m g hg hdeg hm hmn t σ.symm
  map_one' := by
    apply End.ext
    change fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t (1 : Equiv.Perm (Fin n)).symm = 𝟙 _
    rw [show (1 : Equiv.Perm (Fin n)).symm = 1 by rfl]
    exact fullResidueUnitFiberDistinctProjectiveClosurePermutation_one
      q n m g hg hdeg hm hmn t
  map_mul' σ τ := by
    change fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t (σ * τ).symm =
      fullResidueUnitFiberDistinctProjectiveClosurePermutation
          q n m g hg hdeg hm hmn t τ.symm ≫
        fullResidueUnitFiberDistinctProjectiveClosurePermutation
          q n m g hg hdeg hm hmn t σ.symm
    rw [show (σ * τ).symm = τ.symm * σ.symm by rfl]
    exact
      (fullResidueUnitFiberDistinctProjectiveClosurePermutation_comp
        q n m g hg hdeg hm hmn t τ.symm σ.symm).symm

/-! Frobenius equivariance of the coordinate-permutation action. -/

theorem fullResidueUnitFiberFrobenius_permutation
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberPermutation
          (ZMod q) n m g hg hdeg hm hmn t π =
      fullResidueUnitFiberPermutation
          (ZMod q) n m g hg hdeg hm hmn t π ≫
        fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineSchemeFrobeniusOver_naturality
    (fullResidueUnitFiberPermutation
      (ZMod q) n m g hg hdeg hm hmn t π) q
    (fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t)

theorem fullResidueUnitFiberDistinctFrobenius_permutation
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctFrobenius q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberDistinctPermutation
          (ZMod q) n m g hg hdeg hm hmn t π =
      fullResidueUnitFiberDistinctPermutation
          (ZMod q) n m g hg hdeg hm hmn t π ≫
        fullResidueUnitFiberDistinctFrobenius q n m g hg hdeg hm hmn t := by
  unfold fullResidueUnitFiberDistinctFrobenius
  exact affineSchemeFrobeniusOver_naturality
    (fullResidueUnitFiberDistinctPermutation
      (ZMod q) n m g hg hdeg hm hmn t π) q
    (fullResidueUnitFiberDistinctProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjection
      q n m g hg hdeg hm hmn t)

theorem fullResidueUnitFiberDistinctPermutation_twistedFrobenius_conj
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π ρ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctPermutation
          (ZMod q) n m g hg hdeg hm hmn t ρ ≫
        fullResidueUnitFiberDistinctTwistedFrobenius
          q n m g hg hdeg hm hmn t (ρ.symm * π * ρ) =
      fullResidueUnitFiberDistinctTwistedFrobenius
          q n m g hg hdeg hm hmn t π ≫
        fullResidueUnitFiberDistinctPermutation
          (ZMod q) n m g hg hdeg hm hmn t ρ := by
  unfold fullResidueUnitFiberDistinctTwistedFrobenius
  simp only [Category.assoc]
  rw [← Category.assoc,
    fullResidueUnitFiberDistinctPermutation_comp]
  rw [fullResidueUnitFiberDistinctFrobenius_permutation]
  rw [← Category.assoc,
    fullResidueUnitFiberDistinctPermutation_comp]
  congr 2
  change ρ * (ρ⁻¹ * π * ρ) = π * ρ
  rw [mul_assoc ρ⁻¹ π ρ, ← mul_assoc ρ ρ⁻¹,
    mul_inv_cancel, one_mul]

noncomputable def
    fullResidueUnitFiberDistinctFixedPointConjugationEquiv
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π ρ : Equiv.Perm (Fin n)) :
    {z : Spec (.of F) ⟶ FullResidueUnitFiberDistinct
          (ZMod q) n m g hg hdeg hm hmn t //
      z ≫ fullResidueUnitFiberDistinctTwistedFrobenius
        q n m g hg hdeg hm hmn t π = z} ≃
    {z : Spec (.of F) ⟶ FullResidueUnitFiberDistinct
          (ZMod q) n m g hg hdeg hm hmn t //
      z ≫ fullResidueUnitFiberDistinctTwistedFrobenius
        q n m g hg hdeg hm hmn t (ρ.symm * π * ρ) = z} where
  toFun z := ⟨z.1 ≫ fullResidueUnitFiberDistinctPermutation
      (ZMod q) n m g hg hdeg hm hmn t ρ, by
    rw [Category.assoc,
      fullResidueUnitFiberDistinctPermutation_twistedFrobenius_conj,
      ← Category.assoc, z.2]⟩
  invFun z := ⟨z.1 ≫ fullResidueUnitFiberDistinctPermutation
      (ZMod q) n m g hg hdeg hm hmn t ρ.symm, by
    have hperm :
        ρ.symm.symm * (ρ.symm * π * ρ) * ρ.symm = π := by
      change ρ * (ρ⁻¹ * π * ρ) * ρ⁻¹ = π
      rw [mul_assoc ρ⁻¹ π ρ, ← mul_assoc ρ ρ⁻¹,
        mul_inv_cancel, one_mul, mul_assoc, mul_inv_cancel, mul_one]
    have hconj :=
      fullResidueUnitFiberDistinctPermutation_twistedFrobenius_conj
        q n m g hg hdeg hm hmn t (ρ.symm * π * ρ) ρ.symm
    rw [hperm] at hconj
    rw [Category.assoc, hconj, ← Category.assoc, z.2]⟩
  left_inv z := by
    apply Subtype.ext
    simp only [Category.assoc]
    rw [fullResidueUnitFiberDistinctPermutation_comp_symm,
      Category.comp_id]
  right_inv z := by
    apply Subtype.ext
    simp only [Category.assoc]
    rw [fullResidueUnitFiberDistinctPermutation_symm_comp,
      Category.comp_id]

noncomputable def fullResidueUnitFiberDistinctFixedPointCount
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π : Equiv.Perm (Fin n)) : ℕ :=
  Nat.card {z : Spec (.of F) ⟶ FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t //
    z ≫ fullResidueUnitFiberDistinctTwistedFrobenius
      q n m g hg hdeg hm hmn t π = z}

theorem fullResidueUnitFiberDistinctFixedPointCount_conj
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π ρ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctFixedPointCount
        q n m F g hg hdeg hm hmn t (ρ * π * ρ.symm) =
      fullResidueUnitFiberDistinctFixedPointCount
        q n m F g hg hdeg hm hmn t π := by
  unfold fullResidueUnitFiberDistinctFixedPointCount
  symm
  exact Nat.card_congr
    (fullResidueUnitFiberDistinctFixedPointConjugationEquiv
      q n m F g hg hdeg hm hmn t π ρ.symm)

/-! Abstract representation-theoretic form of a Frobenius action commuting
with a finite symmetry group.  This is the algebraic target for the
isotypic compact-support complexes in Sawin's argument. -/

/-- Functorial exterior power of a group representation.  These are the
representations used in the exterior-power expansion of the polynomial
von Mangoldt factorization function in Sawin's Lemma 9.9. -/
noncomputable def Representation.exteriorPower
    {K G V : Type*}
    [Field K] [Group G] [AddCommGroup V] [Module K V]
    (rho : Representation K G V) (degree : ℕ) :
    Representation K G (⋀[K]^degree V) where
  toFun g := exteriorPower.map degree (rho g)
  map_one' := by
    rw [rho.map_one]
    exact @exteriorPower.map_id K _ degree V _ _
  map_mul' g h := by
    rw [rho.map_mul]
    exact exteriorPower.map_comp (rho h) (rho g)

structure FrobeniusRepresentation
    (K G V : Type*) [Field K] [Group G]
    [AddCommGroup V] [Module K V] where
  representation : Representation K G V
  frobenius : V →ₗ[K] V
  commutes : ∀ g, frobenius * representation g =
    representation g * frobenius

namespace FrobeniusRepresentation

variable {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]

noncomputable def twistedTrace [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (g : G) : K :=
  LinearMap.trace K V (data.representation g * data.frobenius)

/-- Complex realization of the untwisted Frobenius endomorphism. -/
noncomputable def frobeniusRealizationMatrix [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) :
    Matrix (Fin (Module.finrank K V)) (Fin (Module.finrank K V)) ℂ :=
  (SawinSpecialization.endomorphismMatrixOfFinrankEq
    data.frobenius rfl).map σ

/-- Complex realization of one finite-symmetry action. -/
noncomputable def representationRealizationMatrix [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G) :
    Matrix (Fin (Module.finrank K V)) (Fin (Module.finrank K V)) ℂ :=
  (SawinSpecialization.endomorphismMatrixOfFinrankEq
    (data.representation g) rfl).map σ

/-- Complex realization of symmetry followed by Frobenius. -/
noncomputable def twistedRealizationMatrix [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G) :
    Matrix (Fin (Module.finrank K V)) (Fin (Module.finrank K V)) ℂ :=
  (SawinSpecialization.endomorphismMatrixOfFinrankEq
    (data.representation g * data.frobenius) rfl).map σ

theorem twistedRealizationMatrix_eq [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G) :
    data.twistedRealizationMatrix σ g =
      data.representationRealizationMatrix σ g *
        data.frobeniusRealizationMatrix σ := by
  unfold twistedRealizationMatrix representationRealizationMatrix
    frobeniusRealizationMatrix
    SawinSpecialization.endomorphismMatrixOfFinrankEq
  rw [LinearMap.toMatrix_mul, Matrix.map_mul]

theorem representationRealizationMatrix_commutes [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G) :
    Commute (data.representationRealizationMatrix σ g)
      (data.frobeniusRealizationMatrix σ) := by
  change _ * _ = _ * _
  unfold representationRealizationMatrix frobeniusRealizationMatrix
    SawinSpecialization.endomorphismMatrixOfFinrankEq
  rw [← Matrix.map_mul, ← Matrix.map_mul,
    ← LinearMap.toMatrix_mul, ← LinearMap.toMatrix_mul,
    data.commutes g]

theorem representationRealizationMatrix_pow_orderOf [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G) :
    (data.representationRealizationMatrix σ g) ^ orderOf g = 1 := by
  unfold representationRealizationMatrix
    SawinSpecialization.endomorphismMatrixOfFinrankEq
  let B := Module.finBasisOfFinrankEq K V rfl
  have hmatrixPow : ∀ N : ℕ,
      (LinearMap.toMatrix B B) ((data.representation g) ^ N) =
        ((LinearMap.toMatrix B B) (data.representation g)) ^ N := by
    intro N
    induction N with
    | zero => simp only [pow_zero, LinearMap.toMatrix_one]
    | succ N ih =>
        rw [pow_succ, pow_succ, LinearMap.toMatrix_mul, ih]
  have hlinear : (data.representation g) ^ orderOf g = 1 := by
    rw [← map_pow data.representation, pow_orderOf_eq_one,
      map_one data.representation]
  have hmatrix :
      ((LinearMap.toMatrix B B) (data.representation g)) ^ orderOf g = 1 := by
    rw [← hmatrixPow, hlinear, LinearMap.toMatrix_one]
  change (RingHom.mapMatrix σ
      ((LinearMap.toMatrix B B) (data.representation g))) ^ orderOf g = 1
  rw [← map_pow, hmatrix, map_one]

/-- For a finite symmetry group, a Deligne root bound on ordinary
Frobenius automatically controls every symmetry-twisted Frobenius. -/
theorem twistedRealizationMatrix_root_norm_le
    [Finite G] [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) (g : G)
    (radius : ℝ) (hradius : 0 ≤ radius)
    (hroot : ∀ z,
      z ∈ (data.frobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z, z ∈ (data.twistedRealizationMatrix σ g).charpoly.roots →
      ‖z‖ ≤ radius := by
  rw [twistedRealizationMatrix_eq]
  exact SawinSpecialization.matrix_mul_root_norm_le_of_commute_pow_eq_one
    (data.representationRealizationMatrix σ g)
    (data.frobeniusRealizationMatrix σ)
    (orderOf_pos g) (data.representationRealizationMatrix_commutes σ g)
    (data.representationRealizationMatrix_pow_orderOf σ g)
    radius hradius hroot

theorem twistedTrace_conj [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (g h : G) :
    data.twistedTrace (h * g * h⁻¹) = data.twistedTrace g := by
  unfold twistedTrace
  rw [data.representation.map_mul, data.representation.map_mul]
  simp only [mul_assoc]
  rw [← data.commutes h⁻¹]
  rw [← mul_assoc (data.representation g)]
  rw [← mul_assoc (data.representation h)]
  rw [LinearMap.trace_mul_cycle]
  rw [← data.representation.map_mul]
  simp

theorem card_inv_mul_sum_twistedTrace_eq_trace_average
    [Fintype G] [Invertible (Fintype.card G : K)]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) :
    (Fintype.card G : K)⁻¹ * ∑ g : G, data.twistedTrace g =
      LinearMap.trace K V
        (data.representation.averageMap * data.frobenius) := by
  simp [twistedTrace, Representation.averageMap, GroupAlgebra.average,
    _root_.map_sum, Finset.sum_mul]

noncomputable def invariantsFrobenius
    (data : FrobeniusRepresentation K G V) :
    data.representation.invariants →ₗ[K]
      data.representation.invariants :=
  data.frobenius.restrict fun x hx => by
    rw [Representation.mem_invariants] at hx ⊢
    intro g
    calc
      data.representation g (data.frobenius x) =
          data.frobenius (data.representation g x) := by
        have hc := congrArg (fun f : V →ₗ[K] V => f x) (data.commutes g)
        simpa only [Module.End.mul_apply] using hc.symm
      _ = data.frobenius x := congrArg data.frobenius (hx g)

theorem trace_invariantsFrobenius_eq_trace_average
    [Fintype G] [Invertible (Fintype.card G : K)]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) :
    LinearMap.trace K data.representation.invariants
        data.invariantsFrobenius =
      LinearMap.trace K V
        (data.representation.averageMap * data.frobenius) := by
  let A := data.representation.averageMap * data.frobenius
  have hA : ∀ x, A x ∈ data.representation.invariants := by
    intro x
    exact data.representation.averageMap_invariant _
  rw [← LinearMap.trace_restrict_eq_of_forall_mem
    data.representation.invariants A hA]
  congr 1
  ext x
  change data.frobenius x = data.representation.averageMap (data.frobenius x)
  exact (data.representation.averageMap_id _
    (data.invariantsFrobenius x).property).symm

theorem card_inv_mul_sum_twistedTrace_eq_trace_invariants
    [Fintype G] [Invertible (Fintype.card G : K)]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) :
    (Fintype.card G : K)⁻¹ * ∑ g : G, data.twistedTrace g =
      LinearMap.trace K data.representation.invariants
        data.invariantsFrobenius := by
  rw [card_inv_mul_sum_twistedTrace_eq_trace_average,
    trace_invariantsFrobenius_eq_trace_average]

noncomputable def dualTensor
    {U : Type*} [AddCommGroup U] [Module K U]
    (σ : Representation K G U)
    (data : FrobeniusRepresentation K G V) :
    FrobeniusRepresentation K G
      (TensorProduct K (Module.Dual K U) V) where
  representation := σ.dual.tprod data.representation
  frobenius := TensorProduct.map LinearMap.id data.frobenius
  commutes := by
    intro g
    ext x y
    change (σ.dual g x) ⊗ₜ[K]
        data.frobenius (data.representation g y) =
      (σ.dual g x) ⊗ₜ[K]
        data.representation g (data.frobenius y)
    have hc := congrArg (fun f : V →ₗ[K] V => f y) (data.commutes g)
    simpa only [Module.End.mul_apply] using
      congrArg (fun z => (σ.dual g x) ⊗ₜ[K] z) hc

theorem dualTensor_twistedTrace
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (σ : Representation K G U)
    (data : FrobeniusRepresentation K G V) (g : G) :
    (data.dualTensor σ).twistedTrace g =
      σ.character g⁻¹ * data.twistedTrace g := by
  unfold twistedTrace dualTensor
  rw [Representation.tprod_apply, ← TensorProduct.map_mul,
    LinearMap.trace_tensorProduct']
  change LinearMap.trace K (Module.Dual K U)
      (σ.dual g * (1 : Module.End K (Module.Dual K U))) * _ = _
  rw [mul_one]
  unfold Representation.character
  rw [Representation.dual_apply, LinearMap.trace_transpose']

noncomputable def invariantsFrobeniusMatrix
    {G V : Type*} [Group G]
    [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V]
    (data : FrobeniusRepresentation ℂ G V) :
    Matrix
      (Fin (Module.finrank ℂ data.representation.invariants))
      (Fin (Module.finrank ℂ data.representation.invariants)) ℂ :=
  Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
    data.invariantsFrobenius rfl

theorem invariantsFrobeniusMatrix_trace
    {G V : Type*} [Group G]
    [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V]
    (data : FrobeniusRepresentation ℂ G V) :
    data.invariantsFrobeniusMatrix.trace =
      LinearMap.trace ℂ data.representation.invariants
        data.invariantsFrobenius := by
  exact Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq_trace
    data.invariantsFrobenius rfl

/-- Deligne bounds on a complex Frobenius representation descend
automatically to its invariant subspace. -/
theorem invariantsFrobeniusMatrix_root_norm_le
    {G V : Type*} [Group G] [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V]
    (data : FrobeniusRepresentation ℂ G V) (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
        data.frobenius rfl).charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ data.invariantsFrobeniusMatrix.charpoly.roots →
      ‖z‖ ≤ radius := by
  unfold invariantsFrobeniusMatrix invariantsFrobenius
  exact Erdos157.SawinSpecialization.restrict_root_norm_le
    data.frobenius data.representation.invariants
    (fun x hx => by
      change data.frobenius x ∈ data.representation.invariants
      rw [Representation.mem_invariants] at hx ⊢
      intro g
      have hc := congrArg (fun f : V →ₗ[ℂ] V => f x) (data.commutes g)
      simpa only [Module.End.mul_apply, hx g] using hc.symm)
    radius hroot

theorem norm_card_inv_mul_sum_twistedTrace_le
    {G V : Type*} [Group G] [Fintype G]
    [AddCommGroup V] [Module ℂ V]
    [FiniteDimensional ℂ V]
    [Invertible (Fintype.card G : ℂ)]
    (data : FrobeniusRepresentation ℂ G V) (radius : ℝ)
    (hroot : ∀ z, z ∈ data.invariantsFrobeniusMatrix.charpoly.roots →
      ‖z‖ ≤ radius) :
    ‖(Fintype.card G : ℂ)⁻¹ * ∑ g : G, data.twistedTrace g‖ ≤
      Module.finrank ℂ data.representation.invariants * radius := by
  rw [data.card_inv_mul_sum_twistedTrace_eq_trace_invariants,
    ← data.invariantsFrobeniusMatrix_trace]
  exact Erdos157.SawinSpecialization.norm_matrix_trace_le_finrank
    data.invariantsFrobeniusMatrix radius hroot

/-- Matrix realization of Frobenius on the invariant subspace after a
chosen embedding of the coefficient field into the complex numbers. -/
noncomputable def invariantsFrobeniusRealizationMatrix
    {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) :
    Matrix
      (Fin (Module.finrank K data.representation.invariants))
      (Fin (Module.finrank K data.representation.invariants)) ℂ :=
  (Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
    data.invariantsFrobenius rfl).map σ

theorem invariantsFrobeniusRealizationMatrix_trace
    {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ) :
    (data.invariantsFrobeniusRealizationMatrix σ).trace =
      σ (LinearMap.trace K data.representation.invariants
        data.invariantsFrobenius) := by
  unfold invariantsFrobeniusRealizationMatrix
  rw [show
    ((Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
        data.invariantsFrobenius rfl).map σ).trace =
      σ ((Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
        data.invariantsFrobenius rfl).trace) by
      exact (AddMonoidHom.map_trace σ _).symm]
  rw [Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq_trace]

/-- The ambient realized Frobenius root bound descends to the invariant
subspace over any coefficient field and any complex embedding. -/
theorem invariantsFrobeniusRealizationMatrix_root_norm_le
    {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ ((Erdos157.SawinSpecialization.endomorphismMatrixOfFinrankEq
        data.frobenius rfl).map σ).charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (data.invariantsFrobeniusRealizationMatrix σ).charpoly.roots →
      ‖z‖ ≤ radius := by
  unfold invariantsFrobeniusRealizationMatrix invariantsFrobenius
  exact Erdos157.SawinSpecialization.restrict_realization_root_norm_le
    data.frobenius data.representation.invariants
    (fun x hx => by
      change data.frobenius x ∈ data.representation.invariants
      rw [Representation.mem_invariants] at hx ⊢
      intro g
      have hc := congrArg (fun f : V →ₗ[K] V => f x) (data.commutes g)
      simpa only [Module.End.mul_apply, hx g] using hc.symm)
    σ radius hroot

/-- Tensoring Frobenius with an identity endomorphism repeats, and does not
enlarge, its realized spectrum.  Consequently the ambient Deligne radius for
`data` also controls the ambient Frobenius of every dual-tensor character
projector. -/
theorem dualTensor_frobeniusRealizationMatrix_root_norm_le
    {K G U V : Type*} [Field K] [Group G]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (data.frobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z,
      z ∈ ((data.dualTensor rho).frobeniusRealizationMatrix
        σ).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  have hcharpoly :
      ((data.dualTensor rho).frobeniusRealizationMatrix σ).charpoly =
        (data.frobeniusRealizationMatrix σ).charpoly ^
          Module.finrank K (Module.Dual K U) := by
    unfold frobeniusRealizationMatrix
    rw [show (data.dualTensor rho).frobenius =
        TensorProduct.map
          (LinearMap.id : Module.End K (Module.Dual K U))
          data.frobenius by rfl]
    exact
      SawinSpecialization.endomorphismMatrix_tensorProduct_map_id_charpoly
        data.frobenius σ
  rw [hcharpoly, Polynomial.roots_pow] at hz
  exact hroot z (Multiset.mem_of_mem_nsmul hz)

/-- The same tensor-stability followed by invariant-subspace restriction
gives the realized root bound needed by a character-weighted trace. -/
theorem dualTensor_invariantsFrobeniusRealizationMatrix_root_norm_le
    {K G U V : Type*} [Field K] [Group G]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (data.frobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ∀ z,
      z ∈ ((data.dualTensor rho).invariantsFrobeniusRealizationMatrix
        σ).charpoly.roots → ‖z‖ ≤ radius := by
  apply (data.dualTensor rho).invariantsFrobeniusRealizationMatrix_root_norm_le
    σ radius
  exact dualTensor_frobeniusRealizationMatrix_root_norm_le
    rho data σ radius hroot

/-- Deligne bounds for the realized invariant Frobenius spectrum and a
rank estimate imply the averaged twisted-trace bound over the original
coefficient field. -/
theorem norm_map_card_inv_mul_sum_twistedTrace_le
    {K G V : Type*} [Field K] [Group G] [Fintype G]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    [Invertible (Fintype.card G : K)]
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (data.invariantsFrobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, data.twistedTrace g)‖ ≤
      Module.finrank K data.representation.invariants * radius := by
  rw [data.card_inv_mul_sum_twistedTrace_eq_trace_invariants,
    ← data.invariantsFrobeniusRealizationMatrix_trace]
  exact Erdos157.SawinSpecialization.norm_matrix_trace_le_finrank
    (data.invariantsFrobeniusRealizationMatrix σ) radius hroot

theorem dualTensor_card_inv_mul_sum_twistedTrace
    {K G U V : Type*} [Field K] [Group G] [Fintype G]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) :
    (Fintype.card G : K)⁻¹ *
        ∑ g : G, (data.dualTensor rho).twistedTrace g =
      (Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * data.twistedTrace g := by
  congr 1
  apply Finset.sum_congr rfl
  intro g _
  exact data.dualTensor_twistedTrace rho g

/-- Dimension of the invariant subspace of a finite-dimensional commuting
Frobenius representation.  Naming this projection avoids typeclass
ambiguity after tensoring representations. -/
noncomputable def invariantRank
    {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) : ℕ :=
  Module.finrank K data.representation.invariants

/-- Taking invariants cannot increase the dimension of a finite-dimensional
representation. -/
theorem invariantRank_le_finrank
    {K G V : Type*} [Field K] [Group G]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) :
    data.invariantRank ≤ Module.finrank K V := by
  exact data.representation.invariants.finrank_le

/-- The multiplicity space selected by a character projector has dimension
at most the product of the representation degree and the ambient
cohomological rank. -/
theorem dualTensor_invariantRank_le
    {K G U V : Type*} [Field K] [Group G]
    [AddCommGroup U] [Module K U] [FiniteDimensional K U]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) :
    (data.dualTensor rho).invariantRank ≤
      Module.finrank K U * Module.finrank K V := by
  calc
    (data.dualTensor rho).invariantRank ≤
        Module.finrank K (TensorProduct K (Module.Dual K U) V) :=
      invariantRank_le_finrank (data.dualTensor rho)
    _ = Module.finrank K U * Module.finrank K V := by
      rw [Module.finrank_tensorProduct, Subspace.dual_finrank_eq]

/-- Character-weighted twisted traces are controlled by the Frobenius
spectrum on the corresponding isotypic invariant space. -/
theorem norm_map_characterWeightedTwistedTrace_le
    {K G U V : Type*} [Field K] [Group G] [Fintype G]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    [Invertible (Fintype.card G : K)]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ ((data.dualTensor rho).invariantsFrobeniusRealizationMatrix
          σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * data.twistedTrace g)‖ ≤
      (data.dualTensor rho).invariantRank * radius := by
  rw [← data.dualTensor_card_inv_mul_sum_twistedTrace rho]
  exact (data.dualTensor rho).norm_map_card_inv_mul_sum_twistedTrace_le
    σ radius hroot

/-- It is enough to prove Deligne's root bound on the original ambient
Frobenius.  Identity tensoring and invariant restriction, proved above,
automatically supply the root hypothesis for the character projector. -/
theorem norm_map_characterWeightedTwistedTrace_le_of_frobenius_root
    {K G U V : Type*} [Field K] [Group G] [Fintype G]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    [Invertible (Fintype.card G : K)]
    (rho : Representation K G U)
    (data : FrobeniusRepresentation K G V) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (data.frobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * data.twistedTrace g)‖ ≤
      (data.dualTensor rho).invariantRank * radius := by
  exact data.norm_map_characterWeightedTwistedTrace_le rho σ radius
    (dualTensor_invariantsFrobeniusRealizationMatrix_root_norm_le
      rho data σ radius hroot)

end FrobeniusRepresentation

/-! A packaged degree of finite-dimensional cohomology, followed by the
finite alternating-sum estimate.  This is the algebraic form in which
Sawin's concentration, weight, and characteristic-cycle bounds are used. -/

structure FiniteFrobeniusRepresentation
    (K G : Type*) [Field K] [Group G] where
  V : Type*
  addCommGroup : AddCommGroup V
  module : Module K V
  finiteDimensional : FiniteDimensional K V
  data : @FrobeniusRepresentation K G V _ _ addCommGroup module

namespace FiniteFrobeniusRepresentation

variable {K G : Type*} [Field K] [Group G]

/-- Realized ambient Frobenius matrix of a packaged finite-dimensional
cohomology degree. -/
noncomputable def frobeniusRealizationMatrix
    (P : FiniteFrobeniusRepresentation K G) (σ : K →+* ℂ) := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact P.data.frobeniusRealizationMatrix σ

noncomputable def twistedTrace
    (P : FiniteFrobeniusRepresentation K G) (g : G) : K := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact P.data.twistedTrace g

/-- The dimension of a packaged finite Frobenius representation. -/
noncomputable def rank
    (P : FiniteFrobeniusRepresentation K G) : ℕ := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact Module.finrank K P.V

noncomputable def characterInvariantRank
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U]
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) : ℕ := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact (P.data.dualTensor rho).invariantRank

theorem characterInvariantRank_le_finrank
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U]
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) :
    P.characterInvariantRank rho ≤ Module.finrank K U * P.rank := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  exact P.data.dualTensor_invariantRank_le rho

noncomputable def characterInvariantFrobeniusRealizationMatrix
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U]
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ) := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact (P.data.dualTensor rho).invariantsFrobeniusRealizationMatrix σ

theorem norm_map_characterWeightedTwistedTrace_le
    [Fintype G] [Invertible (Fintype.card G : K)]
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U]
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (P.characterInvariantFrobeniusRealizationMatrix
          rho σ).charpoly.roots → ‖z‖ ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * P.twistedTrace g)‖ ≤
      P.characterInvariantRank rho * radius := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  exact P.data.norm_map_characterWeightedTwistedTrace_le
    rho σ radius hroot

/-- Packaged form of the ambient-root criterion for a character-weighted
trace. -/
theorem norm_map_characterWeightedTwistedTrace_le_of_frobenius_root
    [Fintype G] [Invertible (Fintype.card G : K)]
    {U : Type*} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U]
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ z,
      z ∈ (P.frobeniusRealizationMatrix σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * P.twistedTrace g)‖ ≤
      P.characterInvariantRank rho * radius := by
  let := P.addCommGroup
  let := P.module
  let := P.finiteDimensional
  exact P.data.norm_map_characterWeightedTwistedTrace_le_of_frobenius_root
    rho σ radius hroot

end FiniteFrobeniusRepresentation

namespace FrobeniusRepresentationFamily

universe w

variable {K G U : Type*} [Field K] [Group G] [Fintype G]
    [Invertible (Fintype.card G : K)]
    [AddCommGroup U] [Module K U] [FiniteDimensional K U]

noncomputable def realizedCharacterAverage
    (P : FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ) : ℂ :=
  σ ((Fintype.card G : K)⁻¹ *
    ∑ g : G, rho.character g⁻¹ * P.twistedTrace g)

noncomputable def alternatingTwistedTrace
    {topDegree : ℕ}
    (P : Fin (topDegree + 1) → FiniteFrobeniusRepresentation K G)
    (g : G) : K :=
  ∑ degree : Fin (topDegree + 1),
    (-1 : K) ^ (degree : ℕ) * (P degree).twistedTrace g

noncomputable def alternatingRealizedCharacterAverage
    {topDegree : ℕ}
    (P : Fin (topDegree + 1) → FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ) : ℂ :=
  ∑ degree : Fin (topDegree + 1),
    (-1 : ℂ) ^ (degree : ℕ) *
      realizedCharacterAverage (P degree) rho σ

/-- A total ambient cohomology-rank bound controls every character-isotypic
rank sum, with the expected factor equal to the character representation's
degree. -/
theorem sum_characterInvariantRank_le_mul_finrank
    {topDegree ambientRankBudget : ℕ}
    (family : Fin (topDegree + 1) → FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U)
    (hambient : (∑ degree : Fin (topDegree + 1),
      (family degree).rank) ≤ ambientRankBudget) :
    (∑ degree : Fin (topDegree + 1),
      (family degree).characterInvariantRank rho) ≤
        Module.finrank K U * ambientRankBudget := by
  calc
    (∑ degree : Fin (topDegree + 1),
        (family degree).characterInvariantRank rho) ≤
      ∑ degree : Fin (topDegree + 1),
        Module.finrank K U * (family degree).rank := by
          apply Finset.sum_le_sum
          intro degree _
          exact (family degree).characterInvariantRank_le_finrank rho
    _ = Module.finrank K U *
        ∑ degree : Fin (topDegree + 1), (family degree).rank := by
          rw [Finset.mul_sum]
    _ ≤ Module.finrank K U * ambientRankBudget := by gcongr

theorem map_characterAverage_alternatingTwistedTrace
    {topDegree : ℕ}
    (P : Fin (topDegree + 1) → FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ) :
    σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ *
          alternatingTwistedTrace P g) =
      alternatingRealizedCharacterAverage P rho σ := by
  simp only [alternatingTwistedTrace,
    alternatingRealizedCharacterAverage, realizedCharacterAverage,
    map_mul, map_sum, map_pow, map_neg, map_one]
  rw [Finset.mul_sum]
  calc
    ∑ g : G, σ (Fintype.card G : K)⁻¹ *
        (σ (rho.character g⁻¹) *
          ∑ degree : Fin (topDegree + 1),
            (-1 : ℂ) ^ (degree : ℕ) *
              σ ((P degree).twistedTrace g)) =
      ∑ g : G, ∑ degree : Fin (topDegree + 1),
        σ (Fintype.card G : K)⁻¹ *
          (σ (rho.character g⁻¹) *
            ((-1 : ℂ) ^ (degree : ℕ) *
              σ ((P degree).twistedTrace g))) := by
        apply Finset.sum_congr rfl
        intro g _
        rw [Finset.mul_sum, Finset.mul_sum]
    _ = ∑ degree : Fin (topDegree + 1), ∑ g : G,
        σ (Fintype.card G : K)⁻¹ *
          (σ (rho.character g⁻¹) *
            ((-1 : ℂ) ^ (degree : ℕ) *
              σ ((P degree).twistedTrace g))) :=
      Finset.sum_comm
    _ = ∑ degree : Fin (topDegree + 1),
        (-1 : ℂ) ^ (degree : ℕ) *
          (σ (Fintype.card G : K)⁻¹ *
            ∑ g : G, σ (rho.character g⁻¹) *
              σ ((P degree).twistedTrace g)) := by
        apply Finset.sum_congr rfl
        intro degree _
        rw [Finset.mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro g _
        ring

theorem norm_alternatingRealizedCharacterAverage_le
    {topDegree : ℕ}
    (P : Fin (topDegree + 1) → FiniteFrobeniusRepresentation K G)
    (rho : Representation K G U) (σ : K →+* ℂ)
    (radius : ℝ)
    (hroot : ∀ degree z,
      z ∈ ((P degree).characterInvariantFrobeniusRealizationMatrix
          rho σ).charpoly.roots → ‖z‖ ≤ radius) :
    ‖alternatingRealizedCharacterAverage P rho σ‖ ≤
      (∑ degree : Fin (topDegree + 1),
        (P degree).characterInvariantRank rho) * radius := by
  unfold alternatingRealizedCharacterAverage
  calc
    ‖∑ degree : Fin (topDegree + 1),
        (-1 : ℂ) ^ (degree : ℕ) *
          realizedCharacterAverage (P degree) rho σ‖ ≤
        ∑ degree : Fin (topDegree + 1),
          ‖(-1 : ℂ) ^ (degree : ℕ) *
            realizedCharacterAverage (P degree) rho σ‖ :=
      norm_sum_le _ _
    _ = ∑ degree : Fin (topDegree + 1),
          ‖realizedCharacterAverage (P degree) rho σ‖ := by
      apply Finset.sum_congr rfl
      intro degree _
      rw [norm_mul, norm_pow]
      norm_num
    _ ≤ ∑ degree : Fin (topDegree + 1),
          (P degree).characterInvariantRank rho * radius := by
      apply Finset.sum_le_sum
      intro degree _
      exact (P degree).norm_map_characterWeightedTwistedTrace_le
        rho σ radius (hroot degree)
    _ = (∑ degree : Fin (topDegree + 1),
          (P degree).characterInvariantRank rho) * radius := by
      rw [Nat.cast_sum, Finset.sum_mul]

/-- The exact geometric inputs to one character-weighted Lefschetz
estimate: a bounded cohomological family, the fixed-point formula, Deligne
root bounds, and a total invariant-rank budget. -/
structure CharacterCohomologyData
    (topDegree : ℕ) (pointTrace : G → K)
    (rho : Representation K G U) (σ : K →+* ℂ)
    (radius : ℝ) (rankBudget : ℕ) where
  family : Fin (topDegree + 1) →
    FiniteFrobeniusRepresentation.{_, _, w} K G
  lefschetz : ∀ g, alternatingTwistedTrace family g = pointTrace g
  root_bound : ∀ degree z,
    z ∈ ((family degree).characterInvariantFrobeniusRealizationMatrix
        rho σ).charpoly.roots → ‖z‖ ≤ radius
  rank_bound :
    (∑ degree : Fin (topDegree + 1),
      (family degree).characterInvariantRank rho) ≤ rankBudget

/-- Construct the character-projected package from ordinary ambient
Frobenius weight bounds.  Tensor stability and invariant restriction supply
the isotypic bounds automatically. -/
noncomputable def CharacterCohomologyData.ofAmbientRootBounds
    (topDegree : ℕ) (pointTrace : G → K)
    (rho : Representation K G U) (σ : K →+* ℂ)
    (radius : ℝ) (rankBudget : ℕ)
    (family : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K G)
    (lefschetz : ∀ g, alternatingTwistedTrace family g = pointTrace g)
    (ambient_root_bound : ∀ degree z,
      z ∈ ((family degree).frobeniusRealizationMatrix
        σ).charpoly.roots → ‖z‖ ≤ radius)
    (rank_bound :
      (∑ degree : Fin (topDegree + 1),
        (family degree).characterInvariantRank rho) ≤ rankBudget) :
    CharacterCohomologyData topDegree pointTrace rho σ radius rankBudget where
  family := family
  lefschetz := lefschetz
  root_bound degree := by
    let := (family degree).addCommGroup
    let := (family degree).module
    let := (family degree).finiteDimensional
    exact
      FrobeniusRepresentation.dualTensor_invariantsFrobeniusRealizationMatrix_root_norm_le
        rho (family degree).data σ radius (ambient_root_bound degree)
  rank_bound := rank_bound

theorem CharacterCohomologyData.norm_characterAverage_pointTrace_le
    {topDegree : ℕ} {pointTrace : G → K}
    {rho : Representation K G U} {σ : K →+* ℂ}
    {radius : ℝ} {rankBudget : ℕ}
    (data : CharacterCohomologyData
      topDegree pointTrace rho σ radius rankBudget)
    (hradius : 0 ≤ radius) :
    ‖σ ((Fintype.card G : K)⁻¹ *
      ∑ g : G, rho.character g⁻¹ * pointTrace g)‖ ≤
        rankBudget * radius := by
  have htrace :
      σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * pointTrace g) =
        alternatingRealizedCharacterAverage data.family rho σ := by
    rw [← map_characterAverage_alternatingTwistedTrace]
    apply congrArg σ
    congr 1
    apply Finset.sum_congr rfl
    intro g _
    rw [data.lefschetz]
  calc
    ‖σ ((Fintype.card G : K)⁻¹ *
        ∑ g : G, rho.character g⁻¹ * pointTrace g)‖ =
      ‖alternatingRealizedCharacterAverage data.family rho σ‖ :=
        congrArg norm htrace
    _ ≤ (∑ degree : Fin (topDegree + 1),
          (data.family degree).characterInvariantRank rho) * radius :=
      norm_alternatingRealizedCharacterAverage_le
        data.family rho σ radius data.root_bound
    _ ≤ rankBudget * radius := by
      gcongr
      exact data.rank_bound

end FrobeniusRepresentationFamily

end SawinGeometry
