    fullResidueUnitFiberDistinctCanonicalFrobeniusCompactSupportLinearMapUnitNormalized_comm
      q n m ell degree g hg hdeg hm hmn t π

noncomputable def
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    (q d m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ell degree g t hg →ₗ[ℚ_[ell]]
      ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ell degree g t hg :=
  AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized
    q (properPairResidueFiberDistinctProjection q d m g t hg)
    (properPairResidueFiberDistinctProjectiveClosureOpen q d m g t hg)
    (properPairResidueFiberDistinctProjectiveClosureProjection q d m g t hg)
    (by simpa only [properPairResidueFiberDistinctProjection] using
      properPairResidueFiberDistinctProjectiveClosureOpen_over q d m g t hg)
    (properPairResidueFiberDistinctPermutation (ZMod q) d m g t hg π)
    (schemeToSpecZMod_hom_ext q _ _)
    (properPairResidueFiberDistinctProjectiveClosurePermutation q d m g t hg π)
    (schemeToSpecZMod_hom_ext q _ _)
    (properPairResidueFiberDistinctPermutation_projectiveClosureOpen
      q d m g t hg π) ell degree

theorem
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
    (q d m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q d m ell degree g t hg (π * ρ) =
      (properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q d m ell degree g t hg π).comp
      (properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q d m ell degree g t hg ρ) := by
  let pX := properPairResidueFiberDistinctProjection q d m g t hg
  let j := properPairResidueFiberDistinctProjectiveClosureOpen q d m g t hg
  let pbar := properPairResidueFiberDistinctProjectiveClosureProjection q d m g t hg
  let hj := by
    simpa only [properPairResidueFiberDistinctProjection] using
      properPairResidueFiberDistinctProjectiveClosureOpen_over q d m g t hg
  let fπ := properPairResidueFiberDistinctPermutation (ZMod q) d m g t hg π
  let fρ := properPairResidueFiberDistinctPermutation (ZMod q) d m g t hg ρ
  let fπρ := properPairResidueFiberDistinctPermutation (ZMod q) d m g t hg (π * ρ)
  let fbπ := properPairResidueFiberDistinctProjectiveClosurePermutation q d m g t hg π
  let fbρ := properPairResidueFiberDistinctProjectiveClosurePermutation q d m g t hg ρ
  let fbπρ := properPairResidueFiberDistinctProjectiveClosurePermutation q d m g t hg (π * ρ)
  change
    AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj fπρ _ fbπρ _ _ ell degree = _
  rw [AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized_congr
    q pX j pbar hj fπρ (fπ ≫ fρ) _ _ fbπρ (fbπ ≫ fbρ) _ _ _ _
      (by exact (properPairResidueFiberDistinctPermutation_comp
        (ZMod q) d m g t hg π ρ).symm)
      (by exact (properPairResidueFiberDistinctProjectiveClosurePermutation_comp
        q d m g t hg π ρ).symm)]
  exact AlgebraicGeometry.Scheme.ProEt.geometricCompactSupportCohomologyLinearMapUnitNormalized_comp
    q pX j pbar hj fπ fρ _ _ fbπ fbρ _ _ _ _ ell degree

theorem
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_one
    (q d m ell degree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
        q d m ell degree g t hg 1 = LinearMap.id := by
  let A :=
    properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
      q d m ell degree g t hg 1
  have hcomp : A = A.comp A := by
    simpa only [one_mul] using
      properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized_comp
        q d m ell degree g t hg 1 1
  have hsurj : Function.Surjective A := by
    unfold A
    unfold properPairResidueFiberDistinctCanonicalPermutationCompactSupportLinearMapUnitNormalized
    exact AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_surjective
      _ _ _ _ _ ell degree
  ext x
  obtain ⟨y, rfl⟩ := hsurj x
  change A (A y) = A y
  exact congrArg (fun F : _ →ₗ[ℚ_[ell]] _ => F y) hcomp.symm

