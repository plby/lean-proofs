        ‖data.proper23 u - (∑ v, data.proper23 v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ +
        ‖data.diagonal u - (∑ v, data.diagonal v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ)‖ ≤
      ((4 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) +
        ((2 * d ^ 3 * sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) :=
      add_le_add hfour hdiagonal
    _ = ((6 * d ^ 3 *
        sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := by
      norm_cast
      ring

