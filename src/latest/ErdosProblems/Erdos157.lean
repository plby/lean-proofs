theorem properPairResidueFiberPermutation_appTop_distinctSection
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    (properPairResidueFiberPermutation K d m g t hg π).appTop
      ((properPairResidueFiberToRootSpace K d m g t hg ≫
        (RootSpaceOpen K (2 * d) g).ι).appTop
          (rootVandermondeSection K (2 * d))) =
      (((twoBlockPermutationFamily d π).sign : ℤ) :
          Γ(ProperPairResidueFiber K d m g t hg, ⊤)) *
        (properPairResidueFiberToRootSpace K d m g t hg ≫
          (RootSpaceOpen K (2 * d) g).ι).appTop
            (rootVandermondeSection K (2 * d)) := by
  let f := properPairResidueFiberPermutation K d m g t hg π
  let a := properPairResidueFiberToRootSpace K d m g t hg ≫
    (RootSpaceOpen K (2 * d) g).ι
  calc
    f.appTop (a.appTop (rootVandermondeSection K (2 * d))) =
        (f ≫ a).appTop (rootVandermondeSection K (2 * d)) := by rfl
    _ = (a ≫ affineRootPermutation K (2 * d)
          (twoBlockPermutationFamily d π)).appTop
        (rootVandermondeSection K (2 * d)) := by
      rw [show f ≫ a = a ≫ affineRootPermutation K (2 * d)
          (twoBlockPermutationFamily d π) by
        dsimp only [f, a]
        simp only [Category.assoc]
        rw [properPairResidueFiberPermutation_toRootSpace_assoc,
          rootPermutation_ι]]
    _ = a.appTop ((affineRootPermutation K (2 * d)
          (twoBlockPermutationFamily d π)).appTop
        (rootVandermondeSection K (2 * d))) := by rfl
    _ = a.appTop ((((twoBlockPermutationFamily d π).sign : ℤ) :
          Γ(AffineRootSpace K (2 * d), ⊤)) *
        rootVandermondeSection K (2 * d)) := by
      rw [affineRootPermutation_appTop_rootVandermondeSection]
    _ = _ := by
      rw [map_mul]
      congr 1
      simp

theorem properPairResidueFiberPermutation_preimage_distinctOpen
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic)
