/-!
# Erdős Problem 157

Erdős, Sárközy, and Sós asked whether there is an infinite Sidon subset of
the natural numbers which is an asymptotic additive basis of order three.
Cédric Pilatte proved that such a set exists.

The mathematical reconstruction and a dependency-by-dependency Leanization
plan are in `tex/157.tex`.

References:

* C. Pilatte, *A solution to the Erdős--Sárközy--Sós problem on asymptotic
  Sidon bases of order 3*, Compositio Math. 160 (2024), 1418--1432.
* W. Sawin, *Square-root cancellation for sums of factorization functions
  over squarefree progressions in F_q[t]*, Acta Math. 233 (2024), 285--418.
-/

open Filter
open CategoryTheory
open scoped Kronecker

/-! The mates correspondence is natural in the two vertical functors.  The
two elementary whiskering laws below complement Mathlib's horizontal-side
whiskering lemmas and are used to keep the equivariant extension-by-zero
comparison compositional. -/

namespace CategoryTheory

universe v₁ v₂ v₃ v₄ u₁ u₂ u₃ u₄

variable {C : Type u₁} {D : Type u₂} {E : Type u₃} {F : Type u₄}
variable [Category.{v₁} C] [Category.{v₂} D]
variable [Category.{v₃} E] [Category.{v₄} F]
variable {G G' : C ⥤ E} {H H' : D ⥤ F}
variable {L₁ : C ⥤ D} {R₁ : D ⥤ C}
variable {L₂ : E ⥤ F} {R₂ : F ⥤ E}

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem mateEquiv_whiskerTop
    (adj₁ : L₁ ⊣ R₁) (adj₂ : L₂ ⊣ R₂)
    (w : TwoSquare G' L₁ L₂ H) (α : G ⟶ G') :
    mateEquiv adj₁ adj₂ (w.whiskerTop α) =
      (mateEquiv adj₁ adj₂ w).whiskerRight α := by
  ext X
  simp [mateEquiv, TwoSquare.whiskerTop, TwoSquare.whiskerRight]

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem mateEquiv_whiskerBottom
    (adj₁ : L₁ ⊣ R₁) (adj₂ : L₂ ⊣ R₂)
    (w : TwoSquare G L₁ L₂ H) (α : H ⟶ H') :
    mateEquiv adj₁ adj₂ (w.whiskerBottom α) =
      (mateEquiv adj₁ adj₂ w).whiskerLeft α := by
  ext X
  simp only [Functor.comp_obj, mateEquiv_apply, NatTrans.comp_app, Functor.id_obj, Functor.rightUnitor_inv_app,
    Functor.whiskerLeft_app, Functor.associator_hom_app, Functor.associator_inv_app, Functor.whiskerRight_app,
    TwoSquare.whiskerBottom_app, Functor.map_comp, Functor.comp_map, Functor.leftUnitor_hom_app, Category.comp_id,
    Category.id_comp, Category.assoc, TwoSquare.whiskerLeft_app]
  simp only [← R₂.map_comp]
  rw [← Category.assoc, α.naturality, Category.assoc]

open Limits

section PullbackOfComposite

variable {C₀ : Type u₁} [Category.{v₁} C₀]
variable {X₀ Y₀ Z₀ T₀ : C₀}
variable (q₀ : X₀ ⟶ Y₀) (g₀ : Y₀ ⟶ Z₀) (t₀ : T₀ ⟶ Z₀)
variable [HasPullback (q₀ ≫ g₀) t₀] [HasPullback g₀ t₀]

/-- The canonical map from a fiber of `q ≫ g` to the corresponding fiber
of `g`. -/
noncomputable def pullbackCompFiberMap :
    pullback (q₀ ≫ g₀) t₀ ⟶ pullback g₀ t₀ :=
  pullback.lift (pullback.fst _ _ ≫ q₀) (pullback.snd _ _) (by
    rw [Category.assoc, pullback.condition])

@[reassoc (attr := simp)]
theorem pullbackCompFiberMap_fst :
    pullbackCompFiberMap q₀ g₀ t₀ ≫ pullback.fst g₀ t₀ =
      pullback.fst (q₀ ≫ g₀) t₀ ≫ q₀ := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem pullbackCompFiberMap_snd :
    pullbackCompFiberMap q₀ g₀ t₀ ≫ pullback.snd g₀ t₀ =
      pullback.snd (q₀ ≫ g₀) t₀ := by
  exact pullback.lift_snd _ _ _

/-- The preceding fiber map is the base change of `q`. -/
theorem pullbackCompFiberMap_isPullback :
    IsPullback (pullback.fst (q₀ ≫ g₀) t₀)
      (pullbackCompFiberMap q₀ g₀ t₀) q₀ (pullback.fst g₀ t₀) := by
  let heq : pullback.fst (q₀ ≫ g₀) t₀ ≫ q₀ =
      pullbackCompFiberMap q₀ g₀ t₀ ≫ pullback.fst g₀ t₀ :=
    (pullbackCompFiberMap_fst q₀ g₀ t₀).symm
  exact IsPullback.of_isLimit (PullbackCone.IsLimit.mk heq
    (fun s => pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) (by
      rw [← Category.assoc, s.condition, Category.assoc,
        pullback.condition, ← Category.assoc]))
    (fun _ => pullback.lift_fst _ _ _)
    (fun s => by
      apply pullback.hom_ext
      · calc
          (pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                pullbackCompFiberMap q₀ g₀ t₀) ≫ pullback.fst g₀ t₀ =
              pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                (pullbackCompFiberMap q₀ g₀ t₀ ≫ pullback.fst g₀ t₀) :=
            Category.assoc _ _ _
          _ = pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                pullback.fst (q₀ ≫ g₀) t₀ ≫ q₀ := by
            rw [pullbackCompFiberMap_fst]
          _ = s.fst ≫ q₀ := by
            rw [← Category.assoc, pullback.lift_fst]
          _ = s.snd ≫ pullback.fst g₀ t₀ := s.condition
      · calc
          (pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                pullbackCompFiberMap q₀ g₀ t₀) ≫ pullback.snd g₀ t₀ =
              pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                (pullbackCompFiberMap q₀ g₀ t₀ ≫ pullback.snd g₀ t₀) :=
            Category.assoc _ _ _
          _ = pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
                pullback.snd (q₀ ≫ g₀) t₀ := by
            rw [pullbackCompFiberMap_snd]
          _ = s.snd ≫ pullback.snd g₀ t₀ := pullback.lift_snd _ _ _)
    (fun s k hkfst hksnd => by
      apply pullback.hom_ext
      · rw [hkfst, pullback.lift_fst]
      · calc
          k ≫ pullback.snd (q₀ ≫ g₀) t₀ =
              k ≫ pullbackCompFiberMap q₀ g₀ t₀ ≫
                pullback.snd g₀ t₀ := by
            rw [pullbackCompFiberMap_snd]
          _ = s.snd ≫ pullback.snd g₀ t₀ := by
            rw [← Category.assoc, hksnd]
          _ = pullback.lift s.fst (s.snd ≫ pullback.snd g₀ t₀) _ ≫
              pullback.snd (q₀ ≫ g₀) t₀ := by
            rw [pullback.lift_snd]))

variable {f₀ : X₀ ⟶ Z₀} (h₀ : q₀ ≫ g₀ = f₀)
variable [HasPullback f₀ t₀]

/-- The fiber map when the composite is identified propositionally with an
existing morphism `f`. -/
noncomputable def pullbackFiberMapOfComm :
    pullback f₀ t₀ ⟶ pullback g₀ t₀ :=
  pullback.lift (pullback.fst _ _ ≫ q₀) (pullback.snd _ _) (by
    rw [Category.assoc, h₀, pullback.condition])

omit [HasPullback (q₀ ≫ g₀) t₀] in
/-- `pullbackFiberMapOfComm` is again a base-change square. -/
theorem pullbackFiberMapOfComm_isPullback :
    IsPullback (pullback.fst f₀ t₀)
      (pullbackFiberMapOfComm q₀ g₀ t₀ h₀) q₀ (pullback.fst g₀ t₀) := by
  subst f₀
  simpa only [pullbackFiberMapOfComm, pullbackCompFiberMap] using
    pullbackCompFiberMap_isPullback q₀ g₀ t₀

end PullbackOfComposite

end CategoryTheory

/-! ## Scheme-theoretic proper closures

The compact-support construction below needs a genuine open immersion into a
proper scheme.  For the affine fibers occurring here we obtain it by first
embedding them as quasi-compact locally closed subschemes of projective space
and then taking the scheme-theoretic image.  The generic image step is
recorded here independently of the later explicit projective embedding. -/

namespace AlgebraicGeometry

universe u

/-- The scheme-theoretic closure of a locally closed subscheme in its ambient
scheme. -/
noncomputable abbrev ProperClosure {X P : Scheme.{u}} (i : X ⟶ P) : Scheme.{u} :=
  i.image

/-- A quasi-compact immersion is an open immersion into its scheme-theoretic
image. -/
noncomputable def properClosureOpen {X P : Scheme.{u}} (i : X ⟶ P) :
    X ⟶ ProperClosure i := i.toImage

/-- The scheme-theoretic closure inherits a map to the base from the ambient
scheme. -/
noncomputable def properClosureProjection {S X P : Scheme.{u}}
    (i : X ⟶ P) (p : P ⟶ S) : ProperClosure i ⟶ S := i.imageι ≫ p

instance {X P : Scheme.{u}} (i : X ⟶ P) [IsImmersion i] [QuasiCompact i] :
    IsOpenImmersion (properClosureOpen i) := by
  unfold properClosureOpen
  infer_instance

instance {S X P : Scheme.{u}} (i : X ⟶ P) (p : P ⟶ S)
    [IsProper p] : IsProper (properClosureProjection i p) := by
  unfold properClosureProjection
  exact MorphismProperty.comp_mem @IsProper _ _
    (by infer_instance) (by infer_instance)

@[reassoc]
theorem properClosureOpen_imageι {X P : Scheme.{u}} (i : X ⟶ P) :
    properClosureOpen i ≫ i.imageι = i := by
  simp [properClosureOpen]

/-! The ambient projective space is built from the usual total-degree
grading on a polynomial ring.  `Option σ` supplies one homogenizing coordinate
in addition to the affine coordinates indexed by `σ`. -/

namespace ProjectiveCompactification

noncomputable section

attribute [local instance] MvPolynomial.gradedAlgebra

abbrev HomogeneousCoordinateRing (K : Type u) [Field K]
    (σ : Type u) (d : ℕ) :=
  MvPolynomial.homogeneousSubmodule (Option σ) K d

abbrev ProjectiveSpace (K : Type u) [Field K] (σ : Type u) : Scheme.{u} :=
  Proj (HomogeneousCoordinateRing K σ)

variable (K : Type u) [Field K] (σ : Type u)

instance projectiveScalarTower :
    IsScalarTower K (HomogeneousCoordinateRing K σ 0)
      (MvPolynomial (Option σ) K) :=
  IsScalarTower.of_algebraMap_eq'
    (R := K) (S := HomogeneousCoordinateRing K σ 0)
    (A := MvPolynomial (Option σ) K) rfl

instance degreeZeroNontrivial :
    Nontrivial (HomogeneousCoordinateRing K σ 0) := by
  refine ⟨⟨0, 1, ?_⟩⟩
  intro h
  have h' := congrArg Subtype.val h
  simpa using h'

/-- The polynomial algebra over its degree-zero part maps onto the whole
homogeneous coordinate ring. -/
def fromDegreeZero :
    MvPolynomial (Option σ) (HomogeneousCoordinateRing K σ 0) →ₐ[
        HomogeneousCoordinateRing K σ 0] MvPolynomial (Option σ) K :=
  MvPolynomial.aeval fun i ↦ MvPolynomial.X i

lemma fromDegreeZero_surjective :
    Function.Surjective (fromDegreeZero K σ) := by
  intro p
  refine ⟨MvPolynomial.map
    (algebraMap K (HomogeneousCoordinateRing K σ 0)) p, ?_⟩
  rw [fromDegreeZero, MvPolynomial.aeval_map_algebraMap]
  rw [MvPolynomial.aeval_X_left]
  rfl

noncomputable instance projectiveFiniteType [Finite σ] :
    Algebra.FiniteType (HomogeneousCoordinateRing K σ 0)
      (MvPolynomial (Option σ) K) :=
  Algebra.FiniteType.of_surjective (fromDegreeZero K σ)
    (fromDegreeZero_surjective K σ)

lemma degreeZeroAlgebraMap_bijective :
    Function.Bijective
      (algebraMap K (HomogeneousCoordinateRing K σ 0)) := by
  constructor
  · exact RingHom.injective _
  · intro x
    have hx : (x.1 : MvPolynomial (Option σ) K) ∈
        (1 : Submodule K (MvPolynomial (Option σ) K)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero (Option σ)]
      exact x.2
    obtain ⟨r, hr⟩ := Submodule.mem_one.mp hx
    refine ⟨r, Subtype.ext ?_⟩
    simpa using hr

noncomputable def degreeZeroRingEquiv :
    K ≃+* HomogeneousCoordinateRing K σ 0 :=
  RingEquiv.ofBijective
    (algebraMap K (HomogeneousCoordinateRing K σ 0))
    (degreeZeroAlgebraMap_bijective K σ)

noncomputable def projectiveSpaceToSpecZero :
    ProjectiveSpace K σ ⟶
      Spec (.of (HomogeneousCoordinateRing K σ 0)) :=
  Proj.toSpecZero (HomogeneousCoordinateRing K σ)

/-- The standard projective space projection, with its degree-zero ring
identified with the ground field. -/
noncomputable def projectiveSpaceProjection :
    ProjectiveSpace K σ ⟶ Spec (.of K) :=
  projectiveSpaceToSpecZero K σ ≫
    Spec.map (degreeZeroRingEquiv K σ).toCommRingCatIso.hom

theorem projectiveSpaceProjection_isProper [Finite σ] :
    IsProper (projectiveSpaceProjection K σ) := by
  unfold projectiveSpaceProjection
  exact MorphismProperty.comp_mem @IsProper _ _
    (by unfold projectiveSpaceToSpecZero; infer_instance)
    (by infer_instance)

/-! The standard affine chart `X₀ ≠ 0` of projective space.  Mathlib's
`Proj.awayι` supplies the open immersion once its homogeneous-localization
ring is identified with the ordinary polynomial ring; the following explicit
dehomogenization argument proves that identification. -/

abbrev H := HomogeneousCoordinateRing K σ

def xZero : MvPolynomial (Option σ) K := MvPolynomial.X none

lemma xZero_mem : xZero K σ ∈ H K σ 1 :=
  MvPolynomial.isHomogeneous_X K none

abbrev AffineChartRing := HomogeneousLocalization.Away (H K σ) (xZero K σ)

lemma xZero_pow_mem (j : ℕ) :
    (xZero K σ) ^ j ∈ Submonoid.powers (xZero K σ) := ⟨j, rfl⟩

def dehomogenize : MvPolynomial (Option σ) K →+* MvPolynomial σ K :=
  MvPolynomial.eval₂Hom MvPolynomial.C fun
    | none => 1
    | some i => MvPolynomial.X i

@[simp] lemma dehomogenize_C (r : K) :
    dehomogenize K σ (MvPolynomial.C r) = MvPolynomial.C r := by
  simp [dehomogenize]

@[simp] lemma dehomogenize_xZero :
    dehomogenize K σ (xZero K σ) = 1 := by
  simp [dehomogenize, xZero]

@[simp] lemma dehomogenize_X_some (i : σ) :
    dehomogenize K σ (MvPolynomial.X (some i)) = MvPolynomial.X i := by
  simp [dehomogenize]

noncomputable def localizedDehomogenize :
    Localization.Away (xZero K σ) →+* MvPolynomial σ K :=
  IsLocalization.Away.lift (xZero K σ)
    (by rw [dehomogenize_xZero]; exact isUnit_one)

noncomputable def chartToAffine : AffineChartRing K σ →+* MvPolynomial σ K :=
  (localizedDehomogenize K σ).comp
    (algebraMap (AffineChartRing K σ) (Localization.Away (xZero K σ)))

def chartCoefficient : K →+* AffineChartRing K σ :=
  (HomogeneousLocalization.fromZeroRingHom
      (H K σ) (Submonoid.powers (xZero K σ))).comp
    (algebraMap K (H K σ 0))

def chartCoordinate (i : σ) : AffineChartRing K σ :=
  HomogeneousLocalization.Away.mk (H K σ) (xZero_mem K σ) 1
    (MvPolynomial.X (some i)) (by
      simpa using MvPolynomial.isHomogeneous_X K (some i))

def affineToChart : MvPolynomial σ K →+* AffineChartRing K σ :=
  MvPolynomial.eval₂Hom (chartCoefficient K σ) (chartCoordinate K σ)

@[simp] theorem chartToAffine_chartCoefficient (r : K) :
    chartToAffine K σ (chartCoefficient K σ r) = MvPolynomial.C r := by
  unfold chartToAffine chartCoefficient localizedDehomogenize
  rw [RingHom.comp_apply, RingHom.comp_apply,
    HomogeneousLocalization.algebraMap_apply]
  change Localization.awayLift (dehomogenize K σ) (xZero K σ)
    (isUnit_iff_exists_inv.mpr ⟨1, by simp⟩)
    (Localization.mk ((algebraMap K (H K σ 0)) r).1
      ⟨(xZero K σ) ^ 0, xZero_pow_mem K σ 0⟩) = _
  calc
    _ = dehomogenize K σ ((algebraMap K (H K σ 0)) r).1 * 1 ^ 0 :=
      Localization.awayLift_mk (dehomogenize K σ) (xZero K σ)
        ((algebraMap K (H K σ 0)) r).1 1 (by simp) 0
    _ = _ := by simp [dehomogenize]

@[simp] theorem chartToAffine_chartCoordinate (i : σ) :
    chartToAffine K σ (chartCoordinate K σ i) = MvPolynomial.X i := by
  unfold chartToAffine chartCoordinate localizedDehomogenize
  rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk]
  change Localization.awayLift (dehomogenize K σ) (xZero K σ)
    (isUnit_iff_exists_inv.mpr ⟨1, by simp⟩)
    (Localization.mk (MvPolynomial.X (some i))
      ⟨(xZero K σ) ^ 1, xZero_pow_mem K σ 1⟩) = _
  calc
    _ = dehomogenize K σ (MvPolynomial.X (some i)) * 1 ^ 1 :=
      Localization.awayLift_mk (dehomogenize K σ) (xZero K σ)
        (MvPolynomial.X (some i)) 1 (by simp) 1
    _ = _ := by simp [dehomogenize]

theorem chartToAffine_comp_affineToChart :
    (chartToAffine K σ).comp (affineToChart K σ) = RingHom.id _ := by
  ext r i
  · simp [affineToChart]
  · simp [affineToChart]

lemma val_prod_chartCoordinate_pow [Fintype σ] (e : σ → ℕ) :
    HomogeneousLocalization.val (∏ i, chartCoordinate K σ i ^ e i) =
      Localization.mk (∏ i, MvPolynomial.X (some i) ^ e i)
        ⟨(xZero K σ) ^ (∑ i, e i), xZero_pow_mem K σ _⟩ := by
  change algebraMap (AffineChartRing K σ) (Localization.Away (xZero K σ))
      (∏ i, chartCoordinate K σ i ^ e i) = _
  simp only [map_prod, map_pow, HomogeneousLocalization.algebraMap_apply,
    chartCoordinate, HomogeneousLocalization.Away.val_mk,
    Localization.mk_pow, Localization.mk_prod]
  congr 1
  ext
  simp [Finset.prod_pow_eq_pow_sum]

lemma chartCoefficient_eq_mk (r : K) :
    chartCoefficient K σ r =
      HomogeneousLocalization.Away.mk (H K σ) (xZero_mem K σ) 0
        (MvPolynomial.C r) (by
          simpa using MvPolynomial.isHomogeneous_C (R := K) r) := by
  rfl

lemma val_chartCoefficient (r : K) :
    HomogeneousLocalization.val (chartCoefficient K σ r) =
      Localization.mk (MvPolynomial.C r)
        ⟨(xZero K σ) ^ 0, xZero_pow_mem K σ 0⟩ := by
  rw [chartCoefficient_eq_mk]
  simpa using
    (HomogeneousLocalization.Away.val_mk
      (H K σ) 0 (xZero_mem K σ) (MvPolynomial.C r)
        (by simpa using MvPolynomial.isHomogeneous_C (R := K) r))

theorem affineToChart_dehomogenize_eq_mk [Fintype σ]
    (n : ℕ) (p : MvPolynomial (Option σ) K) (hp : p.IsHomogeneous n) :
    affineToChart K σ (dehomogenize K σ p) =
      HomogeneousLocalization.Away.mk (H K σ) (xZero_mem K σ) n p (by
        simpa using hp) := by
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero =>
      apply HomogeneousLocalization.val_injective
      simp [affineToChart, HomogeneousLocalization.Away.val_mk,
        Localization.mk_zero]
  | add p q hp hq ihp ihq =>
      rw [map_add, map_add, ihp, ihq]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_add,
        HomogeneousLocalization.Away.val_mk]
      exact Localization.add_mk_self p
        ⟨(xZero K σ) ^ n, xZero_pow_mem K σ n⟩ q
  | monomial d r hr =>
      have hdegree : d none + ∑ i : σ, d (some i) = n := by
        rw [Finsupp.weight_apply] at hr
        simpa [Finsupp.sum_fintype, Finset.sum_insertNone] using hr
      have hdehom :
          dehomogenize K σ (MvPolynomial.monomial d r) =
            MvPolynomial.C r * ∏ i : σ,
              MvPolynomial.X i ^ d (some i) := by
        let f : Option σ → MvPolynomial σ K := fun
          | none => 1
          | some i => MvPolynomial.X i
        change (MvPolynomial.bind₁ f) (MvPolynomial.monomial d r) = _
        rw [MvPolynomial.bind₁_monomial]
        have hf : (∏ i ∈ d.support, f i ^ d i) = ∏ i, f i ^ d i :=
          Finsupp.prod_fintype d _ (by simp)
        rw [hf]
        simp [f, Fintype.prod_option]
      apply HomogeneousLocalization.val_injective
      rw [hdehom, map_mul]
      simp only [affineToChart, MvPolynomial.eval₂Hom_C, map_prod,
        map_pow, MvPolynomial.eval₂Hom_X']
      change HomogeneousLocalization.val
          (chartCoefficient K σ r *
            ∏ i : σ, chartCoordinate K σ i ^ d (some i)) = _
      rw [HomogeneousLocalization.val_mul, val_chartCoefficient,
        val_prod_chartCoordinate_pow, HomogeneousLocalization.Away.val_mk]
      rw [MvPolynomial.monomial_eq]
      rw [Localization.mk_mul]
      rw [Finsupp.prod_option_index]
      all_goals simp only [pow_zero, Submonoid.mk_mul_mk, one_mul, Finsupp.prod_pow, Finsupp.some_apply]
      subst n
      rw [Localization.mk_eq_mk'_apply, Localization.mk_eq_mk'_apply]
      let b : Submonoid.powers (xZero K σ) :=
        ⟨(xZero K σ) ^ (∑ i : σ, d (some i)), xZero_pow_mem K σ _⟩
      let c : Submonoid.powers (xZero K σ) :=
        ⟨(xZero K σ) ^ d none, xZero_pow_mem K σ _⟩
      change IsLocalization.mk' (Localization.Away (xZero K σ))
          (MvPolynomial.C r *
            ∏ i : σ, MvPolynomial.X (some i) ^ d (some i)) b = _
      symm
      calc
        _ = IsLocalization.mk' (Localization.Away (xZero K σ))
            ((MvPolynomial.C r *
                ∏ i : σ, MvPolynomial.X (some i) ^ d (some i)) *
              (c : MvPolynomial (Option σ) K))
            (b * c) := by
              congr 1
              · simp [c, xZero, mul_comm, mul_left_comm, mul_assoc]
              · apply Subtype.ext
                change (xZero K σ) ^ (Finsupp.weight 1 d) =
                  (xZero K σ) ^ (∑ i : σ, d (some i)) *
                    (xZero K σ) ^ d none
                simp [← hdegree, pow_add, mul_comm]
        _ = _ := by rw [IsLocalization.mk'_cancel]

theorem chartToAffine_mk (n : ℕ) (p : MvPolynomial (Option σ) K)
    (hp : p ∈ H K σ n) :
    chartToAffine K σ
        (HomogeneousLocalization.Away.mk (H K σ) (xZero_mem K σ) n p
          (by simpa using hp)) = dehomogenize K σ p := by
  unfold chartToAffine localizedDehomogenize
  rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk]
  change Localization.awayLift (dehomogenize K σ) (xZero K σ)
    (isUnit_iff_exists_inv.mpr ⟨1, by simp⟩)
    (Localization.mk p
      ⟨(xZero K σ) ^ n, xZero_pow_mem K σ n⟩) = _
  calc
    _ = dehomogenize K σ p * 1 ^ n :=
      Localization.awayLift_mk (dehomogenize K σ) (xZero K σ)
        p 1 (by simp) n
    _ = _ := by simp

theorem affineToChart_comp_chartToAffine [Fintype σ] :
    (affineToChart K σ).comp (chartToAffine K σ) = RingHom.id _ := by
  apply DFunLike.ext _ _
  intro z
  obtain ⟨n, p, hp, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective
      (H K σ) (xZero_mem K σ) z
  have hp' : p.IsHomogeneous n := by simpa using hp
  rw [RingHom.comp_apply, chartToAffine_mk K σ n p hp',
    affineToChart_dehomogenize_eq_mk K σ n p hp']
  rfl

noncomputable def affineChartRingEquiv [Fintype σ] :
    MvPolynomial σ K ≃+* AffineChartRing K σ :=
  RingEquiv.ofBijective (affineToChart K σ) ⟨
    (show Function.LeftInverse (chartToAffine K σ) (affineToChart K σ) by
      intro x
      have h := congrArg
        (fun f : MvPolynomial σ K →+* MvPolynomial σ K => f x)
        (chartToAffine_comp_affineToChart K σ)
      simpa [RingHom.comp_apply] using h).injective,
    (show Function.RightInverse (chartToAffine K σ) (affineToChart K σ) by
      intro x
      have h := congrArg
        (fun f : AffineChartRing K σ →+* AffineChartRing K σ => f x)
        (affineToChart_comp_chartToAffine K σ)
      simpa [RingHom.comp_apply] using h).surjective⟩

noncomputable def affineSpaceToProjective [Fintype σ] :
    AffineSpace σ (Spec (.of K)) ⟶ ProjectiveSpace K σ :=
  (AffineSpace.SpecIso σ (.of K)).hom ≫
    Spec.map (affineChartRingEquiv K σ).toCommRingCatIso.inv ≫
      Proj.awayι (H K σ) (xZero K σ) (xZero_mem K σ) (by omega)

instance affineSpaceToProjective_isOpenImmersion [Fintype σ] :
    IsOpenImmersion (affineSpaceToProjective K σ) := by
  unfold affineSpaceToProjective
  infer_instance

instance affineSpaceToProjective_quasiCompact [Fintype σ] :
    QuasiCompact (affineSpaceToProjective K σ) := by
  unfold affineSpaceToProjective
  infer_instance

/-- The standard affine chart embedding is a morphism over the ground
field.  This compatibility is later inherited by the scheme-theoretic
projective closure of every residue fiber. -/
theorem affineSpaceToProjective_over [Fintype σ] :
    affineSpaceToProjective K σ ≫ projectiveSpaceProjection K σ =
      AffineSpace σ (Spec (.of K)) ↘ Spec (.of K) := by
  unfold affineSpaceToProjective projectiveSpaceProjection
    projectiveSpaceToSpecZero
  simp only [Category.assoc]
  rw [Proj.awayι_toSpecZero_assoc]
  simp only [← Spec.map_comp, Category.assoc]
  apply (cancel_epi (AffineSpace.SpecIso σ (.of K)).inv).1
  rw [Iso.inv_hom_id_assoc,
    AffineSpace.SpecIso_inv_over (n := σ) (.of K)]
  simp only [← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  simp only [CommRingCat.comp_apply, CommRingCat.hom_ofHom]
  change (affineChartRingEquiv K σ).symm (chartCoefficient K σ r) =
    MvPolynomial.C r
  rw [RingEquiv.symm_apply_eq]
  simp [affineChartRingEquiv, affineToChart]

end

end ProjectiveCompactification

/-! Every affine finite-type scheme over a field admits a concrete immersion
into a finite-dimensional projective space.  This packages the finite set of
algebra generators into a closed affine embedding and then uses the standard
affine chart above. -/

noncomputable def affineFiniteTypeAlgebraMap
    (K : Type) [Field K] (X : Scheme) (p : X ⟶ Spec (.of K)) :
    K →+* Γ(X, ⊤) :=
  p.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom

@[instance_reducible]
noncomputable def affineFiniteTypeAlgebra
    (K : Type) [Field K] (X : Scheme) (p : X ⟶ Spec (.of K)) :
    Algebra K Γ(X, ⊤) :=
  (affineFiniteTypeAlgebraMap K X p).toAlgebra

theorem affineFiniteTypeAlgebra_finiteType
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    @Algebra.FiniteType K Γ(X, ⊤) _ _
      (affineFiniteTypeAlgebra K X p) := by
  change (affineFiniteTypeAlgebraMap K X p).FiniteType
  unfold affineFiniteTypeAlgebraMap
  have hp : p.appTop.hom.FiniteType := by
    rw [← HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)]
    infer_instance
  apply RingHom.FiniteType.comp hp
  apply RingHom.FiniteType.of_surjective
  exact (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv.surjective

/-- A finite polynomial presentation of the coordinate ring.  The final
component records that the presentation is over the displayed ground-field
map rather than merely a surjective map of abstract rings. -/
noncomputable def affineFiniteTypePresentation
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    Σ n : ℕ, {f : MvPolynomial (Fin n) K →+* Γ(X, ⊤) //
      Function.Surjective f ∧
        ∀ x : K, f (MvPolynomial.C x) =
          affineFiniteTypeAlgebraMap K X p x} := by
  letI : Algebra K Γ(X, ⊤) := affineFiniteTypeAlgebra K X p
  letI : Algebra.FiniteType K Γ(X, ⊤) :=
    affineFiniteTypeAlgebra_finiteType K X p
  let h := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType K Γ(X, ⊤))
  let n := h.choose
  let f := h.choose_spec.choose
  have hf := h.choose_spec.choose_spec
  exact ⟨n, f.toRingHom, hf, f.commutes⟩

/-- The closed embedding of an affine finite-type scheme into the affine
space determined by a chosen finite polynomial presentation. -/
noncomputable def affineFiniteTypeEmbedding
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    X ⟶ AffineSpace (Fin (affineFiniteTypePresentation K X p).1)
      (Spec (.of K)) :=
  X.isoSpec.hom ≫
    Spec.map (CommRingCat.ofHom
      (affineFiniteTypePresentation K X p).2.1) ≫
    (AffineSpace.SpecIso (Fin (affineFiniteTypePresentation K X p).1)
      (.of K)).inv

noncomputable instance affineFiniteTypeEmbedding_isClosedImmersion
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    IsClosedImmersion (affineFiniteTypeEmbedding K X p) := by
  unfold affineFiniteTypeEmbedding
  let : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom
        (affineFiniteTypePresentation K X p).2.1)) :=
    IsClosedImmersion.spec_of_surjective _
      (affineFiniteTypePresentation K X p).2.2.1
  infer_instance

/-- The associated locally closed embedding into projective space. -/
noncomputable def affineFiniteTypeProjectiveEmbedding
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    X ⟶ ProjectiveCompactification.ProjectiveSpace K
      (Fin (affineFiniteTypePresentation K X p).1) :=
  affineFiniteTypeEmbedding K X p ≫
    ProjectiveCompactification.affineSpaceToProjective K
      (Fin (affineFiniteTypePresentation K X p).1)

noncomputable instance affineFiniteTypeProjectiveEmbedding_isImmersion
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    IsImmersion (affineFiniteTypeProjectiveEmbedding K X p) := by
  unfold affineFiniteTypeProjectiveEmbedding
  infer_instance

noncomputable instance affineFiniteTypeProjectiveEmbedding_quasiCompact
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    QuasiCompact (affineFiniteTypeProjectiveEmbedding K X p) := by
  unfold affineFiniteTypeProjectiveEmbedding
  infer_instance

noncomputable def affineFiniteTypeProjectiveClosure
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] : Scheme :=
  ProperClosure (affineFiniteTypeProjectiveEmbedding K X p)

noncomputable def affineFiniteTypeProjectiveClosureOpen
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    X ⟶ affineFiniteTypeProjectiveClosure K X p :=
  properClosureOpen (affineFiniteTypeProjectiveEmbedding K X p)

noncomputable def affineFiniteTypeProjectiveClosureProjection
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    affineFiniteTypeProjectiveClosure K X p ⟶ Spec (.of K) :=
  properClosureProjection (affineFiniteTypeProjectiveEmbedding K X p)
    (ProjectiveCompactification.projectiveSpaceProjection K
      (Fin (affineFiniteTypePresentation K X p).1))

theorem properClosureOpen_isOpenImmersion_explicit
    {X P : Scheme} (i : X ⟶ P) [IsImmersion i] [QuasiCompact i] :
    IsOpenImmersion (properClosureOpen i) := by
  infer_instance

noncomputable instance affineFiniteTypeProjectiveClosureOpen_isOpenImmersion
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    IsOpenImmersion (affineFiniteTypeProjectiveClosureOpen K X p) := by
  unfold affineFiniteTypeProjectiveClosureOpen
  let : IsImmersion (affineFiniteTypeProjectiveEmbedding K X p) :=
    affineFiniteTypeProjectiveEmbedding_isImmersion K X p
  let : QuasiCompact (affineFiniteTypeProjectiveEmbedding K X p) :=
    affineFiniteTypeProjectiveEmbedding_quasiCompact K X p
  exact properClosureOpen_isOpenImmersion_explicit
    (affineFiniteTypeProjectiveEmbedding K X p)

noncomputable instance affineFiniteTypeProjectiveClosureProjection_isProper
    (K : Type) [Field K] (X : Scheme) [IsAffine X]
    (p : X ⟶ Spec (.of K)) [LocallyOfFiniteType p] :
    IsProper (affineFiniteTypeProjectiveClosureProjection K X p) := by
  unfold affineFiniteTypeProjectiveClosureProjection
  let : IsProper
      (ProjectiveCompactification.projectiveSpaceProjection K
        (Fin (affineFiniteTypePresentation K X p).1)) :=
    ProjectiveCompactification.projectiveSpaceProjection_isProper K _
  exact instIsProperProperClosureProjection
    (affineFiniteTypeProjectiveEmbedding K X p)
    (ProjectiveCompactification.projectiveSpaceProjection K
      (Fin (affineFiniteTypePresentation K X p).1))

end AlgebraicGeometry

/-! ## Compact support on the small pro-étale site

Mathlib supplies ordinary ell-adic cohomology but not an extension-by-zero
construction.  The definitions below build the honest left adjoint on the
small pro-étale site and hence compact support relative to a chosen proper
compactification. -/

open CategoryTheory Limits

/-! ## A relative-dimension presentation for polynomial algebras -/

namespace Algebra

universe u v

variable (R : Type u) [CommRing R] (σ : Type v)

/-- The free polynomial algebra has its tautological presentation, with one
generator for every variable and no relations. -/
noncomputable def mvPolynomialFreePreSubmersivePresentation :
    PreSubmersivePresentation R (MvPolynomial σ R) σ PEmpty.{v + 1} where
  toPresentation := {
    toGenerators := Generators.mvPolynomial R σ
    relation := PEmpty.elim
    span_range_relation_eq_ker := by
      rw [Generators.ker_mvPolynomial]
      simp }
  map := PEmpty.elim
  map_inj x := x.elim

/-- The empty Jacobian of the free presentation is the unit determinant. -/
noncomputable def mvPolynomialFreeSubmersivePresentation :
    SubmersivePresentation R (MvPolynomial σ R) σ PEmpty.{v + 1} where
  toPreSubmersivePresentation :=
    mvPolynomialFreePreSubmersivePresentation R σ
  jacobian_isUnit := by
    classical
    rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
      Matrix.det_isEmpty]
    simp

theorem mvPolynomialFreeSubmersivePresentation_dimension [Finite σ] :
    (mvPolynomialFreeSubmersivePresentation R σ).dimension = Nat.card σ := by
  simp [mvPolynomialFreePreSubmersivePresentation, Presentation.dimension]

/-- A polynomial algebra in a finite family of variables is standard smooth
of relative dimension equal to the cardinality of that family. -/
instance [Finite σ] : IsStandardSmoothOfRelativeDimension (Nat.card σ) R
    (MvPolynomial σ R) :=
  (mvPolynomialFreeSubmersivePresentation R σ).isStandardSmoothOfRelativeDimension
    (mvPolynomialFreeSubmersivePresentation_dimension R σ)

end Algebra

/-! ## Functoriality through iterated localizations

Mathlib constructs maps on localized (shifted) Hom groups one localizer at a
time.  The two comparison lemmas below prove that applying two localizer
morphisms successively agrees with the map for their composite.  The shifted
version tracks the source and target comparison isomorphisms explicitly; this
is the coherence input needed below for functoriality of Ext and hence of
compactly supported cohomology. -/

namespace CategoryTheory.LocalizerMorphism

universe w₁ w₂ w₃ v₁ v₂ v₃ u₁ u₂ u₃

open Localization

variable {C₁ : Type u₁} [Category.{v₁} C₁]
variable {C₂ : Type u₂} [Category.{v₂} C₂]
variable {C₃ : Type u₃} [Category.{v₃} C₃]
variable {W₁ : MorphismProperty C₁} {W₂ : MorphismProperty C₂}
variable {W₃ : MorphismProperty C₃}

theorem smallHomMap_comp_localizer
    (Φ : LocalizerMorphism W₁ W₂) (Ψ : LocalizerMorphism W₂ W₃)
    {X Y : C₁}
    [HasSmallLocalizedHom.{w₁} W₁ X Y]
    [HasSmallLocalizedHom.{w₂} W₂ (Φ.functor.obj X) (Φ.functor.obj Y)]
    [h₃ : HasSmallLocalizedHom.{w₃} W₃
      (Ψ.functor.obj (Φ.functor.obj X))
      (Ψ.functor.obj (Φ.functor.obj Y))]
    [h₃' : HasSmallLocalizedHom.{w₃} W₃
      ((Φ.comp Ψ).functor.obj X) ((Φ.comp Ψ).functor.obj Y)]
    (f : SmallHom.{w₁} W₁ X Y) :
    (Φ.comp Ψ).smallHomMap f = Ψ.smallHomMap (Φ.smallHomMap f) := by
  unfold SmallHom
  apply (SmallHom.equiv W₃ W₃.Q).injective
  let GΦ := Φ.localizedFunctor W₁.Q W₂.Q
  let GΨ := Ψ.localizedFunctor W₂.Q W₃.Q
  let eΦ := CatCommSq.iso Φ.functor W₁.Q W₂.Q GΦ
  let eΨ := CatCommSq.iso Ψ.functor W₂.Q W₃.Q GΨ
  let ecomp : (Φ.functor ⋙ Ψ.functor) ⋙ W₃.Q ≅
      W₁.Q ⋙ (GΦ ⋙ GΨ) :=
    (CategoryTheory.Functor.associator Φ.functor Ψ.functor W₃.Q) ≪≫
      (CategoryTheory.Functor.isoWhiskerLeft Φ.functor eΨ) ≪≫
      (CategoryTheory.Functor.associator Φ.functor W₂.Q GΨ).symm ≪≫
      (CategoryTheory.Functor.isoWhiskerRight eΦ GΨ) ≪≫
      (CategoryTheory.Functor.associator W₁.Q GΦ GΨ)
  rw [(Φ.comp Ψ).equiv_smallHomMap W₁.Q W₃.Q (GΦ ⋙ GΨ) ecomp]
  let E₃ := @SmallHom.equiv _ _ W₃ _ _ W₃.Q _ _ _ h₃
  change _ = E₃ (Ψ.smallHomMap (Φ.smallHomMap f))
  rw [Ψ.equiv_smallHomMap W₂.Q W₃.Q GΨ eΨ]
  rw [Φ.equiv_smallHomMap W₁.Q W₂.Q GΦ eΦ]
  dsimp [ecomp]
  simp only [Category.id_comp, Category.comp_id, Functor.map_comp]
  have hassoc :
      (eΨ.hom.app (Φ.functor.obj X) ≫ GΨ.map (eΦ.hom.app X)) ≫
          GΨ.map (GΦ.map ((SmallHom.equiv W₁ W₁.Q) f)) ≫
            GΨ.map (eΦ.inv.app Y) ≫ eΨ.inv.app (Φ.functor.obj Y) =
        eΨ.hom.app (Φ.functor.obj X) ≫
          (GΨ.map (eΦ.hom.app X) ≫
            GΨ.map (GΦ.map ((SmallHom.equiv W₁ W₁.Q) f)) ≫
              GΨ.map (eΦ.inv.app Y)) ≫ eΨ.inv.app (Φ.functor.obj Y) := by
    simp only [Category.assoc]
  exact hassoc

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem smallHomMap'_comp_localizer
    (Φ : LocalizerMorphism W₁ W₂) (Ψ : LocalizerMorphism W₂ W₃)
    {X₁ Y₁ : C₁} {X₂ Y₂ : C₂} {X₃ Y₃ : C₃}
    [HasSmallLocalizedHom.{w₁} W₁ X₁ Y₁]
    [HasSmallLocalizedHom.{w₂} W₂ X₂ X₂]
    [HasSmallLocalizedHom.{w₂} W₂ X₂ Y₂]
    [HasSmallLocalizedHom.{w₂} W₂ Y₂ Y₂]
    [HasSmallLocalizedHom.{w₃} W₃ X₃ X₃]
    [HasSmallLocalizedHom.{w₃} W₃ X₃ Y₃]
    [HasSmallLocalizedHom.{w₃} W₃ Y₃ Y₃]
    (eX : Φ.functor.obj X₁ ≅ X₂) (eY : Φ.functor.obj Y₁ ≅ Y₂)
    (eX' : Ψ.functor.obj X₂ ≅ X₃) (eY' : Ψ.functor.obj Y₂ ≅ Y₃)
    (f : SmallHom.{w₁} W₁ X₁ Y₁) :
    (Φ.comp Ψ).smallHomMap'
        (Ψ.functor.mapIso eX ≪≫ eX')
        (Ψ.functor.mapIso eY ≪≫ eY') f =
      Ψ.smallHomMap' eX' eY' (Φ.smallHomMap' eX eY f) := by
  let h₂raw : HasSmallLocalizedHom.{w₂} W₂
      (Φ.functor.obj X₁) (Φ.functor.obj Y₁) :=
    hasSmallLocalizedHom_of_isos W₂ eX.symm eY.symm
  let eXcomp : Ψ.functor.obj (Φ.functor.obj X₁) ≅ X₃ :=
    Ψ.functor.mapIso eX ≪≫ eX'
  let eYcomp : Ψ.functor.obj (Φ.functor.obj Y₁) ≅ Y₃ :=
    Ψ.functor.mapIso eY ≪≫ eY'
  let h₃raw : HasSmallLocalizedHom.{w₃} W₃
      (Ψ.functor.obj (Φ.functor.obj X₁))
      (Ψ.functor.obj (Φ.functor.obj Y₁)) :=
    hasSmallLocalizedHom_of_isos W₃ eXcomp.symm eYcomp.symm
  let h₃comp : HasSmallLocalizedHom.{w₃} W₃
      ((Φ.comp Ψ).functor.obj X₁) ((Φ.comp Ψ).functor.obj Y₁) := by
    change HasSmallLocalizedHom.{w₃} W₃
      (Ψ.functor.obj (Φ.functor.obj X₁))
      (Ψ.functor.obj (Φ.functor.obj Y₁))
    exact h₃raw
  let GΦ := Φ.localizedFunctor W₁.Q W₂.Q
  let GΨ := Ψ.localizedFunctor W₂.Q W₃.Q
  let eΦ := CatCommSq.iso Φ.functor W₁.Q W₂.Q GΦ
  let eΨ := CatCommSq.iso Ψ.functor W₂.Q W₃.Q GΨ
  let ecomp : (Φ.functor ⋙ Ψ.functor) ⋙ W₃.Q ≅
      W₁.Q ⋙ (GΦ ⋙ GΨ) :=
    (CategoryTheory.Functor.associator Φ.functor Ψ.functor W₃.Q) ≪≫
      (CategoryTheory.Functor.isoWhiskerLeft Φ.functor eΨ) ≪≫
      (CategoryTheory.Functor.associator Φ.functor W₂.Q GΨ).symm ≪≫
      (CategoryTheory.Functor.isoWhiskerRight eΦ GΨ) ≪≫
      (CategoryTheory.Functor.associator W₁.Q GΦ GΨ)
  apply (SmallHom.equiv W₃ W₃.Q).injective
  rw [(Φ.comp Ψ).equiv_smallHomMap' W₁.Q W₃.Q
    eXcomp eYcomp (GΦ ⋙ GΨ) ecomp]
  rw [Ψ.equiv_smallHomMap' W₂.Q W₃.Q eX' eY' GΨ eΨ]
  rw [Φ.equiv_smallHomMap' W₁.Q W₂.Q eX eY GΦ eΦ]
  dsimp only [ecomp, eXcomp, eYcomp]
  simp only [Iso.trans_hom, Iso.trans_inv, NatTrans.comp_app,
    Functor.mapIso_hom, Functor.mapIso_inv, Functor.map_comp,
    Functor.comp_map, Functor.associator_hom_app,
    Functor.associator_inv_app,
    Category.id_comp, Category.comp_id]
  simp only [comp_functor, Functor.comp_obj, Functor.isoWhiskerLeft_hom, Functor.whiskerLeft_app, Iso.symm_hom,
    Functor.associator_inv_app, Functor.isoWhiskerRight_hom, Functor.whiskerRight_app, Category.id_comp,
    Functor.isoWhiskerRight_inv, Iso.symm_inv, Functor.associator_hom_app, Category.comp_id, Functor.isoWhiskerLeft_inv,
    Category.assoc]
  have hsource :
      W₃.Q.map (Ψ.functor.map eX.inv) ≫
          eΨ.hom.app (Φ.functor.obj X₁) =
        eΨ.hom.app X₂ ≫ GΨ.map (W₂.Q.map eX.inv) := by
    simpa only [Functor.comp_map] using eΨ.hom.naturality eX.inv
  rw [← Category.assoc (W₃.Q.map (Ψ.functor.map eX.inv))]
  rw [hsource]
  simp only [Category.assoc]
  have htarget :
      eΨ.inv.app (Φ.functor.obj Y₁) ≫
          W₃.Q.map (Ψ.functor.map eY.hom) =
        GΨ.map (W₂.Q.map eY.hom) ≫ eΨ.inv.app Y₂ := by
    simpa only [Functor.comp_map] using
      (eΨ.inv.naturality eY.hom).symm
  rw [← Category.assoc (eΨ.inv.app (Φ.functor.obj Y₁))]
  rw [htarget]
  simp only [Category.assoc]

universe w₁' w₂' w₃' wM

variable {M : Type wM} [AddMonoid M]
variable [HasShift C₁ M] [HasShift C₂ M] [HasShift C₃ M]

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
theorem smallShiftedHomMap_comp_localizer
    (Φ : LocalizerMorphism W₁ W₂) (Ψ : LocalizerMorphism W₂ W₃)
    [Φ.functor.CommShift M] [Ψ.functor.CommShift M]
    [W₁.IsCompatibleWithShift M] [W₂.IsCompatibleWithShift M]
    [W₃.IsCompatibleWithShift M]
    {X₁ Y₁ : C₁} {X₂ Y₂ : C₂} {X₃ Y₃ : C₃}
    [HasSmallLocalizedShiftedHom.{w₁'} W₁ M X₁ Y₁]
    [HasSmallLocalizedShiftedHom.{w₂'} W₂ M X₂ X₂]
    [HasSmallLocalizedShiftedHom.{w₂'} W₂ M X₂ Y₂]
    [HasSmallLocalizedShiftedHom.{w₂'} W₂ M Y₂ Y₂]
    [HasSmallLocalizedShiftedHom.{w₃'} W₃ M X₃ X₃]
    [HasSmallLocalizedShiftedHom.{w₃'} W₃ M X₃ Y₃]
    [HasSmallLocalizedShiftedHom.{w₃'} W₃ M Y₃ Y₃]
    (eX : Φ.functor.obj X₁ ≅ X₂) (eY : Φ.functor.obj Y₁ ≅ Y₂)
    (eX' : Ψ.functor.obj X₂ ≅ X₃) (eY' : Ψ.functor.obj Y₂ ≅ Y₃)
    {m : M} (f : SmallShiftedHom.{w₁'} W₁ X₁ Y₁ m) :
    letI hcompShift : (Φ.functor ⋙ Ψ.functor).CommShift M := inferInstance
    letI : (Φ.comp Ψ).functor.CommShift M := by
      change (Φ.functor ⋙ Ψ.functor).CommShift M
      exact hcompShift
    (Φ.comp Ψ).smallShiftedHomMap
        (Ψ.functor.mapIso eX ≪≫ eX')
        (Ψ.functor.mapIso eY ≪≫ eY') f =
      Ψ.smallShiftedHomMap eX' eY'
        (Φ.smallShiftedHomMap eX eY f) := by
  let hcompShift : (Φ.functor ⋙ Ψ.functor).CommShift M := inferInstance
  let hcompShift' : (Φ.comp Ψ).functor.CommShift M := by
    change (Φ.functor ⋙ Ψ.functor).CommShift M
    exact hcompShift
  let h₂XX : HasSmallLocalizedHom.{w₂'} W₂ X₂ X₂ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₂ M X₂ X₂
  let h₂XY : HasSmallLocalizedHom.{w₂'} W₂ X₂ Y₂ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₂ M X₂ Y₂
  let h₂YY : HasSmallLocalizedHom.{w₂'} W₂ Y₂ Y₂ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₂ M Y₂ Y₂
  let h₃XX : HasSmallLocalizedHom.{w₃'} W₃ X₃ X₃ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₃ M X₃ X₃
  let h₃XY : HasSmallLocalizedHom.{w₃'} W₃ X₃ Y₃ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₃ M X₃ Y₃
  let h₃YY : HasSmallLocalizedHom.{w₃'} W₃ Y₃ Y₃ :=
    hasSmallLocalizedHom_of_hasSmallLocalizedShiftedHom₀ W₃ M Y₃ Y₃
  let eYm : Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁) ≅
      (shiftFunctor C₂ m).obj Y₂ :=
    (Φ.functor.commShiftIso m).app Y₁ ≪≫ (shiftFunctor C₂ m).mapIso eY
  let h₂raw : HasSmallLocalizedHom.{w₂'} W₂
      (Φ.functor.obj X₁) (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)) :=
    hasSmallLocalizedHom_of_isos W₂ eX.symm eYm.symm
  let eXcomp : Ψ.functor.obj (Φ.functor.obj X₁) ≅ X₃ :=
    Ψ.functor.mapIso eX ≪≫ eX'
  let eYmcomp : Ψ.functor.obj
        (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)) ≅
      (shiftFunctor C₃ m).obj Y₃ :=
    Ψ.functor.mapIso eYm ≪≫ (Ψ.functor.commShiftIso m).app Y₂ ≪≫
      (shiftFunctor C₃ m).mapIso eY'
  let h₃raw : HasSmallLocalizedHom.{w₃'} W₃
      (Ψ.functor.obj (Φ.functor.obj X₁))
      (Ψ.functor.obj (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁))) :=
    hasSmallLocalizedHom_of_isos W₃ eXcomp.symm eYmcomp.symm
  let h₃comp : HasSmallLocalizedHom.{w₃'} W₃
      ((Φ.comp Ψ).functor.obj X₁)
      ((Φ.comp Ψ).functor.obj ((shiftFunctor C₁ m).obj Y₁)) := by
    change HasSmallLocalizedHom.{w₃'} W₃
      (Ψ.functor.obj (Φ.functor.obj X₁))
      (Ψ.functor.obj (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)))
    exact h₃raw
  let GΦ := Φ.localizedFunctor W₁.Q W₂.Q
  let GΨ := Ψ.localizedFunctor W₂.Q W₃.Q
  let eΦ := CatCommSq.iso Φ.functor W₁.Q W₂.Q GΦ
  let eΨ := CatCommSq.iso Ψ.functor W₂.Q W₃.Q GΨ
  let ecomp : (Φ.functor ⋙ Ψ.functor) ⋙ W₃.Q ≅
      W₁.Q ⋙ (GΦ ⋙ GΨ) :=
    (CategoryTheory.Functor.associator Φ.functor Ψ.functor W₃.Q) ≪≫
      (CategoryTheory.Functor.isoWhiskerLeft Φ.functor eΨ) ≪≫
      (CategoryTheory.Functor.associator Φ.functor W₂.Q GΨ).symm ≪≫
      (CategoryTheory.Functor.isoWhiskerRight eΦ GΨ) ≪≫
      (CategoryTheory.Functor.associator W₁.Q GΦ GΨ)
  let eYm' : Ψ.functor.obj ((shiftFunctor C₂ m).obj Y₂) ≅
      (shiftFunctor C₃ m).obj Y₃ :=
    (Ψ.functor.commShiftIso m).app Y₂ ≪≫ (shiftFunctor C₃ m).mapIso eY'
  let eXlhs : Ψ.functor.obj (Φ.functor.obj X₁) ≅ X₃ :=
    Ψ.functor.mapIso eX ≪≫ eX'
  let eYlhs : Ψ.functor.obj
        (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)) ≅
      (shiftFunctor C₃ m).obj Y₃ :=
    letI : (Φ.functor ⋙ Ψ.functor).CommShift M := hcompShift
    ((Φ.functor ⋙ Ψ.functor).commShiftIso m).app Y₁ ≪≫
      (shiftFunctor C₃ m).mapIso (Ψ.functor.mapIso eY ≪≫ eY')
  unfold smallShiftedHomMap
  apply (SmallHom.equiv W₃ W₃.Q).injective
  let fraw : SmallHom.{w₁'} W₁ X₁ ((shiftFunctor C₁ m).obj Y₁) := f
  change (SmallHom.equiv W₃ W₃.Q)
      ((Φ.comp Ψ).smallHomMap' eXlhs eYlhs fraw) =
    (SmallHom.equiv W₃ W₃.Q)
      (Ψ.smallHomMap' eX' eYm' (Φ.smallHomMap' eX eYm fraw))
  rw [(Φ.comp Ψ).equiv_smallHomMap' W₁.Q W₃.Q
    eXlhs eYlhs (GΦ ⋙ GΨ) ecomp]
  rw [Ψ.equiv_smallHomMap' W₂.Q W₃.Q eX' eYm' GΨ eΨ]
  rw [Φ.equiv_smallHomMap' W₁.Q W₂.Q eX eYm GΦ eΦ]
  dsimp only [ecomp, eYlhs, eYm, eYm']
  simp only [Iso.trans_hom, Iso.trans_inv, NatTrans.comp_app,
    Functor.mapIso_hom, Functor.mapIso_inv, Functor.map_comp,
    Functor.comp_map, Functor.associator_hom_app,
    Functor.associator_inv_app, Functor.map_id,
    Category.id_comp, Category.comp_id]
  simp only [comp_functor, Functor.comp_obj, Functor.isoWhiskerLeft_hom, Functor.whiskerLeft_app, Iso.symm_hom,
    Functor.associator_inv_app, Functor.isoWhiskerRight_hom, Functor.whiskerRight_app, Category.id_comp,
    Functor.isoWhiskerRight_inv, Iso.symm_inv, Functor.associator_hom_app, Category.comp_id, Functor.isoWhiskerLeft_inv,
    Iso.app_hom, Category.assoc]
  rw [show
    W₃.Q.map eXlhs.inv =
      W₃.Q.map eX'.inv ≫ W₃.Q.map (Ψ.functor.map eX.inv) by
    change W₃.Q.map (eX'.inv ≫ Ψ.functor.map eX.inv) = _
    simp]
  have hsource :
      W₃.Q.map (Ψ.functor.map eX.inv) ≫
          eΨ.hom.app (Φ.functor.obj X₁) =
        eΨ.hom.app X₂ ≫ GΨ.map (W₂.Q.map eX.inv) := by
    simpa only [Functor.comp_map] using eΨ.hom.naturality eX.inv
  rw [Category.assoc]
  rw [← Category.assoc (W₃.Q.map (Ψ.functor.map eX.inv))]
  rw [hsource]
  rw [Category.assoc]
  simp only [Functor.commShiftIso_comp_hom_app, Functor.map_comp,
    Category.assoc]
  have htarget₁ :
      eΨ.inv.app (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)) ≫
          W₃.Q.map (Ψ.functor.map
            ((Φ.functor.commShiftIso m).hom.app Y₁)) =
        GΨ.map (W₂.Q.map ((Φ.functor.commShiftIso m).hom.app Y₁)) ≫
          eΨ.inv.app ((shiftFunctor C₂ m).obj (Φ.functor.obj Y₁)) := by
    change
      eΨ.inv.app ((shiftFunctor C₁ m ⋙ Φ.functor).obj Y₁) ≫
          (Ψ.functor ⋙ W₃.Q).map
            ((Φ.functor.commShiftIso m).hom.app Y₁) =
        (W₂.Q ⋙ GΨ).map ((Φ.functor.commShiftIso m).hom.app Y₁) ≫
          eΨ.inv.app ((Φ.functor ⋙ shiftFunctor C₂ m).obj Y₁)
    exact (eΨ.inv.naturality
      ((Φ.functor.commShiftIso m).hom.app Y₁)).symm
  rw [← Category.assoc
    (eΨ.inv.app (Φ.functor.obj ((shiftFunctor C₁ m).obj Y₁)))]
  rw [htarget₁]
  simp only [Category.assoc]
  have hshift :
      W₃.Q.map ((Ψ.functor.commShiftIso m).hom.app
            (Φ.functor.obj Y₁)) ≫
          W₃.Q.map ((shiftFunctor C₃ m).map
            (Ψ.functor.map eY.hom)) =
        W₃.Q.map (Ψ.functor.map
            ((shiftFunctor C₂ m).map eY.hom)) ≫
          W₃.Q.map ((Ψ.functor.commShiftIso m).hom.app Y₂) := by
    simpa only [Functor.map_comp] using congrArg W₃.Q.map
      (Ψ.functor.commShiftIso_hom_naturality eY.hom m).symm
  rw [← Category.assoc
    (W₃.Q.map ((Ψ.functor.commShiftIso m).hom.app
      (Φ.functor.obj Y₁)))]
  rw [hshift]
  simp only [Category.assoc]
  have htarget₂ :
      eΨ.inv.app ((shiftFunctor C₂ m).obj (Φ.functor.obj Y₁)) ≫
          W₃.Q.map (Ψ.functor.map
            ((shiftFunctor C₂ m).map eY.hom)) =
        GΨ.map (W₂.Q.map ((shiftFunctor C₂ m).map eY.hom)) ≫
          eΨ.inv.app ((shiftFunctor C₂ m).obj Y₂) := by
    simpa only [Functor.comp_map] using
      (eΨ.inv.naturality ((shiftFunctor C₂ m).map eY.hom)).symm
  rw [← Category.assoc
    (eΨ.inv.app ((shiftFunctor C₂ m).obj (Φ.functor.obj Y₁)))]
  rw [htarget₂]
  simp only [Category.assoc]

end CategoryTheory.LocalizerMorphism

namespace CategoryTheory.Localization

universe u₁ u₂ u₃ v₁ v₂ v₃ w

variable {C : Type u₁} [Category.{v₁} C]
variable {D : Type u₂} [Category.{v₂} D]
variable {E : Type u₃} [Category.{v₃} E]
variable {W : MorphismProperty C} (L : C ⥤ D) [L.IsLocalization W]
variable {A : Type w} [AddMonoid A]
variable [HasShift C A] [HasShift D A] [HasShift E A]
variable [L.CommShift A]

set_option backward.defeqAttrib.useBackward true in
/-- A natural transformation lifted through a localization commutes with
shifts when the two lifting comparison isomorphisms do. -/
theorem liftNatTrans_commShift
    (F₁ F₂ : C ⥤ E) (F₁' F₂' : D ⥤ E)
    [F₁.CommShift A] [F₂.CommShift A]
    [F₁'.CommShift A] [F₂'.CommShift A]
    [Lifting L W F₁ F₁'] [Lifting L W F₂ F₂']
    [NatTrans.CommShift (Lifting.iso L W F₁ F₁').hom A]
    [NatTrans.CommShift (Lifting.iso L W F₂ F₂').hom A]
    (t : F₁ ⟶ F₂) [NatTrans.CommShift t A] :
    NatTrans.CommShift (liftNatTrans L W F₁ F₂ F₁' F₂' t) A := by
  let α := liftNatTrans L W F₁ F₂ F₁' F₂' t
  constructor
  intro a
  apply natTrans_ext L W
  intro X
  simp only [NatTrans.comp_app, Functor.whiskerRight_app,
    Functor.whiskerLeft_app]
  rw [← cancel_epi (F₁'.map ((L.commShiftIso a).hom.app X))]
  simp only [← Category.assoc]
  have hn := (liftNatTrans L W F₁ F₂ F₁' F₂' t).naturality
    ((L.commShiftIso a).hom.app X)
  dsimp at hn
  rw [hn]
  simp only [liftNatTrans_app]
  simp only [Functor.map_comp]
  simp only [← Category.assoc]
  rw [← Functor.commShiftIso_comp_hom_app]
  rw [NatTrans.shift_app_comm
    (Lifting.iso L W F₁ F₁').hom a X]
  simp only [Category.assoc]
  rw [NatTrans.shift_app_comm_assoc t a X]
  rw [NatTrans.shift_app_comm
    (Lifting.iso L W F₂ F₂').inv a X]
  rw [Functor.commShiftIso_comp_hom_app]

end CategoryTheory.Localization

