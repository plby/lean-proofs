                (ZMod q) n m g hg hdeg hm hmn t := by
              rw [← Category.assoc, z.2]⟩,
    fullResidueUnitFiberDistinctPoint_coordinates_injective
      q n m F g hg hdeg hm hmn t z.1⟩
  invFun x := ⟨fullResidueUnitFiberPointToDistinct
      q n m F g hg hdeg hm hmn t x.1.1 x.2, by
        apply (cancel_mono (fullResidueUnitFiberDistinctι
          (ZMod q) n m g hg hdeg hm hmn t)).1
        simp only [Category.assoc]
        rw [fullResidueUnitFiberDistinctTwistedFrobenius_ι]
        rw [← Category.assoc,
          fullResidueUnitFiberPointToDistinct_ι]
        rw [x.1.2]⟩
  left_inv z := by
    apply Subtype.ext
    apply (cancel_mono (fullResidueUnitFiberDistinctι
      (ZMod q) n m g hg hdeg hm hmn t)).1
    rw [fullResidueUnitFiberPointToDistinct_ι]
  right_inv x := by
    apply Subtype.ext
    apply Subtype.ext
    change fullResidueUnitFiberPointToDistinct
        q n m F g hg hdeg hm hmn t x.1.1 x.2 ≫
      fullResidueUnitFiberDistinctι
        (ZMod q) n m g hg hdeg hm hmn t = x.1.1
