open scoped BigOperators Classical

namespace Erdos157.SawinGeometry

open Module Set Set.powersetCard CategoryTheory AlgebraicGeometry

/-- Functions on three coordinates are equivalently triples.  We record this
explicitly because the arithmetic trace identities are naturally written as
three nested sums, while the representation-theoretic averages use a single
sum over a permutation family. -/
def finThreeArrowEquiv (A : Type*) : (Fin 3 → A) ≃ A × A × A where
  toFun f := (f 0, f 1, f 2)
  invFun x := ![x.1, x.2.1, x.2.2]
  left_inv f := by
    funext i
    fin_cases i <;> rfl
  right_inv x := rfl

theorem sum_fin_three_arrow
    {K A : Type*} [AddCommMonoid K] [Fintype A]
    (f : (Fin 3 → A) → K) :
    (∑ x : Fin 3 → A, f x) =
      ∑ a : A, ∑ b : A, ∑ c : A, f ![a, b, c] := by
  calc
    _ = ∑ x : A × A × A, f ((finThreeArrowEquiv A).symm x) :=
      Fintype.sum_equiv (finThreeArrowEquiv A) f
        (fun x => f ((finThreeArrowEquiv A).symm x)) (by
          intro x
          congr 1
          funext i
          fin_cases i <;> rfl)
    _ = _ := by
      rw [Fintype.sum_prod_type]
      simp_rw [Fintype.sum_prod_type]
      rfl

theorem sum_fin_two_arrow
    {K A : Type*} [AddCommMonoid K] [Fintype A]
    (f : (Fin 2 → A) → K) :
    (∑ x : Fin 2 → A, f x) =
      ∑ a : A, ∑ b : A, f ![a, b] := by
  calc
    _ = ∑ x : A × A, f ((finTwoArrowEquiv A).symm x) :=
      Fintype.sum_equiv (finTwoArrowEquiv A) f
        (fun x => f ((finTwoArrowEquiv A).symm x)) (by
          intro x
          congr 1
          funext i
          fin_cases i <;> rfl)
    _ = _ := by
      rw [Fintype.sum_prod_type]
      rfl

def powersetCardEquivFinsetPowerset
    (I : Type*) [Fintype I] [DecidableEq I] (degree : ℕ) :
    powersetCard I degree ≃
      ↥((Finset.univ : Finset I).powersetCard degree) where
  toFun s := ⟨s.1, Finset.mem_powersetCard.mpr
    ⟨Finset.subset_univ _, s.2⟩⟩
  invFun s := ⟨s.1, (Finset.mem_powersetCard.mp s.2).2⟩
  left_inv s := rfl
  right_inv s := rfl

/-- Trace of an induced exterior-power endomorphism, expanded in the wedge
basis associated to a finite ordered basis. -/
theorem trace_exteriorPower_map_eq_sum_det
    {K V I : Type*} [Field K] [AddCommGroup V] [Module K V]
    [Fintype I] [DecidableEq I] [LinearOrder I]
    (b : Basis I K V) (degree : ℕ) (f : V →ₗ[K] V) :
    LinearMap.trace K (⋀[K]^degree V) (exteriorPower.map degree f) =
      ∑ s : powersetCard I degree,
        (Matrix.of fun i j : Fin degree =>
          b.coord (powersetCard.ofFinEmbEquiv.symm s j)
            (f (b (powersetCard.ofFinEmbEquiv.symm s i)))).det := by
  rw [LinearMap.trace_eq_matrix_trace K (b.exteriorPower degree)]
  unfold Matrix.trace
  apply Finset.sum_congr rfl
  intro s _hs
  rw [Matrix.diag_apply, LinearMap.toMatrix_apply]
  rw [exteriorPower.basis_repr_apply]
  rw [exteriorPower.basis_apply]
  rw [exteriorPower.map_apply_ιMulti_family]
  unfold exteriorPower.ιMulti_family
  rw [exteriorPower.ιMultiDual_apply_ιMulti]
  rfl

theorem trace_exteriorPower_map_eq_sum_principalMinors
    {K V I : Type*} [Field K] [AddCommGroup V] [Module K V]
    [Fintype I] [DecidableEq I] [LinearOrder I]
    (b : Basis I K V) (degree : ℕ) (f : V →ₗ[K] V) :
    LinearMap.trace K (⋀[K]^degree V) (exteriorPower.map degree f) =
      ∑ s : powersetCard I degree,
        ((LinearMap.toMatrix b b f).submatrix
          (powersetCard.ofFinEmbEquiv.symm s)
          (powersetCard.ofFinEmbEquiv.symm s)).det := by
  rw [trace_exteriorPower_map_eq_sum_det b]
  apply Finset.sum_congr rfl
  intro s _hs
  rw [← Matrix.det_transpose]
  congr 1
  ext i j
  simp only [Matrix.transpose_apply, Matrix.submatrix_apply,
    LinearMap.toMatrix_apply, Matrix.of_apply, Basis.coord_apply]

theorem coeff_det_one_add_X_smul_eq_trace_exteriorPower
    {K V I : Type*} [Field K] [AddCommGroup V] [Module K V]
    [Fintype I] [DecidableEq I] [LinearOrder I]
    (b : Basis I K V) (degree : ℕ) (f : V →ₗ[K] V) :
    Polynomial.coeff (Matrix.det (1 + (Polynomial.X : Polynomial K) •
        (LinearMap.toMatrix b b f).map Polynomial.C)) degree =
      LinearMap.trace K (⋀[K]^degree V) (exteriorPower.map degree f) := by
  rw [Matrix.coeff_det_one_add_X_smul_eq_sum_minors]
  rw [trace_exteriorPower_map_eq_sum_principalMinors b]
  let e := powersetCardEquivFinsetPowerset I degree
  rw [Finset.sum_subtype
    ((Finset.univ : Finset I).powersetCard degree)
    (fun _ => Iff.rfl)
    (fun s => ((LinearMap.toMatrix b b f).submatrix
      (Subtype.val : s → I) (Subtype.val : s → I)).det)]
  let minor : ↥((Finset.univ : Finset I).powersetCard degree) → K :=
    fun s => ((LinearMap.toMatrix b b f).submatrix
      (Subtype.val : ↥s.1 → I)
      (Subtype.val : ↥s.1 → I)).det
  change (∑ s, minor s) = _
  rw [← e.sum_comp minor]
  apply Finset.sum_congr rfl
  intro s _hs
  dsimp only [minor, e, powersetCardEquivFinsetPowerset]
  let A := (LinearMap.toMatrix b b f).submatrix
      (Subtype.val : s.1 → I) (Subtype.val : s.1 → I)
  have hdet := Matrix.det_submatrix_equiv_self
    (powersetCard.orderIsoOfFin s).toEquiv A
  exact hdet.symm

end Erdos157.SawinGeometry

namespace Erdos157.SawinGeometry

open Module Set Set.powersetCard

theorem character_exteriorPower_permutation_eq_sum_det
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (degree : ℕ) (g : Equiv.Perm H) :
    (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm H) H) degree).character g =
      ∑ s : powersetCard H degree,
        (Matrix.of fun i j : Fin degree =>
          if (powersetCard.ofFinEmbEquiv.symm s j) =
              g (powersetCard.ofFinEmbEquiv.symm s i)
          then 1 else 0 : Matrix (Fin degree) (Fin degree) K).det := by
  rw [show (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm H) H) degree).character g =
      LinearMap.trace K (⋀[K]^degree (MonoidAlgebra K H))
        (exteriorPower.map degree
          (Representation.ofMulAction K (Equiv.Perm H) H g)) by rfl]
  rw [trace_exteriorPower_map_eq_sum_det (MonoidAlgebra.basis H K)]
  apply Finset.sum_congr rfl
  intro s _hs
  congr 1
  ext i j
  show (((Representation.ofMulAction K (Equiv.Perm H) H) g)
      (MonoidAlgebra.single (powersetCard.ofFinEmbEquiv.symm s i) 1)).coeff
        (powersetCard.ofFinEmbEquiv.symm s j) =
      if powersetCard.ofFinEmbEquiv.symm s j =
          g (powersetCard.ofFinEmbEquiv.symm s i) then 1 else 0
  rw [Representation.ofMulAction_single]
  simp only [MonoidAlgebra.coeff_single_apply]
  simpa only [Equiv.Perm.smul_def, eq_comm]

theorem toMatrix_ofMulAction_eq_permMatrix
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) :
    LinearMap.toMatrix (MonoidAlgebra.basis H K) (MonoidAlgebra.basis H K)
        (Representation.ofMulAction K (Equiv.Perm H) H g) =
      (g⁻¹).permMatrix K := by
  ext i j
  rw [LinearMap.toMatrix_apply, MonoidAlgebra.basis_apply,
    Representation.ofMulAction_single]
  simp only [Basis.coord_apply, MonoidAlgebra.basis,
    MonoidAlgebra.coeffLinearEquiv_apply,
    Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply,
    Option.mem_some_iff]
  simp only [MonoidAlgebra.coeff_single_apply, Equiv.Perm.smul_def,
    Equiv.Perm.inv_def, eq_comm]
  by_cases h : i = g j
  · subst i
    simp
  · have hj : j ≠ g.symm i := by
      intro hji
      apply h
      rw [← g.apply_symm_apply i, ← hji]
    simp [h, hj]

/-- A permutation restricted to one of its invariant finite subsets. -/
def permutationRestriction
    {H : Type*} [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (s : Finset H)
    (hs : ∀ x, x ∈ s ↔ g x ∈ s) : Equiv.Perm s where
  toFun x := ⟨g x, (hs x).mp x.2⟩
  invFun x := ⟨g.symm x, (hs (g.symm x)).mpr (by simpa using x.2)⟩
  left_inv x := Subtype.ext (g.symm_apply_apply x)
  right_inv x := Subtype.ext (g.apply_symm_apply x)

/-- The index permutation induced by `g` on the increasing enumeration of
an invariant finite subset. -/
def powersetCardIndexPermutation
    {H : Type*} [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree)
    (hs : ∀ x, x ∈ s ↔ g x ∈ s) : Equiv.Perm (Fin degree) :=
  (powersetCard.orderIsoOfFin s).toEquiv.trans
    ((permutationRestriction g s hs).trans
      (powersetCard.orderIsoOfFin s).toEquiv.symm)

theorem powersetCardIndexPermutation_spec
    {H : Type*} [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree)
    (hs : ∀ x, x ∈ s ↔ g x ∈ s) (i : Fin degree) :
    powersetCard.ofFinEmbEquiv.symm s
        (powersetCardIndexPermutation g s hs i) =
      g (powersetCard.ofFinEmbEquiv.symm s i) := by
  change ↑(powersetCard.orderIsoOfFin s
      (powersetCardIndexPermutation g s hs i)) =
    g ↑(powersetCard.orderIsoOfFin s i)
  rw [show powersetCard.orderIsoOfFin s
      (powersetCardIndexPermutation g s hs i) =
        permutationRestriction g s hs (powersetCard.orderIsoOfFin s i) by
    unfold powersetCardIndexPermutation
    simp only [Equiv.trans_apply]
    exact (powersetCard.orderIsoOfFin s).apply_symm_apply
      (permutationRestriction g s hs (powersetCard.orderIsoOfFin s i))]
  rfl

theorem powersetCard_invariant_iff_forward
    {H : Type*} [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree) :
    (∀ x, x ∈ s ↔ g x ∈ s) ↔ ∀ x ∈ s, g x ∈ s := by
  constructor
  · intro h x hx
    exact (h x).mp hx
  · intro h x
    constructor
    · exact h x
    · intro hgx
      let f : s → s := fun y => ⟨g y, h y y.2⟩
      have hf : Function.Injective f := by
        intro y z hyz
        apply Subtype.ext
        exact g.injective (congrArg Subtype.val hyz)
      have hsurj : Function.Surjective f :=
        Finite.surjective_of_injective hf
      obtain ⟨y, hy⟩ := hsurj ⟨g x, hgx⟩
      have hyx : (y : H) = x :=
        g.injective (congrArg Subtype.val hy)
      simpa only [hyx] using y.2

theorem exteriorPower_permutation_minor_eq_permMatrix
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree)
    (hs : ∀ x, x ∈ s ↔ g x ∈ s) :
    (Matrix.of fun i j : Fin degree =>
      if powersetCard.ofFinEmbEquiv.symm s j =
          g (powersetCard.ofFinEmbEquiv.symm s i)
      then 1 else 0 : Matrix (Fin degree) (Fin degree) K) =
        (powersetCardIndexPermutation g s hs).permMatrix K := by
  ext i j
  simp only [Matrix.of_apply, Equiv.Perm.permMatrix,
    PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_some_iff]
  rw [← powersetCardIndexPermutation_spec g s hs i]
  simp only [EmbeddingLike.apply_eq_iff_eq, eq_comm]

theorem exteriorPower_permutation_minor_det_of_invariant
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree)
    (hs : ∀ x, x ∈ s ↔ g x ∈ s) :
    (Matrix.of fun i j : Fin degree =>
      if powersetCard.ofFinEmbEquiv.symm s j =
          g (powersetCard.ofFinEmbEquiv.symm s i)
      then 1 else 0 : Matrix (Fin degree) (Fin degree) K).det =
        (↑((powersetCardIndexPermutation g s hs).sign) : K) := by
  rw [exteriorPower_permutation_minor_eq_permMatrix g s hs,
    Matrix.det_permutation]

theorem exteriorPower_permutation_minor_det_of_not_invariant
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    {degree : ℕ} (g : Equiv.Perm H) (s : powersetCard H degree)
    (hs : ¬ ∀ x, x ∈ s ↔ g x ∈ s) :
    (Matrix.of fun i j : Fin degree =>
      if powersetCard.ofFinEmbEquiv.symm s j =
          g (powersetCard.ofFinEmbEquiv.symm s i)
      then 1 else 0 : Matrix (Fin degree) (Fin degree) K).det = 0 := by
  rw [powersetCard_invariant_iff_forward] at hs
  push_neg at hs
  obtain ⟨x, hx, hgx⟩ := hs
  let xs : s := ⟨x, hx⟩
  obtain ⟨i, hi⟩ := (powersetCard.orderIsoOfFin s).surjective xs
  apply Matrix.det_eq_zero_of_row_eq_zero i
  intro j
  simp only [Matrix.of_apply, ite_eq_right_iff, one_ne_zero, imp_false]
  intro heq
  apply hgx
  have hj : powersetCard.ofFinEmbEquiv.symm s j ∈ s := by
    rw [powersetCard.ofFinEmbEquiv_symm_apply]
    exact Finset.orderEmbOfFin_mem s.val s.prop j
  have hix : powersetCard.ofFinEmbEquiv.symm s i = x := by
    change ↑(powersetCard.orderIsoOfFin s i) = x
    rw [hi]
  rw [hix] at heq
  rw [← heq]
  exact hj

/-- Character of an exterior power of a permutation module as the signed
count of invariant subsets of the prescribed size. -/
theorem character_exteriorPower_permutation_eq_sum_invariant_sign
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (degree : ℕ) (g : Equiv.Perm H) :
    (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm H) H) degree).character g =
      ∑ s : powersetCard H degree,
        if hs : ∀ x, x ∈ s ↔ g x ∈ s then
          (↑((powersetCardIndexPermutation g s hs).sign) : K)
        else 0 := by
  classical
  rw [character_exteriorPower_permutation_eq_sum_det]
  apply Finset.sum_congr rfl
  intro s _hs
  split_ifs with hs
  · exact exteriorPower_permutation_minor_det_of_invariant g s hs
  · exact exteriorPower_permutation_minor_det_of_not_invariant g s hs

/-- The virtual character whose value is the polynomial von Mangoldt
factorization function on a permutation. -/
noncomputable def permutationVirtualMangoldt
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H) : K :=
  ∑ degree : Fin (Fintype.card H + 1),
    (-1 : K) ^ ((degree : ℕ) + 1) * (degree : ℕ) *
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm H) H)
          (degree : ℕ)).character g

theorem permutationVirtualMangoldt_eq_derivative_det
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H) :
    permutationVirtualMangoldt K H g =
      Polynomial.eval (-1 : K) (Polynomial.derivative
        (Matrix.det (1 + (Polynomial.X : Polynomial K) •
          ((g⁻¹).permMatrix K).map Polynomial.C))) := by
  let M : Matrix H H K := (g⁻¹).permMatrix K
  let D : Polynomial K := Matrix.det
    (1 + (Polynomial.X : Polynomial K) • M.map Polynomial.C)
  have hDle : D.natDegree ≤ Fintype.card H := by
    rw [show D = Matrix.det
        ((Polynomial.X : Polynomial K) • M.map Polynomial.C +
          (1 : Matrix H H K).map Polynomial.C) by
      unfold D
      congr 1
      apply Matrix.ext
      intro i j
      simp [Matrix.one_apply, add_comm]]
    exact Polynomial.natDegree_det_X_add_C_le M 1
  rw [Polynomial.derivative_eval]
  rw [D.sum_over_range' (fun n => by simp) (Fintype.card H + 1)
    (Nat.lt_succ_of_le hDle)]
  rw [← Fin.sum_univ_eq_sum_range
    (fun n => D.coeff n * (n : K) * (-1 : K) ^ (n - 1))
    (Fintype.card H + 1)]
  unfold permutationVirtualMangoldt
  apply Finset.sum_congr rfl
  intro degree _hdegree
  have hcoeff := coeff_det_one_add_X_smul_eq_trace_exteriorPower
    (MonoidAlgebra.basis H K) (degree : ℕ)
      (Representation.ofMulAction K (Equiv.Perm H) H g)
  rw [toMatrix_ofMulAction_eq_permMatrix] at hcoeff
  change D.coeff degree =
    (Representation.exteriorPower
      (Representation.ofMulAction K (Equiv.Perm H) H)
        (degree : ℕ)).character g at hcoeff
  rw [← hcoeff]
  change (-1 : K) ^ ((degree : ℕ) + 1) * (degree : ℕ) *
      D.coeff degree =
    D.coeff degree * (degree : ℕ) *
      (-1 : K) ^ ((degree : ℕ) - 1)
  rcases degree with ⟨_ | n, hn⟩
  · simp
  · simp only [Fin.val_mk, Nat.cast_succ, Nat.succ_sub_one]
    rw [show n + 1 + 1 = n + 2 by omega, pow_add]
    norm_num
    ring

end Erdos157.SawinGeometry

namespace Erdos157.SawinGeometry

open Module Set Set.powersetCard

theorem det_one_sub_permMatrix_block_eq_zero
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (p : H → Prop) [DecidablePred p]
    (hp : ∃ x, p x) (hinv : ∀ x, p x ↔ p (g x)) :
    Matrix.det (Matrix.toSquareBlockProp
      ((1 : Matrix H H K) - (g⁻¹).permMatrix K) p) = 0 := by
  apply (Matrix.exists_mulVec_eq_zero_iff).1
  refine ⟨fun _ ↦ 1, ?_, ?_⟩
  · obtain ⟨x, hx⟩ := hp
    intro hone
    have h := congrFun hone ⟨x, hx⟩
    exact one_ne_zero h
  · ext i
    simp only [Matrix.mulVec, dotProduct, Matrix.toSquareBlockProp_def, Matrix.of_apply,
      Matrix.sub_apply, Matrix.one_apply, Pi.one_apply, Pi.zero_apply, mul_one,
      Equiv.Perm.permMatrix, PEquiv.toMatrix_apply,
      Equiv.toPEquiv_apply, Option.mem_some_iff]
    have hpre : p (g.symm i) := by
      rw [hinv (g.symm i)]
      simpa using i.2
    rw [Finset.sum_sub_distrib]
    rw [Finset.sum_eq_single i]
    · rw [Finset.sum_eq_single ⟨g.symm i, hpre⟩]
      · simp
      · intro b _ hb
        simp only [ite_eq_right_iff, one_ne_zero, imp_false]
        exact fun h ↦ hb (Subtype.ext h.symm)
      · simp
    · intro b _ hb
      simp [Subtype.coe_ne_coe.mpr hb.symm]
    · simp

theorem eval_det_one_add_X_permMatrix_block_eq_zero
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (p : H → Prop) [DecidablePred p]
    (hp : ∃ x, p x) (hinv : ∀ x, p x ↔ p (g x)) :
    Polynomial.eval (-1 : K) (Matrix.det (Matrix.toSquareBlockProp
      (1 + (Polynomial.X : Polynomial K) •
        ((g⁻¹).permMatrix K).map Polynomial.C) p)) = 0 := by
  change (Polynomial.evalRingHom (-1 : K)) (Matrix.det
    (Matrix.toSquareBlockProp
      (1 + (Polynomial.X : Polynomial K) •
        ((g⁻¹).permMatrix K).map Polynomial.C) p)) = 0
  rw [RingHom.map_det]
  have hmatrix : (Polynomial.evalRingHom (-1 : K)).mapMatrix
      (Matrix.toSquareBlockProp
        (1 + (Polynomial.X : Polynomial K) •
          ((g⁻¹).permMatrix K).map Polynomial.C) p) =
      Matrix.toSquareBlockProp
        ((1 : Matrix H H K) - (g⁻¹).permMatrix K) p := by
    ext i j
    simp only [PEquiv.map_toMatrix, RingHom.mapMatrix_apply, Polynomial.coe_evalRingHom, Matrix.map_apply]
    by_cases h₁ : (i : H) = (j : H)
    · rw [if_pos h₁]
      by_cases h₂ : g.symm (i : H) = (j : H)
      · rw [if_pos h₂]
        rw [if_pos h₁, if_pos h₂]
        simp
      · rw [if_neg h₂]
        rw [if_pos h₁, if_neg h₂]
        simp
    · rw [if_neg h₁]
      by_cases h₂ : g.symm (i : H) = (j : H)
      · rw [if_pos h₂]
        rw [if_neg h₁, if_pos h₂]
        simp
      · rw [if_neg h₂]
        rw [if_neg h₁, if_neg h₂]
        simp
  rw [hmatrix]
  exact det_one_sub_permMatrix_block_eq_zero g p hp hinv

noncomputable def permutationDetMatrix
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) : Matrix H H (Polynomial K) :=
  1 + (Polynomial.X : Polynomial K) •
    ((g⁻¹).permMatrix K).map Polynomial.C

theorem eval_det_permutationDetMatrix_block_eq_zero
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (p : H → Prop) [DecidablePred p]
    (hp : ∃ x, p x) (hinv : ∀ x, p x ↔ p (g x)) :
    Polynomial.eval (-1 : K) (Matrix.det (Matrix.toSquareBlockProp
      (permutationDetMatrix K H g) p)) = 0 := by
  exact eval_det_one_add_X_permMatrix_block_eq_zero g p hp hinv

theorem permutationDetMatrix_apply_eq_zero_of_invariant_predicate
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (p : H → Prop) [DecidablePred p]
    (hinv : ∀ x, p x ↔ p (g x))
    (i j : H) (hi : ¬p i) (hj : p j) :
    permutationDetMatrix K H g i j = 0 := by
  have hij : i ≠ j := by
    intro h
    exact hi (h ▸ hj)
  have hperm : g.symm i ≠ j := by
    intro h
    have hgj : g j = i := g.eq_symm_apply.mp h.symm
    apply hi
    rw [← hgj]
    exact (hinv j).mp hj
  simp [permutationDetMatrix, Matrix.one_apply, hij, hperm]

theorem det_permutationDetMatrix_factor_of_invariant_predicate
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (p : H → Prop) [DecidablePred p]
    (hinv : ∀ x, p x ↔ p (g x)) :
    Matrix.det (permutationDetMatrix K H g) =
      Matrix.det (Matrix.toSquareBlockProp
        (permutationDetMatrix K H g) p) *
      Matrix.det (Matrix.toSquareBlockProp
        (permutationDetMatrix K H g) (fun x ↦ ¬p x)) := by
  apply Matrix.twoBlockTriangular_det (permutationDetMatrix K H g) p
  intro i hi j hj
  exact permutationDetMatrix_apply_eq_zero_of_invariant_predicate
    g p hinv i j hi hj

theorem derivative_det_one_add_X_permMatrix_eq_zero_of_invariant_subset
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (s : Finset H) (hs : s.Nonempty)
    (hsne : s ≠ Finset.univ)
    (hinv : ∀ x, x ∈ s ↔ g x ∈ s) :
    Polynomial.eval (-1 : K) (Polynomial.derivative
      (Matrix.det (permutationDetMatrix K H g))) = 0 := by
  classical
  let p : H → Prop := fun x ↦ decide (x ∈ s) = true
  have hp : ∃ x, p x := by
    obtain ⟨x, hx⟩ := hs
    exact ⟨x, by simp [p, hx]⟩
  have hpc : ∃ x, ¬p x := by
    have hex : ∃ x, x ∉ s := by
      by_contra h
      push Not at h
      apply hsne
      exact Finset.eq_univ_iff_forall.mpr h
    obtain ⟨x, hx⟩ := hex
    exact ⟨x, by simp [p, hx]⟩
  have hinvp : ∀ x, p x ↔ p (g x) := by
    intro x
    simp only [p, decide_eq_true_eq]
    exact hinv x
  have hinvpc : ∀ x, ¬p x ↔ ¬p (g x) := fun x ↦ not_congr (hinvp x)
  rw [det_permutationDetMatrix_factor_of_invariant_predicate g p hinvp,
    Polynomial.derivative_mul, Polynomial.eval_add,
    Polynomial.eval_mul, Polynomial.eval_mul]
  have hleft : Polynomial.eval (-1 : K)
      (Matrix.det (Matrix.toSquareBlockProp
        (permutationDetMatrix K H g) p)) = 0 := by
    exact eval_det_permutationDetMatrix_block_eq_zero
      (K := K) (H := H) g p hp hinvp
  have hright : Polynomial.eval (-1 : K)
      (Matrix.det (Matrix.toSquareBlockProp
        (permutationDetMatrix K H g) (fun x ↦ ¬p x))) = 0 := by
    exact eval_det_permutationDetMatrix_block_eq_zero
      (K := K) (H := H) g (fun x ↦ ¬p x) hpc hinvpc
  rw [hleft, hright]
  simp

theorem permutationVirtualMangoldt_eq_zero_of_invariant_subset
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H) (s : Finset H) (hs : s.Nonempty)
    (hsne : s ≠ Finset.univ)
    (hinv : ∀ x, x ∈ s ↔ g x ∈ s) :
    permutationVirtualMangoldt K H g = 0 := by
  rw [permutationVirtualMangoldt_eq_derivative_det]
  simpa only [permutationDetMatrix] using
    derivative_det_one_add_X_permMatrix_eq_zero_of_invariant_subset
      (K := K) g s hs hsne hinv

theorem character_exteriorPower_permutation_top
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H) :
    (Representation.exteriorPower
      (Representation.ofMulAction K (Equiv.Perm H) H)
        (Fintype.card H)).character g = (↑g.sign : K) := by
  have hcoeff := coeff_det_one_add_X_smul_eq_trace_exteriorPower
    (MonoidAlgebra.basis H K) (Fintype.card H)
      (Representation.ofMulAction K (Equiv.Perm H) H g)
  rw [toMatrix_ofMulAction_eq_permMatrix] at hcoeff
  change (permutationDetMatrix K H g).det.coeff (Fintype.card H) =
    (Representation.exteriorPower
      (Representation.ofMulAction K (Equiv.Perm H) H)
        (Fintype.card H)).character g at hcoeff
  rw [← hcoeff]
  have hmatrix : permutationDetMatrix K H g =
      (Polynomial.X : Polynomial K) •
        ((g⁻¹).permMatrix K).map Polynomial.C +
          (1 : Matrix H H K).map Polynomial.C := by
    ext i j
    simp [permutationDetMatrix, Matrix.one_apply, add_comm]
  rw [hmatrix, Polynomial.coeff_det_X_add_C_card,
    Matrix.det_permutation, Equiv.Perm.sign_inv]

theorem character_exteriorPower_permutation_eq_zero_of_only_trivial_invariant_subset
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H) (degree : ℕ) (hdegree : 0 < degree)
    (hdegreeTop : degree < Fintype.card H)
    (htrans : ∀ s : Finset H, (∀ x, x ∈ s ↔ g x ∈ s) →
      s = ∅ ∨ s = Finset.univ) :
    (Representation.exteriorPower
      (Representation.ofMulAction K (Equiv.Perm H) H) degree).character g = 0 := by
  rw [character_exteriorPower_permutation_eq_sum_invariant_sign]
  apply Finset.sum_eq_zero
  intro s _hs
  split_ifs with hinv
  · rcases htrans s.1 hinv with hempty | huniv
    · have hcard := Set.powersetCard.card_eq s
      rw [hempty, Finset.card_empty] at hcard
      omega
    · have hcard := Set.powersetCard.card_eq s
      rw [huniv, Finset.card_univ] at hcard
      omega
  · rfl

theorem permutation_isCycle_of_only_trivial_invariant_subset
    {H : Type*} [Fintype H] [DecidableEq H] [Nonempty H]
    (g : Equiv.Perm H) (hcard : 2 ≤ Fintype.card H)
    (htrans : ∀ s : Finset H, (∀ x, x ∈ s ↔ g x ∈ s) →
      s = ∅ ∨ s = Finset.univ) :
    g.IsCycle := by
  classical
  let x : H := Classical.choice (inferInstance : Nonempty H)
  have hx : g x ≠ x := by
    intro hfix
    have hinv : ∀ y, y ∈ ({x} : Finset H) ↔ g y ∈ ({x} : Finset H) := by
      intro y
      simp only [Finset.mem_singleton]
      constructor
      · intro hy
        rw [hy, hfix]
      · intro hy
        apply g.injective
        rw [hy, hfix]
    rcases htrans {x} hinv with hempty | huniv
    · exact Finset.singleton_ne_empty x hempty
    · have hc := congrArg Finset.card huniv
      simp only [Finset.card_singleton, Finset.card_univ] at hc
      omega
  have hcycleOn := g.isCycleOn_support_cycleOf x
  have hinvCycle : ∀ y, y ∈ (g.cycleOf x).support ↔
      g y ∈ (g.cycleOf x).support := by
    intro y
    exact hcycleOn.apply_mem_iff.symm
  have hnonempty : (g.cycleOf x).support.Nonempty :=
    Equiv.Perm.support_cycleOf_nonempty.mpr hx
  have huniv : (g.cycleOf x).support = Finset.univ := by
    rcases htrans (g.cycleOf x).support hinvCycle with hempty | huniv
    · exact (hnonempty.ne_empty hempty).elim
    · exact huniv
  have hxmem : x ∈ (g.cycleOf x).support := by
    rw [huniv]
    exact Finset.mem_univ x
  refine ⟨x, hx, ?_⟩
  intro y _hy
  apply hcycleOn.2 hxmem
  rw [huniv]
  exact Finset.mem_univ y

theorem permutation_support_eq_univ_of_only_trivial_invariant_subset
    {H : Type*} [Fintype H] [DecidableEq H]
    (g : Equiv.Perm H) (hg : g.IsCycle)
    (htrans : ∀ s : Finset H, (∀ x, x ∈ s ↔ g x ∈ s) →
      s = ∅ ∨ s = Finset.univ) :
    g.support = Finset.univ := by
  have hinv : ∀ x, x ∈ g.support ↔ g x ∈ g.support := by
    intro x
    rw [Equiv.Perm.mem_support, Equiv.Perm.mem_support]
    exact (not_congr g.injective.eq_iff).symm
  rcases htrans g.support hinv with hempty | huniv
  · exact (hg.nonempty_support.ne_empty hempty).elim
  · exact huniv

theorem permutation_cast_sign_eq_neg_pow_card_of_only_trivial_invariant_subset
    {K H : Type*} [Field K] [Fintype H] [DecidableEq H] [Nonempty H]
    (g : Equiv.Perm H) (hcard : 2 ≤ Fintype.card H)
    (htrans : ∀ s : Finset H, (∀ x, x ∈ s ↔ g x ∈ s) →
      s = ∅ ∨ s = Finset.univ) :
    (↑g.sign : K) = -(-1 : K) ^ Fintype.card H := by
  have hg := permutation_isCycle_of_only_trivial_invariant_subset g hcard htrans
  have hsupport :=
    permutation_support_eq_univ_of_only_trivial_invariant_subset g hg htrans
  have hsign := hg.sign
  rw [hsupport, Finset.card_univ] at hsign
  have hcast := congrArg (fun u : ℤˣ ↦ (((u : ℤ) : K))) hsign
  simpa using hcast

theorem permutationVirtualMangoldt_eq_card_of_only_trivial_invariant_subset
    (K H : Type*) [Field K] [Fintype H] [DecidableEq H] [LinearOrder H]
    (g : Equiv.Perm H)
    (htrans : ∀ s : Finset H, (∀ x, x ∈ s ↔ g x ∈ s) →
      s = ∅ ∨ s = Finset.univ) :
    permutationVirtualMangoldt K H g = (Fintype.card H : K) := by
  let top : Fin (Fintype.card H + 1) :=
    ⟨Fintype.card H, Nat.lt_succ_self _⟩
  unfold permutationVirtualMangoldt
  calc
    ∑ degree : Fin (Fintype.card H + 1),
        (-1 : K) ^ ((degree : ℕ) + 1) * (degree : ℕ) *
          (Representation.exteriorPower
            (Representation.ofMulAction K (Equiv.Perm H) H)
              (degree : ℕ)).character g =
      (-1 : K) ^ ((top : ℕ) + 1) * (top : ℕ) *
        (Representation.exteriorPower
          (Representation.ofMulAction K (Equiv.Perm H) H)
            (top : ℕ)).character g := by
      apply Finset.sum_eq_single top
      · intro degree _hdegree hne
        by_cases hzero : (degree : ℕ) = 0
        · simp [hzero]
        · have hpos : 0 < (degree : ℕ) := Nat.pos_of_ne_zero hzero
          have hlt : (degree : ℕ) < Fintype.card H := by
            have hle : (degree : ℕ) ≤ Fintype.card H :=
              Nat.le_of_lt_succ degree.2
            have hneTop : (degree : ℕ) ≠ Fintype.card H := by
              intro h
              apply hne
              apply Fin.ext
              exact h
            omega
          rw [character_exteriorPower_permutation_eq_zero_of_only_trivial_invariant_subset
            K H g (degree : ℕ) hpos hlt htrans]
          simp
      · intro h
        exact (h (Finset.mem_univ top)).elim
    _ = (Fintype.card H : K) := by
      dsimp only [top]
      rw [character_exteriorPower_permutation_top K H g]
      by_cases hzero : Fintype.card H = 0
      · simp [hzero]
      by_cases hone : Fintype.card H = 1
      · have : Nonempty H := Fintype.card_pos_iff.mp (by omega)
        have : Subsingleton H :=
          Fintype.card_le_one_iff_subsingleton.mp (by omega)
        have hg : g = 1 := Subsingleton.elim _ _
        simp [hone, hg]
      · have hcard : 2 ≤ Fintype.card H := by omega
        have : Nonempty H := Fintype.card_pos_iff.mp (by omega)
        rw [permutation_cast_sign_eq_neg_pow_card_of_only_trivial_invariant_subset
          g hcard htrans]
        rw [pow_succ]
        have hsquare :
            (-1 : K) ^ Fintype.card H * (-1 : K) ^ Fintype.card H = 1 := by
          rw [← mul_pow]
          simp
        calc
          (-1 : K) ^ Fintype.card H * -1 * (Fintype.card H : K) *
              -((-1 : K) ^ Fintype.card H) =
              ((-1 : K) ^ Fintype.card H *
                (-1 : K) ^ Fintype.card H) * (Fintype.card H : K) := by ring
          _ = (Fintype.card H : K) := by rw [hsquare, one_mul]

end Erdos157.SawinGeometry

