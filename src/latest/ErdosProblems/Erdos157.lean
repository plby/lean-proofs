/-- Coefficient-space form of the same source statement.  The residue has
first been replaced by its canonical remainder, and the progression mass is
the explicit sum over monic coefficient vectors `P` of the indicator that
`a + GₖP` has three distinct equal-degree prime factors, with its exact
ordered von-Mangoldt weight. -/
def HasSawinLemma914CoefficientSpaceDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ _ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let W := 6 * d ^ 3
      Nat.dist
          (∑ _T : RepresentationFamilies.PrimeTripleOrdering q r,
            RepresentationFamilies.primeTripleOrderingWeight r)
          (progressionTotient q k *
            ∑ P : MonicOfDegree q (6 * r - k ^ 2),
              shortIntervalThreePrimeWeight q k r
                (normalizedResidue q k a) P) ≤
        progressionTotient q k *
          (W * sawinLemma914EqualDegreeError q d (k ^ 2))

/-- The completely source-native affine factorization-function estimate is
identical to the coefficient-space weight statement used by the construction. -/
theorem hasSawinLemma914CoefficientSpaceDeviation_of_affineFactorization
    (haffine : HasSawinLemma914AffineFactorizationDeviation q) :
    HasSawinLemma914CoefficientSpaceDeviation q := by
  intro k hk a ha
  let r := Construction.canonicalDegreeIndex k
