namespace CanonicalProgressionThreeBlockSplitData

/-- Transport the literal source data to the universe-small split package
consumed by the arithmetic argument. -/
noncomputable def toSplitCohomologyData
    {q k r ell : ℕ} [Fact q.Prime] [Fact ell.Prime]
    {hk : 1 ≤ k} {hkm : k ^ 2 ≤ 3 * (2 * r)}
    {sigma : ℚ_[ell] →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    (data : CanonicalProgressionThreeBlockSplitData
      q k r ell hk hkm sigma radius rankBudget) :
    ThreeBlockSplitCohomologyData.{0}
      ℚ_[ell] ((ProgressionQuotient q k)ˣ) data.topDegree (2 * r)
      (fun u => progressionFullDistinctThreeBlockPointTrace
        q k r ell hk hkm u) sigma radius rankBudget where
  rawFamily := progressionCanonicalCoordinateFamily
    q k r ell data.topDegree hk hkm data.finite
  mainFamily := data.mainFamily
  reducedFamily := data.reducedFamily
  split := by
    intro u degree
    exact ((progressionCanonicalFrobeniusFamily
      q k r ell data.topDegree hk hkm data.finite u degree).coordinateEquiv).symm.trans
        (data.split u degree)
  raw_lefschetz := by
    intro u pi
    rw [progressionCanonicalCoordinateFamily_alternatingTwistedTrace]
    exact progressionCanonicalFrobeniusFamily_lefschetz_of_normalizedGL
      q k r ell data.topDegree hk hkm data.finite
        data.normalized_lefschetz u pi
  reduced_root_bound := data.reduced_root_bound
  rankBudgetAt := data.rankBudgetAt
  reduced_rank_bound := data.reduced_rank_bound
  weighted_rank_bound := data.weighted_rank_bound

end CanonicalProgressionThreeBlockSplitData

namespace CanonicalProgressionThreeBlockAmbientSplitData

/-- Transport the compact-support family to coordinate spaces and derive
all character-specific rank budgets from the single ambient Betti bound. -/
noncomputable def toSplitCohomologyData
    {q k r ell : ℕ} [Fact q.Prime] [Fact ell.Prime]
    {hk : 1 ≤ k} {hkm : k ^ 2 ≤ 3 * (2 * r)}
    {sigma : ℚ_[ell] →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    (data : CanonicalProgressionThreeBlockAmbientSplitData
      q k r ell hk hkm sigma radius rankBudget) :
    ThreeBlockSplitCohomologyData.{0}
      ℚ_[ell] ((ProgressionQuotient q k)ˣ) data.topDegree (2 * r)
      (fun u => progressionFullDistinctThreeBlockPointTrace
        q k r ell hk hkm u) sigma radius rankBudget := by
  apply ThreeBlockSplitCohomologyData.ofAmbientRank
    (progressionCanonicalCoordinateFamily
      q k r ell data.topDegree hk hkm data.finite)
    data.mainFamily data.reducedFamily
    (ambientRankBudget := data.ambientRankBudget)
  · intro u degree
    exact ((progressionCanonicalFrobeniusFamily
      q k r ell data.topDegree hk hkm data.finite u degree).coordinateEquiv).symm.trans
        (data.split u degree)
  · intro u pi
    rw [progressionCanonicalCoordinateFamily_alternatingTwistedTrace]
    exact progressionCanonicalFrobeniusFamily_lefschetz_of_normalizedGL
      q k r ell data.topDegree hk hkm data.finite
        data.normalized_lefschetz u pi
  · exact data.reduced_root_bound
  · exact data.reduced_rank_bound
  · exact data.weighted_rank_bound

end CanonicalProgressionThreeBlockAmbientSplitData

namespace CanonicalProgressionThreeBlockCentralProjectorData

/-- Coordinate transport turns the geometric central-projector
decomposition into the universe-small ambient split package. -/
noncomputable def toAmbientSplitData
    {q k r ell : ℕ} [Fact q.Prime] [Fact ell.Prime]
    {hk : 1 ≤ k} {hkm : k ^ 2 ≤ 3 * (2 * r)}
    {sigma : ℚ_[ell] →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    (data : CanonicalProgressionThreeBlockCentralProjectorData
      q k r ell hk hkm sigma radius rankBudget) :
    CanonicalProgressionThreeBlockAmbientSplitData
      q k r ell hk hkm sigma radius rankBudget where
  topDegree := data.topDegree
  finite := data.finite
  mainFamily degree := (data.projectorData.mainFamily degree).coordinate
  reducedFamily u degree :=
    (data.projectorData.reducedFamily u degree).coordinate
  split u degree :=
    (data.projectorData.split u degree).trans
      (FiniteFrobeniusRepresentation.Equiv.prodCongr
        (data.projectorData.mainFamily degree).coordinateEquiv
        (data.projectorData.reducedFamily u degree).coordinateEquiv)
  normalized_lefschetz := data.normalized_lefschetz
  reduced_root_bound := by
    intro u degree z hz
    rw [FiniteFrobeniusRepresentation.coordinate_frobeniusRealizationMatrix_charpoly]
      at hz
    exact data.reduced_root_bound u degree z hz
  ambientRankBudget := data.ambientRankBudget
  reduced_rank_bound := by
    intro u
    simpa only [FiniteFrobeniusRepresentation.coordinate_rank] using
      data.reduced_rank_bound u
  weighted_rank_bound := data.weighted_rank_bound

end CanonicalProgressionThreeBlockCentralProjectorData

