        (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ lowerDegree g t hg))
      (Module.finrank ℚ_[ℓ]
        (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ upperDegree g t hg)) radius radius := by
  letI := data.finite
  let lower := properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
    q d m ℓ lowerDegree g t hg π σ
  let upper := properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
    q d m ℓ upperDegree g t hg π σ
  apply twoDegreeFrobeniusMatricesOfCohomologicalMatrices
    lowerDegree upperDegree lower upper
  · have halt :=
      properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace_eq_two_degrees
        q d m ℓ topDegree lowerDegree upperDegree g t hg π
        data.lower_le data.upper_le data.degrees_ne data.concentration
    have hqell :
        (Nat.card (ProperPairResidueFiberDistinctGeometricTwistedFixedPoint
