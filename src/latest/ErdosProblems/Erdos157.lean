        progressionEqualDegreeDistinctThreePrimeWeightSum q k
            (Construction.canonicalDegreeIndex k) (normalizedResidue q k a) =
          progressionEqualDegreeDistinctThreePrimeWeightSum q k
            (Construction.canonicalDegreeIndex k) a := by
      unfold progressionEqualDegreeDistinctThreePrimeWeightSum
      exact sum_monicProgression_normalizedResidue q k
        (6 * Construction.canonicalDegreeIndex k) a
        (equalDegreeDistinctThreePrimeWeight q
          (Construction.canonicalDegreeIndex k))
    rw [hsum]
    exact hs
  · have hs := h k hk a ha
    dsimp only at hs ⊢
    have hsum :
        progressionEqualDegreeDistinctThreePrimeWeightSum q k
            (Construction.canonicalDegreeIndex k) (normalizedResidue q k a) =
          progressionEqualDegreeDistinctThreePrimeWeightSum q k
            (Construction.canonicalDegreeIndex k) a := by
      unfold progressionEqualDegreeDistinctThreePrimeWeightSum
      exact sum_monicProgression_normalizedResidue q k
        (6 * Construction.canonicalDegreeIndex k) a
        (equalDegreeDistinctThreePrimeWeight q
          (Construction.canonicalDegreeIndex k))
