import ErdosProblems.Erdos599.SingularRetargetedRow
import ErdosProblems.Erdos599.SingularClosedTargetRows

/-!
# The exact two-pass boundary of the retargeted fixed-point strategy

The lower induction hypothesis can choose a full-source row linking any
bounded set of ambient sources.  Thus one may first choose seed rows, close
the source layers under all competitors of those rows, and then choose
master rows linking the resulting omega closures.

All of that construction is unconditional and preserves the exact singular
scale.  What it does *not* prove is that the omega closures generated by the
seed rows are closed under the newly chosen master rows.  This file packages
the two passes and exposes that one remaining `masterClosed` condition.

This is also an audit of possible monotone-envelope arguments.  The omega
closure is monotone for a fixed family of paths, but lower-induction row
selection is not monotone in the requested source set.  Replacing one
selected family by all possible selected families destroys the indexed-warp
cardinality bound used below.
-/

noncomputable section

open Cardinal Set

namespace Erdos599
namespace CardinalInduction
namespace SingularRetargetedFixedPoint

open SingularExtension SingularMatrix SingularRetargetedRow
  SingularClosedTargetRows

universe u

variable {V : Type u}

/-- A single warp creates no new source competitors with itself.  New
competitors in the singular construction therefore come from interactions
between the fixed warp and different row warps. -/
theorem competitorClosure_self_subset
    (G : DWeb V) {W : Set G.DPath} (hW : G.IsWarp W) (S : Set V) :
    G.competitorClosure W S ⊆ S := by
  rintro b ⟨a, ha, p, hpW, hpa, q, hqW, hqb, hpq⟩
  have hpqEq : p = q := by
    by_contra hne
    exact Set.not_disjoint_iff.1 hpq |>.elim fun x hx ↦
      Set.disjoint_left.1 (hW hpW hqW hne) hx.1 hx.2
  rw [hpqEq, hqb] at hpa
  exact hpa ▸ ha

/-- The retargeted lower-extension theorem specialized to an arbitrary
bounded set of ambient sources.  Taking the designated set to be the whole
source makes the complementary linkage empty. -/
theorem exists_fullSourceRow_links_bounded_any
    {kappa rho : Cardinal.{u}}
    (hlower : UniversalCardinalInductionBelow V kappa)
    (hrho : rho < kappa)
    {G : DWeb V} (hG : G.IsUnhindered) (hNorm : G.IsNormalized)
    {B : Set V} (hB : B ⊆ G.source) (hBcard : #B = rho) :
    ∃ P : Set G.DPath,
      G.IsWarp P ∧ G.HasFiniteCharacter P ∧
        G.initialSet P = G.source ∧ LinksToTarget G P B := by
  apply exists_fullSourceRow_links_bounded
    hlower hrho hG hNorm (A₀ := G.source) Set.Subset.rfl hB hBcard
  simpa only [Set.sdiff_self] using empty_linkage G

/-- Two complete passes of the fixed-point attempt.  `generators` define
the omega-closed source sets.  `paths` are selected afterwards and link
those source sets to the target. -/
structure TwoPassRows
    (G : DWeb V) (fixed : Set G.DPath)
    (A₀ : Set V) (kappa : Cardinal.{u})
    (huncountable : aleph0 < kappa) (hsingular : kappa.IsSingular)
    (hcard : #A₀ = kappa) where
  generators : Index kappa → Set G.DPath
  sources : Index kappa → Set V
  paths : Index kappa → Set G.DPath
  sources_eq : ∀ i,
    sources i = G.omegaCompetitorClosure
      (fixed ∪ ⋃ j, generators j)
      (sourceLayer A₀ kappa hcard huncountable hsingular i)
  sources_subset : ∀ i, sources i ⊆ G.source
  sources_card : ∀ i,
    #(sources i) = scale kappa huncountable hsingular i
  generators_isWarp : ∀ i, G.IsWarp (generators i)
  generators_finiteCharacter : ∀ i, G.HasFiniteCharacter (generators i)
  generators_initialSet : ∀ i,
    G.initialSet (generators i) = G.source
  generators_links : ∀ i,
    LinksToTarget G (generators i)
      (sourceLayer A₀ kappa hcard huncountable hsingular i)
  isWarp : ∀ i, G.IsWarp (paths i)
  finiteCharacter : ∀ i, G.HasFiniteCharacter (paths i)
  initialSet : ∀ i, G.initialSet (paths i) = G.source
  links : ∀ i, LinksToTarget G (paths i) (sources i)

namespace TwoPassRows

variable {G : DWeb V} {fixed : Set G.DPath}
variable {A₀ : Set V} {kappa : Cardinal.{u}}
variable {huncountable : aleph0 < kappa} {hsingular : kappa.IsSingular}
variable {hcard : #A₀ = kappa}

/-- The sources really are closed under the rows from the first pass. -/
theorem generators_closed
    (R : TwoPassRows G fixed A₀ kappa
      huncountable hsingular hcard) (i : Index kappa) :
    G.competitorClosure (fixed ∪ ⋃ j, R.generators j) (R.sources i) ⊆
      R.sources i := by
  rw [R.sources_eq i]
  exact G.competitorClosure_omega_subset _ _

/-- The seed source layer is retained by the first omega closure. -/
theorem seed
    (R : TwoPassRows G fixed A₀ kappa
      huncountable hsingular hcard) (i : Index kappa) :
    sourceLayer A₀ kappa hcard huncountable hsingular i ⊆ R.sources i := by
  rw [R.sources_eq i]
  exact G.subset_omegaCompetitorClosure _ _

/-- If the post-choice master rows happen to preserve the first-pass
closures, the constant-row construction is complete.  This premise is the
exact +1 compatibility which is not supplied by retargeting. -/
noncomputable def toClosedRows
    (R : TwoPassRows G fixed A₀ kappa
      huncountable hsingular hcard)
    (masterClosed : ∀ i,
      G.competitorClosure (fixed ∪ ⋃ j, R.paths j) (R.sources i) ⊆
        R.sources i) :
    ClosedRows G fixed A₀ kappa huncountable hsingular hcard where
  sources := R.sources
  paths := R.paths
  seed := R.seed
  isWarp := R.isWarp
  finiteCharacter := R.finiteCharacter
  initialSet := R.initialSet
  links := R.links
  closed := masterClosed

/-- Supplying the missing post-choice closure already proves linkability of
the whole web.  Thus `masterClosed` is not residual cardinal bookkeeping;
it has exactly the strength of the singular conclusion when combined with
the unconditional two-pass construction. -/
theorem isLinkable_of_masterClosed
    (R : TwoPassRows G fixed A₀ kappa
      huncountable hsingular hcard)
    (hA₀ : A₀ ⊆ G.source)
    (hfixed : IsLinkageBetween G (G.source \ A₀) G.target fixed)
    (masterClosed : ∀ i,
      G.competitorClosure (fixed ∪ ⋃ j, R.paths j) (R.sources i) ⊆
        R.sources i) :
    IsLinkable G := by
  exact SingularExtension.isLinkable_of_targetRows
    (R.toClosedRows masterClosed).toTargetRows hA₀ hfixed

end TwoPassRows

/-- Two-pass rows exist unconditionally from lower induction.  The theorem
deliberately stops before claiming closure under the second-pass paths. -/
theorem exists_twoPassRows
    {kappa : Cardinal.{u}}
    (hlower : UniversalCardinalInductionBelow V kappa)
    (hkappa : aleph0 < kappa) (hsingular : kappa.IsSingular)
    {G : DWeb V} (hG : G.IsUnhindered) (hNorm : G.IsNormalized)
    {A₀ : Set V} (hA₀ : A₀ ⊆ G.source) (hcard : #A₀ = kappa)
    {fixed : Set G.DPath}
    (hfixed : IsLinkageBetween G (G.source \ A₀) G.target fixed) :
    Nonempty (TwoPassRows G fixed A₀ kappa hkappa hsingular hcard) := by
  let layer : Index kappa → Set V :=
    sourceLayer A₀ kappa hcard hkappa hsingular
  have hexGenerator : ∀ i : Index kappa,
      ∃ P : Set G.DPath,
        G.IsWarp P ∧ G.HasFiniteCharacter P ∧
          G.initialSet P = G.source ∧ LinksToTarget G P (layer i) := by
    intro i
    apply exists_fullSourceRow_links_bounded_any
      hlower (scale_below kappa hkappa hsingular i) hG hNorm
    · exact (sourceLayer_subset A₀ kappa hcard hkappa hsingular i).trans
        hA₀
    · exact sourceLayer_card A₀ kappa hcard hkappa hsingular i
  let P : Index kappa → Set G.DPath :=
    fun i ↦ Classical.choose (hexGenerator i)
  have hP : ∀ i,
      G.IsWarp (P i) ∧ G.HasFiniteCharacter (P i) ∧
        G.initialSet (P i) = G.source ∧ LinksToTarget G (P i) (layer i) :=
    fun i ↦ Classical.choose_spec (hexGenerator i)
  let C : Index kappa → Set V := fun i ↦
    G.omegaCompetitorClosure (fixed ∪ ⋃ j, P j) (layer i)
  have hCcard : ∀ i,
      #(C i) = scale kappa hkappa hsingular i := by
    intro i
    apply G.mk_omegaCompetitorClosure_eq
    · exact sourceLayer_card A₀ kappa hcard hkappa hsingular i
    · exact scale_infinite kappa hkappa hsingular i
    · intro n
      apply G.mk_competitorIterate_fixed_iUnion_le
        fixed P (layer i) hfixed.isWarp (fun j ↦ (hP j).1)
      · exact scale_infinite kappa hkappa hsingular i
      · exact scale_index_le kappa hkappa hsingular i
      · rw [sourceLayer_card A₀ kappa hcard hkappa hsingular i]
  have hCsubset : ∀ i, C i ⊆ G.source := by
    intro i
    apply G.omegaCompetitorClosure_minimal
    · exact (sourceLayer_subset A₀ kappa hcard hkappa hsingular i).trans
        hA₀
    · rintro b ⟨_a, _ha, _p, _hp, _hpa, q, hq, hqb, _hpq⟩
      rw [← hqb]
      rcases hq with hqFixed | hqP
      · have hqInitial : q.initial ∈ G.initialSet fixed := ⟨q, hqFixed, rfl⟩
        rw [hfixed.initialSet_eq] at hqInitial
        exact hqInitial.1
      · obtain ⟨j, hqPj⟩ := Set.mem_iUnion.1 hqP
        have hqInitial : q.initial ∈ G.initialSet (P j) := ⟨q, hqPj, rfl⟩
        rw [(hP j).2.2.1] at hqInitial
        exact hqInitial
  have hexMaster : ∀ i : Index kappa,
      ∃ Q : Set G.DPath,
        G.IsWarp Q ∧ G.HasFiniteCharacter Q ∧
          G.initialSet Q = G.source ∧ LinksToTarget G Q (C i) := by
    intro i
    apply exists_fullSourceRow_links_bounded_any
      hlower (scale_below kappa hkappa hsingular i) hG hNorm
      (hCsubset i) (hCcard i)
  let Q : Index kappa → Set G.DPath :=
    fun i ↦ Classical.choose (hexMaster i)
  have hQ : ∀ i,
      G.IsWarp (Q i) ∧ G.HasFiniteCharacter (Q i) ∧
        G.initialSet (Q i) = G.source ∧ LinksToTarget G (Q i) (C i) :=
    fun i ↦ Classical.choose_spec (hexMaster i)
  exact ⟨
    { generators := P
      sources := C
      paths := Q
      sources_eq := fun _ ↦ rfl
      sources_subset := hCsubset
      sources_card := hCcard
      generators_isWarp := fun i ↦ (hP i).1
      generators_finiteCharacter := fun i ↦ (hP i).2.1
      generators_initialSet := fun i ↦ (hP i).2.2.1
      generators_links := fun i ↦ (hP i).2.2.2
      isWarp := fun i ↦ (hQ i).1
      finiteCharacter := fun i ↦ (hQ i).2.1
      initialSet := fun i ↦ (hQ i).2.2.1
      links := fun i ↦ (hQ i).2.2.2 }⟩

#print axioms competitorClosure_self_subset
#print axioms exists_twoPassRows
#print axioms TwoPassRows.toClosedRows
#print axioms TwoPassRows.isLinkable_of_masterClosed

end SingularRetargetedFixedPoint
end CardinalInduction
end Erdos599
