/-!
# Roof capture and candidate construction for a protected regular coordinate

The visible pair registration is first captured by a club frontier.  A
second club frontier roofs the actual stopover through its registered height
witness.  The two registration alternatives then give, respectively, the
localized protected candidate and the small-whole-source candidate.
-/

noncomputable section

open Cardinal Order Set

namespace Erdos599
namespace CardinalInduction
namespace RegularLocalizedProtectedRoofCandidate

open Blueprint.LinkageBlueprint.CardinalInduction
open RegularProtectedAmbientRebuild
open SingularProtectedLowerSelection

universe u
variable {V : Type u}

private theorem roof_subset_stageWeb_roof
    {G : DWeb V} {kappa : Cardinal.{u}}
    (L : G.KappaLadder kappa) (delta : Ladder.Stage kappa) (T : Set V) :
    G.roof T ⊆ (L.stageWeb delta).roof T := by
  exact SliceCandidate.roof_subset_of_adj_imp G (L.stageWeb delta) rfl
    (fun {_ _} e ↦ G.quotient_adj_imp
      ((G.quotient (G.terminalFrontier (L.warpAt delta))).essentialPart_adj_imp e)) T

/-- Every carrier of a causal row is captured by the limiting roof of the
canonical split ladder generated by that row. -/
theorem causalCarrier_subset_limitRoof
    (G : DWeb V) {kappa : Cardinal.{u}}
    (hregular : kappa.IsRegular) (huncountable : aleph0 < kappa)
    (hNorm : G.IsNormalized)
    (Qrow : RegularRows.CausalRowRule kappa V)
    (hL : (DWeb.KappaLadder.canonicalLadder G kappa
      (Qrow.preferred hregular.aleph0_le)).IsSplitLegal) :
    (Qrow.rowSystem hregular.aleph0_le).carrier ⊆
      (DWeb.KappaLadder.canonicalLadder G kappa
        (Qrow.preferred hregular.aleph0_le)).limitRoof := by
  intro x hx
  obtain ⟨a, ha⟩ := Qrow.exists_preferred_eq_some_of_mem_carrier
    hregular huncountable hx
  let b : Ladder.Stage kappa :=
    ⟨a.1 + 1, (Cardinal.isSuccLimit_ord hregular.aleph0_le).succ_lt a.2⟩
  exact DWeb.KappaLadder.canonicalLadderCore_preferred_mem_limitRoof_of_fields
    (Qrow.preferred hregular.aleph0_le) hNorm hL.freshMarkers hL.waveRungs
      hL.exactSuccessorArrows hL.roofsSourceAtStages a b rfl ha

/-- A registered protected coordinate is roofed by a strictly later member
of any prescribed club. -/
theorem exists_later_club_roof_registrationAt
    (G : DWeb V) {kappa : Cardinal.{u}}
    (hregular : kappa.IsRegular) (huncountable : aleph0 < kappa)
    (hNorm : G.IsNormalized)
    (Qrow : RegularRows.CausalRowRule kappa V)
    (hL : (DWeb.KappaLadder.canonicalLadder G kappa
      (Qrow.preferred hregular.aleph0_le)).IsSplitLegal)
    (request : Ladder.Stage kappa → Ladder.Stage kappa → Set V)
    {Sigma : Set (Ladder.Stage kappa)}
    (hSigma : Stationary.IsClubBelow kappa Sigma)
    (delta gamma : Ladder.Stage kappa)
    (hregistered :
      RegularLocalizedProtectedRegistration.registrationAt
          (DWeb.KappaLadder.canonicalLadder G kappa
            (Qrow.preferred hregular.aleph0_le)) request delta gamma ⊆
        (Qrow.rowSystem hregular.aleph0_le).carrier) :
    ∃ zeta ∈ Sigma, delta < zeta ∧
      RegularLocalizedProtectedRegistration.registrationAt
          (DWeb.KappaLadder.canonicalLadder G kappa
            (Qrow.preferred hregular.aleph0_le)) request delta gamma ⊆
        G.roof ((DWeb.KappaLadder.canonicalLadder G kappa
          (Qrow.preferred hregular.aleph0_le)).frontier zeta) := by
  let L := DWeb.KappaLadder.canonicalLadder G kappa
    (Qrow.preferred hregular.aleph0_le)
  let Z := RegularLocalizedProtectedRegistration.registrationAt
    L request delta gamma
  have hgeometry : SliceSpliceConstructor.SpliceLadderGeometry G L :=
    ⟨hL.regular, hL.initialStage, hL.limitStages, hL.warpStages,
      hL.frontiersEssential, hL.frontierChronology,
      hL.strictFrontierChronology⟩
  have hcarrier : (Qrow.rowSystem hregular.aleph0_le).carrier ⊆ L.limitRoof :=
    causalCarrier_subset_limitRoof G hregular huncountable hNorm Qrow hL
  have hroofed : SliceSpliceConstructor.IsEventuallyRoofed G L
      (Qrow.rowSystem hregular.aleph0_le).carrier :=
    SliceSpliceConstructor.isEventuallyRoofed_of_subset_limitRoof
      hgeometry hcarrier
  have hNormStage : (L.stageWeb delta).IsNormalized :=
    RegularCandidateProvider.stageWeb_isNormalized hNorm L delta
  have hZsmall : #Z < kappa :=
    RegularLocalizedProtectedRegistration.mk_registration_lt
      hregular huncountable hNormStage
  obtain ⟨a, haSigma, hZa⟩ :=
    SliceSpliceConstructor.exists_club_roof_superset hregular hSigma
      hroofed hregistered hZsmall
  let zeta := RegularCardinal.aboveInClub hregular Sigma hSigma delta a
  have hzetaSigma : zeta ∈ Sigma :=
    RegularCardinal.aboveInClub_mem hregular Sigma hSigma delta a
  have hdeltaZeta : delta < zeta :=
    RegularCardinal.left_lt_aboveInClub hregular Sigma hSigma delta a
  have haZeta : a < zeta :=
    RegularCardinal.right_lt_aboveInClub hregular Sigma hSigma delta a
  exact ⟨zeta, hzetaSigma, hdeltaZeta,
    hZa.trans (G.roof_cut (hL.frontierChronology haZeta))⟩

/-- Turn either concrete registration witness into a later weak candidate.
The second club step is needed only for the height-wave transport in the
protected branch, and is harmless in the full-target branch. -/
theorem exists_later_candidate_of_registrationWitness
    {kappa : Cardinal.{u}} {G : DWeb V}
    {L : G.KappaLadder kappa} (hL : L.SliceGeometry)
    (hNorm : G.IsNormalized)
    (hext : ExtensionBelowFor G kappa)
    {request : Ladder.Stage kappa → Ladder.Stage kappa → Set V}
    {Sigma : Set (Ladder.Stage kappa)}
    (hSigma : Stationary.IsClubBelow kappa Sigma)
    (havoid : Disjoint Sigma L.phi)
    {delta gamma zeta : Ladder.Stage kappa}
    (hdeltaZeta : delta < zeta)
    (hzetaSigma : zeta ∈ Sigma)
    (hregistrationRoof :
      RegularLocalizedProtectedRegistration.registrationAt
          L request delta gamma ⊆ G.roof (L.frontier zeta))
    (hwitness :
      RegularLocalizedProtectedRegistration.IsProtectedRegistrationWitness
          (L.stageWeb delta) (request delta gamma) kappa
            (RegularLocalizedProtectedRegistration.registrationAt
              L request delta gamma) ∨
        RegularLocalizedProtectedRegistration.IsFullTargetRegistrationWitness
          (L.stageWeb delta) kappa
            (RegularLocalizedProtectedRegistration.registrationAt
              L request delta gamma))
    (hrequestFrontier : request delta gamma ⊆ L.frontier delta) :
    ∃ beta ∈ Sigma, delta < beta ∧
      ∃ C : RegularWeakSplitCandidate.WeakSplitFamilies G,
        RegularWeakSplitCandidate.IsWeakSplitAnnularCandidate
          G L request delta beta gamma C := by
  let Q := L.stageWeb delta
  let beta := RegularCardinal.nextInClub hL.regular Sigma hSigma zeta
  have hbetaSigma : beta ∈ Sigma :=
    RegularCardinal.nextInClub_mem hL.regular Sigma hSigma zeta
  have hzetaBeta : zeta < beta :=
    RegularCardinal.lt_nextInClub hL.regular Sigma hSigma zeta
  have hdeltaBeta : delta < beta := hdeltaZeta.trans hzetaBeta
  have hbetaAvoid : beta ∉ L.phi := fun hbetaPhi ↦
    Set.disjoint_left.1 havoid hbetaSigma hbetaPhi
  have hNoEnter : G.NoEdgeEnters G.source := by
    intro x y hxy hy
    exact (hNorm hxy).1 hy
  have hQBase : ∀ {x y : V}, Q.graph.Adj x y → G.graph.Adj x y := by
    intro x y hxy
    exact G.quotient_adj_imp
      ((G.quotient (G.terminalFrontier (L.warpAt delta))).essentialPart_adj_imp hxy)
  have hextQ : ExtensionBelowFor Q kappa := by
    intro rho hrho H hHQ hH
    exact hext rho hrho H (fun {_ _} hxy ↦ hQBase (hHQ hxy)) hH
  have hroofBeta : RegularLocalizedProtectedRegistration.registrationAt
      L request delta gamma ⊆ G.roof (L.frontier beta) :=
    hregistrationRoof.trans (G.roof_cut (hL.frontierChronology hzetaBeta))
  rcases hwitness with
      ⟨rho, hrho, A₀, hrequestA₀, D, X, hX, hXcard, hregistration⟩ |
      ⟨P, hsourceSmall, hP, hregistration⟩
  · have hXzetaAmbient : X ⊆ G.roof (L.frontier zeta) := by
      intro x hx
      apply hregistrationRoof
      rw [hregistration]
      exact Or.inl hx
    have hXzeta : X ⊆ Q.roof (L.frontier zeta) :=
      hXzetaAmbient.trans
        (roof_subset_stageWeb_roof L delta (L.frontier zeta))
    obtain ⟨R, hRwave, hstopoverRoof⟩ := hX.2
    have hterminalLift :=
      SliceCandidate.quotientStageWave_terminalFrontier_subset_laterFrontierRoof_of_geometry
        hL.heightRoofGeometry hNoEnter
          hdeltaZeta hzetaBeta hXzeta hRwave
    have hterminal : (Q.quotient X).terminalFrontier R ⊆
        Q.roof (L.frontier beta) := by
      simpa only [Q, Q.terminalFrontier_liftQuotientFamily] using hterminalLift
    have hCroof : D.stopover ⊆ Q.roof (L.frontier beta) :=
      hstopoverRoof.trans (Q.roof_cut hterminal)
    have htargetRoof : Q.vertexSet D.targetPaths ⊆
        G.roof (L.frontier beta) := by
      intro x hx
      apply hroofBeta
      rw [hregistration]
      exact Or.inr hx
    obtain ⟨C, hC⟩ :=
      RegularLocalizedProtectedCandidate.exists_weakSplitAnnularCandidate_of_localizedProtected
        hL hdeltaBeta hbetaAvoid hNorm D hrho hrequestA₀ hextQ
          hCroof htargetRoof
    exact ⟨beta, hbetaSigma, hdeltaBeta, C, hC⟩
  · have htargetRoof : Q.vertexSet P ⊆ G.roof (L.frontier beta) := by
      intro x hx
      apply hroofBeta
      rw [hregistration]
      exact hx
    have hNormQ : Q.IsNormalized :=
      RegularCandidateProvider.stageWeb_isNormalized hNorm L delta
    obtain ⟨C, hC⟩ :=
      RegularLocalizedProtectedFullTargetCandidate.exists_weakSplitAnnularCandidate_of_fullTarget
        hL hdeltaBeta hNormQ hrequestFrontier hP hsourceSmall htargetRoof
    exact ⟨beta, hbetaSigma, hdeltaBeta, C, hC⟩

/-- The complete coordinate constructor for the repaired causal row.  The
stage unhinderedness is kept explicit because it is supplied differently at
club stages and at stage zero. -/
theorem exists_later_candidate_of_lower
    (G : DWeb V) {kappa : Cardinal.{u}}
    (hregular : kappa.IsRegular) (huncountable : aleph0 < kappa)
    (hNorm : G.IsNormalized)
    (hext : ExtensionBelowFor G kappa)
    (hhalf : ProtectedHalfwayBelowFor G kappa)
    (F : Set G.DPath) (hF : G.IsWarp F)
    (base : Set V) (hbase : #base ≤ kappa)
    {Sigma : Set (Ladder.Stage kappa)}
    (hSigma : Stationary.IsClubBelow kappa Sigma)
    (havoid :
      let Qrow := RegularLocalizedProtectedRows.rowRule G hregular
        huncountable hNorm F hF base hbase
      let L := DWeb.KappaLadder.canonicalLadder G kappa
        (Qrow.preferred hregular.aleph0_le)
      Disjoint Sigma L.phi)
    (delta gamma : Ladder.Stage kappa)
    (hstage :
      let Qrow := RegularLocalizedProtectedRows.rowRule G hregular
        huncountable hNorm F hF base hbase
      let L := DWeb.KappaLadder.canonicalLadder G kappa
        (Qrow.preferred hregular.aleph0_le)
      (L.stageWeb delta).IsUnhindered) :
    let Qrow := RegularLocalizedProtectedRows.rowRule G hregular
      huncountable hNorm F hF base hbase
    let L := DWeb.KappaLadder.canonicalLadder G kappa
      (Qrow.preferred hregular.aleph0_le)
    let request := RegularRows.CausalRegular.finalRequest G Qrow
      hregular.aleph0_le
    ∃ beta ∈ Sigma, delta < beta ∧
      ∃ C : RegularWeakSplitCandidate.WeakSplitFamilies G,
        RegularWeakSplitCandidate.IsWeakSplitAnnularCandidate
          G L request delta beta gamma C := by
  dsimp only at hstage havoid ⊢
  let Qrow := RegularLocalizedProtectedRows.rowRule G hregular
    huncountable hNorm F hF base hbase
  let L := DWeb.KappaLadder.canonicalLadder G kappa
    (Qrow.preferred hregular.aleph0_le)
  let request := RegularRows.CausalRegular.finalRequest G Qrow
    hregular.aleph0_le
  have hNoEnter : G.NoEdgeEnters G.source := by
    intro x y hxy hy
    exact (hNorm hxy).1 hy
  have hL : L.IsSplitLegal :=
    DWeb.KappaLadder.canonicalLadder_isSplitLegal
      (Qrow.preferred hregular.aleph0_le) hregular huncountable hNoEnter
  have hrequest : request delta gamma ⊆ (L.stageWeb delta).source :=
    Set.inter_subset_left
  have hrequestSmall : #(request delta gamma) < kappa :=
    ControlledSlices.mk_diagonalRequest_lt hregular _ _ _ _
  have hQBase : ∀ {x y : V}, (L.stageWeb delta).graph.Adj x y →
      G.graph.Adj x y := by
    intro x y hxy
    exact G.quotient_adj_imp
      ((G.quotient (G.terminalFrontier (L.warpAt delta))).essentialPart_adj_imp hxy)
  have hNormStage : (L.stageWeb delta).IsNormalized :=
    RegularCandidateProvider.stageWeb_isNormalized hNorm L delta
  have hwitness :=
    RegularLocalizedProtectedSelection.exists_witness_with_registration_of_lower
      huncountable hext hhalf hQBase hNormStage hstage hrequest hrequestSmall
  have hregisteredCore : RegularLocalizedProtectedRegistration.registrationAt
      (G.canonicalLadderCore kappa (Qrow.preferred hregular.aleph0_le))
        request delta gamma ⊆
      (Qrow.rowSystem hregular.aleph0_le).carrier :=
    RegularLocalizedProtectedRows.registrationAt_subset_rowRule_carrier
      G hregular huncountable hNorm F hF base hbase delta gamma
  have hregistrationEq :
      RegularLocalizedProtectedRegistration.registrationAt
          L request delta gamma =
        RegularLocalizedProtectedRegistration.registrationAt
          (G.canonicalLadderCore kappa
            (Qrow.preferred hregular.aleph0_le)) request delta gamma := by
    apply RegularLocalizedProtectedRegistration.registrationAt_congr_stageData
    exact DWeb.KappaLadder.withValidBookkeeping_warpAt _ _
    rfl
  have hregistered : RegularLocalizedProtectedRegistration.registrationAt
      L request delta gamma ⊆ (Qrow.rowSystem hregular.aleph0_le).carrier := by
    rw [hregistrationEq]
    exact hregisteredCore
  obtain ⟨zeta, hzetaSigma, hdeltaZeta, hregistrationRoof⟩ :=
    exists_later_club_roof_registrationAt G hregular huncountable hNorm
      Qrow hL request hSigma delta gamma hregistered
  exact exists_later_candidate_of_registrationWitness hL hNorm hext hSigma
    havoid hdeltaZeta hzetaSigma hregistrationRoof hwitness hrequest

#print axioms exists_later_candidate_of_registrationWitness
#print axioms exists_later_candidate_of_lower

end RegularLocalizedProtectedRoofCandidate
end CardinalInduction
end Erdos599
