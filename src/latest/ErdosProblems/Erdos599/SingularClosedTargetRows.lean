import ErdosProblems.Erdos599.SingularExtension

/-!
# Competitor-closed constant rows for the singular extension

Assertion 9.18 only consumes forward coherence and target links for the
recursively closed source rows.  A jointly selected family which is already
closed under all of its competitors can therefore be repeated at every
finite stage.  This module records that reduction.  It is useful for a
future-safe batch construction: no successor theorem for arbitrary rows is
needed.
-/

noncomputable section

open Cardinal Set

namespace Erdos599
namespace CardinalInduction
namespace SingularClosedTargetRows

open SingularExtension SingularMatrix

universe u

variable {V : Type u}

/-- A simultaneous family of target rows which already contains the
canonical source layers and is closed under every competitor in the fixed
linkage and in all chosen rows. -/
structure ClosedRows
    (G : DWeb V) (fixed : Set G.DPath)
    (A₀ : Set V) (kappa : Cardinal.{u})
    (huncountable : aleph0 < kappa) (hsingular : kappa.IsSingular)
    (hcard : #A₀ = kappa) where
  sources : Index kappa → Set V
  paths : Index kappa → Set G.DPath
  seed : ∀ i,
    sourceLayer A₀ kappa hcard huncountable hsingular i ⊆ sources i
  isWarp : ∀ i, G.IsWarp (paths i)
  finiteCharacter : ∀ i, G.HasFiniteCharacter (paths i)
  initialSet : ∀ i, G.initialSet (paths i) = G.source
  links : ∀ i, LinksToTarget G (paths i) (sources i)
  closed : ∀ i,
    G.competitorClosure (fixed ∪ ⋃ j, paths j) (sources i) ⊆ sources i

namespace ClosedRows

variable {G : DWeb V} {fixed : Set G.DPath}
variable {A₀ : Set V} {kappa : Cardinal.{u}}
variable {huncountable : aleph0 < kappa} {hsingular : kappa.IsSingular}
variable {hcard : #A₀ = kappa}

/-- Shrinking the requested source set preserves source-faithful target
links. -/
theorem linksToTarget_mono_sources
    {W : Set G.DPath} {S T : Set V}
    (hTS : T ⊆ S) (hW : LinksToTarget G W S) :
    LinksToTarget G W T := by
  intro a ha
  obtain ⟨p, hpW, q, rfl, hpure, hsuffix⟩ := hW a (hTS ha)
  refine ⟨.inl q, hpW, q, rfl, ?_, hsuffix⟩
  apply Set.Subset.antisymm
  · rintro x ⟨hxq, hxT⟩
    have hxS : x ∈ q.support ∩ S := ⟨hxq, hTS hxT⟩
    have hxa : x = a := Set.mem_singleton_iff.1 (hpure ▸ hxS)
    exact hxa ▸ Set.mem_singleton a
  · intro x hx
    have hxa : x = a := Set.mem_singleton_iff.1 hx
    subst x
    have haS : a ∈ ({a} : Set V) := Set.mem_singleton a
    have haq : a ∈ q.support := (hpure.symm ▸ haS).1
    exact ⟨haq, ha⟩

/-- Every recursively generated matrix source remains in the already
competitor-closed source set. -/
theorem matrixSources_subset
    (R : ClosedRows G fixed A₀ kappa huncountable hsingular hcard)
    (i : Index kappa) : ∀ n,
    matrixSources G fixed (fun j _ ↦ R.paths j)
        (sourceLayer A₀ kappa hcard huncountable hsingular) i n ⊆
      R.sources i := by
  intro n
  induction n with
  | zero => exact R.seed i
  | succ n ih =>
      rw [matrixSources_succ]
      apply Set.union_subset ih
      apply (G.competitorClosure_mono_sources ih).trans
      simpa only [DWeb.matrixStageFamily] using R.closed i

/-- Repeat an already closed simultaneous family at every finite matrix
stage.  Forward coherence is reflexive, while source closure ensures that
the target links remain valid for the recursively generated source rows. -/
noncomputable def toTargetRows
    (R : ClosedRows G fixed A₀ kappa huncountable hsingular hcard) :
    TargetRows G fixed A₀ kappa huncountable hsingular hcard where
  paths i _ := R.paths i
  isWarp i _ := R.isWarp i
  finiteCharacter i _ := R.finiteCharacter i
  initialSet i _ := R.initialSet i
  targetSegment i n a ha := by
    apply targetSegment_of_linksToTarget
    · apply linksToTarget_mono_sources (R.matrixSources_subset i n)
      exact R.links i
    · exact ha
  forward i _ := G.forwardExtension_refl (R.paths i)

end ClosedRows

/-! ## The exact post-choice fixed point

Taking an omega competitor closure after a simultaneous family of rows has
been chosen settles all of the cardinal and closure bookkeeping.  It does
not, by itself, say that the already chosen rows link the enlarged source
sets.  The following structure isolates precisely that remaining post-choice
selection requirement.

This is not an additional assumption hidden inside `ClosedRows`: the two
interfaces are equivalent.  Thus a proof of the constant-row strategy must
really choose rows which link the closure generated by those very rows.
-/

/-- Canonical competitor-closed rows, with the source sets defined to be the
omega closures generated by the chosen simultaneous path family. -/
structure OmegaFixedPointRows
    (G : DWeb V) (fixed : Set G.DPath)
    (A₀ : Set V) (kappa : Cardinal.{u})
    (huncountable : aleph0 < kappa) (hsingular : kappa.IsSingular)
    (hcard : #A₀ = kappa) where
  paths : Index kappa → Set G.DPath
  isWarp : ∀ i, G.IsWarp (paths i)
  finiteCharacter : ∀ i, G.HasFiniteCharacter (paths i)
  initialSet : ∀ i, G.initialSet (paths i) = G.source
  linksClosure : ∀ i,
    LinksToTarget G (paths i)
      (G.omegaCompetitorClosure (fixed ∪ ⋃ j, paths j)
        (sourceLayer A₀ kappa hcard huncountable hsingular i))

namespace OmegaFixedPointRows

variable {G : DWeb V} {fixed : Set G.DPath}
variable {A₀ : Set V} {kappa : Cardinal.{u}}
variable {huncountable : aleph0 < kappa} {hsingular : kappa.IsSingular}
variable {hcard : #A₀ = kappa}

/-- The canonical omega sources associated to a post-choice fixed point. -/
def sources
    (R : OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard) (i : Index kappa) : Set V :=
  G.omegaCompetitorClosure (fixed ∪ ⋃ j, R.paths j)
    (sourceLayer A₀ kappa hcard huncountable hsingular i)

/-- A post-choice omega fixed point is a competitor-closed constant row. -/
noncomputable def toClosedRows
    (R : OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard) :
    ClosedRows G fixed A₀ kappa huncountable hsingular hcard where
  sources := R.sources
  paths := R.paths
  seed i := G.subset_omegaCompetitorClosure
    (fixed ∪ ⋃ j, R.paths j)
    (sourceLayer A₀ kappa hcard huncountable hsingular i)
  isWarp := R.isWarp
  finiteCharacter := R.finiteCharacter
  initialSet := R.initialSet
  links i := R.linksClosure i
  closed i := G.competitorClosure_omega_subset
    (fixed ∪ ⋃ j, R.paths j)
    (sourceLayer A₀ kappa hcard huncountable hsingular i)

/-- The canonical omega source retains the exact singular scale.  This
discharges the set-theoretic part of the fixed-point strategy; only
`linksClosure` is a genuine selection obligation. -/
theorem mk_sources_eq
    (R : OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard)
    (hfixed : G.IsWarp fixed) (i : Index kappa) :
    #(R.sources i) = scale kappa huncountable hsingular i := by
  apply G.mk_omegaCompetitorClosure_eq
  · rw [sourceLayer_card A₀ kappa hcard huncountable hsingular i]
  · exact scale_infinite kappa huncountable hsingular i
  · intro n
    apply G.mk_competitorIterate_fixed_iUnion_le fixed R.paths
    · exact hfixed
    · exact R.isWarp
    · exact scale_infinite kappa huncountable hsingular i
    · exact scale_index_le kappa huncountable hsingular i
    · rw [sourceLayer_card A₀ kappa hcard huncountable hsingular i]

/-- Once the ambient web is already linkable, the post-choice fixed point is
immediate: repeat one full linkage in every column.  This converse is useful
as an audit of the strategy's strength.  It shows why omega closure alone
cannot establish the singular extension step: selecting these fixed-point
rows already contains the missing linkability conclusion. -/
noncomputable def ofLinkage
    (hA₀ : A₀ ⊆ G.source)
    (hfixed : IsLinkageBetween G (G.source \ A₀) G.target fixed)
    {P : Set G.DPath}
    (hP : IsLinkageBetween G G.source G.target P) :
    OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard where
  paths := fun _ ↦ P
  isWarp := fun _ ↦ hP.isWarp
  finiteCharacter := fun _ ↦ hP.finiteCharacter
  initialSet := fun _ ↦ hP.initialSet_eq
  linksClosure i := by
    have hseed :
        sourceLayer A₀ kappa hcard huncountable hsingular i ⊆ G.source :=
      (sourceLayer_subset A₀ kappa hcard huncountable hsingular i).trans hA₀
    have hclosed :
        G.competitorClosure (fixed ∪ ⋃ _j : Index kappa, P) G.source ⊆
          G.source := by
      rintro b ⟨_a, _ha, _p, _hp, _hpa, q, hq, hqb, _hpq⟩
      have hqInitial : q.initial ∈ G.source := by
        rcases hq with hqFixed | hqRows
        · have : q.initial ∈ G.source \ A₀ := by
            rw [← hfixed.initialSet_eq]
            exact ⟨q, hqFixed, rfl⟩
          exact this.1
        · obtain ⟨_j, hqP⟩ := Set.mem_iUnion.1 hqRows
          rw [← hP.initialSet_eq]
          exact ⟨q, hqP, rfl⟩
      exact hqb ▸ hqInitial
    apply ClosedRows.linksToTarget_mono_sources
      (G.omegaCompetitorClosure_minimal
        (fixed ∪ ⋃ _j : Index kappa, P) hseed hclosed)
    exact SingularExtension.linksToTarget_of_linkageToTarget hP

/-- Linkability is the only extra input needed to obtain the canonical
fixed-point rows. -/
noncomputable def ofIsLinkable
    (hA₀ : A₀ ⊆ G.source)
    (hfixed : IsLinkageBetween G (G.source \ A₀) G.target fixed)
    (hG : IsLinkable G) :
    OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard :=
  ofLinkage hA₀ hfixed hG.choose_spec

end OmegaFixedPointRows

namespace ClosedRows

variable {G : DWeb V} {fixed : Set G.DPath}
variable {A₀ : Set V} {kappa : Cardinal.{u}}
variable {huncountable : aleph0 < kappa} {hsingular : kappa.IsSingular}
variable {hcard : #A₀ = kappa}

/-- Conversely, every abstract competitor-closed constant row links its
canonical omega closure.  Hence `ClosedRows` and `OmegaFixedPointRows` have
exactly the same mathematical selection strength. -/
noncomputable def toOmegaFixedPointRows
    (R : ClosedRows G fixed A₀ kappa huncountable hsingular hcard) :
    OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard where
  paths := R.paths
  isWarp := R.isWarp
  finiteCharacter := R.finiteCharacter
  initialSet := R.initialSet
  linksClosure i := by
    apply linksToTarget_mono_sources
      (G.omegaCompetitorClosure_minimal
        (fixed ∪ ⋃ j, R.paths j) (R.seed i) (R.closed i))
    exact R.links i

end ClosedRows

/-- For the concrete complementary linkage used in the singular extension
step, existence of the proposed constant fixed-point rows is equivalent to
linkability of the whole web.  The forward implication is Assertion 9.18
applied to the repeated rows; the reverse implication repeats a full
linkage.  Consequently this fixed-point formulation is exact, but it is not
a weaker replacement for the missing singular selection theorem. -/
theorem nonempty_omegaFixedPointRows_iff_isLinkable
    {G : DWeb V} {fixed : Set G.DPath}
    {A₀ : Set V} {kappa : Cardinal.{u}}
    {huncountable : aleph0 < kappa} {hsingular : kappa.IsSingular}
    {hcard : #A₀ = kappa}
    (hA₀ : A₀ ⊆ G.source)
    (hfixed : IsLinkageBetween G (G.source \ A₀) G.target fixed) :
    Nonempty (OmegaFixedPointRows G fixed A₀ kappa
      huncountable hsingular hcard) ↔ IsLinkable G := by
  constructor
  · rintro ⟨R⟩
    exact SingularExtension.isLinkable_of_targetRows
      R.toClosedRows.toTargetRows hA₀ hfixed
  · intro hG
    exact ⟨OmegaFixedPointRows.ofIsLinkable hA₀ hfixed hG⟩

/-- Exact reduction of the singular extension clause to a jointly selected
competitor-closed batch.  Unlike a successor rule for arbitrary rows, this
interface asks only for the one existential batch which the matrix actually
consumes. -/
theorem singularExtensionClauseAt_of_closedRows
    (kappa : Cardinal.{u})
    (hkappa : aleph0 < kappa)
    (hsingular : kappa.IsSingular)
    (Gamma : DWeb V)
    (hrows : ∀ (A₀ : Set V), A₀ ⊆ Gamma.source →
      (hcard : #A₀ = kappa) →
      ∀ fixed : Set Gamma.DPath,
        IsLinkageBetween Gamma (Gamma.source \ A₀) Gamma.target fixed →
        ClosedRows Gamma fixed A₀ kappa hkappa hsingular hcard) :
    ExtensionClauseAt Gamma kappa := by
  apply singularExtensionClauseAt_of_targetRows kappa hkappa hsingular Gamma
  intro A₀ hA₀ hcard fixed hfixed
  exact (hrows A₀ hA₀ hcard fixed hfixed).toTargetRows

/-- Normalized form of `singularExtensionClauseAt_of_closedRows`, in the
exact shape needed by the public singular branch.  The simultaneous closed
batch is constructed only in the normalized web; all exceptional-set
exchange and transport back to the original web are discharged by
`RegularNormalization.extensionClauseAt_of_normalized`. -/
theorem singularExtensionClauseAt_of_normalizedClosedRows
    (kappa : Cardinal.{u})
    (hkappa : aleph0 < kappa)
    (hsingular : kappa.IsSingular)
    (Gamma : DWeb V)
    (hrows : ∀ (A₀ : Set V), A₀ ⊆ Gamma.normalized.source →
      (hcard : #A₀ = kappa) →
      ∀ fixed : Set Gamma.normalized.DPath,
        IsLinkageBetween Gamma.normalized
            (Gamma.normalized.source \ A₀) Gamma.normalized.target fixed →
        ClosedRows Gamma.normalized fixed A₀ kappa
          hkappa hsingular hcard) :
    ExtensionClauseAt Gamma kappa := by
  apply RegularNormalization.extensionClauseAt_of_normalized kappa hkappa.le
  exact singularExtensionClauseAt_of_closedRows
    kappa hkappa hsingular Gamma.normalized hrows

end SingularClosedTargetRows
end CardinalInduction
end Erdos599
