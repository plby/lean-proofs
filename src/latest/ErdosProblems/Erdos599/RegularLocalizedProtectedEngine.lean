import ErdosProblems.Erdos599.ProtectedCardinalAssembly
import ErdosProblems.Erdos599.RegularLocalizedProtectedExtension

/-!
# Protected regular engine from canonical split grounding

This is the thin public adapter between the concrete repaired regular
construction and the truthful protected cardinal induction.  Its only
premise is the still-visible split-grounding theorem, uniformly over the
normalized edge subwebs of the fixed ambient web.
-/

noncomputable section

open Cardinal Set

namespace Erdos599
namespace CardinalInduction
namespace RegularLocalizedProtectedEngine

universe u

variable {V : Type u}

/-- Canonical split grounding uniformly over normalized edge subwebs of a
fixed ambient web.  The actual ladders quantified here are restricted by
`HasCanonicalSplitGrounding` to those generated by the repaired causal row. -/
def HasCanonicalSplitGroundingFor (Base : DWeb V) : Prop :=
  ∀ (kappa : Cardinal.{u}), ∀ (huncountable : aleph0 < kappa),
    ∀ (hregular : kappa.IsRegular),
    ∀ (G : DWeb V),
      (∀ {x y : V}, G.graph.Adj x y → Base.graph.Adj x y) →
      ∀ (hNorm : G.IsNormalized),
        RegularLocalizedProtectedExtension.HasCanonicalSplitGrounding
          G hregular huncountable hNorm

/-- The concrete repaired regular construction is a protected regular
engine once canonical split grounding is supplied. -/
theorem regularEngineFor_of_canonicalSplitGrounding
    (Base : DWeb V) (hground : HasCanonicalSplitGroundingFor Base) :
    ProtectedCardinalAssembly.RegularEngineFor Base := by
  intro kappa huncountable hregular G hGBase hNorm hUnhindered hext hhalf
  exact
    RegularLocalizedProtectedExtension.extensionClauseAt_of_protectedLower_and_splitGrounding
      G hregular huncountable hNorm hUnhindered hext hhalf
        (hground kappa huncountable hregular G hGBase hNorm)

#print axioms regularEngineFor_of_canonicalSplitGrounding

end RegularLocalizedProtectedEngine
end CardinalInduction
end Erdos599
