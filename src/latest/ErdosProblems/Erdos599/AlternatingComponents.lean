import ErdosProblems.Erdos599.Alternating

/-!
# Countable alternating components

This file isolates the countability argument used at the start of the proof
of Aharoni--Berger, Theorem 4.12.  If `Z` and `Y` are finite-character
warps, the undirected graph whose edge set is `E[Z] ∪ E[Y]` is locally
finite.  Consequently each of its connected components is countable.

The proof does not assume that the ambient vertex type is countable.  Local
finiteness follows from the warp property: through a fixed vertex there is
at most one member of each warp, and finite character makes the support of
that member finite.
-/

namespace Erdos599

open Set
open DirectedPath

universe u v

namespace AlternatingComponents

variable {V : Type u} {Γ : DWeb V}

/-! ## The undirected relation generated by the two warp edge sets -/

/-- Two vertices lie on a common member of a path family.  This auxiliary
relation is used only to prove local finiteness of the actual edge relation. -/
def SameWarpPath (W : Set Γ.DPath) (x y : V) : Prop :=
  ∃ p ∈ W, x ∈ p.support ∧ y ∈ p.support

/-- The symmetric adjacency relation whose unoriented edge set is
`E[Z] ∪ E[Y]`. -/
def EdgeRel (Z Y : Set Γ.DPath) (x y : V) : Prop :=
  (x, y) ∈ Alternating.familyEdges Z ∪ Alternating.familyEdges Y ∨
    (y, x) ∈ Alternating.familyEdges Z ∪ Alternating.familyEdges Y

/-- The connected component of `root` in `E[Z] ∪ E[Y]`. -/
def component (Z Y : Set Γ.DPath) (root : V) : Set V :=
  {x | Relation.ReflTransGen (EdgeRel Z Y) root x}

theorem edgeRel_symm {Z Y : Set Γ.DPath} {x y : V} :
    EdgeRel Z Y x y → EdgeRel Z Y y x := by
  intro h
  exact h.symm

theorem mem_component_self (Z Y : Set Γ.DPath) (root : V) :
    root ∈ component Z Y root :=
  Relation.ReflTransGen.refl

theorem component_trans {Z Y : Set Γ.DPath} {x y z : V}
    (hxy : y ∈ component Z Y x) (hyz : z ∈ component Z Y y) :
    z ∈ component Z Y x :=
  hxy.trans hyz

private theorem reflTransGen_symm_of_symm
    {α : Type v} {r : α → α → Prop}
    (hr : ∀ {x y}, r x y → r y x) {x y : α}
    (h : Relation.ReflTransGen r x y) : Relation.ReflTransGen r y x := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      exact (Relation.ReflTransGen.single (hr hbc)).trans ih

theorem component_symm {Z Y : Set Γ.DPath} {x y : V}
    (h : y ∈ component Z Y x) : x ∈ component Z Y y :=
  reflTransGen_symm_of_symm (fun {_ _} hxy ↦ edgeRel_symm hxy) h

/-! ## Local finiteness -/

/-- In a finite-character warp, only finitely many vertices can share a
warp member with a fixed vertex. -/
theorem finite_sameWarpPath_neighbors {W : Set Γ.DPath}
    (hW : Γ.IsWarp W) (hfinite : Γ.HasFiniteCharacter W) (x : V) :
    {y | SameWarpPath W x y}.Finite := by
  by_cases hx : ∃ p ∈ W, x ∈ p.support
  · obtain ⟨p, hpW, hxp⟩ := hx
    obtain ⟨q, hpq⟩ := hfinite hpW
    subst p
    refine q.support_finite.subset ?_
    intro y hy
    obtain ⟨r, hrW, hxr, hyr⟩ := hy
    have hrq : r = (.inl q : Γ.DPath) :=
      Alternating.DWeb.IsWarp.eq_of_mem_support hW hrW hpW hxr hxp
    rw [hrq] at hyr
    exact hyr
  · have hempty : {y | SameWarpPath W x y} = (∅ : Set V) := by
      ext y
      constructor
      · rintro ⟨p, hpW, hxp, _⟩
        exact (hx ⟨p, hpW, hxp⟩).elim
      · simp
    rw [hempty]
    exact Set.finite_empty

private theorem edge_mem_implies_sameWarpPath
    {W : Set Γ.DPath} {x y : V}
    (h : (x, y) ∈ Alternating.familyEdges W) : SameWarpPath W x y := by
  simp only [Alternating.familyEdges, Set.mem_iUnion] at h
  obtain ⟨p, hpW, he⟩ := h
  have hs := p.edgeSet_subset_support_prod he
  exact ⟨p, hpW, hs.1, hs.2⟩

theorem edgeRel_implies_sameWarpPath {Z Y : Set Γ.DPath} {x y : V}
    (h : EdgeRel Z Y x y) :
    SameWarpPath Z x y ∨ SameWarpPath Y x y := by
  rcases h with h | h
  · rcases h with h | h
    · exact Or.inl (edge_mem_implies_sameWarpPath h)
    · exact Or.inr (edge_mem_implies_sameWarpPath h)
  · rcases h with h | h
    · have hs := edge_mem_implies_sameWarpPath h
      exact Or.inl ⟨hs.choose, hs.choose_spec.1,
        hs.choose_spec.2.2, hs.choose_spec.2.1⟩
    · have hs := edge_mem_implies_sameWarpPath h
      exact Or.inr ⟨hs.choose, hs.choose_spec.1,
        hs.choose_spec.2.2, hs.choose_spec.2.1⟩

/-- The actual `E[Z] ∪ E[Y]` adjacency relation is locally finite. -/
theorem finite_edgeRel_neighbors {Z Y : Set Γ.DPath}
    (hZ : Γ.IsWarp Z) (hY : Γ.IsWarp Y)
    (hZfinite : Γ.HasFiniteCharacter Z)
    (hYfinite : Γ.HasFiniteCharacter Y) (x : V) :
    {y | EdgeRel Z Y x y}.Finite := by
  refine ((finite_sameWarpPath_neighbors hZ hZfinite x).union
    (finite_sameWarpPath_neighbors hY hYfinite x)).subset ?_
  intro y hy
  exact edgeRel_implies_sameWarpPath hy

/-! ## A general countable-reachability lemma -/

/-- Vertices reachable in exactly `n` applications of `r`, with the root in
layer zero. -/
def reachLayer {α : Type v} (r : α → α → Prop) (root : α) : ℕ → Set α
  | 0 => {root}
  | n + 1 => ⋃ x ∈ reachLayer r root n, {y | r x y}

private theorem mem_reachLayer_of_reflTransGen
    {α : Type v} {r : α → α → Prop} {root x : α}
    (h : Relation.ReflTransGen r root x) :
    ∃ n, x ∈ reachLayer r root n := by
  induction h with
  | refl => exact ⟨0, by simp [reachLayer]⟩
  | @tail y z hxy hyz ih =>
      obtain ⟨n, hyn⟩ := ih
      refine ⟨n + 1, ?_⟩
      simp only [reachLayer, Set.mem_iUnion]
      exact ⟨y, ⟨hyn, hyz⟩⟩

/-- A relation with countable outgoing neighborhoods has countable
reflexive-transitive reachability sets. -/
theorem countable_reflTransGen_of_countable_neighbors
    {α : Type v} {r : α → α → Prop}
    (hr : ∀ x, {y | r x y}.Countable) (root : α) :
    {x | Relation.ReflTransGen r root x}.Countable := by
  have hlayer : ∀ n, (reachLayer r root n).Countable := by
    intro n
    induction n with
    | zero => exact Set.finite_singleton root |>.countable
    | succ n ih =>
        exact ih.biUnion (fun x _ ↦ hr x)
  refine (Set.countable_iUnion hlayer).mono ?_
  intro x hx
  obtain ⟨n, hxn⟩ := mem_reachLayer_of_reflTransGen hx
  exact Set.mem_iUnion.2 ⟨n, hxn⟩

/-- Every connected component of the union of two finite-character warps is
countable.  This is the countability input in Theorem 4.12. -/
theorem component_countable {Z Y : Set Γ.DPath}
    (hZ : Γ.IsWarp Z) (hY : Γ.IsWarp Y)
    (hZfinite : Γ.HasFiniteCharacter Z)
    (hYfinite : Γ.HasFiniteCharacter Y) (root : V) :
    (component Z Y root).Countable := by
  apply countable_reflTransGen_of_countable_neighbors
  intro x
  exact (finite_edgeRel_neighbors hZ hY hZfinite hYfinite x).countable

/-! ## Components contain every touched path -/

private theorem walk_start_reaches_of_edgeSet_subset
    {E : Set (V × V)} {a b x : V} (p : Walk Γ.graph a b)
    (hpE : p.edgeSet ⊆ E) (hx : x ∈ p.support) :
    Relation.ReflTransGen (fun u v ↦ (u, v) ∈ E ∨ (v, u) ∈ E) a x := by
  induction p with
  | nil =>
      simp only [Walk.support_nil, List.mem_singleton] at hx
      subst x
      exact Relation.ReflTransGen.refl
  | @cons a c b hac p ih =>
      simp only [Walk.support_cons, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact Relation.ReflTransGen.refl
      · have hacE : (a, c) ∈ E := hpE (by simp [Walk.edgeSet])
        have hpTail : p.edgeSet ⊆ E := by
          intro e he
          exact hpE (by simp [Walk.edgeSet, he])
        have hacStep :
            (fun u v : V ↦ (u, v) ∈ E ∨ (v, u) ∈ E) a c :=
          Or.inl hacE
        exact Relation.ReflTransGen.trans
          (r := fun u v : V ↦ (u, v) ∈ E ∨ (v, u) ∈ E)
          (Relation.ReflTransGen.single hacStep) (ih hpTail hx)

private theorem finitePath_connected_of_edgeSet_subset
    {E : Set (V × V)} (p : FinitePath Γ.graph)
    (hpE : p.edgeSet ⊆ E) {x y : V} (hxp : x ∈ p.support)
    (hyp : y ∈ p.support) :
    Relation.ReflTransGen (fun u v ↦ (u, v) ∈ E ∨ (v, u) ∈ E) x y := by
  have hsx := walk_start_reaches_of_edgeSet_subset p.walk hpE hxp
  have hsy := walk_start_reaches_of_edgeSet_subset p.walk hpE hyp
  exact (reflTransGen_symm_of_symm (fun {_ _} h ↦ h.symm) hsx).trans hsy

private theorem finitePath_edgeSet_subset_familyEdges
    {W : Set Γ.DPath} {p : FinitePath Γ.graph}
    (hpW : (.inl p : Γ.DPath) ∈ W) :
    p.edgeSet ⊆ Alternating.familyEdges W := by
  intro e he
  simp only [Alternating.familyEdges, Set.mem_iUnion]
  exact ⟨.inl p, hpW, he⟩

theorem finitePath_support_subset_component_left
    {Z Y : Set Γ.DPath} {p : FinitePath Γ.graph}
    (hpZ : (.inl p : Γ.DPath) ∈ Z) {x : V} (hxp : x ∈ p.support) :
    p.support ⊆ component Z Y x := by
  intro y hyp
  apply finitePath_connected_of_edgeSet_subset p
    (E := Alternating.familyEdges Z ∪ Alternating.familyEdges Y)
  · exact (finitePath_edgeSet_subset_familyEdges hpZ).trans Set.subset_union_left
  · exact hxp
  · exact hyp

theorem finitePath_support_subset_component_right
    {Z Y : Set Γ.DPath} {p : FinitePath Γ.graph}
    (hpY : (.inl p : Γ.DPath) ∈ Y) {x : V} (hxp : x ∈ p.support) :
    p.support ⊆ component Z Y x := by
  intro y hyp
  apply finitePath_connected_of_edgeSet_subset p
    (E := Alternating.familyEdges Z ∪ Alternating.familyEdges Y)
  · exact (finitePath_edgeSet_subset_familyEdges hpY).trans Set.subset_union_right
  · exact hxp
  · exact hyp

/-- If a component touches a member of `Z`, it contains the whole member. -/
theorem finitePath_support_subset_component_of_touches_left
    {Z Y : Set Γ.DPath} {root x : V} {p : FinitePath Γ.graph}
    (hxC : x ∈ component Z Y root) (hpZ : (.inl p : Γ.DPath) ∈ Z)
    (hxp : x ∈ p.support) : p.support ⊆ component Z Y root := by
  intro y hyp
  exact hxC.trans (finitePath_support_subset_component_left hpZ hxp hyp)

/-- If a component touches a member of `Y`, it contains the whole member. -/
theorem finitePath_support_subset_component_of_touches_right
    {Z Y : Set Γ.DPath} {root x : V} {p : FinitePath Γ.graph}
    (hxC : x ∈ component Z Y root) (hpY : (.inl p : Γ.DPath) ∈ Y)
    (hxp : x ∈ p.support) : p.support ⊆ component Z Y root := by
  intro y hyp
  exact hxC.trans (finitePath_support_subset_component_right hpY hxp hyp)

/-! ## Countable source enumeration in each component -/

/-- The `Z`-initial vertices uncovered by `Y` inside one component form a
countable set. -/
theorem component_initial_difference_countable {Z Y : Set Γ.DPath}
    (hZ : Γ.IsWarp Z) (hY : Γ.IsWarp Y)
    (hZfinite : Γ.HasFiniteCharacter Z)
    (hYfinite : Γ.HasFiniteCharacter Y) (root : V) :
    ((Γ.initialSet Z \ Γ.initialSet Y) ∩ component Z Y root).Countable :=
  (component_countable hZ hY hZfinite hYfinite root).mono Set.inter_subset_right

/-- A concrete enumeration covering the `Z`-initial vertices uncovered by
`Y` in the component of `root`.  The root supplies a default value, so this
also handles the empty set without an ambient `Nonempty V` assumption. -/
noncomputable def enumerateComponentInitialDifference
    {Z Y : Set Γ.DPath}
    (hZ : Γ.IsWarp Z) (hY : Γ.IsWarp Y)
    (hZfinite : Γ.HasFiniteCharacter Z)
    (hYfinite : Γ.HasFiniteCharacter Y) (root : V) : ℕ → V :=
  Set.enumerateCountable
    (component_initial_difference_countable hZ hY hZfinite hYfinite root) root

theorem component_initial_difference_subset_range_enumeration
    {Z Y : Set Γ.DPath}
    (hZ : Γ.IsWarp Z) (hY : Γ.IsWarp Y)
    (hZfinite : Γ.HasFiniteCharacter Z)
    (hYfinite : Γ.HasFiniteCharacter Y) (root : V) :
    (Γ.initialSet Z \ Γ.initialSet Y) ∩ component Z Y root ⊆
      Set.range
        (enumerateComponentInitialDifference hZ hY hZfinite hYfinite root) :=
  Set.subset_range_enumerate
    (component_initial_difference_countable hZ hY hZfinite hYfinite root) root

end AlternatingComponents

end Erdos599
