  | tt o => exact ⟨o, Order5.known_sound hag hcheck⟩
  | split pos no yes ihno ihyes =>
      rw [Cert.check, Bool.and_eq_true] at hcheck
      cases hbit : cross.getLsbD pos with
      | false =>
          apply ihno (⟨pos, false⟩ :: env) hcheck.1
          exact agrees_cons hag hbit
      | true =>
          apply ihyes (⟨pos, true⟩ :: env) hcheck.2
          exact agrees_cons hag hbit

theorem five_exists (cross : BitVec 42) :
    ∃ o : Order5, o.holds cross = true :=
  Cert.sound certificate cross [] certificate_checked (by simp [Agrees])

end Normalized

