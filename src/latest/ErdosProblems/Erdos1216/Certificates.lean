theorem Cert.sound (cert : Cert) (code : BitVec 28) (env : Assignment)
    (hcheck : cert.check env = true) (hag : Agrees code env) :
    ∃ o : Order4, o.holds code 8 = true := by
  induction cert generalizing env with
  | tt o => exact ⟨o, Order4.known_sound hag hcheck⟩
  | split pos no yes ihno ihyes =>
      rw [Cert.check, Bool.and_eq_true] at hcheck
      cases hbit : code.getLsbD pos with
      | false =>
          apply ihno (⟨pos, false⟩ :: env) hcheck.1
          exact agrees_cons hag hbit
      | true =>
          apply ihyes (⟨pos, true⟩ :: env) hcheck.2
          exact agrees_cons hag hbit

theorem four_exists (code : BitVec 28) :
    ∃ o : Order4, o.holds code 8 = true :=
  Cert.sound certificate code [] certificate_checked (by simp [Agrees])

