import Mathlib.LinearAlgebra.Matrix.Notation

/-!
Kernel-checked finite branching certificates for Erdős Problem 1216.
The closed checker equations are proved by definitional reduction.
-/

namespace Erdos1216.Certificates

structure Lit where
  pos : Nat
  val : Bool
  deriving DecidableEq

abbrev Assignment := List Lit

def assigned (env : Assignment) (pos : Nat) (val : Bool) : Bool :=
  decide (⟨pos, val⟩ ∈ env)

def pairIndex (n i j : Nat) : Nat :=
  i * (2 * n - i - 1) / 2 + (j - i - 1)

def arcLit (n i j : Nat) : Lit :=
  if i < j then ⟨pairIndex n i j, true⟩ else ⟨pairIndex n j i, false⟩

def litSatisfied {w : Nat} (code : BitVec w) (lit : Lit) : Bool :=
  code.getLsbD lit.pos == lit.val

def allAssigned (env : Assignment) (lits : List Lit) : Bool :=
  lits.all fun lit ↦ assigned env lit.pos lit.val

def Agrees {w : Nat} (code : BitVec w) (env : Assignment) : Prop :=
  ∀ lit ∈ env, code.getLsbD lit.pos = lit.val

lemma assigned_sound {w : Nat} {code : BitVec w} {env : Assignment}
    {pos : Nat} {val : Bool} (hag : Agrees code env)
    (h : assigned env pos val = true) : code.getLsbD pos = val := by
  apply hag ⟨pos, val⟩
  exact of_decide_eq_true h

lemma allAssigned_sound {w : Nat} {code : BitVec w} {env : Assignment}
    {lits : List Lit} (hag : Agrees code env)
    (h : allAssigned env lits = true) :
    lits.all (litSatisfied code) = true := by
  induction lits with
  | nil => rfl
  | cons lit lits ih =>
      simp only [allAssigned, List.all_cons, Bool.and_eq_true] at h ⊢
      have heq := assigned_sound hag h.1
      exact ⟨by simp [litSatisfied, heq], ih h.2⟩

lemma agrees_cons {w : Nat} {code : BitVec w} {env : Assignment}
    {pos : Nat} {val : Bool} (hag : Agrees code env)
    (hval : code.getLsbD pos = val) :
    Agrees code (⟨pos, val⟩ :: env) := by
  intro lit hlit
  simp only [List.mem_cons] at hlit
  rcases hlit with rfl | hlit
  · exact hval
  · exact hag lit hlit

structure Order4 where
  a : Nat
  b : Nat
  c : Nat
  d : Nat

def Order4.data (n : Nat) (o : Order4) : Bool :=
  o.a < n && o.b < n && o.c < n && o.d < n &&
  o.a != o.b && o.a != o.c && o.a != o.d && o.b != o.c &&
  o.b != o.d && o.c != o.d

def Order4.lits (n : Nat) (o : Order4) : List Lit :=
  [arcLit n o.a o.b, arcLit n o.a o.c, arcLit n o.a o.d,
    arcLit n o.b o.c, arcLit n o.b o.d, arcLit n o.c o.d]

def Order4.known (env : Assignment) (n : Nat) (o : Order4) : Bool :=
  o.data n && allAssigned env (o.lits n)

def Order4.holds {w : Nat} (code : BitVec w) (n : Nat) (o : Order4) : Bool :=
  o.data n && (o.lits n).all (litSatisfied code)

lemma Order4.known_sound {w : Nat} {code : BitVec w} {env : Assignment}
    {n : Nat} {o : Order4} (hag : Agrees code env)
    (h : o.known env n = true) : o.holds code n = true := by
  rw [Order4.known, Bool.and_eq_true] at h
  rw [Order4.holds, Bool.and_eq_true]
  exact ⟨h.1, allAssigned_sound hag h.2⟩

namespace Q6

def qArc (i j : Fin 6) : Bool :=
  let a := i.1 + 1
  let b := j.1 + 1
  decide ((b + 7 - a) % 7 = 1 ∨ (b + 7 - a) % 7 = 2 ∨ (b + 7 - a) % 7 = 4)

def injectiveBool (p : Fin 6 → Fin 6) : Bool :=
    (p 0 != p 1) &&
    (p 0 != p 2) &&
    (p 0 != p 3) &&
    (p 0 != p 4) &&
    (p 0 != p 5) &&
    (p 1 != p 2) &&
    (p 1 != p 3) &&
    (p 1 != p 4) &&
    (p 1 != p 5) &&
    (p 2 != p 3) &&
    (p 2 != p 4) &&
    (p 2 != p 5) &&
    (p 3 != p 4) &&
    (p 3 != p 5) &&
    (p 4 != p 5)

def orbitLits (p : Fin 6 → Fin 6) : List Lit := [
    ⟨pairIndex 6 0 1, qArc (p 0) (p 1)⟩,
    ⟨pairIndex 6 0 2, qArc (p 0) (p 2)⟩,
    ⟨pairIndex 6 0 3, qArc (p 0) (p 3)⟩,
    ⟨pairIndex 6 0 4, qArc (p 0) (p 4)⟩,
    ⟨pairIndex 6 0 5, qArc (p 0) (p 5)⟩,
    ⟨pairIndex 6 1 2, qArc (p 1) (p 2)⟩,
    ⟨pairIndex 6 1 3, qArc (p 1) (p 3)⟩,
    ⟨pairIndex 6 1 4, qArc (p 1) (p 4)⟩,
    ⟨pairIndex 6 1 5, qArc (p 1) (p 5)⟩,
    ⟨pairIndex 6 2 3, qArc (p 2) (p 3)⟩,
    ⟨pairIndex 6 2 4, qArc (p 2) (p 4)⟩,
    ⟨pairIndex 6 2 5, qArc (p 2) (p 5)⟩,
    ⟨pairIndex 6 3 4, qArc (p 3) (p 4)⟩,
    ⟨pairIndex 6 3 5, qArc (p 3) (p 5)⟩,
    ⟨pairIndex 6 4 5, qArc (p 4) (p 5)⟩]

def orbitKnown (env : Assignment) (p : Fin 6 → Fin 6) : Bool :=
  injectiveBool p && allAssigned env (orbitLits p)

def orbitHolds (code : BitVec 15) (p : Fin 6 → Fin 6) : Bool :=
  injectiveBool p && (orbitLits p).all (litSatisfied code)

inductive Cert where
  | tt (o : Order4)
  | orbit (p : Fin 6 → Fin 6)
  | split (pos : Nat) (no yes : Cert)

def Cert.check (env : Assignment) : Cert → Bool
  | .tt o => o.known env 6
  | .orbit p => orbitKnown env p
  | .split pos no yes =>
      no.check (⟨pos, false⟩ :: env) && yes.check (⟨pos, true⟩ :: env)

