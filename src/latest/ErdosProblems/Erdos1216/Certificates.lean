theorem certificate_checked : certificate.check [] = true := by
  rfl

lemma orbitKnown_sound {code : BitVec 15} {env : Assignment} {p : Fin 6 → Fin 6}
    (hag : Agrees code env) (h : orbitKnown env p = true) :
    orbitHolds code p = true := by
  rw [orbitKnown, Bool.and_eq_true] at h
  rw [orbitHolds, Bool.and_eq_true]
  exact ⟨h.1, allAssigned_sound hag h.2⟩

theorem Cert.sound (cert : Cert) (code : BitVec 15) (env : Assignment)
    (hcheck : cert.check env = true) (hag : Agrees code env) :
    (∃ o : Order4, o.holds code 6 = true) ∨
      (∃ p : Fin 6 → Fin 6, orbitHolds code p = true) := by
  induction cert generalizing env with
  | tt o => exact Or.inl ⟨o, Order4.known_sound hag hcheck⟩
  | orbit p => exact Or.inr ⟨p, orbitKnown_sound hag hcheck⟩
  | split pos no yes ihno ihyes =>
      rw [Cert.check, Bool.and_eq_true] at hcheck
      cases hbit : code.getLsbD pos with
      | false =>
          apply ihno (⟨pos, false⟩ :: env) hcheck.1
          exact agrees_cons hag hbit
      | true =>
          apply ihyes (⟨pos, true⟩ :: env) hcheck.2
          exact agrees_cons hag hbit

theorem classification (code : BitVec 15)
    (hfree : ∀ o : Order4, o.holds code 6 ≠ true) :
    ∃ p : Fin 6 → Fin 6, orbitHolds code p = true := by
  have hsound := Cert.sound certificate code [] certificate_checked (by simp [Agrees])
  rcases hsound with ⟨o, ho⟩ | hp
  · exact (hfree o ho).elim
  · exact hp

end Q6

namespace Q7

def qArc (i j : Fin 7) : Bool :=
  let a := i.1
  let b := j.1
  decide ((b + 7 - a) % 7 = 1 ∨ (b + 7 - a) % 7 = 2 ∨ (b + 7 - a) % 7 = 4)

def injectiveBool (p : Fin 7 → Fin 7) : Bool :=
    (p 0 != p 1) &&
    (p 0 != p 2) &&
    (p 0 != p 3) &&
    (p 0 != p 4) &&
    (p 0 != p 5) &&
    (p 0 != p 6) &&
    (p 1 != p 2) &&
    (p 1 != p 3) &&
    (p 1 != p 4) &&
    (p 1 != p 5) &&
    (p 1 != p 6) &&
    (p 2 != p 3) &&
    (p 2 != p 4) &&
    (p 2 != p 5) &&
    (p 2 != p 6) &&
    (p 3 != p 4) &&
    (p 3 != p 5) &&
    (p 3 != p 6) &&
    (p 4 != p 5) &&
    (p 4 != p 6) &&
    (p 5 != p 6)

def orbitLits (p : Fin 7 → Fin 7) : List Lit := [
    ⟨pairIndex 7 0 1, qArc (p 0) (p 1)⟩,
    ⟨pairIndex 7 0 2, qArc (p 0) (p 2)⟩,
    ⟨pairIndex 7 0 3, qArc (p 0) (p 3)⟩,
    ⟨pairIndex 7 0 4, qArc (p 0) (p 4)⟩,
    ⟨pairIndex 7 0 5, qArc (p 0) (p 5)⟩,
    ⟨pairIndex 7 0 6, qArc (p 0) (p 6)⟩,
    ⟨pairIndex 7 1 2, qArc (p 1) (p 2)⟩,
    ⟨pairIndex 7 1 3, qArc (p 1) (p 3)⟩,
    ⟨pairIndex 7 1 4, qArc (p 1) (p 4)⟩,
    ⟨pairIndex 7 1 5, qArc (p 1) (p 5)⟩,
    ⟨pairIndex 7 1 6, qArc (p 1) (p 6)⟩,
    ⟨pairIndex 7 2 3, qArc (p 2) (p 3)⟩,
    ⟨pairIndex 7 2 4, qArc (p 2) (p 4)⟩,
    ⟨pairIndex 7 2 5, qArc (p 2) (p 5)⟩,
    ⟨pairIndex 7 2 6, qArc (p 2) (p 6)⟩,
    ⟨pairIndex 7 3 4, qArc (p 3) (p 4)⟩,
    ⟨pairIndex 7 3 5, qArc (p 3) (p 5)⟩,
    ⟨pairIndex 7 3 6, qArc (p 3) (p 6)⟩,
    ⟨pairIndex 7 4 5, qArc (p 4) (p 5)⟩,
    ⟨pairIndex 7 4 6, qArc (p 4) (p 6)⟩,
    ⟨pairIndex 7 5 6, qArc (p 5) (p 6)⟩]

def orbitKnown (env : Assignment) (p : Fin 7 → Fin 7) : Bool :=
  injectiveBool p && allAssigned env (orbitLits p)

def orbitHolds (code : BitVec 21) (p : Fin 7 → Fin 7) : Bool :=
  injectiveBool p && (orbitLits p).all (litSatisfied code)

inductive Cert where
  | tt (o : Order4)
  | orbit (p : Fin 7 → Fin 7)
  | split (pos : Nat) (no yes : Cert)

def Cert.check (env : Assignment) : Cert → Bool
  | .tt o => o.known env 7
  | .orbit p => orbitKnown env p
  | .split pos no yes =>
      no.check (⟨pos, false⟩ :: env) && yes.check (⟨pos, true⟩ :: env)

