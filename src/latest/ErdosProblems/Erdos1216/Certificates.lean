lemma orbitKnown_sound {code : BitVec 21} {env : Assignment} {p : Fin 7 → Fin 7}
    (hag : Agrees code env) (h : orbitKnown env p = true) :
    orbitHolds code p = true := by
  rw [orbitKnown, Bool.and_eq_true] at h
  rw [orbitHolds, Bool.and_eq_true]
  exact ⟨h.1, allAssigned_sound hag h.2⟩

theorem Cert.sound (cert : Cert) (code : BitVec 21) (env : Assignment)
    (hcheck : cert.check env = true) (hag : Agrees code env) :
    (∃ o : Order4, o.holds code 7 = true) ∨
      (∃ p : Fin 7 → Fin 7, orbitHolds code p = true) := by
  induction cert generalizing env with
  | tt o => exact Or.inl ⟨o, Order4.known_sound hag hcheck⟩
  | orbit p => exact Or.inr ⟨p, orbitKnown_sound hag hcheck⟩
  | split pos no yes ihno ihyes =>
      rw [Cert.check, Bool.and_eq_true] at hcheck
      cases hbit : code.getLsbD pos with
      | false =>
          apply ihno (⟨pos, false⟩ :: env) hcheck.1
          exact agrees_cons hag hbit
      | true =>
          apply ihyes (⟨pos, true⟩ :: env) hcheck.2
          exact agrees_cons hag hbit

theorem classification (code : BitVec 21)
    (hfree : ∀ o : Order4, o.holds code 7 ≠ true) :
    ∃ p : Fin 7 → Fin 7, orbitHolds code p = true := by
  have hsound := Cert.sound certificate code [] certificate_checked (by simp [Agrees])
  rcases hsound with ⟨o, ho⟩ | hp
  · exact (hfree o ho).elim
  · exact hp

end Q7

namespace Normalized

def inA (i : Nat) : Bool := decide (1 ≤ i ∧ i ≤ 7)
def inB (i : Nat) : Bool := decide (8 ≤ i ∧ i ≤ 13)

def crossLit? (i j : Nat) : Option Lit :=
  if inA i && inB j then some ⟨(i - 1) * 6 + (j - 8), true⟩
  else if inB i && inA j then some ⟨(j - 1) * 6 + (i - 8), false⟩
  else none

def fixedArc (i j : Nat) : Bool :=
  if i = j then false
  else if i = 0 then inA j
  else if j = 0 then inB i
  else if (inA i && inA j) || (inB i && inB j) then
    decide ((j + 7 - i) % 7 = 1 ∨ (j + 7 - i) % 7 = 2 ∨
      (j + 7 - i) % 7 = 4)
  else false

def knownPair (env : Assignment) (ij : Nat × Nat) : Bool :=
  match crossLit? ij.1 ij.2 with
  | some lit => assigned env lit.pos lit.val
  | none => fixedArc ij.1 ij.2

def holdsPair (cross : BitVec 42) (ij : Nat × Nat) : Bool :=
  match crossLit? ij.1 ij.2 with
  | some lit => litSatisfied cross lit
  | none => fixedArc ij.1 ij.2

structure Order5 where
  a : Nat
  b : Nat
  c : Nat
  d : Nat
  e : Nat

def Order5.data (o : Order5) : Bool :=
  o.a < 14 && o.b < 14 && o.c < 14 && o.d < 14 && o.e < 14 &&
  o.a != o.b && o.a != o.c && o.a != o.d && o.a != o.e &&
  o.b != o.c && o.b != o.d && o.b != o.e &&
  o.c != o.d && o.c != o.e && o.d != o.e

def Order5.pairs (o : Order5) : List (Nat × Nat) :=
  [(o.a, o.b), (o.a, o.c), (o.a, o.d), (o.a, o.e),
    (o.b, o.c), (o.b, o.d), (o.b, o.e),
    (o.c, o.d), (o.c, o.e), (o.d, o.e)]

def Order5.known (env : Assignment) (o : Order5) : Bool :=
  o.data && o.pairs.all (knownPair env)

def Order5.holds (cross : BitVec 42) (o : Order5) : Bool :=
  o.data && o.pairs.all (holdsPair cross)

lemma knownPair_sound {cross : BitVec 42} {env : Assignment}
    (hag : Agrees cross env) {ij : Nat × Nat}
    (h : knownPair env ij = true) : holdsPair cross ij = true := by
  cases hopt : crossLit? ij.1 ij.2 with
  | none => simpa [knownPair, holdsPair, hopt] using h
  | some lit =>
      have ha : assigned env lit.pos lit.val = true := by
        simpa [knownPair, hopt] using h
      have hbit := assigned_sound hag ha
      simp [holdsPair, hopt, litSatisfied, hbit]

lemma all_knownPair_sound {cross : BitVec 42} {env : Assignment}
    (hag : Agrees cross env) {pairs : List (Nat × Nat)}
    (h : pairs.all (knownPair env) = true) :
    pairs.all (holdsPair cross) = true := by
  induction pairs with
  | nil => rfl
  | cons ij pairs ih =>
      simp only [List.all_cons, Bool.and_eq_true] at h ⊢
      exact ⟨knownPair_sound hag h.1, ih h.2⟩

lemma Order5.known_sound {cross : BitVec 42} {env : Assignment} {o : Order5}
    (hag : Agrees cross env) (h : o.known env = true) :
    o.holds cross = true := by
  rw [Order5.known, Bool.and_eq_true] at h
  rw [Order5.holds, Bool.and_eq_true]
  exact ⟨h.1, all_knownPair_sound hag h.2⟩

inductive Cert where
  | tt (o : Order5)
  | split (pos : Nat) (no yes : Cert)

def Cert.check (env : Assignment) : Cert → Bool
  | .tt o => o.known env
  | .split pos no yes =>
      no.check (⟨pos, false⟩ :: env) && yes.check (⟨pos, true⟩ :: env)

