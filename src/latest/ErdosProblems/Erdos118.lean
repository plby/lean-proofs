namespace Erdos118

/-- The exact requested counterexample at `lambda = ω ^ (ω ^ 2)`. -/
theorem counterexample_at_five :
    Partition lambda lambda 3 ∧ ¬ Partition lambda lambda 5 :=
  ⟨positive_three, negative_five⟩

/-- The already complete counterexample with finite target six. -/
theorem counterexample_at_six :
    Partition lambda lambda 3 ∧ ¬ Partition lambda lambda 6 :=
  ⟨positive_three, negative_six⟩

/-- The universal partition-ordinal implication is false, witnessed at five. -/
theorem not_erdos_118 :
    ¬ ∀ α : Ordinal.{0}, Partition α α 3 →
      ∀ n : ℕ, 3 ≤ n → Partition α α n := by
  intro h
  exact negative_five (h lambda positive_three 5 (by decide))

end Erdos118
