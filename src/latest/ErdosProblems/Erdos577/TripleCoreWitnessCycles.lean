lemma cycle_injective (tag : Fin 12) (j slot : Fin 4) :
    Function.Injective (cycleVertices tag j slot) := by
  have hall : ∀ tag : Fin 12, ∀ j slot : Fin 4,
      Function.Injective (cycleVertices tag j slot) := by decide +kernel
  exact hall tag j slot

lemma cycle_edges (tag : Fin 12) (j slot i : Fin 4) :
    (graph tag).Adj (cycleVertices tag j slot i) (cycleVertices tag j slot (i + 1)) := by
  have hall : ∀ tag : Fin 12, ∀ j slot i : Fin 4,
      (graph tag).Adj (cycleVertices tag j slot i) (cycleVertices tag j slot (i + 1)) := by
    decide +kernel
  exact hall tag j slot i

def quad (tag : Fin 12) (j slot : Fin 4) : Quadrilateral (graph tag) :=
  Quadrilateral.ofEdges ⟨cycleVertices tag j slot, cycle_injective tag j slot⟩
    (cycle_edges tag j slot)

lemma quad_support (tag : Fin 12) (j slot : Fin 4) :
    (quad tag j slot).support = target tag j slot := by
  have hall : ∀ tag : Fin 12, ∀ j slot : Fin 4,
      (Finset.univ.image (cycleVertices tag j slot)) = target tag j slot := by
    decide +kernel
  exact hall tag j slot

lemma quad_on (tag : Fin 12) (j slot : Fin 4) : QuadOn (graph tag) (target tag j slot) :=
  ⟨quad tag j slot, quad_support tag j slot⟩

