/- leanprover/lean4:v4.33.0  mathlib v4.33.0 -/
/-
# The elementary product formula at the places `infinity`, `2`, and `3`

This file isolates the arithmetic normalization used when the rational
Subspace Theorem is specialized to the `S`-unit group generated by `-1`, `2`,
and `3`.  All norms take values in `ℚ`; in particular, Mathlib's
`padicNorm p` is normalized by `|p|_p = p⁻¹`.
-/
import Mathlib

namespace Erdos407
namespace PadicProduct

open scoped BigOperators

/-- The ordinary (Archimedean) absolute value on `ℚ`, with codomain `ℚ`. -/
def archNorm (q : ℚ) : ℚ := |q|

/-- Mathlib's rational-valued p-adic norm, exposed under a local name to make
the three-place formulas below read uniformly. -/
abbrev ratPadicNorm (p : ℕ) (q : ℚ) : ℚ := padicNorm p q

/-- The three-place product used for rational numbers supported at `2` and `3`. -/
def normProduct23 (q : ℚ) : ℚ :=
  archNorm q * padicNorm 2 q * padicNorm 3 q

/-- A rational `S`-unit for `S = {2,3}`.  The two alternatives record its sign. -/
def IsUnit23 (q : ℚ) : Prop :=
  ∃ a b : ℤ,
    q = (2 : ℚ) ^ a * (3 : ℚ) ^ b ∨
      q = -((2 : ℚ) ^ a * (3 : ℚ) ^ b)

/-- An integer supported on the primes `2` and `3`, again with its sign recorded. -/
def IsSupported23 (z : ℤ) : Prop :=
  ∃ a b : ℕ,
    z = (2 : ℤ) ^ a * (3 : ℤ) ^ b ∨
      z = -((2 : ℤ) ^ a * (3 : ℤ) ^ b)

/-- A finite integer vector is primitive when the gcd of its coordinates is one. -/
def IsPrimitive {ι : Type*} [Fintype ι] (x : ι → ℤ) : Prop :=
  Finset.univ.gcd x = 1

lemma padicNorm_zpow (p : ℕ) [Fact p.Prime] (q : ℚ) (z : ℤ) :
    padicNorm p (q ^ z) = padicNorm p q ^ z := by
  exact map_zpow₀ (IsAbsoluteValue.toAbsoluteValue (padicNorm p)) q z

@[simp] lemma archNorm_zero : archNorm 0 = 0 := by simp [archNorm]

@[simp] lemma archNorm_one : archNorm 1 = 1 := by simp [archNorm]

@[simp] lemma archNorm_neg (q : ℚ) : archNorm (-q) = archNorm q := by
  simp [archNorm]

lemma archNorm_mul (q r : ℚ) : archNorm (q * r) = archNorm q * archNorm r := by
  simp [archNorm, abs_mul]

lemma normProduct23_mul (q r : ℚ) :
    normProduct23 (q * r) = normProduct23 q * normProduct23 r := by
  simp only [normProduct23, archNorm_mul, padicNorm.mul]
  ring

@[simp] lemma normProduct23_neg (q : ℚ) : normProduct23 (-q) = normProduct23 q := by
  simp [normProduct23, archNorm]

@[simp] lemma normProduct23_one : normProduct23 1 = 1 := by
  simp [normProduct23, archNorm]

lemma normProduct23_two_zpow (a : ℤ) :
    normProduct23 ((2 : ℚ) ^ a) = 1 := by
  have h22 : padicNorm 2 (2 : ℚ) = (2 : ℚ)⁻¹ := by
    exact padicNorm.padicNorm_p_of_prime (p := 2)
  have h32 : padicNorm 3 (2 : ℚ) = 1 := by
    exact padicNorm.padicNorm_of_prime_of_ne (p := 3) (q := 2) (by omega)
  rw [normProduct23, archNorm, abs_zpow, padicNorm_zpow, padicNorm_zpow, h22, h32]
  rw [abs_of_nonneg (by norm_num : (0 : ℚ) ≤ 2)]
  simp only [one_zpow, mul_one, inv_zpow]
  exact mul_inv_cancel₀ (zpow_ne_zero a (by norm_num : (2 : ℚ) ≠ 0))

lemma normProduct23_three_zpow (b : ℤ) :
    normProduct23 ((3 : ℚ) ^ b) = 1 := by
  have h23 : padicNorm 2 (3 : ℚ) = 1 := by
    exact padicNorm.padicNorm_of_prime_of_ne (p := 2) (q := 3) (by omega)
  have h33 : padicNorm 3 (3 : ℚ) = (3 : ℚ)⁻¹ := by
    exact padicNorm.padicNorm_p_of_prime (p := 3)
  rw [normProduct23, archNorm, abs_zpow, padicNorm_zpow, padicNorm_zpow, h23, h33]
  rw [abs_of_nonneg (by norm_num : (0 : ℚ) ≤ 3)]
  simp only [one_zpow, mul_one, inv_zpow]
  exact mul_inv_cancel₀ (zpow_ne_zero b (by norm_num : (3 : ℚ) ≠ 0))

lemma IsUnit23.ne_zero {q : ℚ} (hq : IsUnit23 q) : q ≠ 0 := by
  rcases hq with ⟨a, b, hab | hab⟩ <;> rw [hab]
  · exact mul_ne_zero (zpow_ne_zero a (by norm_num)) (zpow_ne_zero b (by norm_num))
  · exact neg_ne_zero.mpr
      (mul_ne_zero (zpow_ne_zero a (by norm_num)) (zpow_ne_zero b (by norm_num)))

/-- Away from `2` and `3`, every `{2,3}`-unit has p-adic norm one. -/
theorem IsUnit23.padicNorm_eq_one_of_prime_ne {q : ℚ} (hq : IsUnit23 q)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3) :
    padicNorm p q = 1 := by
  let _ : Fact p.Prime := ⟨hp⟩
  have h2 : padicNorm p (2 : ℚ) = 1 :=
    padicNorm.padicNorm_of_prime_of_ne (p := p) (q := 2) hp2
  have h3 : padicNorm p (3 : ℚ) = 1 :=
    padicNorm.padicNorm_of_prime_of_ne (p := p) (q := 3) hp3
  rcases hq with ⟨a, b, hab | hab⟩ <;> rw [hab]
  · rw [padicNorm.mul, padicNorm_zpow, padicNorm_zpow, h2, h3,
      one_zpow, one_zpow, one_mul]
  · rw [padicNorm.neg, padicNorm.mul, padicNorm_zpow, padicNorm_zpow, h2, h3,
      one_zpow, one_zpow, one_mul]

/-- The product formula restricted to the only three places that can be
nontrivial on a rational `{2,3}`-unit. -/
theorem IsUnit23.normProduct23_eq_one {q : ℚ} (hq : IsUnit23 q) :
    normProduct23 q = 1 := by
  rcases hq with ⟨a, b, hab | hab⟩ <;> rw [hab]
  · rw [normProduct23_mul, normProduct23_two_zpow, normProduct23_three_zpow,
      one_mul]
  · rw [normProduct23_neg, normProduct23_mul, normProduct23_two_zpow,
      normProduct23_three_zpow, one_mul]

/-- Cancellation of the Archimedean factor against the two finite factors. -/
theorem IsUnit23.padicNorm_mul_eq_archNorm_inv {q : ℚ} (hq : IsUnit23 q) :
    padicNorm 2 q * padicNorm 3 q = (archNorm q)⁻¹ := by
  have harch : archNorm q ≠ 0 := by
    simpa [archNorm, abs_ne_zero] using hq.ne_zero
  have hprod : archNorm q * (padicNorm 2 q * padicNorm 3 q) = 1 := by
    simpa only [normProduct23, mul_assoc] using hq.normProduct23_eq_one
  exact ((mul_eq_one_iff_inv_eq₀ harch).mp hprod).symm

lemma IsSupported23.isUnit23 {z : ℤ} (hz : IsSupported23 z) :
    IsUnit23 (z : ℚ) := by
  rcases hz with ⟨a, b, hab | hab⟩
  · refine ⟨(a : ℤ), (b : ℤ), Or.inl ?_⟩
    simp only [hab, Int.cast_mul, Int.cast_pow, Int.cast_ofNat, zpow_natCast]
  · refine ⟨(a : ℤ), (b : ℤ), Or.inr ?_⟩
    simp only [hab, Int.cast_neg, Int.cast_mul, Int.cast_pow, Int.cast_ofNat,
      zpow_natCast]

theorem IsSupported23.normProduct23_eq_one {z : ℤ} (hz : IsSupported23 z) :
    normProduct23 (z : ℚ) = 1 :=
  hz.isUnit23.normProduct23_eq_one

theorem IsSupported23.padicNorm_mul_eq_archNorm_inv {z : ℤ}
    (hz : IsSupported23 z) :
    padicNorm 2 (z : ℚ) * padicNorm 3 (z : ℚ) = (archNorm (z : ℚ))⁻¹ :=
  hz.isUnit23.padicNorm_mul_eq_archNorm_inv

/-- A primitive integer vector has a coordinate not divisible by each prime. -/
theorem IsPrimitive.exists_not_dvd {ι : Type*} [Fintype ι] [Nonempty ι]
    {x : ι → ℤ} (hx : IsPrimitive x) {p : ℕ} (hp : p.Prime) :
    ∃ i, ¬(p : ℤ) ∣ x i := by
  by_contra h
  push Not at h
  have hd : (p : ℤ) ∣ Finset.univ.gcd x :=
    Finset.dvd_gcd fun i _hi ↦ h i
  rw [hx] at hd
  exact hp.not_dvd_one (Int.natCast_dvd_natCast.mp hd)

/-- Divide a nonzero finite integer vector by the gcd of its coordinates.
This supplies the primitive representative of its rational projective class. -/
theorem exists_primitive_factorization {ι : Type*} [Fintype ι] [DecidableEq ι]
    (x : ι → ℤ) (hx : ∃ i, x i ≠ 0) :
    ∃ c : ℤ, ∃ u : ι → ℤ,
      c ≠ 0 ∧ (∀ i, x i = c * u i) ∧ IsPrimitive u := by
  let c : ℤ := Finset.univ.gcd x
  have hc : c ≠ 0 := by
    intro hc0
    rw [Finset.gcd_eq_zero_iff] at hc0
    obtain ⟨i, hi⟩ := hx
    exact hi (hc0 i (Finset.mem_univ i))
  let u : ι → ℤ := fun i ↦ x i / c
  have hdiv (i : ι) : c ∣ x i :=
    Finset.gcd_dvd (Finset.mem_univ i)
  have hfactor (i : ι) : x i = c * u i := by
    rw [mul_comm]
    exact (Int.ediv_mul_cancel (hdiv i)).symm
  obtain ⟨i, hi⟩ := hx
  refine ⟨c, u, hc, hfactor, ?_⟩
  exact Finset.gcd_div_eq_one (Finset.mem_univ i) hi

/-- The maximum p-adic norm of a nonempty finite integer vector. -/
def padicMax {ι : Type*} [Fintype ι] [Nonempty ι] (p : ℕ) (x : ι → ℤ) : ℚ :=
  Finset.univ.sup' Finset.univ_nonempty fun i ↦ padicNorm p (x i : ℚ)

/-- At any prime, the maximum p-adic norm of the coordinates of a primitive
integer vector is exactly one. -/
theorem IsPrimitive.padicMax_eq_one {ι : Type*} [Fintype ι] [Nonempty ι]
    {x : ι → ℤ} (hx : IsPrimitive x) {p : ℕ} (hp : p.Prime) :
    padicMax p x = 1 := by
  let _ : Fact p.Prime := ⟨hp⟩
  unfold padicMax
  apply le_antisymm
  · exact Finset.sup'_le _ _ fun i _hi ↦ padicNorm.of_int (p := p) (x i)
  · obtain ⟨i, hi⟩ := hx.exists_not_dvd hp
    have hnorm : padicNorm p (x i : ℚ) = 1 :=
      (padicNorm.int_eq_one_iff (p := p) (x i)).mpr hi
    rw [← hnorm]
    exact Finset.le_sup' (fun j ↦ padicNorm p (x j : ℚ)) (Finset.mem_univ i)

theorem IsPrimitive.padicMax_two_eq_one {ι : Type*} [Fintype ι] [Nonempty ι]
    {x : ι → ℤ} (hx : IsPrimitive x) :
    padicMax 2 x = 1 :=
  hx.padicMax_eq_one (p := 2) (by norm_num)

theorem IsPrimitive.padicMax_three_eq_one {ι : Type*} [Fintype ι] [Nonempty ι]
    {x : ι → ℤ} (hx : IsPrimitive x) :
    padicMax 3 x = 1 :=
  hx.padicMax_eq_one (p := 3) (by norm_num)

/-- The two finite-place vector factors both disappear after primitive
integer normalization. -/
theorem IsPrimitive.padicMax_two_mul_three {ι : Type*}
    [Fintype ι] [Nonempty ι] {x : ι → ℤ} (hx : IsPrimitive x) :
    padicMax 2 x * padicMax 3 x = 1 := by
  rw [hx.padicMax_two_eq_one, hx.padicMax_three_eq_one, one_mul]

/-- The product of the three local coordinate products. -/
def vectorNormProduct23 {ι : Type*} [Fintype ι] (q : ι → ℚ) : ℚ :=
  (∏ i, archNorm (q i)) * (∏ i, padicNorm 2 (q i)) *
    (∏ i, padicNorm 3 (q i))

lemma vectorNormProduct23_eq_prod {ι : Type*} [Fintype ι] (q : ι → ℚ) :
    vectorNormProduct23 q = ∏ i, normProduct23 (q i) := by
  simp only [vectorNormProduct23, normProduct23, Finset.prod_mul_distrib]

/-- Coordinatewise `{2,3}` support makes the full three-place vector product
equal to one. -/
theorem vectorNormProduct23_eq_one {ι : Type*} [Fintype ι] (q : ι → ℚ)
    (hq : ∀ i, IsUnit23 (q i)) : vectorNormProduct23 q = 1 := by
  rw [vectorNormProduct23_eq_prod]
  exact Finset.prod_eq_one fun i _hi ↦ (hq i).normProduct23_eq_one

theorem intVectorNormProduct23_eq_one {ι : Type*} [Fintype ι] (x : ι → ℤ)
    (hx : ∀ i, IsSupported23 (x i)) :
    vectorNormProduct23 (fun i ↦ (x i : ℚ)) = 1 :=
  vectorNormProduct23_eq_one _ fun i ↦ (hx i).isUnit23

/-- The same cancellation for the sum linear form.  This is the exact form
used when the distinguished Archimedean linear form is a coordinate sum. -/
theorem normProduct23_sum_eq_one {ι : Type*} [Fintype ι] (q : ι → ℚ)
    (hsum : IsUnit23 (∑ i, q i)) :
    normProduct23 (∑ i, q i) = 1 :=
  hsum.normProduct23_eq_one

theorem normProduct23_sum_eq_one_of_sum_eq_one {ι : Type*} [Fintype ι]
    (q : ι → ℚ) (hsum : ∑ i, q i = 1) :
    normProduct23 (∑ i, q i) = 1 := by
  rw [hsum, normProduct23_one]

/-- Combined coordinate and sum cancellation.  This is the local product
attached to the coordinate linear forms together with their sum. -/
theorem vector_mul_sum_normProduct23_eq_one {ι : Type*} [Fintype ι]
    (q : ι → ℚ) (hcoord : ∀ i, IsUnit23 (q i))
    (hsum : IsUnit23 (∑ i, q i)) :
    vectorNormProduct23 q * normProduct23 (∑ i, q i) = 1 := by
  rw [vectorNormProduct23_eq_one q hcoord, hsum.normProduct23_eq_one, one_mul]

theorem vector_mul_sum_normProduct23_eq_one_of_sum_eq_one
    {ι : Type*} [Fintype ι] (q : ι → ℚ)
    (hcoord : ∀ i, IsUnit23 (q i)) (hsum : ∑ i, q i = 1) :
    vectorNormProduct23 q * normProduct23 (∑ i, q i) = 1 := by
  rw [vectorNormProduct23_eq_one q hcoord,
    normProduct23_sum_eq_one_of_sum_eq_one q hsum, one_mul]

end PadicProduct
end Erdos407
