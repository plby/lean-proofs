/- leanprover/lean4:v4.33.0  mathlib v4.33.0 -/
import Mathlib

/-!
# Rational `{2, 3}`-units and primitive relations for Erdős Problem 407

This file contains the elementary algebraic infrastructure used by the
restricted `S`-unit input for Problem 407.  It deliberately contains no
finiteness theorem for `S`-unit equations: that is the deep Diophantine
ingredient isolated in the companion development.
-/

namespace Erdos407.SUnit

open scoped BigOperators

/-! ## Signed rational `{2, 3}`-units -/

/-- A signed rational `{2, 3}`-unit.  The exponent of `-1` records the sign,
while the exponents of `2` and `3` are allowed to be arbitrary integers. -/
def IsSignedSUnit23 (x : ℚ) : Prop :=
  ∃ s a b : ℤ, x = (-1 : ℚ) ^ s * (2 : ℚ) ^ a * (3 : ℚ) ^ b

theorem isSignedSUnit23_ne_zero {x : ℚ} (hx : IsSignedSUnit23 x) : x ≠ 0 := by
  rcases hx with ⟨s, a, b, rfl⟩
  positivity

theorem isSignedSUnit23_one : IsSignedSUnit23 1 := by
  exact ⟨0, 0, 0, by norm_num⟩

theorem isSignedSUnit23_neg_one : IsSignedSUnit23 (-1) := by
  exact ⟨1, 0, 0, by norm_num⟩

theorem isSignedSUnit23_two : IsSignedSUnit23 2 := by
  exact ⟨0, 1, 0, by norm_num⟩

theorem isSignedSUnit23_three : IsSignedSUnit23 3 := by
  exact ⟨0, 0, 1, by norm_num⟩

theorem IsSignedSUnit23.mul {x y : ℚ}
    (hx : IsSignedSUnit23 x) (hy : IsSignedSUnit23 y) :
    IsSignedSUnit23 (x * y) := by
  rcases hx with ⟨sx, ax, bx, rfl⟩
  rcases hy with ⟨sy, ay, by', rfl⟩
  refine ⟨sx + sy, ax + ay, bx + by', ?_⟩
  rw [zpow_add₀ (by norm_num : (-1 : ℚ) ≠ 0),
    zpow_add₀ (by norm_num : (2 : ℚ) ≠ 0),
    zpow_add₀ (by norm_num : (3 : ℚ) ≠ 0)]
  ring

theorem IsSignedSUnit23.inv {x : ℚ} (hx : IsSignedSUnit23 x) :
    IsSignedSUnit23 x⁻¹ := by
  rcases hx with ⟨s, a, b, rfl⟩
  refine ⟨-s, -a, -b, ?_⟩
  simp only [zpow_neg]
  field_simp

theorem IsSignedSUnit23.div {x y : ℚ}
    (hx : IsSignedSUnit23 x) (hy : IsSignedSUnit23 y) :
    IsSignedSUnit23 (x / y) := by
  simpa [div_eq_mul_inv] using hx.mul hy.inv

theorem IsSignedSUnit23.neg {x : ℚ} (hx : IsSignedSUnit23 x) :
    IsSignedSUnit23 (-x) := by
  simpa using isSignedSUnit23_neg_one.mul hx

theorem IsSignedSUnit23.zpow {x : ℚ} (hx : IsSignedSUnit23 x) (n : ℤ) :
    IsSignedSUnit23 (x ^ n) := by
  rcases hx with ⟨s, a, b, rfl⟩
  refine ⟨s * n, a * n, b * n, ?_⟩
  rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul]

/-- The subgroup of rational units generated by the signed `{2, 3}`-units. -/
def signedSUnit23Subgroup : Subgroup ℚˣ where
  carrier := {u | IsSignedSUnit23 (u : ℚ)}
  one_mem' := by simpa using isSignedSUnit23_one
  mul_mem' hx hy := by simpa using hx.mul hy
  inv_mem' hx := by simpa using hx.inv

/-- A bundled nonzero signed rational `{2, 3}`-unit. -/
abbrev SignedSUnit23 := signedSUnit23Subgroup

theorem mem_signedSUnit23Subgroup_iff (u : ℚˣ) :
    u ∈ signedSUnit23Subgroup ↔ IsSignedSUnit23 (u : ℚ) :=
  Iff.rfl

/-! ## Scaling and nondegenerate relations -/

/-- Two rational vectors are projectively equivalent if one is obtained from
the other by multiplication by a nonzero rational scalar. -/
def ProjectivelyEquivalent {I : Type*} (x y : I → ℚ) : Prop :=
  ∃ k : ℚ, k ≠ 0 ∧ ∀ i, y i = k * x i

theorem ProjectivelyEquivalent.refl {I : Type*} (x : I → ℚ) :
    ProjectivelyEquivalent x x := by
  exact ⟨1, one_ne_zero, fun i => by simp⟩

theorem ProjectivelyEquivalent.symm {I : Type*} {x y : I → ℚ}
    (h : ProjectivelyEquivalent x y) : ProjectivelyEquivalent y x := by
  rcases h with ⟨k, hk, hxy⟩
  refine ⟨k⁻¹, inv_ne_zero hk, fun i => ?_⟩
  rw [hxy i]
  field_simp

theorem ProjectivelyEquivalent.trans {I : Type*} {x y z : I → ℚ}
    (hxy : ProjectivelyEquivalent x y) (hyz : ProjectivelyEquivalent y z) :
    ProjectivelyEquivalent x z := by
  rcases hxy with ⟨k, hk, hxy⟩
  rcases hyz with ⟨l, hl, hyz⟩
  refine ⟨l * k, mul_ne_zero hl hk, fun i => ?_⟩
  rw [hyz i, hxy i]
  ring

/-- Projective equivalence as a reusable equivalence relation.  The zero
vector forms its own equivalence class. -/
def projectiveSetoid (I : Type*) : Setoid (I → ℚ) where
  r := ProjectivelyEquivalent
  iseqv := ⟨ProjectivelyEquivalent.refl,
    ProjectivelyEquivalent.symm, ProjectivelyEquivalent.trans⟩

/-- No nonempty subsum of a rational vector vanishes.  Applied to the terms
`a i * x i`, this is the usual nondegeneracy condition for an inhomogeneous
linear `S`-unit equation. -/
def IsNondegenerate {I : Type*} (x : I → ℚ) : Prop :=
  ∀ s : Finset I, s.Nonempty → ∑ i ∈ s, x i ≠ 0

theorem isNondegenerate_scale_iff {I : Type*} {x : I → ℚ} {k : ℚ}
    (hk : k ≠ 0) :
    IsNondegenerate (fun i => k * x i) ↔ IsNondegenerate x := by
  constructor
  · intro h s hs hzero
    apply h s hs
    rw [← Finset.mul_sum]
    simp [hzero]
  · intro h s hs hzero
    rw [← Finset.mul_sum] at hzero
    exact h s hs ((mul_eq_zero.mp hzero).resolve_left hk)

theorem ProjectivelyEquivalent.isNondegenerate_iff {I : Type*}
    {x y : I → ℚ} (hxy : ProjectivelyEquivalent x y) :
    IsNondegenerate x ↔ IsNondegenerate y := by
  rcases hxy with ⟨k, hk, hxy⟩
  have heq : y = fun i => k * x i := funext hxy
  subst y
  exact (isNondegenerate_scale_iff hk).symm

/-- The homogeneous equation associated with a rational relation. -/
def IsZeroSum {I : Type*} [Fintype I] (x : I → ℚ) : Prop :=
  ∑ i, x i = 0

theorem isZeroSum_scale_iff {I : Type*} [Fintype I]
    {x : I → ℚ} {k : ℚ} (hk : k ≠ 0) :
    IsZeroSum (fun i => k * x i) ↔ IsZeroSum x := by
  unfold IsZeroSum
  rw [← Finset.mul_sum]
  exact mul_eq_zero.trans (or_iff_right hk)

theorem ProjectivelyEquivalent.isZeroSum_iff {I : Type*} [Fintype I]
    {x y : I → ℚ} (hxy : ProjectivelyEquivalent x y) :
    IsZeroSum x ↔ IsZeroSum y := by
  rcases hxy with ⟨k, hk, hxy⟩
  have heq : y = fun i => k * x i := funext hxy
  subst y
  exact (isZeroSum_scale_iff hk).symm

theorem projectivelyEquivalent_isSignedSUnit23_iff {I : Type*}
    {x y : I → ℚ} {k : ℚ} (hk : IsSignedSUnit23 k)
    (hxy : ∀ i, y i = k * x i) :
    (∀ i, IsSignedSUnit23 (x i)) ↔ ∀ i, IsSignedSUnit23 (y i) := by
  constructor
  · intro hx i
    rw [hxy i]
    exact hk.mul (hx i)
  · intro hy i
    have hki := hk.inv
    have hrewrite : x i = k⁻¹ * y i := by
      rw [hxy i]
      field_simp [isSignedSUnit23_ne_zero hk]
    rw [hrewrite]
    exact hki.mul (hy i)

/-! ## Primitive integral normalization -/

/-- The positive content of an integer vector, defined as the gcd of the
absolute values of its coordinates. -/
def intContent {I : Type*} [Fintype I] (x : I → ℤ) : ℕ :=
  Finset.univ.gcd fun i => (x i).natAbs

/-- An integer vector is primitive when its coordinate content is one. -/
def IsPrimitiveIntVector {I : Type*} [Fintype I] (x : I → ℤ) : Prop :=
  intContent x = 1

/-- Divide every coordinate by the content.  For the zero vector this is the
zero vector; the useful primitive theorem below assumes a nonzero vector. -/
def primitivePart {I : Type*} [Fintype I] (x : I → ℤ) : I → ℤ :=
  fun i => x i / (intContent x : ℤ)

theorem intContent_dvd_natAbs {I : Type*} [Fintype I]
    (x : I → ℤ) (i : I) : intContent x ∣ (x i).natAbs := by
  exact Finset.gcd_dvd (Finset.mem_univ i)

theorem intContent_dvd {I : Type*} [Fintype I]
    (x : I → ℤ) (i : I) : (intContent x : ℤ) ∣ x i := by
  rw [← Int.natAbs_dvd_natAbs]
  simpa using intContent_dvd_natAbs x i

theorem intContent_ne_zero {I : Type*} [Fintype I]
    {x : I → ℤ} (hx : x ≠ 0) : intContent x ≠ 0 := by
  intro hzero
  unfold intContent at hzero
  have hall := Finset.gcd_eq_zero_iff.mp hzero
  apply hx
  funext i
  exact Int.natAbs_eq_zero.mp (hall i (Finset.mem_univ i))

theorem intContent_mul_primitivePart {I : Type*} [Fintype I]
    (x : I → ℤ) (i : I) :
    (intContent x : ℤ) * primitivePart x i = x i := by
  simpa [primitivePart, mul_comm] using Int.ediv_mul_cancel (intContent_dvd x i)

theorem natAbs_primitivePart {I : Type*} [Fintype I]
    (x : I → ℤ) (i : I) :
    (primitivePart x i).natAbs = (x i).natAbs / intContent x := by
  rw [primitivePart, Int.natAbs_ediv]
  simp [intContent_dvd x i]

private theorem exists_coordinate_ne_zero {I : Type*}
    {x : I → ℤ} (hx : x ≠ 0) : ∃ i, x i ≠ 0 := by
  by_contra h
  push Not at h
  apply hx
  funext i
  exact h i

theorem primitivePart_isPrimitive {I : Type*} [Fintype I]
    {x : I → ℤ} (hx : x ≠ 0) :
    IsPrimitiveIntVector (primitivePart x) := by
  obtain ⟨i, hi⟩ := exists_coordinate_ne_zero hx
  unfold IsPrimitiveIntVector intContent
  simp_rw [natAbs_primitivePart]
  exact Finset.gcd_div_eq_one (Finset.mem_univ i) (Int.natAbs_ne_zero.mpr hi)

theorem primitivePart_ne_zero {I : Type*} [Fintype I]
    {x : I → ℤ} (hx : x ≠ 0) : primitivePart x ≠ 0 := by
  intro hzero
  apply hx
  funext i
  rw [← intContent_mul_primitivePart x i, hzero]
  simp

theorem primitivePart_zeroSum {I : Type*} [Fintype I]
    {x : I → ℤ} (hx : x ≠ 0) (hsum : ∑ i, x i = 0) :
    ∑ i, primitivePart x i = 0 := by
  have hc : (intContent x : ℤ) ≠ 0 := by
    exact_mod_cast intContent_ne_zero hx
  apply (mul_eq_zero.mp ?_).resolve_left hc
  rw [Finset.mul_sum]
  simpa only [intContent_mul_primitivePart] using hsum

theorem primitivePart_projectivelyEquivalent {I : Type*} [Fintype I]
    {x : I → ℤ} (hx : x ≠ 0) :
    ProjectivelyEquivalent
      (fun i => (primitivePart x i : ℚ)) (fun i => (x i : ℚ)) := by
  refine ⟨(intContent x : ℚ), by exact_mod_cast intContent_ne_zero hx, fun i => ?_⟩
  change (x i : ℚ) = (intContent x : ℚ) * (primitivePart x i : ℚ)
  exact_mod_cast (intContent_mul_primitivePart x i).symm

theorem primitivePart_isSignedSUnit23 {I : Type*} [Fintype I]
    {x : I → ℤ} (hcontent : IsSignedSUnit23 (intContent x : ℚ))
    (hx : ∀ i, IsSignedSUnit23 (x i : ℚ)) (i : I) :
    IsSignedSUnit23 (primitivePart x i : ℚ) := by
  have hcast : (primitivePart x i : ℚ) = (x i : ℚ) / (intContent x : ℚ) := by
    apply (eq_div_iff (isSignedSUnit23_ne_zero hcontent)).2
    exact_mod_cast (by
      simpa [mul_comm] using intContent_mul_primitivePart x i)
  rw [hcast]
  exact (hx i).div hcontent

end Erdos407.SUnit
