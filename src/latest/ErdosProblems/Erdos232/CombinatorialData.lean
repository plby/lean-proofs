def natMaskSubset (a s : Nat) : Bool := a &&& s == a

def independentMask (s : Nat) : Bool :=
  unitEdgeMasks.all fun e => !(natMaskSubset e s)

def certificateAtomNumerator (s : Nat) : Int :=
  246993028 - (if s.testBit 0 then 1062576034 else 0) -
    (atomPairWeights.foldl (fun z p => z + if natMaskSubset p.1 s then p.2 else 0) 0) +
    (∑ i : Fin 24, (atomCongruenceWeights i).foldl (fun z c =>
      z + c.2.2 * ((if natMaskSubset c.1 s then 1 else 0) -
        (if natMaskSubset c.2.1 s then 1 else 0))) 0)

def certificateAtomNonnegative (s : Nat) : Bool :=
  0 ≤ certificateAtomNumerator s

/-- Check every mask in the half-open integer interval `[first, first + count)`. -/
def atomMaskRangeCheck (first count : Nat) : Bool :=
  (List.range' first count).all fun s => !independentMask s || certificateAtomNonnegative s

