import Mathlib

/-!
# Scalar endpoint geometry for straddling support faces

The support inequalities give nonnegative coefficients for the gap between the facing
endpoints. Source-arm support gives the horizontal-span bound, and the tangent strips give
the two crossed inequalities. These are algebraic consequences of the stated coordinates.
-/

namespace Puzzling139335.TwoSideFaces

/-- A gap satisfying the two support inequalities lies in the cone generated by the
oriented face tangents `(-s,c)` and `(-q,-d)`. Unit-circle identities are not needed. -/
theorem gap_decomposition {c s d q dx dy : ℝ}
    (hc : 0 < c) (hs : 0 < s) (hd : 0 < d) (hq : 0 < q)
    (hfirst : c * dx + s * dy ≤ 0) (hsecond : 0 ≤ -d * dx + q * dy) :
    ∃ lam mu : ℝ, 0 ≤ lam ∧ 0 ≤ mu ∧
      dx = -lam * s - mu * q ∧ dy = lam * c - mu * d := by
  have hdenom : 0 < s * d + c * q :=
    add_pos (mul_pos hs hd) (mul_pos hc hq)
  refine ⟨(-d * dx + q * dy) / (s * d + c * q),
    -(c * dx + s * dy) / (s * d + c * q),
    div_nonneg hsecond hdenom.le, div_nonneg (neg_nonneg.mpr hfirst) hdenom.le, ?_, ?_⟩
  · field_simp [ne_of_gt hdenom]
    ring
  · field_simp [ne_of_gt hdenom]
    ring

/-- The two source-arm support bounds and the horizontal gap identity imply the span
inequality used in the straddling-face contradiction. -/
theorem horizontal_bound {c s d q a b Yx Yy Zx Zy lam mu : ℝ}
    (hc : 0 < c) (hs : 0 < s) (hd : 0 < d) (hq : 0 < q)
    (hYy : Yy ≤ 1 / 2) (hZy : Zy ≤ 1 / 2)
    (hYsupport : c * (1 - Yx) ≤ s * (Yy - b))
    (hZsupport : d * Zx ≤ q * (Zy - a))
    (hgapx : Zx - Yx = -lam * s - mu * q) :
    1 ≤ (1 - 2 * b) * s / (2 * c) + (1 - 2 * a) * q / (2 * d) +
      lam * s + mu * q := by
  have hleft : 1 - Yx ≤ (1 - 2 * b) * s / (2 * c) := by
    apply (le_div_iff₀ (mul_pos (by norm_num) hc)).mpr
    nlinarith only [hYsupport, mul_le_mul_of_nonneg_left hYy hs.le]
  have hright : Zx ≤ (1 - 2 * a) * q / (2 * d) := by
    apply (le_div_iff₀ (mul_pos (by norm_num) hd)).mpr
    nlinarith only [hZsupport, mul_le_mul_of_nonneg_left hZy hq.le]
  linarith only [hleft, hright, hgapx]

/-- The first tangent strip, evaluated at the far endpoint of the second face, gives
the first crossed-strip bound. Here the face lengths are `1-2*b` and `1-2*a`. -/
theorem crossed_strip_first {c s d q a b Yx Yy Zx Zy lam mu : ℝ}
    (hcs : c ^ 2 + s ^ 2 = 1)
    (hgapx : Zx - Yx = -lam * s - mu * q)
    (hgapy : Zy - Yy = lam * c - mu * d)
    (hstrip :
      -s * ((Zx - (1 - 2 * a) * q) - (Yx + (1 - 2 * b) * s / 2)) +
        c * ((Zy - (1 - 2 * a) * d) - (Yy - (1 - 2 * b) * c / 2)) ≤ 1 / 2) :
    lam + (s * q - c * d) * mu ≤ b - (s * q - c * d) * (1 - 2 * a) := by
  have hid :
      -s * ((Zx - (1 - 2 * a) * q) - (Yx + (1 - 2 * b) * s / 2)) +
        c * ((Zy - (1 - 2 * a) * d) - (Yy - (1 - 2 * b) * c / 2)) =
      lam + (s * q - c * d) * mu + (s * q - c * d) * (1 - 2 * a) +
        (1 - 2 * b) / 2 := by
    linear_combination -s * hgapx + c * hgapy + (lam + (1 - 2 * b) / 2) * hcs
  nlinarith only [hstrip, hid]

/-- The second tangent strip, evaluated at the far endpoint of the first face, gives
the second crossed-strip bound. -/
theorem crossed_strip_second {c s d q a b Yx Yy Zx Zy lam mu : ℝ}
    (hdq : d ^ 2 + q ^ 2 = 1)
    (hgapx : Zx - Yx = -lam * s - mu * q)
    (hgapy : Zy - Yy = lam * c - mu * d)
    (hstrip : -(1 : ℝ) / 2 ≤
      -q * ((Yx + (1 - 2 * b) * s) - (Zx - (1 - 2 * a) * q / 2)) -
        d * ((Yy - (1 - 2 * b) * c) - (Zy - (1 - 2 * a) * d / 2))) :
    (s * q - c * d) * lam + mu ≤ a - (s * q - c * d) * (1 - 2 * b) := by
  have hid :
      -q * ((Yx + (1 - 2 * b) * s) - (Zx - (1 - 2 * a) * q / 2)) -
        d * ((Yy - (1 - 2 * b) * c) - (Zy - (1 - 2 * a) * d / 2)) =
      -((s * q - c * d) * lam + mu + (s * q - c * d) * (1 - 2 * b) +
        (1 - 2 * a) / 2) := by
    linear_combination q * hgapx + d * hgapy - (mu + (1 - 2 * a) / 2) * hdq
  nlinarith only [hstrip, hid]

end Puzzling139335.TwoSideFaces
