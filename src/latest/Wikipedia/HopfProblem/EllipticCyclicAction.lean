import Mathlib.Algebra.Group.Action.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Geometry.Manifold.ContMDiff.Basic
import Mathlib.GroupTheory.Perm.Basic

/-!
# Cyclic actions generated by finite-order permutations

A permutation whose `m`-th power is the identity gives an actual action of
`Multiplicative (ZMod m)`.  The action is selected explicitly, rather than
installed as a global instance.  Its freeness and regularity are derived
from the corresponding properties of the iterates of the generator.
-/

noncomputable section

open scoped ContDiff

namespace Wikipedia.HopfProblem.Elliptic.CyclicAction

variable {M : Type*} {m : ℕ} [NeZero m]

/-- The selected cyclic action induced by a finite-order permutation. -/
@[instance_reducible] def action (σ : Equiv.Perm M) (hσ : σ ^ m = 1) :
    MulAction (Multiplicative (ZMod m)) M where
  smul g x := (σ ^ g.toAdd.val) x
  one_smul x := by
    change (σ ^ (0 : ZMod m).val) x = x
    simp
  mul_smul g h x := by
    change (σ ^ (g.toAdd + h.toAdd).val) x =
      (σ ^ g.toAdd.val) ((σ ^ h.toAdd.val) x)
    rw [ZMod.val_add, ← pow_eq_pow_mod _ hσ, pow_add]
    rfl

/-- The element represented by `1` in the additive cyclic group. -/
def generator (m : ℕ) : Multiplicative (ZMod m) := Multiplicative.ofAdd 1

omit [NeZero m] in
theorem generator_pow (r : ℕ) :
    generator m ^ r = Multiplicative.ofAdd (r : ZMod m) := by
  simp [generator, ← ofAdd_nsmul, nsmul_eq_mul]

@[simp] theorem smul_eq_pow (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (g : Multiplicative (ZMod m)) (x : M) :
    letI := action σ hσ
    g • x = (σ ^ g.toAdd.val) x := rfl

theorem smul_eq_iterate (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (g : Multiplicative (ZMod m)) (x : M) :
    letI := action σ hσ
    g • x = (σ : M → M)^[g.toAdd.val] x := by
  change (σ ^ g.toAdd.val) x = _
  rw [Equiv.Perm.coe_pow]

/-- The residue class of any natural number acts by that many iterations. -/
theorem ofAdd_natCast_smul (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (r : ℕ) (x : M) :
    letI := action σ hσ
    Multiplicative.ofAdd (r : ZMod m) • x = (σ : M → M)^[r] x := by
  change (σ ^ (r : ZMod m).val) x = _
  rw [ZMod.val_natCast, ← pow_eq_pow_mod r hσ, Equiv.Perm.coe_pow]

@[simp] theorem generator_smul (σ : Equiv.Perm M) (hσ : σ ^ m = 1) (x : M) :
    letI := action σ hσ
    generator m • x = σ x := by
  simpa [generator] using ofAdd_natCast_smul σ hσ 1 x

theorem generator_pow_smul (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (r : ℕ) (x : M) :
    letI := action σ hσ
    generator m ^ r • x = (σ : M → M)^[r] x := by
  rw [generator_pow]
  exact ofAdd_natCast_smul σ hσ r x

/-- Absence of fixed points for all nonidentity powers proves cancellation
for the constructed action; freeness is not an assumed action instance. -/
theorem isCancelSMul (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (hfree : ∀ r : ℕ, 0 < r → r < m → ∀ x : M, (σ : M → M)^[r] x ≠ x) :
    letI := action σ hσ
    IsCancelSMul (Multiplicative (ZMod m)) M := by
  let := action σ hσ
  apply isCancelSMul_iff_eq_one_of_smul_eq.mpr
  intro g x hx
  have hval : g.toAdd.val = 0 := by
    by_contra hval
    exact hfree g.toAdd.val (Nat.pos_of_ne_zero hval) (ZMod.val_lt _) x
      ((smul_eq_iterate σ hσ g x).symm.trans hx)
  apply Multiplicative.ext
  exact (ZMod.val_eq_zero _).mp hval

/-- The action is free exactly when every nonidentity power has no fixed point. -/
theorem isCancelSMul_iff (σ : Equiv.Perm M) (hσ : σ ^ m = 1) :
    letI := action σ hσ
    IsCancelSMul (Multiplicative (ZMod m)) M ↔
      ∀ r : ℕ, 0 < r → r < m → ∀ x : M, (σ : M → M)^[r] x ≠ x := by
  let := action σ hσ
  constructor
  · intro hcancel r hr hrm x hx
    let := hcancel
    have hg : Multiplicative.ofAdd (r : ZMod m) = (1 : Multiplicative (ZMod m)) :=
      IsCancelSMul.eq_one_of_smul ((ofAdd_natCast_smul σ hσ r x).trans hx)
    have hz : (r : ZMod m) = 0 := congrArg Multiplicative.toAdd hg
    have hv := congrArg ZMod.val hz
    rw [ZMod.val_natCast_of_lt hrm, ZMod.val_zero] at hv
    omega
  · exact isCancelSMul σ hσ

section Topology

variable [TopologicalSpace M]

/-- Continuity of the generator suffices for continuity of every group element. -/
theorem continuousConstSMul (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (hcont : Continuous (σ : M → M)) :
    letI := action σ hσ
    ContinuousConstSMul (Multiplicative (ZMod m)) M := by
  let := action σ hσ
  refine ⟨fun g => ?_⟩
  simpa only [smul_eq_iterate σ hσ] using hcont.iterate g.toAdd.val

end Topology

section Manifold

variable {𝕜 E H : Type*} [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [TopologicalSpace H]
    {I : ModelWithCorners 𝕜 E H} {n : ℕ∞ω}
    [TopologicalSpace M] [ChartedSpace H M]

/-- Regularity of the generator is inherited by the whole cyclic action.
For `𝕜 = ℂ` and `n = ω` this proves that the action is holomorphic. -/
theorem smul_contMDiff (σ : Equiv.Perm M) (hσ : σ ^ m = 1)
    (hreg : ContMDiff I I n (σ : M → M)) (g : Multiplicative (ZMod m)) :
    letI := action σ hσ
    ContMDiff I I n (fun x : M => g • x) := by
  let := action σ hσ
  simpa only [smul_eq_iterate σ hσ] using hreg.iterate g.toAdd.val

end Manifold

end Wikipedia.HopfProblem.Elliptic.CyclicAction
