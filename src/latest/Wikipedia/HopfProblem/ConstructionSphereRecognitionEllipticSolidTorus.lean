import Wikipedia.HopfProblem.ConstructionSphereRecognitionEllipticCircle
import Wikipedia.HopfProblem.ConstructionSphereRecognitionEllipticBase

/-!
# The genuine weighted elliptic solid torus

For `ell = ±1`, the actual finite quotient generated by
`(s,c) ↦ (exp(-2πi/m)s,c+ell/m)` is homeomorphic to the original disc
times the original additive circle.  The displayed inverse and the
original power projection are retained exactly.
-/

noncomputable section

namespace Wikipedia.HopfProblem.ConstructionSphereRecognition.EllipticModel

open SpecialPeriods ThreefoldOverlapMappingTorus
open Wikipedia.HopfProblem.Elliptic

variable (m : ℕ) [NeZero m] (ell : ℤ)

/-- The literal finite cyclic orbit space, with its quotient topology. -/
abbrev SolidQuotient := CapQuotient m (circleShift m ell) (circleShift_pow_order m ell)

def solidProject : Disc × Circle → SolidQuotient m ell :=
  capProject m (circleShift m ell) (circleShift_pow_order m ell)

theorem solidProject_isOpenQuotientMap : IsOpenQuotientMap (solidProject m ell) :=
  capProject_isOpenQuotientMap m (circleShift m ell) (circleShift_pow_order m ell)

/-- The chosen finite action has precisely the native signed generator. -/
theorem solidAction_generator (p : Disc × Circle) :
    letI := capAction m (circleShift m ell) (circleShift_pow_order m ell)
    CyclicAction.generator m • p =
      (rotate (-sector m) p.1, p.2 + (((ell : ℝ) / m : ℝ) : Circle)) :=
  capAction_generator m (circleShift m ell) (circleShift_pow_order m ell) p

/-- The original base map, descended from the actual power `s^m`. -/
def solidProjection : C(SolidQuotient m ell, Disc) :=
  capBase m (circleShift m ell) (circleShift_pow_order m ell)

@[simp] theorem solidProjection_project (s : Disc) (c : Circle) :
    (solidProjection m ell (solidProject m ell (s, c)) : ℂ) = (s : ℂ) ^ m := rfl

variable (hell : ell = 1 ∨ ell = -1)

/-- The weighted solid torus is the actual disc-circle product, without a transported atlas. -/
def solidTorusHomeomorph : SolidQuotient m ell ≃ₜ Disc × Circle :=
  (capProductHomeomorph m (circleShift m ell) (circleShift_pow_order m ell)
    (signedCoordinate ell) (signedCoordinate_circleShift m ell hell)).trans
    ((Homeomorph.refl Disc).prodCongr (circleQuotientHomeomorph m ell hell))

/-- Literal representative formula: `[s,c] ↦ (s exp(2πi ell c), m c)`. -/
@[simp] theorem solidTorusHomeomorph_project (s : Disc) (c : Circle) :
    solidTorusHomeomorph m ell hell (solidProject m ell (s, c)) =
      (rotate (ell • c) s, m • c) := by
  change ((Homeomorph.refl Disc).prodCongr (circleQuotientHomeomorph m ell hell))
    (capProductHomeomorph m (circleShift m ell) (circleShift_pow_order m ell)
      (signedCoordinate ell) (signedCoordinate_circleShift m ell hell)
      (capProject m (circleShift m ell) (circleShift_pow_order m ell) (s, c))) = _
  rw [capProductHomeomorph_project]
  change (rotate (ell • c) s, circleQuotientHomeomorph m ell hell
    (circleProject m ell c)) = _
  rw [circleQuotientHomeomorph_project]

/-- Inverse formula on any circle representative; no root branch is chosen. -/
theorem solidTorusHomeomorph_symm_multiple (s : Disc) (c : Circle) :
    (solidTorusHomeomorph m ell hell).symm (s, m • c) =
      solidProject m ell (rotate (-(ell • c)) s, c) := by
  apply (solidTorusHomeomorph m ell hell).injective
  rw [Homeomorph.apply_symm_apply, solidTorusHomeomorph_project, rotate_rotate_neg]

/-- A real representative of the target circle gives an explicit inverse representative. -/
theorem solidTorusHomeomorph_symm_real (s : Disc) (t : ℝ) :
    (solidTorusHomeomorph m ell hell).symm (s, (t : Circle)) =
      solidProject m ell
        (rotate (-(ell • ((t / m : ℝ) : Circle))) s, ((t / m : ℝ) : Circle)) := by
  have hm : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  have hc : m • ((t / m : ℝ) : Circle) = (t : Circle) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    congr 1
    field_simp
  rw [← hc, solidTorusHomeomorph_symm_multiple]

/-- The base map in solid-torus coordinates, including its nonconstant circle phase. -/
def solidBase : C(Disc × Circle, Disc) :=
  ⟨fun p => rotate (-(ell • p.2))
    (discPower m (Nat.pos_of_ne_zero (NeZero.ne m)) p.1),
    rotate_continuous.comp
      (((signedCoordinate ell).continuous.comp continuous_snd).neg.prodMk
        ((discPower_continuous m (Nat.pos_of_ne_zero (NeZero.ne m))).comp continuous_fst))⟩

theorem solidBase_val (p : Disc × Circle) :
    (solidBase m ell p : ℂ) = (p.1 : ℂ) ^ m * (phase (-(ell • p.2)) : ℂ) :=
  mul_comm _ _

theorem solidBase_rotated (s : Disc) (c : Circle) :
    solidBase m ell (rotate (ell • c) s, m • c) =
      discPower m (Nat.pos_of_ne_zero (NeZero.ne m)) s := by
  change rotate (-(ell • (m • c)))
    (discPower m (Nat.pos_of_ne_zero (NeZero.ne m)) (rotate (ell • c) s)) = _
  rw [discPower_rotate, smul_comm m ell, rotate_neg_rotate]

/-- This is equality with the independently descended original projection. -/
theorem solidProjection_eq_solidBase (q : SolidQuotient m ell) :
    solidProjection m ell q = solidBase m ell (solidTorusHomeomorph m ell hell q) := by
  obtain ⟨⟨s, c⟩, rfl⟩ := (solidProject_isOpenQuotientMap m ell).surjective q
  rw [solidTorusHomeomorph_project, solidBase_rotated]
  rfl

/-- Exact power-phase formula for the inverse product coordinates. -/
theorem solidProjection_homeomorph_symm (p : Disc × Circle) :
    (solidProjection m ell ((solidTorusHomeomorph m ell hell).symm p) : ℂ) =
      (p.1 : ℂ) ^ m * (phase (-(ell • p.2)) : ℂ) := by
  rw [solidProjection_eq_solidBase m ell hell, Homeomorph.apply_symm_apply, solidBase_val]

/-- On a real circle representative the phase is the required complex exponential. -/
theorem solidProjection_homeomorph_symm_real (s : Disc) (d : ℝ) :
    (solidProjection m ell ((solidTorusHomeomorph m ell hell).symm (s, (d : Circle))) : ℂ) =
      (s : ℂ) ^ m * CuspUniformization.exponential (-((ell : ℂ) * (d : ℂ))) := by
  rw [solidProjection_homeomorph_symm]
  congr 1
  rw [← AddCircle.coe_zsmul, ← AddCircle.coe_neg, phase_real]
  congr 1
  simp only [zsmul_eq_mul, Complex.ofReal_neg, Complex.ofReal_mul, Complex.ofReal_intCast]

/-- The product retains the exact radius of the original root coordinate. -/
theorem solidTorusHomeomorph_project_norm (s : Disc) (c : Circle) :
    ‖((solidTorusHomeomorph m ell hell (solidProject m ell (s, c))).1 : ℂ)‖ = ‖(s : ℂ)‖ := by
  rw [solidTorusHomeomorph_project, rotate_norm]

end Wikipedia.HopfProblem.ConstructionSphereRecognition.EllipticModel
