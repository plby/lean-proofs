import Wikipedia.HopfProblem.SpecialPeriodsTriangleCusp
import Mathlib.Analysis.Complex.UpperHalfPlane.Topology
import Mathlib.Topology.Covering.Quotient
import Mathlib.Topology.Homeomorph.Lemmas

/-!
# The cyclic cusp quotient of the actual triangle action

This file takes the orbit quotient by the cyclic subgroup generated by
the cusp element.  The covering property follows from disjoint real-part
strips for the proved translations by integral multiples of the cusp
width.  It does not require a cusp neighborhood to be precisely invariant
under the full triangle group.

The proved exponential cusp coordinate descends to a homeomorphism from
this actual orbit quotient onto the punctured unit disc.
-/

noncomputable section

open Function Set Topology UpperHalfPlane
open scoped Pointwise

namespace Wikipedia.HopfProblem.SpecialPeriods.Triangle

attribute [local instance] triangleGeometricAction

/-- The actual cyclic subgroup of the abstract triangle group generated
by its distinguished cusp element. -/
abbrev CuspGroup : Type := ↥(Subgroup.zpowers triangleCuspGenerator)

/-- The orbit space of the actual cyclic cusp action on the upper
half-plane, with its quotient topology. -/
abbrev CuspOrbitSpace := Quotient (MulAction.orbitRel CuspGroup ℍ)

/-- Projection to the cyclic cusp-orbit quotient. -/
def cuspOrbitMap : ℍ → CuspOrbitSpace := Quotient.mk _

theorem cuspOrbitRel_iff (z w : ℍ) :
    MulAction.orbitRel CuspGroup ℍ z w ↔
      ∃ n : ℤ, triangleGeometricRepresentation (triangleCuspGenerator ^ n) w = z := by
  change z ∈ MulAction.orbit CuspGroup w ↔ _
  constructor
  · rintro ⟨g, hg⟩
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp g.property
    refine ⟨n, ?_⟩
    rw [hn]
    exact hg
  · rintro ⟨n, hn⟩
    exact ⟨⟨triangleCuspGenerator ^ n, Subgroup.zpow_mem_zpowers _ _⟩, hn⟩

theorem cuspOrbitMap_eq_iff (z w : ℍ) :
    cuspOrbitMap z = cuspOrbitMap w ↔
      ∃ n : ℤ, triangleGeometricRepresentation (triangleCuspGenerator ^ n) w = z :=
  Quotient.eq''.trans (cuspOrbitRel_iff z w)

theorem cuspOrbitMap_surjective : Function.Surjective cuspOrbitMap :=
  Quotient.mk_surjective

theorem cuspOrbitMap_continuous : Continuous cuspOrbitMap :=
  continuous_quotient_mk'

/-- Continuity of each actual cusp translation, as a class for use with
the covering-space API. -/
theorem cuspGroup_continuousConstSMul : ContinuousConstSMul CuspGroup ℍ := by
  constructor
  intro g
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp g.property
  change Continuous (fun z : ℍ => triangleGeometricRepresentation (g : TriangleGroup) z)
  rw [← hn]
  apply UpperHalfPlane.isEmbedding_coe.continuous_iff.mpr
  simpa only [Function.comp_def, triangleGeometricRepresentation_cusp_zpow_apply,
    UpperHalfPlane.coe_vadd, Pi.add_def] using
    (continuous_const.add UpperHalfPlane.continuous_coe :
      Continuous (fun z : ℍ => ((-(n : ℝ) * width : ℝ) : ℂ) + (z : ℂ)))

/-- The cyclic cusp projection is an actual quotient covering map.
The proof uses strips of real-part radius `width / 3`. -/
theorem cuspOrbitMap_quotientCovering : IsQuotientCoveringMap cuspOrbitMap CuspGroup where
  toIsQuotientMap := isQuotientMap_quotient_mk'
  toContinuousConstSMul := cuspGroup_continuousConstSMul
  apply_eq_iff_mem_orbit := Quotient.eq''
  disjoint z := by
    let U : Set ℍ := {w | |w.re - z.re| < width / 3}
    have hU : IsOpen U :=
      isOpen_lt ((UpperHalfPlane.continuous_re.sub continuous_const).abs) continuous_const
    have hzU : z ∈ U := by
      dsimp [U]
      simpa using div_pos width_pos (by norm_num : (0 : ℝ) < 3)
    refine ⟨U, hU.mem_nhds hzU, ?_⟩
    rintro g ⟨w, ⟨v, hv, rfl⟩, hgv⟩
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp g.property
    have htr : g • v = (-(n : ℝ) * width) +ᵥ v := by
      change triangleGeometricRepresentation (g : TriangleGroup) v = _
      rw [← hn, triangleGeometricRepresentation_cusp_zpow_apply]
    change |v.re - z.re| < width / 3 at hv
    change |(g • v).re - z.re| < width / 3 at hgv
    have ha := abs_lt.mp hv
    have hb := abs_lt.mp hgv
    rw [htr, UpperHalfPlane.vadd_re] at hb
    have hl : (-1 : ℝ) * width < (n : ℝ) * width := by linarith [width_pos]
    have hu : (n : ℝ) * width < 1 * width := by linarith [width_pos]
    have hl' : (-1 : ℝ) < (n : ℝ) := (mul_lt_mul_iff_left₀ width_pos).mp hl
    have hu' : (n : ℝ) < 1 := (mul_lt_mul_iff_left₀ width_pos).mp hu
    have hn₀ : n = 0 := by
      have hli : (-1 : ℤ) < n := by exact_mod_cast hl'
      have hui : n < 1 := by exact_mod_cast hu'
      omega
    apply Subtype.ext
    change (g : TriangleGroup) = 1
    rw [← hn, hn₀, zpow_zero]

theorem cuspOrbitMap_isCoveringMap : IsCoveringMap cuspOrbitMap :=
  cuspOrbitMap_quotientCovering.isCoveringMap

theorem cuspOrbitMap_isOpenMap : IsOpenMap cuspOrbitMap :=
  cuspOrbitMap_quotientCovering.isOpenQuotientMap.isOpenMap

/-- The exponential coordinate, descended to the actual cyclic orbit
quotient by its proved invariance. -/
def cuspOrbitToDisc : CuspOrbitSpace → PuncturedDisc :=
  Quotient.lift cuspQMap (fun z w h =>
    (cuspQMap_eq_iff z w).mpr ((cuspOrbitRel_iff z w).mp h))

@[simp] theorem cuspOrbitToDisc_mk (z : ℍ) :
    cuspOrbitToDisc (cuspOrbitMap z) = cuspQMap z := rfl

theorem cuspOrbitToDisc_injective : Function.Injective cuspOrbitToDisc := by
  intro x y
  refine Quotient.inductionOn₂ x y ?_
  intro z w h
  exact (cuspOrbitMap_eq_iff z w).mpr ((cuspQMap_eq_iff z w).mp h)

theorem cuspOrbitToDisc_surjective : Function.Surjective cuspOrbitToDisc := by
  intro q
  obtain ⟨z, rfl⟩ := cuspQMap_surjective q
  exact ⟨cuspOrbitMap z, rfl⟩

theorem cuspOrbitToDisc_continuous : Continuous cuspOrbitToDisc :=
  cuspQMap_continuous.quotient_lift _

theorem cuspOrbitToDisc_isOpenMap : IsOpenMap cuspOrbitToDisc :=
  IsOpenMap.of_comp cuspOrbitMap_continuous cuspOrbitMap_surjective cuspQMap_isOpenMap

/-- The actual cusp-orbit quotient is homeomorphic to the punctured unit
disc, with the homeomorphism induced by the source's exponential `q`. -/
def cuspOrbitDiscHomeomorph : CuspOrbitSpace ≃ₜ PuncturedDisc :=
  (Equiv.ofBijective cuspOrbitToDisc
    ⟨cuspOrbitToDisc_injective, cuspOrbitToDisc_surjective⟩).toHomeomorphOfContinuousOpen
      cuspOrbitToDisc_continuous cuspOrbitToDisc_isOpenMap

@[simp] theorem cuspOrbitDiscHomeomorph_apply (x : CuspOrbitSpace) :
    cuspOrbitDiscHomeomorph x = cuspOrbitToDisc x := rfl

@[simp] theorem cuspOrbitDiscHomeomorph_mk (z : ℍ) :
    cuspOrbitDiscHomeomorph (cuspOrbitMap z) = cuspQMap z := rfl

/-- The identifying homeomorphism really is the normalized complex
exponential on every representative. -/
theorem cuspOrbitDiscHomeomorph_mk_coe (z : ℍ) :
    (cuspOrbitDiscHomeomorph (cuspOrbitMap z) : ℂ) =
      Complex.exp (2 * Real.pi * Complex.I * z / width) := rfl

/-- Consequently the exponential onto the punctured disc is itself a
quotient covering map for the actual cusp subgroup. -/
theorem cuspQMap_quotientCovering : IsQuotientCoveringMap cuspQMap CuspGroup :=
  cuspOrbitMap_quotientCovering.homeomorph_comp cuspOrbitDiscHomeomorph

theorem cuspQMap_isCoveringMap : IsCoveringMap cuspQMap :=
  cuspQMap_quotientCovering.isCoveringMap

theorem cuspOrbitSpace_t2Space : T2Space CuspOrbitSpace :=
  cuspOrbitDiscHomeomorph.isEmbedding.t2Space

end Wikipedia.HopfProblem.SpecialPeriods.Triangle
