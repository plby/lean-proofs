import Wikipedia.HopfProblem.DegreeCollapseThreefoldCanonicalFamily

/-!
# The entire finite inclusion kernel is generated by the actual section classes

Induct over the actual successive cuts. Each regular band and critical
window adjoins the specified canonical section class. The maps throughout
are literal inclusions, so the final kernel is exactly the span of the
given finite family, with no arbitrary relation lifts.
-/

noncomputable section

open Set Function Manifold ContinuousMap Topology
open scoped ContDiff
open Wikipedia.SmoothSixDPoincare ManifoldMorse

namespace Wikipedia.HopfProblem.DegreeCollapse.MorseCancellation

open SingularMayerVietoris PeriodTorusHigherHomology

theorem span_prefix_succ {A : Type} [AddCommGroup A] [Module ℤ A]
    {n k : ℕ} (v : Fin n → A) (hk : k < n) :
    Submodule.span ℤ (range (fun j : Fin k => v ⟨j.val, j.isLt.trans hk⟩)) ⊔
      Submodule.span ℤ {v ⟨k, hk⟩} =
    Submodule.span ℤ (range (fun j : Fin (k + 1) => v ⟨j.val, by omega⟩)) := by
  have heq : (fun j : Fin (k + 1) => v ⟨j.val, by omega⟩) =
      Fin.snoc (fun j : Fin k => v ⟨j.val, j.isLt.trans hk⟩) (v ⟨k, hk⟩) := by
    funext j
    cases j using Fin.lastCases <;> simp
  rw [heq, Fin.range_snoc, Submodule.span_insert, sup_comm]

local notation "S₂" => Hemisphere.Sphere 2

variable {E M : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ, E) ∞ M]
  [T2Space M] [CompactSpace M] {f : M → ℝ}

theorem AdaptedSurgeryWindows.finite_middle_inclusion_relations
    (S : AdaptedSurgeryWindows E f) (hf : ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, ℝ) ∞ f)
    (n : ℕ) (p : Fin n → criticalPoints E f)
    (hp : ∀ j, nativeMorseIndex E f (p j) = 3) (cut : Fin (n + 1) → ℝ)
    (ha : ∀ y, f y = cut 0 → y ∉ criticalPoints E f)
    (hbase : ∀ i, cut 0 ≤ cut i)
    (hnext : ∀ j, cut j.succ = S.toSurgeryWindows.upper (p j))
    (hlower : ∀ j, cut j.castSucc < S.toSurgeryWindows.lower (p j))
    (hband : ∀ j y, f y ∈ Icc (cut j.castSucc) (S.toSurgeryWindows.lower (p j)) →
      y ∉ criticalPoints E f)
    (γ : Fin n → C(S₂, {y : M // f y = cut 0}))
    (horbit : ∀ j x, ∃ t : ℝ,
      S.flow t (nativeIndexThreeAttachingSphere S (p j) (hp j) x).val = (γ j x).val) :
    Surjective (singularHomologyMap (sublevelMap f (hbase (Fin.last n))) 2) ∧
      LinearMap.ker (singularHomologyMap (sublevelMap f (hbase (Fin.last n))) 2) =
        Submodule.span ℤ (range (fun j => middleSectionClass (γ j))) := by
  have hprefix (k : ℕ) : ∀ hk : k ≤ n,
      Surjective (singularHomologyMap (sublevelMap f (hbase ⟨k, by omega⟩)) 2) ∧
        LinearMap.ker (singularHomologyMap (sublevelMap f (hbase ⟨k, by omega⟩)) 2) =
          Submodule.span ℤ (range (fun j : Fin k =>
            middleSectionClass (γ ⟨j.val, j.isLt.trans_le hk⟩))) := by
    induction k with
    | zero =>
      intro hk
      have hid : singularHomologyMap (sublevelMap f (hbase ⟨0, by omega⟩)) 2 =
          LinearMap.id := by
        change singularHomologyMap (ContinuousMap.id {y : M // f y ≤ cut 0}) 2 = _
        exact singularHomologyMap_id _ _
      constructor
      · rw [hid]
        exact Function.surjective_id
      · rw [hid]
        simp
        ext v
        rfl
    | succ k ih =>
      intro hk
      have hkn : k < n := by omega
      let j : Fin n := ⟨k, hkn⟩
      obtain ⟨hprev, hkernel⟩ := ih (by omega)
      have hstep := S.middle_inclusion_step hf (p j) (hp j) (hbase j.castSucc) ha
        (hlower j) (hband j) (γ j) (horbit j) hprev
      have hstep' :
          Surjective (singularHomologyMap (sublevelMap f (hbase ⟨k + 1, by omega⟩)) 2) ∧
          LinearMap.ker (singularHomologyMap (sublevelMap f (hbase ⟨k + 1, by omega⟩)) 2) =
            LinearMap.ker (singularHomologyMap (sublevelMap f (hbase j.castSucc)) 2) ⊔
              Submodule.span ℤ {middleSectionClass (γ j)} := by
        have heq : cut ⟨k + 1, by omega⟩ = S.toSurgeryWindows.upper (p j) := hnext j
        have aux (b : ℝ) (hb : cut 0 ≤ b) (he : b = S.toSurgeryWindows.upper (p j)) :
            Surjective (singularHomologyMap (sublevelMap f hb) 2) ∧
              LinearMap.ker (singularHomologyMap (sublevelMap f hb) 2) =
                LinearMap.ker (singularHomologyMap (sublevelMap f (hbase j.castSucc)) 2) ⊔
                  Submodule.span ℤ {middleSectionClass (γ j)} := by
          subst b
          exact hstep
        exact aux _ _ heq
      refine ⟨hstep'.1, ?_⟩
      rw [hstep'.2, hkernel]
      exact span_prefix_succ (fun i => middleSectionClass (γ i)) hkn
  simpa only using hprefix n le_rfl

end Wikipedia.HopfProblem.DegreeCollapse.MorseCancellation
