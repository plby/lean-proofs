import Wikipedia.HopfProblem.CuspExponentials
import Mathlib.Algebra.Group.TypeTags.Hom
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# The exponential of the actual additive parameter quotient

The normalized complex exponential has exactly the integral periods. It
therefore identifies the additive quotient `ℂ / ℤ` with `ℂˣ` as a group.
The parameter space below retains the ordinary quotient topology; this file
does not transport a topology or a manifold structure along the equivalence.
-/

noncomputable section

open Set Topology

namespace Wikipedia.HopfProblem.SpecialPeriods.Threefold.VerticalAction.Exponential

/-- The normalized complex exponential, regarded as a nonzero complex number. -/
def normalizedExponential (s : ℂ) : ℂˣ :=
  Units.mk0 (CuspUniformization.exponential s) (CuspUniformization.exponential_ne_zero s)

@[simp] theorem normalizedExponential_coe (s : ℂ) :
    (normalizedExponential s : ℂ) = CuspUniformization.exponential s := rfl

@[simp] theorem normalizedExponential_zero : normalizedExponential 0 = 1 := by
  apply Units.ext
  exact CuspUniformization.exponential_zero

theorem normalizedExponential_add (s t : ℂ) :
    normalizedExponential (s + t) = normalizedExponential s * normalizedExponential t := by
  apply Units.ext
  exact CuspUniformization.exponential_add s t

@[simp] theorem normalizedExponential_int (n : ℤ) :
    normalizedExponential (n : ℂ) = 1 := by
  apply Units.ext
  exact CuspUniformization.exponential_int n

theorem normalizedExponential_eq_iff (s t : ℂ) :
    normalizedExponential s = normalizedExponential t ↔ ∃ n : ℤ, s = t + n := by
  rw [← Units.val_inj, normalizedExponential_coe, normalizedExponential_coe]
  exact CuspUniformization.exponential_eq_iff s t

theorem normalizedExponential_eq_one_iff (s : ℂ) :
    normalizedExponential s = 1 ↔ ∃ n : ℤ, s = (n : ℂ) := by
  simpa using normalizedExponential_eq_iff s 0

theorem normalizedExponential_surjective : Function.Surjective normalizedExponential := by
  intro u
  refine ⟨CuspUniformization.logarithm (u : ℂ), ?_⟩
  apply Units.ext
  exact CuspUniformization.exponential_logarithm u.ne_zero

/-- The subgroup of the additive complex plane generated by the actual period `1`. -/
def integerPeriods : AddSubgroup ℂ := AddSubgroup.zmultiples (1 : ℂ)

theorem mem_integerPeriods_iff (s : ℂ) :
    s ∈ integerPeriods ↔ ∃ n : ℤ, s = (n : ℂ) := by
  simp only [integerPeriods, AddSubgroup.mem_zmultiples_iff, zsmul_one, eq_comm]

/-- The additive parameter group, carrying the existing quotient topology. -/
def Parameter := ℂ ⧸ integerPeriods

instance : AddCommGroup Parameter := inferInstanceAs (AddCommGroup (ℂ ⧸ integerPeriods))

instance : TopologicalSpace Parameter :=
  inferInstanceAs (TopologicalSpace (ℂ ⧸ integerPeriods))

instance : IsTopologicalAddGroup Parameter :=
  inferInstanceAs (IsTopologicalAddGroup (ℂ ⧸ integerPeriods))

/-- The quotient homomorphism from the actual additive complex parameter. -/
def parameterProjection : ℂ →+ Parameter := QuotientAddGroup.mk' integerPeriods

theorem parameterProjection_surjective : Function.Surjective parameterProjection :=
  QuotientAddGroup.mk'_surjective integerPeriods

theorem parameterProjection_continuous : Continuous parameterProjection :=
  QuotientAddGroup.continuous_mk

theorem parameterProjection_isQuotientMap : IsQuotientMap parameterProjection :=
  QuotientAddGroup.isQuotientMap_mk integerPeriods

theorem parameterProjection_eq_iff (s t : ℂ) :
    parameterProjection s = parameterProjection t ↔ ∃ n : ℤ, s - t = (n : ℂ) :=
  QuotientAddGroup.eq_iff_sub_mem.trans (mem_integerPeriods_iff (s - t))

@[simp] theorem parameterProjection_int (n : ℤ) : parameterProjection (n : ℂ) = 0 := by
  rw [← map_zero parameterProjection, parameterProjection_eq_iff]
  exact ⟨n, sub_zero _⟩

/-- The exponential as an additive homomorphism to the multiplicative units. -/
def normalizedExponentialAddHom : ℂ →+ Additive ℂˣ where
  toFun s := Additive.ofMul (normalizedExponential s)
  map_zero' := normalizedExponential_zero
  map_add' := normalizedExponential_add

theorem normalizedExponentialAddHom_ker :
    normalizedExponentialAddHom.ker = integerPeriods := by
  ext s
  change normalizedExponential s = 1 ↔ s ∈ integerPeriods
  rw [normalizedExponential_eq_one_iff, mem_integerPeriods_iff]

/-- The exponential homomorphism descended through its exact integer kernel. -/
def parameterExponentialAddHom : Parameter →+ Additive ℂˣ :=
  QuotientAddGroup.lift integerPeriods normalizedExponentialAddHom (by
    intro s hs
    change normalizedExponential s = 1
    exact (normalizedExponential_eq_one_iff s).mpr ((mem_integerPeriods_iff s).mp hs))

/-- The actual exponential of a quotient parameter. -/
def parameterExponential (p : Parameter) : ℂˣ :=
  Additive.toMul (parameterExponentialAddHom p)

@[simp] theorem parameterExponential_projection (s : ℂ) :
    parameterExponential (parameterProjection s) = normalizedExponential s := rfl

@[simp] theorem parameterExponential_zero : parameterExponential 0 = 1 :=
  parameterExponentialAddHom.map_zero

theorem parameterExponential_add (p q : Parameter) :
    parameterExponential (p + q) = parameterExponential p * parameterExponential q :=
  parameterExponentialAddHom.map_add p q

theorem parameterExponential_injective : Function.Injective parameterExponential := by
  intro p q h
  obtain ⟨s, rfl⟩ := parameterProjection_surjective p
  obtain ⟨t, rfl⟩ := parameterProjection_surjective q
  rw [parameterExponential_projection, parameterExponential_projection] at h
  obtain ⟨n, hn⟩ := (normalizedExponential_eq_iff s t).mp h
  apply (parameterProjection_eq_iff s t).mpr
  exact ⟨n, by simp [hn]⟩

theorem parameterExponential_surjective : Function.Surjective parameterExponential := by
  intro u
  obtain ⟨s, hs⟩ := normalizedExponential_surjective u
  exact ⟨parameterProjection s, hs⟩

theorem parameterExponential_bijective : Function.Bijective parameterExponential :=
  ⟨parameterExponential_injective, parameterExponential_surjective⟩

/-- Exponentiation is a group isomorphism after the additive parameter quotient. -/
def parameterMulEquiv : Multiplicative Parameter ≃* ℂˣ :=
  MulEquiv.ofBijective parameterExponentialAddHom.toMultiplicativeLeft
    parameterExponential_bijective

@[simp] theorem parameterMulEquiv_apply (p : Parameter) :
    parameterMulEquiv (Multiplicative.ofAdd p) = parameterExponential p := rfl

@[simp] theorem parameterMulEquiv_projection (s : ℂ) :
    parameterMulEquiv (Multiplicative.ofAdd (parameterProjection s)) =
      normalizedExponential s := rfl

end Wikipedia.HopfProblem.SpecialPeriods.Threefold.VerticalAction.Exponential
