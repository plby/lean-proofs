import Wikipedia.HopfProblem.EllipticArithmetic
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.RingTheory.Coprime.Lemmas

/-!
# Integral coinvariants of the elliptic monodromy matrices

The two maps `(γ, ψⱼ)` in the proof of Theorem 5.4(iii) identify the
integral coinvariant lattices with `ℤ²`. Surjectivity is proved by the
explicit coordinate sections from the source. Exactness is proved by
explicit integral preimages under `Aⱼ - 1`.
-/

namespace Wikipedia.HopfProblem.Elliptic

open scoped Matrix

/-- The order-three invariant functional from Theorem 5.4(iii). -/
def psiOne : Lattice →ₗ[ℤ] ℤ where
  toFun w := 2 * w 1 + w 2 + 3 * w 3
  map_add' w z := by simp only [Pi.add_apply]; ring
  map_smul' a w := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

/-- The order-four invariant functional from Theorem 5.4(iii). -/
def psiTwo : Lattice →ₗ[ℤ] ℤ where
  toFun w := w 1 + w 2 + 2 * w 3
  map_add' w z := by simp only [Pi.add_apply]; ring
  map_smul' a w := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

def psi : Kind → Lattice →ₗ[ℤ] ℤ
  | .three => psiOne
  | .four => psiTwo

/-- Coinvariant coordinates in the order `(γ, ψⱼ)`. -/
def coinvariantMap (j : Kind) : Lattice →ₗ[ℤ] (Fin 2 → ℤ) where
  toFun w := ![γ w, psi j w]
  map_add' w z := by ext k; fin_cases k <;> simp [γ]
  map_smul' a w := by
    ext k
    fin_cases k
    · rfl
    · exact (psi j).map_smul a w

@[simp] theorem coinvariantMap_zero_coordinate (j : Kind) (w : Lattice) :
    coinvariantMap j w 0 = γ w := rfl

@[simp] theorem coinvariantMap_one_coordinate (j : Kind) (w : Lattice) :
    coinvariantMap j w 1 = psi j w := rfl

/-- The section uses `γ̂,ŵ` for order three and `γ̂,û` for order four. -/
def coinvariantSection (j : Kind) : (Fin 2 → ℤ) →ₗ[ℤ] Lattice where
  toFun c := match j with
    | .three => ![c 0, 0, c 1, 0]
    | .four => ![c 0, c 1, 0, 0]
  map_add' c d := by cases j <;> ext k <;> fin_cases k <;> simp
  map_smul' a c := by cases j <;> ext k <;> fin_cases k <;> simp

@[simp] theorem coinvariantMap_section (j : Kind) (c : Fin 2 → ℤ) :
    coinvariantMap j (coinvariantSection j c) = c := by
  cases j <;> ext k <;> fin_cases k <;>
    simp [coinvariantMap, coinvariantSection, γ, psi, psiOne, psiTwo]

theorem coinvariantMap_surjective (j : Kind) : Function.Surjective (coinvariantMap j) :=
  fun c => ⟨coinvariantSection j c, coinvariantMap_section j c⟩

/-- The difference operator whose image defines the integral coinvariants. -/
def coinvariantDifference (j : Kind) : Lattice →ₗ[ℤ] Lattice :=
  (j.matrix - 1).mulVecLin

theorem coinvariantDifference_apply (j : Kind) (w : Lattice) :
    coinvariantDifference j w = j.matrix *ᵥ w - w := by
  simp [coinvariantDifference]

/-- Both coinvariant coordinates are invariant under the actual matrix. -/
theorem coinvariantMap_monodromy (j : Kind) (w : Lattice) :
    coinvariantMap j (j.matrix *ᵥ w) = coinvariantMap j w := by
  cases j <;> ext k <;> fin_cases k <;>
    simp [coinvariantMap, γ, psi, psiOne, psiTwo, Kind.matrix, A₁, A₂,
      dotProduct, Fin.sum_univ_succ] <;> ring

@[simp] theorem coinvariantMap_difference (j : Kind) (w : Lattice) :
    coinvariantMap j (coinvariantDifference j w) = 0 := by
  rw [coinvariantDifference_apply, map_sub, coinvariantMap_monodromy, sub_self]

/-- An explicit integral preimage for vectors in the coordinate kernel. -/
def coinvariantKernelLift (j : Kind) (w : Lattice) : Lattice :=
  match j with
  | .three => ![0, w 3, w 1 + w 3, 0]
  | .four => ![0, -w 1 - w 3, w 3, 0]

theorem coinvariantDifference_kernelLift (j : Kind) (w : Lattice)
    (hw : coinvariantMap j w = 0) :
    coinvariantDifference j (coinvariantKernelLift j w) = w := by
  have h0 : w 0 = 0 := congrFun hw 0
  have hψ : psi j w = 0 := congrFun hw 1
  cases j with
  | three =>
    change 2 * w 1 + w 2 + 3 * w 3 = 0 at hψ
    ext k
    fin_cases k <;>
      simp [coinvariantDifference, coinvariantKernelLift, Kind.matrix, A₁] <;> omega
  | four =>
    change w 1 + w 2 + 2 * w 3 = 0 at hψ
    ext k
    fin_cases k <;>
      simp [coinvariantDifference, coinvariantKernelLift, Kind.matrix, A₂] <;> omega

/-- Exactness over the integers, not merely over the rationals or reals. -/
theorem coinvariantMap_ker_eq_range (j : Kind) :
    LinearMap.ker (coinvariantMap j) = LinearMap.range (coinvariantDifference j) := by
  ext w
  change coinvariantMap j w = 0 ↔ ∃ u, coinvariantDifference j u = w
  constructor
  · intro hw
    exact ⟨coinvariantKernelLift j w, coinvariantDifference_kernelLift j w hw⟩
  · rintro ⟨u, rfl⟩
    exact coinvariantMap_difference j u

/-- The coordinate kernel is exactly the subgroup generated by monodromy
differences, in an elementwise form useful for descent. -/
theorem coinvariantMap_eq_zero_iff (j : Kind) (w : Lattice) :
    coinvariantMap j w = 0 ↔ ∃ u : Lattice, (j.matrix - 1) *ᵥ u = w := by
  change w ∈ LinearMap.ker (coinvariantMap j) ↔ w ∈ LinearMap.range (coinvariantDifference j)
  rw [coinvariantMap_ker_eq_range]

section Descent

variable {B : Type*} [AddCommGroup B]

/-- An invariant additive homomorphism has the same value on a lattice
vector and on its section representative in coinvariant coordinates. -/
theorem invariant_map_section_coinvariantMap (j : Kind) (f : Lattice →+ B)
    (hf : ∀ w, f (j.matrix *ᵥ w) = f w) (w : Lattice) :
    f (coinvariantSection j (coinvariantMap j w)) = f w := by
  have hker : coinvariantMap j (w - coinvariantSection j (coinvariantMap j w)) = 0 := by
    rw [map_sub, coinvariantMap_section, sub_self]
  have hzero : f (coinvariantDifference j
      (coinvariantKernelLift j (w - coinvariantSection j (coinvariantMap j w)))) = 0 := by
    rw [coinvariantDifference_apply, map_sub, hf, sub_self]
  rw [coinvariantDifference_kernelLift j _ hker, map_sub] at hzero
  exact (sub_eq_zero.mp hzero).symm

/-- The explicit descent of an additive map to coinvariant coordinates. -/
def coinvariantDesc (j : Kind) (f : Lattice →+ B) : (Fin 2 → ℤ) →+ B :=
  f.comp (coinvariantSection j).toAddMonoidHom

theorem coinvariantDesc_apply_map (j : Kind) (f : Lattice →+ B)
    (hf : ∀ w, f (j.matrix *ᵥ w) = f w) (w : Lattice) :
    coinvariantDesc j f (coinvariantMap j w) = f w :=
  invariant_map_section_coinvariantMap j f hf w

theorem coinvariantDesc_comp (j : Kind) (f : Lattice →+ B)
    (hf : ∀ w, f (j.matrix *ᵥ w) = f w) :
    (coinvariantDesc j f).comp (coinvariantMap j).toAddMonoidHom = f := by
  apply AddMonoidHom.ext
  intro w
  exact coinvariantDesc_apply_map j f hf w

/-- Universal descent through the actual integral coinvariant map. -/
theorem invariant_addHom_factors (j : Kind) (f : Lattice →+ B)
    (hf : ∀ w, f (j.matrix *ᵥ w) = f w) :
    ∃! g : (Fin 2 → ℤ) →+ B, g.comp (coinvariantMap j).toAddMonoidHom = f := by
  refine ⟨coinvariantDesc j f, coinvariantDesc_comp j f hf, ?_⟩
  intro g hg
  apply AddMonoidHom.ext
  intro c
  calc
    g c = g (coinvariantMap j (coinvariantSection j c)) := by rw [coinvariantMap_section]
    _ = f (coinvariantSection j c) :=
      congrArg (fun h : Lattice →+ B => h (coinvariantSection j c)) hg
    _ = coinvariantDesc j f c := rfl

end Descent

/-- Admissibility gives the precise Bézout identity needed to show that
the abelianized relation vector `(γ(v), ψⱼ(v), -m)` is primitive. -/
theorem admissible_gamma_bezout (j : Kind) (v : Lattice) (hv : AdmissibleTwist j v) :
    ∃ u t : ℤ, u * γ v + t * (j.order : ℤ) = 1 := by
  cases j with
  | three =>
    have hnot : ¬ (3 : ℤ) ∣ γ v := hv.2
    have hmod : γ v % 3 ≠ 0 := fun h => hnot (Int.dvd_iff_emod_eq_zero.mpr h)
    by_cases h1 : γ v % 3 = 1
    · refine ⟨1, -(γ v / 3), ?_⟩
      change 1 * γ v + -(γ v / 3) * 3 = 1
      omega
    · refine ⟨-1, γ v / 3 + 1, ?_⟩
      change -1 * γ v + (γ v / 3 + 1) * 3 = 1
      omega
  | four =>
    have hodd : Odd (γ v) := hv.2
    obtain ⟨k, hk⟩ := hodd
    by_cases h1 : γ v % 4 = 1
    · refine ⟨1, -(γ v / 4), ?_⟩
      change 1 * γ v + -(γ v / 4) * 4 = 1
      omega
    · refine ⟨-1, γ v / 4 + 1, ?_⟩
      change -1 * γ v + (γ v / 4 + 1) * 4 = 1
      omega

theorem admissible_gamma_isCoprime (j : Kind) (v : Lattice)
    (hv : AdmissibleTwist j v) : IsCoprime (γ v) (j.order : ℤ) :=
  admissible_gamma_bezout j v hv

theorem admissible_gamma_gcd (j : Kind) (v : Lattice)
    (hv : AdmissibleTwist j v) : Int.gcd (γ v) (j.order : ℤ) = 1 :=
  Int.isCoprime_iff_gcd_eq_one.mp (admissible_gamma_isCoprime j v hv)

end Wikipedia.HopfProblem.Elliptic
