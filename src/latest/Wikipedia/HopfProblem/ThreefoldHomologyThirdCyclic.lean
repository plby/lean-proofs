import Wikipedia.HopfProblem.ThreefoldHomologySecondAttachment
import Wikipedia.HopfProblem.ThreefoldHomologyThirdSourceKernel
import Wikipedia.HopfProblem.ThreefoldHomologyThirdFibre
import Wikipedia.HopfProblem.ThreefoldHomologyCapEliminationFibre

/-!
# The actual third homology is generated by the original third-fibre class

The original second attachment is injective, so the third piece-inclusion
map is onto.  The cap inclusions remove all filling coordinates, and the
proved source surjectivity removes the remaining non-fibre coordinates.
Thus the original positive `γ ∧ u ∧ w` class generates actual third
homology.  No value of its remaining integral relation is assumed.
-/

noncomputable section

namespace Wikipedia.HopfProblem.SpecialPeriods.Threefold.Homology.ThirdDegree

open SingularMayerVietoris PeriodTorusHigherHomology TrianglePeriodFamily
open TrianglePeriodFamily.Homology TrianglePeriodFamily.HomologyDifference
open CapElimination

/-- Every actual third-homology class is represented in the original regular piece. -/
theorem regularInclusion_three_surjective :
    Function.Surjective (singularHomologyMap originalRegularInclusion 3) := by
  intro x
  obtain ⟨p, hp⟩ := starRight_three_surjective x
  obtain ⟨a, ha⟩ := starOverlapToFillingsHomologyMap_surjective 3 (-p.2)
  have hshape : p - starLeftHomologyMap 3 a =
      (p.1 - starOverlapToRegularHomologyMap 3 a, 0) := by
    rw [starLeft_regular_fillings]
    apply Prod.ext
    · rfl
    · change p.2 - -starOverlapToFillingsHomologyMap 3 a = 0
      rw [ha, neg_neg, sub_self]
  refine ⟨p.1 - starOverlapToRegularHomologyMap 3 a, ?_⟩
  calc
    singularHomologyMap originalRegularInclusion 3
        (p.1 - starOverlapToRegularHomologyMap 3 a) =
        starRightHomologyMap 3 (p.1 - starOverlapToRegularHomologyMap 3 a, 0) :=
      (starRight_regular 3 _).symm
    _ = starRightHomologyMap 3 (p - starLeftHomologyMap 3 a) :=
      congrArg (starRightHomologyMap 3) hshape.symm
    _ = starRightHomologyMap 3 p - starRightHomologyMap 3 (starLeftHomologyMap 3 a) :=
      map_sub _ _ _
    _ = x := by rw [hp, (star_exact_at_pair 3).apply_apply_eq_zero a, sub_zero]

/-- The actual normalized regular fibre surjects onto third integral homology. -/
theorem regularFibre_homologyThree_surjective :
    Function.Surjective (singularHomologyMap regularFibreIntoSpace 3) :=
  regularFibreIntoSpace_homology_surjective 2
    ThirdSource.nativeCapKernelSourceMap_two_surjective regularInclusion_three_surjective

/-- The original primitive third-fibre class followed by the actual regular inclusion. -/
def homologyThreeCyclicMap : ℤ →ₗ[ℤ] SingularHomology Space 3 :=
  intLinearMapOfAddHom
    { toFun z := singularHomologyMap originalRegularInclusion 3 (thirdFibreCyclicMap z)
      map_zero' := by rw [map_zero, map_zero]
      map_add' a b := by rw [map_add, map_add] }

@[simp] theorem homologyThreeCyclicMap_regular (z : ℤ) :
    homologyThreeCyclicMap z =
      singularHomologyMap originalRegularInclusion 3 (thirdFibreCyclicMap z) := rfl

/-- The forward map keeps the original normalized ordered fibre representative. -/
theorem homologyThreeCyclicMap_apply (z : ℤ) :
    homologyThreeCyclicMap z = singularHomologyMap regularFibreIntoSpace 3
      (FlatTorus.singularH3Coordinates.symm ![z, 0, 0, 0]) := by
  rw [homologyThreeCyclicMap_regular, thirdFibreCyclicMap_apply,
    regularFibreIntoSpace_homology, LinearMap.comp_apply]

/-- Every original third-fibre class keeps its actual primitive coordinate. -/
theorem regularFibre_homologyThree_coordinates (a : SingularHomology RealTorus₄ 3) :
    singularHomologyMap regularFibreIntoSpace 3 a =
      homologyThreeCyclicMap (FlatTorus.singularH3Coordinates a 0) := by
  rw [regularFibreIntoSpace_homology, LinearMap.comp_apply,
    thirdFibre_cyclic_coordinates, homologyThreeCyclicMap_regular]

/-- Every actual global third-homology class is an integer multiple of this original fibre image. -/
theorem homologyThreeCyclicMap_surjective : Function.Surjective homologyThreeCyclicMap := by
  intro x
  obtain ⟨a, ha⟩ := regularFibre_homologyThree_surjective x
  exact ⟨FlatTorus.singularH3Coordinates a 0,
    (regularFibre_homologyThree_coordinates a).symm.trans ha⟩

/-- The actual image of the positive ordered `γ ∧ u ∧ w` class. -/
def homologyThreeGenerator : SingularHomology Space 3 := homologyThreeCyclicMap 1

theorem homologyThreeGenerator_eq_fibre :
    homologyThreeGenerator = singularHomologyMap regularFibreIntoSpace 3
      (FlatTorus.singularH3Coordinates.symm ![1, 0, 0, 0]) :=
  homologyThreeCyclicMap_apply 1

/-- Integer multiplication uses the original native homology action. -/
theorem homologyThreeCyclicMap_eq_smul (z : ℤ) :
    homologyThreeCyclicMap z = z • homologyThreeGenerator := by
  simpa [homologyThreeGenerator] using map_zsmul homologyThreeCyclicMap z (1 : ℤ)

/-- Vanishing of this one actual class is equivalent to vanishing of actual third homology. -/
theorem homologyThree_subsingleton_iff_generator_eq_zero :
    Subsingleton (SingularHomology Space 3) ↔ homologyThreeGenerator = 0 := by
  constructor
  · intro h
    exact h.elim _ _
  · intro h
    have hz (x : SingularHomology Space 3) : x = 0 := by
      obtain ⟨z, rfl⟩ := homologyThreeCyclicMap_surjective x
      rw [homologyThreeCyclicMap_eq_smul, h]
      exact @zsmul_zero (SingularHomology Space 3) _ z
    exact ⟨fun x y => (hz x).trans (hz y).symm⟩

end Wikipedia.HopfProblem.SpecialPeriods.Threefold.Homology.ThirdDegree
