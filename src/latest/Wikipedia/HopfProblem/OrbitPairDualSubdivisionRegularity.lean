import Wikipedia.HopfProblem.OrbitPairInitialFacePushout
import Mathlib.AlgebraicTopology.SimplicialSet.Nonsingular

/-!
# Dual subdivision is regular

Regularity means that every positive-dimensional nondegenerate
characteristic simplex is attached to the subcomplex generated by its
zeroth face by the displayed native pushout. The zero-dimensional case
has no face identifications. This condition is weaker than nonsingularity.

The theorem for `dualSd.obj X` holds for arbitrary `X`, with no regularity,
nonsingularity, or finiteness hypothesis on `X`. Geometric realization
carries the checked simplicial square to an actual topological pushout.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Simplicial

namespace Wikipedia.HopfProblem.OrbitPair.InitialFace

def Regular (X : SSet.{u}) : Prop :=
  ∀ (n : ℕ) (z : X _⦋n + 1⦌), z ∈ X.nonDegenerate (n + 1) →
    IsPushout (SSet.Subcomplex.toOfSimplex (X.δ 0 z))
      (SSet.stdSimplex.δ (0 : Fin (n + 2))) (inclusion z) (SSet.Subcomplex.toOfSimplex z)

theorem initialInjective_of_nonsingular {X : SSet.{u}} [X.Nonsingular] {n : ℕ}
    (z : X _⦋n⦌) (hz : z ∈ X.nonDegenerate n) : InitialInjective z := by
  intro l f g _ h
  exact SSet.Nonsingular.injective_map z hz h

theorem regular_of_nonsingular (X : SSet.{u}) [X.Nonsingular] : Regular X := by
  intro n z hz
  exact pushout z (initialInjective_of_nonsingular z hz)

theorem realized_pushout {X : SSet.{u}} {n : ℕ} (z : X _⦋n + 1⦌)
    (hz : InitialInjective z) :
    IsPushout (SSet.toTop.map (SSet.Subcomplex.toOfSimplex (X.δ 0 z)))
      (SSet.toTop.map (SSet.stdSimplex.δ (0 : Fin (n + 2))))
      (SSet.toTop.map (inclusion z)) (SSet.toTop.map (SSet.Subcomplex.toOfSimplex z)) :=
  (pushout z hz).map SSet.toTop

end Wikipedia.HopfProblem.OrbitPair.InitialFace

namespace Wikipedia.HopfProblem.OrbitPair.Subdivision

theorem dual_initialInjective (X : SSet.{u}) {n : ℕ} (z : (dualSd.obj X) _⦋n⦌)
    (hz : z ∈ (dualSd.obj X).nonDegenerate n) : InitialFace.InitialInjective z := by
  intro l f g hf h
  exact dual_map_injective_at_initial X z hz f g hf h

theorem dual_regular (X : SSet.{u}) : InitialFace.Regular (dualSd.obj X) := by
  intro n z hz
  exact InitialFace.pushout z (dual_initialInjective X z hz)

theorem dual_realized_regular_pushout (X : SSet.{u}) {n : ℕ}
    (z : (dualSd.obj X) _⦋n + 1⦌) (hz : z ∈ (dualSd.obj X).nonDegenerate (n + 1)) :
    IsPushout (SSet.toTop.map (SSet.Subcomplex.toOfSimplex ((dualSd.obj X).δ 0 z)))
      (SSet.toTop.map (SSet.stdSimplex.δ (0 : Fin (n + 2))))
      (SSet.toTop.map (InitialFace.inclusion z))
      (SSet.toTop.map (SSet.Subcomplex.toOfSimplex z)) :=
  InitialFace.realized_pushout z (dual_initialInjective X z hz)

end Wikipedia.HopfProblem.OrbitPair.Subdivision
