import Wikipedia.HopfProblem.MappingTorusTopology
import Wikipedia.HopfProblem.EllipticCyclicAction

/-!
# The finite cyclic twist on a circle times a fibre

A homeomorphism with period `m` gives an actual cyclic action on
`AddCircle 1 × X`: its generator translates the circle by `1 / m` and
applies the fibre homeomorphism.  Integer representatives act by the
corresponding simultaneous translation and fibre power.
-/

noncomputable section

namespace Wikipedia.HopfProblem.Elliptic.HigherHomology.MappingTorusQuotient

variable {X : Type*} [TopologicalSpace X]

abbrev Circle := Wikipedia.HopfProblem.MappingTorus.Circle

/-- The actual circle-fibre twist, defined even before imposing a finite period. -/
def twist (m : ℕ) (B : X ≃ₜ X) : (Circle × X) ≃ₜ (Circle × X) :=
  (Homeomorph.addRight (((1 : ℝ) / m : ℝ) : Circle)).prodCongr B

@[simp] theorem twist_apply (m : ℕ) (B : X ≃ₜ X) (a : Circle) (x : X) :
    twist m B (a, x) = (a + (((1 : ℝ) / m : ℝ) : Circle), B x) := rfl

/-- The natural powers translate by the corresponding rational circle coordinate. -/
theorem twist_pow_apply (m : ℕ) (B : X ≃ₜ X) (n : ℕ) (a : Circle) (x : X) :
    (twist m B ^ n) (a, x) =
      (a + (((n : ℝ) / m : ℝ) : Circle), (B ^ n) x) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ', Homeomorph.mul_apply, ih, twist_apply]
      apply Prod.ext
      · change a + (((n : ℝ) / m : ℝ) : Circle) + (((1 : ℝ) / m : ℝ) : Circle) =
          a + ((((n + 1 : ℕ) : ℝ) / m : ℝ) : Circle)
        rw [add_assoc, ← AddCircle.coe_add]
        congr 2
        push_cast
        ring
      · simp only [pow_succ', Homeomorph.mul_apply]

/-- Negative powers use the inverse fibre map and the negative circle translation. -/
theorem twist_zpow_apply (m : ℕ) (B : X ≃ₜ X) (n : ℤ) (a : Circle) (x : X) :
    (twist m B ^ n) (a, x) =
      (a + (((n : ℝ) / m : ℝ) : Circle), (B ^ n) x) := by
  cases n with
  | ofNat n =>
      change (twist m B ^ (n : ℤ)) (a, x) =
        (a + ((((n : ℤ) : ℝ) / m : ℝ) : Circle), (B ^ (n : ℤ)) x)
      simpa only [Int.cast_natCast, zpow_natCast] using twist_pow_apply m B n a x
  | negSucc n =>
      rw [zpow_negSucc]
      apply (twist m B ^ (n + 1)).injective
      change (twist m B ^ (n + 1)) ((twist m B ^ (n + 1)).symm (a, x)) = _
      rw [Homeomorph.apply_symm_apply, twist_pow_apply]
      apply Prod.ext
      · change a = a + ((((Int.negSucc n : ℤ) : ℝ) / m : ℝ) : Circle) +
          ((((n + 1 : ℕ) : ℝ) / m : ℝ) : Circle)
        have ht : (((Int.negSucc n : ℤ) : ℝ) / m : ℝ) +
            (((n + 1 : ℕ) : ℝ) / m : ℝ) = 0 := by
          push_cast
          ring
        rw [add_assoc, ← AddCircle.coe_add, ht, AddCircle.coe_zero, add_zero]
      · change x = (B ^ (n + 1)) ((B ^ (Int.negSucc n : ℤ)) x)
        rw [zpow_negSucc, Homeomorph.inv_apply, Homeomorph.apply_symm_apply]

private def homeomorphPermHom : (X ≃ₜ X) →* Equiv.Perm X where
  toFun := Homeomorph.toEquiv
  map_one' := rfl
  map_mul' _ _ := rfl

theorem twist_pow_order (m : ℕ) [NeZero m] (B : X ≃ₜ X) (hB : B ^ m = 1) :
    twist m B ^ m = 1 := by
  have hm : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  have hc : ((1 : ℝ) : Circle) = 0 := by
    simpa only [Int.cast_one] using Wikipedia.HopfProblem.MappingTorus.circle_intCast 1
  apply Homeomorph.ext
  rintro ⟨a, x⟩
  rw [twist_pow_apply]
  simp only [div_self hm, hc, add_zero, hB, Homeomorph.one_apply]

theorem twistPerm_pow_order (m : ℕ) [NeZero m] (B : X ≃ₜ X) (hB : B ^ m = 1) :
    (twist m B).toEquiv ^ m = 1 := by
  change homeomorphPermHom (twist m B) ^ m = 1
  rw [← map_pow, twist_pow_order m B hB, map_one]

/-- The explicitly selected finite cyclic action generated by the actual twist. -/
@[instance_reducible] def productAction (m : ℕ) [NeZero m] (B : X ≃ₜ X)
    (hB : B ^ m = 1) : MulAction (Multiplicative (ZMod m)) (Circle × X) :=
  CyclicAction.action (twist m B).toEquiv (twistPerm_pow_order m B hB)

theorem productAction_continuousConstSMul (m : ℕ) [NeZero m]
    (B : X ≃ₜ X) (hB : B ^ m = 1) :
    letI := productAction m B hB
    ContinuousConstSMul (Multiplicative (ZMod m)) (Circle × X) := by
  exact CyclicAction.continuousConstSMul (twist m B).toEquiv
    (twistPerm_pow_order m B hB) (twist m B).continuous

/-- Any integer representative of a cyclic element acts by that integer
power, not merely by its chosen nonnegative residue. -/
theorem cyclicAction_ofAdd_intCast_smul {M : Type*} (m : ℕ) [NeZero m]
    (σ : Equiv.Perm M) (hσ : σ ^ m = 1) (n : ℤ) (x : M) :
    letI := CyclicAction.action σ hσ
    Multiplicative.ofAdd (n : ZMod m) • x = (σ ^ n) x := by
  change (σ ^ (n : ZMod m).val) x = (σ ^ n) x
  rw [← zpow_natCast, ZMod.val_intCast, ← zpow_eq_zpow_emod' n hσ]

/-- The actual integer-cast formula for the constructed circle-fibre action. -/
theorem ofAdd_intCast_smul (m : ℕ) [NeZero m] (B : X ≃ₜ X) (hB : B ^ m = 1)
    (n : ℤ) (a : Circle) (x : X) :
    letI := productAction m B hB
    Multiplicative.ofAdd (n : ZMod m) • (a, x) =
      (a + (((n : ℝ) / m : ℝ) : Circle), (B ^ n) x) := by
  change ((twist m B).toEquiv ^ (n : ZMod m).val) (a, x) = _
  rw [← zpow_natCast, ZMod.val_intCast,
    ← zpow_eq_zpow_emod' n (twistPerm_pow_order m B hB)]
  have hp : (twist m B).toEquiv ^ n = (twist m B ^ n).toEquiv :=
    (homeomorphPermHom.map_zpow (twist m B) n).symm
  rw [hp]
  exact twist_zpow_apply m B n a x

/-- Changing an integer fibre exponent by any multiple of its period has no effect. -/
theorem fibre_zpow_add_mul_period (m : ℕ) (B : X ≃ₜ X) (hB : B ^ m = 1)
    (k n : ℤ) : B ^ (k + (m : ℤ) * n) = B ^ k := by
  rw [zpow_add, zpow_mul, zpow_natCast, hB, one_zpow, mul_one]

end Wikipedia.HopfProblem.Elliptic.HigherHomology.MappingTorusQuotient
