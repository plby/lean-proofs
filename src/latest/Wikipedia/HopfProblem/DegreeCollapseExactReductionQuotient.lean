import Wikipedia.HopfProblem.DegreeCollapseIntegralKernelReduction

/-!
# Reduction of an exact cyclic-kernel quotient through actual coefficient maps

For an onto map L with kernel generated by a, and onto reductions R and S
whose kernels are twice their groups, construct the induced map between
the actual residue groups. It is onto, has kernel the span of R(a), and
retains the equation induced(R(x)) = S(L(x)).
-/

noncomputable section

open Function Set

namespace Wikipedia.HopfProblem.DegreeCollapse.ExactReduction

open SphereHomologyCoefficients

theorem mem_twice_iff {G : Type} [AddCommGroup G] [Module ℤ G] (x : G) :
    x ∈ scalarImage 2 G ↔ ∃ y : G, (2 : ℤ) • y = x := by
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨y, ?_⟩
    change ((2 : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) y = x at hy
    rw [two_zsmul, LinearMap.add_apply, LinearMap.id_apply] at hy
    rwa [two_zsmul]
  · rintro ⟨y, hy⟩
    refine ⟨y, ?_⟩
    change ((2 : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) y = x
    rw [two_zsmul, LinearMap.add_apply, LinearMap.id_apply]
    rwa [two_zsmul] at hy

variable {K J P Q : Type} [AddCommGroup K] [Module ℤ K] [AddCommGroup J] [Module ℤ J]
  [AddCommGroup P] [Module ℤ P] [AddCommGroup Q] [Module ℤ Q]
  (L : K →ₗ[ℤ] J) (R : K →ₗ[ℤ] P) (S : J →ₗ[ℤ] Q)
  (hRker : LinearMap.ker R = scalarImage 2 K)
  (hSker : LinearMap.ker S = scalarImage 2 J)

include hRker hSker in
theorem reduction_kernel_le : LinearMap.ker R ≤ LinearMap.ker (S.comp L) := by
  intro x hx
  rw [hRker] at hx
  obtain ⟨y, hy⟩ := (mem_twice_iff x).mp hx
  change S (L x) = 0
  rw [← hy, map_zsmul]
  exact IntegralKernelReduction.twice_maps_zero S hSker (L y)

variable (hR : Surjective R)

def inducedMap : P →ₗ[ℤ] Q := by
  let E := R.quotKerEquivOfSurjective hR
  let F := (LinearMap.ker R).liftQ (S.comp L) (reduction_kernel_le L R S hRker hSker)
  let Fadd : P →+ Q := F.toAddMonoidHom.comp E.symm.toAddMonoidHom
  exact {
    toFun := Fadd
    map_add' := Fadd.map_add
    map_smul' := by
      intro k x
      exact (congrArg Fadd (int_smul_eq_zsmul (inferInstance : Module ℤ P) k x)).trans
        ((Fadd.map_zsmul k x).trans
          (int_smul_eq_zsmul (inferInstance : Module ℤ Q) k (Fadd x)).symm) }

theorem inducedMap_reduction (x : K) : inducedMap L R S hRker hSker hR (R x) = S (L x) := by
  change (LinearMap.ker R).liftQ (S.comp L) (reduction_kernel_le L R S hRker hSker)
    ((R.quotKerEquivOfSurjective hR).symm (R x)) = _
  rw [LinearMap.quotKerEquivOfSurjective_symm_apply, Submodule.liftQ_apply]
  rfl

theorem inducedMap_surjective (hL : Surjective L) (hS : Surjective S) :
    Surjective (inducedMap L R S hRker hSker hR) := by
  intro x
  obtain ⟨y, hy⟩ := hS x
  obtain ⟨z, hz⟩ := hL y
  refine ⟨R z, ?_⟩
  rw [inducedMap_reduction, hz, hy]

variable (a : K) (hLker : LinearMap.ker L = Submodule.span ℤ {a})

include hLker in
theorem attaching_maps_zero : L a = 0 := by
  change a ∈ LinearMap.ker L
  rw [hLker]
  exact Submodule.subset_span (mem_singleton _)

include hLker in
theorem inducedMap_kernel (hL : Surjective L) :
    LinearMap.ker (inducedMap L R S hRker hSker hR) = Submodule.span ℤ {R a} := by
  ext v
  constructor
  · intro hv
    obtain ⟨x, rfl⟩ := hR v
    have hm : L x ∈ scalarImage 2 J := by
      rw [← hSker]
      change S (L x) = 0
      rw [← inducedMap_reduction L R S hRker hSker hR]
      exact hv
    obtain ⟨y, hy⟩ := (mem_twice_iff (L x)).mp hm
    obtain ⟨z, hz⟩ := hL y
    have hLz : L (x - (2 : ℤ) • z) = 0 := by
      rw [map_sub, map_zsmul, hz, hy, sub_self]
    have hspan : x - (2 : ℤ) • z ∈ Submodule.span ℤ {a} := by
      rw [← hLker]
      exact hLz
    obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp hspan
    have hk' : k • a = x - (2 : ℤ) • z :=
      (int_smul_eq_zsmul (inferInstance : Module ℤ K) k a).symm.trans hk
    have he : k • R a = R x := by
      rw [← map_zsmul, hk', map_sub, IntegralKernelReduction.twice_maps_zero R hRker, sub_zero]
    exact Submodule.mem_span_singleton.mpr
      ⟨k, (int_smul_eq_zsmul (inferInstance : Module ℤ P) k (R a)).trans he⟩
  · intro hv
    obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp hv
    have hk' : k • R a = v :=
      (int_smul_eq_zsmul (inferInstance : Module ℤ P) k (R a)).symm.trans hk
    change inducedMap L R S hRker hSker hR v = 0
    rw [← hk', map_zsmul, inducedMap_reduction, attaching_maps_zero L a hLker, map_zero, zsmul_zero]

def quotientEquiv (hL : Surjective L) (hS : Surjective S) :
    (P ⧸ Submodule.span ℤ {R a}) ≃ₗ[ℤ] Q := by
  let E := (Submodule.quotEquivOfEq _ _
    (inducedMap_kernel L R S hRker hSker hR a hLker hL).symm).trans
    ((inducedMap L R S hRker hSker hR).quotKerEquivOfSurjective
      (inducedMap_surjective L R S hRker hSker hR hL hS))
  let ea : (P ⧸ Submodule.span ℤ {R a}) ≃+ Q := {
    toEquiv := E.toEquiv
    map_add' := fun x y ↦ E.map_add' x y }
  exact ea.toIntLinearEquiv

theorem quotientEquiv_mk (hL : Surjective L) (hS : Surjective S) (x : P) :
    quotientEquiv L R S hRker hSker hR a hLker hL hS (Submodule.Quotient.mk x) =
      inducedMap L R S hRker hSker hR x := by
  change (inducedMap L R S hRker hSker hR).quotKerEquivOfSurjective
    (inducedMap_surjective L R S hRker hSker hR hL hS)
    (Submodule.quotEquivOfEq _ _ (inducedMap_kernel L R S hRker hSker hR a hLker hL).symm
      (Submodule.Quotient.mk x)) = _
  rw [Submodule.quotEquivOfEq_mk, LinearMap.quotKerEquivOfSurjective_apply_mk]

end Wikipedia.HopfProblem.DegreeCollapse.ExactReduction
