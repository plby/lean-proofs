import Wikipedia.HopfProblem.OrbitPairRealizationQuotient

/-!
# Exact identifications in the actual realization

Two characteristic-simplex parameters give the same realized point exactly
when they are related by the equivalence relation generated by simplicial
operators and their geometric maps. The forward direction uses the proved
native colimit, rather than assuming that these are all identifications.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Simplicial

namespace Wikipedia.HopfProblem.OrbitPair.RealizationSimplex

open FirstHurewicz

variable (S : SSet.{u})

inductive Glue : Parameters S → Parameters S → Prop where
  | of_map (m n : ℕ) (f : ⦋m⦌ ⟶ ⦋n⦌) (x : S _⦋n⦌) (t : Simplex m) :
      Glue ⟨⟨m, S.map f.op x⟩, t⟩
        ⟨⟨n, x⟩, (SimplexCategory.toTop₀.map f).hom t⟩

theorem glue_projection_eq {a b : Parameters S} (h : Glue S a b) :
    projection S a = projection S b := by
  cases h with
  | of_map m n f x t =>
      exact congrArg (fun g : C(Simplex m, SSet.toTop.obj S) ↦ g t)
        (characteristic_map S m n f x)

theorem eqvGen_projection_eq {a b : Parameters S} (h : Relation.EqvGen (Glue S) a b) :
    projection S a = projection S b := by
  induction h with
  | rel a b h => exact glue_projection_eq S h
  | refl => rfl
  | symm a b h ih => exact ih.symm
  | trans a b c hab hbc ihab ihbc => exact ihab.trans ihbc

local instance : Category.{0} (CostructuredArrow SSet.stdSimplex.{u} S) :=
  inferInstanceAs (Category.{0} (CostructuredArrow uliftYoneda.{u} S))

def rawDiagram :=
  (CostructuredArrow.proj SSet.stdSimplex.{u} S ⋙ SimplexCategory.toTop.{u}) ⋙ forget TopCat

def rawToParameters (a : Σ j, (rawDiagram S).obj j) : Parameters S :=
  ⟨⟨a.1.left.len, SSet.yonedaEquiv a.1.hom⟩, a.2.down⟩

def parametersToRaw (a : Parameters S) : Σ j, (rawDiagram S).obj j :=
  ⟨CostructuredArrow.mk (SSet.yonedaEquiv.symm a.1.2), ULift.up a.2⟩

theorem rawToParameters_parametersToRaw (a : Parameters S) :
    rawToParameters S (parametersToRaw S a) = a := by
  rcases a with ⟨⟨n, x⟩, t⟩
  change (⟨⟨n, SSet.yonedaEquiv (SSet.yonedaEquiv.symm x)⟩, t⟩ : Parameters S) = _
  rw [Equiv.apply_symm_apply]

theorem raw_relation_glue {a b : Σ j, (rawDiagram S).obj j}
    (h : (rawDiagram S).ColimitTypeRel a b) :
    Glue S (rawToParameters S a) (rawToParameters S b) := by
  rcases a with ⟨a, t⟩
  rcases b with ⟨b, v⟩
  change ∃ f : a ⟶ b, v = (rawDiagram S).map f t at h
  obtain ⟨f, rfl⟩ := h
  have hx : S.map f.left.op (SSet.yonedaEquiv b.hom) = SSet.yonedaEquiv a.hom := by
    rw [SSet.yonedaEquiv_naturality, CostructuredArrow.w f]
  change Glue S ⟨⟨a.left.len, SSet.yonedaEquiv a.hom⟩, t.down⟩
    ⟨⟨b.left.len, SSet.yonedaEquiv b.hom⟩,
      (SimplexCategory.toTop₀.map f.left).hom t.down⟩
  rw [← hx]
  exact Glue.of_map _ _ _ _ _

theorem raw_eqvGen_glue {a b : Σ j, (rawDiagram S).obj j}
    (h : Relation.EqvGen (rawDiagram S).ColimitTypeRel a b) :
    Relation.EqvGen (Glue S) (rawToParameters S a) (rawToParameters S b) := by
  induction h with
  | rel a b h => exact .rel _ _ (raw_relation_glue S h)
  | refl => exact .refl _
  | symm a b h ih => exact .symm _ _ ih
  | trans a b c hab hbc ihab ihbc => exact .trans _ _ _ ihab ihbc

theorem raw_eqvGen_of_projection_eq {a b : Σ j, (rawDiagram S).obj j}
    (h : projection S (rawToParameters S a) = projection S (rawToParameters S b)) :
    Relation.EqvGen (rawDiagram S).ColimitTypeRel a b := by
  let c := (forget TopCat).mapCocone (simplexCocone S)
  have hc : ((rawDiagram S).coconeTypesEquiv.symm c).IsColimit :=
    (Types.isColimit_iff_coconeTypesIsColimit c).mp
      ⟨isColimitOfPreserves (forget TopCat) (isColimitSimplexCocone S)⟩
  apply Quot.eq.mp
  apply hc.bijective.1
  rcases a with ⟨a, t⟩
  rcases b with ⟨b, v⟩
  change (simplexCocone S).ι.app a t = (simplexCocone S).ι.app b v
  change characteristic S a.left.len (SSet.yonedaEquiv a.hom) t.down =
    characteristic S b.left.len (SSet.yonedaEquiv b.hom) v.down at h
  exact (characteristic_eq_cocone_leg S a t).symm.trans
    (h.trans (characteristic_eq_cocone_leg S b v))

theorem projection_eq_iff (a b : Parameters S) :
    projection S a = projection S b ↔ Relation.EqvGen (Glue S) a b := by
  constructor
  · intro h
    have hraw : projection S (rawToParameters S (parametersToRaw S a)) =
        projection S (rawToParameters S (parametersToRaw S b)) := by
      rwa [rawToParameters_parametersToRaw, rawToParameters_parametersToRaw]
    have hg := raw_eqvGen_glue S (raw_eqvGen_of_projection_eq S hraw)
    rwa [rawToParameters_parametersToRaw, rawToParameters_parametersToRaw] at hg
  · exact eqvGen_projection_eq S

end Wikipedia.HopfProblem.OrbitPair.RealizationSimplex
