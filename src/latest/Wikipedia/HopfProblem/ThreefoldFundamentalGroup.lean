import Wikipedia.HopfProblem.ThreefoldFundamentalGroupEllipticPowers
import Wikipedia.HopfProblem.FundamentalGroupSimplyConnected
import Wikipedia.HopfProblem.SpecialPeriodsThreefoldRealManifold

/-!
# The actual constructed threefold is simply connected

The native fundamental group is generated by the actual regular family,
as proved by the two-open-set van Kampen theorem on the genuine filling
cover.  The cusp and the two elliptic attaching maps have now been
evaluated in a single source-column and jointly based meridian marking.
Their checked presentation kills every generator, hence the actual
fundamental group.  Path connectedness then gives native simple
connectedness of the constructed compact complex threefold.

All statements below are unconditional.  No fundamental-group
presentation, attaching relation, geometric map comparison, or
uniformization is supplied as a hypothesis.
-/

noncomputable section

open scoped ContDiff Manifold

namespace Wikipedia.HopfProblem.SpecialPeriods.Threefold

namespace PiOne

/-- Every class in the actual fundamental group at the marked point is trivial. -/
theorem trivial (g : GlobalGroup) : g = 1 :=
  trivial_of_oriented_elliptic_power_relations
    TrianglePeriodFamily.Meridians.normalizationReversesMeridians
    meridian_first_cube meridian_second_fourth g

end PiOne

/-- The actual compact threefold, with its original topology, is simply connected. -/
theorem space_simplyConnected : SimplyConnectedSpace Space := by
  have := space_pathConnected
  exact simplyConnectedSpace_of_fundamentalGroup_eq_one PiOne.basepoint PiOne.trivial

/-- Triviality holds at every actual basepoint, not only the chosen marking. -/
theorem space_fundamentalGroup_eq_one (x : Space) (g : FundamentalGroup Space x) : g = 1 := by
  have := space_simplyConnected
  exact Subsingleton.elim _ _

theorem space_fundamentalGroup_subsingleton (x : Space) :
    Subsingleton (FundamentalGroup Space x) :=
  ⟨fun g h => (space_fundamentalGroup_eq_one x g).trans
    (space_fundamentalGroup_eq_one x h).symm⟩

/-- An explicit equivalence from the actual native fundamental group to the trivial group. -/
def space_fundamentalGroup_equivPUnit (x : Space) : FundamentalGroup Space x ≃* PUnit where
  toFun _ := PUnit.unit
  invFun _ := 1
  left_inv g := (space_fundamentalGroup_eq_one x g).symm
  right_inv u := by cases u; rfl
  map_mul' _ _ := rfl

/-- Any two actual paths with common endpoints are homotopic relative to those endpoints. -/
theorem space_paths_homotopic {x y : Space} (p q : Path x y) : Path.Homotopic p q := by
  have := space_simplyConnected
  exact SimplyConnectedSpace.paths_homotopic p q

theorem space_loops_nullhomotopic {x : Space} (p : Path x x) :
    Path.Homotopic p (Path.refl x) := space_paths_homotopic p (Path.refl x)

attribute [local instance] chartedSpace

/-- The resulting simply connected compact Hausdorff complex threefold,
with precisely the already constructed gluing atlas. -/
theorem compact_simply_connected_complex_threefold :
    CompactSpace Space ∧ SimplyConnectedSpace Space ∧ T2Space Space ∧
      SecondCountableTopology Space ∧
      IsManifold (modelWithCornersSelf ℂ (ℂ × ComplexPlane₂)) ω Space ∧
      Module.finrank ℂ (ℂ × ComplexPlane₂) = 3 :=
  ⟨space_compact, space_simplyConnected, space_t2Space, space_secondCountable,
    space_isManifold, complex_dimension⟩

end Wikipedia.HopfProblem.SpecialPeriods.Threefold
