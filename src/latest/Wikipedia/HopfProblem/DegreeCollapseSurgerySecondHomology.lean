import Wikipedia.HopfProblem.DegreeCollapseSurgeryNativeEndExact
import Wikipedia.HopfProblem.DegreeCollapseSurgeryOriginalEndHomology

/-!
# Actual second homology on both ends of a framed surgery trace

The original inclusion induces an isomorphism on H2, while the native
surgery-end inclusion is surjective on H2. If the original manifold has
zero H2, the new end's entire H2 is generated by its actual belt sphere.
Vanishing of that belt class is not assumed or inferred merely from the
existence of the framed trace.
-/

noncomputable section

open Set Function Metric Topology
open scoped Manifold ContDiff

namespace Wikipedia.HopfProblem.DegreeCollapse.TraceBody

open NoExoticSixSphere NoExoticSixSphere.GLOrthonormalization EuclideanEmbedding
open EuclideanEmbedding.FramedAttachingProduct
open EuclideanEmbedding.FramedAttachingProduct.RoundedTrace
open SingularMayerVietoris PeriodTorusHigherHomology SphereHomology

variable {M : Type} [TopologicalSpace M] [ChartedSpace (Vector 6) M] [CompactSpace M]
  [IsManifold (𝓡 6) ∞ M] [T2Space M] {e : EuclideanEmbedding 6 M}
  {a : SmoothRangeFrame (𝓡 6) e.normalProjection e.NormalModel}
  (f : C(Sphere 3, M)) (A : FramedAttachingProduct e a f) (hR : A.radius = 2)

include hR in
theorem topMap_homology_bijective_two : Bijective (singularHomologyMap (topMap A) 2) := by
  let : Subsingleton (SingularHomology (Sphere 3) 2) :=
    unitSphere_homology_subsingleton 2 2 (by decide) (by decide)
  let : Subsingleton (SingularHomology (Sphere 3) 1) :=
    unitSphere_homology_subsingleton 2 1 (by decide) (by decide)
  constructor
  · apply LinearMap.ker_eq_bot.mp
    rw [← TraceCoreAttachment.topMap_homology_exact f A hR 2 (by decide)]
    apply bot_unique
    rintro u ⟨v, rfl⟩
    change singularHomologyMap f 2 v = 0
    rw [Subsingleton.elim v 0, map_zero]
  · have hsurj : Surjective ((TraceCoreAttachment.corePresentation A hR).oldHomologyMap 2) := by
      intro u
      have hu : u ∈ LinearMap.ker ((TraceCoreAttachment.corePresentation A hR).cellConnectingMap 1) :=
        Subsingleton.elim _ _
      rw [← (TraceCoreAttachment.corePresentation A hR).cell_exact_at_ambient 1] at hu
      exact hu
    have hcyl : Surjective (singularHomologyMap (TraceCoreAttachment.cylinderInclusion A) 2) := by
      intro u
      obtain ⟨x, hx⟩ := hsurj ((TraceCoreAttachment.coreHomologyEquiv A hR 2).symm u)
      refine ⟨(TraceCoreAttachment.cylinderHomologyEquiv A hR 2).symm x, ?_⟩
      have h := TraceCoreAttachment.old_homology_compare A hR 2
        ((TraceCoreAttachment.cylinderHomologyEquiv A hR 2).symm x)
      rw [LinearEquiv.apply_symm_apply, hx, LinearEquiv.apply_symm_apply] at h
      exact h.symm
    intro u
    obtain ⟨x, hx⟩ := hcyl u
    refine ⟨(TraceCoreAttachment.originalEndHomologyEquiv f A 2).symm x, ?_⟩
    rw [TraceCoreAttachment.topMap_homology_compare, LinearEquiv.apply_symm_apply, hx]

theorem nativeTarget_homology_surjective_two :
    Surjective (singularHomologyMap (nativeTargetInclusion A hR) 2) := by
  let : Subsingleton (SingularHomology (Sphere 2) 1) :=
    unitSphere_homology_subsingleton 1 1 (by decide) (by decide)
  apply LinearMap.range_eq_top.mp
  rw [native_end_exact_at_trace A hR 1]
  apply top_unique
  intro u hu
  exact Subsingleton.elim _ _

def nativeBeltClass : SingularHomology (UnitSurgery.Target A hR) 2 :=
  singularHomologyMap (nativeBeltMap A hR) 2 (unitSphereTopClass 1)

theorem nativeBeltHomology_range : LinearMap.range (singularHomologyMap (nativeBeltMap A hR) 2) =
    Submodule.span ℤ {nativeBeltClass f A hR} := by
  ext u
  constructor
  · rintro ⟨v, rfl⟩
    obtain ⟨k, rfl⟩ := unitSphereTopClass_generates 1 v
    rw [map_zsmul]
    exact Submodule.mem_span_singleton.mpr ⟨k,
      int_smul_eq_zsmul (SingularHomology (UnitSurgery.Target A hR) 2).isModule k
        (nativeBeltClass f A hR)⟩
  · intro hu
    obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp hu
    refine ⟨k • unitSphereTopClass 1, ?_⟩
    rw [map_zsmul]
    exact (int_smul_eq_zsmul (SingularHomology (UnitSurgery.Target A hR) 2).isModule k
      (nativeBeltClass f A hR)).symm.trans hk

theorem native_second_homology_span_belt [Subsingleton (SingularHomology M 2)] :
    Submodule.span ℤ {nativeBeltClass f A hR} = ⊤ := by
  let : Subsingleton (SingularHomology (ambientSet A) 2) :=
    (topMap_homology_bijective_two f A hR).surjective.subsingleton
  rw [← nativeBeltHomology_range, native_end_exact A hR 2 (by decide)]
  apply top_unique
  intro u hu
  exact Subsingleton.elim _ _

end Wikipedia.HopfProblem.DegreeCollapse.TraceBody
