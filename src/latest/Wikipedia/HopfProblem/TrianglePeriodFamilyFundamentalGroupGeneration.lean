import Wikipedia.HopfProblem.TrianglePeriodFamilyFundamentalGroupMarked

/-!
# Generators of the actual regular period-family fundamental group

The actual fibre lattice and the two geometrically marked section
meridians generate the actual total-space fundamental group.  This is
deduced from the proved marked semidirect-product equivalence, rather
than included as a presentation hypothesis.  Consequently, maps out of
this fundamental group are determined by those generators.
-/

noncomputable section

open Set Topology UpperHalfPlane

namespace Wikipedia.HopfProblem.TrianglePeriodFamily

/-- The normal factor and the free generators of the right factor generate
the whole semidirect product. -/
theorem freeSemidirect_subgroup_eq_top {N α : Type*} [Group N]
    (φ : FreeGroup α →* MulAut N) (S : Subgroup (N ⋊[φ] FreeGroup α))
    (hN : ∀ n, SemidirectProduct.inl n ∈ S)
    (hG : ∀ a, SemidirectProduct.inr (FreeGroup.of a) ∈ S) : S = ⊤ := by
  have hc : (⊤ : Subgroup (FreeGroup α)) ≤
      S.comap (SemidirectProduct.inr : FreeGroup α →* N ⋊[φ] FreeGroup α) := by
    rw [← FreeGroup.closure_range_of α]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨a, rfl⟩
    exact hG a
  apply top_unique
  intro x _
  rw [← SemidirectProduct.inl_left_mul_inr_right x]
  exact S.mul_mem (hN x.left) (hc (Subgroup.mem_top x.right))

open SpecialPeriods SpecialPeriods.Triangle Meridians

variable (P : HolomorphicPeriodMap ℂ ℍ)
    (h₁ : ∀ z : ℍ, P.point (Triangle.generatorOneSL • z) = (P.point z).step₁)
    (h₂ : ∀ z : ℍ, P.point (Triangle.generatorTwoSL • z) = (P.point z).step₂)

local notation "Dreg" => regularData P h₁ h₂
local notation "breg" => normalizedRegularMeridianBasepoint

/-- The actual fibre lattice together with the two specified section meridians. -/
def markedRegularFundamentalGroupGenerators :
    Set (FundamentalGroup (Dreg).Space ((Dreg).fundamentalGroupBasepoint breg)) :=
  Set.range ((Dreg).latticeFundamentalGroupHom breg) ∪
    Set.range (fun b : Bool =>
      (Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b))

/-- A subgroup containing the actual lattice loops and both actual marked
section meridians is the whole total-space fundamental group. -/
theorem markedRegularFundamentalGroup_subgroup_eq_top
    (S : Subgroup (FundamentalGroup (Dreg).Space ((Dreg).fundamentalGroupBasepoint breg)))
    (hL : ∀ v : Multiplicative Lattice, (Dreg).latticeFundamentalGroupHom breg v ∈ S)
    (hM : ∀ b : Bool,
      (Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b) ∈ S) :
    S = ⊤ := by
  let e := markedRegularFundamentalGroupEquiv P h₁ h₂
  have hmap : S.map e.toMonoidHom = ⊤ := by
    apply freeSemidirect_subgroup_eq_top
    · intro v
      exact ⟨(Dreg).latticeFundamentalGroupHom breg v, hL v,
        markedRegularFundamentalGroupEquiv_lattice P h₁ h₂ v⟩
    · intro b
      exact ⟨(Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b),
        hM b, markedRegularFundamentalGroupEquiv_meridian P h₁ h₂ b⟩
  apply top_unique
  intro γ _
  have hγ : e γ ∈ S.map e.toMonoidHom := by
    rw [hmap]
    trivial
  obtain ⟨δ, hδ, he⟩ := hγ
  exact e.injective he ▸ hδ

/-- The subgroup generated by the fibre lattice and the two actual marked
section meridians is the whole fundamental group. -/
theorem markedRegularFundamentalGroup_generators_closure :
    Subgroup.closure (markedRegularFundamentalGroupGenerators P h₁ h₂) = ⊤ := by
  apply markedRegularFundamentalGroup_subgroup_eq_top P h₁ h₂
  · intro v
    exact Subgroup.subset_closure (Or.inl ⟨v, rfl⟩)
  · intro b
    exact Subgroup.subset_closure (Or.inr ⟨b, rfl⟩)

/-- Homomorphisms out of the actual total-space fundamental group are
determined by the fibre lattice and the two specified section meridians. -/
theorem markedRegularFundamentalGroupHom_ext {A : Type*} [Monoid A]
    (f g : FundamentalGroup (Dreg).Space ((Dreg).fundamentalGroupBasepoint breg) →* A)
    (hL : ∀ v : Multiplicative Lattice,
      f ((Dreg).latticeFundamentalGroupHom breg v) =
        g ((Dreg).latticeFundamentalGroupHom breg v))
    (hM : ∀ b : Bool,
      f ((Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b)) =
        g ((Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b))) :
    f = g := by
  apply MonoidHom.eq_of_eqOn_dense (markedRegularFundamentalGroup_generators_closure P h₁ h₂)
  rintro γ (⟨v, rfl⟩ | ⟨b, rfl⟩)
  · exact hL v
  · exact hM b

/-- A homomorphism killing the actual fibre lattice and both marked section
meridians is the trivial homomorphism. -/
theorem markedRegularFundamentalGroupHom_eq_one {A : Type*} [Monoid A]
    (f : FundamentalGroup (Dreg).Space ((Dreg).fundamentalGroupBasepoint breg) →* A)
    (hL : ∀ v : Multiplicative Lattice, f ((Dreg).latticeFundamentalGroupHom breg v) = 1)
    (hM : ∀ b : Bool,
      f ((Dreg).sectionFundamentalGroupHom breg (compatibleRegularMeridianClass b)) = 1) :
    f = 1 :=
  markedRegularFundamentalGroupHom_ext P h₁ h₂ f 1 hL hM

/-- Triviality with the two meridian hypotheses given separately. -/
theorem markedRegularFundamentalGroupHom_eq_one_of_two_meridians
    {A : Type*} [Monoid A]
    (f : FundamentalGroup (Dreg).Space ((Dreg).fundamentalGroupBasepoint breg) →* A)
    (hL : ∀ v : Multiplicative Lattice, f ((Dreg).latticeFundamentalGroupHom breg v) = 1)
    (hfalse : f ((Dreg).sectionFundamentalGroupHom breg
      (compatibleRegularMeridianClass false)) = 1)
    (htrue : f ((Dreg).sectionFundamentalGroupHom breg
      (compatibleRegularMeridianClass true)) = 1) :
    f = 1 := by
  apply markedRegularFundamentalGroupHom_eq_one P h₁ h₂ f hL
  intro b
  cases b
  · exact hfalse
  · exact htrue

end Wikipedia.HopfProblem.TrianglePeriodFamily
