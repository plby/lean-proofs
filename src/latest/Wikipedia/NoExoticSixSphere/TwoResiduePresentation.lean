import Mathlib.Algebra.Group.Equiv.Basic
import Mathlib.Algebra.Group.TypeTags.Basic
import Mathlib.Data.Int.ModEq
import Mathlib.Tactic

/-!
# Normal forms for a single relation with integer coefficient of absolute value two

A surjective homomorphism from Z times an abelian group whose kernel is
generated by (a,b), with abs(a)=2, has exactly the representatives with
integer coordinate zero or one. The resulting equivalence is an
equivalence of types; no cyclic group structure is inferred.
-/

noncomputable section

namespace NoExoticSixSphere.TwoResiduePresentation

variable {A G : Type*} [AddCommGroup A] [Group G]

abbrev Coordinates (A : Type*) := Multiplicative ℤ × Multiplicative A

def representative (x : Fin 2 × A) : Coordinates A :=
  (Multiplicative.ofAdd (x.1.val : ℤ), Multiplicative.ofAdd x.2)

def normalMap (p : Coordinates A →* G) (x : Fin 2 × A) : G := p (representative x)

theorem split_integer (p : Coordinates A →* G) (b : A) :
    p (Multiplicative.ofAdd 1, Multiplicative.ofAdd b) =
      p (Multiplicative.ofAdd 1, 1) * p (1, Multiplicative.ofAdd b) := by
  have h := map_mul p (Multiplicative.ofAdd 1, 1) (1, Multiplicative.ofAdd b)
  change p (Multiplicative.ofAdd 1 * 1, 1 * Multiplicative.ofAdd b) = _ at h
  simpa only [mul_one, one_mul] using h

theorem integer_reduction (a : ℤ) (ha : a.natAbs = 2) (m : ℤ) :
    ∃ i : Fin 2, ∃ k : ℤ, k * a = m - (i.val : ℤ) := by
  have h₀ : 0 ≤ m % 2 := Int.emod_nonneg m (by decide)
  have h₁ : m % 2 < 2 := Int.emod_lt_of_pos m (by decide)
  let i : Fin 2 := ⟨(m % 2).toNat, by omega⟩
  have hi : (i.val : ℤ) = m % 2 := Int.toNat_of_nonneg h₀
  have hm := Int.mul_ediv_add_emod m 2
  rcases Int.natAbs_eq_iff.mp ha with h | h
  · exact ⟨i, m / 2, by rw [h]; omega⟩
  · exact ⟨i, -(m / 2), by rw [h]; omega⟩

variable (p : Coordinates A →* G) (a : ℤ) (b : A)
  (hkernel : ∀ x : Coordinates A, p x = 1 ↔
    ∃ k : ℤ, k * a = x.1.toAdd ∧ k • b = x.2.toAdd)
  (ha : a.natAbs = 2)

include hkernel ha in
theorem normalMap_injective : Function.Injective (normalMap p) := by
  intro x y hxy
  have h : p (representative x * (representative y)⁻¹) = 1 := by
    rw [map_mul, map_inv]
    change normalMap p x * (normalMap p y)⁻¹ = 1
    rw [hxy, mul_inv_cancel]
  obtain ⟨k, hk, hb⟩ := (hkernel _).mp h
  change k * a = (x.1.val : ℤ) - (y.1.val : ℤ) at hk
  change k • b = x.2 + -y.2 at hb
  rw [← sub_eq_add_neg] at hb
  have hx := x.1.isLt
  have hy := y.1.isLt
  have hk₀ : k = 0 := by
    rcases Int.natAbs_eq_iff.mp ha with h | h
    · rw [h] at hk
      omega
    · rw [h] at hk
      omega
  rw [hk₀, zero_mul] at hk
  apply Prod.ext
  · apply Fin.ext
    omega
  · exact sub_eq_zero.mp (by simpa only [hk₀, zero_zsmul] using hb.symm)

include hkernel ha in
theorem normalMap_surjective (hp : Function.Surjective p) :
    Function.Surjective (normalMap p) := by
  intro g
  obtain ⟨x, rfl⟩ := hp g
  obtain ⟨i, k, hk⟩ := integer_reduction a ha x.1.toAdd
  let y : Fin 2 × A := (i, x.2.toAdd - k • b)
  have h : p (x * (representative y)⁻¹) = 1 := by
    apply (hkernel _).mpr
    refine ⟨k, hk, ?_⟩
    change k • b = x.2.toAdd + -(x.2.toAdd - k • b)
    abel
  refine ⟨y, ?_⟩
  rw [map_mul, map_inv] at h
  exact (mul_inv_eq_one.mp h).symm

def normalEquiv (hp : Function.Surjective p) : (Fin 2 × A) ≃ G :=
  Equiv.ofBijective (normalMap p)
    ⟨normalMap_injective p a b hkernel ha, normalMap_surjective p a b hkernel ha hp⟩

theorem normalEquiv_apply (hp : Function.Surjective p) (x : Fin 2 × A) :
    normalEquiv p a b hkernel ha hp x = p (representative x) := rfl

end NoExoticSixSphere.TwoResiduePresentation
