import Wikipedia.NoExoticSixSphere

open NoExoticSixSphere

open scoped Manifold ContDiff

universe audit_u

example : SixSphereRigidity.{audit_u} := noExoticSixSpheres

example (M : Type audit_u) [TopologicalSpace M]
    [ChartedSpace (EuclideanSpace ℝ (Fin 6)) M] [IsManifold (𝓡 6) ∞ M]
    (h : Nonempty (M ≃ₜ Sphere 6)) : Nonempty (M ≃ₘ⟮𝓡 6, 𝓡 6⟯ Sphere 6) :=
  noExoticSixSpheres M inferInstance inferInstance inferInstance h

