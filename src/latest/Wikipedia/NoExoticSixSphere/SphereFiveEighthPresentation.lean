import Wikipedia.NoExoticSixSphere.SphereFourAttachingClass

/-!
# A single actual attaching relation presents the eighth group of S5

The checked coordinates on pi_7(S4) transport its original suspension to
a homomorphism from Z times Z/12 onto the native pi_8(S5). Its kernel is
generated by the coordinates of the actual attaching class. This is an
unconditional presentation with an explicitly defined relation, not a
numerical evaluation of that relation or a claimed computation as Z/24.
-/

noncomputable section

open scoped Topology

namespace NoExoticSixSphere.SphereFiveEighth

abbrev Coordinates := Multiplicative ℤ × Multiplicative (ZMod 12)

def relation : Coordinates := SphereFourSeventh.groupEquiv SphereFourAttaching.attachingClass

def projection : Coordinates →* π_ 8 (Sphere 5) (spherePole 5) :=
  SphereFourAttaching.suspension.comp SphereFourSeventh.groupEquiv.symm.toMonoidHom

theorem projection_coordinates (c : π_ 7 (Sphere 4) (spherePole 4)) :
    projection (SphereFourSeventh.groupEquiv c) = SphereFourAttaching.suspension c := by
  change SphereFourAttaching.suspension
    (SphereFourSeventh.groupEquiv.symm (SphereFourSeventh.groupEquiv c)) = _
  rw [MulEquiv.symm_apply_apply]

theorem projection_eq_one_iff (x : Coordinates) :
    projection x = 1 ↔ ∃ k : ℤ, relation ^ k = x := by
  change SphereFourAttaching.suspension (SphereFourSeventh.groupEquiv.symm x) = 1 ↔ _
  rw [SphereFourAttaching.suspension_eq_one_iff]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    change SphereFourSeventh.groupEquiv SphereFourAttaching.attachingClass ^ k = x
    rw [← map_zpow, hk, MulEquiv.apply_symm_apply]
  · rintro ⟨k, hk⟩
    refine ⟨k, SphereFourSeventh.groupEquiv.injective ?_⟩
    rw [map_zpow, MulEquiv.apply_symm_apply]
    exact hk

theorem projection_ker : projection.ker = Subgroup.zpowers relation := by
  ext x
  exact (projection_eq_one_iff x).trans Subgroup.mem_zpowers_iff.symm

theorem projection_surjective : Function.Surjective projection :=
  SphereFourAttaching.suspension_surjective.comp SphereFourSeventh.groupEquiv.symm.surjective

def presentationEquiv : (Coordinates ⧸ Subgroup.zpowers relation) ≃*
    π_ 8 (Sphere 5) (spherePole 5) :=
  (QuotientGroup.quotientMulEquivOfEq projection_ker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective projection projection_surjective)

theorem presentationEquiv_mk (x : Coordinates) :
    presentationEquiv (QuotientGroup.mk x) = projection x := rfl

theorem presentationEquiv_coordinates (c : π_ 7 (Sphere 4) (spherePole 4)) :
    presentationEquiv (QuotientGroup.mk (SphereFourSeventh.groupEquiv c)) =
      SphereFourAttaching.suspension c := projection_coordinates c

theorem relation_hopf : relation.1 =
    Wikipedia.HomotopyGroupsOfSpheres.pi7_sphere_seven_mulEquiv (spherePole 7)
      (SphereFourSeventh.hopf SphereFourAttaching.attachingClass) :=
  SphereFourSeventh.groupEquiv_hopf SphereFourAttaching.attachingClass

theorem projection_eq_one_iff_coordinates (x : Coordinates) :
    projection x = 1 ↔ ∃ k : ℤ,
      k * relation.1.toAdd = x.1.toAdd ∧ k • relation.2.toAdd = x.2.toAdd := by
  rw [projection_eq_one_iff]
  apply exists_congr
  intro k
  change (relation.1 ^ k, relation.2 ^ k) = x ↔ _
  rw [Prod.ext_iff]
  change k • relation.1.toAdd = x.1.toAdd ∧ k • relation.2.toAdd = x.2.toAdd ↔ _
  rw [Int.zsmul_eq_mul]

end NoExoticSixSphere.SphereFiveEighth
