import Wikipedia.NoExoticSixSphere.OrthogonalAntipodalEnergy
import Wikipedia.NoExoticSixSphere.SkewAntipodalMinimum
import Wikipedia.NoExoticSixSphere.OrthogonalEnergyStationarity
import Mathlib.Analysis.Calculus.LocalExtr.Basic

/-!
# The minimum-energy family among smooth antipodal orthogonal paths

The lower bound for arbitrary smooth paths makes a path attaining `n π²`
stationary under every smooth fixed-endpoint variation. The proved
stationary-path classification and spectral equality case then identify
it with the path generated by `π J` for an actual orthogonal complex
structure `J`.
-/

open scoped ContDiff

namespace NoExoticSixSphere.OrthogonalMinimumPaths

open GLOrthonormalization CayleyTransform HilbertSchmidt OrthogonalExponential
  OrthogonalPathEnergy OrthogonalEnergyStationarity OrthogonalComplexStructures
  SkewSpectralPlane

variable {n : ℕ}

theorem energy_complexStructure (b : OrthogonalOperators n) (J : Space n) :
    energy (fun t ↦ (b * exp (t • (Real.pi • J.1))).1.1) 0 1 =
      (n : ℝ) * Real.pi ^ 2 := by
  rw [energy_left_exp]
  have hg : gram (Real.pi • J.1) = Real.pi ^ 2 • (1 : Vector n →L[ℝ] Vector n) := by
    rw [gram_smul, gram_eq_one]
  rw [SkewAntipodalSpectrum.squareNorm_of_gram_scalar _ _ hg]
  ring

theorem isStationary_of_energy_eq_min {γ : ℝ → OrthogonalOperators n}
    (hend : (γ 1).1.1 = -(γ 0).1.1)
    (he : energy (fun t ↦ (γ t).1.1) 0 1 = (n : ℝ) * Real.pi ^ 2) :
    IsStationary γ 0 1 := by
  intro a ha hbase hl hu
  let F : ℝ → ℝ := fun s ↦ energy (fun t ↦ (a (s, t)).1.1) 0 1
  have hF0 : F 0 = (n : ℝ) * Real.pi ^ 2 := by
    change energy (fun t ↦ (a (0, t)).1.1) 0 1 = _
    simpa only [hbase] using he
  have hmin : IsLocalMin F 0 := Filter.Eventually.of_forall (fun s ↦ by
    change F 0 ≤ F s
    rw [hF0]
    have hs : ContDiff ℝ ∞ (fun t ↦ (a (s, t)).1.1) :=
      ha.comp (contDiff_const.prodMk contDiff_id)
    apply antipodal_energy_ge hs
    rw [hu, hl]
    exact hend)
  have hd := OrthogonalFirstVariation.hasDerivAt_energy ha 0 0 1
  exact hd.congr_deriv (hmin.hasDerivAt_eq_zero hd)

theorem eq_complexStructure_of_energy_eq_min {γ : ℝ → OrthogonalOperators n}
    (hγ : ContDiff ℝ ∞ (fun t ↦ (γ t).1.1))
    (hend : (γ 1).1.1 = -(γ 0).1.1)
    (he : energy (fun t ↦ (γ t).1.1) 0 1 = (n : ℝ) * Real.pi ^ 2) :
    ∃ J : Space n, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      γ t = γ 0 * exp (t • (Real.pi • J.1)) := by
  obtain ⟨K, hK⟩ := stationary_is_exponential hγ (by norm_num : (0 : ℝ) < 1)
    (isStationary_of_energy_eq_min hend he)
  have hpath (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
      γ t = γ 0 * exp (t • K) := by simpa only [sub_zero] using hK t ht
  have h1 : γ 1 = γ 0 * exp K := by
    simpa only [one_smul] using hpath 1 ⟨zero_le_one, le_rfl⟩
  have hexp : (exp K).1.1 = -(1 : Vector n →L[ℝ] Vector n) := by
    rw [h1] at hend
    apply ContinuousLinearMap.ext
    intro x
    apply (OrthogonalPaths.toEquiv (γ 0)).injective
    change (γ 0).1.1 ((exp K).1.1 x) = (γ 0).1.1 (-x)
    have hx := DFunLike.congr_fun hend x
    change (γ 0).1.1 ((exp K).1.1 x) = -((γ 0).1.1 x) at hx
    simpa only [map_neg] using hx
  have henergy : energy (fun t ↦ (γ t).1.1) 0 1 =
      energy (fun t ↦ (γ 0 * exp (t • K)).1.1) 0 1 :=
    energy_congr_Icc zero_le_one (fun t ht ↦ congrArg (fun a ↦ a.1.1) (hpath t ht))
  have hs : squareNorm (K : Vector n →L[ℝ] Vector n) = (n : ℝ) * Real.pi ^ 2 := by
    rw [energy_left_exp] at henergy
    simpa only [sub_zero, one_mul] using henergy.symm.trans he
  obtain ⟨J, hJ⟩ := (SkewAntipodalSpectrum.squareNorm_eq_iff_complexStructure K hexp).mp hs
  refine ⟨J, fun t ht ↦ ?_⟩
  rw [hJ]
  exact hpath t ht

theorem energy_eq_min_iff {γ : ℝ → OrthogonalOperators n}
    (hγ : ContDiff ℝ ∞ (fun t ↦ (γ t).1.1))
    (hend : (γ 1).1.1 = -(γ 0).1.1) :
    energy (fun t ↦ (γ t).1.1) 0 1 = (n : ℝ) * Real.pi ^ 2 ↔
      ∃ J : Space n, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        γ t = γ 0 * exp (t • (Real.pi • J.1)) := by
  constructor
  · exact eq_complexStructure_of_energy_eq_min hγ hend
  · rintro ⟨J, hJ⟩
    rw [energy_congr_Icc zero_le_one (fun t ht ↦ congrArg (fun a ↦ a.1.1) (hJ t ht))]
    exact energy_complexStructure (γ 0) J

end NoExoticSixSphere.OrthogonalMinimumPaths
