theorem coordinates_eq_zero (e f g h n c a b : ℝ) (hn0 : 0 ≤ n) (hn1 : n ≤ 1)
    (hs : Constraints e f g h n c a b) : a = 0 ∧ b = 0 := by
  have hi := certificate_identity e f g h n c a b
  rw [hs.h0, hs.h1, hs.h2, hs.h3, hs.h4, hs.h5, hs.h6, hs.h7, hs.h8, hs.h9] at hi
  simp only [mul_zero, add_zero] at hi
  have hp := total_nonneg e f g h n c a b hn0 hn1
  constructor <;> nlinarith [sq_nonneg a, sq_nonneg b]

