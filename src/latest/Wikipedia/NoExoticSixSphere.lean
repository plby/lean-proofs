/-!
# There are no exotic smooth six-spheres

`NoExoticSixSphere.noExoticSixSpheres` proves
`NoExoticSixSphere.SixSphereRigidity` unconditionally. Every smooth
six-dimensional manifold homeomorphic to the standard six-sphere is
diffeomorphic to it, with its independently supplied original smooth atlas.

`NoExoticSixSphere.not_isExoticSixSphere` states the equivalent nonexistence
of exotic six-spheres. Neither theorem assumes a classification result.
-/

open scoped ContDiff Manifold

namespace NoExoticSixSphere

/-- Every smooth six-sphere has the standard smooth structure. The supplied
atlas on `M` is independent of the homeomorphism. -/
theorem no_exotic_six_sphere (M : Type*) [TopologicalSpace M]
    [ChartedSpace (EuclideanSpace ℝ (Fin 6)) M] [IsManifold (𝓡 6) ∞ M]
    (h : Nonempty (M ≃ₜ Sphere 6)) : Nonempty (M ≃ₘ⟮𝓡 6, 𝓡 6⟯ Sphere 6) :=
  noExoticSixSpheres M inferInstance inferInstance inferInstance h

end NoExoticSixSphere
